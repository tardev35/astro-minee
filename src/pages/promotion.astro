---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBoxPremium.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement3.astro";

import { Picture } from "astro:assets";

import pro1 from "../assets/slide1.png";
import pro2 from "../assets/slide2.png";
import pro3 from "../assets/slide3.png";
import pro4 from "../assets/slide4.png";
import { pageGraph } from "../lib/schema";

// IMAGE PAGE, not an article: the whole body is the <h1>, one short intro
// paragraph, the four promo images and one CTA. No section headings and no
// second paragraph — the slides already print their own offer in large type,
// so prose underneath only re-types what the visitor can already read.
const pageTitle = "โปรโมชั่น DUCK36 สำหรับสมาชิกใหม่และสมาชิกเดิม";

// docx SUB-PAGES Meta สำหรับหน้าโปรโมชั่น + ประโยคปิดท้ายหนึ่งวรรคให้ผ่านเกท 150
// นับเป็น "ตัวอักษร" ไม่ใช่ไบต์ (ภาษาไทย 3 ไบต์/ตัว) — สตริงนี้วัดได้ 157 ตัวอักษร
const pageDescription =
  "DUCK36 รวมโปรโมชั่นสล็อต โบนัสสมาชิก และสิทธิพิเศษต่าง ๆ พร้อมรายละเอียดเงื่อนไขให้ตรวจสอบก่อนเลือกรับสิทธิ์ที่เหมาะกับการใช้งาน ควรอ่านเงื่อนไขก่อนรับสิทธิ์";

const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "โปรโมชั่น", path: "/promotion" },
  ],
  primaryImagePath: pro1.src,
});

const promoCardClass =
  "mx-auto h-auto w-full rounded-xl border border-[#f5b70a]/30 object-contain shadow-[0_10px_30px_rgba(245,183,10,0.20)] transition-transform duration-300 hover:-translate-y-1 hover:border-[#d99908]/55 hover:shadow-[0_15px_40px_rgba(217,153,8,0.30)]";
---

<MainLayout title="DUCK36 | โปรโมชั่นสล็อตและโบนัสสำหรับสมาชิก" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={pageTitle} as="h1">
    <div>
      <p class="mb-8 text-left text-base leading-relaxed text-[#efe3c9]">
        <strong class="text-[#fff8e6]">DUCK36</strong> รวมโปรโมชั่นสล็อตและโบนัสสำหรับสมาชิกไว้ในหน้าเดียว ทั้งสิทธิ์ของบัญชีที่เพิ่งเปิดใช้งาน โบนัสจากยอดฝากครั้งแรก การคืนยอดเสียตามรอบวัน
        และเครดิตจากการชวนเพื่อน รายละเอียดของแต่ละรายการพิมพ์อยู่บนภาพด้านล่างแล้ว ทั้งเปอร์เซ็นต์ที่ได้รับและเพดานสูงสุดของรายการนั้น ก่อนกดรับสิทธิ์ควรอ่านเงื่อนไขของโปรโมชั่นที่เลือกให้ครบ
        เพราะแต่ละรายการกำหนดยอดฝากขั้นต่ำ จำนวนเทิร์น และเกมที่ร่วมรายการไม่เหมือนกัน หากไม่แน่ใจจุดใด สอบถามทีมงานผ่านช่องทางที่เว็บไซต์ระบุได้ตลอด 24 ชั่วโมง
      </p>

      <div class="grid w-full grid-cols-1 gap-6 sm:grid-cols-2">
        <Picture
          src={pro1}
          alt="แบนเนอร์โปรโมชั่น DUCK36 ข้อความ สมาชิกใหม่ รับโบนัส 100% เริ่มสนุกได้ทันที พร้อมมาสคอตเป็ดใส่แว่นกันแดด สวมหมวก DUCK36 และสร้อยทองคำ บนพื้นหลังวงล้อสล็อตและกองเหรียญทองสีดำเข้ม แถบล่างระบุ มั่นคงปลอดภัย ฝากถอนออโต้ รองรับมือถือ บริการ 24 ชม."
          loading="lazy"
          fetchpriority="low"
          widths={[300, 450, 600]}
          sizes="(max-width: 639px) 85vw, (max-width: 1520px) 45vw, 600px"
          class={promoCardClass}
          decoding="async"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={80}
        />

        <Picture
          src={pro2}
          alt="แบนเนอร์โปรโมชั่น DUCK36 ข้อความ ฝากครั้งแรก รับเพิ่ม 50% โบนัสต้อนรับสุดคุ้ม พร้อมมาสคอตเป็ดใส่แว่นกันแดด สวมหมวก DUCK36 และสร้อยทองคำ บนพื้นหลังวงล้อสล็อตและกองเหรียญทองสีดำเข้ม แถบล่างระบุ มั่นคงปลอดภัย ฝากถอนออโต้ รองรับมือถือ บริการ 24 ชม."
          loading="lazy"
          fetchpriority="low"
          widths={[300, 450, 600]}
          sizes="(max-width: 639px) 85vw, (max-width: 1520px) 45vw, 600px"
          class={promoCardClass}
          decoding="async"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={80}
        />

        <Picture
          src={pro3}
          alt="แบนเนอร์โปรโมชั่น DUCK36 ข้อความ คืนยอดเสียทุกวัน 10% สูงสุด 5,000 บาท พร้อมมาสคอตเป็ดใส่แว่นกันแดด สวมหมวก DUCK36 และสร้อยทองคำ บนพื้นหลังวงล้อรูเล็ตและกองเหรียญทองสีดำเข้ม แถบล่างระบุ มั่นคงปลอดภัย ฝากถอนออโต้ รองรับมือถือ บริการ 24 ชม."
          loading="lazy"
          fetchpriority="low"
          widths={[300, 450, 600]}
          sizes="(max-width: 639px) 85vw, (max-width: 1520px) 45vw, 600px"
          class={promoCardClass}
          decoding="async"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={80}
        />

        <Picture
          src={pro4}
          alt="แบนเนอร์โปรโมชั่น DUCK36 ข้อความ ชวนเพื่อน รับเครดิตฟรี 300 บาท ชวนมาก ได้มาก พร้อมมาสคอตเป็ดใส่แว่นกันแดด สวมหมวก DUCK36 และสร้อยทองคำ บนพื้นหลังวงล้อสล็อตและกองเหรียญทองสีดำเข้ม แถบล่างระบุ ชวนง่าย รับทันที คุ้มค่า ปลอดภัย"
          loading="lazy"
          fetchpriority="low"
          widths={[300, 450, 600]}
          sizes="(max-width: 639px) 85vw, (max-width: 1520px) 45vw, 600px"
          class={promoCardClass}
          decoding="async"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={80}
        />
      </div>

      <div class="mt-12 flex justify-center pb-4">
        <a
          href="/register"
          class="flex items-center justify-center rounded-lg border border-[#f5b70a]/60 bg-gradient-to-r from-[#ffd76a] via-[#f5b70a] to-[#a8720a] px-10 py-3.5 text-lg font-black text-[#120d02] shadow-[0_10px_30px_rgba(245,183,10,0.28)] transition-transform hover:scale-105 hover:shadow-[0_15px_40px_rgba(245,183,10,0.40)]">
          สมัครสมาชิก DUCK36
        </a>
      </div>
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
