---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement5.astro";

import { Picture } from "astro:assets";

import pro1 from "../assets/slide1.png";
import pro2 from "../assets/slide2.png";
import pro3 from "../assets/slide3.png";
import pro4 from "../assets/slide4.png";
import { pageGraph } from "../lib/schema";

// IMAGE PAGE, not an article: the whole body is the <h1>, one short intro
// paragraph, the four promo images and one CTA. No section headings and no
// second paragraph — the slides already print their own offer in large type,
// so prose underneath only re-types what the visitor can already read.
const pageTitle = "โปรโมชั่น BUGGY888 สำหรับสมาชิกใหม่และสมาชิกเดิม";

// docx SUB-PAGES Meta สำหรับหน้าโปรโมชั่น + ประโยคปิดท้ายหนึ่งวรรคให้ผ่านเกท 150
// นับเป็น "ตัวอักษร" ไม่ใช่ไบต์ (ภาษาไทย 3 ไบต์/ตัว) — สตริงนี้วัดได้ 152 ตัวอักษร
const pageDescription = "BUGGY888 รวมโปรโมชั่นคาสิโน โบนัสสมาชิกใหม่ และสิทธิพิเศษตามเงื่อนไข พร้อมรายละเอียดชัดเจนให้ตรวจสอบก่อนเลือกรับสิทธิ์ที่ตรงกับรูปแบบการเล่นของตนเองเสมอ";

const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "โปรโมชั่น", path: "/promotion" },
  ],
  primaryImagePath: pro1.src,
});

const promoCardClass =
  "mx-auto h-auto w-full rounded-xl border border-[#ffd233]/30 object-contain shadow-[0_10px_30px_rgba(255,210,51,0.20)] transition-transform duration-300 hover:-translate-y-1 hover:border-[#e0a81c]/55 hover:shadow-[0_15px_40px_rgba(224,168,28,0.30)]";
---

<MainLayout title="BUGGY888 | โปรโมชั่นคาสิโนออนไลน์และสิทธิพิเศษสำหรับสมาชิก" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={pageTitle} as="h1">
    <div>
      <p class="mb-8 text-left text-base leading-relaxed text-[#f7e2c4]">
        <strong class="text-[#fff3cf]">BUGGY888</strong> รวมโปรโมชั่นคาสิโนและสิทธิพิเศษสำหรับสมาชิกไว้ในหน้าเดียว ทั้งโบนัสของบัญชีที่เพิ่งเปิดใช้งาน โบนัสจากยอดฝากแรกของวัน การคืนยอดเสียตามรอบวัน และค่าคอมมิชชั่นจากการแนะนำเพื่อน
        รายละเอียดของแต่ละรายการพิมพ์อยู่บนภาพด้านล่างแล้ว ทั้งเปอร์เซ็นต์ที่ได้รับและเงื่อนไขหลักของรายการนั้น ก่อนกดรับสิทธิ์ควรอ่านเงื่อนไขของโปรโมชั่นที่เลือกให้ครบ เพราะแต่ละรายการกำหนดยอดฝากขั้นต่ำ
        จำนวนเทิร์น และเกมที่ร่วมรายการไม่เหมือนกัน หากไม่แน่ใจจุดใด สอบถามทีมงานผ่านช่องทางที่เว็บไซต์กำหนดได้ตลอด 24 ชั่วโมง
      </p>

      <div class="grid w-full grid-cols-1 gap-6 sm:grid-cols-2">
        <Picture
          src={pro1}
          alt="แบนเนอร์โปรโมชั่น BUGGY888 ข้อความ สมาชิกใหม่ รับโบนัส 50% สมัครวันนี้ รับสิทธิ์ทันที และปุ่ม รับโปรเลย บนพื้นหลังสีแดงทอง มีป้ายทอง BUGGY 888 กับมาสคอตโจรสลัดตัวตลก นางแบบชุดแดงทอง วงล้อสล็อตเลข 777 หีบสมบัติ กองเหรียญทองและอัญมณีสีแดง"
          loading="lazy"
          fetchpriority="low"
          widths={[300, 450, 600]}
          sizes="(max-width: 639px) 85vw, (max-width: 1520px) 45vw, 600px"
          class={promoCardClass}
          decoding="async"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={80}
        />

        <Picture
          src={pro2}
          alt="แบนเนอร์โปรโมชั่น BUGGY888 ข้อความ ฝากแรกของวัน รับเพิ่ม 20% คุ้มตั้งแต่ฝากแรก และปุ่ม ฝากเลย บนพื้นหลังสีแดงทอง มีป้ายทอง BUGGY 888 กับมาสคอตโจรสลัดตัวตลก นางแบบชุดแดงทองถือเหรียญ ตู้สล็อต JACKPOT เลข 777 กองเหรียญทองและอัญมณีสีแดง"
          loading="lazy"
          fetchpriority="low"
          widths={[300, 450, 600]}
          sizes="(max-width: 639px) 85vw, (max-width: 1520px) 45vw, 600px"
          class={promoCardClass}
          decoding="async"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={80}
        />

        <Picture
          src={pro3}
          alt="แบนเนอร์โปรโมชั่น BUGGY888 ข้อความ คืนยอดเสียทุกวัน สูงสุด 0.8% เล่นต่อได้ทุกวัน และปุ่ม รับสิทธิ์ บนพื้นหลังสีแดงทอง มีป้ายทอง BUGGY 888 กับมาสคอตโจรสลัดตัวตลก นางแบบชุดแดงทอง ป้ายไฟ JACKPOT วงล้อสล็อตเลข 777 กองเหรียญทองและอัญมณีสีแดง"
          loading="lazy"
          fetchpriority="low"
          widths={[300, 450, 600]}
          sizes="(max-width: 639px) 85vw, (max-width: 1520px) 45vw, 600px"
          class={promoCardClass}
          decoding="async"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={80}
        />

        <Picture
          src={pro4}
          alt="แบนเนอร์โปรโมชั่น BUGGY888 ข้อความ แนะนำเพื่อน รับค่าคอม 10% ชวนเพื่อน ยิ่งชวนยิ่งคุ้ม และปุ่ม ชวนเลย บนพื้นหลังสีแดงทอง มีป้ายทอง BUGGY 888 กับมาสคอตโจรสลัดตัวตลก นางแบบชุดแดงทอง ป้ายไฟ JACKPOT หีบสมบัติ กองเหรียญทองและอัญมณีสีแดง"
          loading="lazy"
          fetchpriority="low"
          widths={[300, 450, 600]}
          sizes="(max-width: 639px) 85vw, (max-width: 1520px) 45vw, 600px"
          class={promoCardClass}
          decoding="async"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={80}
        />
      </div>

      <div class="mt-12 flex justify-center pb-4">
        <a
          href="/register"
          class="flex items-center justify-center rounded-lg border border-[#ffd233]/60 bg-gradient-to-r from-[#ffe98a] via-[#ffd233] to-[#8d630b] px-10 py-3.5 text-lg font-black text-[#2a0704] shadow-[0_10px_30px_rgba(255,210,51,0.28)] transition-transform hover:scale-105 hover:shadow-[0_15px_40px_rgba(255,210,51,0.40)]">
          สมัครสมาชิก BUGGY888
        </a>
      </div>
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
