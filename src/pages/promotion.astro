---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/AnnouncementCyber.astro";

import { Picture } from "astro:assets";

import pro1 from "../assets/slide1.png";
import pro2 from "../assets/slide2.png";
import pro3 from "../assets/slide3.png";
import pro4 from "../assets/slide4.png";
import { pageGraph } from "../lib/schema";

// IMAGE PAGE, not an article: the whole body is the <h1>, one short intro
// paragraph, the four promo images and one CTA. No section headings and no
// second paragraph — the slides already print their own offer in large type,
// so prose underneath only re-types what the visitor can already read.
const pageTitle = "โปรโมชั่น BMK289 รวมโบนัสและสิทธิพิเศษสำหรับสมาชิก";

// docx SUB-PAGES Meta ของหน้าโปรโมชั่น ยกถ้อยคำมาทั้งประโยค (124 ตัวอักษร)
// + วรรคปิดท้ายหนึ่งวรรคให้ผ่านเกท DESC_MIN 150 ของ tools/verify-build.mjs
// ซึ่งยกเว้นให้เฉพาะหน้าแรกเท่านั้น นับเป็น "ตัวอักษร" ไม่ใช่ไบต์ (ไทย 3 ไบต์/ตัว)
// — สตริงนี้วัดได้ 158 ตัวอักษร
const pageDescription =
  "BMK289 รวมโปรโมชั่นสล็อต โบนัส และสิทธิพิเศษตามเงื่อนไข พร้อมรายละเอียดชัดเจน ช่วยให้เลือกโปรได้เหมาะกับงบและรูปแบบการใช้งาน ตรวจเงื่อนไขก่อนรับสิทธิ์ทุกครั้ง";

const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "โปรโมชั่น", path: "/promotion" },
  ],
  primaryImagePath: pro1.src,
});

// Hover border is gold rather than the palette's deepest navy: a #0d2350 edge on
// the near-black navy page is invisible, so the hover state would read as no
// state at all.
const promoCardClass =
  "mx-auto h-auto w-full rounded-xl border border-[#2b8cff]/35 object-contain shadow-[0_10px_30px_rgba(43,140,255,0.20)] transition-transform duration-300 hover:-translate-y-1 hover:border-[#ffcc33]/55 hover:shadow-[0_15px_40px_rgba(157,206,240,0.30)]";
---

<MainLayout title="BMK289 | โปรโมชั่นสล็อตและสิทธิพิเศษสำหรับสมาชิก" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={pageTitle} as="h1">
    <div>
      <p class="mb-8 text-left text-base leading-relaxed text-[#dbe9fb]">
        หน้านี้รวมโปรโมชั่นที่ <strong class="text-[#ffcc33]">BMK289</strong> เปิดให้สมาชิกไว้ครบในที่เดียว ทั้งโบนัสสมาชิกใหม่ โบนัสฝากครั้งแรก ค่าคอมจากการแนะนำเพื่อน และเครดิตคืนยอดเสียรายวัน
        ตัวเลขและเงื่อนไขหลักของแต่ละรายการพิมพ์อยู่บนภาพด้านล่างแล้ว ก่อนกดรับสิทธิ์ควรตรวจยอดฝากที่กำหนด เกมที่ร่วมรายการ และเงื่อนไขการถอนให้ครบ เพราะแต่ละรายการกำหนดไว้ไม่เท่ากัน
      </p>

      <div class="grid w-full grid-cols-1 gap-6 sm:grid-cols-2">
        <Picture
          src={pro1}
          alt="แบนเนอร์โปรโมชั่น BMK289 ข้อความ แนะนำเพื่อน รับค่าคอม 10% พร้อมบรรทัด ชวนเพื่อน ยิ่งชวนยิ่งคุ้ม และแผนภาพสามขั้นตอน ส่งลิงก์ เพื่อนสมัคร รับค่าคอม กับปุ่ม ชวนเลย ด้านบนเป็นโลโก้ BMK289 สีฟ้าโครเมียมและบรรทัด BMK289.COM FUTURE GAME AND SPORTS ด้านขวาเป็นผู้หญิงในชุดครอปสีน้ำเงิน-ขาวพิมพ์คำว่า BMK289 ชี้นิ้วขึ้น มุมขวาบนเป็นป้าย JACKPOT 1,286,000.00 ฉากหลังเป็นเมืองนีออนสีน้ำเงิน วงล้อสล็อตเลข 777 และกองเหรียญทอง"
          loading="lazy"
          fetchpriority="low"
          widths={[300, 450, 600]}
          sizes="(max-width: 639px) 85vw, (max-width: 1520px) 45vw, 600px"
          class={promoCardClass}
          decoding="async"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={80}
        />

        <Picture
          src={pro2}
          alt="แบนเนอร์โปรโมชั่น BMK289 ข้อความ ฝากครั้งแรก รับเพิ่ม 20% พร้อมบรรทัด คุ้มตั้งแต่ฝากแรก และไอคอนสามช่อง ฝากง่าย ถอนเร็ว ระบบออโต้ กับปุ่ม ฝากเลย ตัวเลข 20% ขนาดใหญ่สีทอง ด้านบนเป็นโลโก้ BMK289 สีฟ้าโครเมียม ด้านขวาเป็นผู้หญิงในชุดครอปสีน้ำเงิน-ขาวพิมพ์คำว่า BMK289 ชูนิ้วชี้ขึ้น ฉากหลังมีป้าย JACKPOT 1,286,000.00 วงล้อสล็อตเลข 7 ไพ่เอซ และกองเหรียญทอง"
          loading="lazy"
          fetchpriority="low"
          widths={[300, 450, 600]}
          sizes="(max-width: 639px) 85vw, (max-width: 1520px) 45vw, 600px"
          class={promoCardClass}
          decoding="async"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={80}
        />

        <Picture
          src={pro3}
          alt="แบนเนอร์โปรโมชั่น BMK289 ข้อความ คืนยอดเสีย 0.8% ทุกวัน พร้อมบรรทัด เล่นต่อได้ทุกวัน คุ้มค่าทุกความสนุก ป้ายบนสุด เว็บตรงแตกง่าย ป้ายย่อย โบนัสคุ้ม ระบบเสถียร บริการ 24 ชม. และปุ่ม รับสิทธิ์ ตัวเลข 0.8% ขนาดใหญ่สีขาวเงิน ด้านบนเป็นโลโก้ BMK289 สีฟ้าโครเมียม ด้านขวาเป็นผู้หญิงในชุดครอปสีน้ำเงิน-ขาวพิมพ์คำว่า BMK289 ชี้นิ้วมาทางข้อความ ฉากหลังเป็นเมืองนีออนสีน้ำเงิน วงล้อสล็อตเลข 77 และกองเหรียญทอง"
          loading="lazy"
          fetchpriority="low"
          widths={[300, 450, 600]}
          sizes="(max-width: 639px) 85vw, (max-width: 1520px) 45vw, 600px"
          class={promoCardClass}
          decoding="async"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={80}
        />

        <Picture
          src={pro4}
          alt="แบนเนอร์โปรโมชั่น BMK289 ข้อความ สมาชิกใหม่ รับโบนัส 50% พร้อมบรรทัด สมัครวันนี้ รับสิทธิ์ทันที และ โบนัสต้อนรับสำหรับผู้เล่นใหม่ กับปุ่ม รับโปรเลย ตัวเลข 50% ขนาดใหญ่สีขาวเงิน ด้านบนเป็นโลโก้ BMK289 สีฟ้าโครเมียมและบรรทัด BMK289.COM FUTURE GAME AND SPORTS ด้านขวาเป็นผู้หญิงในชุดครอปสีน้ำเงิน-ขาวพิมพ์คำว่า BMK289 กำมือชูขึ้น ฉากหลังมีป้าย JACKPOT 1,286,000.00 วงล้อสล็อตเลข 7 ไพ่เอซ และกองเหรียญทอง"
          loading="lazy"
          fetchpriority="low"
          widths={[300, 450, 600]}
          sizes="(max-width: 639px) 85vw, (max-width: 1520px) 45vw, 600px"
          class={promoCardClass}
          decoding="async"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={80}
        />
      </div>

      <div class="mt-12 flex justify-center pb-4">
        <a
          href="/register"
          class="flex items-center justify-center rounded-lg border border-[#ffcc33]/60 bg-gradient-to-r from-[#5eb0ff] via-[#2b8cff] to-[#0d2350] px-10 py-3.5 text-lg font-black text-[#dbe9fb] shadow-[0_10px_30px_rgba(43,140,255,0.28)] transition-transform hover:scale-105 hover:shadow-[0_15px_40px_rgba(157,206,240,0.40)]">
          สมัครสมาชิก BMK289
        </a>
      </div>
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
