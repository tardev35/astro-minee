---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/AnnouncementHuay.astro";

import { Picture } from "astro:assets";

import pro1 from "../assets/slide1.png";
import pro2 from "../assets/slide2.png";
import pro3 from "../assets/slide3.png";
import pro4 from "../assets/slide4.png";
import { pageGraph } from "../lib/schema";

// IMAGE PAGE, not an article: the whole body is the h1, one short intro
// paragraph, the four promo images and one CTA. Zero section headings and no
// second paragraph — the slides already print their own offer in large type, so
// prose underneath only re-types what the visitor can already read. The docx
// gives this route a Title and a Meta and never a body, so any heading or extra
// paragraph found here was invented by an earlier rebrand and gets deleted, not
// translated. Rendered inventory: h1x1, h2x0, h3x0.
//
// The alt text below is the Thai printed on each หวยพร้อม slide plus the scene
// it draws — the offer, the sub-line, the button and the artwork. All four
// strings were rewritten from scratch against the images in this drop (read with
// the Read tool): the artwork changed completely, not only the numbers, so the
// outgoing brand's casino descriptions could not be renamed, only replaced.
// Slide order on disk is slide1 สมาชิกใหม่ รับเครดิตฟรี 88, slide2 วงล้อเลขมงคล
// ลุ้นเครดิต 188, slide3 เช็กอิน 5 วัน รับเครดิตเพิ่ม, slide4 ชวนเพื่อนลุ้นเฮง
// รับโบนัส 88. All four are .png in this drop (2026-09-06) and all four belong
// here; banner2.png is dated 2026-08-13, predates the drop, and is deliberately
// NOT imported anywhere. No domain string appears in any alt — verify-build.mjs
// fails the build on a host found inside an attribute. The wordmark drawn on
// every slide reads "หวยพร้อม" with a red tick emblem, which is what the alt
// says is printed.
//
// <Announcement /> is bare on purpose: AnnouncementHuay's default message
// already carries this brand's copy, so the ticker matches index.astro with no
// second string to keep in sync here. The variant rotated off AnnouncementPremium,
// the outgoing brand's pick, per the brand spec.
const pageTitle = "โปรโมชั่น หวยพร้อม รวมสิทธิพิเศษและโบนัสสำหรับสมาชิก";

// Title and description are the docx SUB-PAGES row for /promotion, both shipped
// VERBATIM. The description is shorter than the DESC_MIN=150 floor, and that is
// correct: the brief's own sentence is the brand's copy, not a draft to top up.
// verify-build.mjs exempts any description that appears literally in
// src/assets/content.txt for exactly this reason. Do not pad it.
const pageDescription = "หวยพร้อม รวมโปรโมชั่นหวยออนไลน์ โบนัส และสิทธิพิเศษตามเงื่อนไข พร้อมข้อมูลอัตราจ่ายและรายละเอียดช่วยเลือกโปรให้เหมาะกับงบ";

const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "โปรโมชั่น", path: "/promotion" },
  ],
  primaryImagePath: pro1.src,
});

// Green carries the card edge and the glow — the identity hue of the artwork,
// which is a green city glow behind gold lottery balls. Gold stays on the prize
// numbers inside the pictures and red stays on the CTA below, so the frame
// around a promo image is the one place neither belongs: a gold rim would
// compete with the gold printed on the slide, a red rim would read as a button.
const promoCardClass =
  "mx-auto h-auto w-full rounded-xl border border-[#1e7a3a]/45 object-contain shadow-[0_10px_30px_rgba(34,197,94,0.22)] transition-transform duration-300 hover:-translate-y-1 hover:border-[#22c55e]/70 hover:shadow-[0_15px_40px_rgba(34,197,94,0.3)]";
---

<MainLayout title="หวยพร้อม | โปรโมชั่นหวยออนไลน์และสิทธิพิเศษสำหรับสมาชิก" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={pageTitle} as="h1">
    <div>
      <p class="mb-8 text-left text-base leading-relaxed">
        หน้านี้รวมโปรโมชั่นที่ <strong class="text-[#6ee7a0]">หวยพร้อม</strong> เปิดให้สมาชิกไว้ในที่เดียว ทั้งเครดิตต้อนรับสมาชิกใหม่ วงล้อเลขมงคลประจำวัน การเช็กอินสะสมสิทธิ์รายวัน
        และโบนัสจากการชวนเพื่อน จำนวนเครดิตและเงื่อนไขหลักของแต่ละรายการพิมพ์อยู่บนภาพด้านล่างแล้ว ก่อนกดรับสิทธิ์ควรตรวจยอดฝากขั้นต่ำ ประเภทหวยที่ร่วมรายการ ระยะเวลา
        และเงื่อนไขการถอนของรายการนั้นอีกครั้ง เพราะแต่ละโปรกำหนดเงื่อนไขไว้ไม่เท่ากันและปรับได้ตามรอบ
      </p>

      <div class="grid w-full grid-cols-1 gap-6 sm:grid-cols-2">
        <Picture
          src={pro1}
          alt="แบนเนอร์โปรโมชั่น หวยพร้อม ด้านบนเป็นโลโก้เขียนว่า หวยพร้อม พร้อมเครื่องหมายถูกสีแดงในวงกลม ตรงกลางเป็นพาดหัวตัวใหญ่สีขาวว่า สมาชิกใหม่ เหนือบรรทัด รับเครดิตฟรี แล้วเป็นเลข 88 ตัวทองขนาดใหญ่ ข้างเลขมีริบบิ้นสีแดงเขียนว่า NEW MEMBER ใต้ลงมาเป็นบรรทัด รับสิทธิ์ต้อนรับสำหรับใช้ลุ้นหวยออนไลน์ ปิดท้ายด้วยปุ่มสีแดงเขียนว่า สมัครเลย แถวล่างมีไอคอนกำกับว่า สมัครง่าย ใช้งานสะดวก และ ลุ้นได้ทุกวัน ข้อความด้านข้างเขียนว่า เลขดี ชีวิตดี เริ่มได้ที่ หวยพร้อม ซื้อง่าย ตรวจผลเร็ว รางวัลจริงแน่นอน ลุ้นทุกความหวังอยู่ใกล้แค่ปลายนิ้ว และ หวยไทย หวยฮานอย หวยลาว หวยหุ้น ด้านซ้ายเป็นผู้หญิงในชุดสีเขียวเมทัลลิกถือใบสลากหลายใบและชี้มือไปที่ตัวเลข ฉากหลังเป็นเส้นขอบฟ้าเมืองสีเขียวเรืองแสง มีลูกบอลหวยหมายเลข 6 2 9 5 และ 8 เหรียญทอง และใบสลากกระจายอยู่"
          loading="lazy"
          fetchpriority="low"
          widths={[300, 450, 600]}
          sizes="(max-width: 639px) 85vw, (max-width: 1520px) 45vw, 600px"
          class={promoCardClass}
          decoding="async"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={80}
        />

        <Picture
          src={pro2}
          alt="แบนเนอร์โปรโมชั่น หวยพร้อม มุมบนซ้ายเป็นโลโก้เขียนว่า หวยพร้อม พร้อมเครื่องหมายถูกสีแดงในวงกลม ด้านขวาเป็นวงล้อเสี่ยงโชคสีเขียวขอบทองแบ่งช่องเขียนว่า 188 เครดิต 88 เครดิต 38 เครดิต 18 เครดิต ขอให้รวย ลุ้นโชค 2 เท่า เครดิตฟรี คู่ไอคอนกล่องของขวัญ และ รางวัลพิเศษ คู่ไอคอนกองเหรียญ โดยมีโลโก้แบรนด์อยู่กลางวงล้อ ด้านล่างเป็นพาดหัวตัวใหญ่สีขาวว่า วงล้อเลขมงคล เหนือบรรทัด ลุ้นเครดิต 188 ตามด้วยข้อความ หมุนรับของรางวัล ก่อนซื้อหวยทุกวัน ปิดท้ายด้วยปุ่มสีแดงเขียนว่า สิทธิ์พิเศษประจำวัน แถวล่างมีไอคอนกำกับว่า เล่นง่ายไม่ยุ่งยาก จ่ายจริงมั่นใจได้ 100 เปอร์เซ็นต์ รองรับมือถือเล่นได้ทุกที่ทุกเวลา และ หวยรัฐบาล หวยฮานอย หวยลาว หวยหุ้น ข้อความด้านข้างเขียนว่า มากกว่าหวยคือความมั่นใจ เสี่ยงโชคสร้างโอกาสให้ชีวิตดีขึ้น และ หมุนวันนี้อาจเป็นคุณที่โชคดี ด้านซ้ายเป็นผู้หญิงในชุดสีเขียวเมทัลลิกถือลูกบอลหมายเลข 8 และชี้มือมาข้างหน้า ฉากหลังเป็นแสงเขียวเรืองรอง มีลูกบอลหวย เหรียญทอง ธนบัตร และใบโคลเวอร์กระจายอยู่"
          loading="lazy"
          fetchpriority="low"
          widths={[300, 450, 600]}
          sizes="(max-width: 639px) 85vw, (max-width: 1520px) 45vw, 600px"
          class={promoCardClass}
          decoding="async"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={80}
        />

        <Picture
          src={pro3}
          alt="แบนเนอร์โปรโมชั่น หวยพร้อม ด้านบนเป็นโลโก้เขียนว่า หวยพร้อม พร้อมเครื่องหมายถูกสีแดงในวงกลม ถัดมาเป็นพาดหัวตัวใหญ่ว่า เช็กอิน 5 วัน โดยเลข 5 เป็นตัวทองขนาดใหญ่ เหนือบรรทัด รับเครดิตเพิ่ม ใต้ลงมาเป็นข้อความ สะสมสิทธิ์รายวัน พร้อมลุ้นเลขเด่นทุกเช้า แล้วเป็นแผงปฏิทินห้าช่องเขียนว่า วันที่ 1 ถึง วันที่ 5 แต่ละช่องมีเครื่องหมายถูกสีเขียวในวงกลม ข้างกันเป็นป้ายสีทองเขียนว่า DAILY CHECK-IN คู่ไอคอนปฏิทิน ข้อความด้านข้างเขียนว่า เช็กทุกวัน โชคดีทุกเช้า ที่ หวยพร้อม เช็กอินวันนี้ รับเลยเครดิตฟรี ลุ้นเลขปังทุกวัน และ เสี่ยงโชคสร้างโอกาสให้ชีวิตดีขึ้น ด้านซ้ายเป็นผู้หญิงในชุดสีเขียวเมทัลลิกถือโทรศัพท์ที่หน้าจอเป็นโลโก้แบรนด์และชี้มือไปที่หน้าจอ ฉากหลังเป็นเส้นขอบฟ้าเมืองสีเขียวเรืองแสง มีลูกบอลหวย ใบสลากลงวันที่ และเหรียญทองกระจายอยู่"
          loading="lazy"
          fetchpriority="low"
          widths={[300, 450, 600]}
          sizes="(max-width: 639px) 85vw, (max-width: 1520px) 45vw, 600px"
          class={promoCardClass}
          decoding="async"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={80}
        />

        <Picture
          src={pro4}
          alt="แบนเนอร์โปรโมชั่น หวยพร้อม ด้านบนเป็นโลโก้เขียนว่า หวยพร้อม พร้อมเครื่องหมายถูกสีแดงในวงกลม ใต้โลโก้เป็นบรรทัด หวยรัฐบาล หวยฮานอย หวยลาว หวยหุ้น ถัดมาเป็นพาดหัวตัวใหญ่สีขาวว่า ชวนเพื่อนลุ้นเฮง เหนือบรรทัด รับโบนัส แล้วเป็นเลข 88 ตัวทองขนาดใหญ่ ใต้ลงมาเป็นป้ายเขียนว่า เพื่อนสมัครสำเร็จ รับเครดิตโบนัสทันที คู่ไอคอนรูปคนสองคน ตามด้วยบรรทัด ยิ่งชวน ยิ่งได้ลุ้น และป้ายเล็กด้านซ้ายเขียนว่า ชวนเลย ข้อความด้านข้างเขียนว่า ชวนเพื่อน สร้างโอกาส สร้างความเฮงไปด้วยกัน เล่นหวยได้เพื่อน ได้โชค ได้โบนัส และ เพื่อนเยอะ โชคเยอะ รวยไปด้วยกัน ด้านซ้ายเป็นผู้หญิงในชุดสีเขียวเมทัลลิกถือโทรศัพท์ที่หน้าจอเป็นโลโก้แบรนด์ ด้านล่างเป็นกล่องของขวัญสีเขียวคาดทองเขียนว่า ชวนเพื่อน รับโบนัส 88 พร้อมไอคอนแชร์ ลูกบอลหวย ใบสลาก และเหรียญทอง"
          loading="lazy"
          fetchpriority="low"
          widths={[300, 450, 600]}
          sizes="(max-width: 639px) 85vw, (max-width: 1520px) 45vw, 600px"
          class={promoCardClass}
          decoding="async"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={80}
        />
      </div>

      <div class="mt-12 flex justify-center pb-4">
        <a
          href="/register"
          class="flex items-center justify-center rounded-lg border border-[#ff4d4a]/60 bg-gradient-to-r from-[#ff4d4a] via-[#e10600] to-[#8f0402] px-10 py-3.5 text-lg font-black text-white shadow-[0_10px_30px_rgba(225,6,0,0.32)] transition-transform hover:scale-105 hover:shadow-[0_15px_40px_rgba(225,6,0,0.45)]">
          สมัครสมาชิก หวยพร้อม
        </a>
      </div>
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
