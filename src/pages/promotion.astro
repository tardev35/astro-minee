---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBoxPremium.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement3.astro";

import { Picture } from "astro:assets";

import pro1 from "../assets/slide1.png";
import pro2 from "../assets/slide2.png";
import pro3 from "../assets/slide3.png";
import pro4 from "../assets/slide4.png";
import { pageGraph } from "../lib/schema";

const pageTitle = "โปรโมชั่นคาสิโนออนไลน์ LCX88 และโบนัสสำหรับสมาชิก";

const pageDescription =
  "LCX88 รวมโปรโมชั่นคาสิโนออนไลน์สำหรับสมาชิกใหม่และสมาชิกเดิม พร้อมโบนัส เครดิตพิเศษ และสิทธิประโยชน์ตามเงื่อนไขที่กำหนด ควรตรวจสอบเงื่อนไขก่อนรับสิทธิ์ทุกครั้ง";

const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "โปรโมชั่น", path: "/promotion" },
  ],
  primaryImagePath: pro1.src,
});
---

<MainLayout title="LCX88 | โปรโมชั่นคาสิโนออนไลน์และโบนัสสำหรับสมาชิก" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={pageTitle} as="h1">
    <div>
      <h2 class="mb-4 text-2xl leading-normal font-bold text-[#f5c542]">โปรโมชั่น LCX88 มีรายการอะไรบ้าง และควรอ่านเงื่อนไขจุดไหนก่อนกดรับ</h2>

      <p class="mb-5 text-left text-base leading-relaxed text-[#d7e3ff]">
        <strong class="text-[#ffe08a]">LCX88</strong> รวมเกมคาสิโนออนไลน์หลายรูปแบบไว้ในระบบเดียว ทั้งเกมสล็อต บาคาร่า รูเล็ต เกมไพ่ และคาสิโนสด สิทธิ์ที่หน้านี้เปิดให้กดรับจึงผูกอยู่กับยอดฝากและเกมที่ร่วมรายการ
        ไม่ได้ลอยอยู่เดี่ยว ๆ บนแบนเนอร์ ตัวเลขใหญ่บนภาพบอกได้แค่ว่ามีอะไรให้ ส่วนบรรทัดเล็กใต้ตัวเลขคือคนที่ตัดสินว่าได้จริงเท่าไร ก่อนกดรับจึงควรไล่ให้ครบทั้ง 5 จุด
        คือยอดฝากขั้นต่ำของรายการนั้น เปอร์เซ็นต์โบนัสที่ได้รับ จำนวนเทิร์นที่ต้องทำ เกมและค่ายที่ร่วมรายการ และเพดานถอนสูงสุด เพราะโปรแต่ละแบบกำหนดเกมและเงื่อนไขถอนไม่เหมือนกัน
        การเลือกจากเปอร์เซ็นต์ที่สูงที่สุดเพียงอย่างเดียวจึงไม่ใช่วิธีที่ปลอดภัยที่สุด
      </p>

      <p class="mb-5 text-left text-base leading-relaxed text-[#d7e3ff]">
        รายการที่แสดงบนหน้านี้มีสี่แบบ ทั้งชนิดรับครั้งเดียวและชนิดรับตามรอบ เริ่มจากสมาชิกใหม่ รับโบนัส 100% เริ่มสนุกได้ทันที ซึ่งเป็นสิทธิ์ครั้งเดียวของบัญชีที่เพิ่งเปิดใช้งาน
        ต่อด้วยฝากครั้งแรก รับเพิ่ม 50% โบนัสต้อนรับสุดคุ้ม ที่คิดจากยอดฝากรายการแรกและมักมีเพดานโบนัสของตัวเอง ส่วนคืนยอดเสียทุกวัน 10% สูงสุด 5,000 บาท เป็นรายการที่คำนวณตามรอบวัน
        และชวนเพื่อน รับเครดิตฟรี 300 บาท ชวนมาก ได้มาก ที่นับจากจำนวนเพื่อนซึ่งสมัครและเริ่มใช้งานจริงตามที่ระบบกำหนด
        ตัวเลขบนภาพควรใช้เป็นข้อมูลตั้งต้นแล้วตรวจจากหน้าโปรโมชั่นจริงในระบบอีกครั้งก่อนกด เพราะช่วงเวลาของสิทธิ์ ค่ายเกมที่ยกเว้น และการรับซ้อนกับรายการอื่นเป็นรายละเอียดที่เปลี่ยนได้ตามรอบ
        ถ้าแผนของคุณคือเล่นตามงบที่ตั้งไว้แล้วปิดจบ การไม่รับสิทธิ์เลยก็เป็นทางเลือกที่สมเหตุสมผล เพราะโบนัสที่ยังติดเทิร์นไม่ได้แปลว่าเงินอยู่ในมือแล้ว
      </p>

      <h2 class="mt-10 mb-4 text-2xl leading-normal font-bold text-[#f5c542]">ฝากถอนไม่มีขั้นต่ำกับยอดขั้นต่ำของโปรโมชั่นเป็นคนละชุดตัวเลข</h2>

      <p class="mb-5 text-left text-base leading-relaxed text-[#d7e3ff]">
        เงื่อนไขฝากถอนไม่มีขั้นต่ำของ LCX88 ช่วยให้กำหนดยอดทำรายการได้ยืดหยุ่นขึ้นตามช่องทางที่เว็บไซต์กำหนด แต่เป็นคนละชุดตัวเลขกับยอดฝากขั้นต่ำที่โปรโมชั่นแต่ละรายการเขียนไว้
        รายการอย่างฝากครั้งแรกรับเพิ่ม 50% มีเพดานโบนัสและยอดเริ่มต้นของตัวเอง ส่วนรายการคืนยอดเสีย 10% ต้องดูว่าคำนวณจากยอดเสียสุทธิของช่วงเวลาไหน นับเฉพาะเกมที่ร่วมรายการหรือไม่ ปิดยอดกี่โมง และเพดาน 5,000 บาทนับต่อวันหรือต่อรอบ
        ก่อนยืนยันจึงควรตรวจช่องทางที่รองรับ สถานะบัญชี และข้อกำหนดของโปรโมชั่นให้ตรงกัน เพื่อช่วยลดปัญหารายการล่าช้าหรือข้อมูลไม่ตรงกันภายหลัง
      </p>

      <p class="mb-8 text-left text-base leading-relaxed text-[#d7e3ff]">
        หลังกดรับสิทธิ์ ควรเปิดหน้าประวัติรายการดูว่ายอดโบนัสเข้าครบ เทิร์นเดินถูกเกม และยอดคงเหลือตรงกับที่ระบบแสดง เพราะบางรายการนับยอดเฉพาะเกมสล็อตบางค่าย และบางรายการยกเว้นโต๊ะคาสิโนสดไว้ตั้งแต่ต้น
        ระบบออโต้ช่วยให้เข้าสู่ระบบ เลือกเกม ทำรายการ และตรวจสอบประวัติได้จากหน้าเว็บไซต์เดียว จึงย้อนดูรายการได้เร็วโดยไม่ต้องสลับหลายหน้า หากยอดยังไม่ขยับไม่ควรกดซ้ำทันที เพราะระบบอาจกำลังประมวลผลอยู่
        และหากติดปัญหาเรื่องสถานะฝากถอนหรือเงื่อนไขโปรโมชั่น ทีมงานดูแลสมาชิกเปิดรับเรื่องตลอด 24 ชั่วโมงผ่านช่องทางที่เว็บไซต์ระบุ โดยไม่ต้องส่งรหัสผ่านหรือรหัสยืนยันให้ใครทั้งสิ้น
      </p>

      <div class="grid w-full grid-cols-1 gap-6 sm:grid-cols-2">
        <Picture
          src={pro1}
          alt="แบนเนอร์โปรโมชั่น LCX88 ข้อความ สมาชิกใหม่ รับโบนัส 100% เริ่มสนุกได้ทันที พร้อมภาพพรีเซนเตอร์ในชุดสีน้ำเงินทอง ชิปคาสิโน ลูกเต๋า และเหรียญทองบนพื้นหลังสีน้ำเงินเข้ม"
          loading="lazy"
          fetchpriority="low"
          widths={[300, 450, 600]}
          sizes="(max-width: 639px) 85vw, (max-width: 1520px) 45vw, 600px"
          class="mx-auto h-auto w-full rounded-xl border border-[#2f6bff]/30 object-contain shadow-[0_10px_30px_rgba(47,107,255,0.20)] transition-transform duration-300 hover:-translate-y-1 hover:border-[#f5c542]/55 hover:shadow-[0_15px_40px_rgba(245,197,66,0.30)]"
          decoding="async"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={80}
        />

        <Picture
          src={pro2}
          alt="แบนเนอร์โปรโมชั่น LCX88 ข้อความ ฝากครั้งแรก รับเพิ่ม 50% โบนัสต้อนรับสุดคุ้ม พร้อมภาพพรีเซนเตอร์ในชุดสีน้ำเงินทอง ชิปคาสิโน และเหรียญทองบนพื้นหลังสีน้ำเงินเข้ม"
          loading="lazy"
          fetchpriority="low"
          widths={[300, 450, 600]}
          sizes="(max-width: 639px) 85vw, (max-width: 1520px) 45vw, 600px"
          class="mx-auto h-auto w-full rounded-xl border border-[#2f6bff]/30 object-contain shadow-[0_10px_30px_rgba(47,107,255,0.20)] transition-transform duration-300 hover:-translate-y-1 hover:border-[#f5c542]/55 hover:shadow-[0_15px_40px_rgba(245,197,66,0.30)]"
          decoding="async"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={80}
        />

        <Picture
          src={pro3}
          alt="แบนเนอร์โปรโมชั่น LCX88 ข้อความ คืนยอดเสียทุกวัน 10% สูงสุด 5,000 บาท พร้อมภาพพรีเซนเตอร์ในชุดสีน้ำเงินขาวและกองเหรียญทองบนพื้นหลังสีน้ำเงินเข้ม"
          loading="lazy"
          fetchpriority="low"
          widths={[300, 450, 600]}
          sizes="(max-width: 639px) 85vw, (max-width: 1520px) 45vw, 600px"
          class="mx-auto h-auto w-full rounded-xl border border-[#2f6bff]/30 object-contain shadow-[0_10px_30px_rgba(47,107,255,0.20)] transition-transform duration-300 hover:-translate-y-1 hover:border-[#f5c542]/55 hover:shadow-[0_15px_40px_rgba(245,197,66,0.30)]"
          decoding="async"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={80}
        />

        <Picture
          src={pro4}
          alt="แบนเนอร์โปรโมชั่น LCX88 ข้อความ ชวนเพื่อน รับเครดิตฟรี 300 บาท ชวนมาก ได้มาก พร้อมแถบด้านล่างระบุ มั่นคง ปลอดภัย ระบบมาตรฐานสากล ฝากถอนออโต้ รวดเร็ว ทันใจ รองรับมือถือ แอปใช้งานง่าย และ บริการตลอด 24 ชม. ดูแลทุกการใช้งาน"
          loading="lazy"
          fetchpriority="low"
          widths={[300, 450, 600]}
          sizes="(max-width: 639px) 85vw, (max-width: 1520px) 45vw, 600px"
          class="mx-auto h-auto w-full rounded-xl border border-[#2f6bff]/30 object-contain shadow-[0_10px_30px_rgba(47,107,255,0.20)] transition-transform duration-300 hover:-translate-y-1 hover:border-[#f5c542]/55 hover:shadow-[0_15px_40px_rgba(245,197,66,0.30)]"
          decoding="async"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={80}
        />
      </div>

      <div class="mt-12 flex justify-center pb-4">
        <a
          href="/register"
          class="flex items-center justify-center rounded-lg border border-[#f5c542]/60 bg-gradient-to-r from-[#ffe08a] via-[#f5c542] to-[#c08b1f] px-10 py-3.5 text-lg font-black text-[#04102e] shadow-[0_10px_30px_rgba(245,197,66,0.22)] transition-transform hover:scale-105 hover:shadow-[0_15px_40px_rgba(245,197,66,0.34)]">
          สมัครสมาชิก LCX88
        </a>
      </div>
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
