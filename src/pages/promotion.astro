---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement3.astro";

import { Picture } from "astro:assets";

import pro1 from "../assets/slide1.png";
import pro2 from "../assets/slide2.png";
import pro3 from "../assets/slide3.png";
import pro4 from "../assets/slide4.png";
import { pageGraph } from "../lib/schema";

// IMAGE PAGE, not an article: the whole body is the h1, one short intro
// paragraph, the four promo images and one CTA. Zero section headings and no
// second paragraph — the slides already print their own offer in large type, so
// prose underneath only re-types what the visitor can already read. The docx
// gives this route a Title and a Meta and never a body, so any heading or extra
// paragraph found here was invented by an earlier rebrand and gets deleted, not
// translated. Rendered inventory: h1x1, h2x0, h3x0.
//
// The alt text below is the Thai printed on each MVP928 slide plus the scene it
// draws — the offer, the sub-line, the button and the artwork. Every string was
// rewritten against the actual image in this drop, not renamed from the outgoing
// brand's: all four offers changed, not only the numbers. Slide order on disk is
// slide1 สนุกคุ้มทุกแมตช์, slide2 เช็กอิน 5 วัน, slide3 King Hour, slide4
// วงล้อราชัน. slide1-4 are all .png in this drop (2026-09-04) and all four
// belong here; banner2.png is dated 2026-08-13, predates the drop, and is
// deliberately NOT imported anywhere. No domain string appears in any alt —
// verify-build.mjs fails the build on a host found inside an attribute.
//
// <Announcement /> is bare on purpose: Announcement3's default message already
// carries this brand's copy, so the ticker matches index.astro with no second
// string to keep in sync here. The variant rotated off Announcement4, the
// outgoing brand's pick, per the brand spec.
const pageTitle = "โปรโมชั่น MVP928 รวมสิทธิพิเศษและโบนัสสำหรับสมาชิกสล็อต";

// Title and description are the docx SUB-PAGES row for /promotion, both shipped
// VERBATIM. The description is 123 characters, shorter than the DESC_MIN=150
// floor, and that is correct: the brief's own sentence is the brand's copy, not
// a draft to top up. verify-build.mjs exempts any description that appears
// literally in src/assets/content.txt for exactly this reason. Do not pad it.
const pageDescription = "MVP928 รวมโปรโมชั่นสล็อต โบนัส และสิทธิพิเศษตามเงื่อนไข พร้อมข้อมูลช่วยเลือกโปรให้เหมาะกับงบ รูปแบบเกม และการใช้งานแต่ละแบบ";

const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "โปรโมชั่น", path: "/promotion" },
  ],
  primaryImagePath: pro1.src,
});

// Burnt copper carries the surfaces here (border, glow) and the gold carries the
// hover state — the same read the artwork uses, a copper-rimmed card lifting to
// a gold highlight. A #2a1508 edge on the near-black page would read as no
// border at all, so the resting border is the primary copper rather than the
// panel surface.
const promoCardClass =
  "mx-auto h-auto w-full rounded-xl border border-[#ef6a17]/40 object-contain shadow-[0_10px_30px_rgba(239,106,23,0.24)] transition-transform duration-300 hover:-translate-y-1 hover:border-[#f0b243]/65 hover:shadow-[0_15px_40px_rgba(239,106,23,0.3)]";
---

<MainLayout title="MVP928 | โปรโมชั่นสล็อตและสิทธิพิเศษสำหรับสมาชิก" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={pageTitle} as="h1">
    <div>
      <p class="mb-8 text-left text-base leading-relaxed text-[#ece0d6]">
        หน้านี้รวมโปรโมชั่นที่ <strong class="text-[#f0b243]">MVP928</strong> เปิดให้สมาชิกสล็อตไว้ในที่เดียว ทั้งเกมเด่นที่อัปเดตโบนัสทุกวัน การเช็กอินสะสมห้าวัน ช่วงเวลา King Hour และวงล้อราชันจากยอดฝาก
        ตัวเลขเครดิตและเงื่อนไขหลักของแต่ละรายการพิมพ์อยู่บนภาพด้านล่างแล้ว ก่อนกดรับสิทธิ์ควรตรวจช่วงเวลาที่กำหนด ยอดฝากขั้นต่ำ เกมที่ร่วมรายการ และเงื่อนไขการถอนให้ครบ เพราะแต่ละรายการกำหนดไว้ไม่เท่ากันและปรับได้ตามรอบ
      </p>

      <div class="grid w-full grid-cols-1 gap-6 sm:grid-cols-2">
        <Picture
          src={pro1}
          alt="แบนเนอร์โปรโมชั่น MVP928 มุมซ้ายบนเป็นโลโก้ MVP928 ถัดมาเป็นข้อความตัวใหญ่สีโครมสลับส้มว่า MVP928 เหนือบรรทัด สนุกคุ้มทุกแมตช์ ใต้ลงมาเป็นแถบข้อความ รวมเกมเด่น โบนัสอัปเดตทุกวัน แล้วเป็นป้ายทรงแคปซูลสามอัน เกมไว คู่ไอคอนสายฟ้า ภาพคม คู่ไอคอนเป้า และ เล่นลื่น คู่ไอคอนจรวด ปิดท้ายด้วยปุ่มสีส้มเขียนว่า เปิดเกมเลย ด้านขวาเป็นผู้หญิงในชุดดำขลิบทองแดงติดโลโก้ MVP928 นั่งอยู่ท่ามกลางเหรียญทองและชิปคาสิโน ด้านหลังเป็นรูปปั้นครึ่งตัวเทพซุสสีทองบนพื้นหลังสีดำ"
          loading="lazy"
          fetchpriority="low"
          widths={[300, 450, 600]}
          sizes="(max-width: 639px) 85vw, (max-width: 1520px) 45vw, 600px"
          class={promoCardClass}
          decoding="async"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={80}
        />

        <Picture
          src={pro2}
          alt="แบนเนอร์โปรโมชั่น MVP928 พาดหัวว่า เช็กอิน 5 วัน เหนือบรรทัด รับกล่องสุ่มโบนัส ถัดมาเป็นข้อความ ลุ้น 28 หรือ 58 หรือ 128 เครดิต ใต้ลงมาเป็นแถวหมุดห้าขั้น วันที่ 1 ถึง วันที่ 5 แต่ละขั้นเป็นเครื่องหมายถูกสีทองในวงกลมเชื่อมกันด้วยลูกศร พร้อมคำอธิบายว่า ทำเช็กอินต่อเนื่องครบ รับสิทธิ์สุ่มทันที ด้านล่างเป็นหีบสมบัติสามใบเขียนว่า 28 เครดิต 58 เครดิต และ 128 เครดิต ปิดท้ายด้วยปุ่มเขียนว่า เช็กอินเลย ด้านซ้ายเป็นผู้หญิงในชุดดำขลิบทองแดงติดโลโก้ MVP928 ชี้นิ้วไปที่ขั้นตอนการเช็กอิน"
          loading="lazy"
          fetchpriority="low"
          widths={[300, 450, 600]}
          sizes="(max-width: 639px) 85vw, (max-width: 1520px) 45vw, 600px"
          class={promoCardClass}
          decoding="async"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={80}
        />

        <Picture
          src={pro3}
          alt="แบนเนอร์โปรโมชั่น MVP928 ข้อความสีโครมสลับทองว่า King Hour พร้อมป้ายนาฬิกาเขียนช่วงเวลา 22:00 ถึง 23:00 ถัดมาเป็นบรรทัด เปิดหีบ ลุ้นโค้ดลับ และ รับเครดิตฟรี 99 หรือ 199 หรือ 299 พร้อมคำอธิบายว่า เฉพาะช่วงเวลากำหนดของทุกวัน ตรงกลางเป็นหีบสมบัติทองเปิดออกเรืองแสง มีเหรียญรูปกุญแจสลักคำว่า CODE กระจายออกมา ปิดท้ายด้วยปุ่มเขียนว่า ล่ารางวัล บนพื้นหลังสีดำ"
          loading="lazy"
          fetchpriority="low"
          widths={[300, 450, 600]}
          sizes="(max-width: 639px) 85vw, (max-width: 1520px) 45vw, 600px"
          class={promoCardClass}
          decoding="async"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={80}
        />

        <Picture
          src={pro4}
          alt="แบนเนอร์โปรโมชั่น MVP928 ข้อความตัวใหญ่ว่า วงล้อราชัน พร้อมเงื่อนไขว่า ฝากครบ 500 รับสิทธิ์หมุนฟรี 1 ครั้ง ด้านขวาเป็นวงล้อรางวัลสีทองสลับดำ แบ่งเป็นช่อง 68 เครดิต 168 เครดิต 368 เครดิต ช่อง ของรางวัล และช่องที่เป็นไอคอนหีบสมบัติ ถุงเงิน กับเพชร พร้อมคำอธิบายว่า หมุนรับสิทธิ์ลุ้นของรางวัลได้ทุกวัน ปิดท้ายด้วยปุ่มเขียนว่า หมุนเลย ด้านซ้ายเป็นผู้หญิงในชุดดำขลิบทองแดงติดโลโก้ MVP928 ชี้นิ้วไปที่วงล้อ"
          loading="lazy"
          fetchpriority="low"
          widths={[300, 450, 600]}
          sizes="(max-width: 639px) 85vw, (max-width: 1520px) 45vw, 600px"
          class={promoCardClass}
          decoding="async"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={80}
        />
      </div>

      <div class="mt-12 flex justify-center pb-4">
        <a
          href="/register"
          class="flex items-center justify-center rounded-lg border border-[#f0b243]/60 bg-gradient-to-r from-[#f7ece2] via-[#f0b243] to-[#ef6a17] px-10 py-3.5 text-lg font-black text-[#1c0e05] shadow-[0_10px_30px_rgba(239,106,23,0.32)] transition-transform hover:scale-105 hover:shadow-[0_15px_40px_rgba(179,74,8,0.40)]">
          สมัครสมาชิก MVP928
        </a>
      </div>
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
