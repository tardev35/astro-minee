---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement5.astro";

import { Picture } from "astro:assets";

import pro1 from "../assets/slide1.png";
import pro2 from "../assets/slide2.png";
import pro3 from "../assets/slide3.png";
import pro4 from "../assets/slide4.png";
import { pageGraph } from "../lib/schema";

// IMAGE PAGE, not an article: the whole body is the <h1>, one short intro
// paragraph, the four promo images and one CTA. No section headings and no
// second paragraph — the slides already print their own offer in large type,
// so prose underneath only re-types what the visitor can already read.
const pageTitle = "โปรโมชั่น PG699 รวมโบนัสและสิทธิพิเศษสำหรับสมาชิก";

// docx SUB-PAGES Meta ของหน้าโปรโมชั่น ยกมาทั้งประโยคโดยไม่แก้ถ้อยคำ (129 ตัวอักษร)
// + วรรคปิดท้ายหนึ่งวรรคให้ผ่านเกท DESC_MIN 150 ของ tools/verify-build.mjs
// ซึ่งยกเว้นให้เฉพาะหน้าแรกเท่านั้น นับเป็น "ตัวอักษร" ไม่ใช่ไบต์ (ไทย 3 ไบต์/ตัว)
// — สตริงนี้วัดได้ 157 ตัวอักษร
const pageDescription =
  "PG699 รวมโปรโมชั่นคาสิโน โบนัสต้อนรับ และสิทธิพิเศษสำหรับสมาชิก พร้อมรายละเอียดเงื่อนไข ช่วยให้เลือกโปรได้เหมาะกับรูปแบบการใช้งาน ตรวจเงื่อนไขก่อนกดรับสิทธิ์";

const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "โปรโมชั่น", path: "/promotion" },
  ],
  primaryImagePath: pro1.src,
});

const promoCardClass =
  "mx-auto h-auto w-full rounded-xl border border-[#f5c518]/30 object-contain shadow-[0_10px_30px_rgba(245,197,24,0.20)] transition-transform duration-300 hover:-translate-y-1 hover:border-[#5b9dff]/55 hover:shadow-[0_15px_40px_rgba(26,92,245,0.30)]";
---

<MainLayout title="PG699 | โปรโมชั่นคาสิโนและสิทธิพิเศษสำหรับสมาชิก" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={pageTitle} as="h1">
    <div>
      <p class="mb-8 text-left text-base leading-relaxed text-[#dbe6ff]">
        หน้านี้รวมโปรโมชั่นที่ <strong class="text-[#f5c518]">PG699</strong> เปิดให้สมาชิกคาสิโนไว้ครบในที่เดียว ทั้งโบนัสต้อนรับสมาชิกใหม่ โบนัสฝากครั้งแรก ค่าคอมจากการแนะนำเพื่อน
        และคืนยอดเสียรายวัน ตัวเลขและเงื่อนไขหลักของแต่ละรายการพิมพ์อยู่บนภาพด้านล่างแล้ว จึงอ่านจบได้ตั้งแต่ครั้งแรกที่เลื่อนดู ก่อนกดรับสิทธิ์ควรดูยอดฝากขั้นต่ำ จำนวนเทิร์น
        เกมที่ร่วมรายการ และเพดานถอนของรายการนั้นให้ครบ เพราะแต่ละโปรกำหนดไว้ไม่เท่ากัน หากมีจุดใดไม่ชัดเจน สอบถามทีมบริการสมาชิกผ่านช่องทางที่เว็บไซต์กำหนดได้ตลอด 24 ชั่วโมง
      </p>

      <div class="grid w-full grid-cols-1 gap-6 sm:grid-cols-2">
        <Picture
          src={pro1}
          alt="แบนเนอร์โปรโมชั่น PG699 ข้อความ สมาชิกใหม่ รับโบนัส 50% สมัครวันนี้ รับสิทธิ์ทันที และปุ่ม รับโปรเลย ตัวเลข 50% ขนาดใหญ่สีทองขอบน้ำเงิน โลโก้ PG699 คู่กับ OKACE พริตตี้ในชุดน้ำเงินทองชี้นิ้วขึ้น ป้าย JACKPOT ตู้สล็อตเลข 777 กองเหรียญทองและชิปคาสิโน PG699 บนพื้นน้ำเงินเข้ม"
          loading="lazy"
          fetchpriority="low"
          widths={[300, 450, 600]}
          sizes="(max-width: 639px) 85vw, (max-width: 1520px) 45vw, 600px"
          class={promoCardClass}
          decoding="async"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={80}
        />

        <Picture
          src={pro2}
          alt="แบนเนอร์โปรโมชั่น PG699 ข้อความ ฝากครั้งแรก รับเพิ่ม 20% คุ้มตั้งแต่ฝากแรก และปุ่ม ฝากเลย ตัวเลข 20% ขนาดใหญ่สีทอง โลโก้ PG699 คู่กับ OKACE พริตตี้ในชุดน้ำเงินทองชี้นิ้วขึ้น ป้าย JACKPOT ตู้สล็อตเลข 777 และ BAR กองเหรียญทองและชิปคาสิโน PG699 บนพื้นน้ำเงินเข้ม"
          loading="lazy"
          fetchpriority="low"
          widths={[300, 450, 600]}
          sizes="(max-width: 639px) 85vw, (max-width: 1520px) 45vw, 600px"
          class={promoCardClass}
          decoding="async"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={80}
        />

        <Picture
          src={pro3}
          alt="แบนเนอร์โปรโมชั่น PG699 ข้อความ แนะนำเพื่อน รับค่าคอม 10% ชวนเพื่อน ยิ่งชวนยิ่งคุ้ม และปุ่ม ชวนเลย พร้อมแผนภาพสามขั้นตอน แนะนำเพื่อนให้มาสมัคร เพื่อนสมัครและฝากเงิน รับค่าคอมสูงสุด 10% มีพริตตี้ชุดน้ำเงินทองถือโทรศัพท์ที่เปิดหน้าเกม ตู้สล็อต JACKPOT เลข 777 และเหรียญทองบนพื้นน้ำเงินเข้ม"
          loading="lazy"
          fetchpriority="low"
          widths={[300, 450, 600]}
          sizes="(max-width: 639px) 85vw, (max-width: 1520px) 45vw, 600px"
          class={promoCardClass}
          decoding="async"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={80}
        />

        <Picture
          src={pro4}
          alt="แบนเนอร์โปรโมชั่น PG699 ข้อความ คืนยอดเสียทุกวัน 0.8% เล่นต่อได้ทุกวัน และปุ่ม รับสิทธิ์ ตัวเลข 0.8% ขนาดใหญ่สีทอง พร้อมป้ายสามอัน ระบบออโต้ โบนัสคุ้ม และบริการ 24 ชม. มีพริตตี้ชุดน้ำเงินทองชี้นิ้วขึ้น ชิปคาสิโน PG699 และเหรียญทองบนพื้นน้ำเงินเข้ม"
          loading="lazy"
          fetchpriority="low"
          widths={[300, 450, 600]}
          sizes="(max-width: 639px) 85vw, (max-width: 1520px) 45vw, 600px"
          class={promoCardClass}
          decoding="async"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={80}
        />
      </div>

      <div class="mt-12 flex justify-center pb-4">
        <a
          href="/register"
          class="flex items-center justify-center rounded-lg border border-[#f5c518]/60 bg-gradient-to-r from-[#ffe9a8] via-[#f5c518] to-[#b8770a] px-10 py-3.5 text-lg font-black text-[#08122e] shadow-[0_10px_30px_rgba(245,197,24,0.28)] transition-transform hover:scale-105 hover:shadow-[0_15px_40px_rgba(245,197,24,0.40)]">
          สมัครสมาชิก PG699
        </a>
      </div>
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
