---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/AnnouncementPremium.astro";

import { Picture } from "astro:assets";

import pro1 from "../assets/slide1.png";
import pro2 from "../assets/slide2.png";
import pro3 from "../assets/slide3.png";
import pro4 from "../assets/slide4.png";
import { pageGraph } from "../lib/schema";

// IMAGE PAGE, not an article: the whole body is the <h1>, one short intro
// paragraph, the four promo images and one CTA. No section headings and no
// second paragraph — the slides already print their own offer in large type,
// so prose underneath only re-types what the visitor can already read.
//
// Every alt below was written by opening the file with the Read tool and
// transcribing the Thai printed on the artwork — the LASVEGAS889 wordmark, the
// offer, the guarantee strip and the scene. This asset drop is new artwork, so
// nothing here carries over from the previous brand's alt text.
const pageTitle = "โปรโมชั่น LASVEGAS889 รวมโบนัสและสิทธิพิเศษสำหรับสมาชิก";

// docx SUB-PAGES Meta ของหน้าโปรโมชั่น ยกถ้อยคำมาทั้งประโยค (131 ตัวอักษร)
// + วรรคปิดท้ายหนึ่งวรรคให้ผ่านเกท DESC_MIN 150 ของ tools/verify-build.mjs
// ซึ่งยกเว้นให้เฉพาะหน้าแรกเท่านั้น นับเป็น "ตัวอักษร" ไม่ใช่ไบต์ (ไทย 3 ไบต์/ตัว)
// — สตริงนี้วัดได้ 157 ตัวอักษร
const pageDescription =
  "LASVEGAS889 รวมโปรโมชั่นสล็อตบาคาร่า โบนัส และสิทธิพิเศษตามเงื่อนไข พร้อมรายละเอียดชัดเจน ช่วยให้เลือกโปรได้เหมาะกับรูปแบบการใช้งาน ตรวจเงื่อนไขก่อนรับสิทธิ์";

const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "โปรโมชั่น", path: "/promotion" },
  ],
  primaryImagePath: pro1.src,
});

// Hover border is gold rather than the palette's deepest navy: a #122a63 edge on
// the near-black royal-navy page is invisible, so the hover state would read as
// no state at all.
const promoCardClass =
  "mx-auto h-auto w-full rounded-xl border border-[#1f5ce0]/35 object-contain shadow-[0_10px_30px_rgba(31,92,224,0.20)] transition-transform duration-300 hover:-translate-y-1 hover:border-[#f2b829]/55 hover:shadow-[0_15px_40px_rgba(63,220,255,0.30)]";
---

<MainLayout title="LASVEGAS889 | โปรโมชั่นสล็อตบาคาร่าและสิทธิพิเศษสมาชิก" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={pageTitle} as="h1">
    <div>
      <p class="mb-8 text-left text-base leading-relaxed text-[#cddcf7]">
        หน้านี้รวมโปรโมชั่นที่ <strong class="text-[#f2b829]">LASVEGAS889</strong> เปิดให้สมาชิกไว้ในที่เดียว ทั้งโบนัสสมาชิกใหม่ โบนัสฝากครั้งแรก และเครดิตคืนยอดเสียรายวัน ใช้ได้กับทั้งเกมสล็อตและบาคาร่า
        ตัวเลขและเงื่อนไขหลักของแต่ละรายการพิมพ์อยู่บนภาพด้านล่างแล้ว ก่อนกดรับสิทธิ์ควรตรวจยอดฝากขั้นต่ำ เกมที่ร่วมรายการ และเงื่อนไขการถอนให้ครบ เพราะแต่ละรายการกำหนดไว้ไม่เท่ากัน
      </p>

      <div class="grid w-full grid-cols-1 gap-6 sm:grid-cols-2">
        <Picture
          src={pro1}
          alt="แบนเนอร์โปรโมชั่น LASVEGAS889 ข้อความ สมาชิกใหม่ รับโบนัส 50% โดยตัวเลข 50% เป็นตัวทองขนาดใหญ่ พร้อมบรรทัด สมัครวันนี้ รับสิทธิ์ทันที และปุ่มทอง รับโปรเลย ด้านบนเป็นโลโก้คำว่า LASVEGAS สีทองคู่กับเลข 889 สีเงินโครเมียม บนเส้นขอบฟ้าเมืองลาสเวกัสสีฟ้านีออน ด้านขวาเป็นผู้หญิงในชุดครอปสีน้ำเงิน-ขาวขลิบทองพิมพ์คำว่า LASVEGAS 889 สวมโช้กเกอร์เลข 889 แถบล่างมีสามข้อความ มั่นคง ปลอดภัย เชื่อถือได้ 100% บริการตลอด 24 ชม. รวดเร็วทันใจ และ ฝาก-ถอน ออโต้ ไม่ต้องรอนาน ฉากหลังมีเหรียญทองและชิปคาสิโนสีน้ำเงิน"
          loading="lazy"
          fetchpriority="low"
          widths={[300, 450, 600]}
          sizes="(max-width: 639px) 85vw, (max-width: 1520px) 45vw, 600px"
          class={promoCardClass}
          decoding="async"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={80}
        />

        <Picture
          src={pro2}
          alt="แบนเนอร์โปรโมชั่น LASVEGAS889 ข้อความ ฝากครั้งแรก รับเพิ่ม 20% โดยตัวเลข 20% เป็นตัวทองขนาดใหญ่ พร้อมบรรทัด คุ้มตั้งแต่ฝากแรก ไอคอนสามช่อง ฝากง่าย ถอนเร็ว ระบบออโต้ และปุ่มทอง ฝากเลย ด้านบนเป็นโลโก้คำว่า LASVEGAS สีทองคู่กับเลข 889 สีเงินโครเมียม บนเส้นขอบฟ้าเมืองลาสเวกัสสีฟ้านีออน ด้านขวาเป็นผู้หญิงในชุดเกาะอกสีน้ำเงิน-ขาวขลิบทองพิมพ์คำว่า LASVEGAS 889 มุมขวาบนเป็นวงล้อสล็อตเลข 7 และคำว่า BAR ฉากหลังมีวงล้อรูเล็ต กล่องของขวัญ ป้าย VIP กองเหรียญทอง และชิปคาสิโนสีน้ำเงิน"
          loading="lazy"
          fetchpriority="low"
          widths={[300, 450, 600]}
          sizes="(max-width: 639px) 85vw, (max-width: 1520px) 45vw, 600px"
          class={promoCardClass}
          decoding="async"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={80}
        />

        <Picture
          src={pro3}
          alt="แบนเนอร์โปรโมชั่น LASVEGAS889 ข้อความ คืนยอดเสีย 0.8% ทุกวัน โดยตัวเลข 0.8% เป็นตัวทองขนาดใหญ่ พร้อมบรรทัด เล่นต่อได้ทุกวัน คืนยอดเสียคุ้มค่า ไม่พลาดทุกความสนุก และปุ่มทอง รับสิทธิ์ ด้านบนเป็นโลโก้คำว่า LASVEGAS สีทองคู่กับเลข 889 สีเงินโครเมียม บนเส้นขอบฟ้าเมืองลาสเวกัสสีฟ้านีออน ด้านขวาเป็นผู้หญิงในชุดยาวสีน้ำเงิน-ขาวขลิบทองพิมพ์คำว่า LASVEGAS 889 ชูนิ้วชี้ขึ้น ข้างกันมีตู้สล็อตเลข 777 ป้าย JACKPOT ชิปคาสิโนสีน้ำเงินพิมพ์ LASVEGAS 889 และกองเหรียญทอง"
          loading="lazy"
          fetchpriority="low"
          widths={[300, 450, 600]}
          sizes="(max-width: 639px) 85vw, (max-width: 1520px) 45vw, 600px"
          class={promoCardClass}
          decoding="async"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={80}
        />

        <Picture
          src={pro4}
          alt="แบนเนอร์โปรโมชั่น LASVEGAS889 ข้อความ คาสิโนออนไลน์ครบวงจร พร้อมบรรทัด เล่นง่าย ฝาก-ถอนออโต้ จ่ายจริง และการันตีสี่ช่อง ปลอดภัย มั่นคง 100% ฝาก-ถอน ออโต้ จ่ายจริง ไม่มีโกง และ บริการ 24 ชม. ตลอดทุกวัน กับปุ่มทอง สมัครเลย ด้านบนเป็นโลโก้คำว่า LASVEGAS สีทองคู่กับเลข 889 สีเงินโครเมียม บนเส้นขอบฟ้าเมืองลาสเวกัสสีฟ้านีออน ด้านซ้ายเป็นตู้สล็อตเลข 777 มุมขวาบนเป็นป้าย Welcome to Fabulous LAS VEGAS NEVADA และผู้หญิงในชุดสีน้ำเงิน-ขาวขลิบทองพิมพ์คำว่า LASVEGAS 889 แถบล่างระบุ รองรับทุกอุปกรณ์ ระบบทันสมัย ปลอดภัย และรองรับทุกธนาคาร"
          loading="lazy"
          fetchpriority="low"
          widths={[300, 450, 600]}
          sizes="(max-width: 639px) 85vw, (max-width: 1520px) 45vw, 600px"
          class={promoCardClass}
          decoding="async"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={80}
        />
      </div>

      <div class="mt-12 flex justify-center pb-4">
        <a
          href="/register"
          class="flex items-center justify-center rounded-lg border border-[#f2b829]/60 bg-gradient-to-r from-[#4d8dff] via-[#1f5ce0] to-[#0a1a45] px-10 py-3.5 text-lg font-black text-[#cddcf7] shadow-[0_10px_30px_rgba(31,92,224,0.28)] transition-transform hover:scale-105 hover:shadow-[0_15px_40px_rgba(63,220,255,0.40)]">
          สมัครสมาชิก LASVEGAS889
        </a>
      </div>
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
