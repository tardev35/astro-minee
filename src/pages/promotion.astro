---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement5.astro";

import { Picture } from "astro:assets";

import pro1 from "../assets/slide1.png";
import pro2 from "../assets/slide2.png";
import pro3 from "../assets/slide3.png";
import pro4 from "../assets/slide4.png";
import { pageGraph } from "../lib/schema";

// IMAGE PAGE, not an article: the whole body is the h1, one short intro
// paragraph, the four promo images and one CTA. Zero section headings and no
// second paragraph — the slides already print their own offer in large type, so
// prose underneath only re-types what the visitor can already read. The docx
// gives this route a Title and a Meta and never a body, so any heading or extra
// paragraph found here was invented by an earlier rebrand and gets deleted, not
// translated. Rendered inventory: h1x1, h2x0, h3x0.
//
// The alt text below was written by opening each PNG — the alt IS the Thai
// printed on the artwork (the offer, the sub-line, the button and the scene).
// DIAMOND789's slides are pink-diamond themed: ภารกิจประจำวัน / ชวนเพื่อนรับเพิ่ม
// / Lucky Hour / วงล้อเพชรแตก, and none of the outgoing brand's pirate wording
// survived. slide1-4 are all .png in this drop (on disk, all dated 2026-09-02 with
// the rest of the DIAMOND789 assets) and all four belong here; banner2.png is
// stale inventory from a previous brand and is deliberately NOT imported. No
// domain string appears in any alt — verify-build.mjs fails the build on a host
// found inside an attribute.
//
// <Announcement /> is bare on purpose: Announcement5's default message already
// carries this brand's copy, so the ticker matches index.astro with no second
// string to keep in sync here. The variant rotated off Announcement3, the
// outgoing brand's pick, per the brand spec.
const pageTitle = "โปรโมชั่น DIAMOND789 รวมสิทธิพิเศษสำหรับสมาชิก";

// Title and description are the docx SUB-PAGES row for /promotion, both shipped
// VERBATIM. The description is shorter than the DESC_MIN=150 floor and that is
// correct: the brief's own sentence is the brand's copy, not a draft to top up.
// verify-build.mjs exempts any description that appears literally in
// src/assets/content.txt for exactly this reason. Do not pad it.
const pageDescription = "DIAMOND789 รวมโปรโมชั่นสล็อตทุนน้อย โบนัส และสิทธิพิเศษตามเงื่อนไข พร้อมข้อมูลช่วยเลือกโปรให้เหมาะกับงบและรูปแบบการเล่น";

const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "โปรโมชั่น", path: "/promotion" },
  ],
  primaryImagePath: pro1.src,
});

// Hot pink carries the surfaces here (border, glow) and the brighter pink
// carries the hover state — the same read the artwork uses, a pink-edged card
// lifting to a highlight. A #1a0d16 edge on the near-black page would read as no
// border at all, so the resting border is the primary pink rather than the panel
// surface.
const promoCardClass =
  "mx-auto h-auto w-full rounded-xl border border-[#f30d8c]/40 object-contain shadow-[0_10px_30px_rgba(243,13,140,0.24)] transition-transform duration-300 hover:-translate-y-1 hover:border-[#ff5cb8]/65 hover:shadow-[0_15px_40px_rgba(243,13,140,0.3)]";
---

<MainLayout title="DIAMOND789 | โปรโมชั่นสล็อตทุนน้อยและสิทธิพิเศษสมาชิก" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={pageTitle} as="h1">
    <div>
      <p class="mb-8 text-left text-base leading-relaxed text-[#f8e3f0]">
        หน้านี้รวมโปรโมชั่นที่ <strong class="text-[#ff5cb8]">DIAMOND789</strong> เปิดให้สมาชิกสล็อตไว้ในที่เดียว ทั้งภารกิจประจำวัน ช่วง Lucky Hour โบนัสชวนเพื่อน และสิทธิ์หมุนวงล้อจากยอดฝาก ตัวเลขและเงื่อนไขหลักของแต่ละรายการพิมพ์อยู่บนภาพด้านล่างแล้ว
        ก่อนกดรับสิทธิ์ควรตรวจช่วงเวลาที่กำหนด ยอดฝากขั้นต่ำ และเงื่อนไขการถอนให้ครบ เพราะแต่ละรายการกำหนดไว้ไม่เท่ากันและปรับได้ตามรอบ
      </p>

      <div class="grid w-full grid-cols-1 gap-6 sm:grid-cols-2">
        <Picture
          src={pro1}
          alt="แบนเนอร์โปรโมชั่น DIAMOND789 ข้อความ ภารกิจประจำวัน ทำครบ 3 ภารกิจ รับกล่องสุ่ม 79 บาท ใต้ลงมาเป็นรายการภารกิจสามข้อติดเครื่องหมายถูกครบทุกข้อ ล็อกอิน ฝากเงิน และ หมุนเกม ถัดมาเป็นวงกลมสีชมพูเขียนว่า 79 บาท พร้อมปุ่ม รับภารกิจ ด้านขวาเป็นกล่องของขวัญสีชมพูผูกโบว์เรืองแสง ด้านซ้ายเป็นผู้หญิงในชุดรัดรูปสีดำสลับชมพูติดโลโก้ DIAMOND789 บนพื้นหลังสีดำชมพูที่มีเพชรเจียระไน วงล้อรูเล็ต ชิปคาสิโน และไพ่เอซ"
          loading="lazy"
          fetchpriority="low"
          widths={[300, 450, 600]}
          sizes="(max-width: 639px) 85vw, (max-width: 1520px) 45vw, 600px"
          class={promoCardClass}
          decoding="async"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={80}
        />

        <Picture
          src={pro2}
          alt="แบนเนอร์โปรโมชั่น DIAMOND789 ข้อความ ชวนเพื่อนรับเพิ่ม เพื่อนสมัครสำเร็จ รับทันที 89 บาท ใต้ข้อความเป็นแผนภาพสามขั้นตอนต่อกันด้วยลูกศร หนึ่ง ชวนเพื่อน สอง สมัครสำเร็จ สาม รับโบนัส แล้วมีแถบเขียนว่า รับสิทธิ์ง่าย โบนัสเข้าไว พร้อมปุ่ม ชวนเลย ด้านขวาเป็นผู้หญิงในชุดรัดรูปสีดำสลับชมพูถือโทรศัพท์ที่เปิดหน้าแอปของเว็บและชี้นิ้วมาที่หน้าจอ บนพื้นหลังสีดำชมพูที่มีเพชรเจียระไน กองเหรียญ ไพ่เอซ ลูกเต๋า และวงล้อรูเล็ต"
          loading="lazy"
          fetchpriority="low"
          widths={[300, 450, 600]}
          sizes="(max-width: 639px) 85vw, (max-width: 1520px) 45vw, 600px"
          class={promoCardClass}
          decoding="async"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={80}
        />

        <Picture
          src={pro3}
          alt="แบนเนอร์โปรโมชั่น DIAMOND789 ข้อความตัวใหญ่ Lucky Hour พร้อมช่วงเวลา 20:00 ถึง 21:00 ใต้ลงมาเขียนว่า เปิดหีบลับ ลุ้นรับ 29 หรือ 79 หรือ 179 เครดิต กับหมายเหตุ ร่วมสนุกเฉพาะช่วงเวลาที่กำหนด และปุ่ม เปิดเลย ด้านขวาเป็นหีบสมบัติสีชมพูเปิดออก มีเพชรและเหรียญล้นออกมาจากหีบ ด้านซ้ายเป็นผู้หญิงในชุดรัดรูปสีดำสลับชมพูยกมือแนบแก้มทำหน้าตื่นเต้น บนพื้นหลังสีดำชมพูที่มีเพชรเจียระไน วงล้อรูเล็ต ชิปคาสิโน และไพ่เอซ"
          loading="lazy"
          fetchpriority="low"
          widths={[300, 450, 600]}
          sizes="(max-width: 639px) 85vw, (max-width: 1520px) 45vw, 600px"
          class={promoCardClass}
          decoding="async"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={80}
        />

        <Picture
          src={pro4}
          alt="แบนเนอร์โปรโมชั่น DIAMOND789 ข้อความ วงล้อเพชรแตก ฝากครบ 300 รับสิทธิ์หมุน 1 ครั้ง ด้านขวาเป็นวงล้อรางวัลขอบไฟสีชมพู แบ่งช่องเป็น 39 เครดิต 89 เครดิต 189 เครดิต สลับกับช่อง ของรางวัล และ หมุนฟรี มีเพชรสีชมพูอยู่กลางวงล้อ ใต้ลงมาเป็นหมายเหตุ ลุ้นได้ทุกวันตามเงื่อนไข และปุ่ม หมุนเลย ด้านซ้ายเป็นผู้หญิงในชุดรัดรูปสีดำสลับชมพูติดโลโก้ DIAMOND789 ชี้นิ้วไปที่วงล้อ บนพื้นหลังสีดำชมพูที่มีชิปคาสิโน กองเหรียญ และเพชรเจียระไน"
          loading="lazy"
          fetchpriority="low"
          widths={[300, 450, 600]}
          sizes="(max-width: 639px) 85vw, (max-width: 1520px) 45vw, 600px"
          class={promoCardClass}
          decoding="async"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={80}
        />
      </div>

      <div class="mt-12 flex justify-center pb-4">
        <a
          href="/register"
          class="flex items-center justify-center rounded-lg border border-[#ff5cb8]/60 bg-gradient-to-r from-[#f30d8c] via-[#b312ac] to-[#b80568] px-10 py-3.5 text-lg font-black text-white shadow-[0_10px_30px_rgba(243,13,140,0.32)] transition-transform hover:scale-105 hover:shadow-[0_15px_40px_rgba(184,5,104,0.40)]">
          สมัครสมาชิก DIAMOND789
        </a>
      </div>
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
