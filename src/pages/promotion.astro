---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBoxPremium.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement5.astro";

import { Picture } from "astro:assets";

import pro1 from "../assets/slide1.png";
import pro2 from "../assets/slide2.png";
import pro3 from "../assets/slide3.png";
import pro4 from "../assets/slide4.png";
import { pageGraph } from "../lib/schema";

const pageDescription =
  "รวมโปรโมชั่น XFINITYPLAY ทั้งโบนัสต้อนรับ คืนยอดเสียรายวัน และเครดิตชวนเพื่อน พร้อมเงื่อนไขยอดฝาก จำนวนเทิร์น เกมที่ร่วมรายการ และเพดานถอนที่ควรอ่านก่อนกดรับ";

const graph = pageGraph(Astro, {
  name: "โปรโมชั่น XFINITYPLAY โบนัสต้อนรับ คืนยอดเสีย และเครดิตชวนเพื่อน",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "โปรโมชั่น", path: "/promotion" },
  ],
  primaryImagePath: pro1.src,
});
---

<MainLayout title="โปรโมชั่น XFINITYPLAY โบนัสต้อนรับ คืนยอดเสียรายวัน และเครดิตชวนเพื่อน" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="โปรโมชั่น XFINITYPLAY โบนัสต้อนรับ คืนยอดเสีย และเครดิตชวนเพื่อน" as="h1">
    <div>
      <h2 class="mb-4 text-2xl leading-normal font-bold text-[#22d3ee]">โปรโมชั่น XFINITYPLAY มีรายการอะไรบ้าง และควรอ่านเงื่อนไขจุดไหนก่อนกดรับ</h2>

      <p class="mb-5 text-left text-base leading-relaxed text-[#cfe3f5]">
        <strong class="text-[#a5f3fc]">XFINITYPLAY</strong> เป็นเว็บที่รวบรวมเกมสล็อตยอดนิยมจากหลายค่ายไว้ในระบบเดียว สิทธิ์ที่หน้านี้เปิดให้กดรับจึงผูกอยู่กับยอดฝากและเกมที่ร่วมรายการ
        ไม่ได้ลอยอยู่เดี่ยว ๆ บนแบนเนอร์ ตัวเลขใหญ่บนภาพบอกได้แค่ว่ามีอะไรให้ ส่วนบรรทัดเล็กใต้ตัวเลขคือคนที่ตัดสินว่าได้จริงเท่าไร ก่อนกดรับจึงควรไล่ให้ครบทั้ง 5 จุด
        คือยอดฝากขั้นต่ำของรายการนั้น เปอร์เซ็นต์โบนัสที่ได้รับ จำนวนเทิร์นที่ต้องทำ เกมและค่ายที่ร่วมรายการ และเพดานถอนสูงสุด เพราะโปรแต่ละแบบกำหนดเกมและเงื่อนไขถอนไม่เหมือนกัน
        การเลือกจากเปอร์เซ็นต์ที่สูงที่สุดเพียงอย่างเดียวจึงไม่ใช่วิธีที่ปลอดภัยที่สุด
      </p>

      <p class="mb-5 text-left text-base leading-relaxed text-[#cfe3f5]">
        รายการที่เห็นบนหน้านี้มีทั้งแบบรับครั้งเดียวและแบบรับตามรอบ เช่น โบนัสต้อนรับสำหรับการฝากครั้งแรก โบนัสสำหรับสมาชิกใหม่ คืนยอดเสียรายวัน และเครดิตจากการชวนเพื่อน
        ตัวเลขบนภาพควรใช้เป็นข้อมูลตั้งต้นแล้วตรวจจากหน้าโปรโมชั่นจริงในระบบอีกครั้งก่อนกด เพราะช่วงเวลาของสิทธิ์ ค่ายเกมที่ยกเว้น และการรับซ้อนกับรายการอื่นเป็นรายละเอียดที่เปลี่ยนได้ตามรอบ
        ถ้าแผนของคุณคือหมุนตามงบที่ตั้งไว้แล้วปิดจบ การไม่รับสิทธิ์เลยก็เป็นทางเลือกที่สมเหตุสมผล เพราะโบนัสที่ยังติดเทิร์นไม่ได้แปลว่าเงินอยู่ในมือแล้ว
      </p>

      <h2 class="mt-10 mb-4 text-2xl leading-normal font-bold text-[#22d3ee]">ฝากถอนไม่มีขั้นต่ำกับยอดขั้นต่ำของโปรโมชั่นเป็นคนละชุดตัวเลข</h2>

      <p class="mb-5 text-left text-base leading-relaxed text-[#cfe3f5]">
        เงื่อนไขฝากถอนไม่มีขั้นต่ำของ XFINITYPLAY ช่วยให้กำหนดยอดทำรายการได้ยืดหยุ่นขึ้นตามช่องทางที่เว็บไซต์กำหนด แต่เป็นคนละชุดตัวเลขกับยอดฝากขั้นต่ำที่โปรโมชั่นแต่ละรายการเขียนไว้
        รายการแบบฝากครั้งแรกรับเพิ่มมักมีเพดานโบนัสและยอดเริ่มต้นของตัวเอง ส่วนรายการคืนยอดเสียรายวันต้องดูว่าคำนวณจากยอดเสียสุทธิของช่วงเวลาไหน นับเฉพาะเกมที่ร่วมรายการหรือไม่ และปิดยอดกี่โมง
        ก่อนยืนยันจึงควรตรวจช่องทางที่รองรับ สถานะบัญชี และข้อกำหนดของโปรโมชั่นให้ตรงกัน เพื่อช่วยลดปัญหารายการล่าช้าหรือข้อมูลไม่ตรงกันภายหลัง
      </p>

      <p class="mb-8 text-left text-base leading-relaxed text-[#cfe3f5]">
        หลังกดรับสิทธิ์ ควรเปิดหน้าประวัติรายการดูว่ายอดโบนัสเข้าครบ เทิร์นเดินถูกเกม และยอดคงเหลือตรงกับที่ระบบแสดง เพราะบางรายการนับยอดเฉพาะสล็อตบางค่ายเท่านั้น
        ระบบเว็บตรงทำให้สมัคร เข้าสู่ระบบ เลือกเกม และตรวจสอบรายการได้จากหน้าเว็บไซต์เดียว จึงย้อนดูรายการได้เร็วโดยไม่ต้องสลับหลายหน้า หากยอดยังไม่ขยับไม่ควรกดซ้ำทันที เพราะระบบอาจกำลังประมวลผลอยู่
        และหากติดปัญหาเรื่องสถานะฝากถอนหรือเงื่อนไขโปรโมชั่น ทีมงานดูแลสมาชิกเปิดรับเรื่องตลอด 24 ชั่วโมงผ่านช่องทางที่เว็บไซต์ระบุ โดยไม่ต้องส่งรหัสผ่านหรือรหัสยืนยันให้ใครทั้งสิ้น
      </p>

      <div class="grid w-full grid-cols-1 gap-6 sm:grid-cols-2">
        <Picture
          src={pro1}
          alt="แบนเนอร์โปรโมชั่น XFINITYPLAY ข้อความ ฝากครั้งแรก รับเพิ่ม 50% โบนัสต้อนรับสุดคุ้ม พร้อมแถบด้านล่างระบุ มั่นคง ปลอดภัย ระบบมาตรฐานสากล ฝาก-ถอน ออโต้ และรองรับมือถือ 100%"
          loading="lazy"
          fetchpriority="low"
          widths={[300, 450, 600]}
          sizes="(max-width: 639px) 85vw, (max-width: 1520px) 45vw, 650px"
          class="mx-auto h-auto w-full rounded-xl border border-[#22d3ee]/25 object-contain shadow-[0_10px_30px_rgba(34,211,238,0.18)] transition-transform duration-300 hover:-translate-y-1 hover:border-[#a855f7]/50 hover:shadow-[0_15px_40px_rgba(168,85,247,0.30)]"
          decoding="async"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={80}
        />

        <Picture
          src={pro2}
          alt="แบนเนอร์โปรโมชั่น XFINITYPLAY ข้อความ คืนยอดเสียทุกวัน 10% สูงสุด 5,000 บาท พร้อมแถบด้านล่างระบุ มั่นคง ปลอดภัย ระบบมาตรฐานสากล ฝาก-ถอน ออโต้ และรองรับมือถือ 100%"
          loading="lazy"
          fetchpriority="low"
          widths={[300, 450, 600]}
          sizes="(max-width: 639px) 85vw, (max-width: 1520px) 45vw, 650px"
          class="mx-auto h-auto w-full rounded-xl border border-[#22d3ee]/25 object-contain shadow-[0_10px_30px_rgba(34,211,238,0.18)] transition-transform duration-300 hover:-translate-y-1 hover:border-[#a855f7]/50 hover:shadow-[0_15px_40px_rgba(168,85,247,0.30)]"
          decoding="async"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={80}
        />

        <Picture
          src={pro3}
          alt="แบนเนอร์โปรโมชั่น XFINITYPLAY ข้อความ ชวนเพื่อน รับเครดิตฟรี 300 บาท ชวนมาก ได้มาก พร้อมแถบด้านล่างระบุ มั่นคง ปลอดภัย ระบบมาตรฐานสากล ฝาก-ถอน ออโต้ และรองรับมือถือ 100%"
          loading="lazy"
          fetchpriority="low"
          widths={[300, 450, 600]}
          sizes="(max-width: 639px) 85vw, (max-width: 1520px) 45vw, 650px"
          class="mx-auto h-auto w-full rounded-xl border border-[#22d3ee]/25 object-contain shadow-[0_10px_30px_rgba(34,211,238,0.18)] transition-transform duration-300 hover:-translate-y-1 hover:border-[#a855f7]/50 hover:shadow-[0_15px_40px_rgba(168,85,247,0.30)]"
          decoding="async"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={80}
        />

        <Picture
          src={pro4}
          alt="แบนเนอร์โปรโมชั่น XFINITYPLAY ข้อความ สมาชิกใหม่ รับโบนัส 100% เริ่มสนุกได้ทันที พร้อมแถบด้านล่างระบุ มั่นคง ปลอดภัย ระบบมาตรฐานสากล ฝาก-ถอน ออโต้ และรองรับมือถือ 100%"
          loading="lazy"
          fetchpriority="low"
          widths={[300, 450, 600]}
          sizes="(max-width: 639px) 85vw, (max-width: 1520px) 45vw, 650px"
          class="mx-auto h-auto w-full rounded-xl border border-[#22d3ee]/25 object-contain shadow-[0_10px_30px_rgba(34,211,238,0.18)] transition-transform duration-300 hover:-translate-y-1 hover:border-[#a855f7]/50 hover:shadow-[0_15px_40px_rgba(168,85,247,0.30)]"
          decoding="async"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={80}
        />
      </div>

      <div class="mt-12 flex justify-center pb-4">
        <a
          href="/register"
          class="flex items-center justify-center rounded-lg border border-[#22d3ee]/60 bg-gradient-to-r from-[#a5f3fc] via-[#22d3ee] to-[#a855f7] px-10 py-3.5 text-lg font-black text-[#080520] shadow-[0_10px_30px_rgba(34,211,238,0.18)] transition-transform hover:scale-105 hover:shadow-[0_15px_40px_rgba(168,85,247,0.30)]">
          สมัครสมาชิก XFINITYPLAY
        </a>
      </div>
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
