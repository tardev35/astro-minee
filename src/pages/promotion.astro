---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBoxPremium.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/AnnouncementCyber.astro";

import { Picture } from "astro:assets";

import pro1 from "../assets/slide1.png";
import pro2 from "../assets/slide2.png";
import pro3 from "../assets/slide3.png";
import pro4 from "../assets/slide4.png";
import { pageGraph } from "../lib/schema";

const pageTitle = "โปรโมชั่นบาคาร่า KOHKAE789 สำหรับสมาชิกใหม่และผู้ใช้งานเดิม";

// docx SUB-PAGES Meta สำหรับหน้าโปรโมชั่น + ประโยคปิดท้ายหนึ่งวรรคให้ผ่านเกท 150
// นับเป็น "ตัวอักษร" ไม่ใช่ไบต์ (ภาษาไทย 3 ไบต์/ตัว) — สตริงนี้วัดได้ 155 ตัวอักษร
const pageDescription =
  "KOHKAE789 รวมโปรโมชั่นบาคาร่า โบนัสต้อนรับ และสิทธิพิเศษสำหรับสมาชิก พร้อมรายละเอียดเงื่อนไขก่อนเลือกรับสิทธิ์ให้เหมาะกับการใช้งาน ควรตรวจเงื่อนไขก่อนกดรับ";

const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "โปรโมชั่น", path: "/promotion" },
  ],
  primaryImagePath: pro1.src,
});
---

<MainLayout title="KOHKAE789 | โปรโมชั่นบาคาร่าและโบนัสพิเศษสำหรับสมาชิก" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={pageTitle} as="h1">
    <div>
      <h2 class="mb-4 text-2xl leading-normal font-bold text-[#7fdcff]">โปรโมชั่น KOHKAE789 มีรายการอะไรบ้าง และควรอ่านเงื่อนไขจุดไหนก่อนกดรับ</h2>

      <p class="mb-5 text-left text-base leading-relaxed text-[#cfe6f7]">
        <strong class="text-[#e8f6ff]">KOHKAE789</strong> เปิดโต๊ะบาคาร่าไว้หลายรูปแบบในระบบเดียว ทั้งโต๊ะที่เดิมพันต่อตาไม่สูงและเดินเกมได้ยาว โต๊ะที่วางเดิมพันต่อตาสูงขึ้นตามงบที่เตรียมมา
        และโต๊ะที่มีรูปแบบเดิมพันข้างอย่างคู่ไพ่หรือเสมอให้เลือกเพิ่ม สิทธิ์ที่หน้านี้เปิดให้กดรับจึงผูกอยู่กับยอดฝากและโต๊ะที่ร่วมรายการ ไม่ได้ลอยอยู่เดี่ยว ๆ บนแบนเนอร์
        ตัวเลขใหญ่บนภาพบอกได้แค่ว่ามีอะไรให้ ส่วนบรรทัดเล็กใต้ตัวเลขคือคนที่ตัดสินว่าได้จริงเท่าไร ก่อนกดรับจึงควรไล่ให้ครบทั้ง 5 จุด คือยอดฝากขั้นต่ำของรายการนั้น เปอร์เซ็นต์โบนัสที่ได้รับ
        จำนวนเทิร์นที่ต้องทำ โต๊ะและค่ายคาสิโนสดที่ร่วมรายการ และเพดานถอนสูงสุด เพราะโปรแต่ละแบบกำหนดโต๊ะและเงื่อนไขถอนไม่เหมือนกัน การเลือกจากเปอร์เซ็นต์ที่สูงที่สุดเพียงอย่างเดียวจึงไม่ใช่วิธีที่ปลอดภัยที่สุด
      </p>

      <p class="mb-5 text-left text-base leading-relaxed text-[#cfe6f7]">
        รายการที่แสดงบนหน้านี้มีสี่แบบ ทั้งชนิดรับครั้งเดียวและชนิดรับตามรอบ เริ่มจากสมาชิกใหม่ รับโบนัส 100% เริ่มสนุกได้ทันที ซึ่งเป็นสิทธิ์ครั้งเดียวของบัญชีที่เพิ่งเปิดใช้งาน
        ต่อด้วยฝากครั้งแรก รับเพิ่ม 50% โบนัสต้อนรับสุดคุ้ม ที่คิดจากยอดฝากรายการแรกและมักมีเพดานโบนัสของตัวเอง แล้วจึงเป็นคืนยอดเสียทุกวัน 10% สูงสุด 5,000 บาท ซึ่งคำนวณตามรอบวัน
        และปิดท้ายด้วยชวนเพื่อน รับเครดิตฟรี 300 บาท ชวนมาก ได้มาก ที่นับจากจำนวนเพื่อนซึ่งสมัครและเริ่มใช้งานจริงตามที่ระบบกำหนด
        ตัวเลขบนภาพควรใช้เป็นข้อมูลตั้งต้นแล้วตรวจจากหน้าโปรโมชั่นจริงในระบบอีกครั้งก่อนกด เพราะช่วงเวลาของสิทธิ์ โต๊ะที่ยกเว้น และการรับซ้อนกับรายการอื่นเป็นรายละเอียดที่เปลี่ยนได้ตามรอบ
        ถ้าแผนของคุณคือเล่นตามงบที่ตั้งไว้แล้วปิดจบ การไม่รับสิทธิ์เลยก็เป็นทางเลือกที่สมเหตุสมผล เพราะโบนัสที่ยังติดเทิร์นไม่ได้แปลว่าเงินอยู่ในมือแล้ว
      </p>

      <h2 class="mt-10 mb-4 text-2xl leading-normal font-bold text-[#7fdcff]">ยอดฝากที่คุณตั้งเองกับยอดขั้นต่ำของโปรโมชั่นเป็นคนละชุดตัวเลข</h2>

      <p class="mb-5 text-left text-base leading-relaxed text-[#cfe6f7]">
        ระบบออโต้ของ KOHKAE789 ช่วยให้กำหนดยอดทำรายการได้ยืดหยุ่นตามช่องทางที่เว็บไซต์กำหนด แต่ยอดที่คุณเลือกฝากเองเป็นคนละชุดตัวเลขกับยอดฝากขั้นต่ำที่โปรโมชั่นแต่ละรายการเขียนไว้
        รายการอย่างฝากครั้งแรกรับเพิ่ม 50% มีเพดานโบนัสและยอดเริ่มต้นของตัวเอง ส่วนรายการคืนยอดเสีย 10% ต้องดูว่าคำนวณจากยอดเสียสุทธิของช่วงเวลาไหน นับเฉพาะโต๊ะที่ร่วมรายการหรือไม่ ปิดยอดกี่โมง
        และเพดาน 5,000 บาทนับต่อวันหรือต่อรอบ ก่อนยืนยันจึงควรตรวจช่องทางที่รองรับ สถานะบัญชี และข้อกำหนดของโปรโมชั่นให้ตรงกัน เพื่อช่วยลดปัญหารายการล่าช้าหรือข้อมูลไม่ตรงกันภายหลัง
      </p>

      <p class="mb-8 text-left text-base leading-relaxed text-[#cfe6f7]">
        หลังกดรับสิทธิ์ ควรเปิดหน้าประวัติรายการดูว่ายอดโบนัสเข้าครบ เทิร์นเดินถูกโต๊ะ และยอดคงเหลือตรงกับที่ระบบแสดง เพราะบางรายการนับยอดเฉพาะโต๊ะบาคาร่าของค่ายคาสิโนสดบางค่าย
        และบางรายการไม่นับเดิมพันฝั่งเสมอหรือเดิมพันข้างที่วางคู่กันในตาเดียว ระบบออโต้ช่วยให้เข้าสู่ระบบ เลือกโต๊ะ ทำรายการ และตรวจสอบประวัติได้จากหน้าเว็บไซต์เดียว จึงย้อนดูรายการได้เร็วโดยไม่ต้องสลับหลายหน้า
        หากยอดยังไม่ขยับไม่ควรกดซ้ำทันที เพราะระบบอาจกำลังประมวลผลอยู่ และหากติดปัญหาเรื่องสถานะฝากถอนหรือเงื่อนไขโปรโมชั่น ทีมงานดูแลสมาชิกเปิดรับเรื่องตลอด 24 ชั่วโมงผ่านช่องทางที่เว็บไซต์ระบุ
        โดยไม่ต้องส่งรหัสผ่านหรือรหัสยืนยันให้ใครทั้งสิ้น
      </p>

      <div class="grid w-full grid-cols-1 gap-6 sm:grid-cols-2">
        <Picture
          src={pro1}
          alt="แบนเนอร์โปรโมชั่น KOHKAE789 ข้อความ สมาชิกใหม่ รับโบนัส 100% เริ่มสนุกได้ทันที พร้อมโลโก้รูปโล่และมาสคอตชายใส่แว่นสวมหน้ากากผ้าสีฟ้าในสูทน้ำเงินถือไพ่โพดำ ชิปคาสิโนและเหรียญทองบนพื้นหลังเมืองสีน้ำเงินเข้ม และแถบล่างระบุ มั่นคงปลอดภัย ฝากถอนออโต้ รองรับมือถือ บริการ 24 ชม."
          loading="lazy"
          fetchpriority="low"
          widths={[300, 450, 600]}
          sizes="(max-width: 639px) 85vw, (max-width: 1520px) 45vw, 600px"
          class="mx-auto h-auto w-full rounded-xl border border-[#29abe3]/30 object-contain shadow-[0_10px_30px_rgba(41,171,227,0.20)] transition-transform duration-300 hover:-translate-y-1 hover:border-[#1573e6]/55 hover:shadow-[0_15px_40px_rgba(21,115,230,0.30)]"
          decoding="async"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={80}
        />

        <Picture
          src={pro2}
          alt="แบนเนอร์โปรโมชั่น KOHKAE789 ข้อความ ฝากครั้งแรก รับเพิ่ม 50% โบนัสต้อนรับสุดคุ้ม พร้อมมาสคอตชายใส่แว่นสวมหน้ากากผ้าสีฟ้าในสูทน้ำเงินถือไพ่ ชิปคาสิโนและเหรียญทองบนพื้นหลังเมืองสีน้ำเงินเข้ม และแถบล่างระบุ มั่นคงปลอดภัย ฝากถอนออโต้ รองรับมือถือ บริการ 24 ชม."
          loading="lazy"
          fetchpriority="low"
          widths={[300, 450, 600]}
          sizes="(max-width: 639px) 85vw, (max-width: 1520px) 45vw, 600px"
          class="mx-auto h-auto w-full rounded-xl border border-[#29abe3]/30 object-contain shadow-[0_10px_30px_rgba(41,171,227,0.20)] transition-transform duration-300 hover:-translate-y-1 hover:border-[#1573e6]/55 hover:shadow-[0_15px_40px_rgba(21,115,230,0.30)]"
          decoding="async"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={80}
        />

        <Picture
          src={pro3}
          alt="แบนเนอร์โปรโมชั่น 3 ของ KOHKAE789 ข้อความ คืนยอดเสียทุกวัน 10% สูงสุด 5,000 บาท พร้อมมาสคอตชายใส่แว่นสวมหน้ากากผ้าสีฟ้าในสูทน้ำเงินถือไพ่ ชิปคาสิโนและเหรียญทองบนพื้นหลังเมืองสีน้ำเงินเข้ม และแถบล่างระบุ มั่นคงปลอดภัย ฝากถอนออโต้ รองรับมือถือ บริการ 24 ชม."
          loading="lazy"
          fetchpriority="low"
          widths={[300, 450, 600]}
          sizes="(max-width: 639px) 85vw, (max-width: 1520px) 45vw, 600px"
          class="mx-auto h-auto w-full rounded-xl border border-[#29abe3]/30 object-contain shadow-[0_10px_30px_rgba(41,171,227,0.20)] transition-transform duration-300 hover:-translate-y-1 hover:border-[#1573e6]/55 hover:shadow-[0_15px_40px_rgba(21,115,230,0.30)]"
          decoding="async"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={80}
        />

        <Picture
          src={pro4}
          alt="แบนเนอร์ PROMOTION 4 ของ KOHKAE789 ข้อความ ชวนเพื่อน รับเครดิตฟรี 300 บาท ชวนมาก ได้มาก พร้อมมาสคอตชายใส่แว่นสวมหน้ากากผ้าสีฟ้าในสูทน้ำเงินถือไพ่ ชิปคาสิโนและเหรียญทองบนพื้นหลังเมืองสีน้ำเงินเข้ม และแถบล่างระบุ ชวนง่าย รับทันที คุ้มค่า ปลอดภัย"
          loading="lazy"
          fetchpriority="low"
          widths={[300, 450, 600]}
          sizes="(max-width: 639px) 85vw, (max-width: 1520px) 45vw, 600px"
          class="mx-auto h-auto w-full rounded-xl border border-[#29abe3]/30 object-contain shadow-[0_10px_30px_rgba(41,171,227,0.20)] transition-transform duration-300 hover:-translate-y-1 hover:border-[#1573e6]/55 hover:shadow-[0_15px_40px_rgba(21,115,230,0.30)]"
          decoding="async"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={80}
        />
      </div>

      <div class="mt-12 flex justify-center pb-4">
        <a
          href="/register"
          class="flex items-center justify-center rounded-lg border border-[#1573e6]/60 bg-gradient-to-r from-[#5aa8ff] via-[#1573e6] to-[#0b3f96] px-10 py-3.5 text-lg font-black text-[#e8f6ff] shadow-[0_10px_30px_rgba(21,115,230,0.28)] transition-transform hover:scale-105 hover:shadow-[0_15px_40px_rgba(21,115,230,0.40)]">
          สมัครสมาชิก KOHKAE789
        </a>
      </div>
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
