---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement5.astro";

import { Picture } from "astro:assets";

import pro1 from "../assets/slide1.png";
import pro2 from "../assets/slide2.png";
import pro3 from "../assets/slide3.png";
import pro4 from "../assets/slide4.png";
import { pageGraph } from "../lib/schema";

// IMAGE PAGE, not an article: the whole body is the <h1>, one short intro
// paragraph, the four promo images and one CTA. No section headings and no
// second paragraph — the slides already print their own offer in large type,
// so prose underneath only re-types what the visitor can already read.
const pageTitle = "โปรโมชั่น เฮงเฮง888 รวมโบนัสและสิทธิพิเศษสำหรับสมาชิก";

// docx SUB-PAGES Meta ของหน้าโปรโมชั่น ยกถ้อยคำมาทั้งประโยค (125 ตัวอักษร)
// + วรรคปิดท้ายหนึ่งวรรคให้ผ่านเกท DESC_MIN 150 ของ tools/verify-build.mjs
// ซึ่งยกเว้นให้เฉพาะหน้าแรกเท่านั้น นับเป็น "ตัวอักษร" ไม่ใช่ไบต์ (ไทย 3 ไบต์/ตัว)
// — สตริงนี้วัดได้ 159 ตัวอักษร
const pageDescription =
  "เฮงเฮง888 รวมโปรโมชั่นสล็อต โบนัส และสิทธิพิเศษตามเงื่อนไข พร้อมรายละเอียดชัดเจน ช่วยให้เลือกโปรได้เหมาะกับงบและรูปแบบการเล่น ตรวจเงื่อนไขก่อนรับสิทธิ์ทุกครั้ง";

const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "โปรโมชั่น", path: "/promotion" },
  ],
  primaryImagePath: pro1.src,
});

// Hover border is gold rather than the palette's deepest green: a #05461f edge
// on the near-black green page is invisible, so the hover state would read as
// no state at all.
const promoCardClass =
  "mx-auto h-auto w-full rounded-xl border border-[#12a34f]/35 object-contain shadow-[0_10px_30px_rgba(18,163,79,0.20)] transition-transform duration-300 hover:-translate-y-1 hover:border-[#f5c518]/55 hover:shadow-[0_15px_40px_rgba(159,207,58,0.30)]";
---

<MainLayout title="เฮงเฮง888 | โปรโมชั่นสล็อตและสิทธิพิเศษสำหรับสมาชิก" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={pageTitle} as="h1">
    <div>
      <p class="mb-8 text-left text-base leading-relaxed text-[#e8f3e0]">
        หน้านี้รวมโปรโมชั่นที่ <strong class="text-[#f5c518]">เฮงเฮง888</strong> เปิดให้สมาชิกไว้ครบในที่เดียว ทั้งโบนัสสมาชิกใหม่ โบนัสฝากครั้งแรก ค่าคอมจากการแนะนำเพื่อน และเครดิตคืนยอดเสียรายวัน
        ตัวเลขและเงื่อนไขหลักของแต่ละรายการพิมพ์อยู่บนภาพด้านล่างแล้ว ก่อนกดรับสิทธิ์ควรตรวจยอดฝากที่กำหนด เกมที่ร่วมรายการ และเงื่อนไขการถอนให้ครบ เพราะแต่ละรายการกำหนดไว้ไม่เท่ากัน
      </p>

      <div class="grid w-full grid-cols-1 gap-6 sm:grid-cols-2">
        <Picture
          src={pro1}
          alt="แบนเนอร์โปรโมชั่น เฮงเฮง888 ข้อความ สมาชิกใหม่ รับโบนัส 50% สมัครวันนี้ รับสิทธิ์ทันที พร้อมบรรทัด โบนัสต้อนรับสำหรับผู้เล่นใหม่ และปุ่มสีเขียว รับโปรเลย ตัวเลข 50% ขนาดใหญ่สีขาวขอบทอง มุมซ้ายบนเป็นโลโก้ เฮงเฮง888 ตัวอักษรสีขาววางบนเลข 888 สีเขียวมะนาว ด้านขวาเป็นผู้หญิงในชุดครอปสีเขียว-ขาวพิมพ์คำว่า เฮงเฮง888 ชี้นิ้วขึ้น มุมล่างซ้ายเป็นวงล้อสล็อตเลข 777 กับกองเหรียญทอง บนพื้นหลังสีเขียวเข้ม"
          loading="lazy"
          fetchpriority="low"
          widths={[300, 450, 600]}
          sizes="(max-width: 639px) 85vw, (max-width: 1520px) 45vw, 600px"
          class={promoCardClass}
          decoding="async"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={80}
        />

        <Picture
          src={pro2}
          alt="แบนเนอร์โปรโมชั่น เฮงเฮง888 ข้อความ ฝากครั้งแรก รับเพิ่ม 20% พร้อมบรรทัด คุ้มตั้งแต่ฝากแรก และป้ายย่อย ฝากง่าย ถอนเร็ว ระบบออโต้ กับปุ่มสีเขียว ฝากเลย ตัวเลข 20% ขนาดใหญ่สีขาวขอบทอง ด้านบนเป็นโลโก้ เฮงเฮง888 ตัวอักษรสีขาววางบนเลข 888 สีเขียวมะนาว ด้านซ้ายเป็นผู้หญิงในชุดครอปสีเขียว-ขาวพิมพ์คำว่า เฮงเฮง888 ชี้นิ้วมาทางข้อความ ฉากหลังเป็นตู้สล็อตป้าย JACKPOT วงล้อเลข 7 ชิปคาสิโนสีเขียวและกองเหรียญทอง"
          loading="lazy"
          fetchpriority="low"
          widths={[300, 450, 600]}
          sizes="(max-width: 639px) 85vw, (max-width: 1520px) 45vw, 600px"
          class={promoCardClass}
          decoding="async"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={80}
        />

        <Picture
          src={pro3}
          alt="แบนเนอร์โปรโมชั่น เฮงเฮง888 ข้อความ แนะนำเพื่อน รับค่าคอม 10% พร้อมบรรทัด ชวนเพื่อน ยิ่งชวนยิ่งคุ้ม และแผนภาพสามขั้นตอน ส่งลิงก์แนะนำ เพื่อนสมัคร รับค่าคอม กับปุ่มสีเขียว ชวนเลย ตัวเลข 10% ขนาดใหญ่สีทอง ด้านบนเป็นโลโก้ เฮงเฮง888 ตัวอักษรสีขาววางบนเลข 888 สีเขียวมะนาว ด้านขวาเป็นผู้หญิงในชุดกีฬาสีเขียว-ขาวพิมพ์คำว่า เฮงเฮง888 ชี้นิ้วขึ้น แถบล่างระบุ มั่นคงปลอดภัย เชื่อถือได้ 100% บริการตลอด 24 ชม. และถอนง่ายจ่ายไวไม่ต้องรอนาน"
          loading="lazy"
          fetchpriority="low"
          widths={[300, 450, 600]}
          sizes="(max-width: 639px) 85vw, (max-width: 1520px) 45vw, 600px"
          class={promoCardClass}
          decoding="async"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={80}
        />

        <Picture
          src={pro4}
          alt="แบนเนอร์โปรโมชั่น เฮงเฮง888 ข้อความ คืนยอดเสียทุกวัน 0.8% พร้อมบรรทัด เล่นต่อได้ทุกวัน และ คืนยอดเสียคุ้มค่า ไม่พลาดทุกความสนุก กับป้ายย่อย ระบบออโต้ โบนัสคุ้ม บริการ 24 ชม. และปุ่มสีเขียว รับสิทธิ์ ตัวเลข 0.8% ขนาดใหญ่สีขาวขอบทอง ด้านบนเป็นโลโก้ เฮงเฮง888 ตัวอักษรสีขาววางบนเลข 888 สีเขียวมะนาว ด้านขวาเป็นผู้หญิงในชุดครอปสีเขียว-ขาวพิมพ์คำว่า เฮงเฮง888 ชี้นิ้วขึ้น ฉากหลังเป็นตู้สล็อตเลข 777 ชิปคาสิโนสีเขียว กล่องของขวัญผูกโบว์ทอง และกองเหรียญทอง"
          loading="lazy"
          fetchpriority="low"
          widths={[300, 450, 600]}
          sizes="(max-width: 639px) 85vw, (max-width: 1520px) 45vw, 600px"
          class={promoCardClass}
          decoding="async"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={80}
        />
      </div>

      <div class="mt-12 flex justify-center pb-4">
        <a
          href="/register"
          class="flex items-center justify-center rounded-lg border border-[#f5c518]/60 bg-gradient-to-r from-[#1fc465] via-[#12a34f] to-[#05461f] px-10 py-3.5 text-lg font-black text-[#e8f3e0] shadow-[0_10px_30px_rgba(18,163,79,0.28)] transition-transform hover:scale-105 hover:shadow-[0_15px_40px_rgba(159,207,58,0.40)]">
          สมัครสมาชิก เฮงเฮง888
        </a>
      </div>
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
