---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement3.astro";

import { Picture } from "astro:assets";

import pro1 from "../assets/slide1.png";
import pro2 from "../assets/slide2.png";
import pro3 from "../assets/slide3.png";
import pro4 from "../assets/slide4.png";
import { pageGraph } from "../lib/schema";

// IMAGE PAGE, not an article: the whole body is the <h1>, one short intro
// paragraph, the four promo images and one CTA. No section headings and no
// second paragraph — the slides already print their own offer in large type,
// so prose underneath only re-types what the visitor can already read.
//
// Every alt below was written by opening the file with the Read tool and
// transcribing the Thai printed on the artwork — the offer, the sub-line, the
// button and the scene. The wordmark drawn on the artwork reads "77Lotto";
// the brand name in copy and alt text is LOTTO77, so the alt names the logo by
// the brand, not by the lettering.
const pageTitle = "โปรโมชั่น LOTTO77 รวมสิทธิพิเศษสำหรับสมาชิกสายหวย";

// docx SUB-PAGES Meta ของหน้าโปรโมชั่น + วรรคปิดท้ายหนึ่งวรรคให้ผ่านเกท
// DESC_MIN 150 ของ tools/verify-build.mjs ซึ่งยกเว้นให้เฉพาะหน้าแรกเท่านั้น
// นับเป็น "ตัวอักษร" ไม่ใช่ไบต์ (ไทย 3 ไบต์/ตัว) — สตริงนี้วัดได้ 159 ตัวอักษร
const pageDescription =
  "LOTTO77 รวมโปรโมชั่นหวยออนไลน์ โบนัสและสิทธิพิเศษตามเงื่อนไข พร้อมรายละเอียดชัดเจน ช่วยให้เลือกโปรได้เหมาะกับงบและรูปแบบการซื้อหวย ควรอ่านเงื่อนไขก่อนรับสิทธิ์";

const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "โปรโมชั่น", path: "/promotion" },
  ],
  primaryImagePath: pro1.src,
});

// Hover border is gold rather than the palette's deep red: a #7d0000 edge on
// the near-black maroon page is invisible, so the hover state would read as no
// state at all.
const promoCardClass =
  "mx-auto h-auto w-full rounded-xl border border-[#d81220]/35 object-contain shadow-[0_10px_30px_rgba(216,18,32,0.20)] transition-transform duration-300 hover:-translate-y-1 hover:border-[#f5c451]/55 hover:shadow-[0_15px_40px_rgba(245,196,81,0.30)]";
---

<MainLayout title="LOTTO77 | โปรโมชั่นหวยออนไลน์และสิทธิพิเศษสำหรับสมาชิก" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={pageTitle} as="h1">
    <div>
      <p class="mb-8 text-left text-base leading-relaxed text-[#f3ded7]">
        หน้านี้รวมโปรโมชั่นที่ <strong class="text-[#f5c451]">LOTTO77</strong> เปิดให้สมาชิกไว้ในที่เดียว ทั้งเครดิตฟรีสำหรับสมาชิกใหม่ ส่วนลดช่วงนาทีทอง วงล้อเลขนำโชค และเครดิตคืนตามยอดซื้อในแต่ละงวด
        ตัวเลขและเงื่อนไขหลักของแต่ละรายการพิมพ์อยู่บนภาพด้านล่างแล้ว ก่อนกดรับสิทธิ์ควรตรวจยอดซื้อขั้นต่ำ ช่วงเวลาที่กำหนด และเงื่อนไขการรับเครดิตให้ครบ เพราะแต่ละรายการกำหนดไว้ไม่เท่ากัน
      </p>

      <div class="grid w-full grid-cols-1 gap-6 sm:grid-cols-2">
        <Picture
          src={pro1}
          alt="แบนเนอร์โปรโมชั่น LOTTO77 ข้อความ สมาชิกใหม่ รับเครดิตฟรีซื้อหวย โดยตัวเลข 50 บาท เป็นตัวทองขนาดใหญ่ พร้อมสองบรรทัดในกรอบ สมัครวันนี้ รับสิทธิ์ทันที และ โปรต้อนรับสำหรับสายหวย กับปุ่มแดงขอบทองคำว่า รับโปรเลย ด้านบนเป็นโลโก้ LOTTO77 ตัวอักษรขาวบนป้ายสีแดง ด้านขวาเป็นผู้หญิงในชุดกี่เพ้าสีแดงเลื่อมถือสลากกินแบ่งรัฐบาลคลี่เป็นพัด ด้านซ้ายล่างเป็นตารางเลขยี่กี ด้านขวาล่างเป็นตารางเลขหวยรัฐบาล ฉากหลังสีแดงเข้มมีลูกบอลหวยเลข 77 เลข 3 เลข 1 เลข 9 และเหรียญทองกระจายอยู่"
          loading="lazy"
          fetchpriority="low"
          widths={[300, 450, 600]}
          sizes="(max-width: 639px) 85vw, (max-width: 1520px) 45vw, 600px"
          class={promoCardClass}
          decoding="async"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={80}
        />

        <Picture
          src={pro2}
          alt="แบนเนอร์โปรโมชั่น LOTTO77 ข้อความ นาทีทอง 19:00 ถึง 21:00 ซื้อหวยรับส่วนลด โดยตัวเลข 10% เป็นตัวทองขนาดใหญ่ พร้อมบรรทัด เฉพาะช่วงเวลาที่กำหนด และปุ่มแดงขอบทองคำว่า ร่วมโปรเลย ด้านบนเป็นโลโก้ LOTTO77 ตัวอักษรขาวบนป้ายสีแดง ฉากหลังเป็นหน้าปัดนาฬิกาสีทองและริบบิ้นทองพลิ้วบนพื้นสีแดงเข้ม ด้านขวาเป็นผู้หญิงในชุดกี่เพ้าสีแดงเลื่อมถือสลากกินแบ่งรัฐบาลคลี่เป็นพัด ด้านล่างมีลูกบอลหวยเลข 77 และเลข 7 กับกองเหรียญทอง"
          loading="lazy"
          fetchpriority="low"
          widths={[300, 450, 600]}
          sizes="(max-width: 639px) 85vw, (max-width: 1520px) 45vw, 600px"
          class={promoCardClass}
          decoding="async"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={80}
        />

        <Picture
          src={pro3}
          alt="แบนเนอร์โปรโมชั่น LOTTO77 ข้อความ วงล้อเลขนำโชค ลุ้นเครดิตซื้อหวยสูงสุด โดยตัวเลข 888 บาท เป็นตัวทองขนาดใหญ่ พร้อมบรรทัด หมุนฟรีทุกวัน ลุ้นรับทันที และปุ่มแดงขอบทองคำว่า หมุนเลย ด้านบนเป็นโลโก้ LOTTO77 ตัวอักษรขาวบนป้ายสีแดง ด้านขวาเป็นวงล้อเสี่ยงโชคขนาดใหญ่ขอบไฟทอง แบ่งเป็นช่องสีเขียว ม่วง ส้ม และครีม มีเลข 77 99 24 38 17 89 45 และ 16 เรียงรอบดุมกลางที่มีโลโก้แบรนด์ ข้างวงล้อเป็นผู้หญิงในชุดกี่เพ้าสีแดงเลื่อมยกมือชี้ไปที่วงล้อ ด้านล่างเป็นสลากกินแบ่งรัฐบาลสองใบ ลูกบอลหวยเลข 77 เลข 11 เลข 8 เลข 3 และเหรียญทอง"
          loading="lazy"
          fetchpriority="low"
          widths={[300, 450, 600]}
          sizes="(max-width: 639px) 85vw, (max-width: 1520px) 45vw, 600px"
          class={promoCardClass}
          decoding="async"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={80}
        />

        <Picture
          src={pro4}
          alt="แบนเนอร์โปรโมชั่น LOTTO77 ข้อความ ซื้อหวยครบ 300 บาท รับคืน 5% ทุกงวด โดยตัวเลข 300 และ 5% เป็นตัวทองขนาดใหญ่ พร้อมบรรทัด ยิ่งซื้อ ยิ่งคุ้ม และปุ่มแดงขอบทองคำว่า รับสิทธิ์ ด้านบนเป็นโลโก้ LOTTO77 ตัวอักษรขาวบนป้ายสีแดง ด้านขวาเป็นผู้หญิงในชุดกี่เพ้าสีแดงเลื่อมถือสลากกินแบ่งรัฐบาลคลี่เป็นพัด สองมุมล่างเป็นตารางเลขหวย ฉากหลังสีแดงเข้มมีลูกบอลหวยเลข 7 เลข 3 เลข 8 และเหรียญทองกระจายอยู่"
          loading="lazy"
          fetchpriority="low"
          widths={[300, 450, 600]}
          sizes="(max-width: 639px) 85vw, (max-width: 1520px) 45vw, 600px"
          class={promoCardClass}
          decoding="async"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={80}
        />
      </div>

      <div class="mt-12 flex justify-center pb-4">
        <a
          href="/register"
          class="flex items-center justify-center rounded-lg border border-[#f5c451]/60 bg-gradient-to-r from-[#ff3d3d] via-[#d81220] to-[#7d0000] px-10 py-3.5 text-lg font-black text-[#ffe08a] shadow-[0_10px_30px_rgba(216,18,32,0.28)] transition-transform hover:scale-105 hover:shadow-[0_15px_40px_rgba(245,196,81,0.40)]">
          สมัครสมาชิก LOTTO77
        </a>
      </div>
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
