---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/AnnouncementCyber.astro";

import { Picture } from "astro:assets";

import pro1 from "../assets/slide1.png";
import pro2 from "../assets/slide2.png";
import pro3 from "../assets/slide3.png";
import pro4 from "../assets/slide4.png";
import { pageGraph } from "../lib/schema";

// IMAGE PAGE, not an article: the whole body is the h1, one short intro
// paragraph, the four promo images and one CTA. Zero section headings and no
// second paragraph — the slides already print their own offer in large type, so
// prose underneath only re-types what the visitor can already read. The docx
// gives this route a Title and a Meta and never a body, so any heading or extra
// paragraph found here was invented by an earlier rebrand and gets deleted, not
// translated. Rendered inventory: h1x1, h2x0, h3x0.
//
// The alt text below is the Thai printed on each slide plus the scene it draws —
// the offer, the sub-line, the badge and the artwork. All four strings were
// rewritten from scratch against the images in this drop (read with the Read
// tool): the artwork moved from red-and-gold Thai lottery to turquoise Pattaya
// beach neon, so the outgoing brand's descriptions could not be renamed, only
// replaced. Slide order on disk is slide1 สมาชิกใหม่รับโบนัส 88, slide2 ชวนเพื่อน
// รับเพิ่ม 300, slide3 ภารกิจรายวัน ทำครบรับของรางวัล, slide4 นาทีทอง เติมครบ 500
// รับเพิ่ม 20%. All four are .png in this drop (2026-09-14) and all four belong
// here; banner2.png is dated 2026-08-13, predates the drop, and is deliberately
// NOT imported anywhere.
//
// The wordmark drawn into these pixels matches this brand's own name, so the alt
// may say it; what no alt carries is a domain string — verify-build.mjs fails the
// build on a host found inside an attribute. The English script lines painted in
// the corners of slides 2 to 4 are decorative and are described rather than
// transcribed one by one.
//
// <Announcement /> is bare on purpose: AnnouncementCyber's default message
// already carries this brand's copy, so the ticker matches index.astro with no
// second string to keep in sync here. The variant rotated off AnnouncementHuay,
// the outgoing brand's pick, per the brand spec.
const pageTitle = "โปรโมชั่น PATTAYA168 รวมสิทธิพิเศษสล็อตสำหรับสมาชิก";

// Title and description are the docx SUB-PAGES row for /promotion, both shipped
// VERBATIM. The description is shorter than the DESC_MIN=150 floor (134
// characters), and that is correct: the brief's own sentence is the brand's
// copy, not a draft to top up. verify-build.mjs exempts any description that
// appears literally in src/assets/content.txt for exactly this reason. Do not
// pad it.
const pageDescription = "PATTAYA168 รวมโปรโมชั่นสล็อต โบนัส และสิทธิพิเศษตามเงื่อนไข พร้อมข้อมูลช่วยเลือกโปรให้เหมาะกับงบ สมัครสมาชิกเพื่อดูสิทธิ์ล่าสุดได้ง่าย";

const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "โปรโมชั่น", path: "/promotion" },
  ],
  primaryImagePath: pro1.src,
});

// Deep cyan carries the card edge at rest and the primary turquoise carries the
// glow — the two hues of the artwork, which is a turquoise Pattaya bay at night
// with gold coins over it. The slides are themselves mostly turquoise and gold,
// so the frame stays on the deep end (#0c8ba4) at rest and only lifts to the
// bright cyan (#02c4e3) on hover; a bright rim at rest would blur into the
// picture it is supposed to contain. No red and no gold rim — that pair was the
// outgoing brand's hue and none of this artwork leads with it.
const promoCardClass =
  "mx-auto h-auto w-full rounded-xl border border-[#0c8ba4]/55 object-contain shadow-[0_10px_30px_rgba(2,196,227,0.22)] transition-transform duration-300 hover:-translate-y-1 hover:border-[#02c4e3]/70 hover:shadow-[0_15px_40px_rgba(2,196,227,0.32)]";
---

<MainLayout title="PATTAYA168 | โปรโมชั่นสล็อตลิขสิทธิ์และสิทธิพิเศษสมาชิก" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={pageTitle} as="h1">
    <div>
      <p class="mb-8 text-left text-base leading-relaxed">
        หน้านี้รวมโปรโมชั่นสล็อตที่ <strong class="text-[#8ff5ff]">PATTAYA168</strong> เปิดให้สมาชิกไว้ในที่เดียว ทั้งโบนัสสมาชิกใหม่ สิทธิ์จากการชวนเพื่อน ภารกิจรายวัน และกิจกรรมเฉพาะช่วงเวลา รายละเอียดหลักของแต่ละรายการพิมพ์อยู่บนภาพด้านล่างแล้ว
        ก่อนกดรับสิทธิ์ควรตรวจยอดขั้นต่ำ เกมและค่ายที่ร่วมรายการ ระยะเวลา และเงื่อนไขการถอนของรายการนั้นอีกครั้ง เพราะแต่ละโปรกำหนดเงื่อนไขไว้ไม่เท่ากันและปรับเปลี่ยนได้ตามช่วงกิจกรรม
      </p>

      <div class="grid w-full grid-cols-1 gap-6 sm:grid-cols-2">
        <Picture
          src={pro1}
          alt="แบนเนอร์โปรโมชั่นโทนฟ้าเทอร์ควอยซ์-ทอง กลางด้านบนเป็นโลโก้เว็บไซต์รูปวงกลมสีฟ้าที่มีต้นปาล์มสีขาวอยู่เหนือคลื่นน้ำ ใต้ลงมาเป็นตัวอักษร PATTAYA และลูกบอลสีส้มสามลูกเรียงเป็นเลข 168 กลางภาพเป็นพาดหัวตัวใหญ่ว่า สมาชิกใหม่รับโบนัส พร้อมเลข 88 ตัวทองขนาดใหญ่ ถัดลงมาเขียนว่า เปิดยูสวันนี้ รับสิทธิ์ทันที และป้ายมงกุฎสองข้างเขียนว่า เฉพาะสมาชิกใหม่ แถบล่างสุดมีไอคอนกำกับสามช่องว่า สมัครฟรี รับไว และ ใช้งานง่าย ด้านซ้ายเป็นผู้หญิงในชุดสีส้มสลับเทอร์ควอยซ์ ขยิบตาและชี้นิ้วมาข้างหน้า ฉากหลังเป็นเส้นขอบฟ้าเมืองพัทยายามค่ำคืน มีเหรียญทอง ชิปคาสิโนสีฟ้า และไพ่โพดำกระจายอยู่รอบภาพ"
          loading="lazy"
          fetchpriority="low"
          widths={[300, 450, 600]}
          sizes="(max-width: 639px) 85vw, (max-width: 1520px) 45vw, 600px"
          class={promoCardClass}
          decoding="async"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={80}
        />

        <Picture
          src={pro2}
          alt="แบนเนอร์โปรโมชั่นชวนเพื่อนโทนฟ้าเทอร์ควอยซ์-ทอง กลางด้านบนเป็นโลโก้เว็บไซต์รูปวงกลมสีฟ้าที่มีต้นปาล์มสีขาวเหนือคลื่นน้ำ ตัวอักษร PATTAYA และลูกบอลสีส้มสามลูกเรียงเป็นเลข 168 กลางภาพเป็นพาดหัวตัวใหญ่ว่า ชวนเพื่อน ใต้ลงมาเป็นแถบทองเขียนว่า รับเพิ่ม พร้อมเลข 300 ตัวทองขนาดใหญ่ และบรรทัดล่างว่า เพื่อนสมัครสำเร็จ รับโบนัสทันที ถัดลงมาเป็นสามขั้นตอนมีเลขกำกับและลูกศรคั่นว่า แชร์ลิงก์ เพื่อนสมัคร และ รับโบนัส ด้านซ้ายเป็นผู้หญิงในเสื้อคลุมสีเทอร์ควอยซ์ ขยิบตาและชี้นิ้วมาข้างหน้า มืออีกข้างถือโทรศัพท์ที่หน้าจอมีโลโก้เว็บไซต์ ไอคอนแชร์ และข้อความว่า แชร์ให้เพื่อน รับโบนัสด้วยกัน ริมซ้ายมีข้อความลายมือว่า ยิ่งชวน ยิ่งรวย ไปด้วยกัน มุมซ้ายล่างเป็นแผ่นป้ายทองและชิปคาสิโนสีฟ้า ฉากหลังเป็นอ่าวพัทยายามค่ำคืน ตึกสูง ต้นปาล์ม และเหรียญทองปลิวอยู่รอบภาพ"
          loading="lazy"
          fetchpriority="low"
          widths={[300, 450, 600]}
          sizes="(max-width: 639px) 85vw, (max-width: 1520px) 45vw, 600px"
          class={promoCardClass}
          decoding="async"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={80}
        />

        <Picture
          src={pro3}
          alt="แบนเนอร์โปรโมชั่นภารกิจรายวันโทนฟ้าเทอร์ควอยซ์-ทอง กลางด้านบนเป็นโลโก้เว็บไซต์รูปวงกลมสีฟ้าที่มีต้นปาล์มสีขาวเหนือคลื่นน้ำ ตัวอักษร PATTAYA และลูกบอลสีส้มสามลูกเรียงเป็นเลข 168 กลางภาพเป็นพาดหัวตัวใหญ่มีมงกุฎทองวางอยู่ด้านบนว่า ภารกิจรายวัน ใต้ลงมาว่า ทำครบรับของรางวัล และบรรทัดเล็กว่า สะสมแต้ม แลกรับสิทธิ์สุดคุ้ม ถัดลงมาเป็นสามขั้นตอนมีไอคอนและลูกศรคั่นว่า เช็กอิน ทำภารกิจ และ รับรางวัล ด้านซ้ายเป็นผู้หญิงในชุดกีฬาสีเทอร์ควอยซ์ที่มีโลโก้เว็บไซต์อยู่บนเสื้อ ขยิบตาและชี้นิ้วมาข้างหน้า ริมซ้ายเป็นแผ่นป้ายมังกรทองเขียนว่า SLOT ริมขวาเป็นป้ายไพ่เขียนว่า CASINO และป้ายลูกฟุตบอลเขียนว่า SPORTS มุมขวาบนเป็นป้ายไม้เขียนว่า PATTAYA 168 แถวล่างเป็นกล่องของขวัญสีเทอร์ควอยซ์ผูกโบว์ทอง เหรียญทอง และชิปคาสิโนที่มีชื่อ PATTAYA168 ฉากหลังเป็นต้นปาล์มและท้องฟ้ายามค่ำคืน"
          loading="lazy"
          fetchpriority="low"
          widths={[300, 450, 600]}
          sizes="(max-width: 639px) 85vw, (max-width: 1520px) 45vw, 600px"
          class={promoCardClass}
          decoding="async"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={80}
        />

        <Picture
          src={pro4}
          alt="แบนเนอร์โปรโมชั่นนาทีทองโทนทอง-ฟ้าเทอร์ควอยซ์ กลางด้านบนเป็นโลโก้เว็บไซต์รูปวงกลมสีฟ้าที่มีต้นปาล์มสีขาวเหนือคลื่นน้ำ ตัวอักษร PATTAYA และลูกบอลสีส้มสามลูกเรียงเป็นเลข 168 มุมขวาบนเป็นหน้าปัดนาฬิกาทองเลขโรมันขนาดใหญ่ที่มีคำว่า GOLDEN HOUR อยู่บนหน้าปัด กลางซ้ายเป็นพาดหัวตัวทองขนาดใหญ่มีมงกุฎวางอยู่ด้านบนว่า นาทีทอง ใต้ลงมาเป็นแถบเขียนว่า เติมครบ 500 และ รับเพิ่ม 20 เปอร์เซ็นต์ ถัดลงมาเป็นสองบรรทัดที่มีไอคอนกำกับว่า เฉพาะช่วงกิจกรรม และ ลุ้นสนุกได้ทุกวัน ด้านขวาเป็นผู้หญิงในชุดราตรีเลื่อมทองเปิดหลัง เกล้าผมและหันมามองข้ามไหล่ มุมซ้ายล่างเป็นวงล้อสล็อตที่ขึ้นเลข 777 ฉากหลังด้านซ้ายเป็นต้นปาล์มกับอ่าวพัทยายามค่ำคืน มีเหรียญทองและชิปคาสิโนสีฟ้ากระจายอยู่รอบภาพ"
          loading="lazy"
          fetchpriority="low"
          widths={[300, 450, 600]}
          sizes="(max-width: 639px) 85vw, (max-width: 1520px) 45vw, 600px"
          class={promoCardClass}
          decoding="async"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={80}
        />
      </div>

      <div class="mt-12 flex justify-center pb-4">
        <a
          href="/register"
          class="flex items-center justify-center rounded-lg border border-[#fdac13]/60 bg-gradient-to-r from-[#5afef1] via-[#02c4e3] to-[#0c8ba4] px-10 py-3.5 text-lg font-black text-[#021c22] shadow-[0_10px_30px_rgba(2,196,227,0.34)] transition-transform hover:scale-105 hover:shadow-[0_15px_40px_rgba(253,172,19,0.45)]">
          สมัครสมาชิก PATTAYA168
        </a>
      </div>
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
