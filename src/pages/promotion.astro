---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement2.astro";

import { Picture } from "astro:assets";

import pro1 from "../assets/slide1.png";
import pro2 from "../assets/slide2.png";
import pro3 from "../assets/slide3.png";
import pro4 from "../assets/slide4.png";
import { pageGraph } from "../lib/schema";

// IMAGE PAGE, not an article: the whole body is the h1, one short intro
// paragraph, the four promo images and one CTA. Zero section headings and no
// second paragraph — the slides already print their own offer in large type, so
// prose underneath only re-types what the visitor can already read. The docx
// gives this route a Title and a Meta and never a body, so any heading or extra
// paragraph found here was invented by an earlier rebrand and gets deleted, not
// translated. Rendered inventory: h1x1, h2x0, h3x0.
//
// The alt text below is the Thai printed on each ORA2U slide plus the scene it
// draws — the offer, the sub-line, the button and the artwork. Slide order on
// disk is: slide1 ภารกิจประจำวัน, slide2 Lucky Hour, slide3 วงล้อแต้มทอง,
// slide4 ชวนเพื่อนรับเพิ่ม. The outgoing brand's alts described the same four
// files in a different order, so every string here was rewritten rather than
// renamed. slide1-4 are all .png in this drop (2026-09-03) and all four belong
// here; banner2.png is dated 2026-08-13, predates the drop, and is deliberately
// NOT imported anywhere. No domain string appears in any alt — verify-build.mjs
// fails the build on a host found inside an attribute.
//
// <Announcement /> is bare on purpose: Announcement2's default message already
// carries this brand's copy, so the ticker matches index.astro with no second
// string to keep in sync here. The variant rotated off Announcement5, the
// outgoing brand's pick, per the brand spec.
const pageTitle = "โปรโมชั่น ORA2U รวมสิทธิพิเศษสำหรับสมาชิกสล็อตและคาสิโน";

// Title and description are the docx SUB-PAGES row for /promotion, both shipped
// VERBATIM. The description is 113 characters, shorter than the DESC_MIN=150
// floor, and that is correct: the brief's own sentence is the brand's copy, not
// a draft to top up. verify-build.mjs exempts any description that appears
// literally in src/assets/content.txt for exactly this reason. Do not pad it.
const pageDescription = "ORA2U รวมโปรโมชั่นสล็อตคาสิโน โบนัส และสิทธิพิเศษตามเงื่อนไข พร้อมข้อมูลช่วยเลือกโปรให้เหมาะกับงบและรูปแบบการเล่น";

const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "โปรโมชั่น", path: "/promotion" },
  ],
  primaryImagePath: pro1.src,
});

// Gold carries the surfaces here (border, glow) and the lighter gold carries the
// hover state — the same read the artwork uses, a gold-edged card lifting to a
// highlight. A #241503 edge on the near-black page would read as no border at
// all, so the resting border is the primary gold rather than the panel surface.
const promoCardClass =
  "mx-auto h-auto w-full rounded-xl border border-[#fe9a00]/40 object-contain shadow-[0_10px_30px_rgba(254,154,0,0.24)] transition-transform duration-300 hover:-translate-y-1 hover:border-[#ffd76a]/65 hover:shadow-[0_15px_40px_rgba(254,154,0,0.3)]";
---

<MainLayout title="ORA2U | โปรโมชั่นสล็อตคาสิโนและสิทธิพิเศษสำหรับสมาชิก" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={pageTitle} as="h1">
    <div>
      <p class="mb-8 text-left text-base leading-relaxed text-[#f6e6cf]">
        หน้านี้รวมโปรโมชั่นที่ <strong class="text-[#ffd76a]">ORA2U</strong> เปิดให้สมาชิกสล็อตและคาสิโนออนไลน์ไว้ในที่เดียว ทั้งภารกิจประจำวัน ช่วง Lucky Hour วงล้อแต้มทองจากยอดฝาก และโบนัสชวนเพื่อน ตัวเลขและเงื่อนไขหลักของแต่ละรายการพิมพ์อยู่บนภาพด้านล่างแล้ว
        ก่อนกดรับสิทธิ์ควรตรวจช่วงเวลาที่กำหนด ยอดฝากขั้นต่ำ เกมที่ร่วมรายการ และเงื่อนไขการถอนให้ครบ เพราะแต่ละรายการกำหนดไว้ไม่เท่ากันและปรับได้ตามรอบ
      </p>

      <div class="grid w-full grid-cols-1 gap-6 sm:grid-cols-2">
        <Picture
          src={pro1}
          alt="แบนเนอร์โปรโมชั่น ORA2U ข้อความทองว่า ภารกิจประจำวัน ใต้ลงมาเขียนว่า ทำครบ 4 ภารกิจ รับซองสุ่ม พร้อมไอคอนซองแดง ถัดมาเป็นตัวเลขทองขนาดใหญ่ 28 หรือ 88 หรือ 168 เหนือคำว่า เครดิต แล้วเป็นแถวการ์ดทองสี่ขั้นตอนติดเครื่องหมายถูกครบทุกช่อง ล็อกอิน ฝากเงิน หมุนเกม และ รับรางวัล ปิดท้ายด้วยปุ่มทองทรงรีเขียนว่า รับภารกิจ ด้านซ้ายเป็นผู้หญิงในชุดรัดรูปสีดำสลับทอง โลโก้มงกุฎ ORA2U อยู่กลางด้านบน รอบภาพเป็นกล่องของขวัญ เหรียญทอง และวงล้อสล็อตบนพื้นหลังสีดำ"
          loading="lazy"
          fetchpriority="low"
          widths={[300, 450, 600]}
          sizes="(max-width: 639px) 85vw, (max-width: 1520px) 45vw, 600px"
          class={promoCardClass}
          decoding="async"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={80}
        />

        <Picture
          src={pro2}
          alt="แบนเนอร์โปรโมชั่น ORA2U ข้อความสีขาวว่า Lucky Hour พร้อมกรอบไฟนีออนชมพูเขียนช่วงเวลา 19:00 ถึง 20:00 ใต้ลงมาเป็นข้อความ เปิดหีบลับ ลุ้นรับ แล้วเป็นตัวเลขทองขนาดใหญ่ 29 หรือ 79 หรือ 179 เครดิต กับหมายเหตุ เฉพาะช่วงเวลาที่กำหนด และปุ่มทองทรงรีเขียนว่า เปิดเลย ด้านขวาเป็นหีบสมบัติทองเปิดออกมีแสงพุ่งขึ้น พร้อมอัญมณีสีฟ้า ชมพู ขาว เหรียญทอง และวงล้อรูเล็ต ด้านซ้ายเป็นผู้หญิงในชุดดำสลับทองยกมือทั้งสองข้าง มีโลโก้ ORA2U อยู่มุมบนซ้ายและไอคอนนาฬิกาด้านบน"
          loading="lazy"
          fetchpriority="low"
          widths={[300, 450, 600]}
          sizes="(max-width: 639px) 85vw, (max-width: 1520px) 45vw, 600px"
          class={promoCardClass}
          decoding="async"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={80}
        />

        <Picture
          src={pro3}
          alt="แบนเนอร์โปรโมชั่น ORA2U ข้อความทองว่า วงล้อแต้มทอง พร้อมบรรทัดรอง ฝากครบ 300 รับสิทธิ์หมุน 1 ครั้ง ด้านขวาเป็นวงล้อรางวัลสีทองสลับดำขนาดใหญ่ ขอบวงล้อประดับหลอดไฟ แบ่งช่องเป็น 39 เครดิต 89 เครดิต 189 เครดิต สลับกับช่อง ของรางวัล ที่มีไอคอนกล่องของขวัญ และช่อง หมุนฟรี ที่มีไอคอนลูกศรวน ตรงกลางวงล้อเขียนว่า หมุน และมีลูกศรทองชี้อยู่ด้านบน ใต้ภาพเป็นหมายเหตุ ลุ้นได้ทุกวันตามเงื่อนไข กับปุ่มทองทรงรีเขียนว่า หมุนเลย ด้านซ้ายเป็นผู้หญิงในชุดดำสลับทองชี้นิ้วไปที่วงล้อ มีโลโก้ ORA2U อยู่มุมบนซ้าย รอบภาพเป็นเพชรและเหรียญทอง"
          loading="lazy"
          fetchpriority="low"
          widths={[300, 450, 600]}
          sizes="(max-width: 639px) 85vw, (max-width: 1520px) 45vw, 600px"
          class={promoCardClass}
          decoding="async"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={80}
        />

        <Picture
          src={pro4}
          alt="แบนเนอร์โปรโมชั่น ORA2U ข้อความทองว่า ชวนเพื่อนรับเพิ่ม ใต้ลงมาเป็นแผงกรอบทองเขียนว่า เพื่อนสมัครสำเร็จ รับทันที พร้อมตัวเลข 69 ขนาดใหญ่มากและคำว่า บาท ถัดมาเป็นไอคอนวงกลมทองสามขั้นตอนต่อกันด้วยลูกศร ชวนเพื่อน เป็นรูปคนพร้อมเครื่องหมายบวก สมัครสำเร็จ เป็นคลิปบอร์ดติดเครื่องหมายถูก และ รับโบนัส เป็นกล่องของขวัญ ปิดท้ายด้วยบรรทัด ยิ่งชวน ยิ่งได้ และปุ่มทองทรงรีเขียนว่า ชวนเลย ด้านซ้ายเป็นผู้หญิงในชุดดำสลับทองถือโทรศัพท์ที่แสดงโลโก้ ORA2U และชี้นิ้วมาที่หน้าจอ รอบภาพเป็นไพ่เอซ เหรียญทอง และกล่องของขวัญบนพื้นหลังสีดำ"
          loading="lazy"
          fetchpriority="low"
          widths={[300, 450, 600]}
          sizes="(max-width: 639px) 85vw, (max-width: 1520px) 45vw, 600px"
          class={promoCardClass}
          decoding="async"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={80}
        />
      </div>

      <div class="mt-12 flex justify-center pb-4">
        <a
          href="/register"
          class="flex items-center justify-center rounded-lg border border-[#ffd76a]/60 bg-gradient-to-r from-[#fdf3da] via-[#ffd76a] to-[#fe9a00] px-10 py-3.5 text-lg font-black text-[#2a1502] shadow-[0_10px_30px_rgba(254,154,0,0.32)] transition-transform hover:scale-105 hover:shadow-[0_15px_40px_rgba(177,93,1,0.40)]">
          สมัครสมาชิก ORA2U
        </a>
      </div>
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
