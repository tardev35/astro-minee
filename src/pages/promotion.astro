---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBoxPremium.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement5.astro";

import { Picture } from "astro:assets";

import pro1 from "../assets/slide1.png";
import pro2 from "../assets/slide2.png";
import pro3 from "../assets/slide3.png";
import pro4 from "../assets/slide4.png";
import { pageGraph } from "../lib/schema";

const pageTitle = "โปรโมชั่นสล็อต TGAZM สำหรับสมาชิกใหม่และผู้ใช้งานเดิม";

// 153 ตัวอักษร (นับตัวอักษร ไม่ใช่ไบต์) — อยู่ในกรอบ 150–160 ที่ verify-build บังคับ
const pageDescription =
  "TGAZM รวมโปรโมชั่นสล็อต โบนัสต้อนรับ และสิทธิพิเศษสำหรับสมาชิก พร้อมรายละเอียดเงื่อนไขให้ตรวจสอบก่อนเลือกรับสิทธิ์ ควรอ่านข้อกำหนดให้ครบก่อนกดรับทุกครั้ง";

const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "โปรโมชั่น", path: "/promotion" },
  ],
  primaryImagePath: pro1.src,
});
---

<MainLayout title="TGAZM | โปรโมชั่นสล็อตสำหรับสมาชิกใหม่และผู้ใช้งานเดิม" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={pageTitle} as="h1">
    <div>
      <h2 class="mb-4 text-2xl leading-normal font-bold text-[#ffd54a]">โปรโมชั่น TGAZM มีรายการอะไรบ้าง และควรอ่านเงื่อนไขจุดไหนก่อนกดรับ</h2>

      <p class="mb-5 text-left text-base leading-relaxed text-[#e2f3cd]">
        <strong class="text-[#ffeaa0]">TGAZM</strong> รวมเกมสล็อตหลายรูปแบบไว้ในระบบเดียว ทั้งเกมที่จ่ายบ่อยแต่รางวัลต่อครั้งไม่สูง เกมผันผวนสูงที่ต้องรอจังหวะ และเกมที่มีฟีเจอร์โบนัสหลายชั้น
        สิทธิ์ที่หน้านี้เปิดให้กดรับจึงผูกอยู่กับยอดฝากและเกมที่ร่วมรายการ ไม่ได้ลอยอยู่เดี่ยว ๆ บนแบนเนอร์ ตัวเลขใหญ่บนภาพบอกได้แค่ว่ามีอะไรให้ ส่วนบรรทัดเล็กใต้ตัวเลขคือคนที่ตัดสินว่าได้จริงเท่าไร
        ก่อนกดรับจึงควรไล่ให้ครบทั้ง 5 จุด คือยอดฝากขั้นต่ำของรายการนั้น เปอร์เซ็นต์โบนัสที่ได้รับ จำนวนเทิร์นที่ต้องทำ เกมและค่ายที่ร่วมรายการ และเพดานถอนสูงสุด
        เพราะโปรแต่ละแบบกำหนดเกมและเงื่อนไขถอนไม่เหมือนกัน การเลือกจากเปอร์เซ็นต์ที่สูงที่สุดเพียงอย่างเดียวจึงไม่ใช่วิธีที่ปลอดภัยที่สุด
      </p>

      <p class="mb-5 text-left text-base leading-relaxed text-[#e2f3cd]">
        รายการที่แสดงบนหน้านี้มีสี่แบบ ทั้งชนิดรับครั้งเดียวและชนิดรับตามรอบ เริ่มจากฝากครั้งแรก รับเพิ่ม 50% โบนัสต้อนรับสุดคุ้ม ที่คิดจากยอดฝากรายการแรกและมักมีเพดานโบนัสของตัวเอง
        ต่อด้วยคืนยอดเสียทุกวัน 10% สูงสุด 5,000 บาท ซึ่งเป็นรายการที่คำนวณตามรอบวัน แล้วจึงเป็นชวนเพื่อน รับเครดิตฟรี 300 บาท ชวนมาก ได้มาก ที่นับจากจำนวนเพื่อนซึ่งสมัครและเริ่มใช้งานจริงตามที่ระบบกำหนด
        และปิดท้ายด้วยสมาชิกใหม่ รับโบนัส 100% เริ่มสนุกได้ทันที ซึ่งเป็นสิทธิ์ครั้งเดียวของบัญชีที่เพิ่งเปิดใช้งาน
        ตัวเลขบนภาพควรใช้เป็นข้อมูลตั้งต้นแล้วตรวจจากหน้าโปรโมชั่นจริงในระบบอีกครั้งก่อนกด เพราะช่วงเวลาของสิทธิ์ ค่ายเกมที่ยกเว้น และการรับซ้อนกับรายการอื่นเป็นรายละเอียดที่เปลี่ยนได้ตามรอบ
        ถ้าแผนของคุณคือเล่นตามงบที่ตั้งไว้แล้วปิดจบ การไม่รับสิทธิ์เลยก็เป็นทางเลือกที่สมเหตุสมผล เพราะโบนัสที่ยังติดเทิร์นไม่ได้แปลว่าเงินอยู่ในมือแล้ว
      </p>

      <h2 class="mt-10 mb-4 text-2xl leading-normal font-bold text-[#ffd54a]">ฝากไม่มีขั้นต่ำกับยอดขั้นต่ำของโปรโมชั่นเป็นคนละชุดตัวเลข</h2>

      <p class="mb-5 text-left text-base leading-relaxed text-[#e2f3cd]">
        เงื่อนไขฝากไม่มีขั้นต่ำของ TGAZM ช่วยให้กำหนดยอดทำรายการได้ยืดหยุ่นขึ้นตามช่องทางที่เว็บไซต์กำหนด แต่เป็นคนละชุดตัวเลขกับยอดฝากขั้นต่ำที่โปรโมชั่นแต่ละรายการเขียนไว้
        รายการอย่างฝากครั้งแรกรับเพิ่ม 50% มีเพดานโบนัสและยอดเริ่มต้นของตัวเอง ส่วนรายการคืนยอดเสีย 10% ต้องดูว่าคำนวณจากยอดเสียสุทธิของช่วงเวลาไหน นับเฉพาะเกมที่ร่วมรายการหรือไม่ ปิดยอดกี่โมง และเพดาน 5,000 บาทนับต่อวันหรือต่อรอบ
        ก่อนยืนยันจึงควรตรวจช่องทางที่รองรับ สถานะบัญชี และข้อกำหนดของโปรโมชั่นให้ตรงกัน เพื่อช่วยลดปัญหารายการล่าช้าหรือข้อมูลไม่ตรงกันภายหลัง
      </p>

      <p class="mb-8 text-left text-base leading-relaxed text-[#e2f3cd]">
        หลังกดรับสิทธิ์ ควรเปิดหน้าประวัติรายการดูว่ายอดโบนัสเข้าครบ เทิร์นเดินถูกเกม และยอดคงเหลือตรงกับที่ระบบแสดง เพราะบางรายการนับยอดเฉพาะเกมสล็อตบางค่าย และบางรายการยกเว้นเกมที่ซื้อฟีเจอร์โบนัสไว้ตั้งแต่ต้น
        ระบบออโต้ช่วยให้เข้าสู่ระบบ เลือกเกม ทำรายการ และตรวจสอบประวัติได้จากหน้าเว็บไซต์เดียว จึงย้อนดูรายการได้เร็วโดยไม่ต้องสลับหลายหน้า หากยอดยังไม่ขยับไม่ควรกดซ้ำทันที เพราะระบบอาจกำลังประมวลผลอยู่
        และหากติดปัญหาเรื่องสถานะฝากถอนหรือเงื่อนไขโปรโมชั่น ทีมงานดูแลสมาชิกเปิดรับเรื่องตลอด 24 ชั่วโมงผ่านช่องทางที่เว็บไซต์ระบุ โดยไม่ต้องส่งรหัสผ่านหรือรหัสยืนยันให้ใครทั้งสิ้น
      </p>

      <div class="grid w-full grid-cols-1 gap-6 sm:grid-cols-2">
        <Picture
          src={pro1}
          alt="แบนเนอร์โปรโมชั่น TGAZM ข้อความ ฝากครั้งแรก รับเพิ่ม 50% โบนัสต้อนรับสุดคุ้ม พร้อมพรีเซนเตอร์หญิงในชุดสีเขียวทอง ตู้สล็อต 777 มงกุฎ และเหรียญทองบนพื้นหลังสีเขียวเข้ม"
          loading="lazy"
          fetchpriority="low"
          widths={[300, 450, 600]}
          sizes="(max-width: 639px) 85vw, (max-width: 1520px) 45vw, 600px"
          class="mx-auto h-auto w-full rounded-xl border border-[#a3e635]/30 object-contain shadow-[0_10px_30px_rgba(163,230,53,0.20)] transition-transform duration-300 hover:-translate-y-1 hover:border-[#ffd54a]/55 hover:shadow-[0_15px_40px_rgba(255,213,74,0.30)]"
          decoding="async"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={80}
        />

        <Picture
          src={pro2}
          alt="แบนเนอร์โปรโมชั่น TGAZM ข้อความ คืนยอดเสียทุกวัน 10% สูงสุด 5,000 บาท พร้อมพรีเซนเตอร์หญิงในชุดสีเขียวทองและกองเหรียญทองปลิวรอบตัวบนพื้นหลังสีเขียวเข้ม"
          loading="lazy"
          fetchpriority="low"
          widths={[300, 450, 600]}
          sizes="(max-width: 639px) 85vw, (max-width: 1520px) 45vw, 600px"
          class="mx-auto h-auto w-full rounded-xl border border-[#a3e635]/30 object-contain shadow-[0_10px_30px_rgba(163,230,53,0.20)] transition-transform duration-300 hover:-translate-y-1 hover:border-[#ffd54a]/55 hover:shadow-[0_15px_40px_rgba(255,213,74,0.30)]"
          decoding="async"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={80}
        />

        <Picture
          src={pro3}
          alt="แบนเนอร์โปรโมชั่น TGAZM ข้อความ ชวนเพื่อน รับเครดิตฟรี 300 บาท ชวนมาก ได้มาก พร้อมพรีเซนเตอร์หญิงถือกล่องของขวัญสีเขียวผูกโบว์ทองและเหรียญทองบนพื้นหลังสีเขียวเข้ม"
          loading="lazy"
          fetchpriority="low"
          widths={[300, 450, 600]}
          sizes="(max-width: 639px) 85vw, (max-width: 1520px) 45vw, 600px"
          class="mx-auto h-auto w-full rounded-xl border border-[#a3e635]/30 object-contain shadow-[0_10px_30px_rgba(163,230,53,0.20)] transition-transform duration-300 hover:-translate-y-1 hover:border-[#ffd54a]/55 hover:shadow-[0_15px_40px_rgba(255,213,74,0.30)]"
          decoding="async"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={80}
        />

        <Picture
          src={pro4}
          alt="แบนเนอร์โปรโมชั่น TGAZM ข้อความ สมาชิกใหม่ รับโบนัส 100% เริ่มสนุกได้ทันที พร้อมพรีเซนเตอร์หญิงในชุดสีเขียวทอง กองเหรียญทอง และแถบด้านล่างระบุ มั่นคง ปลอดภัย ฝากถอนออโต้ รองรับมือถือ และบริการ 24 ชม."
          loading="lazy"
          fetchpriority="low"
          widths={[300, 450, 600]}
          sizes="(max-width: 639px) 85vw, (max-width: 1520px) 45vw, 600px"
          class="mx-auto h-auto w-full rounded-xl border border-[#a3e635]/30 object-contain shadow-[0_10px_30px_rgba(163,230,53,0.20)] transition-transform duration-300 hover:-translate-y-1 hover:border-[#ffd54a]/55 hover:shadow-[0_15px_40px_rgba(255,213,74,0.30)]"
          decoding="async"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={80}
        />
      </div>

      <div class="mt-12 flex justify-center pb-4">
        <a
          href="/register"
          class="flex items-center justify-center rounded-lg border border-[#ffd54a]/60 bg-gradient-to-r from-[#ffeaa0] via-[#ffd54a] to-[#c9911a] px-10 py-3.5 text-lg font-black text-[#04150a] shadow-[0_10px_30px_rgba(255,213,74,0.22)] transition-transform hover:scale-105 hover:shadow-[0_15px_40px_rgba(255,213,74,0.34)]">
          สมัครสมาชิก TGAZM
        </a>
      </div>
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
