---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement3.astro";

import { Picture } from "astro:assets";

import pro1 from "../assets/slide1.png";
import pro2 from "../assets/slide2.png";
import pro3 from "../assets/slide3.png";
import pro4 from "../assets/slide4.png";
import { pageGraph } from "../lib/schema";

// IMAGE PAGE, not an article: the whole body is the <h1>, one short intro
// paragraph, the four promo images and one CTA. No section headings and no
// second paragraph — the slides already print their own offer in large type,
// so prose underneath only re-types what the visitor can already read.
const pageTitle = "โปรโมชั่นสล็อต AMBPLUS สำหรับสมาชิกใหม่และสมาชิกเดิม";

// docx SUB-PAGES Meta สำหรับหน้าโปรโมชั่น + ประโยคปิดท้ายหนึ่งวรรคให้ผ่านเกท 150
// นับเป็น "ตัวอักษร" ไม่ใช่ไบต์ (ภาษาไทย 3 ไบต์/ตัว) — สตริงนี้วัดได้ 154 ตัวอักษร
const pageDescription = "AMBPLUS รวมโปรโมชั่นสล็อต โบนัสสมาชิกใหม่ และสิทธิพิเศษตามเงื่อนไข พร้อมรายละเอียดให้ตรวจสอบก่อนเลือกรับโปรที่เหมาะกับการใช้งาน สอบถามทีมงานได้ตลอดทั้งวัน";

const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "โปรโมชั่น", path: "/promotion" },
  ],
  primaryImagePath: pro1.src,
});

const promoCardClass =
  "mx-auto h-auto w-full rounded-xl border border-[#ecd48c]/30 object-contain shadow-[0_10px_30px_rgba(236,212,140,0.20)] transition-transform duration-300 hover:-translate-y-1 hover:border-[#c9a24a]/55 hover:shadow-[0_15px_40px_rgba(201,162,74,0.30)]";
---

<MainLayout title="AMBPLUS | โปรโมชั่นสล็อตและสิทธิพิเศษสำหรับสมาชิก" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={pageTitle} as="h1">
    <div>
      <p class="mb-8 text-left text-base leading-relaxed text-[#efe3c8]">
        <strong class="text-[#fbf2c4]">AMBPLUS</strong> รวมโปรโมชั่นสล็อตและสิทธิพิเศษของสมาชิกไว้ในหน้าเดียว ทั้งโบนัสต้อนรับของบัญชีที่เพิ่งเปิดใช้งาน โบนัสจากยอดฝากแรกของวัน และการคืนยอดเสียตามรอบวัน
        รายละเอียดของแต่ละรายการพิมพ์อยู่บนภาพด้านล่างแล้ว ทั้งเปอร์เซ็นต์ที่ได้รับและเงื่อนไขหลักของรายการนั้น ก่อนกดรับสิทธิ์ควรอ่านเงื่อนไขให้ครบ เพราะแต่ละรายการกำหนดยอดฝากขั้นต่ำ จำนวนเทิร์น
        และเกมที่ร่วมรายการไม่เหมือนกัน หากไม่แน่ใจจุดใด สอบถามทีมงานผ่านช่องทางที่เว็บไซต์กำหนดได้ตลอดทั้งวัน
      </p>

      <div class="grid w-full grid-cols-1 gap-6 sm:grid-cols-2">
        <Picture
          src={pro1}
          alt="แบนเนอร์ AMBPlus+ ตัวอักษรทองบนพื้นดำ ข้อความ คาสิโนออนไลน์ครบวงจร เล่นง่าย จ่ายจริง ฝากถอนออโต้ ป้ายโล่ รองรับมือถือ ระบบออโต้ 24 ชม. และปุ่มทอง สมัครเลย มีนางแบบชุดดำทองยืนแบมือ ตู้สล็อต JACKPOT เลข 777 วงล้อรูเล็ต ไพ่ป็อก และกองชิปกับเหรียญทอง"
          loading="lazy"
          fetchpriority="low"
          widths={[300, 450, 600]}
          sizes="(max-width: 639px) 85vw, (max-width: 1520px) 45vw, 600px"
          class={promoCardClass}
          decoding="async"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={80}
        />

        <Picture
          src={pro2}
          alt="แบนเนอร์โปรโมชั่น AMBPlus+ ข้อความ สมาชิกใหม่ รับโบนัส 50% สมัครวันนี้ รับสิทธิ์ทันที โบนัสต้อนรับสำหรับผู้เล่นใหม่ และปุ่มทอง รับโปรเลย บนพื้นดำ มีนางแบบชุดดำทอง ตัวเลข 50% ทองนูน ตู้สล็อตเลข 777 ไพ่ป็อก และกองชิปกับเหรียญทอง"
          loading="lazy"
          fetchpriority="low"
          widths={[300, 450, 600]}
          sizes="(max-width: 639px) 85vw, (max-width: 1520px) 45vw, 600px"
          class={promoCardClass}
          decoding="async"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={80}
        />

        <Picture
          src={pro3}
          alt="แบนเนอร์โปรโมชั่น AMBPlus+ ข้อความ ฝากแรกของวัน รับเพิ่ม 20% คุ้มตั้งแต่ฝากแรก ป้ายโล่ ฝากง่าย ถอนเร็ว ระบบออโต้ และปุ่มทอง ฝากเลย บนพื้นดำ มีนางแบบชุดดำทองชูนิ้ว ตัวเลข 20% ทองนูน ตู้สล็อต JACKPOT เลข 777 วงล้อรูเล็ต และกองชิปกับเหรียญทอง"
          loading="lazy"
          fetchpriority="low"
          widths={[300, 450, 600]}
          sizes="(max-width: 639px) 85vw, (max-width: 1520px) 45vw, 600px"
          class={promoCardClass}
          decoding="async"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={80}
        />

        <Picture
          src={pro4}
          alt="แบนเนอร์โปรโมชั่น AMBPlus+ ข้อความ คืนยอดเสียทุกวัน 0.8% เล่นต่อได้ทุกวัน คืนยอดเสียคุ้มค่า ไม่พลาดทุกความสนุก และปุ่มทอง รับสิทธิ์ บนพื้นดำ มีนางแบบชุดดำทองแบมือ ตัวเลข 0.8% ทองนูน ตู้สล็อต JACKPOT เลข 777 วงล้อรูเล็ต ไพ่ป็อก และกองชิปกับเหรียญทอง"
          loading="lazy"
          fetchpriority="low"
          widths={[300, 450, 600]}
          sizes="(max-width: 639px) 85vw, (max-width: 1520px) 45vw, 600px"
          class={promoCardClass}
          decoding="async"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          quality={80}
        />
      </div>

      <div class="mt-12 flex justify-center pb-4">
        <a
          href="/register"
          class="flex items-center justify-center rounded-lg border border-[#ecd48c]/60 bg-gradient-to-r from-[#fbf2c4] via-[#ecd48c] to-[#8c6b22] px-10 py-3.5 text-lg font-black text-[#17110a] shadow-[0_10px_30px_rgba(236,212,140,0.28)] transition-transform hover:scale-105 hover:shadow-[0_15px_40px_rgba(236,212,140,0.40)]">
          สมัครสมาชิก AMBPLUS
        </a>
      </div>
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
