---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/AnnouncementCyber.astro";

import { Picture } from "astro:assets";
import imgLine from "../assets/contact-line.webp";
import { pageGraph } from "../lib/schema";
import { BRAND_ADDRESS } from "../lib/brandProfile";

// One string, used twice: MainLayout's <meta name="description"> and the
// WebPage node's description. Keeping it in a const is what stops the meta tag
// and the structured data from drifting apart — they used to be two hand-typed
// variants of the same sentence, and the JSON-LD copy was the one nobody
// reread. Count CHARACTERS, not bytes (Thai is 3 bytes/char, so a byte count
// reads ~3x too long and will send you rewriting a description that was fine).
//
// The docx SUB-PAGES Meta for ติดต่อเรา is carried VERBATIM as the opening
// sentence (129 characters) plus one closing clause, because
// tools/verify-build.mjs errors below DESC_MIN=150 on every indexable page and
// exempts only the home page. Measured at 153 characters.
//
// This page is a BUTTON PAGE: zero section headings, zero paragraphs, nothing
// that turns it back into an article. The docx gives it a Title and a Meta and
// never a body, so any prose found here came from an earlier rebrand inventing
// it. The whole body is the <h1>, the LINE image, the BRAND_ADDRESS block and
// the button row — in that order.
const pageDescription =
  "BMK289 เปิดช่องทางติดต่อเรื่องบัญชี ทางเข้า โปรโมชั่น และสถานะธุรกรรม พร้อมข้อมูลช่วยตรวจสอบปัญหาและขั้นตอนการใช้งานที่เกี่ยวข้อง ติดต่อผ่านไลน์ได้ทุกวัน";

// BRAND_ADDRESS is visible text only — it never goes into the graph below.
const graph = pageGraph(Astro, {
  type: "ContactPage",
  name: "ติดต่อทีมงาน BMK289",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "ติดต่อเรา", path: "/contact-us" },
  ],
  org: {
    alternateName: "BMK289 เว็บสล็อตรวมเกมยอดนิยม ระบบออโต้ฝากง่าย ถอนไวตามเงื่อนไข รองรับมือถือและคอมพิวเตอร์",
    contactPoints: [
      {
        contactType: "customer service",
        availableLanguage: ["Thai", "English"],
        path: "/line",
        description: "ติดต่อแอดมินผ่าน LINE Official",
      },
    ],
  },
});
---

<MainLayout title="BMK289 | ติดต่อทีมงานและสอบถามข้อมูลการใช้งาน" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="ติดต่อทีมงาน BMK289" as="h1">
    <Picture
      src={imgLine}
      alt="ผู้หญิงผมยาวสีน้ำตาลในชุดเลื่อมสีชมพูยืนกอดอกและยิ้ม ด้านล่างเป็นปุ่มสีขาวที่มีไอคอนแชต LINE สีเขียวและคำว่า Support"
      loading="lazy"
      fetchpriority="low"
      widths={[200, 400, 600]}
      sizes="(max-width: 400px) 100vw, 400px"
      class="mx-auto h-auto w-full max-w-[400px] object-contain shadow-[0_10px_30px_rgba(43,140,255,0.18)]"
      decoding="async"
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      quality={60}
    />
    {
      BRAND_ADDRESS.lines.length > 0 && (
        <address aria-label={BRAND_ADDRESS.label} class="mt-8 mb-8 border-l-4 border-[#2b8cff] pl-6 text-left text-base leading-relaxed text-[#dbe9fb] not-italic">
          <p class="mb-1 font-bold text-[#ffcc33]">{BRAND_ADDRESS.label}</p>
          {BRAND_ADDRESS.lines.map((line) => (
            <span class="block">{line}</span>
          ))}
          {BRAND_ADDRESS.email && (
            <span class="mt-3 block">
              <span aria-hidden="true" class="mr-2">
                ✉️
              </span>
              <a href={`mailto:${BRAND_ADDRESS.email}`} class="font-bold text-[#ffcc33] underline decoration-current/40 underline-offset-4">
                {BRAND_ADDRESS.email}
              </a>
            </span>
          )}
        </address>
      )
    }

    <div class="flex flex-wrap justify-center gap-4">
      <a
        href="/register"
        aria-label="สมัครสมาชิก"
        class="flex items-center justify-center rounded-lg border border-[#ffe488]/60 bg-gradient-to-b from-[#ffe488] via-[#ffcc33] to-[#c9931a] px-8 py-3 font-bold text-[#05132e] shadow-[0_10px_30px_rgba(255,204,51,0.28)] transition-transform hover:scale-105 hover:shadow-[0_15px_40px_rgba(255,204,51,0.40)]">
        สมัครสมาชิก
      </a>

      <a
        href="/login"
        aria-label="เข้าสู่ระบบ"
        class="flex items-center justify-center rounded-lg border border-[#2b8cff]/60 bg-[#02081c] px-8 py-3 font-extrabold text-[#dbe9fb] shadow-[0_4px_14px_rgba(43,140,255,0.25)] transition-transform hover:scale-105 hover:bg-[#123061]">
        เข้าสู่ระบบ
      </a>

      <a
        href="/line"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="ติดต่อทีมงานผ่าน Line Official"
        class="flex items-center justify-center rounded-lg border border-green-300 bg-gradient-to-b from-green-400 to-green-700 px-8 py-3 font-bold text-white transition-transform hover:scale-105">
        ติดต่อผ่าน Line Official
      </a>
    </div>
  </ContentBox>
  <Navfoot />
</MainLayout>
