---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBoxPremium.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement3.astro";

import { Picture } from "astro:assets";
import imgLine from "../assets/contact-line.webp";
import { pageGraph } from "../lib/schema";
import { BRAND_ADDRESS } from "../lib/brandProfile";

// One string, used three times: MainLayout's <meta name="description">, the
// WebPage node's description, and nothing else. Keeping it in a const is what
// stops the meta tag and the structured data from drifting apart — they used to
// be two hand-typed variants of the same sentence, and the JSON-LD copy was the
// one nobody reread. 150–160 CHARACTERS (Thai is 3 bytes/char, so a byte count
// reads ~3x too long and will send you rewriting a description that was fine).
//
// This is the docx SUB-PAGES Meta for ติดต่อเรา, which arrived at 123 chars —
// under the 150 the build gate requires — plus one closing clause to reach the
// window. The extra clause lives in the meta tag ONLY. This page is a button
// page: zero section headings, zero paragraphs, nothing that turns it back
// into an article — the docx gives it a Title and a Meta and never a body.
const pageDescription =
  "LCX88 พร้อมช่วยเหลือเรื่องบัญชี โปรโมชั่น ทางเข้าเล่น และสถานะฝากถอน ผ่านช่องทางบริการสมาชิกที่เว็บไซต์กำหนดตลอด 24 ชั่วโมง เตรียมชื่อผู้ใช้ให้พร้อมก่อนแจ้ง";

const graph = pageGraph(Astro, {
  type: "ContactPage",
  name: "ติดต่อทีมงาน LCX88",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "ติดต่อเรา", path: "/contact-us" },
  ],
  org: {
    alternateName: "LCX88 คาสิโนออนไลน์ระบบออโต้ ฝากถอนไม่มีขั้นต่ำ",
    contactPoints: [
      {
        contactType: "customer service",
        availableLanguage: ["Thai", "English"],
        // Point at this site's own /line hop, not the short link behind it.
        // This page is indexed, and structured data is read and stored by
        // Google directly — so a shortener host here is the group's most
        // exposed shared identifier. /line forwards to the same place and
        // that redirect page is noindex.
        //
        // `contactOption: "TollFree"` used to be here. That enum describes a
        // freephone NUMBER; on a chat link it is simply false, and a
        // ContactPoint Google rejects takes the rest of the node with it.
        path: "/line",
        description: "ติดต่อแอดมินผ่าน LINE Official",
      },
    ],
  },
});
---

<MainLayout title="LCX88 | ติดต่อทีมงานและสอบถามข้อมูลตลอด 24 ชั่วโมง" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="ติดต่อทีมงาน LCX88" as="h1">
    <Picture
      src={imgLine}
      alt="พนักงานหญิงในชุดเลื่อมสีชมพูยิ้มอยู่ข้างปุ่ม LINE Support สีเขียว ช่องทางแชตกับทีมงาน LCX88"
      loading="lazy"
      fetchpriority="low"
      widths={[200, 400, 600]}
      sizes="(max-width: 768px) 100vw"
      class="mx-auto h-auto w-full max-w-[400px] object-contain shadow-[0_10px_30px_rgba(47,107,255,0.18)]"
      decoding="async"
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      quality={60}
    />
    {
      BRAND_ADDRESS.lines.length > 0 && (
        <address
          aria-label={BRAND_ADDRESS.label}
          class="mt-8 mb-8 border-l-4 border-[#f5c542] pl-6 text-left text-base leading-relaxed text-[#d7e3ff] not-italic">
          <p class="mb-1 font-bold text-[#ffe08a]">{BRAND_ADDRESS.label}</p>
          {BRAND_ADDRESS.lines.map((line) => (
            <span class="block">{line}</span>
          ))}
        </address>
      )
    }

    <div class="flex flex-wrap justify-center gap-4">
      <a
        href="/register"
        aria-label="สมัครสมาชิก"
        class="flex items-center justify-center rounded-lg border border-[#f5c542]/60 bg-gradient-to-b from-[#ffe08a] via-[#f5c542] to-[#c08b1f] px-8 py-3 font-bold text-[#04102e] shadow-[0_10px_30px_rgba(245,197,66,0.22)] transition-transform hover:scale-105 hover:shadow-[0_15px_40px_rgba(245,197,66,0.35)]">
        สมัครสมาชิก
      </a>

      <a
        href="/login"
        aria-label="เข้าสู่ระบบ"
        class="flex items-center justify-center rounded-lg border border-[#2f6bff]/60 bg-[#071138] px-8 py-3 font-extrabold text-[#6ea3ff] shadow-[0_4px_14px_rgba(47,107,255,0.22)] transition-transform hover:scale-105 hover:bg-[#122264]">
        เข้าสู่ระบบ
      </a>

      <a
        href="/line"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="ติดต่อทีมงานผ่าน Line Official"
        class="flex items-center justify-center rounded-lg border border-green-300 bg-gradient-to-b from-green-400 to-green-700 px-8 py-3 font-bold text-white transition-transform hover:scale-105">
        ติดต่อผ่าน Line Official
      </a>
    </div>
  </ContentBox>
  <Navfoot />
</MainLayout>
