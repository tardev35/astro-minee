---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/AnnouncementHuay.astro";

import { Picture } from "astro:assets";
import imgLine from "../assets/contact-line.webp";
import { pageGraph } from "../lib/schema";
import { BRAND_ADDRESS } from "../lib/brandProfile";

// One string, used twice: MainLayout's <meta name="description"> and the
// WebPage node's description. Keeping it in a const is what stops the meta tag
// and the structured data from drifting apart — they used to be two hand-typed
// variants of the same sentence, and the JSON-LD copy was the one nobody
// reread. Count CHARACTERS, not bytes (Thai is 3 bytes/char, so a byte count
// reads ~3x too long and will send you rewriting a description that was fine).
//
// Title and Meta are the docx SUB-PAGES row "ติดต่อเรา" and ship VERBATIM at
// their own length — the brand spec is explicit that the
// docx-supplied rows are not to be padded to the 150-character floor. Earlier
// brands bolted an extra clause on to clear tools/verify-build.mjs' DESC_MIN;
// that is what this round deliberately stops doing. verify-build.mjs exempts
// any description that appears literally in src/assets/content.txt, which this
// one does.
//
// This page is a BUTTON PAGE: zero section headings, zero paragraphs, nothing
// that turns it back into an article. The docx gives it a Title and a Meta and
// never a body, so any prose found here came from an earlier rebrand inventing
// it. The whole body is the <h1>, the LINE image, the BRAND_ADDRESS block and
// the button row — in that order. Rendered inventory: h1x1, h2x0, h3x0.
//
// <Announcement /> is bare on purpose: AnnouncementHuay's default message is
// this brand's copy, so the ticker matches index.astro without a second string
// here. Rotated off AnnouncementCyber, the outgoing brand's pick, per the spec.
//
// The BRAND_ADDRESS block below names NO colour on purpose — it inherits
// ContentBox's body colour and draws its rule from currentColor, so it lands
// correctly on every brand this template is relaunched for. Retyping it in this
// round's palette is exactly what leaves the previous brand's hex behind next
// time. The lines themselves come from BRAND_ADDRESS; never retype those either.
const pageDescription = "JAIDEEJING ติดต่อสอบถามเรื่องบัญชี โพยหวย โปรโมชั่น ผลรางวัล และสถานะรายการ พร้อมข้อมูลช่วยตรวจสอบปัญหาและการใช้งาน";

// BRAND_ADDRESS is visible text only — it never goes into the graph below.
const graph = pageGraph(Astro, {
  type: "ContactPage",
  name: "ติดต่อทีมงาน JAIDEEJING",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "ติดต่อเรา", path: "/contact-us" },
  ],
  org: {
    alternateName:
      "JAIDEEJING เว็บแทงหวยออนไลน์ครบวงจร รวมหวยหลายประเภท ระบบจัดโพย อัตราจ่าย ข้อมูลผลรางวัล และสถานะรายการไว้ในบัญชีเดียว รองรับการใช้งานผ่านมือถือ พร้อมโปรโมชั่นตามเงื่อนไขของแต่ละรายการ",
    contactPoints: [
      {
        contactType: "customer service",
        availableLanguage: ["Thai", "English"],
        path: "/line",
        description: "ติดต่อแอดมินผ่าน LINE Official",
      },
    ],
  },
});
---

<MainLayout title="JAIDEEJING | ติดต่อทีมงานและสอบถามข้อมูลหวยออนไลน์" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="ติดต่อทีมงาน JAIDEEJING" as="h1">
    <Picture
      src={imgLine}
      alt="ผู้หญิงผมยาวสีน้ำตาลในชุดเลื่อมยืนกอดอกและยิ้ม ด้านล่างเป็นปุ่มสีขาวที่มีไอคอนแชต LINE สีเขียวและคำว่า Support"
      loading="lazy"
      fetchpriority="low"
      widths={[200, 400, 600]}
      sizes="(max-width: 400px) 100vw, 400px"
      class="mx-auto h-auto w-full max-w-[400px] object-contain shadow-[0_10px_30px_rgba(245,196,81,0.24)]"
      decoding="async"
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      quality={60}
    />
    {
      BRAND_ADDRESS.lines.length > 0 && (
        <address aria-label={BRAND_ADDRESS.label} class="mt-8 mb-8 border-l-4 border-current/30 pl-6 text-left text-base leading-relaxed not-italic opacity-90">
          <p class="mb-1 font-bold tracking-wide">{BRAND_ADDRESS.label}</p>
          {BRAND_ADDRESS.lines.map((line) => (
            <span class="block">{line}</span>
          ))}
          {BRAND_ADDRESS.email && (
            <span class="mt-3 block">
              <span aria-hidden="true" class="mr-2">
                ✉️
              </span>
              <a href={`mailto:${BRAND_ADDRESS.email}`} class="font-bold underline decoration-current/40 underline-offset-4">
                {BRAND_ADDRESS.emailDisplay}
              </a>
            </span>
          )}
        </address>
      )
    }

    <div class="flex flex-wrap justify-center gap-4">
      <a
        href="/register"
        aria-label="สมัครสมาชิก"
        class="flex items-center justify-center rounded-lg border border-[#f5c451]/60 bg-gradient-to-b from-[#d12027] to-[#8f1a10] px-8 py-3 font-bold text-white shadow-[0_10px_30px_rgba(209,32,39,0.32)] transition-transform hover:scale-105 hover:shadow-[0_15px_40px_rgba(245,196,81,0.45)]">
        สมัครสมาชิก
      </a>

      <a
        href="/login"
        aria-label="เข้าสู่ระบบ"
        class="flex items-center justify-center rounded-lg border border-[#8f1a10]/70 bg-[#2a0806] px-8 py-3 font-extrabold text-[#f7e4c0] shadow-[0_4px_14px_rgba(245,196,81,0.28)] transition-transform hover:scale-105 hover:border-[#f5c451] hover:bg-[#3a1008]">
        เข้าสู่ระบบ
      </a>

      <a
        href="/line"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="ติดต่อทีมงานผ่าน Line Official"
        class="flex items-center justify-center rounded-lg border border-[#00B900]/70 bg-gradient-to-b from-[#06C755] to-[#00B900] px-8 py-3 font-bold text-white transition-transform hover:scale-105">
        ติดต่อผ่าน Line Official
      </a>
    </div>
  </ContentBox>
  <Navfoot />
</MainLayout>
