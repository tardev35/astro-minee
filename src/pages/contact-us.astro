---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBoxPremium.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/AnnouncementPremium.astro";

import { Picture } from "astro:assets";
import imgLine from "../assets/contact-line.webp";
import { pageGraph } from "../lib/schema";

// One string, used three times: MainLayout's <meta name="description">, the
// WebPage node's description, and nothing else. Keeping it in a const is what
// stops the meta tag and the structured data from drifting apart — they used to
// be two hand-typed variants of the same sentence, and the JSON-LD copy was the
// one nobody reread. 150–160 CHARACTERS (Thai is 3 bytes/char, so a byte count
// reads ~3x too long and will send you rewriting a description that was fine).
const pageDescription =
  "ช่องทางติดต่อทีมงาน MIRACLE55 ผ่าน LINE Official สำหรับปัญหาสมัครสมาชิก เข้าสู่ระบบ โบนัส และสถานะฝากถอนออโต้ พร้อมข้อมูลที่ควรเตรียมให้ครบก่อนแจ้งเรื่อง";

const graph = pageGraph(Astro, {
  type: "ContactPage",
  name: "ติดต่อทีมงาน MIRACLE55 ผ่าน LINE Official",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "ติดต่อเรา", path: "/contact-us" },
  ],
  org: {
    alternateName: "MIRACLE55 เว็บตรงรวมสล็อต PG คาสิโนสด และกีฬา",
    contactPoints: [
      {
        contactType: "customer service",
        availableLanguage: ["Thai", "English"],
        // Point at this site's own /line hop, not the short link behind it.
        // This page is indexed, and structured data is read and stored by
        // Google directly — so a shortener host here is the group's most
        // exposed shared identifier. /line forwards to the same place and
        // that redirect page is noindex.
        //
        // `contactOption: "TollFree"` used to be here. That enum describes a
        // freephone NUMBER; on a chat link it is simply false, and a
        // ContactPoint Google rejects takes the rest of the node with it.
        path: "/line",
        description: "ติดต่อแอดมินผ่าน LINE Official",
      },
    ],
  },
});
---

<MainLayout
  title="ติดต่อเรา MIRACLE55 แจ้งปัญหาสมัครสมาชิก เข้าสู่ระบบ โบนัส และสถานะฝากถอนออโต้ ผ่าน LINE Official"
  description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="ติดต่อทีมงาน MIRACLE55" as="h1">
    <h2 class="mb-6 text-2xl leading-normal font-bold text-[#e8b43a]">ติดปัญหาสมัครสมาชิก เข้าสู่ระบบ โบนัส หรือสถานะฝากถอน ทักทีมงาน MIRACLE55 ทางไหน</h2>

    <Picture
      src={imgLine}
      alt="พนักงานหญิงในชุดเลื่อมยิ้มอยู่ข้างปุ่ม LINE Support สีเขียว ช่องทางแชตกับทีมงาน MIRACLE55"
      loading="lazy"
      fetchpriority="low"
      widths={[200, 400, 600]}
      sizes="(max-width: 768px) 100vw"
      class="mx-auto h-auto w-full max-w-[400px] object-contain shadow-[0_10px_30px_rgba(232,180,58,0.18)]"
      decoding="async"
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      quality={60}
    />
    <p class="my-5 text-left text-base leading-relaxed text-[#f4e3c8]">
      ช่องทางหลักของ <strong class="text-[#f7d97a]">MIRACLE55</strong> คือ LINE Official ที่แสดงอยู่บนหน้าเว็บ ใช้ได้ตั้งแต่ขั้นตอนสมัครสมาชิกที่ใช้เบอร์โทรศัพท์และรหัสผ่านเป็นข้อมูลหลัก ไปจนถึงการเข้าสู่ระบบด้วยเบอร์โทร การกู้คืนรหัสผ่านเมื่อเข้าบัญชีไม่ได้ การหาเกมสล็อตตามค่ายอย่าง PG, Joker หรือ Pragmatic การเลือกโต๊ะคาสิโนสดอย่างบาคาร่าและรูเล็ต รวมถึงการตรวจสถานะรายการฝากถอนออโต้ที่ส่งไปแล้ว
      ระบบออโต้ใช้เวลาประมาณ 5–30 วินาทีสำหรับฝาก และ 1–5 นาทีสำหรับถอน ขึ้นอยู่กับธนาคารและสถานะระบบ ถ้ายอดยังไม่เปลี่ยนหรือรายการยังไม่ขึ้นสถานะ ให้ทักมาพร้อมเวลาทำรายการและภาพหน้าจอแทนการกดซ้ำ เพราะรายการซ้ำใช้เวลาตรวจย้อนหลังนานกว่าการรอรอบเดิมเสียอีก
    </p>

    <h2 class="mt-8 mb-6 text-2xl leading-normal font-bold text-[#e8b43a]">ควรเตรียมข้อมูลอะไรก่อนแจ้งเรื่อง และอะไรที่ห้ามส่งให้ใครเด็ดขาด</h2>

    <p class="mb-6 text-left text-base leading-relaxed text-[#f4e3c8]">
      ก่อนทักเข้ามา ควรเตรียมเบอร์โทรศัพท์ที่ใช้สมัคร เวลาที่ทำรายการ ชื่อบัญชีธนาคารและยอดเงินที่โอน ถ้าเป็นเรื่องเกมให้ระบุค่ายและชื่อเกม ยอดเดิมพันต่อรอบ และเวลาที่กด ถ้าเป็นเรื่องโปรโมชั่นให้ระบุชื่อโปรที่กดรับและยอดฝากที่ใช้รับสิทธิ์ เพราะยอดขั้นต่ำ จำนวนเทิร์น เกมที่ร่วมรายการ และเพดานถอนของแต่ละโปรไม่เท่ากัน แนบภาพหน้าจอที่เกี่ยวข้องมาด้วย ข้อมูลครบตั้งแต่ข้อความแรกช่วยได้มากกว่าการเล่าเป็นตอน ๆ
      ที่สำคัญคือไม่ควรส่งรหัสผ่านหรือ OTP ให้ผู้อื่นไม่ว่ากรณีใด ทีมงานไม่มีความจำเป็นต้องขอสองอย่างนี้ ต่อให้อีกฝั่งพิมพ์มาสุภาพแค่ไหน รหัสชุดนี้ก็ไม่ได้มีไว้แบ่งปัน หากลืมรหัสควรใช้เมนูกู้คืนจากระบบโดยตรง และควรติดต่อผ่านช่องทางที่แสดงบนเว็บไซต์จริงเท่านั้น ไม่ใช่ลิงก์ที่เด้งมาจากข้อความส่วนตัว
    </p>

    <div class="flex flex-wrap justify-center gap-4">
      <a
        href="/register"
        aria-label="สมัครสมาชิก"
        class="flex items-center justify-center rounded-lg border border-[#e8b43a]/60 bg-gradient-to-b from-[#f7d97a] via-[#e8b43a] to-[#a9741c] px-8 py-3 font-bold text-[#1a1206] shadow-[0_10px_30px_rgba(232,180,58,0.18)] transition-transform hover:scale-105 hover:shadow-[0_15px_40px_rgba(232,180,58,0.30)]">
        สมัครสมาชิก
      </a>

      <a
        href="/login"
        aria-label="เข้าสู่ระบบ"
        class="flex items-center justify-center rounded-lg border border-[#e8b43a]/60 bg-[#15110b] px-8 py-3 font-extrabold text-[#f7d97a] shadow-[0_4px_14px_rgba(232,180,58,0.18)] transition-transform hover:scale-105 hover:bg-[#1e1710]">
        เข้าสู่ระบบ
      </a>

      <a
        href="/line"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="ติดต่อทีมงานผ่าน Line Official"
        class="flex items-center justify-center rounded-lg border border-green-300 bg-gradient-to-b from-green-400 to-green-700 px-8 py-3 font-bold text-white transition-transform hover:scale-105">
        ติดต่อผ่าน Line Official
      </a>
    </div>
  </ContentBox>
  <Navfoot />
</MainLayout>
