---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement6.astro";

import { Picture } from "astro:assets";
import imgLine from "../assets/contact-line.webp";
import { pageGraph } from "../lib/schema";
import { BRAND_ADDRESS } from "../lib/brandProfile";

// One string, used twice: MainLayout's <meta name="description"> and the
// WebPage node's description. Keeping it in a const is what stops the meta tag
// and the structured data from drifting apart — they used to be two hand-typed
// variants of the same sentence, and the JSON-LD copy was the one nobody
// reread. Count CHARACTERS, not bytes (Thai is 3 bytes/char, so a byte count
// reads ~3x too long and will send you rewriting a description that was fine).
//
// Title and Meta are the brand spec §6 row for /contact-us. The docx sentence
// runs 128 characters, under the DESC_MIN=150 floor tools/verify-build.mjs
// enforces on every indexable page, so it opens the description and one clause
// about the LINE channel closes it. Measured at 154 characters.
//
// This page is a BUTTON PAGE: zero section headings, zero paragraphs, nothing
// that turns it back into an article. The docx gives it a Title and a Meta and
// never a body, so any prose found here came from an earlier rebrand inventing
// it. The whole body is the <h1>, the LINE image, the BRAND_ADDRESS block and
// the button row — in that order.
//
// <Announcement /> is bare on purpose: Announcement6's default message is this
// brand's copy, so the ticker matches index.astro without a second string here.
const pageDescription = "HOT189 เปิดช่องทางติดต่อเรื่องบัญชี ทางเข้า โปรโมชั่น และสถานะฝากถอน พร้อมข้อมูลช่วยตรวจสอบปัญหาและขั้นตอนการใช้งานที่เกี่ยวข้อง ติดต่อผ่าน LINE ได้ทุกวัน";

// BRAND_ADDRESS is visible text only — it never goes into the graph below.
const graph = pageGraph(Astro, {
  type: "ContactPage",
  name: "ติดต่อทีมงาน HOT189",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "ติดต่อเรา", path: "/contact-us" },
  ],
  org: {
    alternateName: "HOT189 แพลตฟอร์มบาคาร่าออนไลน์ระบบเว็บตรง พร้อมระบบฝากถอนออโต้และการจัดการบัญชีจากหน้าเดียว รองรับทั้งมือถือและคอมพิวเตอร์",
    contactPoints: [
      {
        contactType: "customer service",
        availableLanguage: ["Thai", "English"],
        path: "/line",
        description: "ติดต่อแอดมินผ่าน LINE Official",
      },
    ],
  },
});
---

<MainLayout title="HOT189 | ติดต่อทีมงานและสอบถามข้อมูลการใช้งาน" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="ติดต่อทีมงาน HOT189" as="h1">
    <Picture
      src={imgLine}
      alt="ผู้หญิงผมยาวสีน้ำตาลในชุดเลื่อมสีชมพูยืนกอดอกและยิ้ม ด้านล่างเป็นปุ่มสีขาวที่มีไอคอนแชต LINE สีเขียวและคำว่า Support"
      loading="lazy"
      fetchpriority="low"
      widths={[200, 400, 600]}
      sizes="(max-width: 400px) 100vw, 400px"
      class="mx-auto h-auto w-full max-w-[400px] object-contain shadow-[0_10px_30px_rgba(239,43,9,0.22)]"
      decoding="async"
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      quality={60}
    />
    {
      BRAND_ADDRESS.lines.length > 0 && (
        <address aria-label={BRAND_ADDRESS.label} class="mt-8 mb-8 border-l-4 border-[#ef2b09] pl-6 text-left text-base leading-relaxed text-[#ffe9cf] not-italic">
          <p class="mb-1 font-bold text-[#fcd304]">{BRAND_ADDRESS.label}</p>
          {BRAND_ADDRESS.lines.map((line) => (
            <span class="block">{line}</span>
          ))}
          {BRAND_ADDRESS.email && (
            <span class="mt-3 block">
              <span aria-hidden="true" class="mr-2">
                ✉️
              </span>
              <a href={`mailto:${BRAND_ADDRESS.email}`} class="font-bold text-[#fcd304] underline decoration-current/40 underline-offset-4">
                {BRAND_ADDRESS.email}
              </a>
            </span>
          )}
        </address>
      )
    }

    <div class="flex flex-wrap justify-center gap-4">
      <a
        href="/register"
        aria-label="สมัครสมาชิก"
        class="flex items-center justify-center rounded-lg border border-[#fcd304]/60 bg-gradient-to-b from-[#ffe86b] via-[#fcd304] to-[#c99400] px-8 py-3 font-bold text-[#2b0a02] shadow-[0_10px_30px_rgba(252,211,4,0.30)] transition-transform hover:scale-105 hover:shadow-[0_15px_40px_rgba(252,211,4,0.44)]">
        สมัครสมาชิก
      </a>

      <a
        href="/login"
        aria-label="เข้าสู่ระบบ"
        class="flex items-center justify-center rounded-lg border border-[#ff7a18]/65 bg-[#2e100a] px-8 py-3 font-extrabold text-[#ffe9cf] shadow-[0_4px_14px_rgba(239,43,9,0.40)] transition-transform hover:scale-105 hover:bg-[#8f1505]">
        เข้าสู่ระบบ
      </a>

      <a
        href="/line"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="ติดต่อทีมงานผ่าน Line Official"
        class="flex items-center justify-center rounded-lg border border-green-300 bg-gradient-to-b from-green-400 to-green-700 px-8 py-3 font-bold text-white transition-transform hover:scale-105">
        ติดต่อผ่าน Line Official
      </a>
    </div>
  </ContentBox>
  <Navfoot />
</MainLayout>
