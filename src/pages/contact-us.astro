---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement5.astro";

import { Picture } from "astro:assets";
import imgLine from "../assets/contact-line.webp";
import { pageGraph } from "../lib/schema";
import { BRAND_ADDRESS } from "../lib/brandProfile";

// One string, used twice: MainLayout's <meta name="description"> and the
// WebPage node's description. Keeping it in a const is what stops the meta tag
// and the structured data from drifting apart — they used to be two hand-typed
// variants of the same sentence, and the JSON-LD copy was the one nobody
// reread. Count CHARACTERS, not bytes (Thai is 3 bytes/char, so a byte count
// reads ~3x too long and will send you rewriting a description that was fine).
//
// Title and Meta are the docx SUB-PAGES row "ติดต่อเรา" and ship VERBATIM at
// their own length (125 characters) — the brand spec is explicit that the
// docx-supplied rows are not to be padded to the 150-character floor. Earlier
// brands bolted an extra clause on to clear tools/verify-build.mjs' DESC_MIN;
// that is what this round deliberately stops doing. If the verifier objects,
// the floor is the thing to relax, not this sentence.
//
// This page is a BUTTON PAGE: zero section headings, zero paragraphs, nothing
// that turns it back into an article. The docx gives it a Title and a Meta and
// never a body, so any prose found here came from an earlier rebrand inventing
// it. The whole body is the <h1>, the LINE image, the BRAND_ADDRESS block and
// the button row — in that order. Rendered inventory: h1x1, h2x0, h3x0.
//
// <Announcement /> is bare on purpose: Announcement5's default message is this
// brand's copy, so the ticker matches index.astro without a second string here.
//
// The BRAND_ADDRESS block below names NO colour on purpose — it inherits
// ContentBox's body colour and draws its rule from currentColor, so it lands
// correctly on every brand this template is relaunched for. Retyping it in this
// round's palette is exactly what leaves the previous brand's hex behind next
// time. The lines themselves come from BRAND_ADDRESS; never retype those either.
const pageDescription = "DIAMOND789 เปิดช่องทางติดต่อเรื่องบัญชี ทางเข้า โปรโมชั่น เกม และสถานะธุรกรรม พร้อมข้อมูลช่วยตรวจสอบรายการและขั้นตอนการใช้งาน";

// BRAND_ADDRESS is visible text only — it never goes into the graph below.
const graph = pageGraph(Astro, {
  type: "ContactPage",
  name: "ติดต่อทีมงาน DIAMOND789",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "ติดต่อเรา", path: "/contact-us" },
  ],
  org: {
    alternateName: "DIAMOND789 แพลตฟอร์มสล็อตออนไลน์ที่รวบรวมเกมจากหลายค่ายไว้ในระบบเดียว พร้อมโปรโมชั่นทุนน้อยและเงื่อนไขไม่มีขั้นต่ำในบางช่องทาง",
    contactPoints: [
      {
        contactType: "customer service",
        availableLanguage: ["Thai", "English"],
        path: "/line",
        description: "ติดต่อแอดมินผ่าน LINE Official",
      },
    ],
  },
});
---

<MainLayout title="DIAMOND789 | ติดต่อทีมงานและสอบถามข้อมูลการใช้งาน" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="ติดต่อทีมงาน DIAMOND789" as="h1">
    <Picture
      src={imgLine}
      alt="ผู้หญิงผมยาวสีน้ำตาลในชุดเลื่อมสีชมพูยืนกอดอกและยิ้ม ด้านล่างเป็นปุ่มสีขาวที่มีไอคอนแชต LINE สีเขียวและคำว่า Support"
      loading="lazy"
      fetchpriority="low"
      widths={[200, 400, 600]}
      sizes="(max-width: 400px) 100vw, 400px"
      class="mx-auto h-auto w-full max-w-[400px] object-contain shadow-[0_10px_30px_rgba(243,13,140,0.22)]"
      decoding="async"
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      quality={60}
    />
    {
      BRAND_ADDRESS.lines.length > 0 && (
        <address aria-label={BRAND_ADDRESS.label} class="mt-8 mb-8 border-l-4 border-current/30 pl-6 text-left text-base leading-relaxed not-italic opacity-90">
          <p class="mb-1 font-bold tracking-wide">{BRAND_ADDRESS.label}</p>
          {BRAND_ADDRESS.lines.map((line) => (
            <span class="block">{line}</span>
          ))}
          {BRAND_ADDRESS.email && (
            <span class="mt-3 block">
              <span aria-hidden="true" class="mr-2">
                ✉️
              </span>
              <a href={`mailto:${BRAND_ADDRESS.email}`} class="font-bold underline decoration-current/40 underline-offset-4">
                {BRAND_ADDRESS.email}
              </a>
            </span>
          )}
        </address>
      )
    }

    <div class="flex flex-wrap justify-center gap-4">
      <a
        href="/register"
        aria-label="สมัครสมาชิก"
        class="flex items-center justify-center rounded-lg border border-[#ff5cb8]/60 bg-gradient-to-b from-[#f30d8c] to-[#b80568] px-8 py-3 font-bold text-white shadow-[0_10px_30px_rgba(243,13,140,0.30)] transition-transform hover:scale-105 hover:shadow-[0_15px_40px_rgba(243,13,140,0.44)]">
        สมัครสมาชิก
      </a>

      <a
        href="/login"
        aria-label="เข้าสู่ระบบ"
        class="flex items-center justify-center rounded-lg border border-[#f30d8c]/65 bg-[#1a0d16] px-8 py-3 font-extrabold text-[#f8e3f0] shadow-[0_4px_14px_rgba(243,13,140,0.30)] transition-transform hover:scale-105 hover:border-[#ff5cb8] hover:bg-[#2b0620]">
        เข้าสู่ระบบ
      </a>

      <a
        href="/line"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="ติดต่อทีมงานผ่าน Line Official"
        class="flex items-center justify-center rounded-lg border border-green-300 bg-gradient-to-b from-green-400 to-green-700 px-8 py-3 font-bold text-white transition-transform hover:scale-105">
        ติดต่อผ่าน Line Official
      </a>
    </div>
  </ContentBox>
  <Navfoot />
</MainLayout>
