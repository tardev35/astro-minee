---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/AnnouncementPremium.astro";

import { Picture } from "astro:assets";
import imgLine from "../assets/contact-line.webp";
import { pageGraph } from "../lib/schema";
import { BRAND_ADDRESS } from "../lib/brandProfile";

// One string, used twice: MainLayout's <meta name="description"> and the
// WebPage node's description. Keeping it in a const is what stops the meta tag
// and the structured data from drifting apart — they used to be two hand-typed
// variants of the same sentence, and the JSON-LD copy was the one nobody
// reread. Count CHARACTERS, not bytes (Thai is 3 bytes/char, so a byte count
// reads ~3x too long and will send you rewriting a description that was fine).
//
// Title and Meta are the docx SUB-PAGES row "ติดต่อเรา". The docx sentence runs
// 131 characters, under the DESC_MIN=150 floor tools/verify-build.mjs enforces
// on every indexable page, so it opens the description verbatim and one clause
// about the LINE channel closes it. Measured at 157 characters.
//
// This page is a BUTTON PAGE: zero section headings, zero paragraphs, nothing
// that turns it back into an article. The docx gives it a Title and a Meta and
// never a body, so any prose found here came from an earlier rebrand inventing
// it. The whole body is the <h1>, the LINE image, the BRAND_ADDRESS block and
// the button row — in that order.
//
// <Announcement /> is bare on purpose: AnnouncementPremium's default message is
// this brand's copy, so the ticker matches index.astro without a second string
// here.
const pageDescription = "LAVA432 เปิดช่องทางติดต่อเรื่องบัญชี ทางเข้า โปรโมชั่น และสถานะธุรกรรม พร้อมข้อมูลช่วยตรวจสอบรายการและขั้นตอนการใช้งานที่เกี่ยวข้อง ติดต่อผ่าน LINE ได้ทุกวัน";

// BRAND_ADDRESS is visible text only — it never goes into the graph below.
const graph = pageGraph(Astro, {
  type: "ContactPage",
  name: "ติดต่อทีมงาน LAVA432",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "ติดต่อเรา", path: "/contact-us" },
  ],
  org: {
    alternateName: "LAVA432 แพลตฟอร์มสล็อตออนไลน์ระบบใหม่ที่รวมเกมหลายรูปแบบไว้ในบัญชีเดียว พร้อมระบบฝากถอนออโต้และหน้าตรวจสอบธุรกรรม รองรับทั้งมือถือและคอมพิวเตอร์",
    contactPoints: [
      {
        contactType: "customer service",
        availableLanguage: ["Thai", "English"],
        path: "/line",
        description: "ติดต่อแอดมินผ่าน LINE Official",
      },
    ],
  },
});
---

<MainLayout title="LAVA432 | ติดต่อทีมงานและสอบถามข้อมูลการใช้งาน" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="ติดต่อทีมงาน LAVA432" as="h1">
    <Picture
      src={imgLine}
      alt="ผู้หญิงผมยาวสีน้ำตาลในชุดเลื่อมสีชมพูยืนกอดอกและยิ้ม ด้านล่างเป็นปุ่มสีขาวที่มีไอคอนแชต LINE สีเขียวและคำว่า Support"
      loading="lazy"
      fetchpriority="low"
      widths={[200, 400, 600]}
      sizes="(max-width: 400px) 100vw, 400px"
      class="mx-auto h-auto w-full max-w-[400px] object-contain shadow-[0_10px_30px_rgba(236,0,14,0.22)]"
      decoding="async"
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      quality={60}
    />
    {
      BRAND_ADDRESS.lines.length > 0 && (
        <address aria-label={BRAND_ADDRESS.label} class="mt-8 mb-8 border-l-4 border-[#ec000e] pl-6 text-left text-base leading-relaxed text-[#f4e3e0] not-italic">
          <p class="mb-1 font-bold text-[#ff6a13]">{BRAND_ADDRESS.label}</p>
          {BRAND_ADDRESS.lines.map((line) => (
            <span class="block">{line}</span>
          ))}
          {BRAND_ADDRESS.email && (
            <span class="mt-3 block">
              <span aria-hidden="true" class="mr-2">
                ✉️
              </span>
              <a href={`mailto:${BRAND_ADDRESS.email}`} class="font-bold text-[#ff6a13] underline decoration-current/40 underline-offset-4">
                {BRAND_ADDRESS.email}
              </a>
            </span>
          )}
        </address>
      )
    }

    <div class="flex flex-wrap justify-center gap-4">
      <a
        href="/register"
        aria-label="สมัครสมาชิก"
        class="flex items-center justify-center rounded-lg border border-[#ffa040]/60 bg-gradient-to-b from-[#ffa040] via-[#ff6a13] to-[#ec000e] px-8 py-3 font-bold text-[#120303] shadow-[0_10px_30px_rgba(255,106,19,0.30)] transition-transform hover:scale-105 hover:shadow-[0_15px_40px_rgba(236,0,14,0.44)]">
        สมัครสมาชิก
      </a>

      <a
        href="/login"
        aria-label="เข้าสู่ระบบ"
        class="flex items-center justify-center rounded-lg border border-[#ff6a13]/65 bg-[#2a0808] px-8 py-3 font-extrabold text-[#f4e3e0] shadow-[0_4px_14px_rgba(236,0,14,0.40)] transition-transform hover:scale-105 hover:bg-[#7a0206]">
        เข้าสู่ระบบ
      </a>

      <a
        href="/line"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="ติดต่อทีมงานผ่าน Line Official"
        class="flex items-center justify-center rounded-lg border border-green-300 bg-gradient-to-b from-green-400 to-green-700 px-8 py-3 font-bold text-white transition-transform hover:scale-105">
        ติดต่อผ่าน Line Official
      </a>
    </div>
  </ContentBox>
  <Navfoot />
</MainLayout>
