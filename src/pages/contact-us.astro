---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/AnnouncementPremium.astro";

import { Picture } from "astro:assets";
import imgLine from "../assets/contact-line.webp";
import { pageGraph } from "../lib/schema";
import { BRAND_ADDRESS } from "../lib/brandProfile";

// One string, used twice: MainLayout's <meta name="description"> and the
// WebPage node's description. Keeping it in a const is what stops the meta tag
// and the structured data from drifting apart — they used to be two hand-typed
// variants of the same sentence, and the JSON-LD copy was the one nobody
// reread. 150–160 CHARACTERS (Thai is 3 bytes/char, so a byte count reads ~3x
// too long and will send you rewriting a description that was fine). This one
// is the docx SUB-PAGES Meta for ติดต่อเรา plus one closing clause to clear the
// 150 gate — measured at 159 characters.
//
// This page is a BUTTON PAGE: zero section headings, zero paragraphs, nothing
// that turns it back into an article. The docx gives it a Title and a Meta and
// never a body, so any prose found here came from an earlier rebrand inventing
// it. The whole body is the <h1>, the LINE image, the BRAND_ADDRESS block and
// the button row — in that order.
const pageDescription = "WIN666 เปิดช่องทางติดต่อเกี่ยวกับบัญชี โปรโมชั่น ทางเข้า และรายการธุรกรรม พร้อมทีมงานช่วยตรวจสอบข้อมูลและให้คำแนะนำสมาชิก ดูแลตลอด 24 ชั่วโมงตามช่องทางที่กำหนด";

const graph = pageGraph(Astro, {
  type: "ContactPage",
  name: "ติดต่อทีมงาน WIN666",
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "ติดต่อเรา", path: "/contact-us" },
  ],
  org: {
    alternateName: "WIN666 คาสิโนออนไลน์ระบบใหม่ ฝากถอนง่ายด้วยระบบออโต้",
    contactPoints: [
      {
        contactType: "customer service",
        availableLanguage: ["Thai", "English"],
        // Point at this site's own /line hop, not the short link behind it.
        // This page is indexed, and structured data is read and stored by
        // Google directly — so a shortener host here is the group's most
        // exposed shared identifier. /line forwards to the same place and
        // that redirect page is noindex.
        //
        // `contactOption: "TollFree"` used to be here. That enum describes a
        // freephone NUMBER; on a chat link it is simply false, and a
        // ContactPoint Google rejects takes the rest of the node with it.
        path: "/line",
        description: "ติดต่อแอดมินผ่าน LINE Official",
      },
    ],
  },
});
---

<MainLayout title="WIN666 | ติดต่อทีมงานและสอบถามข้อมูลการใช้งาน" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title="ติดต่อทีมงาน WIN666" as="h1">
    <Picture
      src={imgLine}
      alt="พนักงานหญิงผมยาวในชุดเลื่อมสีชมพูยิ้มอยู่ข้างปุ่มสีขาวที่มีไอคอน LINE สีเขียวและคำว่า Support ช่องทางแชตกับทีมงาน WIN666"
      loading="lazy"
      fetchpriority="low"
      widths={[200, 400, 600]}
      sizes="(max-width: 768px) 100vw"
      class="mx-auto h-auto w-full max-w-[400px] object-contain shadow-[0_10px_30px_rgba(246,147,30,0.18)]"
      decoding="async"
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      quality={60}
    />
    {
      BRAND_ADDRESS.lines.length > 0 && (
        <address aria-label={BRAND_ADDRESS.label} class="mt-8 mb-8 border-l-4 border-[#f6931e] pl-6 text-left text-base leading-relaxed text-[#f2dfc4] not-italic">
          <p class="mb-1 font-bold text-[#fff2e0]">{BRAND_ADDRESS.label}</p>
          {BRAND_ADDRESS.lines.map((line) => (
            <span class="block">{line}</span>
          ))}
          {BRAND_ADDRESS.email && (
            <span class="mt-3 block">
              <span aria-hidden="true" class="mr-2">
                ✉️
              </span>
              <a href={`mailto:${BRAND_ADDRESS.email}`} class="font-bold text-[#ffb35c] underline decoration-current/40 underline-offset-4">
                {BRAND_ADDRESS.email}
              </a>
            </span>
          )}
        </address>
      )
    }

    <div class="flex flex-wrap justify-center gap-4">
      <a
        href="/register"
        aria-label="สมัครสมาชิก"
        class="flex items-center justify-center rounded-lg border border-[#f6931e]/60 bg-gradient-to-b from-[#ffb35c] via-[#f6931e] to-[#a8560a] px-8 py-3 font-bold text-[#180d02] shadow-[0_10px_30px_rgba(246,147,30,0.28)] transition-transform hover:scale-105 hover:shadow-[0_15px_40px_rgba(246,147,30,0.40)]">
        สมัครสมาชิก
      </a>

      <a
        href="/login"
        aria-label="เข้าสู่ระบบ"
        class="flex items-center justify-center rounded-lg border border-[#f6931e]/60 bg-[#161009] px-8 py-3 font-extrabold text-[#f5e0bb] shadow-[0_4px_14px_rgba(246,147,30,0.25)] transition-transform hover:scale-105 hover:bg-[#241a0e]">
        เข้าสู่ระบบ
      </a>

      <a
        href="/line"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="ติดต่อทีมงานผ่าน Line Official"
        class="flex items-center justify-center rounded-lg border border-green-300 bg-gradient-to-b from-green-400 to-green-700 px-8 py-3 font-bold text-white transition-transform hover:scale-105">
        ติดต่อผ่าน Line Official
      </a>
    </div>
  </ContentBox>
  <Navfoot />
</MainLayout>
