---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/AnnouncementPremium.astro";
import { pageGraph } from "../lib/schema";

// Button page, not an article: the whole body is the <h1> plus the two-button
// grid. The docx SUB-PAGES block gives this page a Title and a Meta and never
// a body, so no section heading and no prose belong here — not a login
// checklist, not a PIN/OTP notice. The h1 names what the page IS rather than
// previewing a section that does not exist. Rendered inventory: h1x1, h2x0,
// h3x0.
const pageTitle = "ทางเข้า TT1BET เว็บหลัก";

// <Announcement /> is called bare on purpose — AnnouncementPremium's default
// message is this brand's copy, set once in the component so every sub-page
// ticker and index.astro's explicit prop can never drift apart. Rotated off
// AnnouncementCyber, the outgoing brand's pick, per the brand spec.

// Title and description are the docx SUB-PAGES row for /ทางเข้า, both shipped
// VERBATIM at their own length. The description is shorter than the DESC_MIN=150
// floor and that is correct: the brief's own sentence is the brand's copy, not a
// draft to top up. verify-build.mjs exempts any description that appears
// literally in src/assets/content.txt for exactly this reason. Do not pad it.
const pageDescription = "TT1BET ทางเข้าเว็บคาสิโนสล็อต รวมค่ายเกมหลายรูปแบบ พร้อมโปรโมชั่น โบนัส ระบบสมาชิก และข้อมูลธุรกรรมให้ตรวจสอบได้ง่าย";

const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "ทางเข้า", path: "/ทางเข้า" },
  ],
});
---

<MainLayout title="TT1BET | ทางเข้าเว็บคาสิโนสล็อตรวมค่ายดัง" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={pageTitle} as="h1">
    <div class="mb-5 grid grid-cols-1 gap-8 md:grid-cols-2">
      <div class="flex flex-col items-center justify-center gap-4">
        <a
          href="/login"
          aria-label="เข้าสู่ระบบ TT1BET"
          class="group relative mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-[#b8862a]/70 bg-[#241a0d] px-6 py-4 shadow-[0_10px_30px_rgba(233,195,65,0.28)] transition-all duration-300 hover:scale-105 hover:border-[#e9c341] hover:bg-[#171008] hover:shadow-[0_15px_40px_rgba(233,195,65,0.36)]">
          <div class="absolute inset-x-0 top-0 h-1/2 bg-gradient-to-b from-[#e9c341]/22 to-transparent"></div>

          <svg
            class="relative z-10 h-9 w-9 text-[#fcf1b0]"
            aria-hidden="true"
            focusable="false"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            viewBox="0 0 24 24"
            xmlns="http://www.w3.org/2000/svg">
            <path stroke-linecap="round" stroke-linejoin="round" d="M11 16l-4-4m0 0l4-4m-4 4h14m-5 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h7a3 3 0 013 3v1"></path>
          </svg>

          <span class="relative z-10 text-3xl font-bold tracking-wide text-[#fcf1b0]">เข้าสู่ระบบ</span>
        </a>
      </div>

      <div class="flex flex-col items-center justify-center gap-4">
        <a
          href="/register"
          aria-label="สมัครสมาชิก TT1BET"
          class="group relative mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-[#b8862a]/60 bg-gradient-to-b from-[#fff8d6] via-[#e9c341] to-[#b8862a] px-6 py-4 shadow-[0_10px_30px_rgba(233,195,65,0.34)] transition-all duration-300 hover:scale-105 hover:shadow-[0_15px_40px_rgba(184,134,42,0.45)]">
          <div class="absolute inset-x-0 top-0 h-1/2 bg-gradient-to-b from-[#fcf1b0]/28 to-transparent"></div>

          <svg
            class="relative z-10 h-9 w-9 text-[#0b0805]"
            aria-hidden="true"
            focusable="false"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            viewBox="0 0 24 24"
            xmlns="http://www.w3.org/2000/svg">
            <path stroke-linecap="round" stroke-linejoin="round" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z"></path>
          </svg>

          <span class="relative z-10 text-3xl font-bold tracking-wide text-[#0b0805]">สมัครสมาชิก</span>
        </a>
      </div>
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
