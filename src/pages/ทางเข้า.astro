---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement3.astro";
import { pageGraph } from "../lib/schema";

const pageTitle = "ทางเข้าเล่น LCX88 รองรับมือถือ แท็บเล็ต และคอมพิวเตอร์";

const pageDescription =
  "LCX88 ทางเข้าเล่นคาสิโนออนไลน์ รองรับมือถือ แท็บเล็ต และคอมพิวเตอร์ พร้อมรวมเกม โปรโมชั่น และบริการต่าง ๆ ไว้ในระบบเดียว ควรตรวจสอบช่องทางเข้าก่อนกรอกข้อมูล";

const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "ทางเข้าเล่น", path: "/ทางเข้า" },
  ],
});
---

<MainLayout title="LCX88 | ทางเข้าเล่นคาสิโนออนไลน์รองรับทุกอุปกรณ์" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={pageTitle} as="h1">
    <div>
      <h2 class="mb-6 bg-gradient-to-r from-[#ffe08a] via-[#f5c542] to-[#6ea3ff] bg-clip-text text-2xl leading-normal font-bold text-transparent">ตรวจช่องทางเข้า LCX88 ให้ครบก่อนกรอกข้อมูลบัญชี</h2>

      <p class="mb-6 text-left text-base leading-relaxed text-[#d7e3ff]">
        ชื่อ LCX88 ปรากฏอยู่บนหลายโดเมนและหลายช่องทางโซเชียล ผลค้นหาจึงมีทั้งเว็บหลัก บัญชีโซเชียล และหน้ารวมลิงก์ปะปนกัน ก่อนกรอกข้อมูลบัญชีจึงควรไล่ตรวจให้ครบสี่จุด
        คือชื่อเว็บไซต์ทุกตัวอักษร การเชื่อมต่อว่าเป็น HTTPS โลโก้ที่แสดงบนหน้า และปลายทางของปุ่มเข้าสู่ระบบว่าพาไปที่ใด
        โดยเฉพาะลิงก์ที่ถูกส่งต่อมาในข้อความส่วนตัวหรือเด้งเปลี่ยนหน้าหลายรอบก่อนพามาถึงหน้ากรอกข้อมูล เพราะชื่อคล้ายกันและโลโก้คล้ายกันไม่ได้ยืนยันว่าเป็นเว็บเดียวกัน
        จากนั้นดูต่อว่าเมนูเข้าสู่ระบบ สมัครสมาชิก โปรโมชั่น ทดลองเล่น และช่องทางติดต่อทีมงานอยู่ครบตามปกติหรือไม่ เพราะหน้าเลียนแบบมักลอกภาพได้เหมือนแต่ตกหล่นบางเมนู
        หรือรีบพาไปหน้ากรอกข้อมูลตั้งแต่คลิกแรก หากมีผู้ใดขอรหัสผ่าน รหัสยืนยัน หรือข้อมูลธนาคารผ่านแชต ควรหยุดทันที เพราะทีมงานดูแลสมาชิกไม่ขอข้อมูลเหล่านี้ผ่านช่องทางส่วนตัว
      </p>

      <h2 class="mb-6 bg-gradient-to-r from-[#ffe08a] via-[#f5c542] to-[#6ea3ff] bg-clip-text text-2xl leading-normal font-bold text-transparent">เข้าระบบ LCX88 แล้วใช้อะไรได้บ้าง และควรหยุดทำรายการตอนไหน</h2>

      <p class="mb-6 text-left text-base leading-relaxed text-[#d7e3ff]">
        เมื่อเข้าสู่ระบบแล้ว บัญชีเดียวเปิดใช้งานเกมคาสิโนออนไลน์ได้หลายรูปแบบที่ LCX88 รวบรวมไว้ในระบบเดียว ทั้งเกมสล็อต บาคาร่า รูเล็ต เกมไพ่ และคาสิโนสดจากหลายค่าย
        เลือกดูตามประเภทเกม ค่าย หรือรูปแบบที่ถนัดได้จากหน้าเดียว ก่อนเริ่มควรศึกษากติกา อัตราการจ่าย และเงื่อนไขของแต่ละเกม เพื่อวางงบประมาณให้เหมาะกับตนเองมากกว่าเลือกจากหน้าปกเกมอย่างเดียว
        เว็บไซต์รองรับทั้งมือถือ แท็บเล็ต และคอมพิวเตอร์ จึงเข้าสู่ระบบและทำรายการผ่านเบราว์เซอร์ได้โดยไม่ต้องติดตั้งโปรแกรมเพิ่ม ควรใช้อินเทอร์เน็ตที่เสถียร อัปเดตเบราว์เซอร์ให้เป็นรุ่นล่าสุด
        และหลีกเลี่ยงเครือข่ายสาธารณะเมื่อต้องทำธุรกรรม
      </p>

      <p class="mb-8 text-left text-base leading-relaxed text-[#d7e3ff]">
        ด้านการเงิน ระบบฝากถอนออโต้ช่วยลดขั้นตอนการทำรายการผ่านหน้าบัญชีของตนเอง และเงื่อนไขไม่มีขั้นต่ำช่วยให้กำหนดยอดได้ยืดหยุ่นตามช่องทางที่เว็บไซต์กำหนด
        ก่อนยืนยันควรตรวจชื่อบัญชี จำนวนเงิน ช่องทางที่รองรับ และข้อกำหนดของโปรโมชั่นให้ตรงกันทุกครั้ง หากยอดยังไม่เปลี่ยนไม่ควรกดซ้ำทันที เพราะระบบอาจกำลังประมวลผลอยู่
        และหลังทำรายการควรเก็บเลขรายการหรือภาพหน้าจอไว้ตรวจสอบภายหลัง ควรตั้งรหัสผ่านที่คาดเดายาก กรอกข้อมูลเฉพาะบนโดเมนที่ตรวจแล้ว และออกจากระบบทุกครั้งเมื่อใช้อุปกรณ์ร่วมกับผู้อื่น
        เมื่อพบปัญหาเรื่องบัญชี ทางเข้าเล่น โปรโมชั่น หรือสถานะฝากถอน ทีมงานดูแลสมาชิกรับเรื่องตลอด 24 ชั่วโมงผ่านช่องทางที่เว็บไซต์ระบุ และถ้าไม่แน่ใจว่าลิงก์
        <strong class="text-[#ffe08a]">ทางเข้าเล่น LCX88</strong> หรือลิงก์สมัครสมาชิกใดคือของจริง เราเตรียมลิงก์ที่ถูกต้องไว้ให้แล้วที่ปุ่มด้านล่างนี้
      </p>

      <div class="mb-5 grid grid-cols-1 gap-8 md:grid-cols-2">
        <div class="flex flex-col items-center justify-center gap-4">
          <a
            href="/login"
            aria-label="เข้าสู่ระบบ LCX88"
            class="group relative mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-[#2f6bff]/60 bg-[#071138] px-6 py-4 shadow-[0_10px_30px_rgba(47,107,255,0.20)] transition-all duration-300 hover:scale-105 hover:border-[#f5c542] hover:bg-[#122264] hover:shadow-[0_15px_40px_rgba(245,197,66,0.30)]">
            <div class="absolute inset-x-0 top-0 h-1/2 bg-gradient-to-b from-[#2f6bff]/25 to-transparent"></div>

            <svg
              class="relative z-10 h-9 w-9 text-[#6ea3ff]"
              aria-hidden="true"
              focusable="false"
              fill="none"
              stroke="currentColor"
              stroke-width="2.5"
              viewBox="0 0 24 24"
              xmlns="http://www.w3.org/2000/svg">
              <path stroke-linecap="round" stroke-linejoin="round" d="M11 16l-4-4m0 0l4-4m-4 4h14m-5 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h7a3 3 0 013 3v1"></path>
            </svg>

            <span class="relative z-10 text-3xl font-bold tracking-wide text-[#ffe08a]">เข้าสู่ระบบ</span>
          </a>
        </div>

        <div class="flex flex-col items-center justify-center gap-4">
          <a
            href="/register"
            aria-label="สมัครสมาชิก LCX88"
            class="group relative mx-auto flex w-full max-w-[320px] items-center justify-center gap-3 overflow-hidden rounded-xl border border-[#f5c542]/60 bg-gradient-to-r from-[#ffe08a] via-[#f5c542] to-[#c08b1f] px-6 py-4 shadow-[0_10px_30px_rgba(245,197,66,0.22)] transition-all duration-300 hover:scale-105 hover:shadow-[0_15px_40px_rgba(245,197,66,0.34)]">
            <div class="absolute inset-x-0 top-0 h-1/2 bg-gradient-to-b from-white/55 to-transparent"></div>

            <svg
              class="relative z-10 h-9 w-9 text-[#04102e]"
              aria-hidden="true"
              focusable="false"
              fill="none"
              stroke="currentColor"
              stroke-width="2.5"
              viewBox="0 0 24 24"
              xmlns="http://www.w3.org/2000/svg">
              <path stroke-linecap="round" stroke-linejoin="round" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z"></path>
            </svg>

            <span class="relative z-10 text-3xl font-bold tracking-wide text-[#04102e]">สมัครสมาชิก</span>
          </a>
        </div>
      </div>
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
