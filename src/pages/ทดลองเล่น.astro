---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement5.astro";

import { Picture } from "astro:assets";
import { itemList, pageGraph, schemaCtx } from "../lib/schema";
import image1 from "../assets/gamedemo7.webp";
import image2 from "../assets/gamedemo8.webp";
import image3 from "../assets/gamedemo9.webp";
import image4 from "../assets/gamedemo10.webp";
import image5 from "../assets/gamedemo11.webp";
import image6 from "../assets/gamedemo12.webp";
import image7 from "../assets/gamedemo13.webp";
import image8 from "../assets/gamedemo14.webp";
import image9 from "../assets/gamedemo15.webp";
import image10 from "../assets/gamedemo16.webp";
import image11 from "../assets/gamedemo17.webp";
import image12 from "../assets/gamedemo18.webp";

// One list, two consumers: the gallery below and the ItemList in the JSON-LD.
// They used to be two hand-kept arrays that had to stay in the same order, and
// the name shown to a reader could drift from the name handed to a crawler.
//
// Every alt below was written by opening the file: it describes the artwork on
// the banner (logo + character + setting), not the page it happens to sit on.
// They describe the game PROVIDER's banner, not the brand, so a rebrand leaves
// them alone.
const demoGames = [
  { name: "AskmeSlot", src: image1, alt: "แบนเนอร์ค่ายเกม AskmeSlot โลโก้โพดำสีเหลือง คู่ภาพตัวการ์ตูนเด็กชายสวมหมวกและเสื้อแจ็กเก็ตสีแดงบนถนนเมืองเก่าที่มีกังหันลม" },
  { name: "Popular Game", src: image2, alt: "แบนเนอร์ POPULAR GAME ตัวอักษรทอง มีตัวการ์ตูนกระต่ายและแมวใส่แว่นยืนขนาบหีบสมบัติ พร้อมชิปคาสิโนและกองเหรียญทอง" },
  { name: "SlotXO", src: image3, alt: "แบนเนอร์ค่ายเกม SlotXO โลโก้รูปตู้สล็อต คู่ภาพนักรบโรมันเคราขาวสวมมงกุฎใบลอเรลหน้าโคลอสเซียม" },
  { name: "Skywind Group", src: image4, alt: "แบนเนอร์ค่ายเกม Skywind Group โลโก้วงกลมสี่สี คู่ภาพแมวกวักญี่ปุ่นสีขาวท่ามกลางดอกซากุระและก้อนทอง" },
  { name: "PG Soft", src: image5, alt: "แบนเนอร์ค่ายเกม PG Soft หรือ Pocket Games Soft คู่ภาพนักรบหญิงสวมเครื่องประดับขนนกสไตล์แอซเท็ก" },
  { name: "SBOBET", src: image6, alt: "แบนเนอร์ค่ายเกม SBOBET คู่ภาพตัวการ์ตูนสาวผมบลอนด์ในชุดกิโมโนสีชมพูถืออมยิ้มเกลียวสีรุ้ง" },
  { name: "Sexy Slot", src: image7, alt: "แบนเนอร์ค่ายเกม Sexy Slot ตัวอักษรสีชมพูม่วง คู่ภาพตัวการ์ตูนสาวในชุดรัดรูปสีม่วงพร้อมรูปหัวใจลอยรอบตัว" },
  { name: "JILI", src: image8, alt: "แบนเนอร์ค่ายเกม JILI ตัวอักษรทอง คู่ภาพนางเงือกผมแดงถือหอยสังข์อยู่ใต้ทะเลพร้อมปลาการ์ตูน" },
  { name: "Ask Me Bet", src: image9, alt: "แบนเนอร์ค่ายเกม Ask Me Bet คู่ภาพหัวสิงโตเชิดสีแดงทองท่ามกลางโคมไฟจีนสีแดง" },
  { name: "New Game", src: image10, alt: "แบนเนอร์ New Game ตัวอักษรสีขาวบนฟลอร์เรืองแสง มีตัวการ์ตูนหัวฟักทองและโครงกระดูกยืนขนาบสองข้าง" },
  { name: "JOKER", src: image11, alt: "แบนเนอร์ค่ายเกม JOKER คู่ภาพนักรบโรมันสวมหมวกเหล็กยอดแหลมยืนคู่สิงโตคำรามในสนามประลอง" },
  { name: "AFB Gaming", src: image12, alt: "แบนเนอร์ค่ายเกม AFB Gaming คู่ภาพเทพเจ้ากรีกเคราขาวสวมมงกุฎใบลอเรล ดวงตาเปล่งแสงหน้าวิหารเสาหิน" },
];

// The URL each entry resolves to is schema.ts's problem, not this file's — an
// older version pasted a hand-built page URL onto all 12 and got the trailing
// slash and the Thai encoding wrong on every one of them.
const gameList = demoGames.map((game) => ({ name: game.name, imagePath: game.src.src }));

const pageTitle = "ทดลองเล่นสล็อตกับ AMB194 เพื่อศึกษารูปแบบเกมก่อนเล่นจริง";

// docx SUB-PAGES Meta ของหน้าทดลองเล่น + วรรคปิดท้ายหนึ่งวรรคให้ผ่านเกท 150
// นับเป็น "ตัวอักษร" ไม่ใช่ไบต์ (ภาษาไทย 3 ไบต์/ตัว) — สตริงนี้วัดได้ 155 ตัวอักษร
const pageDescription =
  "AMB194 ทดลองเล่นสล็อตเพื่อเรียนรู้กติกา ฟีเจอร์โบนัส และรูปแบบการจ่าย ช่วยให้เลือกเกมได้เหมาะกับความชอบและงบประมาณ ก่อนตัดสินใจเริ่มใช้งานบัญชีจริงทุกครั้ง";

const ctx = schemaCtx(Astro);
const graph = pageGraph(Astro, {
  type: "CollectionPage",
  name: pageTitle,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "ทดลองเล่น", path: "/ทดลองเล่น" },
  ],
  extra: [
    itemList(ctx, {
      name: "ทดลองเล่นเกมสล็อตหลายรูปแบบของ AMB194",
      alternateName: "AMB194 โหมดทดลองเล่นสล็อตบนมือถือก่อนเริ่มใช้งานจริง",
      itemType: "Game",
      items: gameList,
    }),
  ],
});
---

<MainLayout title="AMB194 | ทดลองเล่นสล็อตเพื่อศึกษารูปแบบเกมก่อนเล่นจริง" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={pageTitle} as="h1">
    <div>
      <h2 class="mb-6 bg-gradient-to-r from-[#fff3ae] via-[#f8d441] to-[#d9a520] bg-clip-text text-2xl leading-normal font-bold text-transparent">โหมดทดลองของ AMB194 มีไว้ทำอะไร และควรดูอะไรก่อนเลือกเกม</h2>

      <p class="mb-8 text-left text-base leading-relaxed text-[#f5ecd6]">
        AMB194 เป็นแพลตฟอร์มเกมสล็อตออนไลน์ที่รวบรวมเกมหลายรูปแบบไว้ในระบบเดียว ทั้งสล็อตคลาสสิก เกมโบนัส และเกมธีมใหม่ ๆ ที่มีรูปแบบการจ่ายต่างกัน จากหลายค่ายด้วยกัน ทั้ง PG Soft, JOKER, JILI, SlotXO และค่ายที่เห็นอยู่ด้านล่างนี้
        หน้านี้จึงเป็นที่ให้กดเปิดดูหน้าเกมก่อนว่าหน้าตาของเกมเป็นแบบไหน ปุ่มปรับเดิมพันต่อไม้อยู่ตรงไหน ฟีเจอร์โบนัสหรือฟรีสปินเข้าเงื่อนไขอย่างไร และหนึ่งรอบใช้เวลาแค่ไหน โดยยังไม่ต้องใส่เงินจริงและไม่มีการได้เสียเกิดขึ้น
        สิ่งที่ควรดูจริงคือกติกาของเกม อัตราจ่ายรางวัลและตารางสัญลักษณ์ เงื่อนไขของฟีเจอร์พิเศษ ระดับความผันผวนของเกมนั้น และวงเงินเดิมพันขั้นต่ำต่อรอบ เพื่อเลือกเกมให้เหมาะกับงบประมาณของตนเอง
        มากกว่าดูว่าเกมไหนกำลังมีคนเล่นเยอะที่สุด เกมยอดนิยมช่วยให้หาคนคุยด้วยง่าย แต่ไม่ได้ช่วยเจรจากับผลของรอบถัดไปเป็นการส่วนตัว ถือเป็นการอ่านคู่มือก่อนขับ ซึ่งน่าเบื่อกว่าการลองขับเลยอยู่แล้ว แต่ค่าซ่อมมันถูกกว่ากันเยอะ
      </p>

      <div class="mb-5 grid grid-cols-2 gap-5 sm:grid-cols-2 md:grid-cols-4">
        {
          demoGames.map((game) => (
            <div class="group/game relative mx-auto w-full max-w-[400px] overflow-hidden rounded-xl">
              <Picture
                src={game.src}
                alt={game.alt}
                loading="lazy"
                fetchpriority="low"
                widths={[160, 320, 480]}
                sizes="(max-width: 767px) 42vw, (max-width: 1520px) 23vw, 320px"
                class="block h-auto w-full object-cover shadow-[0_10px_30px_rgba(248,212,65,0.20)] transition-transform duration-300 group-hover/game:scale-105"
                decoding="async"
                formats={["avif", "webp"]}
                fallbackFormat="webp"
                quality={60}
              />
              <a
                href="/register"
                target="_blank"
                rel="noopener noreferrer"
                aria-label={`สมัครสมาชิกเพื่อเล่น ${game.name} ที่ AMB194`}
                class="absolute inset-0 flex items-center justify-center bg-[#0b0806]/75 opacity-0 transition-opacity duration-300 group-hover/game:opacity-100 focus-visible:opacity-100">
                <span class="rounded-full border border-[#f8d441]/60 bg-gradient-to-r from-[#fff8d6] via-[#fff3ae] to-[#f8d441] px-6 py-2 font-bold text-[#170f02] shadow-[0_10px_30px_rgba(217,165,32,0.32)] transition-transform hover:scale-110">เล่นเลย</span>
              </a>
            </div>
          ))
        }
      </div>

      <h2 class="mt-8 mb-6 bg-gradient-to-r from-[#fff3ae] via-[#f8d441] to-[#d9a520] bg-clip-text text-2xl leading-normal font-bold text-transparent">โหมดทดลองบอกอะไรได้ และบอกอะไรไม่ได้</h2>

      <p class="mb-4 text-left text-base leading-relaxed text-[#f5ecd6]">
        โหมดทดลองบอกได้ว่าเกมทำงานอย่างไร เมนูอยู่ตรงไหน ปรับเดิมพันต่อรอบได้ละเอียดแค่ไหน ซื้อฟีเจอร์ได้หรือไม่ และหนึ่งรอบใช้เวลาเท่าไร แต่เครดิตในโหมดนี้เป็นยอดสมมติ ถอนไม่ได้ และผลที่ออกมาก็ไม่ได้บอกว่าเล่นจริงจะได้ผลเหมือนกัน
        คำว่าแตกไม่อั้นหรือเกมกำลังมาแรงเป็นคำโฆษณาที่ใช้สื่อถึงจังหวะลุ้นรางวัลและฟีเจอร์ที่น่าสนใจเท่านั้น ไม่สามารถรับประกันผลลัพธ์ได้ ต่อให้กดในโหมดทดลองแล้วโบนัสเข้าติดกันหลายรอบ ก็ไม่ใช่หลักฐานว่าเกมนั้นกำลังอารมณ์ดีรอเราอยู่
        ประวัติการหมุนที่เห็นบนหน้าจอเป็นบันทึกของรอบที่จบไปแล้ว ไม่ใช่คำใบ้ของรอบถัดไป เกมที่ความผันผวนสูงอาจเงียบยาวแล้วจ่ายก้อนเดียว ส่วนเกมผันผวนต่ำมักจ่ายย่อยถี่กว่า ทั้งสองแบบไม่ได้แปลว่าแบบไหนดีกว่ากัน แค่เหมาะกับงบคนละแบบ
      </p>

      <p class="mb-4 text-left text-base leading-relaxed text-[#f5ecd6]">
        อีกเรื่องที่ควรเผื่อใจคือโหมดทดลองไม่ได้มีให้ครบทุกเกม บางค่ายเปิดเฉพาะบางชุดเกม และบางเกมที่เพิ่งปล่อยใหม่ก็ยังไม่เปิดโหมดนี้ จึงควรเปิดหน้ารายละเอียดของเกมดูก่อนเลือก
        และยอดที่หมุนในโหมดทดลองไม่นับเป็นยอดเทิร์นของบัญชีหรือของโปรโมชั่นใด ถ้าเกมที่อยากลองไม่มีปุ่มทดลอง ให้ถือว่าวันนี้โชคไม่ดี ไม่ใช่สัญญาณลับที่ระบบส่งมาให้เราคนเดียว
        การรวมเกมไว้ในระบบเดียวช่วยให้ค้นหาตามค่าย ธีม หรือสไตล์การจ่ายที่ชื่นชอบได้จากหน้าเดียว และเว็บไซต์รองรับทั้งมือถือ แท็บเล็ต และคอมพิวเตอร์ จึงเปิดดูเกมผ่านเบราว์เซอร์ได้โดยไม่ต้องติดตั้งโปรแกรมเพิ่ม
        ควรใช้อินเทอร์เน็ตที่เสถียรและอัปเดตเบราว์เซอร์ให้เป็นรุ่นล่าสุด
      </p>

      <h2 class="mt-8 mb-6 bg-gradient-to-r from-[#fff3ae] via-[#f8d441] to-[#d9a520] bg-clip-text text-2xl leading-normal font-bold text-transparent">จากโหมดทดลองไปเล่นจริงบน AMB194 ควรเช็กอะไรก่อน</h2>

      <p class="mb-2 text-left text-base leading-relaxed text-[#f5ecd6]">
        ถ้าจะขยับจากโหมดทดลองไปเล่นด้วยเงินจริง เรื่องที่ควรดูก่อนคือบัญชี งบต่อรอบ โปรโมชั่น และช่องทางเข้า ด้านบัญชี ควรใช้ข้อมูลที่ตรงกับตอนสมัคร ทั้งเบอร์โทรที่รับข้อความได้จริงและข้อมูลสำหรับทำรายการที่เป็นของผู้สมัครเอง
        และตั้งรหัสผ่านที่คาดเดายาก ไม่ซ้ำกับบริการอื่น ไม่ใช่เลขวันเกิด เลขเรียง หรือเลขซ้ำทั้งชุด เพราะสมัครเร็วเป็นเรื่องดี แต่กรอกผิดแล้วตามแก้ทีหลัง ความเร็วก็หายหมด
        ด้านงบ ควรกำหนดวงเงินและเวลาเล่นให้ชัดเจนก่อนเริ่ม แล้วดูเดิมพันขั้นต่ำต่อรอบของเกมที่เลือกประกอบ ตัวเลขนั้นเป็นเดิมพันของเกม ไม่ใช่เงื่อนไขของการฝากหรือการถอน
        ระบบธุรกรรมของ AMB194 ช่วยให้สมาชิกทำรายการผ่านหน้าบัญชีได้โดยตรง โดยไม่ต้องส่งข้อมูลเดิมซ้ำหลายรอบ จึงควรตรวจสอบชื่อบัญชี จำนวนเงิน และสถานะรายการให้ครบถ้วนก่อนยืนยันทุกครั้ง และหากรายการยังดำเนินการอยู่ ควรรอผลจากระบบก่อนทำซ้ำ
        ถ้าจะกดรับโปรโมชั่นก็ต้องอ่านยอดฝากขั้นต่ำ โบนัสที่ได้รับ จำนวนเทิร์น เกมที่ร่วมรายการ และเพดานถอนให้จบก่อน
        สุดท้ายควรเข้าใช้งานผ่านช่องทางหลักของ AMB194 ที่ตรวจชื่อเว็บไซต์แล้วและเชื่อมต่อแบบ HTTPS เท่านั้น หลีกเลี่ยงเครือข่ายสาธารณะเมื่อต้องทำธุรกรรม และหากติดปัญหาระหว่างใช้งาน ให้เก็บเวลา จำนวนเงิน และรายละเอียดรายการไว้ติดต่อทีมงาน โดยไม่เปิดเผยรหัสผ่านหรือข้อมูลยืนยันแก่ผู้อื่น
      </p>
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
