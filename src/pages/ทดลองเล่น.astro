---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/AnnouncementHuay.astro";
import { pageGraph } from "../lib/schema";

// This page imports NO image, and that is a decision rather than an omission.
// The only "demo" art in the repo is src/assets/gamedemo7-18.webp — twelve slot
// and live-casino game covers left behind by an earlier brand. หวยพร้อม sells
// หวย, so a grid of those covers on this page can only go one of two ways: an
// honest alt ("ปกเกมสล็อต…") puts twelve off-topic pictures on a lottery page,
// or a lottery-sounding alt describes something the picture is not. Neither is
// worth a tile row, so the files stay in src/assets as inventory for the next
// slot brand. DO NOT import them: an imported image is an emitted image, and
// verify-build.mjs fails the build on an image that ships unrendered. Because
// nothing is imported, the stale-asset sweep has nothing to check here either.
//
// What carries the page instead is the four-step walkthrough below — no images,
// plain markup, and each step's label is a <p>/<span> with an aria-label on the
// region, because only the article body may produce a heading. It is NOT an
// h3-bearing icon-card block: the sanctioned source of an h3 is
// FeatureHighlights.astro, and that file still carries a previous brand's
// palette, so wiring it in here would ship off-brand colour.
//
// <Announcement /> is bare: AnnouncementHuay's default message is this brand's
// copy, so the ticker matches index.astro without a second string here. The
// variant rotated off AnnouncementPremium, the outgoing brand's pick, per the
// brand spec.
//
// หวยพร้อม's brief frames the site as a platform that gathers ประเภทหวย, ระบบ
// กรอกโพย, อัตราจ่าย and ข้อมูลผลรางวัล into one system. Its standing advice:
// check ชื่อรายการ / วันที่ออกรางวัล / เวลาปิดรับ before choosing a number;
// know whether the bet is 2 ตัว, 3 ตัว or วิ่ง and whether it is ตรง or โต๊ด
// before typing an amount; read เลขอั้น status, because a number may be capped,
// repriced or closed once a งวด reaches its limit; compare the price the system
// actually shows rather than a headline อัตราจ่าย; and keep the โพย's เลขอ้างอิง
// for checking back. Its standing caveat is that ไม่อั้นเลข and จ่ายเยอะ are
// wording, not a guarantee, and that a higher payout rate does not mean a better
// chance of winning. The brief names no wallet, no bank and no payment brand, so
// neither does this page — and it promises no payout, no win rate, and never
// that a trial run predicts a real draw.
const trySteps = [
  {
    icon: "🗂️",
    label: "เลือกประเภทหวยแล้วตรวจงวดกับเวลาปิดรับให้ตรงกัน",
    detail:
      "ระบบจัดหมวดหวยตามประเภทและรอบออกรางวัลตามรายการที่เว็บไซต์กำหนด เช่น หวยรัฐบาล หวยฮานอย หวยลาว หวยหุ้น และหวยยี่กี ซึ่งแต่ละรายการเปิดรับคนละช่วงเวลา ช่วงทดลองคือเวลาที่ควรไล่ดูให้ครบว่าแต่ละงวดปิดรับเมื่อไร ก่อนเลือกเลขควรตรวจชื่อรายการ วันที่ออกรางวัล และเวลาปิดรับให้ถูกต้อง โดยเฉพาะผู้ที่ซื้อหลายประเภทในวันเดียว เพื่อป้องกันการส่งโพยผิดงวด",
  },
  {
    icon: "🔢",
    label: "แยกให้ออกว่าเป็นเลข 2 ตัว 3 ตัว หรือวิ่ง และแทงตรงหรือโต๊ด",
    detail:
      "รูปแบบแทงหวยแต่ละประเภทมีวิธีคิดผลและอัตราจ่ายแตกต่างกัน เลข 2 ตัวแยกตามตำแหน่งที่เลือก เลข 3 ตัวแยกระหว่างแทงตรงกับโต๊ดที่นับผลได้แม้ตำแหน่งสลับกัน ส่วนเลขวิ่งนับจากตัวเลขตัวเดียวที่ปรากฏในผลตามเงื่อนไขของรายการนั้น ควรตรวจว่าต้องการรูปแบบใดก่อนกรอกจำนวนเงิน เพราะเลือกประเภทผิดจะทำให้โพยไม่ตรงกับความตั้งใจแม้จะใช้เลขชุดเดียวกัน",
  },
  {
    icon: "🚦",
    label: "ตรวจสถานะเลขอั้นและราคาที่ระบบแสดงจริงก่อนกดยืนยัน",
    detail:
      "คำว่าไม่อั้นเลขควรพิจารณาตามสถานะล่าสุดของแต่ละงวด เพราะบางเลขอาจถูกจำกัดยอด เปลี่ยนอัตราจ่าย หรือหยุดรับเมื่อถึงวงเงินที่กำหนด ช่วงทดลองจึงเป็นเวลาที่ควรฝึกดูว่าระบบแสดงสถานะเหล่านี้ไว้ตรงไหนของหน้ากรอกโพย แล้วยึดราคาที่ขึ้นกับเลขนั้นจริงในขณะกรอก ไม่ใช่อัตราจ่ายที่จำมาจากงวดก่อนหรือจากรายการอื่น",
  },
  {
    icon: "🧾",
    label: "ไล่ดูโพยทีละรายการแล้วเก็บเลขอ้างอิงไว้ตรวจย้อนหลัง",
    detail:
      "เมื่อซื้อหลายเลขพร้อมกัน ควรไล่ดูเลข ประเภทเดิมพัน จำนวนเงิน และยอดรวมทีละรายการก่อนกดส่ง เพราะยอดรวมโตเร็วกว่าที่คาดไว้เสมอเมื่อวางหลายเลขในรอบเดียว หลังยืนยันแล้วให้เก็บเลขอ้างอิงของโพยไว้ เพื่อใช้ตรวจสอบย้อนหลังเมื่อมีการประกาศผลรางวัลหรือเมื่อพบข้อมูลที่ไม่ตรงกัน",
  },
];

const pageTitle = "ทดลองระบบหวยบน หวยพร้อม และศึกษาวิธีกรอกโพยก่อนซื้อจริง";

// Title and description are the docx SUB-PAGES row "ทดลองเล่น" and ship
// VERBATIM at their own length (116 characters). The brand spec is explicit
// that the docx-supplied rows are not to be padded to the 150-character floor
// tools/verify-build.mjs enforces — it exempts any description that appears
// literally in src/assets/content.txt for exactly this reason. Counted in
// CHARACTERS (Thai is 3 bytes per character, so a byte count reads ~3x too
// long). Do not re-word it: an edit here loses the exemption as well.
const pageDescription = "หวยพร้อม ทดลองระบบเพื่อศึกษาวิธีเลือกเลข 2 ตัว 3 ตัว วิ่ง อัตราจ่าย และขั้นตอนตรวจโพย ช่วยให้เข้าใจก่อนส่งรายการจริง";

const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "ทดลองเล่น", path: "/ทดลองเล่น" },
  ],
});

// h2 inside the card: light gold → prize gold → deep gold, i.e. the brand's gold
// accent read downward, where ContentBox's own h1 gradient opens on soft
// green-white and runs green-white → neon green → gold. The two levels stay
// visually distinct without either repeating the other's opening stop, and the
// green stays on the h1 — a second green-led heading on this near-black green
// card is where the hierarchy would collapse.
const sectionHeadingClass = "bg-gradient-to-r from-[#ffe08a] via-[#f5c451] to-[#a9791a] bg-clip-text text-2xl leading-normal font-bold text-transparent";
---

<MainLayout title="หวยพร้อม | ทดลองระบบหวยและศึกษาวิธีกรอกโพยก่อนซื้อจริง" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={pageTitle} as="h1">
    <div>
      <h2 class={`mb-6 ${sectionHeadingClass}`}>ทดลองระบบบน หวยพร้อม คือการไล่ดูอะไรบ้างก่อนส่งโพยจริง</h2>

      <p class="mb-8 text-left text-base leading-relaxed text-[#d8efdc]">
        การทดลองระบบบน หวยพร้อม คือการเปิดหน้าจอชุดเดียวกับที่จะใช้จริงขึ้นมาไล่ดูให้ครบก่อนส่งโพยด้วยเงินของตัวเอง ตั้งแต่หน้ารวมหวยที่แยกตามประเภทและรอบออกรางวัลตามรายการที่เว็บไซต์กำหนด
        หน้ากรอกโพยที่ต้องระบุว่าเป็นเลข 2 ตัว เลข 3 ตัว หรือเลขวิ่ง และเป็นแทงตรงหรือโต๊ด หน้าที่แสดงอัตราจ่ายกับสถานะของเลขในงวดนั้น ไปจนถึงหน้าสรุปรายการที่รวมยอดของทุกเลขไว้ก่อนกดยืนยัน
        และหน้าประวัติที่เก็บเลขอ้างอิงของโพยไว้ใช้ตรวจผลย้อนหลัง เพราะสิ่งที่ทำให้ผู้เล่นใหม่เสียเงินโดยไม่จำเป็นมักไม่ใช่เลขที่เลือก แต่เป็นการกดยืนยันโดยยังไม่รู้ว่ารายการตรงหน้าคิดผลจากอะไร เช่น
        ส่งโพยผิดงวดเพราะไม่ได้ดูเวลาปิดรับของรายการนั้น เลือกโต๊ดทั้งที่ตั้งใจแทงตรง กรอกเลขไปโดยยังไม่ได้ดูว่าเลขนั้นถูกจำกัดยอดหรือปรับอัตราจ่ายไปแล้ว
        อ่านยอดรวมของโพยผิดช่องจนใช้เงินเกินงบที่ตั้งไว้ หรือกดส่งซ้ำเพราะไม่ได้รอให้ระบบแสดงสถานะของรายการเดิมก่อน
        ความเข้าใจคลาดเคลื่อนเหล่านี้แก้ทีหลังไม่ได้เมื่อโพยเข้าสู่ระบบและงวดปิดรับไปแล้ว แต่ป้องกันได้เกือบทั้งหมดด้วยการเปิดดูหนึ่งรอบก่อน สี่ขั้นด้านล่างคือสิ่งที่ควรไล่ดูให้ครบ
        และเป็นลำดับเดียวกับที่ใช้จริงเมื่อซื้อหวยด้วยเงินของตัวเอง
      </p>

      <div class="mb-8 grid grid-cols-1 gap-5 sm:grid-cols-2" role="list" aria-label="สี่ขั้นตอนที่ควรศึกษาก่อนซื้อหวยด้วยเงินจริงบน หวยพร้อม">
        {
          trySteps.map((step) => (
            <div role="listitem" class="rounded-2xl border border-[#1e7a3a]/35 bg-[#10361c]/70 p-5 transition-colors duration-300 hover:border-[#22c55e]/55">
              <p class="mb-2 flex items-center gap-3 text-base font-bold text-[#6ee7a0]">
                <span aria-hidden="true" class="text-2xl">
                  {step.icon}
                </span>
                {step.label}
              </p>
              <p class="text-left text-base leading-relaxed text-[#d8efdc]">{step.detail}</p>
            </div>
          ))
        }
      </div>

      <h2 class={`mt-8 mb-6 ${sectionHeadingClass}`}>สามชั้นข้อมูลที่ควรอ่านให้จบในช่วงทดลองก่อนกรอกโพยรอบแรก</h2>

      <p class="mb-4 text-left text-base leading-relaxed text-[#d8efdc]">
        หวยแต่ละประเภทออกผลกันคนละแบบและคนละเวลา หวยรัฐบาลออกตามงวดที่ประกาศไว้ล่วงหน้า หวยต่างประเทศอย่างฮานอยและลาวเดินตามรอบของรายการนั้นในแต่ละวัน หวยหุ้นอ้างอิงตัวเลขจากตลาดตามเงื่อนไขที่ระบบระบุ
        ส่วนยี่กีมีรอบถี่กว่ามากภายในวันเดียว เมื่อระบบรวมหลายประเภทไว้ด้วยกัน รายการสองรายการที่อยู่ใกล้กันบนหน้าจอจึงอาจใช้เวลาปิดรับและอัตราจ่ายคนละชุด สิ่งที่ควรได้จากการทดลองจึงเป็นความเข้าใจว่าโพยที่กำลังจะส่งนั้นผูกกับงวดไหน
        ไม่ใช่การจำว่าปุ่มอยู่ตรงไหน เรื่องที่ควรอ่านให้จบมีสามชั้น ชั้นแรกคือรายการและงวด ทั้งชื่อหวย วันที่ออกรางวัล และเวลาปิดรับ ซึ่งเป็นชั้นที่ผิดแล้วเสียทั้งโพยเพราะเลขถูกส่งไปอยู่คนละงวดกับที่ตั้งใจ
        ชั้นที่สองคือรูปแบบเดิมพันกับอัตราจ่ายที่มาคู่กัน เลข 2 ตัวกับเลข 3 ตัวคิดผลคนละแบบ แทงตรงกับโต๊ดนับผลคนละเงื่อนไขและจ่ายคนละอัตรา ส่วนเลขวิ่งใช้ตัวเลขตัวเดียวจึงมีลักษณะความเสี่ยงต่างออกไปอีก
        รูปแบบที่อัตราจ่ายสูงกว่ามักมาพร้อมเงื่อนไขการนับผลที่แคบกว่า สองอย่างนี้ต้องอ่านคู่กันเสมอ และไม่ควรถือว่าอัตราจ่ายสูงหมายถึงมีโอกาสถูกรางวัลมากขึ้น
        ชั้นที่สามคือขอบเขตของเลขและของโพย ทั้งสถานะเลขอั้น วงเงินที่รับต่อเลข ยอดขั้นต่ำต่อรายการ และยอดรวมทั้งโพย ค่าเหล่านี้เป็นค่าเฉพาะของงวดนั้นและเปลี่ยนได้ระหว่างวัน
        จึงต้องอ่านจากหน้าที่ระบบแสดงจริง ไม่ใช่จากที่จำมาจากงวดก่อน เรื่องสุดท้ายในขั้นนี้คือการอ่านยอดให้ถูกช่อง จำนวนเงินต่อหนึ่งเลขกับยอดรวมของทั้งโพยเป็นคนละยอด
        และเมื่อกรอกหลายเลขพร้อมกัน ยอดรวมจะโตเร็วกว่าที่คาดไว้เสมอ การตั้งยอดต่อเลขให้ต่ำไว้ตอนเริ่มจึงช่วยได้จริง
      </p>

      <h2 class={`mt-8 mb-6 ${sectionHeadingClass}`}>สิ่งที่การทดลองระบบบอกได้ และสิ่งที่บอกไม่ได้</h2>

      <p class="mb-4 text-left text-base leading-relaxed text-[#d8efdc]">
        สิ่งที่การทดลองบอกได้คือกลไกและขั้นตอน ได้แก่ วิธีหาชื่อรายการกับเวลาปิดรับของแต่ละงวด ความต่างระหว่างเลข 2 ตัว เลข 3 ตัว และเลขวิ่ง ความต่างระหว่างแทงตรงกับโต๊ด ตำแหน่งที่ระบบแสดงอัตราจ่ายและสถานะเลขอั้น
        ลำดับหน้าจอตั้งแต่เลือกประเภทหวยจนถึงหน้าสรุปโพย และจุดที่เก็บเลขอ้างอิงไว้ตรวจผลย้อนหลัง เมื่อรู้สิ่งเหล่านี้แล้ว การซื้อจริงจะเหลือแค่การตัดสินใจเรื่องเลขและงบ
        ไม่ต้องเสียสมาธิไปกับการหาปุ่มหรือเดาว่ารายการที่ส่งไปนั้นนับผลอย่างไร สิ่งที่การทดลองบอกไม่ได้เลยคือผลของงวดถัดไป เลขที่ออกในงวดหนึ่งไม่ได้ถูกกำหนดจากงวดก่อนหน้า
        และเครดิตที่ใช้ในช่วงทดลองไม่ใช่เงินจริง ถอนไม่ได้ และไม่มีผลต่อยอดในบัญชีจริง ตัวเลขที่เห็นระหว่างทดลองจึงไม่ใช่ตัวแทนของผลจริงหรือของอัตราจ่ายที่จะได้รับ
        ช่วงที่เลขกลุ่มใดออกติดกันหลายงวดก็เป็นเรื่องของความบังเอิญในระยะสั้น ไม่ใช่สัญญาณว่างวดถัดไปจะออกทางใด และการนับสถิติจากงวดที่ผ่านมาก็ไม่ได้ทำให้คาดเดางวดหน้าได้แม่นขึ้น
        คำว่าไม่อั้นเลขและจ่ายเยอะก็เป็นถ้อยคำที่ใช้สื่อถึงรูปแบบการให้บริการและอัตราจ่ายที่เว็บไซต์กำหนดเท่านั้น ไม่ใช่การรับประกันว่าทุกเลขจะรับไม่จำกัด และไม่ใช่การรับประกันผลรางวัลหรือรายได้
        ทุกอย่างจึงควรตรวจจากสถานะและราคาที่ระบบแสดงจริงในขณะนั้น ไม่ใช่จากคำโฆษณา
      </p>

      <p class="mb-2 text-left text-base leading-relaxed text-[#d8efdc]">
        เมื่อพร้อมจะขยับไปซื้อจริง สิ่งที่ควรจัดให้เรียบร้อยก่อนมีสามอย่าง อย่างแรกคือบัญชี ควรใช้ข้อมูลที่ตรงกับตอนสมัคร ตั้งรหัสผ่านที่คาดเดายากและไม่ซ้ำกับบริการอื่น
        และเข้าใช้งานผ่านช่องทางหลักที่เว็บไซต์กำหนดเท่านั้น โดยตรวจชื่อเว็บไซต์และการเชื่อมต่อแบบ HTTPS ทุกครั้งก่อนกรอกข้อมูล อย่างที่สองคืองบประมาณ ควรกำหนดงบต่อวันหรือต่องวดไว้ล่วงหน้า
        ใช้เฉพาะเงินที่ไม่กระทบค่าใช้จ่ายจำเป็น หยุดเมื่อถึงวงเงินที่ตั้งไว้ และไม่เพิ่มยอดในงวดถัดไปเพื่อตามคืนยอดที่เสียไปแล้ว อย่างที่สามคือการติดตามรายการ
        หลังส่งโพยหรือรับสิทธิ์โปรโมชั่นแล้วให้ยึดสถานะและยอดคงเหลือจากหน้าบัญชีเป็นหลัก หลีกเลี่ยงการส่งคำขอซ้ำขณะที่รายการเดิมยังดำเนินการอยู่ และหากพบรายการที่ผิดปกติ ให้เตรียมเวลา จำนวนเงิน
        และเลขอ้างอิงของโพยไว้แจ้งทีมงานตั้งแต่ข้อความแรก โดยไม่เปิดเผยรหัสผ่านหรือรหัสยืนยันแก่ผู้ใด
      </p>
