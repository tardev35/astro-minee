---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/AnnouncementCyber.astro";

import { Picture } from "astro:assets";
import { itemList, pageGraph, schemaCtx } from "../lib/schema";
import image1 from "../assets/gamedemo7.webp";
import image2 from "../assets/gamedemo8.webp";
import image3 from "../assets/gamedemo9.webp";
import image4 from "../assets/gamedemo10.webp";
import image5 from "../assets/gamedemo11.webp";
import image6 from "../assets/gamedemo12.webp";
import image7 from "../assets/gamedemo13.webp";
import image8 from "../assets/gamedemo14.webp";
import image9 from "../assets/gamedemo15.webp";
import image10 from "../assets/gamedemo16.webp";
import image11 from "../assets/gamedemo17.webp";
import image12 from "../assets/gamedemo18.webp";

// One list, two consumers: the gallery below and the ItemList in the JSON-LD.
// They used to be two hand-kept arrays that had to stay in the same order, and
// the name shown to a reader could drift from the name handed to a crawler.
//
// Every alt below was written by opening the file: it describes the artwork on
// the banner (logo + character + setting), not the page it happens to sit on.
// They describe the game PROVIDER's banner, not the brand, so a rebrand leaves
// them alone.
const demoGames = [
  { name: "AskmeSlot", src: image1, alt: "แบนเนอร์ค่ายเกม AskmeSlot โลโก้โพดำสีเหลือง คู่ภาพตัวการ์ตูนเด็กชายสวมหมวกและเสื้อแจ็กเก็ตสีแดงบนถนนเมืองเก่าที่มีกังหันลม" },
  { name: "Popular Game", src: image2, alt: "แบนเนอร์ POPULAR GAME ตัวอักษรทอง มีตัวการ์ตูนกระต่ายและแมวใส่แว่นยืนขนาบหีบสมบัติ พร้อมชิปคาสิโนและกองเหรียญทอง" },
  { name: "SlotXO", src: image3, alt: "แบนเนอร์ค่ายเกม SlotXO โลโก้รูปตู้สล็อต คู่ภาพนักรบโรมันเคราขาวสวมมงกุฎใบลอเรลหน้าโคลอสเซียม" },
  { name: "Skywind Group", src: image4, alt: "แบนเนอร์ค่ายเกม Skywind Group โลโก้วงกลมสี่สี คู่ภาพแมวกวักญี่ปุ่นสีขาวท่ามกลางดอกซากุระและก้อนทอง" },
  { name: "PG Soft", src: image5, alt: "แบนเนอร์ค่ายเกม PG Soft หรือ Pocket Games Soft คู่ภาพนักรบหญิงสวมเครื่องประดับขนนกสไตล์แอซเท็ก" },
  { name: "SBOBET", src: image6, alt: "แบนเนอร์ค่ายเกม SBOBET คู่ภาพตัวการ์ตูนสาวผมบลอนด์ในชุดกิโมโนสีชมพูถืออมยิ้มเกลียวสีรุ้ง" },
  { name: "Sexy Slot", src: image7, alt: "แบนเนอร์ค่ายเกม Sexy Slot ตัวอักษรสีชมพูม่วง คู่ภาพตัวการ์ตูนสาวในชุดรัดรูปสีม่วงพร้อมรูปหัวใจลอยรอบตัว" },
  { name: "JILI", src: image8, alt: "แบนเนอร์ค่ายเกม JILI ตัวอักษรทอง คู่ภาพนางเงือกผมแดงถือหอยสังข์อยู่ใต้ทะเลพร้อมปลาการ์ตูน" },
  { name: "Ask Me Bet", src: image9, alt: "แบนเนอร์ค่ายเกม Ask Me Bet คู่ภาพหัวสิงโตเชิดสีแดงทองท่ามกลางโคมไฟจีนสีแดง" },
  { name: "New Game", src: image10, alt: "แบนเนอร์ New Game ตัวอักษรสีขาวบนฟลอร์เรืองแสง มีตัวการ์ตูนหัวฟักทองและโครงกระดูกยืนขนาบสองข้าง" },
  { name: "JOKER", src: image11, alt: "แบนเนอร์ค่ายเกม JOKER คู่ภาพนักรบโรมันสวมหมวกเหล็กยอดแหลมยืนคู่สิงโตคำรามในสนามประลอง" },
  { name: "AFB Gaming", src: image12, alt: "แบนเนอร์ค่ายเกม AFB Gaming คู่ภาพเทพเจ้ากรีกเคราขาวสวมมงกุฎใบลอเรล ดวงตาเปล่งแสงหน้าวิหารเสาหิน" },
];

const gameList = demoGames.map((game) => ({ name: game.name, imagePath: game.src.src }));

const pageTitle = "ทดลองเล่นสล็อตกับ BMK289 ศึกษาฟีเจอร์ก่อนเริ่มเล่นจริง";

// docx SUB-PAGES Meta ของหน้าทดลองเล่น ยกมาทั้งประโยคโดยไม่แก้ถ้อยคำ (118 ตัวอักษร)
// + วรรคปิดท้ายหนึ่งวรรคให้ผ่านเกท DESC_MIN 150 ของ tools/verify-build.mjs
// ซึ่งยกเว้นให้เฉพาะหน้าแรกเท่านั้น นับเป็น "ตัวอักษร" ไม่ใช่ไบต์ (ไทย 3 ไบต์/ตัว)
// — สตริงนี้วัดได้ 151 ตัวอักษร
const pageDescription =
  "BMK289 ทดลองเล่นสล็อตเพื่อศึกษากติกา ฟีเจอร์ และรูปแบบการจ่าย ช่วยให้เลือกเกมตรงกับความชอบและงบประมาณก่อนเริ่มเล่นจริง เปิดดูเกมได้หลายค่ายจากหน้าเดียว";

const ctx = schemaCtx(Astro);
const graph = pageGraph(Astro, {
  type: "CollectionPage",
  name: pageTitle,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "ทดลองเล่น", path: "/ทดลองเล่น" },
  ],
  extra: [
    itemList(ctx, {
      name: "เกมสล็อตหลายรูปแบบที่เปิดให้ทดลองเล่นบน BMK289",
      alternateName: "BMK289 โหมดทดลองเล่นสล็อตบนมือถือก่อนเริ่มใช้งานบัญชีจริง",
      itemType: "Game",
      items: gameList,
    }),
  ],
});

// h2 inside the card: blue → cyan → gold, the reverse direction of ContentBox's
// own h1 gradient (gold → cyan) so the two heading levels stay visually distinct.
const sectionHeadingClass = "bg-gradient-to-r from-[#2b8cff] via-[#9dcef0] to-[#ffcc33] bg-clip-text text-2xl leading-normal font-bold text-transparent";
---

<MainLayout title="BMK289 | ทดลองเล่นสล็อตและศึกษารูปแบบเกมก่อนเล่นจริง" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={pageTitle} as="h1">
    <div>
      <h2 class={`mb-6 ${sectionHeadingClass}`}>โหมดทดลองของ BMK289 เปิดไว้ให้ดูอะไรก่อนเลือกเกม</h2>

      <p class="mb-8 text-left text-base leading-relaxed text-[#dbe9fb]">
        ภายใน BMK289 มีเกมสล็อตหลายรูปแบบรวมอยู่ในระบบเดียว ทั้งสล็อตคลาสสิก เกมที่เน้นฟีเจอร์โบนัส และเกมธีมสมัยใหม่ จากค่ายอย่าง PG Soft, JOKER, JILI, SlotXO และค่ายอื่นที่เห็นอยู่ในตารางด้านล่างนี้
        หน้านี้มีไว้ให้กดเปิดดูหน้าตาของเกมก่อนว่าวางเมนูไว้ตรงไหน ปรับเดิมพันต่อรอบได้ละเอียดแค่ไหน ฟีเจอร์โบนัสหรือฟรีสปินเข้าเงื่อนไขอย่างไร และหนึ่งรอบใช้เวลาเท่าไร โดยยังไม่ต้องใส่เงินจริงและไม่มีการได้เสียเกิดขึ้น
        สิ่งที่ควรพิจารณาจริง ๆ มีสามอย่าง คือกติกาของเกม รูปแบบการจ่ายพร้อมตารางสัญลักษณ์ และระดับความผันผวน เพราะสามอย่างนี้เป็นตัวกำหนดว่างบประมาณเท่าที่ตั้งไว้จะเล่นเกมนั้นได้กี่รอบ และช่วยให้เลือกเกมที่เหมาะกับสไตล์การเล่นของตนเองมากขึ้น
        ซึ่งมีน้ำหนักกว่าการเลือกจากคำโฆษณาหรือจากอันดับว่าเกมไหนกำลังมีคนเล่นเยอะที่สุด ความนิยมบอกได้แค่ว่าคนอื่นชอบอะไร ไม่ได้บอกว่ารอบถัดไปของเราจะออกแบบไหน การเปิดอ่านข้อมูลก่อนหนึ่งรอบจึงเสียเวลาน้อยกว่าการลองไปแก้ไปมาก
      </p>

      <div class="mb-5 grid grid-cols-2 gap-5 sm:grid-cols-2 md:grid-cols-4">
        {
          demoGames.map((game) => (
            <div class="group/game relative mx-auto w-full max-w-[400px] overflow-hidden rounded-xl">
              <Picture
                src={game.src}
                alt={game.alt}
                loading="lazy"
                fetchpriority="low"
                widths={[160, 320, 480]}
                sizes="(max-width: 767px) 42vw, (max-width: 1520px) 23vw, 320px"
                class="block h-auto w-full object-cover shadow-[0_10px_30px_rgba(43,140,255,0.20)] transition-transform duration-300 group-hover/game:scale-105"
                decoding="async"
                formats={["avif", "webp"]}
                fallbackFormat="webp"
                quality={60}
              />
              <a
                href="/register"
                target="_blank"
                rel="noopener noreferrer"
                aria-label={`สมัครสมาชิกเพื่อเล่น ${game.name} ที่ BMK289`}
                class="absolute inset-0 flex items-center justify-center bg-[#02081c]/80 opacity-0 transition-opacity duration-300 group-hover/game:opacity-100 focus-visible:opacity-100">
                <span class="rounded-full border border-[#ffcc33]/50 bg-gradient-to-r from-[#5eb0ff] via-[#2b8cff] to-[#0d2350] px-6 py-2 font-bold text-[#dbe9fb] shadow-[0_10px_30px_rgba(43,140,255,0.32)] transition-transform hover:scale-110">เล่นเลย</span>
              </a>
            </div>
          ))
        }
      </div>

      <h2 class={`mt-8 mb-6 ${sectionHeadingClass}`}>โหมดทดลองบอกอะไรได้ และบอกอะไรไม่ได้</h2>

      <p class="mb-4 text-left text-base leading-relaxed text-[#dbe9fb]">
        สิ่งที่โหมดทดลองบอกได้คือกลไกของเกม เมนูอยู่ตรงไหน ปรับเดิมพันต่อรอบได้ละเอียดแค่ไหน ซื้อฟีเจอร์ได้หรือไม่ และหนึ่งรอบกินเวลาเท่าไร ส่วนเครดิตในโหมดนี้เป็นยอดสมมติ ถอนไม่ได้ และผลที่ออกมาก็ไม่ได้เป็นตัวแทนของการเล่นจริง
        คำว่าแตกหนักวันนี้ที่เห็นตามหน้าเกมก็ควรอ่านควบคู่กับข้อมูลของเกมเสมอ เกมที่ถูกนำเสนอแบบนั้นอาจมีฟีเจอร์หรือจังหวะลุ้นรางวัลที่น่าสนใจจริง แต่ไม่ได้แปลว่าจะได้ผลลัพธ์ตามคาดทุกครั้ง จึงควรดูอัตราจ่าย ความผันผวน และเงื่อนไขโบนัสประกอบ พร้อมกำหนดวงเงินและระยะเวลาในการเล่นให้ชัดเจนก่อนเริ่ม
        ประวัติการหมุนที่ขึ้นบนหน้าจอเป็นบันทึกของรอบที่จบไปแล้ว ไม่ใช่คำใบ้ของรอบถัดไป เกมความผันผวนสูงมักเงียบยาวแล้วจ่ายเป็นก้อน ส่วนเกมผันผวนต่ำจ่ายย่อยถี่กว่า ทั้งสองแบบไม่มีแบบไหนดีกว่ากัน แค่เหมาะกับงบคนละขนาด
      </p>

      <p class="mb-4 text-left text-base leading-relaxed text-[#dbe9fb]">
        อีกเรื่องที่ควรเผื่อใจคือโหมดทดลองไม่ได้เปิดครบทุกเกม บางค่ายเปิดเฉพาะบางชุด และเกมที่เพิ่งปล่อยใหม่มักยังไม่เปิดโหมดนี้ จึงควรกดเข้าไปดูหน้ารายละเอียดของเกมก่อนเลือก
        ยอดที่หมุนในโหมดทดลองไม่ถูกนับเป็นยอดของบัญชีหรือของโปรโมชั่นใดทั้งสิ้น จึงใช้ปลดเงื่อนไขโบนัสไม่ได้ และถ้าเกมที่อยากลองไม่มีปุ่มทดลอง ก็เป็นเพียงเรื่องที่ค่ายนั้นยังไม่เปิดให้ ไม่ใช่สัญญาณอะไรเป็นพิเศษ
        การรวมทุกค่ายไว้ในระบบเดียวช่วยให้กรองเกมตามค่าย ธีม หรือรูปแบบการจ่ายที่ชอบได้จากหน้าเดียว และเว็บไซต์ BMK289 รองรับทั้งมือถือ แท็บเล็ต และคอมพิวเตอร์ จึงเปิดผ่านเบราว์เซอร์ได้เลยโดยไม่ต้องติดตั้งโปรแกรมเพิ่ม
        ควรใช้อินเทอร์เน็ตที่สัญญาณนิ่งและอัปเดตเบราว์เซอร์ให้เป็นรุ่นล่าสุด เพราะเกมที่โหลดไม่ครบมักทำให้ภาพค้างจนดูจังหวะของฟีเจอร์ไม่ออก
      </p>

      <h2 class={`mt-8 mb-6 ${sectionHeadingClass}`}>ขยับจากโหมดทดลองไปเล่นจริงบน BMK289 ควรเช็กอะไรก่อน</h2>

      <p class="mb-2 text-left text-base leading-relaxed text-[#dbe9fb]">
        ถ้าจะขยับจากโหมดทดลองไปเล่นด้วยเงินจริง เรื่องที่ควรจัดให้เรียบร้อยก่อนมีสี่อย่าง คือบัญชี งบต่อรอบ โปรโมชั่น และช่องทางเข้า ด้านบัญชี ควรใช้ข้อมูลที่ตรงกับตอนสมัคร ทั้งเบอร์โทรที่รับข้อความได้จริงและข้อมูลบัญชีฝากถอนที่เป็นของผู้สมัครเอง
        พร้อมตั้งรหัสผ่านที่คาดเดายาก ไม่ซ้ำกับบริการอื่น และไม่ใช่เลขวันเกิด เลขเรียง หรือเลขซ้ำทั้งชุด เพราะการสมัครใช้เวลาไม่กี่นาที แต่การตามแก้ข้อมูลที่กรอกผิดกินเวลามากกว่านั้นหลายเท่า
        ด้านงบ ควรกำหนดวงเงินต่อรอบและวงเงินรวมของวันไว้ล่วงหน้า แล้วเทียบกับเดิมพันขั้นต่ำของเกมที่เลือก เพื่อให้รู้ตั้งแต่ต้นว่างบที่ตั้งไว้เล่นได้กี่รอบ และไม่ต้องเพิ่มทุนระหว่างทางเพราะอยากไล่ตามผลที่เสียไป
        และตัวเลขเดิมพันขั้นต่ำต่อรอบของเกมเป็นคนละเรื่องกับยอดขั้นต่ำของโปรโมชั่น จึงต้องคำนวณแยกกัน ส่วนโปรโมชั่นที่ให้สิทธิ์เพิ่มตามเงื่อนไขหรือกิจกรรม ควรอ่านจำนวน ระยะเวลา และข้อกำหนดการนำไปใช้ให้จบก่อนกดรับ เพราะเงื่อนไขเหล่านี้ผูกกับยอดในบัญชีทันทีที่รับสิทธิ์
        ด้านการทำรายการ ระบบออโต้ของ BMK289 ช่วยลดขั้นตอนการส่งข้อมูลซ้ำ แต่ก่อนกดยืนยันยังควรตรวจชื่อบัญชี จำนวนเงิน และช่องทางที่ใช้ให้ตรงกันทุกครั้ง แล้วรอให้ระบบแสดงสถานะสำเร็จก่อนส่งรายการใหม่ เพื่อลดความคลาดเคลื่อนและทำให้ตรวจสอบย้อนหลังได้ง่าย
        สุดท้ายควรเข้าใช้งานผ่านช่องทางหลักของ BMK289 ที่ตรวจชื่อเว็บไซต์แล้วและเชื่อมต่อแบบ HTTPS เท่านั้น เลี่ยงเครือข่ายสาธารณะเมื่อต้องจัดการข้อมูลบัญชี และหากติดปัญหาระหว่างใช้งาน ให้เตรียมชื่อผู้ใช้ เวลา และรายละเอียดรายการไว้แจ้งทีมงาน BMK289 โดยไม่เปิดเผยรหัสผ่านหรือรหัสยืนยันแก่ผู้ใด
      </p>
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
