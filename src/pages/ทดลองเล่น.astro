---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement5.astro";
import { pageGraph } from "../lib/schema";

// An earlier brand rendered a grid of twelve gamedemo*.webp provider covers here
// with a "เล่นเลย" overlay per tile. Those tiles claimed twelve specific playable
// demos by name, which is a claim this page cannot back — the demo opens inside
// the provider's own client, and the cover art is a stale off-brand set. The
// tiles stay gone and their imports with them, so nothing is emitted into
// dist/_astro that no page renders. The gamedemo*.webp files stay in src/assets
// as inventory. This page imports no image of any kind, which is also why the
// stale-asset sweep has nothing to check here.
//
// What replaces them is the four-step walkthrough below — no images, plain
// markup, and each step's label is a <p>/<span> with an aria-label on the
// region, because only the article body may produce a heading.
//
// <Announcement /> is bare: Announcement5's default message is this brand's
// copy, so the ticker matches index.astro without a second string here. The
// variant rotated off AnnouncementPremium, the outgoing brand's pick, per the
// brand spec.
//
// FINN20 is a BACCARAT / live-casino brand. The body below was slot copy under
// the outgoing brand and is rewritten end to end — โต๊ะ / Banker, Player, Tie /
// อัตราจ่าย / ค่าคอมมิชชัน / ความเร็วของรอบ, never a reel, never a slot paytable.
const trySteps = [
  {
    icon: "🃏",
    label: "เลือกโต๊ะบาคาร่าให้ตรงกับวงเงินและจังหวะที่ต้องการ",
    detail:
      "หน้ารวมเกมจัดโต๊ะไว้หลายผู้ให้บริการและหลายระดับวงเงิน ทั้งโต๊ะที่เดินรอบเร็วและโต๊ะที่ให้เวลาตัดสินใจนานกว่า ควรดูเดิมพันขั้นต่ำต่อรอบ เดิมพันสูงสุด และเดิมพันเสริมที่โต๊ะนั้นเปิดให้ก่อนเข้าเล่น เพราะโต๊ะที่หน้าตาคล้ายกันอาจกำหนดเงื่อนไขคนละชุด",
  },
  {
    icon: "📊",
    label: "อ่านอัตราจ่ายของ Banker Player และ Tie พร้อมค่าคอมมิชชัน",
    detail:
      "ผู้ให้บริการระบุอัตราจ่ายของแต่ละฝั่ง ค่าคอมมิชชันที่หักเมื่อชนะฝั่ง Banker และเงื่อนไขของเดิมพันเสริมไว้ในหน้าข้อมูลของโต๊ะ ควรอ่านให้จบก่อนลงรอบแรก เพราะตัวเลขเหล่านี้เป็นค่าเฉพาะของโต๊ะนั้น ไม่ใช่ค่ากลางที่ทุกโต๊ะใช้ร่วมกัน",
  },
  {
    icon: "💳",
    label: "ไล่ขั้นตอนฝากถอนออโต้ให้ครบก่อนกดยืนยันจริง",
    detail:
      "ลองเดินตั้งแต่เลือกช่องทาง กรอกจำนวนเงิน จนถึงหน้าสรุปรายการ เพื่อให้รู้ว่าต้องตรวจอะไรบ้างก่อนกดยืนยัน และควรรอให้ระบบแสดงสถานะของรายการเดิมก่อนส่งรายการใหม่ทุกครั้ง",
  },
  {
    icon: "⚖️",
    label: "กำหนดวงเงินต่อรอบให้พอดีกับงบ",
    detail:
      "บาคาร่าจบผลในรอบสั้นและเปิดรอบใหม่ได้ทันที โต๊ะที่เดินเร็วจึงใช้เงินต่อชั่วโมงมากกว่าที่หลายคนคาดไว้ ลองนั่งดูสักช่วงหนึ่งจะพอเห็นจังหวะของโต๊ะนั้น แล้วค่อยตั้งวงเงินต่อรอบให้พอดีกับงบและจำนวนรอบที่ตั้งใจเล่น",
  },
];

const pageTitle = "ทดลองบาคาร่าบน FINN20 เพื่อศึกษากติกาก่อนเริ่มเล่นจริง";

// Title + description come from the brand spec / the docx SUB-PAGES row for
// ทดลองเล่น. The title ships verbatim. The docx description is 121 characters,
// under the DESC_MIN=150 floor tools/verify-build.mjs enforces on every
// INDEXABLE page (only the home page is exempt), so the docx sentence opens it
// verbatim and one clause closes it at 153. Counted in CHARACTERS (Thai is 3
// bytes per character, so a byte count reads ~3x too long). Do not re-word it.
const pageDescription =
  "FINN20 ทดลองบาคาร่าเพื่อศึกษากติกา Banker Player Tie อัตราจ่าย และวงเงินโต๊ะ ช่วยให้เข้าใจเกมก่อนเริ่มเดิมพันด้วยเงินจริง พร้อมตั้งงบต่อรอบไว้ล่วงหน้าได้";

const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "ทดลองเล่น", path: "/ทดลองเล่น" },
  ],
});

// h2 inside the card: gold → bright gold → silver, the reverse direction of
// ContentBox's own h1 gradient (silver → bright gold → gold) so the two heading
// levels stay visually distinct. Gold carries the type on this brand; the deep
// gold stays on the surfaces, because a #e39d02 heading on a dark #14110a card
// is where the contrast goes. There is no scarlet or molten orange in FINN20 —
// that was the brand before it, and every red stop on this page became gold,
// bright gold or silver.
const sectionHeadingClass = "bg-gradient-to-r from-[#fdd323] via-[#ffe98a] to-[#d7dbe1] bg-clip-text text-2xl leading-normal font-bold text-transparent";
---

<MainLayout title="FINN20 | ทดลองบาคาร่าและศึกษากติกาก่อนเล่นจริง" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={pageTitle} as="h1">
    <div>
      <h2 class={`mb-6 ${sectionHeadingClass}`}>ทดลองบาคาร่าบน FINN20 หมายถึงอะไร และควรดูอะไรก่อนลงเงินจริง</h2>

      <p class="mb-8 text-left text-base leading-relaxed text-[#f3e7c8]">
        การทดลองบาคาร่าบน FINN20 คือการเปิดหน้าจอชุดเดียวกับที่จะใช้จริงขึ้นมาไล่ดูให้ครบก่อนใส่เงินลงไป ตั้งแต่หน้ารวมโต๊ะ หน้าข้อมูลของโต๊ะที่ระบุอัตราจ่ายของ Banker, Player และ Tie ค่าคอมมิชชัน และวงเงินต่อรอบ
        ไปจนถึงหน้าฝากถอนออโต้และหน้าสรุปก่อนยืนยัน เพราะสิ่งที่ทำให้ผู้เล่นใหม่เสียเงินโดยไม่จำเป็นมักไม่ใช่ดวง แต่เป็นการกดยืนยันโดยยังไม่รู้ว่ารายการตรงหน้าคิดผลจากอะไร เช่น
        เข้าใจว่าฝั่ง Banker จ่ายเต็มจำนวนทั้งที่โต๊ะนั้นหักค่าคอมมิชชันเมื่อชนะ ลงเดิมพัน Tie โดยยังไม่ได้อ่านอัตราจ่ายและโอกาสของมัน เข้าใจเงื่อนไขโปรโมชั่นผิดจนรับสิทธิ์ไม่ครบ
        หรือกดยืนยันรายการฝากถอนซ้ำเพราะไม่ได้รอให้ระบบแสดงสถานะของรายการเดิมก่อน ความเข้าใจคลาดเคลื่อนเหล่านี้แก้ทีหลังไม่ได้เมื่อรายการเข้าสู่ระบบแล้ว
        แต่ป้องกันได้เกือบทั้งหมดด้วยการเปิดดูหนึ่งรอบก่อน สี่ขั้นด้านล่างคือสิ่งที่ควรไล่ดูให้ครบ และเป็นลำดับเดียวกับที่ใช้จริงเมื่อลงเดิมพันด้วยเงินของตัวเอง
      </p>

      <div class="mb-8 grid grid-cols-1 gap-5 sm:grid-cols-2" role="list" aria-label="สี่ขั้นตอนที่ควรศึกษาก่อนลงเดิมพันบาคาร่าด้วยเงินจริงบน FINN20">
        {
          trySteps.map((step) => (
            <div role="listitem" class="rounded-2xl border border-[#fdd323]/35 bg-[#1f1a10]/60 p-5 transition-colors duration-300 hover:border-[#ffe98a]/55">
              <p class="mb-2 flex items-center gap-3 text-base font-bold text-[#fdd323]">
                <span aria-hidden="true" class="text-2xl">
                  {step.icon}
                </span>
                {step.label}
              </p>
              <p class="text-left text-base leading-relaxed text-[#f3e7c8]">{step.detail}</p>
            </div>
          ))
        }
      </div>

      <h2 class={`mt-8 mb-6 ${sectionHeadingClass}`}>อัตราจ่าย ค่าคอมมิชชัน และวงเงินโต๊ะที่ควรอ่านให้จบก่อนลงรอบแรก</h2>

      <p class="mb-4 text-left text-base leading-relaxed text-[#f3e7c8]">
        บาคาร่าเป็นเกมที่กติกาหลักไม่ซับซ้อน แต่ละรอบเจ้ามือแจกไพ่ให้สองฝั่งคือ Banker กับ Player แล้ววัดผลจากแต้มรวมที่นับเฉพาะหลักหน่วย ฝั่งที่ใกล้เก้ากว่าเป็นฝ่ายชนะ และถ้าแต้มเท่ากันคือ Tie
        ข้อดีคือเรียนรู้ได้เร็ว ข้อควรระวังคือความเรียบง่ายนั้นทำให้หลายคนข้ามการอ่านรายละเอียดที่ต่างกันจริงในแต่ละโต๊ะ สิ่งที่ควรได้จากการทดลองจึงเป็นความเข้าใจว่ารอบที่กำลังจะลงนั้นคิดผลจากอะไร
        ไม่ใช่การจำว่าปุ่มวางเดิมพันอยู่ตรงไหน เรื่องที่ควรอ่านให้จบมีสามชั้น ชั้นแรกคือกติกาการนับแต้มและเงื่อนไขการจั่วไพ่ใบที่สามของโต๊ะนั้น ซึ่งระบบตัดสินให้เองตามกติกาที่ประกาศไว้ ไม่ใช่การเลือกของผู้เล่น
        ชั้นที่สองคืออัตราจ่ายของทั้งสามตัวเลือกและค่าคอมมิชชันที่หักเมื่อชนะฝั่ง Banker ซึ่งทำให้เงินที่ได้รับจริงต่างจากตัวเลขที่เห็นบนโต๊ะ รวมถึงเดิมพันเสริมที่โต๊ะนั้นเปิดให้และเงื่อนไขเฉพาะของมัน
        ชั้นที่สามคือขอบเขตของรายการ ทั้งเดิมพันต่ำสุดต่อรอบ สูงสุดต่อรอบ และเวลาที่โต๊ะเปิดให้วางเดิมพันในแต่ละรอบ สามชั้นนี้เป็นค่าเฉพาะของโต๊ะนั้น จึงต้องอ่านจากหน้าข้อมูลที่ระบบแสดงจริง ไม่ใช่จากที่จำมาจากโต๊ะอื่น
        เรื่องสุดท้ายในขั้นนี้คือการอ่านยอดให้ถูกช่อง เดิมพันหลักกับเดิมพันเสริมเป็นคนละยอด และเมื่อวางไว้หลายช่องพร้อมกัน ยอดรวมต่อหนึ่งรอบจะโตเร็วกว่าที่คาดไว้เสมอ การตั้งค่าให้ต่ำไว้ตอนเริ่มจึงช่วยได้จริง
        ฝั่งการเงินใช้หลักเดียวกันแต่คนละหน่วยวัด คือช่องทางที่เลือก จำนวนเงิน ข้อมูลบัญชีรับเงิน และเงื่อนไขโปรโมชั่นที่ผูกกับรายการนั้น ต้องตรงกันครบทั้งสี่อย่างก่อนกดยืนยัน
      </p>

      <h2 class={`mt-8 mb-6 ${sectionHeadingClass}`}>สิ่งที่การทดลองบอกได้ และสิ่งที่บอกไม่ได้</h2>

      <p class="mb-4 text-left text-base leading-relaxed text-[#f3e7c8]">
        สิ่งที่การทดลองบอกได้คือกลไกและขั้นตอน ได้แก่ วิธีนับแต้มและเงื่อนไขการจั่วไพ่ใบที่สาม ความต่างระหว่างเดิมพันหลักกับเดิมพันเสริม ลำดับหน้าจอตั้งแต่เลือกโต๊ะจนถึงหน้าสรุป ตำแหน่งที่ระบบแสดงอัตราจ่ายกับค่าคอมมิชชัน
        และความรู้สึกตอนใช้งานว่าความเร็วของรอบบนโต๊ะนั้นเข้ากับสไตล์ของเราหรือไม่ เมื่อรู้สิ่งเหล่านี้แล้ว การเล่นจริงจะเหลือแค่การตัดสินใจเรื่องวงเงินและงบ
        ไม่ต้องเสียสมาธิไปกับการหาปุ่มหรือเดาว่ารอบที่ผ่านไปนั้นตัดสินจากอะไร สิ่งที่การทดลองบอกไม่ได้เลยคือผลของรอบถัดไปเมื่อลงด้วยเงินจริง ผลของแต่ละรอบไม่ได้ถูกกำหนดโดยรอบก่อนหน้า
        และเครดิตในโหมดทดลองไม่ใช่เงินจริง ถอนไม่ได้ และไม่มีผลต่อยอดเงินในบัญชีจริง ตัวเลขที่เห็นในโหมดทดลองจึงไม่ใช่ตัวแทนของผลจริงหรือของอัตราการจ่ายที่จะได้รับ
        ช่วงที่ฝั่งใดฝั่งหนึ่งออกติดกันยาวผิดปกติในโหมดทดลองก็เป็นเรื่องของความผันผวนระยะสั้น ไม่ใช่สัญญาณว่ารอบถัดไปจะออกทางใด และการนับสถิติจากกระดานผลย้อนหลังก็ไม่ได้ทำให้คาดเดารอบหน้าได้แม่นขึ้น
        คำว่าไม่ล็อคผลหรือจ่ายไวก็ควรอ่านคู่กับเงื่อนไขที่ระบบแสดงจริงและประวัติรายการที่ตรวจสอบได้ เพราะเป็นถ้อยคำทางการตลาด ไม่ใช่การรับประกันผลของเกมหรือกำไรของใคร
      </p>

      <p class="mb-2 text-left text-base leading-relaxed text-[#f3e7c8]">
        เมื่อพร้อมจะขยับไปเล่นจริง สิ่งที่ควรจัดให้เรียบร้อยก่อนมีสามอย่าง อย่างแรกคือบัญชี ควรใช้ข้อมูลที่ตรงกับตอนสมัคร ตั้งรหัสผ่านที่คาดเดายากและไม่ซ้ำกับบริการอื่น
        และเข้าใช้งานผ่านช่องทางหลักที่เว็บไซต์กำหนดเท่านั้น โดยตรวจชื่อเว็บไซต์และการเชื่อมต่อแบบ HTTPS ทุกครั้งก่อนกรอกข้อมูล อย่างที่สองคืองบประมาณ ควรกำหนดวงเงินและระยะเวลาไว้ล่วงหน้า
        ใช้เฉพาะเงินที่ไม่กระทบค่าใช้จ่ายจำเป็น และไม่เพิ่มเดิมพันต่อรอบเพื่อหวังตามคืนยอดที่เสียไปแล้ว อย่างที่สามคือการติดตามรายการ หลังฝาก ถอน หรือรับสิทธิ์โปรโมชั่นแล้วให้ยึดสถานะจากหน้าบัญชีของตนเองเป็นหลัก
        หลีกเลี่ยงการส่งคำขอซ้ำขณะที่รายการเดิมยังดำเนินการอยู่ และหากพบรายการที่ผิดปกติ ให้เตรียมเวลา จำนวนเงิน และเลขอ้างอิงไว้แจ้งทีมงานตั้งแต่ข้อความแรก โดยไม่เปิดเผยรหัสผ่านหรือรหัสยืนยันแก่ผู้ใด
      </p>
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
