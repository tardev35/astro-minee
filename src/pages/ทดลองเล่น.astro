---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement3.astro";
import { pageGraph } from "../lib/schema";

// The previous brand rendered a grid of twelve gamedemo*.webp slot-provider
// banners here (PG Soft, JOKER, SlotXO, …) with a "เล่นเลย" overlay per tile.
// LOTTO77 is a lottery brand: it opens no slot game, so a page claiming twelve
// playable slot demos is a claim the site cannot back, and the artwork is the
// same off-brand slot cover set the brand spec dropped GameRankingBoard for.
// The tiles are gone; the imports went with them, so nothing is emitted into
// dist/_astro that no page renders. The gamedemo*.webp files stay in
// src/assets as inventory for the next slot brand.
//
// What replaces them is the four-step walkthrough below — no images, plain
// markup, and each step's label is a <p>/<span> with an aria-label on the
// region, because only the article body may produce a heading.
const trySteps = [
  {
    icon: "🎯",
    label: "เลือกประเภทหวยและงวดที่เปิดรับ",
    detail: "ดูว่าตลาดใดเปิดอยู่ ทั้งหวยรัฐบาล หวยลาว หวยฮานอย และหวยยี่กี แต่ละตลาดมีวันออกรางวัลและเวลาปิดรับคนละรอบ จึงควรยืนยันงวดที่กำลังซื้อก่อนกรอกเลข",
  },
  {
    icon: "🔢",
    label: "ลองกรอกเลขตามรูปแบบการเดิมพัน",
    detail: "สองตัวบน สองตัวล่าง สามตัวบน สามตัวโต๊ด และเลขวิ่ง ใช้จำนวนหลักไม่เท่ากัน การลองกรอกดูก่อนช่วยให้เห็นว่าแต่ละช่องรับค่าแบบใด",
  },
  {
    icon: "📋",
    label: "อ่านอัตราจ่ายและสถานะของเลข",
    detail: "ราคาที่ระบบแสดงผูกกับประเภทหวย งวด และเลขที่เลือก บางชุดอาจถูกจำกัดวงเงิน ปรับราคา หรือหยุดรับ จึงต้องอ่านจากหน้าจอในขณะนั้น ไม่ใช่จากที่จำไว้",
  },
  {
    icon: "🧾",
    label: "ตรวจโพยและขั้นตอนบันทึกรายการ",
    detail: "ก่อนยืนยันควรไล่ดูตัวเลข ประเภทเดิมพัน จำนวนเงินต่อรายการ และยอดรวมของโพยอีกครั้ง แล้วเก็บเลขอ้างอิงไว้จนกว่าจะประกาศผลรางวัล",
  },
];

const pageTitle = "ทดลองใช้งานระบบหวยของ LOTTO77 ก่อนเริ่มซื้อจริง";

// docx SUB-PAGES Meta ของหน้าทดลองเล่น ต่อท้ายหนึ่งวรรคให้ผ่านเกท DESC_MIN 150
// ของ tools/verify-build.mjs ซึ่งยกเว้นให้เฉพาะหน้าแรก นับเป็น "ตัวอักษร" ไม่ใช่
// ไบต์ (ไทย 3 ไบต์/ตัว) — สตริงนี้วัดได้ 154 ตัวอักษร
const pageDescription =
  "LOTTO77 ทดลองใช้งานเพื่อศึกษาวิธีเลือกเลข รูปแบบการเดิมพัน อัตราจ่าย และขั้นตอนบันทึกโพย ช่วยให้เข้าใจระบบก่อนเริ่มซื้อจริงโดยไม่ต้องใช้เงินจริงในการทดลอง";

const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "ทดลองเล่น", path: "/ทดลองเล่น" },
  ],
});

// h2 inside the card: red → gold, the reverse direction of ContentBox's own h1
// gradient (gold → red) so the two heading levels stay visually distinct.
const sectionHeadingClass = "bg-gradient-to-r from-[#ff3d3d] via-[#f5c451] to-[#ffe08a] bg-clip-text text-2xl leading-normal font-bold text-transparent";
---

<MainLayout title="LOTTO77 | ทดลองใช้งานระบบหวยก่อนซื้อจริง" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={pageTitle} as="h1">
    <div>
      <h2 class={`mb-6 ${sectionHeadingClass}`}>ทดลองใช้งานบน LOTTO77 หมายถึงอะไร และควรศึกษาอะไรก่อนซื้อจริง</h2>

      <p class="mb-8 text-left text-base leading-relaxed">
        คำว่าทดลองใช้งานบน LOTTO77 ไม่ได้หมายถึงการเล่นเกมสาธิต แต่หมายถึงการเดินดูระบบซื้อหวยให้ครบทุกขั้นก่อนที่จะใส่เงินจริงลงไป ตั้งแต่หน้าเลือกประเภทหวย ช่องกรอกเลข ตารางอัตราจ่าย ไปจนถึงหน้าสรุปโพยก่อนกดยืนยัน
        เพราะสิ่งที่ทำให้ผู้ใช้งานใหม่เสียเงินโดยไม่จำเป็นมักไม่ใช่การเลือกเลขผิด แต่เป็นการกดยืนยันโดยยังไม่เข้าใจว่าหน้าจอตรงหน้ากำลังบันทึกอะไรไว้ เช่น กรอกเลขของงวดที่ปิดรับไปแล้ว เลือกประเภทเดิมพันคนละแบบกับที่ตั้งใจ
        หรือใส่จำนวนเงินต่อรายการแล้วเข้าใจว่าเป็นยอดรวมทั้งโพย ความผิดพลาดเหล่านี้แก้ไม่ได้หลังรายการถูกบันทึก แต่ป้องกันได้เกือบทั้งหมดด้วยการเปิดดูหนึ่งรอบก่อน
        สี่ขั้นด้านล่างคือสิ่งที่ควรไล่ดูให้ครบ และเป็นลำดับเดียวกับที่ระบบใช้จริงเมื่อซื้อ
      </p>

      <div class="mb-8 grid grid-cols-1 gap-5 sm:grid-cols-2" role="list" aria-label="สี่ขั้นตอนที่ควรศึกษาก่อนซื้อหวยจริงบน LOTTO77">
        {
          trySteps.map((step) => (
            <div role="listitem" class="rounded-2xl border border-[#d81220]/35 bg-[#3f070a]/60 p-5 transition-colors duration-300 hover:border-[#f5c451]/55">
              <p class="mb-2 flex items-center gap-3 text-base font-bold text-[#f5c451]">
                <span aria-hidden="true" class="text-2xl">
                  {step.icon}
                </span>
                {step.label}
              </p>
              <p class="text-left text-base leading-relaxed">{step.detail}</p>
            </div>
          ))
        }
      </div>

      <h2 class={`mt-8 mb-6 ${sectionHeadingClass}`}>รูปแบบการเดิมพันและอัตราจ่ายที่ควรอ่านให้เข้าใจก่อนบันทึกโพย</h2>

      <p class="mb-4 text-left text-base leading-relaxed">
        รูปแบบการเดิมพันของหวยแต่ละแบบไม่ได้ต่างกันแค่จำนวนหลักที่กรอก แต่ต่างกันที่โอกาสและอัตราจ่ายซึ่งผูกกันอยู่ เลขสองตัวใช้ตัวเลขน้อยกว่าและมีอัตราจ่ายต่ำกว่าเลขสามตัว ส่วนเลขวิ่งนับจากการปรากฏของตัวเลขหลักเดียวในผลที่ออก
        จึงมีเงื่อนไขการนับที่ต่างออกไปอีกชุดหนึ่ง การเข้าใจว่าแต่ละแบบนับผลอย่างไรคือสิ่งที่ควรได้จากการทดลองใช้งาน มากกว่าการจำว่าปุ่มไหนอยู่ตรงไหน
        อัตราจ่ายที่แสดงในระบบเป็นค่าของงวดนั้นและของเลขนั้น ไม่ใช่ค่าคงที่ของทั้งเว็บไซต์ ประเภทหวยคนละตลาดอาจให้ราคาไม่เท่ากัน และเลขบางชุดในงวดเดียวกันอาจถูกปรับราคาหรือจำกัดวงเงินรับเมื่อยอดถึงระดับที่กำหนด
        นี่คือเหตุผลที่การตรวจราคาที่แสดงอยู่ก่อนกดยืนยันทุกครั้งมีน้ำหนักกว่าการอ้างอิงตัวเลขที่เคยเห็นในงวดก่อน และเป็นสิ่งที่ควรฝึกให้เป็นนิสัยตั้งแต่ตอนที่ยังไม่ได้ใส่เงินจริง
        เรื่องสุดท้ายในขั้นนี้คือการอ่านยอดให้ถูกช่อง จำนวนเงินต่อรายการกับยอดรวมของโพยเป็นคนละตัวเลข และเมื่อซื้อหลายเลขพร้อมกัน ยอดรวมจะโตเร็วกว่าที่คาดไว้เสมอ การแบ่งโพยเป็นชุดย่อยแล้วตรวจทีละชุดจึงช่วยได้จริง
      </p>

      <h2 class={`mt-8 mb-6 ${sectionHeadingClass}`}>สิ่งที่การทดลองใช้งานบอกได้ และสิ่งที่บอกไม่ได้</h2>

      <p class="mb-4 text-left text-base leading-relaxed">
        สิ่งที่การทดลองใช้งานบอกได้คือกลไกของระบบ ได้แก่ ลำดับของขั้นตอน ตำแหน่งของข้อมูลที่ต้องอ่าน วิธีที่ระบบรวมรายการเป็นโพย และสิ่งที่หน้าจอจะแสดงหลังกดยืนยัน เมื่อรู้สิ่งเหล่านี้แล้ว การซื้อจริงจะเหลือแค่การตัดสินใจเรื่องเลขและงบ
        ไม่ต้องเสียสมาธิไปกับการหาปุ่ม สิ่งที่การทดลองใช้งานบอกไม่ได้เลยคือผลของงวดถัดไป ระบบไม่ได้จำลองการออกรางวัล ไม่มีเครดิตสมมติที่ถอนได้ และไม่มีตัวเลขใดในหน้าทดลองที่เป็นตัวแทนของผลจริง
        ผลการออกรางวัลของทุกตลาดคาดเดาไม่ได้และไม่มีใครรับประกันได้ ไม่ว่าจะซื้อผ่านช่องทางใด
        ข้อมูลประกอบอย่างสถิติย้อนหลังหรือแนวทางที่รวบรวมไว้ก็อยู่ในกรอบเดียวกัน คือใช้เป็นข้อมูลอ้างอิงได้ แต่ไม่ได้ทำให้โอกาสของงวดถัดไปเปลี่ยนไป เลขที่เคยออกบ่อยไม่ได้มีสิทธิ์มากกว่าเลขอื่นในงวดใหม่
        และคำโฆษณาทั่วไปอย่างเลขอั้นน้อยก็ควรอ่านคู่กับสถานะเลขที่ระบบแสดงจริงในงวดนั้น เพราะเป็นคนละเรื่องกับการไม่มีข้อจำกัดใดเลย
      </p>

      <p class="mb-2 text-left text-base leading-relaxed">
        เมื่อพร้อมจะขยับไปซื้อจริง สิ่งที่ควรจัดให้เรียบร้อยก่อนมีสามอย่าง อย่างแรกคือบัญชี ควรใช้ข้อมูลที่ตรงกับตอนสมัคร ตั้งรหัสผ่านที่คาดเดายากและไม่ซ้ำกับบริการอื่น และเข้าใช้งานผ่านช่องทางหลักที่เว็บไซต์กำหนดเท่านั้น
        โดยตรวจชื่อเว็บไซต์และการเชื่อมต่อแบบ HTTPS ทุกครั้งก่อนกรอกข้อมูล อย่างที่สองคืองบประมาณ ควรกำหนดวงเงินต่อหนึ่งงวดไว้ล่วงหน้า ใช้เฉพาะเงินที่ไม่กระทบค่าใช้จ่ายจำเป็น และไม่เพิ่มยอดเพื่อชดเชยการเสียจากงวดก่อน
        อย่างที่สามคือการติดตามรายการ หลังส่งโพยแล้วให้ยึดสถานะจากหน้าบัญชีของตนเองเป็นหลัก เก็บเลขอ้างอิงของโพยไว้จนกว่าจะประกาศผลและรายการปิดรอบ และหากพบรายการที่ผิดปกติ ให้เตรียมเวลา จำนวนเงิน และเลขอ้างอิงไว้แจ้งทีมงานตั้งแต่ข้อความแรก
        โดยไม่เปิดเผยรหัสผ่านหรือรหัสยืนยันแก่ผู้ใด
      </p>
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
