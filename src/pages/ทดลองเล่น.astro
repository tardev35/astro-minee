---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/AnnouncementPremium.astro";
import { pageGraph } from "../lib/schema";

// An earlier brand rendered a grid of twelve gamedemo*.webp provider covers here
// with a "เล่นเลย" overlay per tile. Those tiles claimed twelve specific playable
// demos by name, which is a claim this page cannot back — the demo opens inside
// the provider's own client, and the cover art is a stale off-brand set. The
// tiles stay gone and their imports with them, so nothing is emitted into
// dist/_astro that no page renders. The gamedemo*.webp files stay in src/assets
// as inventory.
//
// What replaces them is the four-step walkthrough below — no images, plain
// markup, and each step's label is a <p>/<span> with an aria-label on the
// region, because only the article body may produce a heading.
const trySteps = [
  {
    icon: "🎰",
    label: "เลือกหมวดเกมและรูปแบบเดิมพันให้ตรงที่ต้องการ",
    detail: "ระบบจัดหมวดไว้ทั้งสล็อต บาคาร่า และเกมรูปแบบอื่นที่ระบบรองรับ ควรดูชื่อเกม ช่วงเดิมพันขั้นต่ำถึงสูงสุด และรายละเอียดที่แสดงก่อนเข้า เพราะเกมที่หน้าตาคล้ายกันอาจกำหนดเงื่อนไขคนละชุด",
  },
  {
    icon: "📊",
    label: "อ่านอัตราจ่ายและวิธีตัดสินผลของเกมนั้น",
    detail: "แต่ละหมวดคิดผลคนละแบบ สล็อตตัดสินจากรูปแบบที่ระบบกำหนด ส่วนบาคาร่าตัดสินจากแต้มรวมของฝั่งที่เลือก ควรอ่านวิธีตัดสินผลและอัตราจ่ายของเกมให้จบก่อนลงรอบแรก",
  },
  {
    icon: "💳",
    label: "ไล่ขั้นตอนฝากถอนผ่าน True Wallet ให้ครบก่อนยืนยัน",
    detail: "ลองเดินตั้งแต่เลือกช่องทาง กรอกจำนวนเงิน จนถึงหน้าสรุปรายการ เพื่อให้รู้ว่าต้องตรวจอะไรบ้างก่อนกดยืนยันจริง และควรรอให้ระบบแสดงสถานะสำเร็จก่อนทำรายการใหม่ทุกครั้ง",
  },
  {
    icon: "⚖️",
    label: "กำหนดวงเงินต่อรอบให้พอดีกับงบ",
    detail: "ตัวเลือกที่อัตราจ่ายสูงมักมีโอกาสออกต่ำกว่า ส่วนตัวเลือกที่จ่ายน้อยกว่าก็แลกมาด้วยความถี่ที่มากกว่า ลองเดินระบบต่อเนื่องสักช่วงหนึ่งจะพอเห็นจังหวะ แล้วค่อยตั้งวงเงินต่อรอบให้พอดีกับงบ",
  },
];

const pageTitle = "ทดลองระบบเดิมพันบน VEGUS1 เพื่อศึกษาวิธีใช้งานก่อนเล่นจริง";

// Title + description come verbatim from the brand spec §6 and are already
// length-checked against tools/verify-build.mjs (DESC_MIN 150 / DESC_MAX 160,
// counted in CHARACTERS — Thai is 3 bytes per character, so a byte count reads
// ~3x too long). This one measures 156 characters. Do not re-word it.
const pageDescription =
  "VEGUS1 ทดลองระบบเดิมพันเพื่อศึกษากติกา รูปแบบเดิมพัน และขั้นตอนใช้งาน ช่วยให้เลือกเกมและกำหนดงบได้เหมาะสมก่อนเริ่มรายการจริง โดยไม่มีผลต่อยอดเงินในบัญชีจริง";

const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "ทดลองเล่น", path: "/ทดลองเล่น" },
  ],
});

// h2 inside the card: gold deep → gold light, the reverse direction of
// ContentBox's own h1 gradient (light → deep) so the two heading levels stay
// visually distinct. Gold carries the type on this brand; crimson stays on the
// surfaces, because red text on a dark red card is where the contrast goes.
const sectionHeadingClass = "bg-gradient-to-r from-[#c9931a] via-[#f5c451] to-[#ffe08a] bg-clip-text text-2xl leading-normal font-bold text-transparent";
---

<MainLayout title="VEGUS1 | ทดลองระบบเดิมพันและศึกษาวิธีใช้งานก่อนเล่นจริง" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={pageTitle} as="h1">
    <div>
      <h2 class={`mb-6 ${sectionHeadingClass}`}>ทดลองระบบบน VEGUS1 หมายถึงอะไร และควรศึกษาอะไรก่อนเดิมพันจริง</h2>

      <p class="mb-8 text-left text-base leading-relaxed text-[#f7e3c8]">
        การทดลองระบบบน VEGUS1 คือการเปิดหน้าจอที่จะใช้จริงขึ้นมาไล่ดูให้ครบทุกส่วนก่อนที่จะใส่เงินลงไป ตั้งแต่หน้ารวมหมวดเกม รูปแบบเดิมพันและอัตราจ่ายของแต่ละตัวเลือก ไปจนถึงหน้าฝากถอนผ่าน True Wallet และหน้าสรุปก่อนยืนยัน
        เพราะสิ่งที่ทำให้ผู้ใช้งานใหม่เสียเงินโดยไม่จำเป็นมักไม่ใช่ดวง แต่เป็นการกดยืนยันโดยยังไม่รู้ว่ารายการตรงหน้าคิดผลจากอะไร เช่น เข้าใจว่าตัวเลือกที่จ่ายสูงน่าลงทุกรอบทั้งที่โอกาสออกต่ำกว่ามาก
        เข้าใจเงื่อนไขโปรโมชั่นคลาดเคลื่อนจนรับสิทธิ์ไม่ครบ หรือกดยืนยันรายการฝากถอนซ้ำเพราะไม่ได้รอให้ระบบแสดงสถานะของรายการเดิมก่อน
        ความเข้าใจคลาดเคลื่อนเหล่านี้แก้ทีหลังไม่ได้เมื่อรายการเข้าสู่ระบบแล้ว แต่ป้องกันได้เกือบทั้งหมดด้วยการเปิดดูหนึ่งรอบก่อน สี่ขั้นด้านล่างคือสิ่งที่ควรไล่ดูให้ครบ และเป็นลำดับเดียวกับที่ใช้จริงเมื่อเดิมพันด้วยเงินของตัวเอง
      </p>

      <div class="mb-8 grid grid-cols-1 gap-5 sm:grid-cols-2" role="list" aria-label="สี่ขั้นตอนที่ควรศึกษาก่อนเดิมพันด้วยเงินจริงบน VEGUS1">
        {
          trySteps.map((step) => (
            <div role="listitem" class="rounded-2xl border border-[#d81f26]/35 bg-[#2a0606]/60 p-5 transition-colors duration-300 hover:border-[#ff3a33]/55">
              <p class="mb-2 flex items-center gap-3 text-base font-bold text-[#f5c451]">
                <span aria-hidden="true" class="text-2xl">
                  {step.icon}
                </span>
                {step.label}
              </p>
              <p class="text-left text-base leading-relaxed text-[#f7e3c8]">{step.detail}</p>
            </div>
          ))
        }
      </div>

      <h2 class={`mt-8 mb-6 ${sectionHeadingClass}`}>รูปแบบเดิมพันและอัตราจ่ายที่ควรเข้าใจก่อนลงเงินบน VEGUS1</h2>

      <p class="mb-4 text-left text-base leading-relaxed text-[#f7e3c8]">
        VEGUS1 รวมเกมเดิมพันหลายประเภทไว้ในบัญชีเดียว ตั้งแต่สล็อต บาคาร่า ไปจนถึงเกมรูปแบบอื่นที่ระบบรองรับ ข้อดีของการอยู่ในระบบเดียวคือไม่ต้องสลับหลายบัญชี แต่ข้อควรระวังคือกติกา อัตราจ่าย และระดับความเสี่ยงของแต่ละหมวดไม่ได้เท่ากัน
        สิ่งที่ควรได้จากการทดลองระบบจึงเป็นความเข้าใจว่ารายการที่เรากำลังจะกดนั้นคิดผลจากอะไร ไม่ใช่การจำว่าปุ่มยืนยันอยู่ตรงไหน
        เรื่องที่ควรอ่านให้จบมีสามชั้น ชั้นแรกคือวิธีตัดสินผลของเกมนั้น สล็อตตัดสินจากรูปแบบที่ระบบกำหนดในแต่ละรอบ ส่วนบาคาร่าตัดสินจากแต้มรวมของฝั่งที่เลือกตามกติกาของโต๊ะ ชั้นที่สองคืออัตราจ่ายของแต่ละตัวเลือกและเงื่อนไขปลีกย่อยที่เกมนั้นกำหนดไว้
        ชั้นที่สามคือขอบเขตของรายการ ทั้งเดิมพันขั้นต่ำ ขั้นสูงสุด และช่วงเวลาที่เปิดให้ลงในแต่ละรอบ สามชั้นนี้เป็นค่าเฉพาะของเกมนั้นในขณะนั้น จึงต้องอ่านจากที่ระบบแสดงจริง ไม่ใช่จากที่จำมาจากเกมอื่น
        เรื่องสุดท้ายในขั้นนี้คือการอ่านยอดให้ถูกช่อง เดิมพันต่อตัวเลือกกับยอดรวมต่อหนึ่งรอบเป็นคนละตัวเลข และเมื่อลงหลายตัวเลือกพร้อมกัน ยอดรวมต่อรอบจะโตเร็วกว่าที่คาดไว้เสมอ การตั้งค่าให้ต่ำไว้ตอนเริ่มจึงช่วยได้จริง
        ฝั่งการเงินใช้หลักเดียวกันแต่คนละหน่วยวัด คือช่องทางที่เลือก จำนวนเงิน ข้อมูลบัญชีรับเงิน และเงื่อนไขโปรโมชั่นที่ผูกกับรายการนั้น ต้องตรงกันครบทั้งสี่อย่างก่อนกดยืนยัน
      </p>

      <h2 class={`mt-8 mb-6 ${sectionHeadingClass}`}>สิ่งที่การทดลองระบบบอกได้ และสิ่งที่บอกไม่ได้</h2>

      <p class="mb-4 text-left text-base leading-relaxed text-[#f7e3c8]">
        สิ่งที่การทดลองระบบบอกได้คือกลไกและขั้นตอน ได้แก่ วิธีตัดสินผลของเกมแต่ละหมวด หน้าที่ของตัวเลือกเดิมพันแต่ละแบบ ลำดับหน้าจอตั้งแต่เลือกรายการจนถึงหน้าสรุป ตำแหน่งที่ระบบแสดงอัตราจ่ายและเงื่อนไข และความรู้สึกตอนใช้งานว่าเข้ากับสไตล์ของเราหรือไม่
        เมื่อรู้สิ่งเหล่านี้แล้ว การเดิมพันจริงจะเหลือแค่การตัดสินใจเรื่องรายการและงบ ไม่ต้องเสียสมาธิไปกับการหาปุ่มหรือเดาว่ารอบที่ผ่านไปนั้นตัดสินจากอะไร
        สิ่งที่การทดลองระบบบอกไม่ได้เลยคือผลของรอบถัดไปเมื่อเดิมพันด้วยเงินจริง ผลของแต่ละรอบไม่ได้ถูกกำหนดโดยรอบก่อนหน้า และเครดิตในโหมดทดลองไม่ใช่เงินจริง ถอนไม่ได้ และไม่มีผลต่อยอดเงินในบัญชีจริง
        ตัวเลขที่เห็นในโหมดทดลองจึงไม่ใช่ตัวแทนของผลจริงหรือของอัตราการจ่ายที่จะได้รับ ช่วงที่ผลออกฝั่งเดียวติดกันยาวผิดปกติในโหมดทดลองก็เป็นเรื่องของความผันผวนระยะสั้น ไม่ใช่สัญญาณว่ารอบถัดไปจะออกทางใด
        คำว่ามั่นคงก็ควรอ่านคู่กับเงื่อนไขที่ระบบแสดงจริงและประวัติรายการที่ตรวจสอบได้ เพราะไม่ใช่การรับประกันความปลอดภัยทุกกรณี และไม่มีใครรับประกันผลของการเดิมพันหรือกำไรได้
      </p>

      <p class="mb-2 text-left text-base leading-relaxed text-[#f7e3c8]">
        เมื่อพร้อมจะขยับไปเดิมพันจริง สิ่งที่ควรจัดให้เรียบร้อยก่อนมีสามอย่าง อย่างแรกคือบัญชี ควรใช้ข้อมูลที่ตรงกับตอนสมัคร ตั้งรหัสผ่านที่คาดเดายากและไม่ซ้ำกับบริการอื่น และเข้าใช้งานผ่านช่องทางหลักที่เว็บไซต์กำหนดเท่านั้น
        โดยตรวจชื่อเว็บไซต์และการเชื่อมต่อแบบ HTTPS ทุกครั้งก่อนกรอกข้อมูล อย่างที่สองคืองบประมาณ ควรกำหนดวงเงินและระยะเวลาไว้ล่วงหน้า ใช้เฉพาะเงินที่ไม่กระทบค่าใช้จ่ายจำเป็น และไม่เพิ่มเดิมพันเพื่อหวังตามคืนยอดที่เสียไปแล้ว
        อย่างที่สามคือการติดตามรายการ หลังฝาก ถอน หรือยืนยันเดิมพันแล้วให้ยึดสถานะจากหน้าบัญชีของตนเองเป็นหลัก หลีกเลี่ยงการส่งคำขอซ้ำขณะที่รายการเดิมยังดำเนินการอยู่ และหากพบรายการที่ผิดปกติ ให้เตรียมเวลา จำนวนเงิน และเลขอ้างอิงไว้แจ้งทีมงานตั้งแต่ข้อความแรก
        โดยไม่เปิดเผยรหัสผ่านหรือรหัสยืนยันแก่ผู้ใด
      </p>
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
