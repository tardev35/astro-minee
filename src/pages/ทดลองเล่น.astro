---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement6.astro";
import { pageGraph } from "../lib/schema";

// An earlier brand rendered a grid of twelve gamedemo*.webp provider covers here
// with a "เล่นเลย" overlay per tile. Those tiles claimed twelve specific playable
// demos by name, which is a claim this page cannot back — the demo opens inside
// the provider's own client, and the cover art is a stale off-brand set. The
// tiles stay gone and their imports with them, so nothing is emitted into
// dist/_astro that no page renders. The gamedemo*.webp files stay in src/assets
// as inventory.
//
// What replaces them is the four-step walkthrough below — no images, plain
// markup, and each step's label is a <p>/<span> with an aria-label on the
// region, because only the article body may produce a heading.
//
// <Announcement /> is bare: Announcement6's default message is this brand's
// copy, so the ticker matches index.astro without a second string here.
const trySteps = [
  {
    icon: "🃏",
    label: "เลือกโต๊ะบาคาร่าให้ตรงกับวงเงินและจังหวะที่ต้องการ",
    detail: "ระบบจัดโต๊ะไว้หลายระดับวงเงินและหลายความเร็วของเกม ควรดูขั้นต่ำของโต๊ะ ขั้นสูงสุด และตัวเลือกเดิมพันที่เปิดให้ลงก่อนเข้า เพราะโต๊ะที่หน้าตาคล้ายกันอาจกำหนดเงื่อนไขคนละชุด",
  },
  {
    icon: "📊",
    label: "อ่านอัตราจ่ายของ Banker Player และ Tie ให้ครบ",
    detail: "สามตัวเลือกหลักของบาคาร่ามีอัตราจ่ายและความน่าจะเป็นไม่เท่ากัน และฝั่ง Banker มักมีค่าคอมมิชชันเข้ามาเกี่ยวข้อง ควรอ่านวิธีคิดผลและอัตราจ่ายที่โต๊ะนั้นแสดงจริงให้จบก่อนลงรอบแรก",
  },
  {
    icon: "💳",
    label: "ไล่ขั้นตอนฝากถอนออโต้ให้ครบก่อนกดยืนยันจริง",
    detail: "ลองเดินตั้งแต่เลือกช่องทาง กรอกจำนวนเงิน จนถึงหน้าสรุปรายการ เพื่อให้รู้ว่าต้องตรวจอะไรบ้างก่อนกดยืนยัน และควรรอให้ระบบแสดงสถานะของรายการเดิมก่อนส่งรายการใหม่ทุกครั้ง",
  },
  {
    icon: "⚖️",
    label: "กำหนดวงเงินต่อรอบให้พอดีกับงบ",
    detail: "ตัวเลือกที่อัตราจ่ายสูงมักมีโอกาสออกต่ำกว่า ส่วนตัวเลือกที่จ่ายน้อยกว่าก็แลกมาด้วยความถี่ที่มากกว่า ลองเดินระบบต่อเนื่องสักช่วงหนึ่งจะพอเห็นจังหวะ แล้วค่อยตั้งวงเงินต่อรอบให้พอดีกับงบ",
  },
];

const pageTitle = "ทดลองบาคาร่าบน HOT189 เพื่อศึกษากติกาก่อนเล่นจริง";

// Title + description come from the brand spec §6. The docx sentence is 124
// characters, under the DESC_MIN=150 floor tools/verify-build.mjs enforces on
// every indexable page, so it opens the description and one clause closes it.
// Counted in CHARACTERS (Thai is 3 bytes per character, so a byte count reads
// ~3x too long). This one measures 155 characters. Do not re-word it.
const pageDescription = "HOT189 ทดลองบาคาร่าเพื่อศึกษากติกา ตัวเลือกเดิมพัน และอัตราจ่าย ช่วยให้เข้าใจรูปแบบเกมและกำหนดงบได้เหมาะสมก่อนเริ่มเล่นจริง โดยไม่มีผลต่อยอดเงินในบัญชีจริง";

const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "ทดลองเล่น", path: "/ทดลองเล่น" },
  ],
});

// h2 inside the card: gold deep → gold light, the reverse direction of
// ContentBox's own h1 gradient (light → deep) so the two heading levels stay
// visually distinct. Gold carries the type on this brand; flame red stays on the
// surfaces, because red text on a dark ember card is where the contrast goes.
const sectionHeadingClass = "bg-gradient-to-r from-[#c99400] via-[#fcd304] to-[#ffe86b] bg-clip-text text-2xl leading-normal font-bold text-transparent";
---

<MainLayout title="HOT189 | ทดลองบาคาร่าและศึกษากติกาก่อนเล่นจริง" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={pageTitle} as="h1">
    <div>
      <h2 class={`mb-6 ${sectionHeadingClass}`}>ทดลองบาคาร่าบน HOT189 หมายถึงอะไร และควรดูอะไรก่อนลงเงินจริง</h2>

      <p class="mb-8 text-left text-base leading-relaxed text-[#ffe9cf]">
        การทดลองบาคาร่าบน HOT189 คือการเปิดหน้าจอชุดเดียวกับที่จะใช้จริงขึ้นมาไล่ดูให้ครบก่อนใส่เงินลงไป ตั้งแต่หน้ารวมโต๊ะ ตัวเลือกเดิมพันและอัตราจ่ายของแต่ละฝั่ง
        ไปจนถึงหน้าฝากถอนออโต้และหน้าสรุปก่อนยืนยัน เพราะสิ่งที่ทำให้ผู้เล่นใหม่เสียเงินโดยไม่จำเป็นมักไม่ใช่ดวง แต่เป็นการกดยืนยันโดยยังไม่รู้ว่ารายการตรงหน้าคิดผลจากอะไร เช่น
        เข้าใจว่าฝั่งที่จ่ายสูงน่าลงทุกรอบทั้งที่โอกาสออกต่ำกว่ามาก อ่านค่าคอมมิชชันของฝั่ง Banker ไม่ครบจนคำนวณยอดที่ได้รับคลาดเคลื่อน เข้าใจเงื่อนไขโปรโมชั่นผิดจนรับสิทธิ์ไม่ครบ
        หรือกดยืนยันรายการฝากถอนซ้ำเพราะไม่ได้รอให้ระบบแสดงสถานะของรายการเดิมก่อน ความเข้าใจคลาดเคลื่อนเหล่านี้แก้ทีหลังไม่ได้เมื่อรายการเข้าสู่ระบบแล้ว
        แต่ป้องกันได้เกือบทั้งหมดด้วยการเปิดดูหนึ่งรอบก่อน สี่ขั้นด้านล่างคือสิ่งที่ควรไล่ดูให้ครบ และเป็นลำดับเดียวกับที่ใช้จริงเมื่อเดิมพันด้วยเงินของตัวเอง
      </p>

      <div class="mb-8 grid grid-cols-1 gap-5 sm:grid-cols-2" role="list" aria-label="สี่ขั้นตอนที่ควรศึกษาก่อนเดิมพันบาคาร่าด้วยเงินจริงบน HOT189">
        {
          trySteps.map((step) => (
            <div role="listitem" class="rounded-2xl border border-[#ef2b09]/35 bg-[#2e100a]/60 p-5 transition-colors duration-300 hover:border-[#ff7a18]/55">
              <p class="mb-2 flex items-center gap-3 text-base font-bold text-[#fcd304]">
                <span aria-hidden="true" class="text-2xl">
                  {step.icon}
                </span>
                {step.label}
              </p>
              <p class="text-left text-base leading-relaxed text-[#ffe9cf]">{step.detail}</p>
            </div>
          ))
        }
      </div>

      <h2 class={`mt-8 mb-6 ${sectionHeadingClass}`}>ตัวเลือกเดิมพัน อัตราจ่าย และค่าคอมมิชชันที่ควรอ่านให้จบก่อนลงรอบแรก</h2>

      <p class="mb-4 text-left text-base leading-relaxed text-[#ffe9cf]">
        บาคาร่าเป็นเกมที่กติกาหลักไม่ซับซ้อน แต่ละรอบวัดกันที่แต้มรวมของฝั่ง Banker กับฝั่ง Player และผู้เล่นเลือกได้ว่าจะลงฝั่งใดหรือจะลง Tie ข้อดีคือเรียนรู้ได้เร็ว
        ข้อควรระวังคือความเรียบง่ายนั้นทำให้หลายคนข้ามการอ่านรายละเอียดที่ต่างกันจริงในแต่ละโต๊ะ สิ่งที่ควรได้จากการทดลองจึงเป็นความเข้าใจว่ารายการที่กำลังจะกดนั้นคิดผลจากอะไร
        ไม่ใช่การจำว่าปุ่มยืนยันอยู่ตรงไหน เรื่องที่ควรอ่านให้จบมีสามชั้น ชั้นแรกคือวิธีตัดสินผลของโต๊ะนั้น ทั้งการนับแต้ม เงื่อนไขการเปิดไพ่ใบที่สาม และกรณีที่นับเป็นเสมอ
        ชั้นที่สองคืออัตราจ่ายของแต่ละตัวเลือกและค่าคอมมิชชันที่อาจหักจากฝั่ง Banker ซึ่งทำให้ยอดที่ได้รับจริงไม่เท่ากับอัตราจ่ายที่เห็นบนหน้าจอเสมอไป ชั้นที่สามคือขอบเขตของรายการ ทั้งเดิมพันขั้นต่ำ
        ขั้นสูงสุด และช่วงเวลาที่เปิดให้ลงในแต่ละรอบ สามชั้นนี้เป็นค่าเฉพาะของโต๊ะนั้นในขณะนั้น จึงต้องอ่านจากที่ระบบแสดงจริง ไม่ใช่จากที่จำมาจากโต๊ะอื่น เรื่องสุดท้ายในขั้นนี้คือการอ่านยอดให้ถูกช่อง
        เดิมพันต่อตัวเลือกกับยอดรวมต่อหนึ่งรอบเป็นคนละตัวเลข และเมื่อลงหลายตัวเลือกพร้อมกัน ยอดรวมต่อรอบจะโตเร็วกว่าที่คาดไว้เสมอ การตั้งค่าให้ต่ำไว้ตอนเริ่มจึงช่วยได้จริง
        ฝั่งการเงินใช้หลักเดียวกันแต่คนละหน่วยวัด คือช่องทางที่เลือก จำนวนเงิน ข้อมูลบัญชีรับเงิน และเงื่อนไขโปรโมชั่นที่ผูกกับรายการนั้น ต้องตรงกันครบทั้งสี่อย่างก่อนกดยืนยัน
      </p>

      <h2 class={`mt-8 mb-6 ${sectionHeadingClass}`}>สิ่งที่การทดลองบอกได้ และสิ่งที่บอกไม่ได้</h2>

      <p class="mb-4 text-left text-base leading-relaxed text-[#ffe9cf]">
        สิ่งที่การทดลองบอกได้คือกลไกและขั้นตอน ได้แก่ วิธีตัดสินผลของโต๊ะแต่ละแบบ หน้าที่ของตัวเลือกเดิมพันแต่ละฝั่ง ลำดับหน้าจอตั้งแต่เลือกโต๊ะจนถึงหน้าสรุป ตำแหน่งที่ระบบแสดงอัตราจ่ายกับเงื่อนไข
        และความรู้สึกตอนใช้งานว่าจังหวะของโต๊ะนั้นเข้ากับสไตล์ของเราหรือไม่ เมื่อรู้สิ่งเหล่านี้แล้ว การเล่นจริงจะเหลือแค่การตัดสินใจเรื่องรายการและงบ
        ไม่ต้องเสียสมาธิไปกับการหาปุ่มหรือเดาว่ารอบที่ผ่านไปนั้นตัดสินจากอะไร สิ่งที่การทดลองบอกไม่ได้เลยคือผลของรอบถัดไปเมื่อเดิมพันด้วยเงินจริง ผลของแต่ละรอบไม่ได้ถูกกำหนดโดยรอบก่อนหน้า
        และเครดิตในโหมดทดลองไม่ใช่เงินจริง ถอนไม่ได้ และไม่มีผลต่อยอดเงินในบัญชีจริง ตัวเลขที่เห็นในโหมดทดลองจึงไม่ใช่ตัวแทนของผลจริงหรือของอัตราการจ่ายที่จะได้รับ
        ช่วงที่ผลออกฝั่งเดียวติดกันยาวผิดปกติในโหมดทดลองก็เป็นเรื่องของความผันผวนระยะสั้น ไม่ใช่สัญญาณว่ารอบถัดไปจะออกทางใด และการอ่านสถิติผลย้อนหลังบนกระดานก็ไม่ได้ทำให้คาดเดารอบหน้าได้แม่นขึ้น
        คำว่าแตกง่ายหรือมั่นคงก็ควรอ่านคู่กับเงื่อนไขที่ระบบแสดงจริงและประวัติรายการที่ตรวจสอบได้ เพราะเป็นถ้อยคำทางการตลาด ไม่ใช่การรับประกันผลของบาคาร่าหรือกำไรของใคร
      </p>

      <p class="mb-2 text-left text-base leading-relaxed text-[#ffe9cf]">
        เมื่อพร้อมจะขยับไปเล่นจริง สิ่งที่ควรจัดให้เรียบร้อยก่อนมีสามอย่าง อย่างแรกคือบัญชี ควรใช้ข้อมูลที่ตรงกับตอนสมัคร ตั้งรหัสผ่านที่คาดเดายากและไม่ซ้ำกับบริการอื่น
        และเข้าใช้งานผ่านช่องทางหลักที่เว็บไซต์กำหนดเท่านั้น โดยตรวจชื่อเว็บไซต์และการเชื่อมต่อแบบ HTTPS ทุกครั้งก่อนกรอกข้อมูล อย่างที่สองคืองบประมาณ ควรกำหนดวงเงินและระยะเวลาไว้ล่วงหน้า
        ใช้เฉพาะเงินที่ไม่กระทบค่าใช้จ่ายจำเป็น และไม่เพิ่มเดิมพันเพื่อหวังตามคืนยอดที่เสียไปแล้ว อย่างที่สามคือการติดตามรายการ หลังฝาก ถอน หรือยืนยันเดิมพันแล้วให้ยึดสถานะจากหน้าบัญชีของตนเองเป็นหลัก
        หลีกเลี่ยงการส่งคำขอซ้ำขณะที่รายการเดิมยังดำเนินการอยู่ และหากพบรายการที่ผิดปกติ ให้เตรียมเวลา จำนวนเงิน และเลขอ้างอิงไว้แจ้งทีมงานตั้งแต่ข้อความแรก โดยไม่เปิดเผยรหัสผ่านหรือรหัสยืนยันแก่ผู้ใด
      </p>
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
