---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/AnnouncementCyber.astro";
import { pageGraph } from "../lib/schema";

// This page imports NO image, and that is a decision rather than an omission.
// The only "demo" art in the repo is src/assets/gamedemo7-18.webp — twelve game
// covers left behind by an earlier brand, carrying that brand's artwork rather
// than RUAYRUAY888's. Publishing another brand's covers here buys a tile row and
// costs the same thing every stale asset costs. The files stay in src/assets as
// inventory. DO NOT import them: an imported image is an emitted image, and
// verify-build.mjs fails the build on an image that ships unrendered. Because
// nothing is imported, the stale-asset sweep has nothing to check here either.
//
// What carries the page instead is the four-step walkthrough below — no images,
// plain markup, and each step's label is a <p>/<span> with an aria-label on the
// region, because only the article body may produce a heading. It is NOT an
// h3-bearing icon-card block: the sanctioned source of an h3 is
// FeatureHighlights.astro, and that file still carries a previous brand's
// palette, so wiring it in here would ship off-brand colour.
//
// <Announcement /> is bare: AnnouncementCyber's default message is this brand's
// copy, so the ticker matches index.astro without a second string here. The
// variant rotated off AnnouncementHuay, the outgoing brand's pick, per the
// brand spec.
//
// RUAYRUAY888's brief frames the site as a platform that gathers เกมจากหลายค่าย,
// โปรโมชั่นหลายรูปแบบ and ช่องทาง Wallet into one system. Its standing advice:
// compare กติกา / ฟีเจอร์ / อัตราจ่าย / วงเงิน before picking a provider; read a
// promotion's ยอดขั้นต่ำ, เกมที่ร่วมรายการ, ระยะเวลา and เงื่อนไขการถอน rather
// than its headline credit; check ข้อมูลกระเป๋าเงิน, จำนวนเงิน and บัญชีสมาชิก
// before confirming a Wallet transaction and wait for the previous one to update;
// and keep เวลา, จำนวนเงิน and เลขอ้างอิง of a slow item for checking back. Its
// standing caveat is that จ่ายดี and โปรแรง are wording, not a guarantee, and
// that เกมพนันมีความไม่แน่นอนและไม่สามารถรับประกันกำไรได้. The brief names Wallet
// as a channel but no bank and no payment brand, so neither does this page — and
// it promises no payout, no win rate, and never that a trial run predicts a real
// round.
const trySteps = [
  {
    icon: "🗂️",
    label: "เลือกประเภทเกมแล้วตรวจกติกากับฟีเจอร์ของค่ายนั้นให้ตรงกัน",
    detail:
      "ระบบจัดหมวดเกมตามประเภทและผู้ให้บริการตามรายการที่เว็บไซต์กำหนด ทั้งสล็อต บาคาร่า คาสิโนสด และเกมรูปแบบอื่นจากหลายค่าย ซึ่งแต่ละค่ายวางกติกาและฟีเจอร์ไว้คนละแบบ ช่วงทดลองคือเวลาที่ควรไล่ดูให้ครบว่าเกมที่สนใจเดิมพันอย่างไร นับผลจากอะไร และมีฟีเจอร์พิเศษเงื่อนไขใดบ้าง เพราะค่ายที่ได้รับความนิยมไม่จำเป็นต้องเหมาะกับรูปแบบการเล่นของทุกคน",
  },
  {
    icon: "🔢",
    label: "อ่านอัตราจ่ายกับความผันผวนคู่กันก่อนตั้งยอดต่อรอบ",
    detail:
      "เกมแต่ละประเภทมีอัตราจ่าย ความผันผวน และวงเงินขั้นต่ำต่อรอบแตกต่างกัน สล็อตกับเกมโต๊ะคิดผลคนละแบบและใช้จังหวะเดิมพันคนละจังหวะ ควรดูตารางจ่ายและกติกาจากผู้ให้บริการก่อนเริ่ม แล้วตั้งยอดต่อรอบจากงบที่วางไว้ ไม่ใช่จากตัวเลขรางวัลสูงสุดที่เห็นบนหน้าเกม และไม่ควรถือว่าอัตราจ่ายสูงหมายถึงมีโอกาสชนะมากขึ้น",
  },
  {
    icon: "🚦",
    label: "ตรวจเงื่อนไขโปรโมชั่นและเกมที่ร่วมรายการก่อนกดรับสิทธิ์",
    detail:
      "โปรโมชั่นที่ดูแรงอาจมีทั้งโบนัสสมาชิกใหม่ สิทธิ์ตามยอดฝาก หรือกิจกรรมเฉพาะช่วงเวลา ช่วงทดลองจึงเป็นเวลาที่ควรฝึกดูว่าระบบแสดงยอดขั้นต่ำ เกมที่ร่วมรายการ ระยะเวลา และเงื่อนไขการถอนไว้ตรงไหนของหน้าโปรโมชั่น แล้วยึดเงื่อนไขที่ขึ้นกับรายการนั้นจริงในขณะกดรับ ไม่ใช่เงื่อนไขที่จำมาจากรอบก่อนหรือจากรายการอื่น",
  },
  {
    icon: "🧾",
    label: "ไล่ดูยอดคงเหลือกับประวัติธุรกรรมแล้วเก็บเลขอ้างอิงไว้ตรวจย้อนหลัง",
    detail:
      "ก่อนฝากหรือถอนควรตรวจโปรโมชั่นที่เปิดใช้งาน ยอดคงเหลือ และประวัติธุรกรรมให้ตรงกันก่อน พร้อมตรวจข้อมูลกระเป๋าเงิน จำนวนเงิน และบัญชีสมาชิกให้ตรงกันก่อนกดยืนยัน หากพบรายการล่าช้าควรเก็บเวลา จำนวนเงิน และเลขอ้างอิงไว้จนกว่าระบบจะอัปเดตผล แล้วรอการอัปเดตนั้นก่อนทำธุรกรรมใหม่ เพราะการกดส่งซ้ำระหว่างนั้นไม่ได้ทำให้เร็วขึ้น",
  },
];

const pageTitle = "ทดลองระบบเกมบน RUAYRUAY888 และศึกษากติกากับอัตราจ่ายก่อนเล่นจริง";

// Title and description are the docx SUB-PAGES row "ทดลองเล่น" and ship
// VERBATIM at their own length (117 characters). The brand spec is explicit
// that the docx-supplied rows are not to be padded to the 150-character floor
// tools/verify-build.mjs enforces — it exempts any description that appears
// literally in src/assets/content.txt for exactly this reason. Counted in
// CHARACTERS (Thai is 3 bytes per character, so a byte count reads ~3x too
// long). Do not re-word it: an edit here loses the exemption as well.
const pageDescription = "RUAYRUAY888 ทดลองระบบเกมเพื่อศึกษากติกา อัตราจ่าย ฟีเจอร์ และรูปแบบการเดิมพัน ช่วยให้เลือกเกมได้เหมาะกับงบและความชอบ";

const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "ทดลองเล่น", path: "/ทดลองเล่น" },
  ],
});

// h2 inside the card: white → hot pink → deep pink, i.e. the brand's contrast
// note read into its accent, where ContentBox's own h1 gradient opens on soft
// pink-white and runs pink-white → hot pink → mid-deep pink. The two levels stay
// visually distinct without either repeating the other's opening stop, and the
// soft pink stays on the h1 — a second pink-led heading on this rose-black card
// is where the hierarchy would collapse. No gold: that was the outgoing brand's
// secondary.
const sectionHeadingClass = "bg-gradient-to-r from-[#ffffff] via-[#f874a1] to-[#8f1140] bg-clip-text text-2xl leading-normal font-bold text-transparent";
---

<MainLayout title="RUAYRUAY888 | ทดลองเกมและศึกษากติกาก่อนเล่นจริง" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={pageTitle} as="h1">
    <div>
      <h2 class={`mb-6 ${sectionHeadingClass}`}>ทดลองระบบบน RUAYRUAY888 คือการไล่ดูอะไรบ้างก่อนเดิมพันจริง</h2>

      <p class="mb-8 text-left text-base leading-relaxed text-[#f6dde8]">
        การทดลองระบบบน RUAYRUAY888 คือการเปิดหน้าจอชุดเดียวกับที่จะใช้จริงขึ้นมาไล่ดูให้ครบก่อนเดิมพันด้วยเงินของตัวเอง ตั้งแต่หน้ารวมเกมที่แยกตามประเภทและผู้ให้บริการตามรายการที่เว็บไซต์กำหนด
        หน้าเกมที่ต้องเลือกรูปแบบการเดิมพันและยอดต่อรอบ หน้าที่แสดงตารางจ่ายกับกติกาของเกมนั้น หน้าโปรโมชั่นที่ระบุยอดขั้นต่ำ เกมที่ร่วมรายการ ระยะเวลา และเงื่อนไขการถอน
        ไปจนถึงหน้าบัญชีที่รวมยอดคงเหลือ สิทธิ์ที่ถืออยู่ และประวัติธุรกรรมไว้ตรวจย้อนหลัง เพราะสิ่งที่ทำให้ผู้เล่นใหม่เสียเงินโดยไม่จำเป็นมักไม่ใช่เกมที่เลือก แต่เป็นการกดยืนยันโดยยังไม่รู้ว่ารายการตรงหน้าคิดผลจากอะไร เช่น
        ตั้งยอดต่อรอบสูงกว่าที่ตั้งใจเพราะไม่ได้ดูวงเงินขั้นต่ำของเกมนั้น กดรับโปรโมชั่นทั้งที่เกมที่จะเล่นไม่ได้ร่วมรายการ ยืนยันฝากถอนโดยยังไม่ได้ตรวจข้อมูลกระเป๋าเงินกับจำนวนเงินให้ตรงกัน
        อ่านยอดคงเหลือผิดช่องจนใช้เงินเกินงบที่ตั้งไว้ หรือกดส่งซ้ำเพราะไม่ได้รอให้ระบบแสดงสถานะของรายการเดิมก่อน
        ความเข้าใจคลาดเคลื่อนเหล่านี้แก้ทีหลังได้ยากเมื่อรายการเข้าสู่ระบบไปแล้ว แต่ป้องกันได้เกือบทั้งหมดด้วยการเปิดดูหนึ่งรอบก่อน สี่ขั้นด้านล่างคือสิ่งที่ควรไล่ดูให้ครบ
        และเป็นลำดับเดียวกับที่ใช้จริงเมื่อเล่นด้วยเงินของตัวเอง
      </p>

      <div class="mb-8 grid grid-cols-1 gap-5 sm:grid-cols-2" role="list" aria-label="สี่ขั้นตอนที่ควรศึกษาก่อนเดิมพันด้วยเงินจริงบน RUAYRUAY888">
        {
          trySteps.map((step) => (
            <div role="listitem" class="rounded-2xl border border-[#8f1140]/35 bg-[#241b1d]/70 p-5 transition-colors duration-300 hover:border-[#f874a1]/55">
              <p class="mb-2 flex items-center gap-3 text-base font-bold text-[#fdb4d4]">
                <span aria-hidden="true" class="text-2xl">
                  {step.icon}
                </span>
                {step.label}
              </p>
              <p class="text-left text-base leading-relaxed text-[#f6dde8]">{step.detail}</p>
            </div>
          ))
        }
      </div>

      <h2 class={`mt-8 mb-6 ${sectionHeadingClass}`}>สามชั้นข้อมูลที่ควรอ่านให้จบในช่วงทดลองก่อนเดิมพันรอบแรก</h2>

      <p class="mb-4 text-left text-base leading-relaxed text-[#f6dde8]">
        เกมแต่ละค่ายวางกติกากันคนละแบบ สล็อตนับผลจากเงื่อนไขของตัวเกมและฟีเจอร์ที่ค่ายนั้นใส่มา บาคาร่ากับเกมโต๊ะอื่นนับผลจากกติกาของโต๊ะและอัตราจ่ายของแต่ละช่องเดิมพัน
        คาสิโนสดเดินตามจังหวะของรอบที่เปิดจริงและมีวงเงินต่อรอบของตัวเอง เมื่อระบบรวมหลายค่ายไว้ด้วยกัน เกมสองเกมที่อยู่ใกล้กันบนหน้าจอจึงอาจใช้กติกา อัตราจ่าย และวงเงินคนละชุด
        สิ่งที่ควรได้จากการทดลองจึงเป็นความเข้าใจว่ารายการที่กำลังจะยืนยันนั้นคิดผลจากอะไร ไม่ใช่การจำว่าปุ่มอยู่ตรงไหน เรื่องที่ควรอ่านให้จบมีสามชั้น
        ชั้นแรกคือค่ายและประเภทเกม ทั้งชื่อผู้ให้บริการ ประเภทเกม ฟีเจอร์ที่มี และวงเงินขั้นต่ำต่อรอบ ซึ่งเป็นชั้นที่ผิดแล้วทำให้รูปแบบการเล่นทั้งรอบไม่ตรงกับที่ตั้งใจไว้
        ชั้นที่สองคืออัตราจ่ายกับความผันผวนที่มาคู่กัน เกมที่จ่ายสูงกว่ามักมาพร้อมความผันผวนที่มากกว่า และเงื่อนไขการนับผลที่แคบกว่า สองอย่างนี้ต้องอ่านคู่กันเสมอ
        และไม่ควรถือว่าอัตราจ่ายสูงหมายถึงมีโอกาสชนะมากขึ้น ชั้นที่สามคือขอบเขตของโปรโมชั่นและของบัญชี ทั้งยอดขั้นต่ำ เกมที่ร่วมรายการ ระยะเวลา เงื่อนไขการถอน และวงเงินของแต่ละรายการ
        ค่าเหล่านี้เป็นค่าเฉพาะของรายการนั้นและเปลี่ยนได้ระหว่างช่วงเวลา จึงต้องอ่านจากหน้าที่ระบบแสดงจริง ไม่ใช่จากที่จำมาจากรอบก่อน เรื่องสุดท้ายในขั้นนี้คือการอ่านยอดให้ถูกช่อง
        จำนวนเงินต่อหนึ่งรอบกับยอดรวมที่ใช้ไปทั้งวันเป็นคนละยอด และเมื่อเล่นต่อเนื่องหลายรอบ ยอดรวมจะโตเร็วกว่าที่คาดไว้เสมอ การตั้งยอดต่อรอบให้ต่ำไว้ตอนเริ่มจึงช่วยได้จริง
      </p>

      <h2 class={`mt-8 mb-6 ${sectionHeadingClass}`}>สิ่งที่การทดลองระบบบอกได้ และสิ่งที่บอกไม่ได้</h2>

      <p class="mb-4 text-left text-base leading-relaxed text-[#f6dde8]">
        สิ่งที่การทดลองบอกได้คือกลไกและขั้นตอน ได้แก่ วิธีหาชื่อค่ายกับประเภทเกมที่ต้องการ ความต่างระหว่างสล็อต บาคาร่า และคาสิโนสด ตำแหน่งที่ระบบแสดงตารางจ่าย กติกา และวงเงินต่อรอบ
        ลำดับหน้าจอตั้งแต่เลือกค่ายจนถึงหน้ายืนยันการเดิมพัน จุดที่ระบบแสดงเงื่อนไขของโปรโมชั่น และจุดที่เก็บประวัติธุรกรรมกับเลขอ้างอิงไว้ตรวจย้อนหลัง เมื่อรู้สิ่งเหล่านี้แล้ว
        การเล่นจริงจะเหลือแค่การตัดสินใจเรื่องเกมและงบ ไม่ต้องเสียสมาธิไปกับการหาปุ่มหรือเดาว่ารายการที่ยืนยันไปนั้นนับผลอย่างไร สิ่งที่การทดลองบอกไม่ได้เลยคือผลของรอบถัดไป
        ผลของรอบหนึ่งไม่ได้ถูกกำหนดจากรอบก่อนหน้า และเครดิตที่ใช้ในช่วงทดลองไม่ใช่เงินจริง ถอนไม่ได้ และไม่มีผลต่อยอดในบัญชีจริง ตัวเลขที่เห็นระหว่างทดลองจึงไม่ใช่ตัวแทนของผลจริงหรือของอัตราจ่ายที่จะได้รับ
        ช่วงที่ผลออกทางใดทางหนึ่งติดกันหลายรอบก็เป็นเรื่องของความผันผวนในระยะสั้น ไม่ใช่สัญญาณว่ารอบถัดไปจะออกทางใด และการนับสถิติจากรอบที่ผ่านมาก็ไม่ได้ทำให้คาดเดารอบหน้าได้แม่นขึ้น
        คำว่าจ่ายดีและโปรแรงก็เป็นถ้อยคำที่ใช้สื่อถึงอัตราจ่ายและสิทธิ์ที่เว็บไซต์กำหนดเท่านั้น ไม่ใช่การรับประกันผลตอบแทน และไม่สามารถรับประกันกำไรได้ไม่ว่ากรณีใด
        ทุกอย่างจึงควรตรวจจากกติกาและเงื่อนไขที่ระบบแสดงจริงในขณะนั้น ไม่ใช่จากคำโฆษณา
      </p>

      <p class="mb-2 text-left text-base leading-relaxed text-[#f6dde8]">
        เมื่อพร้อมจะขยับไปเล่นจริง สิ่งที่ควรจัดให้เรียบร้อยก่อนมีสามอย่าง อย่างแรกคือบัญชี ควรใช้ข้อมูลที่ตรงกับตอนสมัคร ตั้งรหัสผ่านที่คาดเดายากและไม่ซ้ำกับบริการอื่น
        และเข้าใช้งานผ่านช่องทางหลักที่เว็บไซต์กำหนดเท่านั้น โดยตรวจชื่อเว็บไซต์และการเชื่อมต่อแบบ HTTPS ทุกครั้งก่อนกรอกข้อมูล อย่างที่สองคืองบประมาณ ควรกำหนดวงเงินต่อวันหรือต่อรอบไว้ล่วงหน้า
        ใช้เฉพาะเงินที่ไม่กระทบค่าใช้จ่ายจำเป็น หยุดเมื่อถึงวงเงินที่ตั้งไว้ และไม่เพิ่มเงินเพื่อตามคืนยอดที่เสียไปแล้ว อย่างที่สามคือการติดตามรายการ
        หลังยืนยันการฝากถอนหรือรับสิทธิ์โปรโมชั่นแล้วให้ยึดสถานะและยอดคงเหลือจากหน้าบัญชีเป็นหลัก หลีกเลี่ยงการส่งคำขอซ้ำขณะที่รายการเดิมยังดำเนินการอยู่ และหากพบรายการที่ผิดปกติ ให้เตรียมเวลา จำนวนเงิน
        และเลขอ้างอิงของรายการไว้แจ้งทีมงานตั้งแต่ข้อความแรก โดยไม่เปิดเผยรหัสผ่านหรือรหัสยืนยันแก่ผู้ใด
      </p>
