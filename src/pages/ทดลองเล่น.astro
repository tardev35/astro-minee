---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/AnnouncementCyber.astro";

import { Picture } from "astro:assets";
import { itemList, pageGraph, schemaCtx } from "../lib/schema";
import image1 from "../assets/gamedemo7.webp";
import image2 from "../assets/gamedemo8.webp";
import image3 from "../assets/gamedemo9.webp";
import image4 from "../assets/gamedemo10.webp";
import image5 from "../assets/gamedemo11.webp";
import image6 from "../assets/gamedemo12.webp";
import image7 from "../assets/gamedemo13.webp";
import image8 from "../assets/gamedemo14.webp";
import image9 from "../assets/gamedemo15.webp";
import image10 from "../assets/gamedemo16.webp";
import image11 from "../assets/gamedemo17.webp";
import image12 from "../assets/gamedemo18.webp";

// One list, two consumers: the gallery below and the ItemList in the JSON-LD.
// They used to be two hand-kept arrays that had to stay in the same order, and
// the name shown to a reader could drift from the name handed to a crawler.
//
// Every alt below was written by opening the file: it describes the artwork on
// the banner (logo + character + setting), not the page it happens to sit on.
const demoGames = [
  { name: "AskmeSlot", src: image1, alt: "แบนเนอร์ค่ายเกม AskmeSlot โลโก้โพดำสีเหลือง คู่ภาพตัวการ์ตูนเด็กชายสวมหมวกและเสื้อแจ็กเก็ตสีแดงบนถนนเมืองเก่าที่มีกังหันลม" },
  { name: "Popular Game", src: image2, alt: "แบนเนอร์ POPULAR GAME ตัวอักษรทอง มีตัวการ์ตูนกระต่ายและแมวใส่แว่นยืนขนาบหีบสมบัติ พร้อมชิปคาสิโนและกองเหรียญทอง" },
  { name: "SlotXO", src: image3, alt: "แบนเนอร์ค่ายเกม SlotXO โลโก้รูปตู้สล็อต คู่ภาพนักรบโรมันเคราขาวสวมมงกุฎใบลอเรลหน้าโคลอสเซียม" },
  { name: "Skywind Group", src: image4, alt: "แบนเนอร์ค่ายเกม Skywind Group โลโก้วงกลมสี่สี คู่ภาพแมวกวักญี่ปุ่นสีขาวท่ามกลางดอกซากุระและก้อนทอง" },
  { name: "PG Soft", src: image5, alt: "แบนเนอร์ค่ายเกม PG Soft หรือ Pocket Games Soft คู่ภาพนักรบหญิงสวมเครื่องประดับขนนกสไตล์แอซเท็ก" },
  { name: "SBOBET", src: image6, alt: "แบนเนอร์ค่ายเกม SBOBET คู่ภาพตัวการ์ตูนสาวผมบลอนด์ในชุดกิโมโนสีชมพูถืออมยิ้มเกลียวสีรุ้ง" },
  { name: "Sexy Slot", src: image7, alt: "แบนเนอร์ค่ายเกม Sexy Slot ตัวอักษรสีชมพูม่วง คู่ภาพตัวการ์ตูนสาวในชุดรัดรูปสีม่วงพร้อมรูปหัวใจลอยรอบตัว" },
  { name: "JILI", src: image8, alt: "แบนเนอร์ค่ายเกม JILI ตัวอักษรทอง คู่ภาพนางเงือกผมแดงถือหอยสังข์อยู่ใต้ทะเลพร้อมปลาการ์ตูน" },
  { name: "Ask Me Bet", src: image9, alt: "แบนเนอร์ค่ายเกม Ask Me Bet คู่ภาพหัวสิงโตเชิดสีแดงทองท่ามกลางโคมไฟจีนสีแดง" },
  { name: "New Game", src: image10, alt: "แบนเนอร์ New Game ตัวอักษรสีขาวบนฟลอร์เรืองแสง มีตัวการ์ตูนหัวฟักทองและโครงกระดูกยืนขนาบสองข้าง" },
  { name: "JOKER", src: image11, alt: "แบนเนอร์ค่ายเกม JOKER คู่ภาพนักรบโรมันสวมหมวกเหล็กยอดแหลมยืนคู่สิงโตคำรามในสนามประลอง" },
  { name: "AFB Gaming", src: image12, alt: "แบนเนอร์ค่ายเกม AFB Gaming คู่ภาพเทพเจ้ากรีกเคราขาวสวมมงกุฎใบลอเรล ดวงตาเปล่งแสงหน้าวิหารเสาหิน" },
];

// The URL each entry resolves to is schema.ts's problem, not this file's — an
// older version pasted a hand-built page URL onto all 12 and got the trailing
// slash and the Thai encoding wrong on every one of them.
const gameList = demoGames.map((game) => ({ name: game.name, imagePath: game.src.src }));

const pageTitle = "ทดลองเล่นบาคาร่าและเกมคาสิโน KOHKAE789 ก่อนลงเดิมพันจริง";

// 157 ตัวอักษร (นับตัวอักษร ไม่ใช่ไบต์) — อยู่ในกรอบ 150–160 ที่ verify-build บังคับ
const pageDescription =
  "KOHKAE789 ทดลองเล่นบาคาร่าเพื่อเรียนรู้กติกา รูปแบบเดิมพัน และการนับผลแต่ละรอบ ช่วยให้เข้าใจเกมและวางงบประมาณได้เหมาะสมขึ้น ทดลองเล่นไม่ใช่การเดิมพันเงินจริง";

const ctx = schemaCtx(Astro);
const graph = pageGraph(Astro, {
  type: "CollectionPage",
  name: pageTitle,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "ทดลองเล่น", path: "/ทดลองเล่น" },
  ],
  extra: [
    itemList(ctx, {
      name: "ทดลองเล่นเกมคาสิโนหลายค่ายของ KOHKAE789",
      alternateName: "KOHKAE789 โหมดทดลองเล่นเกมคาสิโนบนมือถือก่อนเริ่มใช้งานจริง",
      itemType: "Game",
      items: gameList,
    }),
  ],
});
---

<MainLayout title="KOHKAE789 | ทดลองเล่นบาคาร่าเพื่อศึกษากติกาก่อนเดิมพัน" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={pageTitle} as="h1">
    <div>
      <h2 class="mb-6 bg-gradient-to-r from-[#e8f6ff] via-[#7fdcff] to-[#29abe3] bg-clip-text text-2xl leading-normal font-bold text-transparent">โหมดทดลองของ KOHKAE789 มีไว้ทำอะไร และควรดูอะไรก่อนเลือกโต๊ะ</h2>

      <p class="mb-8 text-left text-base leading-relaxed text-[#cfe6f7]">
        KOHKAE789 วางบาคาร่าเป็นเกมหลักของระบบ และมีเกมค่ายอื่นอยู่ในเมนูเดียวกัน ทั้งค่ายอย่าง PG Soft, JOKER, JILI และค่ายที่เห็นอยู่ด้านล่างนี้
        หน้านี้จึงเป็นที่ให้กดเปิดดูหน้าเกมก่อนว่าหน้าตาระบบเป็นแบบไหน ปุ่มปรับเดิมพันอยู่ตรงไหน ผลแต่ละรอบขึ้นอย่างไร และหนึ่งตาใช้เวลาแค่ไหน โดยยังไม่ต้องใส่เงินจริงและไม่มีการได้เสียเกิดขึ้น
        สำหรับบาคาร่า สิ่งที่ควรดูจริงคือกติกาการนับแต้ม เงื่อนไขการเปิดไพ่ใบที่สาม อัตราจ่ายของฝั่งเจ้ามือกับฝั่งผู้เล่น และเดิมพันขั้นต่ำต่อตา เพื่อเลือกโต๊ะให้เหมาะกับงบประมาณของตนเอง
        มากกว่าดูว่าโต๊ะไหนกำลังมีคนนั่งเยอะที่สุด โต๊ะที่คนเยอะช่วยให้หาคนคุยด้วยง่าย แต่ไม่ได้ช่วยเจรจากับผลไพ่เป็นการส่วนตัว ถือเป็นการอ่านคู่มือก่อนขับ ซึ่งน่าเบื่อกว่าการลองขับเลยอยู่แล้ว แต่ค่าซ่อมมันถูกกว่ากันเยอะ
      </p>

      <div class="mb-5 grid grid-cols-2 gap-5 sm:grid-cols-2 md:grid-cols-4">
        {
          demoGames.map((game) => (
            <div class="group/game relative mx-auto w-full max-w-[400px] overflow-hidden rounded-xl">
              <Picture
                src={game.src}
                alt={game.alt}
                loading="lazy"
                fetchpriority="low"
                widths={[160, 320, 480]}
                sizes="(max-width: 767px) 42vw, (max-width: 1520px) 23vw, 320px"
                class="block h-auto w-full object-cover shadow-[0_10px_30px_rgba(41,171,227,0.20)] transition-transform duration-300 group-hover/game:scale-105"
                decoding="async"
                formats={["avif", "webp"]}
                fallbackFormat="webp"
                quality={60}
              />
              <a
                href="/register"
                target="_blank"
                rel="noopener noreferrer"
                aria-label={`สมัครสมาชิกเพื่อเล่น ${game.name} ที่ KOHKAE789`}
                class="absolute inset-0 flex items-center justify-center bg-[#050c1a]/75 opacity-0 transition-opacity duration-300 group-hover/game:opacity-100 focus-visible:opacity-100">
                <span class="rounded-full border border-[#29abe3]/60 bg-gradient-to-r from-[#bfe9ff] via-[#7fdcff] to-[#29abe3] px-6 py-2 font-bold text-[#050c1a] shadow-[0_10px_30px_rgba(21,115,230,0.32)] transition-transform hover:scale-110">เล่นเลย</span>
              </a>
            </div>
          ))
        }
      </div>

      <h2 class="mt-8 mb-6 bg-gradient-to-r from-[#e8f6ff] via-[#7fdcff] to-[#29abe3] bg-clip-text text-2xl leading-normal font-bold text-transparent">โหมดทดลองบอกอะไรได้ และบอกอะไรไม่ได้</h2>

      <p class="mb-4 text-left text-base leading-relaxed text-[#cfe6f7]">
        โหมดทดลองบอกได้ว่าเกมทำงานอย่างไร เมนูอยู่ตรงไหน ช่องวางเดิมพันแยกฝั่งกันแบบไหน และหนึ่งตาใช้เวลาเท่าไร แต่เครดิตในโหมดนี้เป็นยอดสมมติ ถอนไม่ได้ และผลที่ออกมาก็ไม่ได้บอกว่าเล่นจริงจะได้ผลเหมือนกัน
        คำว่าแตกง่ายใช้สื่อถึงเกมที่มีจังหวะลุ้นน่าสนใจ แต่ไม่สามารถรับประกันผลลัพธ์ได้ ต่อให้กดในโหมดทดลองแล้วจังหวะเข้ามือ ก็ไม่ใช่หลักฐานว่าโต๊ะนั้นกำลังอารมณ์ดีรอเราอยู่
        เค้าไพ่ที่เห็นบนจอเป็นบันทึกของรอบที่ผ่านไปแล้ว ไม่ใช่คำใบ้ของรอบถัดไป โหมดนี้จึงมีไว้ศึกษาระบบ ไม่ใช่ไว้ดูดวงผ่านหน้าจอ
      </p>

      <p class="mb-4 text-left text-base leading-relaxed text-[#cfe6f7]">
        อีกเรื่องที่ควรเผื่อใจคือโหมดทดลองไม่ได้มีให้ครบทุกเกม โดยเฉพาะโต๊ะถ่ายทอดสดและเกมบางค่ายที่ยังไม่เปิดโหมดนี้ จึงควรเปิดหน้ารายละเอียดของเกมดูก่อนเลือก
        และยอดที่หมุนในโหมดทดลองไม่นับเป็นยอดเทิร์นของบัญชีหรือของโปรโมชั่นใด ถ้าเกมที่อยากลองไม่มีปุ่มทดลอง ให้ถือว่าวันนี้โชคไม่ดี ไม่ใช่สัญญาณลับที่ระบบส่งมาให้เราคนเดียว
        การรวมเกมไว้ในระบบเดียวช่วยให้ค้นหาตามค่าย ประเภทเกม หรือรูปแบบที่ชื่นชอบได้จากหน้าเดียว และเว็บไซต์รองรับทั้งมือถือ แท็บเล็ต และคอมพิวเตอร์ จึงเปิดดูเกมผ่านเบราว์เซอร์ได้โดยไม่ต้องติดตั้งโปรแกรมเพิ่ม
        ควรใช้อินเทอร์เน็ตที่เสถียรและอัปเดตเบราว์เซอร์ให้เป็นรุ่นล่าสุด
      </p>

      <h2 class="mt-8 mb-6 bg-gradient-to-r from-[#e8f6ff] via-[#7fdcff] to-[#29abe3] bg-clip-text text-2xl leading-normal font-bold text-transparent">จากโหมดทดลองไปเล่นจริงบน KOHKAE789 ควรเช็กอะไรก่อน</h2>

      <p class="mb-2 text-left text-base leading-relaxed text-[#cfe6f7]">
        ถ้าจะขยับจากโหมดทดลองไปเล่นด้วยเงินจริง เรื่องที่ควรดูก่อนคือบัญชี งบต่อตา โปรโมชั่น และช่องทางเข้า ด้านบัญชี ควรใช้ข้อมูลที่ตรงกับตอนสมัคร ทั้งเบอร์โทรที่รับข้อความได้จริงและชื่อบัญชีธนาคารของผู้สมัครเอง
        และตั้งรหัสผ่านที่คาดเดายาก ไม่ซ้ำกับบริการอื่น ไม่ใช่เลขวันเกิด เลขเรียง หรือเลขซ้ำทั้งชุด เพราะสมัครเร็วเป็นเรื่องดี แต่กรอกผิดแล้วตามแก้ทีหลัง ความเร็วก็หายหมด
        ด้านงบ ควรกำหนดวงเงินและเวลาเล่นให้ชัดเจนก่อนเริ่ม แล้วดูเดิมพันขั้นต่ำต่อตาของโต๊ะที่เลือกประกอบ ตัวเลขนั้นเป็นเดิมพันของโต๊ะ ไม่ใช่เงื่อนไขของการฝากหรือการถอน
        เงื่อนไขฝากถอนของ KOHKAE789 ทำผ่านระบบออโต้ตามช่องทางที่เว็บไซต์กำหนด จึงควรดูยอดบนหน้าฝากและหน้าโต๊ะแยกกันอีกครั้ง และถ้าจะกดรับโปรโมชั่นก็ต้องอ่านยอดฝากขั้นต่ำ โบนัสที่ได้รับ จำนวนเทิร์น เกมที่ร่วมรายการ และเพดานถอนให้จบก่อน
        สุดท้ายควรเข้าใช้งานผ่านช่องทางเข้าหลักของ KOHKAE789 ที่ตรวจชื่อเว็บไซต์แล้วและเชื่อมต่อแบบ HTTPS เท่านั้น ไม่ใช่ลิงก์ที่ส่งต่อกันมาในแชตพร้อมคำโฆษณา และหากติดปัญหาระหว่างใช้งาน ทีมงานดูแลสมาชิกรับเรื่องตลอด 24 ชั่วโมงผ่านช่องทางที่เว็บไซต์ระบุ
      </p>
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
