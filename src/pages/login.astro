---
import { fontStack, usesGoogleFonts } from "../lib/brandProfile";

const targetUrl = "https://yoalink.com/q83b";

// This page has its own <head> and does not import global.css, so it gets
// neither the @theme fallback for --font-sans nor the self-hosted Kanit
// @font-face. Both have to be supplied here or the page renders in the browser
// default while the rest of the site does not — hence the @font-face rules in
// the first <style> block below. Kanit stays declared on either brand font: it
// is also the Thai fallback inside the Google Sans stack.
//
// This brand is on Google Sans (BRAND_FONT rotated off kanit), so
// usesGoogleFonts is true and fontHref takes the FIRST branch, asking Google
// for Google Sans and Oswald. Oswald is the only face that always needs a CDN:
// the Latin status heading uses it and it is not self-hosted. Kanit still comes
// from /fonts by the @font-face rules below — it is the Thai fallback inside
// the Google Sans stack — and never from the CDN.
// The brand wordmark needs no third typeface either — .brand-identity draws the
// name in var(--font-sans), the same face the rest of the site uses, so the
// wordmark here matches the navbar logotype on a screen that is on display for
// 1.5 seconds.
//
// The kanit branch used to request "Kanit:wght@300;400;600" too, even though the
// site self-hosts Kanit: a third-party request for weights nothing here draws
// (300 and 600 are used zero times), and a query string byte-identical on every
// Kanit brand in the portfolio — the shared signature BRAND_FONT exists to
// break up. Do not put Kanit back into either branch.
const fontHref = usesGoogleFonts
  ? "https://fonts.googleapis.com/css2?family=Google+Sans:ital,opsz,wght@0,17..18,400..700;1,17..18,400..700&family=Oswald:wght@700&display=swap"
  : "https://fonts.googleapis.com/css2?family=Oswald:wght@700&display=swap";
---

<html lang="th" style={`--font-sans: ${fontStack};`}>
  <head>
    <meta charset="utf-8" />
    <title>หวยพร้อม | เข้าสู่ระบบแทงหวยออนไลน์ผ่านช่องทางหลัก</title>

    {
      /* Title and description are the docx SUB-PAGES row for /login, both
        verbatim. The brief's sentence is 118 characters and it ships at 118:
        a description the docx supplies is used at its own length and is not
        padded. Nothing forces a floor here either — verify-build.mjs puts its
        150–160 gate after `if (!indexable) continue;` and this stub is noindex
        (see the robots meta below).
        Count CHARACTERS, not bytes: Thai is 3 bytes per character. */
    }
    <meta name="description" content="หวยพร้อม เข้าสู่ระบบผ่านช่องทางหลัก รองรับมือถือ พร้อมเลือกหวย กรอกเลข ตรวจโพย อัตราจ่าย และประวัติรายการได้อย่างสะดวก" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    {
      /* This page exists only to forward; there is nothing here worth ranking,
        and its source carries the affiliate URL — the one host every brand in
        the group has in common. Keeping it out of the index means that link is
        not sitting in a page Google has stored. Astro's own /line redirect page
        ships noindex for the same reason. */
    }
    <meta name="robots" content="noindex, follow" />

    <meta http-equiv="refresh" content={`1.5;url=${targetUrl}`} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href={fontHref} rel="stylesheet" />

    <style>
      /* Self-hosted Kanit. This page has its own <head> and does not import
         global.css, so the @font-face rules there never reach it — which is why
         it used to pull Kanit from Google instead. Kanit is the Thai fallback
         inside the Google Sans stack too, so these stay on either brand font.
         Only the weights this page actually draws are declared. */
      @font-face {
        font-family: "Kanit";
        font-style: normal;
        font-weight: 400;
        font-display: swap;
        src: url("/fonts/kanit-v17-latin_thai-regular.woff2") format("woff2");
      }
      @font-face {
        font-family: "Kanit";
        font-style: normal;
        font-weight: 700;
        font-display: swap;
        src: url("/fonts/kanit-v17-latin_thai-700.woff2") format("woff2");
      }
    </style>

    <style>
      /* หวยพร้อม is a deep-green lottery hall: the identity hue is the green of
         its own artwork, gold is the prize metal that credit figures and badges
         are drawn in, and red appears on exactly one thing — the tick in the
         logo, which elsewhere on the site is the call-to-action colour. There is
         no button on this screen, so red is deliberately absent from it rather
         than sprinkled around for decoration.
         The .brand-identity gradient reads the wordmark's own bevel top to
         bottom: white through mint into gold, and down into the forest green the
         page itself sits on.
         The outgoing brand here was a metallic gold-on-navy hall, so every stop
         below changed hue as well as value. Naming a previous brand or quoting
         its hexes in this comment is what a dist/ grep for the old name would
         find, so the description stays generic on purpose.
         Every variable is NAMED FOR THE COLOUR IT HOLDS, which previous brands
         stopped doing: this block once declared `--brand-gold` on brands with no
         gold in them and `--brand-red` on a blue one, so the next editor reused
         it by name and shipped the wrong hue. Hence `--green*` for the primary,
         `--gold*` for the prize metal, and `--ink`/`--forest` for the two dark
         surfaces the ramp ends on. Rename with the value. */
      :root {
        --ink: #04140a;
        --panel: rgba(10, 36, 19, 0.94);
        --green: #22c55e;
        --green-bright: #6ee7a0;
        --green-deep: #1e7a3a;
        --forest: #10361c;
        --gold: #f5c451;
        --gold-bright: #ffe08a;
        --gold-deep: #a9791a;
        --white: #ffffff;
        --text: #d8efdc;
        --text-dim: #9fc8ab;
      }

      body {
        margin: 0;
        font-family: var(--font-sans);
        color: var(--text);

        background: radial-gradient(circle at 50% 10%, rgba(34, 197, 94, 0.16) 0%, transparent 55%), radial-gradient(circle at 50% 92%, rgba(30, 122, 58, 0.55) 0%, transparent 55%), var(--ink);
        display: flex;
        min-height: 100vh;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 2rem;
      }

      .premium-loading-container {
        width: 90%;
        max-width: 450px;
        padding: 3.5rem;
        background: var(--panel);
        border: 1px solid rgba(34, 197, 94, 0.45);
        border-radius: 2rem;
        box-shadow:
          0 1rem 3rem rgba(34, 197, 94, 0.24),
          0 0 2rem rgba(30, 122, 58, 0.55);
        text-align: center;
        backdrop-filter: blur(10px);
      }

      .brand-identity {
        font-family: var(--font-sans);
        font-size: 1.5rem;
        font-weight: 700;
        background: linear-gradient(180deg, var(--white) 0%, var(--green-bright) 22%, var(--gold-bright) 48%, var(--gold) 72%, var(--gold-deep) 88%, var(--forest) 100%);
        -webkit-background-clip: text;
        background-clip: text;
        color: transparent;
        letter-spacing: 0.12em;
        margin-bottom: 2rem;
        filter: drop-shadow(0 1px 2px rgba(4, 20, 10, 0.6));
      }

      .sophisticated-loader {
        position: relative;
        width: 100px;
        height: 100px;
        margin: 0 auto 3.5rem auto;
        display: flex;
        align-items: center;
        justify-content: center;
      }

      .orb {
        width: 40px;
        height: 40px;
        background: radial-gradient(circle, var(--green-bright) 0%, var(--green) 55%, var(--forest) 100%);
        border-radius: 50%;
        box-shadow: 0 0 2rem rgba(34, 197, 94, 0.45);
        animation: pulse 2s ease-in-out infinite;
      }

      .ring {
        position: absolute;
        border-radius: 50%;
        border: 3px solid rgba(34, 197, 94, 0.2);
        animation: spin linear infinite;
      }

      .ring-1 {
        width: 100%;
        height: 100%;
        border-top-color: var(--green);
        animation-duration: 4s;
      }

      .ring-2 {
        width: 80%;
        height: 80%;
        border-bottom-color: var(--gold);
        animation-duration: 6s;
        animation-direction: reverse;
      }

      @keyframes spin {
        0% {
          transform: rotate(0deg);
        }
        100% {
          transform: rotate(360deg);
        }
      }
      @keyframes pulse {
        0%,
        100% {
          transform: scale(1);
          box-shadow: 0 0 2rem rgba(34, 197, 94, 0.45);
        }
        50% {
          transform: scale(1.15);
          box-shadow: 0 0 3rem rgba(110, 231, 160, 0.55);
        }
      }

      .status-text .h1 {
        font-family: "Oswald", sans-serif;
        font-size: 1.25rem;
        font-weight: 700;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: var(--text);
        text-shadow: 0 1px 1px rgba(4, 20, 10, 0.6);
        margin: 0;
      }
      .status-text .p {
        font-size: 0.875rem;
        color: var(--text-dim);
        line-height: 1.6;
        margin: 1rem 0 0 0;
      }
    </style>
  </head>
  <body>
    <div class="premium-loading-container">
      <div class="brand-identity">หวยพร้อม</div>

      <div class="sophisticated-loader">
        <div class="orb"></div>
        <div class="ring ring-1"></div>
        <div class="ring ring-2"></div>
      </div>

      <div class="status-text">
        <h1 class="h1">AUTHENTICATING SECURE ACCESS...</h1>
        <p class="p">กำลังพาไปหน้าเข้าสู่ระบบ หวยพร้อม อย่างปลอดภัย <span aria-hidden="true">🔒</span></p>
      </div>
    </div>

    <script define:vars={{ targetUrl }}>
      setTimeout(() => {
        window.location.replace(targetUrl);
      }, 3000);
    </script>
  </body>
</html>
