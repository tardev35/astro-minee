---
import { fontStack, usesGoogleFonts } from "../lib/brandProfile";

const targetUrl = "https://yoalink.com/q83b";

// This page has its own <head> and does not import global.css, so it gets
// neither the @theme fallback for --font-sans nor the self-hosted Kanit
// @font-face. Both have to be supplied here or the page renders in the browser
// default while the rest of the site does not — hence the @font-face rules in
// the first <style> block below. Kanit stays declared on either brand font: it
// is also the Thai fallback inside the Google Sans stack.
//
// This brand is on Google Sans (BRAND_FONT rotated off kanit), so
// usesGoogleFonts is true and fontHref takes the FIRST branch, asking Google for
// Google Sans and Oswald in one request. Oswald is the only face that always
// needs a CDN: the Latin status heading uses it and it is not self-hosted. The
// brand wordmark does NOT — .brand-identity draws the name in var(--font-sans),
// the same face the rest of the site uses, so the wordmark here matches the
// navbar logotype instead of introducing a third typeface on a screen that is on
// display for 1.5 seconds.
//
// The kanit branch used to request "Kanit:wght@300;400;600" too, even though the
// site self-hosts Kanit: a third-party request for weights nothing here draws
// (300 and 600 are used zero times), and a query string byte-identical on every
// Kanit brand in the portfolio — the shared signature BRAND_FONT exists to
// break up. Do not put Kanit back into either branch.
const fontHref = usesGoogleFonts
  ? "https://fonts.googleapis.com/css2?family=Google+Sans:ital,opsz,wght@0,17..18,400..700;1,17..18,400..700&family=Oswald:wght@700&display=swap"
  : "https://fonts.googleapis.com/css2?family=Oswald:wght@700&display=swap";
---

<html lang="th" style={`--font-sans: ${fontStack};`}>
  <head>
    <meta charset="utf-8" />
    <title>HOT189 | เข้าสู่ระบบบาคาร่าเว็บตรงผ่านช่องทางหลัก</title>

    {
      /* Title is the brand spec §6 row for เข้าสู่ระบบ, verbatim. The brief's
        description is 123 characters, so it opens the sentence here and one
        clause carries it to 157 — the site-wide 150–160 window every other page
        is written to. verify-build.mjs would not have forced it (its length gate
        sits after `if (!indexable) continue;` and this stub is noindex, see the
        robots meta below), but a description written to a different rule than
        the rest of the site is the kind of thing the next rebrand copies.
        Count CHARACTERS, not bytes: Thai is 3 bytes per character. */
    }
    <meta name="description" content="HOT189 เข้าสู่ระบบผ่านช่องทางหลัก รองรับมือถือและคอมพิวเตอร์ พร้อมเลือกโต๊ะบาคาร่า ตรวจสอบบัญชี โปรโมชั่น และรายการได้สะดวก จากหน้าบัญชีเดียวได้ตลอดการใช้งาน" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    {
      /* This page exists only to forward; there is nothing here worth ranking,
        and its source carries the affiliate URL — the one host every brand in
        the group has in common. Keeping it out of the index means that link is
        not sitting in a page Google has stored. Astro's own /line redirect page
        ships noindex for the same reason. */
    }
    <meta name="robots" content="noindex, follow" />

    <meta http-equiv="refresh" content={`1.5;url=${targetUrl}`} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href={fontHref} rel="stylesheet" />

    <style>
      /* Self-hosted Kanit. This page has its own <head> and does not import
         global.css, so the @font-face rules there never reach it — which is why
         it used to pull Kanit from Google instead. Kanit is the Thai fallback
         inside the Google Sans stack too, so these stay on either brand font.
         Only the weights this page actually draws are declared. */
      @font-face {
        font-family: "Kanit";
        font-style: normal;
        font-weight: 400;
        font-display: swap;
        src: url("/fonts/kanit-v17-latin_thai-regular.woff2") format("woff2");
      }
      @font-face {
        font-family: "Kanit";
        font-style: normal;
        font-weight: 700;
        font-display: swap;
        src: url("/fonts/kanit-v17-latin_thai-700.woff2") format("woff2");
      }
    </style>

    <style>
      /* HOT189 is fire: a blazing orange-red orb inside electric gold rings on an
         ember-black page, and a gold wordmark that falls into flame at its base,
         the way the logo's type does. The outgoing brand here was crimson and
         muted gold on near-black maroon, so the primary moved from CRIMSON to
         FLAME and every support hue went hotter and much more yellow; nothing
         below kept its old value.
         Every variable is NAMED FOR THE COLOUR IT HOLDS, which previous brands
         stopped doing: this block once declared `--brand-gold` on brands with no
         gold in them and `--brand-red` on a blue one, so the next editor reused
         it by name and shipped the wrong hue. Rename with the value. */
      :root {
        --ink: #0d0402;
        --panel: rgba(28, 7, 5, 0.94);
        --flame: #ef2b09;
        --ember: #ff7a18;
        --char: #2e100a;
        --gold: #fcd304;
        --gold-light: #ffe86b;
        --gold-deep: #c99400;
        --text: #ffe9cf;
        --text-dim: #d9ac86;
      }

      body {
        margin: 0;
        font-family: var(--font-sans);
        color: var(--text);

        background: radial-gradient(circle at 50% 10%, rgba(239, 43, 9, 0.18) 0%, transparent 55%), radial-gradient(circle at 50% 92%, rgba(46, 16, 10, 0.45) 0%, transparent 55%), var(--ink);
        display: flex;
        min-height: 100vh;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 2rem;
      }

      .premium-loading-container {
        width: 90%;
        max-width: 450px;
        padding: 3.5rem;
        background: var(--panel);
        border: 1px solid rgba(239, 43, 9, 0.45);
        border-radius: 2rem;
        box-shadow:
          0 1rem 3rem rgba(239, 43, 9, 0.24),
          0 0 2rem rgba(46, 16, 10, 0.45);
        text-align: center;
        backdrop-filter: blur(10px);
      }

      .brand-identity {
        font-family: var(--font-sans);
        font-size: 1.5rem;
        font-weight: 700;
        background: linear-gradient(180deg, var(--gold-light) 0%, var(--gold) 35%, var(--gold-deep) 65%, var(--ember) 85%, var(--flame) 100%);
        -webkit-background-clip: text;
        background-clip: text;
        color: transparent;
        letter-spacing: 0.12em;
        margin-bottom: 2rem;
        filter: drop-shadow(0 1px 2px rgba(13, 4, 2, 0.6));
      }

      .sophisticated-loader {
        position: relative;
        width: 100px;
        height: 100px;
        margin: 0 auto 3.5rem auto;
        display: flex;
        align-items: center;
        justify-content: center;
      }

      .orb {
        width: 40px;
        height: 40px;
        background: radial-gradient(circle, var(--ember) 0%, var(--flame) 45%, var(--char) 100%);
        border-radius: 50%;
        box-shadow: 0 0 2rem rgba(239, 43, 9, 0.45);
        animation: pulse 2s ease-in-out infinite;
      }

      .ring {
        position: absolute;
        border-radius: 50%;
        border: 3px solid rgba(252, 211, 4, 0.2);
        animation: spin linear infinite;
      }

      .ring-1 {
        width: 100%;
        height: 100%;
        border-top-color: var(--gold);
        animation-duration: 4s;
      }

      .ring-2 {
        width: 80%;
        height: 80%;
        border-bottom-color: var(--ember);
        animation-duration: 6s;
        animation-direction: reverse;
      }

      @keyframes spin {
        0% {
          transform: rotate(0deg);
        }
        100% {
          transform: rotate(360deg);
        }
      }
      @keyframes pulse {
        0%,
        100% {
          transform: scale(1);
          box-shadow: 0 0 2rem rgba(239, 43, 9, 0.45);
        }
        50% {
          transform: scale(1.15);
          box-shadow: 0 0 3rem rgba(255, 122, 24, 0.55);
        }
      }

      .status-text .h1 {
        font-family: "Oswald", sans-serif;
        font-size: 1.25rem;
        font-weight: 700;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: var(--text);
        text-shadow: 0 1px 1px rgba(43, 10, 2, 0.6);
        margin: 0;
      }
      .status-text .p {
        font-size: 0.875rem;
        color: var(--text-dim);
        line-height: 1.6;
        margin: 1rem 0 0 0;
      }
    </style>
  </head>
  <body>
    <div class="premium-loading-container">
      <div class="brand-identity">HOT189</div>

      <div class="sophisticated-loader">
        <div class="orb"></div>
        <div class="ring ring-1"></div>
        <div class="ring ring-2"></div>
      </div>

      <div class="status-text">
        <h1 class="h1">AUTHENTICATING SECURE ACCESS...</h1>
        <p class="p">กำลังพาไปหน้าเข้าสู่ระบบ HOT189 อย่างปลอดภัย <span aria-hidden="true">🔒</span></p>
      </div>
    </div>

    <script define:vars={{ targetUrl }}>
      setTimeout(() => {
        window.location.replace(targetUrl);
      }, 3000);
    </script>
  </body>
</html>
