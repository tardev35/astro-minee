---
import { fontStack } from "../lib/brandProfile";

const targetUrl = "https://tinyurl.com/2ac7ys5h";

// This page has its own <head> and does not import global.css, so it gets
// neither the @theme fallback for --font-sans nor the self-hosted brand font's
// @font-face rules. Both have to be supplied here or the page renders in the
// browser default while the rest of the site does not — hence the @font-face
// block below, which declares BOTH faces the BRAND_FONT rotation can choose
// from. Only the one named by `fontStack` is ever fetched: an @font-face whose
// family nothing draws with is never downloaded, so carrying both costs zero
// bytes and means the next rotation cannot silently break this page.
//
// This brand is on Google Sans (BRAND_FONT rotated off kanit), so `fontStack`
// resolves to the Google Sans stack and the two google-sans-v70 subsets below
// are the files this page actually uses. All six live in public/fonts — the
// brand font is self-hosted on either setting and never comes from a CDN.
//
// Oswald is the one face that genuinely needs the CDN: the Latin status heading
// draws with it and it is not self-hosted, which is all `fontHref` asks for.
// It used to ask for the brand font as well — "Kanit:wght@300;400;600" on a
// Kanit brand, "Google+Sans" on a Google Sans one. Both were wrong: the Kanit
// weights are self-hosted (and 300/600 are drawn zero times), and Google Sans is
// not published on the Google Fonts API at all, so that request could only ever
// fail. Do not put the brand font back into this URL — on either setting.
//
// The brand wordmark needs no third typeface either — .brand-identity draws the
// name in var(--font-sans), the same face the rest of the site uses, so the
// wordmark here matches the navbar logotype on a screen that is on display for
// 1.5 seconds.
const fontHref = "https://fonts.googleapis.com/css2?family=Oswald:wght@700&display=swap";
---

<html lang="th" style={`--font-sans: ${fontStack};`}>
  <head>
    <meta charset="utf-8" />
    <title>TT1BET | เข้าสู่ระบบคาสิโนสล็อตผ่านช่องทางหลัก</title>

    {
      /* Title and description are the docx SUB-PAGES row for /login, both
        verbatim. The brief's sentence ships at its own length: a description the
        docx supplies is used as written and is not padded. Nothing forces a
        floor here either — verify-build.mjs puts its 150–160 gate after
        `if (!indexable) continue;` and this stub is noindex (see the robots meta
        below).
        Count CHARACTERS, not bytes: Thai is 3 bytes per character. */
    }
    <meta name="description" content="TT1BET เข้าสู่ระบบคาสิโนสล็อต รองรับมือถือ พร้อมเลือกค่ายเกม ตรวจโปรโมชั่น บัญชี และสถานะรายการได้สะดวกจากระบบเดียว" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    {
      /* This page exists only to forward; there is nothing here worth ranking,
        and its source carries the affiliate URL — the one host every brand in
        the group has in common. Keeping it out of the index means that link is
        not sitting in a page Google has stored. Astro's own /line redirect page
        ships noindex for the same reason. */
    }
    <meta name="robots" content="noindex, follow" />

    <meta http-equiv="refresh" content={`1.5;url=${targetUrl}`} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href={fontHref} rel="stylesheet" />

    <style>
      /* The self-hosted brand faces, copied from global.css because this page
         has its own <head> and never imports it. Both BRAND_FONT options are
         declared; the stack on <html> decides which one is drawn, and the other
         is never fetched. The unicode-range split is load-bearing on Google
         Sans: latin and thai are two separate files, and without it the browser
         would try to render Thai from the latin subset. */
      @font-face {
        font-family: "Google Sans";
        font-style: normal;
        font-weight: 400 700;
        font-display: swap;
        src: url("/fonts/google-sans-v70-latin-wght.woff2") format("woff2");
        unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
      }
      @font-face {
        font-family: "Google Sans";
        font-style: normal;
        font-weight: 400 700;
        font-display: swap;
        src: url("/fonts/google-sans-v70-thai-wght.woff2") format("woff2");
        unicode-range: U+02D7, U+0303, U+0331, U+0E01-0E5B, U+200C-200D, U+25CC;
      }
      @font-face {
        font-family: "Kanit";
        font-style: normal;
        font-weight: 400;
        font-display: swap;
        src: url("/fonts/kanit-v17-latin_thai-regular.woff2") format("woff2");
      }
      @font-face {
        font-family: "Kanit";
        font-style: normal;
        font-weight: 700;
        font-display: swap;
        src: url("/fonts/kanit-v17-latin_thai-700.woff2") format("woff2");
      }
    </style>

    <style>
      /* This brand is a Thai casino house painted as a gold-lit floor after
         dark: the identity hue is the gold of its own artwork — the chandeliers,
         the stacked chips, the rim of the roulette wheel — and it runs the top
         of the ramp, from a pale champagne highlight down through bronze into a
         deep bronze shadow. Crimson is the genuine second hue, not a tint of the
         first: it is the red of the wheel's pockets and the gown in the artwork,
         and it appears once, on the outer ring, so it reads as an accent rather
         than a rival. Everything bottoms out in the warm near-black the page
         itself is painted on. There is no button on this screen, so nothing
         needs a separate call-to-action colour.
         The .brand-identity gradient reads the wordmark top to bottom the way
         the artwork reads: brushed silver-white through champagne into gold,
         then down through bronze into that deep bronze shadow.
         Naming a previous brand or quoting its hexes in this comment is what a
         dist/ grep for the old name would find, so the description stays
         generic on purpose.
         Every variable is NAMED FOR THE COLOUR IT HOLDS, which previous brands
         stopped doing: this block once declared `--brand-gold` on brands with no
         gold in them and `--brand-red` on a blue one, so the next editor reused
         it by name and shipped the wrong hue. Hence `--gold*` for the primary
         ramp, `--bronze*` for its deep end, `--crimson` for the second hue, and
         `--ink`/`--panel` for the two dark surfaces. Rename with the value. */
      :root {
        --ink: #0b0805;
        --panel: rgba(23, 16, 8, 0.94);
        --gold: #e9c341;
        --gold-light: #fcf1b0;
        --gold-pale: #fff8d6;
        --bronze: #b8862a;
        --bronze-deep: #6d4a13;
        --crimson: #9e1b13;
        --white: #ffffff;
        --text: #f2e7cd;
        --text-dim: #c2ad85;
      }

      body {
        margin: 0;
        font-family: var(--font-sans);
        color: var(--text);

        background: radial-gradient(circle at 50% 10%, rgba(233, 195, 65, 0.16) 0%, transparent 55%), radial-gradient(circle at 50% 92%, rgba(184, 134, 42, 0.55) 0%, transparent 55%), var(--ink);
        display: flex;
        min-height: 100vh;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 2rem;
      }

      .premium-loading-container {
        width: 90%;
        max-width: 450px;
        padding: 3.5rem;
        background: var(--panel);
        border: 1px solid rgba(233, 195, 65, 0.45);
        border-radius: 2rem;
        box-shadow:
          0 1rem 3rem rgba(233, 195, 65, 0.24),
          0 0 2rem rgba(184, 134, 42, 0.55);
        text-align: center;
        backdrop-filter: blur(10px);
      }

      .brand-identity {
        font-family: var(--font-sans);
        font-size: 1.5rem;
        font-weight: 700;
        background: linear-gradient(180deg, var(--white) 0%, var(--gold-pale) 20%, var(--gold-light) 40%, var(--gold) 62%, var(--bronze) 80%, var(--bronze-deep) 100%);
        -webkit-background-clip: text;
        background-clip: text;
        color: transparent;
        letter-spacing: 0.12em;
        margin-bottom: 2rem;
        filter: drop-shadow(0 1px 2px rgba(11, 8, 5, 0.6));
      }

      .sophisticated-loader {
        position: relative;
        width: 100px;
        height: 100px;
        margin: 0 auto 3.5rem auto;
        display: flex;
        align-items: center;
        justify-content: center;
      }

      .orb {
        width: 40px;
        height: 40px;
        background: radial-gradient(circle, var(--gold-pale) 0%, var(--gold) 55%, var(--bronze-deep) 100%);
        border-radius: 50%;
        box-shadow: 0 0 2rem rgba(233, 195, 65, 0.45);
        animation: pulse 2s ease-in-out infinite;
      }

      .ring {
        position: absolute;
        border-radius: 50%;
        border: 3px solid rgba(233, 195, 65, 0.2);
        animation: spin linear infinite;
      }

      .ring-1 {
        width: 100%;
        height: 100%;
        border-top-color: var(--gold);
        animation-duration: 4s;
      }

      .ring-2 {
        width: 80%;
        height: 80%;
        border-bottom-color: var(--crimson);
        animation-duration: 6s;
        animation-direction: reverse;
      }

      @keyframes spin {
        0% {
          transform: rotate(0deg);
        }
        100% {
          transform: rotate(360deg);
        }
      }
      @keyframes pulse {
        0%,
        100% {
          transform: scale(1);
          box-shadow: 0 0 2rem rgba(233, 195, 65, 0.45);
        }
        50% {
          transform: scale(1.15);
          box-shadow: 0 0 3rem rgba(252, 241, 176, 0.55);
        }
      }

      .status-text .h1 {
        font-family: "Oswald", sans-serif;
        font-size: 1.25rem;
        font-weight: 700;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: var(--text);
        text-shadow: 0 1px 1px rgba(11, 8, 5, 0.6);
        margin: 0;
      }
      .status-text .p {
        font-size: 0.875rem;
        color: var(--text-dim);
        line-height: 1.6;
        margin: 1rem 0 0 0;
      }
    </style>
  </head>
  <body>
    <div class="premium-loading-container">
      <div class="brand-identity">TT1BET</div>

      <div class="sophisticated-loader">
        <div class="orb"></div>
        <div class="ring ring-1"></div>
        <div class="ring ring-2"></div>
      </div>

      <div class="status-text">
        <h1 class="h1">AUTHENTICATING SECURE ACCESS...</h1>
        <p class="p">กำลังพาไปหน้าเข้าสู่ระบบ TT1BET อย่างปลอดภัย <span aria-hidden="true">🔒</span></p>
      </div>
    </div>

    <script define:vars={{ targetUrl }}>
      setTimeout(() => {
        window.location.replace(targetUrl);
      }, 3000);
    </script>
  </body>
</html>
