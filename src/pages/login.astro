---
import { fontStack, usesGoogleFonts } from "../lib/brandProfile";

const targetUrl = "https://yoalink.com/q83b";

// This page has its own <head> and does not import global.css, so it gets
// neither the @theme fallback for --font-sans nor the self-hosted Kanit
// @font-face. Both have to be supplied here or the page renders in the browser
// default while the rest of the site does not — hence the @font-face rules in
// the first <style> block below. Kanit stays declared even on a Google Sans
// brand: it is the Thai fallback inside that stack.
//
// Oswald is the only face left that needs a CDN: the Latin status heading uses
// it and it is not self-hosted. The brand wordmark does NOT — .brand-identity
// draws BMK289 in var(--font-sans), the same face the rest of the site uses, so
// the wordmark here matches the navbar logotype instead of introducing a third
// typeface on a screen that is on display for 1.5 seconds.
//
// The old value asked Google for "Kanit:wght@300;400;600" even though the site
// self-hosts Kanit: a third-party request for weights nothing here draws (300
// and 600 are used zero times), and a query string byte-identical on every
// Kanit brand in the portfolio — the shared signature BRAND_FONT exists to
// break up.
const fontHref = usesGoogleFonts
  ? "https://fonts.googleapis.com/css2?family=Google+Sans:ital,opsz,wght@0,17..18,400..700;1,17..18,400..700&family=Oswald:wght@700&display=swap"
  : "https://fonts.googleapis.com/css2?family=Oswald:wght@700&display=swap";
---

<html lang="th" style={`--font-sans: ${fontStack};`}>
  <head>
    <meta charset="utf-8" />
    <title>BMK289 | เข้าสู่ระบบสล็อตผ่านช่องทางหลัก</title>

    {
      /* Title and description are the docx SUB-PAGES row for เข้าสู่ระบบ,
        carried VERBATIM at the length the brief supplies (119 characters).
        verify-build.mjs SKIPS the description length check on this file — the
        gate sits after `if (!indexable) continue;` and this stub is noindex
        (see the robots meta below) — so there is nothing here to pad up to the
        150–160 window and no reason to reword the brand's own sentence.
        Count CHARACTERS, not bytes: Thai is 3 bytes per character. */
    }
    <meta name="description" content="BMK289 เข้าสู่ระบบผ่านช่องทางหลัก รองรับมือถือและคอมพิวเตอร์ พร้อมเลือกเกม ตรวจสอบโปรโมชั่น และจัดการบัญชีได้อย่างสะดวก" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    {
      /* This page exists only to forward; there is nothing here worth ranking,
        and its source carries the affiliate URL — the one host every brand in
        the group has in common. Keeping it out of the index means that link is
        not sitting in a page Google has stored. Astro's own /line redirect page
        ships noindex for the same reason. */
    }
    <meta name="robots" content="noindex, follow" />

    <meta http-equiv="refresh" content={`1.5;url=${targetUrl}`} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href={fontHref} rel="stylesheet" />

    <style>
      /* Self-hosted Kanit. This page has its own <head> and does not import
         global.css, so the @font-face rules there never reach it — which is why
         it used to pull Kanit from Google instead. Only the weights this page
         actually draws are declared. */
      @font-face {
        font-family: "Kanit";
        font-style: normal;
        font-weight: 400;
        font-display: swap;
        src: url("/fonts/kanit-v17-latin_thai-regular.woff2") format("woff2");
      }
      @font-face {
        font-family: "Kanit";
        font-style: normal;
        font-weight: 700;
        font-display: swap;
        src: url("/fonts/kanit-v17-latin_thai-700.woff2") format("woff2");
      }
    </style>

    <style>
      /* BMK289 is electric blue on near-black navy — neon cyber-casino rather
         than the previous brand's lucky-green: gold coins as the second colour
         (here on the counter-rotating inner ring) and an icy cyan as the third,
         which is how the logo is drawn — a chrome-blue BMK289 wordmark.
         Every variable below is NAMED FOR THE COLOUR IT HOLDS, which previous
         brands stopped doing: this block once declared `--brand-gold` on brands
         with no gold in them and `--brand-red` on a blue one, so the next editor
         reused it by name and shipped the wrong hue. The names arriving here
         were the previous brand's greens, and so were the hues behind them —
         neither belongs to this palette. Rename with the value. */
      :root {
        --ink: #02081c;
        --panel: rgba(8, 21, 47, 0.94);
        --blue: #2b8cff;
        --blue-light: #5eb0ff;
        --blue-deep: #0d2350;
        --blue-darkest: #05132e;
        --gold: #ffcc33;
        --ice: #9dcef0;
        --silver: #e9edf2;
        --text-blue: #dbe9fb;
        --text-blue-dim: #96abcb;
      }

      body {
        margin: 0;
        font-family: var(--font-sans);
        color: var(--text-blue);

        background: radial-gradient(circle at 50% 10%, rgba(43, 140, 255, 0.2) 0%, transparent 55%), radial-gradient(circle at 50% 92%, rgba(13, 35, 80, 0.28) 0%, transparent 55%), var(--ink);
        display: flex;
        min-height: 100vh;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 2rem;
      }

      .premium-loading-container {
        width: 90%;
        max-width: 450px;
        padding: 3.5rem;
        background: var(--panel);
        border: 1px solid rgba(43, 140, 255, 0.4);
        border-radius: 2rem;
        box-shadow:
          0 1rem 3rem rgba(43, 140, 255, 0.2),
          0 0 2rem rgba(13, 35, 80, 0.28);
        text-align: center;
        backdrop-filter: blur(10px);
      }

      .brand-identity {
        font-family: var(--font-sans);
        font-size: 1.5rem;
        font-weight: 700;
        background: linear-gradient(180deg, var(--silver) 0%, var(--silver) 42%, var(--ice) 74%, var(--blue-deep) 100%);
        -webkit-background-clip: text;
        background-clip: text;
        color: transparent;
        letter-spacing: 0.12em;
        margin-bottom: 2rem;
        filter: drop-shadow(0 1px 2px rgba(43, 140, 255, 0.35));
      }

      .sophisticated-loader {
        position: relative;
        width: 100px;
        height: 100px;
        margin: 0 auto 3.5rem auto;
        display: flex;
        align-items: center;
        justify-content: center;
      }

      .orb {
        width: 40px;
        height: 40px;
        background: radial-gradient(circle, var(--blue-light) 0%, var(--blue) 45%, var(--blue-darkest) 100%);
        border-radius: 50%;
        box-shadow: 0 0 2rem rgba(43, 140, 255, 0.35);
        animation: pulse 2s ease-in-out infinite;
      }

      .ring {
        position: absolute;
        border-radius: 50%;
        border: 3px solid rgba(43, 140, 255, 0.2);
        animation: spin linear infinite;
      }

      .ring-1 {
        width: 100%;
        height: 100%;
        border-top-color: var(--blue);
        animation-duration: 4s;
      }

      .ring-2 {
        width: 80%;
        height: 80%;
        border-bottom-color: var(--gold);
        animation-duration: 6s;
        animation-direction: reverse;
      }

      @keyframes spin {
        0% {
          transform: rotate(0deg);
        }
        100% {
          transform: rotate(360deg);
        }
      }
      @keyframes pulse {
        0%,
        100% {
          transform: scale(1);
          box-shadow: 0 0 2rem rgba(43, 140, 255, 0.35);
        }
        50% {
          transform: scale(1.15);
          box-shadow: 0 0 3rem rgba(94, 176, 255, 0.5);
        }
      }

      .status-text .h1 {
        font-family: "Oswald", sans-serif;
        font-size: 1.25rem;
        font-weight: 700;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: var(--text-blue);
        text-shadow: 0 1px 1px rgba(43, 140, 255, 0.25);
        margin: 0;
      }
      .status-text .p {
        font-size: 0.875rem;
        color: var(--text-blue-dim);
        line-height: 1.6;
        margin: 1rem 0 0 0;
      }
    </style>
  </head>
  <body>
    <div class="premium-loading-container">
      <div class="brand-identity">BMK289</div>

      <div class="sophisticated-loader">
        <div class="orb"></div>
        <div class="ring ring-1"></div>
        <div class="ring ring-2"></div>
      </div>

      <div class="status-text">
        <h1 class="h1">AUTHENTICATING SECURE ACCESS...</h1>
        <p class="p">กำลังพาไปหน้าเข้าสู่ระบบ BMK289 อย่างปลอดภัย <span aria-hidden="true">🔒</span></p>
      </div>
    </div>

    <script define:vars={{ targetUrl }}>
      setTimeout(() => {
        window.location.replace(targetUrl);
      }, 3000);
    </script>
  </body>
</html>
