---
import { fontStack } from "../lib/brandProfile";

const targetUrl = "https://tinyurl.com/2ac7ys5h";

// This page has its own <head> and does not import global.css, so it gets
// neither the @theme fallback for --font-sans nor the self-hosted brand font's
// @font-face rules. Both have to be supplied here or the page renders in the
// browser default while the rest of the site does not — hence the @font-face
// block below, which declares BOTH faces the BRAND_FONT rotation can choose
// from. Only the one named by `fontStack` is ever fetched: an @font-face whose
// family nothing draws with is never downloaded, so carrying both costs zero
// bytes and means the next rotation cannot silently break this page.
//
// This brand is on Kanit (BRAND_FONT rotated off google-sans), so `fontStack`
// resolves to the Kanit stack and the two kanit-v17 weights below are the files
// this page actually uses. All four live in public/fonts — the brand font is
// self-hosted on either setting and never comes from a CDN.
//
// Oswald is the one face that genuinely needs the CDN: the Latin status heading
// draws with it and it is not self-hosted, which is all `fontHref` asks for.
// It used to ask for the brand font as well — "Kanit:wght@300;400;600" on a
// Kanit brand, "Google+Sans" on a Google Sans one. Both were wrong: the Kanit
// weights are self-hosted (and 300/600 are drawn zero times), and Google Sans is
// not published on the Google Fonts API at all, so that request could only ever
// fail. Do not put the brand font back into this URL — on either setting.
//
// The brand wordmark needs no third typeface either — .brand-identity draws the
// name in var(--font-sans), the same face the rest of the site uses, so the
// wordmark here matches the navbar logotype on a screen that is on display for
// 1.5 seconds.
const fontHref = "https://fonts.googleapis.com/css2?family=Oswald:wght@700&display=swap";
---

<html lang="th" style={`--font-sans: ${fontStack};`}>
  <head>
    <meta charset="utf-8" />
    <title>PATTAYA168 | สมัครสมาชิกสล็อตลิขสิทธิ์ผ่านช่องทางหลัก</title>

    {
      /* The docx has no SUB-PAGES row for สมัครสมาชิก, so this pair is written
        here rather than quoted: it mirrors the /login row in shape and swaps the
        verb, so it says what THIS page is — registering. An earlier brand opened
        this sentence with "ทางเข้าเล่นและสมัครสมาชิก", which described /ทางเข้า
        instead and gave two routes the same promise.
        Written to the site-wide 150–160 window (153) even though this stub is
        noindex and verify-build.mjs puts that gate after
        `if (!indexable) continue;` — the window is what keeps an invented
        description from growing a clause per rebrand.
        Count CHARACTERS, not bytes: Thai is 3 bytes per character. */
    }
    <meta name="description" content="PATTAYA168 สมัครสมาชิกสล็อตลิขสิทธิ์ผ่านช่องทางหลัก รองรับมือถือ พร้อมเลือกค่ายเกม ตรวจ RTP ตารางจ่าย โปรโมชั่น บัญชี และสถานะธุรกรรมได้สะดวกจากระบบเดียว" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    {
      /* This page exists only to forward; there is nothing here worth ranking,
        and its source carries the affiliate URL — the one host every brand in
        the group has in common. Keeping it out of the index means that link is
        not sitting in a page Google has stored. Astro's own /line redirect page
        ships noindex for the same reason. */
    }
    <meta name="robots" content="noindex, follow" />

    <meta http-equiv="refresh" content={`1.5;url=${targetUrl}`} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href={fontHref} rel="stylesheet" />

    <style>
      /* The self-hosted brand faces, copied from global.css because this page
         has its own <head> and never imports it. Both BRAND_FONT options are
         declared; the stack on <html> decides which one is drawn, and the other
         is never fetched. The unicode-range split is load-bearing on Google
         Sans: latin and thai are two separate files, and without it the browser
         would try to render Thai from the latin subset. */
      @font-face {
        font-family: "Google Sans";
        font-style: normal;
        font-weight: 400 700;
        font-display: swap;
        src: url("/fonts/google-sans-v70-latin-wght.woff2") format("woff2");
        unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
      }
      @font-face {
        font-family: "Google Sans";
        font-style: normal;
        font-weight: 400 700;
        font-display: swap;
        src: url("/fonts/google-sans-v70-thai-wght.woff2") format("woff2");
        unicode-range: U+02D7, U+0303, U+0331, U+0E01-0E5B, U+200C-200D, U+25CC;
      }
      @font-face {
        font-family: "Kanit";
        font-style: normal;
        font-weight: 400;
        font-display: swap;
        src: url("/fonts/kanit-v17-latin_thai-regular.woff2") format("woff2");
      }
      @font-face {
        font-family: "Kanit";
        font-style: normal;
        font-weight: 700;
        font-display: swap;
        src: url("/fonts/kanit-v17-latin_thai-700.woff2") format("woff2");
      }
    </style>

    <style>
      /* This brand is a Thai slot house painted as a tropical bay after dark:
         the identity hue is the turquoise of its own artwork — the logo disc,
         the palm over water ripples, the lit bay behind it — and it runs the top
         of the ramp, from a pale seafoam highlight down to a deep lagoon teal.
         Gold is the genuine second hue, not a tint of the first: it carries the
         sunset and the numbered balls in the mark, and it warms the middle of
         every gradient before the ramp bottoms out in the near-black ocean ink
         the page itself is painted on. There is no button on this screen, so
         nothing needs a separate call-to-action colour.
         The .brand-identity gradient reads the wordmark top to bottom the way
         the artwork reads: white foam through seafoam into turquoise, then down
         through the gold of the sunset into that deep teal.
         Naming a previous brand or quoting its hexes in this comment is what a
         dist/ grep for the old name would find, so the description stays
         generic on purpose.
         Every variable is NAMED FOR THE COLOUR IT HOLDS, which previous brands
         stopped doing: this block once declared `--brand-gold` on brands with no
         gold in them and `--brand-red` on a blue one, so the next editor reused
         it by name and shipped the wrong hue. Hence `--cyan*` for the primary
         ramp, `--gold*` for the second, and `--ink`/`--teal-deep` for the two
         dark surfaces it ends on. Rename with the value. */
      :root {
        --ink: #021c22;
        --panel: rgba(4, 34, 43, 0.94);
        --cyan: #02c4e3;
        --cyan-light: #8ff5ff;
        --cyan-deep: #0c8ba4;
        --gold: #fdac13;
        --gold-deep: #f0820c;
        --teal-deep: #03303c;
        --white: #ffffff;
        --text: #cfeef7;
        --text-dim: #9ac6d6;
      }

      body {
        margin: 0;
        font-family: var(--font-sans);
        color: var(--text);

        background: radial-gradient(circle at 50% 10%, rgba(2, 196, 227, 0.16) 0%, transparent 55%), radial-gradient(circle at 50% 92%, rgba(12, 139, 164, 0.55) 0%, transparent 55%), var(--ink);
        display: flex;
        min-height: 100vh;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 2rem;
      }

      .premium-loading-container {
        width: 90%;
        max-width: 450px;
        padding: 3.5rem;
        background: var(--panel);
        border: 1px solid rgba(2, 196, 227, 0.45);
        border-radius: 2rem;
        box-shadow:
          0 1rem 3rem rgba(2, 196, 227, 0.24),
          0 0 2rem rgba(12, 139, 164, 0.55);
        text-align: center;
        backdrop-filter: blur(10px);
      }

      .brand-identity {
        font-family: var(--font-sans);
        font-size: 1.5rem;
        font-weight: 700;
        background: linear-gradient(180deg, var(--white) 0%, var(--cyan-light) 20%, var(--cyan) 44%, var(--gold) 64%, var(--gold-deep) 80%, var(--teal-deep) 100%);
        -webkit-background-clip: text;
        background-clip: text;
        color: transparent;
        letter-spacing: 0.12em;
        margin-bottom: 2rem;
        filter: drop-shadow(0 1px 2px rgba(2, 28, 34, 0.6));
      }

      .sophisticated-loader {
        position: relative;
        width: 100px;
        height: 100px;
        margin: 0 auto 3.5rem auto;
        display: flex;
        align-items: center;
        justify-content: center;
      }

      .orb {
        width: 40px;
        height: 40px;
        background: radial-gradient(circle, var(--cyan-light) 0%, var(--cyan) 55%, var(--gold-deep) 100%);
        border-radius: 50%;
        box-shadow: 0 0 2rem rgba(2, 196, 227, 0.45);
        animation: pulse 2s ease-in-out infinite;
      }

      .ring {
        position: absolute;
        border-radius: 50%;
        border: 3px solid rgba(2, 196, 227, 0.2);
        animation: spin linear infinite;
      }

      .ring-1 {
        width: 100%;
        height: 100%;
        border-top-color: var(--cyan);
        animation-duration: 4s;
      }

      .ring-2 {
        width: 80%;
        height: 80%;
        border-bottom-color: var(--gold);
        animation-duration: 6s;
        animation-direction: reverse;
      }

      @keyframes spin {
        0% {
          transform: rotate(0deg);
        }
        100% {
          transform: rotate(360deg);
        }
      }
      @keyframes pulse {
        0%,
        100% {
          transform: scale(1);
          box-shadow: 0 0 2rem rgba(2, 196, 227, 0.45);
        }
        50% {
          transform: scale(1.15);
          box-shadow: 0 0 3rem rgba(143, 245, 255, 0.55);
        }
      }

      .status-text .h1 {
        font-family: "Oswald", sans-serif;
        font-size: 1.25rem;
        font-weight: 700;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: var(--text);
        text-shadow: 0 1px 1px rgba(2, 28, 34, 0.6);
        margin: 0;
      }
      .status-text .p {
        font-size: 0.875rem;
        color: var(--text-dim);
        line-height: 1.6;
        margin: 1rem 0 0 0;
      }
    </style>
  </head>
  <body>
    <div class="premium-loading-container">
      <div class="brand-identity">PATTAYA168</div>

      <div class="sophisticated-loader">
        <div class="orb"></div>
        <div class="ring ring-1"></div>
        <div class="ring ring-2"></div>
      </div>

      <div class="status-text">
        <h1 class="h1">CREATING SECURE ACCOUNT SESSION...</h1>
        <p class="p">กำลังพาไปหน้าสมัครสมาชิก PATTAYA168 อย่างปลอดภัย <span aria-hidden="true">🔒</span></p>
      </div>
    </div>

    <script define:vars={{ targetUrl }}>
      setTimeout(() => {
        window.location.replace(targetUrl);
      }, 3000);
    </script>
  </body>
</html>
