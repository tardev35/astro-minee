---
import { fontStack, usesGoogleFonts } from "../lib/brandProfile";

const targetUrl = "https://yoalink.com/q83b";

// This page has its own <head> and does not import global.css, so it gets
// neither the @theme fallback for --font-sans nor the self-hosted Kanit
// @font-face. Both have to be supplied here or the page renders in the browser
// default while the rest of the site does not — hence the @font-face rules in
// the first <style> block below. Kanit stays declared even on a Google Sans
// brand: it is the Thai fallback inside that stack.
//
// This brand is on Kanit (BRAND_FONT flipped from google-sans), so
// usesGoogleFonts is false and fontHref resolves to the Oswald-only URL below.
// Oswald is the only face left that needs a CDN: the Latin status heading uses
// it and it is not self-hosted. The brand wordmark does NOT — .brand-identity
// draws LASVEGAS889 in var(--font-sans), the same face the rest of the site
// uses, so the wordmark here matches the navbar logotype instead of introducing
// a third typeface on a screen that is on display for 1.5 seconds.
//
// The old value asked Google for "Kanit:wght@300;400;600" even though the site
// self-hosts Kanit: a third-party request for weights nothing here draws (300
// and 600 are used zero times), and a query string byte-identical on every
// Kanit brand in the portfolio — the shared signature BRAND_FONT exists to
// break up.
const fontHref = usesGoogleFonts
  ? "https://fonts.googleapis.com/css2?family=Google+Sans:ital,opsz,wght@0,17..18,400..700;1,17..18,400..700&family=Oswald:wght@700&display=swap"
  : "https://fonts.googleapis.com/css2?family=Oswald:wght@700&display=swap";
---

<html lang="th" style={`--font-sans: ${fontStack};`}>
  <head>
    <meta charset="utf-8" />
    <title>LASVEGAS889 | สมัครสมาชิกสล็อตบาคาร่าอย่างสะดวก</title>

    {
      /* The docx SUB-PAGES table has no สมัครสมาชิก row, so unlike /login these
        two strings are written here rather than carried over from the brief.
        They mirror the เข้าสู่ระบบ row in register wording — they say what THIS
        page is: registering. The previous wording opened "ทางเข้าเล่นและสมัคร
        สมาชิก", which described /ทางเข้า instead and gave two routes the same
        promise. This stub is noindex, so verify-build.mjs skips the 150–160
        window on it (the check sits after `if (!indexable) continue;`) — the
        sentence ships at the same unpadded length as /login's, 125 characters,
        rather than being topped up with a clause the brief never wrote.
        Count CHARACTERS, not bytes: Thai is 3 bytes per character. */
    }
    <meta name="description" content="LASVEGAS889 สมัครสมาชิกผ่านช่องทางหลัก รองรับมือถือและคอมพิวเตอร์ พร้อมเลือกสล็อต บาคาร่า ตรวจสอบบัญชี และดูโปรโมชั่นได้สะดวก" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    {
      /* This page exists only to forward; there is nothing here worth ranking,
        and its source carries the affiliate URL — the one host every brand in
        the group has in common. Keeping it out of the index means that link is
        not sitting in a page Google has stored. Astro's own /line redirect page
        ships noindex for the same reason. */
    }
    <meta name="robots" content="noindex, follow" />

    <meta http-equiv="refresh" content={`1.5;url=${targetUrl}`} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href={fontHref} rel="stylesheet" />

    <style>
      /* Self-hosted Kanit. This page has its own <head> and does not import
         global.css, so the @font-face rules there never reach it — which is why
         it used to pull Kanit from Google instead. Only the weights this page
         actually draws are declared. */
      @font-face {
        font-family: "Kanit";
        font-style: normal;
        font-weight: 400;
        font-display: swap;
        src: url("/fonts/kanit-v17-latin_thai-regular.woff2") format("woff2");
      }
      @font-face {
        font-family: "Kanit";
        font-style: normal;
        font-weight: 700;
        font-display: swap;
        src: url("/fonts/kanit-v17-latin_thai-700.woff2") format("woff2");
      }
    </style>

    <style>
      /* LASVEGAS889 is a Las Vegas night strip: deep royal-navy sky, a neon-cyan
         skyline as the accent, rich gold for the wordmark and silver chrome for
         the numerals. The previous brand here was a colder electric blue with an
         icy pale accent — every hue below moved, not just the name.
         Every variable is NAMED FOR THE COLOUR IT HOLDS, which previous brands
         stopped doing: this block once declared `--brand-gold` on brands with no
         gold in them and `--brand-red` on a blue one, so the next editor reused
         it by name and shipped the wrong hue. `--ice` went the same way — it was
         holding this palette's neon cyan, which is not an ice blue — so it is
         `--cyan` now. Rename with the value. */
      :root {
        --ink: #050b24;
        --panel: rgba(11, 23, 64, 0.94);
        --blue: #1f5ce0;
        --blue-light: #4d8dff;
        --blue-deep: #122a63;
        --blue-darkest: #0a1a45;
        --gold: #f2b829;
        --gold-light: #ffdd7a;
        --cyan: #3fdcff;
        --silver: #e8eefb;
        --text-blue: #cddcf7;
        --text-blue-dim: #7f96c4;
      }

      body {
        margin: 0;
        font-family: var(--font-sans);
        color: var(--text-blue);

        background: radial-gradient(circle at 50% 10%, rgba(31, 92, 224, 0.2) 0%, transparent 55%), radial-gradient(circle at 50% 92%, rgba(18, 42, 99, 0.28) 0%, transparent 55%), var(--ink);
        display: flex;
        min-height: 100vh;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 2rem;
      }

      .premium-loading-container {
        width: 90%;
        max-width: 450px;
        padding: 3.5rem;
        background: var(--panel);
        border: 1px solid rgba(31, 92, 224, 0.4);
        border-radius: 2rem;
        box-shadow:
          0 1rem 3rem rgba(31, 92, 224, 0.2),
          0 0 2rem rgba(18, 42, 99, 0.28);
        text-align: center;
        backdrop-filter: blur(10px);
      }

      .brand-identity {
        font-family: var(--font-sans);
        font-size: 1.5rem;
        font-weight: 700;
        background: linear-gradient(180deg, var(--gold-light) 0%, var(--gold) 30%, var(--silver) 58%, var(--cyan) 80%, var(--blue-deep) 100%);
        -webkit-background-clip: text;
        background-clip: text;
        color: transparent;
        letter-spacing: 0.12em;
        margin-bottom: 2rem;
        filter: drop-shadow(0 1px 2px rgba(31, 92, 224, 0.35));
      }

      .sophisticated-loader {
        position: relative;
        width: 100px;
        height: 100px;
        margin: 0 auto 3.5rem auto;
        display: flex;
        align-items: center;
        justify-content: center;
      }

      .orb {
        width: 40px;
        height: 40px;
        background: radial-gradient(circle, var(--blue-light) 0%, var(--blue) 45%, var(--blue-darkest) 100%);
        border-radius: 50%;
        box-shadow: 0 0 2rem rgba(31, 92, 224, 0.35);
        animation: pulse 2s ease-in-out infinite;
      }

      .ring {
        position: absolute;
        border-radius: 50%;
        border: 3px solid rgba(31, 92, 224, 0.2);
        animation: spin linear infinite;
      }

      .ring-1 {
        width: 100%;
        height: 100%;
        border-top-color: var(--blue);
        animation-duration: 4s;
      }

      .ring-2 {
        width: 80%;
        height: 80%;
        border-bottom-color: var(--gold);
        animation-duration: 6s;
        animation-direction: reverse;
      }

      @keyframes spin {
        0% {
          transform: rotate(0deg);
        }
        100% {
          transform: rotate(360deg);
        }
      }
      @keyframes pulse {
        0%,
        100% {
          transform: scale(1);
          box-shadow: 0 0 2rem rgba(31, 92, 224, 0.35);
        }
        50% {
          transform: scale(1.15);
          box-shadow: 0 0 3rem rgba(77, 141, 255, 0.5);
        }
      }

      .status-text .h1 {
        font-family: "Oswald", sans-serif;
        font-size: 1.25rem;
        font-weight: 700;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: var(--text-blue);
        text-shadow: 0 1px 1px rgba(31, 92, 224, 0.25);
        margin: 0;
      }
      .status-text .p {
        font-size: 0.875rem;
        color: var(--text-blue-dim);
        line-height: 1.6;
        margin: 1rem 0 0 0;
      }
    </style>
  </head>
  <body>
    <div class="premium-loading-container">
      <div class="brand-identity">LASVEGAS889</div>

      <div class="sophisticated-loader">
        <div class="orb"></div>
        <div class="ring ring-1"></div>
        <div class="ring ring-2"></div>
      </div>

      <div class="status-text">
        <h1 class="h1">CREATING SECURE ACCOUNT SESSION...</h1>
        <p class="p">กำลังพาไปหน้าสมัครสมาชิก LASVEGAS889 อย่างปลอดภัย <span aria-hidden="true">🔒</span></p>
      </div>
    </div>

    <script define:vars={{ targetUrl }}>
      setTimeout(() => {
        window.location.replace(targetUrl);
      }, 3000);
    </script>
  </body>
</html>
