---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement5.astro";
import { pageGraph } from "../lib/schema";

const pageTitle = "เกี่ยวกับเรา ABM96 เว็บสล็อตรวมเกมหลายแนว โปรทุนน้อยลุ้นรับเครดิต";

// One string, three jobs: MainLayout's <meta name="description">, the WebPage
// node's description, and nothing else. 150–160 CHARACTERS (Thai is 3 bytes per
// character, so a byte count reads ~3x too long). This one is 154.
//
// The docx for this brand has no "เกี่ยวกับเรา" SUB-PAGES row — its Title/Meta
// table covers the other pages only — so the Title and Meta here are written
// from the brief's Main SEO block rather than copied from a row. Nothing to
// reconcile against the docx.
//
// Body copy is deliberately written as "about the site" (who we are, how the
// service is set up, what we commit to) so it does not restate the homepage's
// docx sections, which cover the same topics from the how-to-use angle.
const pageDescription =
  "ABM96 รวมเกมสล็อตหลายแนวไว้ในระบบเดียว หน้านี้เล่าว่าเราเป็นใคร วางระบบสมาชิกและโปรทุนน้อยอย่างไร อธิบายเงื่อนไขเครดิตแบบใด และดูแลบัญชีสมาชิกด้วยแนวทางใด";

const graph = pageGraph(Astro, {
  type: "AboutPage",
  name: pageTitle,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "เกี่ยวกับเรา", path: "/about-us" },
  ],
});
---

<MainLayout title="ABM96 | เกี่ยวกับเราและแนวทางการดูแลสมาชิก" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={pageTitle} as="h1">
    <div>
      <h2 class="mb-6 bg-gradient-to-r from-[#fda3cd] via-[#f1509b] to-[#b5054f] bg-clip-text text-2xl leading-normal font-bold text-transparent">ABM96 เป็นเว็บแบบไหน และในเว็บไซต์นี้มีหน้าอะไรอยู่บ้าง</h2>

      <p class="mb-6 text-left text-base leading-relaxed text-[#f6e3ee]">
        <strong class="text-[#fda3cd]">ABM96</strong> คือแพลตฟอร์มเกมสล็อตออนไลน์ที่รวบรวมเกมหลายรูปแบบไว้ในระบบเดียว ทั้งเกมสล็อตคลาสสิก เกมที่มีฟีเจอร์โบนัส และเกมธีมใหม่ ๆ
        แต่ละเกมมีกติกา รูปแบบการจ่าย และระดับความผันผวนไม่เหมือนกัน สมาชิกจึงเลือกเกมให้ตรงกับความชอบและงบประมาณของตนเอง ตรวจสอบโปรโมชั่น และติดตามเครดิตได้จากหน้าเดียวโดยไม่ต้องสลับระบบไปมา
        สิ่งที่เราให้ความสำคัญเป็นอันดับแรกคือความสะดวกของการเข้าใช้งานและการทำรายการ ทั้งการเข้าสู่ระบบ การเลือกเกม และการตรวจสอบสถานะฝากถอน ทำได้ผ่านเบราว์เซอร์โดยไม่ต้องติดตั้งโปรแกรมเพิ่ม
        เรายังจัดโปรโมชั่นสำหรับผู้เล่นทุนน้อยไว้เป็นหมวดหนึ่งของเว็บไซต์ พร้อมเครดิตเพิ่มเติมตามยอดฝากหรือกิจกรรมที่กำหนด เพื่อให้เริ่มต้นด้วยวงเงินที่ชัดเจนได้จริง และรองรับการใช้งานทั้งบนมือถือ แท็บเล็ต และคอมพิวเตอร์
        เนื้อหาบนเว็บไซต์จัดเป็นหน้าย่อยไม่กี่หน้าเพื่อให้หาสิ่งที่ต้องการได้เร็ว ได้แก่ หน้าแรกที่อธิบายภาพรวมของระบบและเงื่อนไขการใช้งาน หน้าโปรโมชั่นที่แจกแจงสิทธิ์และข้อกำหนดของแต่ละรายการ
        หน้าทดลองเล่นสำหรับศึกษากติกาและฟีเจอร์ก่อนเล่นจริง หน้าทางเข้าสำหรับเข้าใช้งานผ่านช่องทางหลัก และหน้าติดต่อเราสำหรับส่งเรื่องถึงทีมงานโดยตรง
        หน้านี้ไม่ใช่คู่มือการใช้งาน แต่มีไว้บอกว่าเราเป็นใคร ตั้งใจให้บริการแบบไหน และผู้ใช้งานควรคาดหวังอะไรได้จากเว็บไซต์นี้
      </p>

      <h2 class="mt-8 mb-6 bg-gradient-to-r from-[#fda3cd] via-[#f1509b] to-[#b5054f] bg-clip-text text-2xl leading-normal font-bold text-transparent">แนวทางที่ทีมงาน ABM96 ใช้วางระบบและอธิบายเงื่อนไขเครดิต</h2>

      <p class="mb-6 text-left text-base leading-relaxed text-[#f6e3ee]">
        แนวทางที่เรายึดในการวางระบบมีอยู่สามข้อ ข้อแรกคือตัดขั้นตอนที่ไม่จำเป็นออกให้มากที่สุด สมาชิกจึงเข้าสู่ระบบ เลือกเกม ตรวจสอบโปรโมชั่น และติดตามสถานะรายการได้ด้วยตนเองจากหน้าบัญชี
        เห็นสถานะของทุกรายการจากหน้าเดียว และไม่ต้องส่งข้อมูลชุดเดิมซ้ำอีกในรอบถัดไป ก่อนกดยืนยันควรตรวจชื่อบัญชี จำนวนเงิน และรายละเอียดของรายการให้ถูกต้องทุกครั้ง และถ้ารายการยังดำเนินการอยู่ ขอให้รอผลจากระบบก่อนทำรายการซ้ำ
        เพราะรายการที่ส่งซ้อนกันคือสาเหตุที่ทำให้การตรวจสอบย้อนหลังใช้เวลานานขึ้น
        ข้อสองคือให้ข้อมูลของเกมครบพอที่จะเลือกเองได้ ทั้งธีมเกม กติกา ฟีเจอร์โบนัส ระดับความผันผวน รูปแบบการจ่าย และวงเงินเดิมพันต่อรอบ เพื่อให้แต่ละคนจับคู่เกมกับงบประมาณของตนเองได้จริง แทนที่จะเลือกตามอันดับความนิยมเพียงอย่างเดียว
        ข้อสามคือเขียนเงื่อนไขให้อ่านรู้เรื่อง โปรโมชั่นทุนน้อยแต่ละรายการอาจกำหนดยอดฝากเริ่มต้นและเกมที่เข้าร่วมไม่เท่ากัน ส่วนเครดิตเพิ่มเติมก็ต่างกันทั้งจำนวน ระยะเวลา และข้อกำหนดการนำไปใช้ ทุกข้อจะถูกระบุไว้ให้เปรียบเทียบก่อนกดรับเสมอ ไม่ซ่อนไว้ในบรรทัดท้ายสุด
        เช่นเดียวกับเงื่อนไขการถอนที่ผูกกับโปรโมชั่นแต่ละรายการ เราจะระบุไว้ตรงจุดที่ต้องใช้ ไม่ปล่อยให้เข้าใจไปเองว่าใช้ได้กับทุกรายการ
        เราไม่ใช้คำที่รับประกันผลการเล่นและไม่แนะนำสูตรใด เพราะคำอย่างแตกง่ายบอกได้เพียงว่าเกมนั้นมีจังหวะลุ้นรางวัลและฟีเจอร์ที่น่าสนใจ ไม่ใช่การรับประกันผลลัพธ์
        สถิติรอบที่ผ่านมาที่เห็นบนหน้าจอก็เป็นบันทึกของรอบที่จบไปแล้ว ไม่ใช่คำใบ้ของรอบถัดไป สิ่งที่เว็บไซต์ให้ได้คือข้อมูลที่ครบพอให้ตัดสินใจเอง ไม่ใช่คำสัญญาเรื่องผลลัพธ์
      </p>

      <h2 class="mt-8 mb-6 bg-gradient-to-r from-[#fda3cd] via-[#f1509b] to-[#b5054f] bg-clip-text text-2xl leading-normal font-bold text-transparent">สิ่งที่เรารับผิดชอบต่อบัญชีสมาชิกและการติดต่อกลับ</h2>

      <p class="mb-2 text-left text-base leading-relaxed text-[#f6e3ee]">
        เรื่องบัญชีเป็นส่วนที่เราถือว่าสำคัญที่สุด ทีมงานจะไม่ขอรหัสผ่านหรือรหัสยืนยันจากสมาชิกไม่ว่ากรณีใด ไม่ว่าจะผ่านช่องทางส่วนตัวหรือช่องทางสาธารณะ
        ถ้ามีข้อความในลักษณะนั้นส่งมา ให้ถือว่าไม่ได้มาจากเรา และเราแนะนำให้เข้าใช้งานผ่านช่องทางหลักที่ตรวจชื่อเว็บไซต์และการเชื่อมต่อแบบ HTTPS แล้วเท่านั้น
        ไม่ใช่ลิงก์ที่ส่งต่อกันมาพร้อมคำโฆษณา ควรตั้งรหัสผ่านที่คาดเดายาก ใช้อินเทอร์เน็ตที่เสถียรและเลี่ยงเครือข่ายสาธารณะเมื่อต้องทำธุรกรรม และออกจากระบบทุกครั้งเมื่อใช้อุปกรณ์ที่ไม่ใช่ของตนเอง
        ด้านการทำรายการ ควรใช้ข้อมูลที่ตรงกับตอนสมัคร ตรวจยอดคงเหลือและเงื่อนไขเครดิตที่ค้างอยู่ก่อนกดยืนยัน และเก็บรายละเอียดรายการไว้จนกว่าระบบจะแสดงสถานะสำเร็จ
        ด้านการติดต่อ ทีมงานดูแลสมาชิกของ ABM96 รับเรื่องตลอด 24 ชั่วโมงผ่านช่องทางที่เว็บไซต์กำหนด ทั้งเรื่องบัญชี ทางเข้าเล่น โปรโมชั่น เครดิต และสถานะฝากถอน
        การแจ้งชื่อผู้ใช้ เวลาที่ทำรายการ และรายละเอียดของรายการมาให้ครบตั้งแต่ข้อความแรก จะช่วยให้เราตรวจสอบต้นเหตุได้ตรงจุดและเร็วขึ้น โดยไม่ต้องเปิดเผยรหัสผ่านหรือรหัสยืนยันบัญชี
        สุดท้ายเราขอย้ำว่าการเล่นสล็อตควรอยู่ในวงเงินที่ไม่กระทบค่าใช้จ่ายส่วนตัว กำหนดเวลาและงบประมาณให้ชัดเจนก่อนเริ่ม และไม่ควรเพิ่มทุนเพื่อตามยอดที่เสียไป
      </p>
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
