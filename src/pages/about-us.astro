---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement4.astro";
import { pageGraph } from "../lib/schema";

const pageTitle = "เกี่ยวกับเรา MAX56 แพลตฟอร์มสล็อตฝากถอน True Wallet ที่เน้นใช้งานง่ายและตรวจสอบได้";

// One string, three jobs: MainLayout's <meta name="description">, the WebPage
// node's description, and nothing else. 150–160 CHARACTERS (Thai is 3 bytes per
// character, so a byte count reads ~3x too long). This one is 157.
//
// The docx for this brand has no "เกี่ยวกับเรา" SUB-PAGES row — its Title/Meta
// table covers โปรโมชั่น/บทความ/ติดต่อเรา/เข้าสู่ระบบ/ทางเข้าเล่น/ทดลองเล่น only
// — so the Title and Meta here are written from the brief's Main SEO block
// rather than copied from a row. Nothing to reconcile against the docx.
//
// Body copy is deliberately written as "about the site" (who we are, how the
// service is set up, what we commit to) so it does not restate the homepage's
// docx sections, which cover the same topics from the how-to-use angle.
const pageDescription =
  "MAX56 รวมเกมสล็อตหลายรูปแบบไว้ในระบบเดียว หน้านี้เล่าว่าเราเป็นใคร วางระบบฝากถอนผ่าน True Wallet ไว้แบบใด ให้ข้อมูลเกมอย่างไร และดูแลบัญชีสมาชิกด้วยแนวทางไหน";

const graph = pageGraph(Astro, {
  type: "AboutPage",
  name: pageTitle,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "เกี่ยวกับเรา", path: "/about-us" },
  ],
});

// h2 inside the card: crimson → gold, the reverse direction of ContentBox's own
// h1 gradient so the two levels stay visually distinct. Every stop is a palette
// colour that stays legible on the near-black card.
const sectionHeadingClass = "bg-gradient-to-r from-[#ff5a66] via-[#e8202f] to-[#f5c451] bg-clip-text text-2xl leading-normal font-bold text-transparent";
---

<MainLayout title="MAX56 | เกี่ยวกับเราและแนวทางดูแลสมาชิกเกมสล็อต" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={pageTitle} as="h1">
    <div>
      <h2 class={`mb-6 ${sectionHeadingClass}`}>MAX56 เป็นแพลตฟอร์มแบบไหน และในเว็บไซต์นี้มีหน้าอะไรอยู่บ้าง</h2>

      <p class="mb-6 text-left text-base leading-relaxed text-[#f6e4e4]">
        <strong class="text-[#f5c451]">MAX56</strong> คือแพลตฟอร์มเกมสล็อตออนไลน์ที่เน้นความสะดวกด้านการทำธุรกรรมผ่าน True Wallet พร้อมเงื่อนไขไม่มีขั้นต่ำในช่องทางที่กำหนด
        ภายในระบบมีเกมสล็อตหลายรูปแบบรวมอยู่ที่เดียว ทั้งเกมคลาสสิก เกมที่มีฟีเจอร์โบนัส และเกมธีมใหม่ แต่ละเกมมีกติกา รูปแบบการจ่าย และระดับความผันผวนไม่เหมือนกัน
        สมาชิกจึงเลือกเกมให้ตรงกับความสนใจและงบประมาณของตนเอง ตรวจสอบโปรโมชั่น และติดตามสถานะรายการได้จากบัญชีเดียวโดยไม่ต้องสลับระบบไปมา
        สิ่งที่เราให้ความสำคัญเป็นอันดับแรกคือเมนูที่เข้าใจง่ายและขั้นตอนที่เดินตามได้เป็นลำดับ ทั้งการเข้าสู่ระบบ การเลือกเกม และการตรวจสอบสถานะฝากถอน ทำได้ผ่านเบราว์เซอร์โดยไม่ต้องติดตั้งโปรแกรมเพิ่ม
        ระบบรองรับทั้งมือถือ แท็บเล็ต และคอมพิวเตอร์ จึงเปลี่ยนอุปกรณ์ระหว่างวันได้โดยที่หน้าตาของเมนูและตำแหน่งของข้อมูลยังอยู่ที่เดิม
        เนื้อหาบนเว็บไซต์จัดเป็นหน้าย่อยไม่กี่หน้าเพื่อให้หาสิ่งที่ต้องการได้เร็ว ได้แก่ หน้าแรกที่อธิบายภาพรวมของระบบและเงื่อนไขการใช้งาน หน้าโปรโมชั่นที่แจกแจงสิทธิ์และข้อกำหนดของแต่ละรายการ
        หน้าทดลองเล่นสำหรับศึกษากติกาและฟีเจอร์ก่อนเล่นจริง หน้าทางเข้าสำหรับเข้าใช้งานผ่านช่องทางหลัก และหน้าติดต่อเราสำหรับส่งเรื่องถึงทีมงานโดยตรง
        หน้านี้ไม่ใช่คู่มือการใช้งาน แต่มีไว้บอกว่าเราเป็นใคร ตั้งใจให้บริการแบบไหน และผู้ใช้งานควรคาดหวังอะไรได้จากเว็บไซต์นี้
      </p>

      <h2 class={`mt-8 mb-6 ${sectionHeadingClass}`}>แนวทางที่ทีมงาน MAX56 ใช้จัดหมวดเกมและเขียนเงื่อนไข</h2>

      <p class="mb-6 text-left text-base leading-relaxed text-[#f6e4e4]">
        แนวทางที่เรายึดในการวางระบบมีอยู่สามข้อ ข้อแรกคือตัดขั้นตอนที่ไม่จำเป็นออกให้มากที่สุด สมาชิกจึงเข้าสู่ระบบ เลือกเกม ตรวจสอบโปรโมชั่น และติดตามยอดฝาก ถอน รวมถึงสถานะธุรกรรมได้ด้วยตนเองจากหน้าบัญชี
        เห็นสถานะของทุกรายการจากหน้าเดียว และไม่ต้องส่งข้อมูลชุดเดิมซ้ำอีกในรอบถัดไป ก่อนกดยืนยันควรตรวจข้อมูล Wallet จำนวนเงิน และรายละเอียดบัญชีให้ตรงกันทุกครั้ง และถ้ารายการยังอยู่ระหว่างดำเนินการ ขอให้รอผลจากระบบก่อนส่งรายการซ้ำ
        เพราะรายการที่ส่งซ้อนกันคือสาเหตุที่ทำให้การตรวจสอบย้อนหลังใช้เวลานานขึ้น ควรเก็บข้อมูลอ้างอิง เวลา และจำนวนเงินไว้จนกว่าธุรกรรมจะเสร็จสมบูรณ์
        ข้อสองคือให้ข้อมูลของเกมครบพอที่จะเลือกเองได้ ทั้งธีมเกม กติกา ฟีเจอร์โบนัส อัตราจ่าย ระดับความผันผวน และวงเงินเดิมพันต่อรอบ เพื่อให้แต่ละคนจับคู่เกมกับงบประมาณของตนเองได้จริง แทนที่จะเลือกตามคำโฆษณาเพียงอย่างเดียว
        ข้อสามคือเขียนเงื่อนไขให้อ่านรู้เรื่อง เงื่อนไขไม่มีขั้นต่ำใช้ได้เฉพาะช่องทางหรือรายการที่กำหนด ไม่ใช่ทุกช่องทางเสมอไป ส่วนโปรโมชั่นแต่ละรายการอาจกำหนดยอดเริ่มต้นและเกมที่เข้าร่วมไม่เท่ากัน
        สิทธิ์ที่ได้รับก็ต่างกันทั้งจำนวน ระยะเวลา และข้อกำหนดการนำไปใช้ ทุกข้อจะถูกระบุไว้ให้เปรียบเทียบก่อนกดรับเสมอ ไม่ซ่อนไว้ในบรรทัดท้ายสุด
        เราไม่ใช้คำที่รับประกันผลการเล่นและไม่แนะนำสูตรใด เพราะคำว่าแตกง่ายบอกได้เพียงว่าเกมนั้นมีฟีเจอร์และจังหวะลุ้นรางวัลที่น่าสนใจ ไม่ใช่การรับประกันว่าจะได้ผลลัพธ์ตามคาดทุกครั้ง
        เช่นเดียวกับคำว่าจ่ายจริงทุกยอด ที่ไม่ควรตีความว่าเป็นการรับประกันการถอนในทุกกรณี เพราะการถอนยังขึ้นอยู่กับสถานะบัญชี เงื่อนไขโปรโมชั่น และการตรวจสอบของระบบ
        สถิติรอบที่ผ่านมาที่เห็นบนหน้าจอก็เป็นบันทึกของรอบที่จบไปแล้ว ไม่ใช่คำใบ้ของรอบถัดไป สิ่งที่เว็บไซต์ให้ได้คือข้อมูลที่ครบพอให้ตัดสินใจเอง ไม่ใช่คำสัญญาเรื่องผลลัพธ์
      </p>

      <h2 class={`mt-8 mb-6 ${sectionHeadingClass}`}>ความปลอดภัยของบัญชีและการดูแลสมาชิกโดยทีมงาน MAX56</h2>

      <p class="mb-2 text-left text-base leading-relaxed text-[#f6e4e4]">
        เรื่องบัญชีเป็นส่วนที่เราถือว่าสำคัญที่สุด และความปลอดภัยเริ่มจากการใช้งานช่องทางหลักที่เว็บไซต์กำหนดเป็นหลัก ไม่ใช่ลิงก์ที่ส่งต่อกันมาพร้อมคำโฆษณา ควรตรวจชื่อเว็บไซต์และการเชื่อมต่อแบบ HTTPS ทุกครั้งก่อนกรอกข้อมูล
        ทีมงานจะไม่ขอรหัสผ่านหรือรหัสยืนยันจากสมาชิกไม่ว่ากรณีใด ไม่ว่าจะผ่านช่องทางส่วนตัวหรือช่องทางสาธารณะ ถ้ามีข้อความในลักษณะนั้นส่งมา ให้ถือว่าไม่ได้มาจากเรา
        ควรตั้งรหัสผ่านที่คาดเดายากและไม่ซ้ำกับบริการอื่น ใช้อินเทอร์เน็ตที่เสถียรและเลี่ยงเครือข่ายสาธารณะเมื่อต้องจัดการข้อมูลบัญชี และออกจากระบบทุกครั้งเมื่อใช้อุปกรณ์ร่วมกับผู้อื่น
        ด้านการทำรายการ ควรใช้ข้อมูล True Wallet ที่ตรงกับตอนสมัคร ตรวจยอดคงเหลือและเงื่อนไขที่ค้างอยู่ก่อนกดยืนยัน และเก็บรายละเอียดรายการไว้จนกว่าระบบจะแสดงสถานะสำเร็จ
        ด้านการติดต่อ ทีมงานดูแลสมาชิกของ MAX56 รับเรื่องผ่านช่องทางบริการที่เว็บไซต์ระบุ ทั้งเรื่องบัญชี ทางเข้าเล่น โปรโมชั่น และสถานะฝากถอน
        การแจ้งชื่อผู้ใช้ เวลาที่ทำรายการ และรายละเอียดของปัญหามาให้ครบตั้งแต่ข้อความแรก จะช่วยให้เราตรวจสอบต้นเหตุได้ตรงจุดและเร็วขึ้น โดยไม่ต้องเปิดเผยรหัสผ่านหรือรหัสยืนยันบัญชี
        สุดท้ายเราขอย้ำว่าเกมสล็อตมีผลลัพธ์ไม่แน่นอนและไม่ควรมองเป็นแหล่งรายได้ประจำ ควรเล่นด้วยเงินที่รับความสูญเสียได้ กำหนดเวลาและงบประมาณให้ชัดเจนก่อนเริ่ม และไม่ควรเพิ่มทุนเพื่อตามยอดที่เสียไป
      </p>
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
