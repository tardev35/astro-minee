---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement5.astro";
import { pageGraph } from "../lib/schema";

const pageTitle = "เกี่ยวกับเรา PG699 คาสิโนเกมยอดนิยม ฝากถอนออโต้ จ่ายไวทุกยอด";

// One string, three jobs: MainLayout's <meta name="description">, the WebPage
// node's description, and nothing else. 150–160 CHARACTERS (Thai is 3 bytes per
// character, so a byte count reads ~3x too long). This one is 154.
//
// The docx for this brand has no "เกี่ยวกับเรา" SUB-PAGES row — its Title/Meta
// table covers the other pages only — so the Title and Meta here are written
// from the brief's Main SEO block rather than copied from a row. Nothing to
// reconcile against the docx.
//
// Body copy is deliberately written as "about the site" (who we are, how the
// service is set up, what we commit to) so it does not restate the homepage's
// docx sections, which cover the same topics from the how-to-use angle.
const pageDescription =
  "PG699 คาสิโนออนไลน์รวมเกมสล็อต บาคาร่า เกมไพ่ และคาสิโนสด หน้านี้อธิบายว่าเราเป็นใคร วางระบบฝากถอนออโต้ไว้อย่างไร และดูแลบัญชีของสมาชิกด้วยแนวทางแบบใดบ้าง";

const graph = pageGraph(Astro, {
  type: "AboutPage",
  name: pageTitle,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "เกี่ยวกับเรา", path: "/about-us" },
  ],
});
---

<MainLayout title="PG699 | เกี่ยวกับเราและแนวทางดูแลสมาชิกคาสิโนออนไลน์" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={pageTitle} as="h1">
    <div>
      <h2 class="mb-6 bg-gradient-to-r from-[#ffe9a8] via-[#f5c518] to-[#b8770a] bg-clip-text text-2xl leading-normal font-bold text-transparent">PG699 เป็นเว็บแบบไหน และในเว็บไซต์นี้มีหน้าอะไรอยู่บ้าง</h2>

      <p class="mb-6 text-left text-base leading-relaxed text-[#dbe6ff]">
        <strong class="text-[#f5c518]">PG699</strong> คือแพลตฟอร์มคาสิโนออนไลน์ที่รวบรวมเกมหลายประเภทไว้ในระบบเดียว ทั้งเกมสล็อต บาคาร่า เกมไพ่ และคาสิโนสดที่ถ่ายทอดจากโต๊ะจริง
        แต่ละเกมมีกติกา รูปแบบการเดิมพัน และระดับความเสี่ยงต่างกัน สมาชิกจึงเลือกเกมตามความสนใจ ตรวจสอบโปรโมชั่น และจัดการบัญชีของตนเองได้จากหน้าเดียวโดยไม่ต้องสลับระบบไปมา
        จุดที่เราให้ความสำคัญเป็นอันดับแรกคือความเร็วของการฝากและการถอน รายการทั้งหมดเดินผ่านระบบออโต้ที่ลดขั้นตอนการทำรายการลง และเมนูทั้งหมดออกแบบให้เปิดใช้งานได้ทั้งบนมือถือ แท็บเล็ต และคอมพิวเตอร์โดยไม่ต้องติดตั้งโปรแกรมเพิ่ม
        เนื้อหาบนเว็บไซต์จัดเป็นหน้าย่อยไม่กี่หน้าเพื่อให้หาสิ่งที่ต้องการได้เร็ว ได้แก่ หน้าแรกที่อธิบายภาพรวมของระบบและหมวดเกม หน้าโปรโมชั่นที่แจกแจงสิทธิ์และเงื่อนไขของแต่ละรายการ
        หน้าทดลองเล่นสำหรับเปิดดูเกมก่อนตัดสินใจ หน้าทางเข้าสำหรับเข้าใช้งานผ่านช่องทางหลัก และหน้าติดต่อเราสำหรับส่งเรื่องถึงทีมบริการสมาชิกโดยตรง
        หน้านี้ไม่ใช่คู่มือการใช้งาน แต่มีไว้บอกว่าเราเป็นใคร ตั้งใจให้บริการแบบไหน และผู้ใช้งานควรคาดหวังอะไรได้จากเว็บไซต์นี้
      </p>

      <h2 class="mt-8 mb-6 bg-gradient-to-r from-[#ffe9a8] via-[#f5c518] to-[#b8770a] bg-clip-text text-2xl leading-normal font-bold text-transparent">แนวทางที่ทีมงาน PG699 ใช้วางระบบและให้ข้อมูลกับสมาชิก</h2>

      <p class="mb-6 text-left text-base leading-relaxed text-[#dbe6ff]">
        แนวทางที่เรายึดในการวางระบบมีอยู่สามข้อ ข้อแรกคือตัดขั้นตอนที่ไม่จำเป็นออกให้มากที่สุด ระบบฝากถอนออโต้จึงเปิดให้สมาชิกทำรายการผ่านหน้าบัญชีได้โดยตรง เห็นสถานะของทุกรายการจากหน้าเดียว
        และไม่ต้องส่งข้อมูลชุดเดิมซ้ำอีกในรอบถัดไป ก่อนกดยืนยันควรตรวจชื่อบัญชี จำนวนเงิน และข้อมูลที่เกี่ยวข้องให้ถูกต้องทุกครั้ง และถ้ารายการยังดำเนินการอยู่ ขอให้รอผลจากระบบก่อนส่งคำขอใหม่
        เพราะรายการที่ส่งซ้อนกันคือสาเหตุที่ทำให้การตรวจสอบย้อนหลังใช้เวลานานขึ้น
        ข้อสองคือให้ข้อมูลของเกมครบพอที่จะเลือกเองได้ ทั้งประเภทเกม กติกา รูปแบบการเดิมพัน อัตราจ่าย ระดับความผันผวน และวงเงินต่อรอบ เพื่อให้แต่ละคนจับคู่เกมกับงบประมาณและสไตล์ของตนเองได้จริง แทนที่จะเลือกตามอันดับความนิยมเพียงอย่างเดียว
        ข้อสามคือเขียนเงื่อนไขให้อ่านรู้เรื่อง ทั้งยอดฝากขั้นต่ำของโปรโมชั่น จำนวนเทิร์น เกมที่ร่วมรายการ และเพดานถอน จะถูกระบุไว้ให้ตรวจก่อนกดรับเสมอ ไม่ซ่อนไว้ในบรรทัดท้ายสุด
        เราไม่ใช้คำที่รับประกันผลการเล่นและไม่แนะนำสูตรใด เพราะคำอย่างแตกง่ายหรือจ่ายไวทุกยอดบอกได้เพียงว่าเกมนั้นมีจังหวะลุ้นรางวัลและฟีเจอร์ที่น่าสนใจ ไม่ใช่การรับประกันผลลัพธ์
        สถิติรอบที่ผ่านมาที่เห็นบนหน้าจอก็เป็นบันทึกของรอบที่จบไปแล้ว ไม่ใช่คำใบ้ของรอบถัดไป สิ่งที่เว็บไซต์ให้ได้คือข้อมูลที่ครบพอให้ตัดสินใจเอง ไม่ใช่คำสัญญาเรื่องผลลัพธ์
      </p>

      <h2 class="mt-8 mb-6 bg-gradient-to-r from-[#ffe9a8] via-[#f5c518] to-[#b8770a] bg-clip-text text-2xl leading-normal font-bold text-transparent">สิ่งที่เรารับผิดชอบต่อบัญชีสมาชิกและการติดต่อกลับ</h2>

      <p class="mb-2 text-left text-base leading-relaxed text-[#dbe6ff]">
        เรื่องบัญชีเป็นส่วนที่เราถือว่าสำคัญที่สุด ทีมงานจะไม่ขอรหัสผ่านหรือรหัสยืนยันจากสมาชิกไม่ว่ากรณีใด ไม่ว่าจะผ่านช่องทางส่วนตัวหรือช่องทางสาธารณะ
        ถ้ามีข้อความในลักษณะนั้นส่งมา ให้ถือว่าไม่ได้มาจากเรา และเราแนะนำให้เข้าใช้งานผ่านช่องทางหลักที่ตรวจชื่อเว็บไซต์และการเชื่อมต่อแบบ HTTPS แล้วเท่านั้น
        ไม่ใช่ลิงก์ที่ส่งต่อกันมาพร้อมคำโฆษณา ควรตั้งรหัสผ่านที่คาดเดายาก เลี่ยงเครือข่ายสาธารณะเมื่อต้องจัดการธุรกรรมทางการเงิน และออกจากระบบทุกครั้งเมื่อใช้อุปกรณ์ที่ไม่ใช่ของตนเอง
        ด้านการทำรายการ ควรใช้ข้อมูลที่ตรงกับตอนสมัคร ตรวจยอดคงเหลือและเงื่อนไขโปรโมชั่นที่ค้างอยู่ก่อนกดยืนยัน และเก็บรายละเอียดรายการไว้จนกว่าระบบจะแสดงสถานะสำเร็จ
        ด้านการติดต่อ ทีมบริการสมาชิกของ PG699 รับเรื่องตลอด 24 ชั่วโมงผ่านช่องทางที่เว็บไซต์ระบุ ทั้งเรื่องบัญชี ทางเข้า โปรโมชั่น และสถานะฝากถอน
        การแจ้งชื่อผู้ใช้ เวลาที่ทำรายการ และรายละเอียดของรายการมาให้ครบตั้งแต่ข้อความแรก จะช่วยให้เราตรวจสอบต้นเหตุได้ตรงจุดและเร็วขึ้น โดยไม่ต้องเปิดเผยรหัสผ่านหรือรหัสยืนยันบัญชี
        สุดท้ายเราขอย้ำว่าการเดิมพันควรอยู่ในวงเงินที่ไม่กระทบค่าใช้จ่ายส่วนตัว และไม่ควรเพิ่มทุนเพื่อตามยอดที่เสียไป
      </p>
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
