---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement5.astro";
import { pageGraph } from "../lib/schema";

const pageTitle = "เกี่ยวกับเรา BUGGY888 เว็บรวมเกมคาสิโนออนไลน์ ระบบฝากถอนออโต้";

// One string, three jobs: MainLayout's <meta name="description">, the WebPage
// node's description, and nothing else. 150–160 CHARACTERS (Thai is 3 bytes per
// character, so a byte count reads ~3x too long). This one is 156.
//
// The docx for this brand has no "เกี่ยวกับเรา" section — its headings cover the
// homepage only — so the Title and Meta here are written from the brief's Main
// SEO block rather than copied from a SUB-PAGES row. Nothing to reconcile
// against the docx.
//
// Body copy is deliberately written as "about the site" (who we are, how the
// service is set up, what we commit to) so it does not restate the homepage's
// docx sections, which cover the same topics from the how-to-use angle.
const pageDescription =
  "BUGGY888 แนะนำแนวทางการให้บริการคาสิโนออนไลน์ ทั้งการรวมเกม ระบบฝากถอนออโต้ และการดูแลสมาชิก พร้อมข้อมูลพื้นฐานที่ควรอ่านทำความเข้าใจก่อนเริ่มใช้งานทุกครั้ง";

const graph = pageGraph(Astro, {
  type: "AboutPage",
  name: pageTitle,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "เกี่ยวกับเรา", path: "/about-us" },
  ],
});
---

<MainLayout title="BUGGY888 | เกี่ยวกับเราและแนวทางการให้บริการสมาชิก" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={pageTitle} as="h1">
    <div>
      <h2 class="mb-6 bg-gradient-to-r from-[#fff3cf] via-[#ffd233] to-[#e0a81c] bg-clip-text text-2xl leading-normal font-bold text-transparent">BUGGY888 คือคาสิโนแบบไหน และหน้าเว็บไซต์นี้มีอะไรอยู่บ้าง</h2>

      <p class="mb-6 text-left text-base leading-relaxed text-[#f7e2c4]">
        <strong class="text-[#ffd233]">BUGGY888</strong> เป็นแพลตฟอร์มคาสิโนออนไลน์ที่รวบรวมเกมหลายประเภทไว้ในระบบเดียว ทั้งสล็อต บาคาร่า รูเล็ต เกมไพ่ และคาสิโนสดที่มีดีลเลอร์ถ่ายทอดจากโต๊ะจริง
        ตั้งแต่การสมัคร การเลือกเกมตามกติกาและรูปแบบการเดิมพัน ไปจนถึงการฝากถอนด้วยระบบออโต้จากบัญชีเดียว โดยรองรับเงื่อนไขไม่มีขั้นต่ำในช่องทางที่กำหนด และใช้งานได้ทั้งมือถือ แท็บเล็ต และคอมพิวเตอร์
        เนื้อหาบนเว็บไซต์ถูกจัดเป็นหน้าย่อยไม่กี่หน้าเพื่อให้หาสิ่งที่ต้องการได้เร็ว ได้แก่ หน้าแรกที่อธิบายภาพรวมของระบบ หน้าโปรโมชั่นที่แจกแจงสิทธิ์และเงื่อนไขของแต่ละรายการ
        หน้าทดลองเล่นสำหรับเปิดดูเกมก่อนตัดสินใจ หน้าทางเข้าสำหรับเข้าใช้งานผ่านช่องทางหลัก และหน้าติดต่อเราสำหรับส่งเรื่องถึงทีมงานโดยตรง
        หน้านี้ไม่ได้เป็นคู่มือการใช้งาน แต่มีไว้บอกว่าเราเป็นใคร ตั้งใจให้บริการแบบไหน และผู้ใช้งานควรคาดหวังอะไรได้จากเว็บไซต์นี้
      </p>

      <h2 class="mt-8 mb-6 bg-gradient-to-r from-[#fff3cf] via-[#ffd233] to-[#e0a81c] bg-clip-text text-2xl leading-normal font-bold text-transparent">แนวทางการวางระบบและการให้ข้อมูลของทีมงาน BUGGY888</h2>

      <p class="mb-6 text-left text-base leading-relaxed text-[#f7e2c4]">
        แนวทางที่เรายึดในการวางระบบมีอยู่สามข้อ ข้อแรกคือลดขั้นตอนที่ไม่จำเป็นออก ระบบออโต้จึงเปิดให้สมาชิกฝากและถอนผ่านหน้าบัญชีได้ด้วยตนเอง และตรวจสถานะรายการได้จากหน้าเดียว แทนที่จะต้องส่งข้อมูลเดิมซ้ำหลายรอบ
        ควรตรวจสอบชื่อบัญชี ยอดเงิน และสถานะรายการก่อนยืนยันทุกครั้ง และหากรายการยังอยู่ระหว่างดำเนินการ ควรรอผลจากระบบแทนการส่งรายการซ้ำ เพื่อให้ตรวจย้อนหลังได้ตรงรายการ
        ข้อสองคือให้ข้อมูลของเกมครบพอให้เลือกเองได้ ทั้งประเภทของเกม กติกาของแต่ละโต๊ะ รูปแบบการเดิมพัน อัตราจ่าย ระดับความเสี่ยง และวงเงินเดิมพันต่อรอบ เพื่อให้แต่ละคนเลือกเกมที่เข้ากับงบประมาณและสไตล์การเล่นของตนเองได้จริง
        ข้อสามคือเขียนเงื่อนไขให้อ่านได้จริง ทั้งช่องทางที่รองรับเงื่อนไขไม่มีขั้นต่ำ จำนวนเทิร์นของโปรโมชั่น เกมที่ร่วมรายการ และเพดานถอน จะถูกระบุไว้ให้ตรวจก่อนกดรับเสมอ
        เราไม่ใช้คำที่รับประกันผลการเล่นและไม่แนะนำสูตรใด เพราะผลลัพธ์ของเกมคาสิโนแต่ละรอบไม่สามารถรับประกันได้ และสถิติรอบที่ผ่านมาที่เห็นบนหน้าจอเป็นบันทึกของรอบที่จบไปแล้ว ไม่ใช่คำใบ้ของรอบถัดไป
        สิ่งที่เว็บไซต์ให้ได้คือข้อมูลที่ครบพอให้ตัดสินใจเอง ไม่ใช่คำสัญญาเรื่องผลลัพธ์
      </p>

      <h2 class="mt-8 mb-6 bg-gradient-to-r from-[#fff3cf] via-[#ffd233] to-[#e0a81c] bg-clip-text text-2xl leading-normal font-bold text-transparent">สิ่งที่เรารับผิดชอบต่อบัญชีสมาชิกและการติดต่อกลับ</h2>

      <p class="mb-2 text-left text-base leading-relaxed text-[#f7e2c4]">
        เรื่องบัญชีเป็นส่วนที่เราถือว่าสำคัญที่สุด ทีมงานจะไม่ขอรหัสผ่านหรือรหัส OTP จากสมาชิกไม่ว่ากรณีใด ผ่านช่องทางส่วนตัวหรือช่องทางสาธารณะก็ตาม
        ถ้ามีข้อความในลักษณะนั้นส่งมา ให้ถือว่าไม่ได้มาจากเรา และเราแนะนำให้เข้าใช้งานผ่านช่องทางเข้าหลักที่ตรวจชื่อเว็บไซต์และการเชื่อมต่อแบบ HTTPS แล้วเท่านั้น
        ไม่ใช่ลิงก์ที่ส่งต่อกันมาพร้อมคำโฆษณา ควรตั้งรหัสผ่านที่คาดเดายาก หลีกเลี่ยงการทำธุรกรรมผ่านเครือข่ายสาธารณะ และออกจากระบบทุกครั้งเมื่อใช้อุปกรณ์ร่วมกับผู้อื่น
        ด้านการทำรายการ ควรใช้บัญชีที่ตรงกับข้อมูลตอนสมัคร ตรวจสอบยอดเงินและข้อมูลบัญชีก่อนกดยืนยัน และเก็บหลักฐานรายการไว้จนกว่าระบบจะแสดงสถานะสำเร็จ
        ด้านการติดต่อ ทีมงานดูแลสมาชิกของ BUGGY888 รับเรื่องตลอด 24 ชั่วโมงผ่านช่องทางที่เว็บไซต์กำหนด ทั้งเรื่องบัญชี ทางเข้าเล่น โปรโมชั่น และสถานะฝากถอน
        การแจ้งชื่อผู้ใช้ เวลาที่ทำรายการ และยอดเงินของรายการมาให้ครบตั้งแต่ข้อความแรก จะช่วยให้เราตรวจสอบต้นเหตุได้ตรงจุดและเร็วขึ้น โดยไม่ต้องเปิดเผยรหัสผ่านหรือข้อมูลยืนยันส่วนตัว
        สุดท้ายเราขอย้ำว่าการเดิมพันควรอยู่ในวงเงินที่ไม่กระทบค่าใช้จ่ายส่วนตัว และไม่ควรเพิ่มทุนเพื่อตามยอดที่เสียไป
      </p>
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
