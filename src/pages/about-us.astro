---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/AnnouncementCyber.astro";
import { pageGraph } from "../lib/schema";

const pageTitle = "เกี่ยวกับ RUAYRUAY888 แพลตฟอร์มที่รวมค่ายเกมพนัน โปรโมชั่น และช่องทาง Wallet ไว้ในระบบเดียว";

// One string, two jobs: MainLayout's <meta name="description"> and the WebPage
// node's description. The docx SUB-PAGES block has no row for /about-us, so this
// sentence is written here and held to the 150–160 CHARACTER window that
// tools/verify-build.mjs enforces on any description an agent writes (Thai is 3
// bytes per character, so a byte count reads ~3x too long). This one is 158.
//
// Body copy is deliberately "about the site" — what the platform is, how far a
// member's own use of it goes, and the limits we do not claim past — so it does
// not restate the home page's docx sections. The three H2s below are this page's
// own and deliberately do not echo any docx heading; every claim in them traces
// back to the brief's own cautious wording (รวมเกมจากหลายค่ายไว้ในระบบเดียว
// พร้อมโปรโมชั่นหลายรูปแบบและช่องทาง Wallet, เปรียบเทียบกติกา ฟีเจอร์ อัตราจ่าย
// และวงเงินก่อนเลือก, โปรแรงควรดูเงื่อนไขจริงมากกว่าจำนวนโบนัส, ตรวจข้อมูล
// กระเป๋าเงินและรอให้รายการเดิมอัปเดตสถานะ, จ่ายดีไม่ได้แปลว่าให้ผลตอบแทนสูง
// ทุกครั้ง, เก็บเวลา จำนวนเงิน และเลขอ้างอิงไว้ตรวจย้อนหลัง, กำหนดวงเงินก่อนเล่น
// และไม่ตามคืนยอดเสีย). Nothing here promises a payout, a win rate or a
// processing time, and nothing claims a licence, an award, a founding date, a
// user count or an office — the brief states none of those and neither does this
// page.
//
// <Announcement /> is bare: AnnouncementCyber's default message is this brand's
// copy, so the ticker matches index.astro without a second string here. The
// variant rotated off AnnouncementHuay, the outgoing brand's pick, per the
// brand spec.
//
// RUAYRUAY888 is a CASINO brand, so the two lottery routes an earlier lottery
// client switched on are parked in src/pages-disabled/ this round and the page
// list below names neither. It is prose, not links — this page renders no anchor
// at all — but a sentence pointing at a route that does not exist is the same
// defect as a dead link, so keep the list in step if that toggle ever moves.
//
// The brief names Wallet as a channel but no bank and no payment brand, so
// neither does this page: money language stays "ระบบของเว็บไซต์" and "ช่องทางที่
// เว็บไซต์กำหนด".
const pageDescription = "หน้านี้อธิบายว่า RUAYRUAY888 เป็นแพลตฟอร์มพนันออนไลน์แบบใด รวมค่ายเกม โปรโมชั่น และช่องทาง Wallet ไว้อย่างไร สมาชิกใช้งานได้ถึงขั้นไหน และเราไม่รับปากเรื่องใด";

const graph = pageGraph(Astro, {
  type: "AboutPage",
  name: pageTitle,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "เกี่ยวกับเรา", path: "/about-us" },
  ],
});

// h2 inside the card: white → hot pink → deep pink, i.e. the brand's contrast
// note read into its accent, where ContentBox's own h1 gradient opens on soft
// pink-white and runs pink-white → hot pink → mid-deep pink. The two levels stay
// visually distinct without either one repeating the other's opening stop, and
// the soft pink stays on the h1 — a second pink-led heading on this rose-black
// card is where the hierarchy would collapse. No gold: that was the outgoing
// brand's secondary.
const sectionHeadingClass = "bg-gradient-to-r from-[#ffffff] via-[#f874a1] to-[#8f1140] bg-clip-text text-2xl leading-normal font-bold text-transparent";
---

<MainLayout title="RUAYRUAY888 | เกี่ยวกับเรา และการรวมค่ายเกมพนันไว้ในระบบเดียว" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={pageTitle} as="h1">
    <div>
      <h2 class={`mb-6 ${sectionHeadingClass}`}>RUAYRUAY888 คือแพลตฟอร์มแบบไหน และเว็บไซต์นี้มีหน้าอะไรบ้าง</h2>

      <p class="mb-6 text-left text-base leading-relaxed text-[#f6dde8]">
        <strong class="text-[#fdb4d4]">RUAYRUAY888</strong> เป็นแพลตฟอร์มพนันออนไลน์ที่รวบรวมเกมจากหลายค่ายไว้ในระบบเดียว ทั้งสล็อต บาคาร่า คาสิโนสด และเกมรูปแบบอื่นจากผู้ให้บริการหลายราย ตามรายการที่เว็บไซต์กำหนดในแต่ละช่วง
        พร้อมโปรโมชั่นหลายรูปแบบและช่องทาง Wallet สำหรับจัดการธุรกรรมผ่านมือถือ หน้าที่ของเรามีอย่างเดียว คือจัดวางรายการเกม โปรโมชั่น และข้อมูลบัญชีให้อยู่ในที่เดียวกัน แทนที่ผู้ใช้จะต้องเปิดหลายหน้าเพื่อดูว่าค่ายไหนเปิดเกมอะไร
        เทียบอัตราจ่าย แล้วไปตามเงื่อนไขโปรโมชั่นจากอีกแหล่งหนึ่ง เมื่อทุกอย่างอยู่ที่จุดเดียว การสลับหน้าไปมาและขั้นตอนที่ไม่จำเป็นจะลดลงเอง แต่การรวมไว้ที่เดียวไม่ได้แปลว่าทุกค่ายใช้กติกาชุดเดียวกัน
        เกมแต่ละประเภทยังมีกติกา ฟีเจอร์ อัตราจ่าย ความผันผวน และวงเงินของตัวเองอยู่ ระบบจึงแยกหมวดตามประเภทเกมและผู้ให้บริการไว้ให้ชัด การแยกหมวดไม่ได้มีไว้เพื่อความสวยงามของหน้าเว็บ
        แต่มีไว้ให้เทียบชื่อค่าย ประเภทเกม ฟีเจอร์ อัตราจ่าย และวงเงินได้ง่ายขึ้นก่อนตัดสินใจ ส่วนนี้เป็นเจตนาของเราโดยตรง คืออยากให้เลือกจากข้อมูลของเกมที่เข้าใจเงื่อนไขจริง มากกว่าเลือกจากคำโปรโมตที่เห็นผ่านตา
        เพราะค่ายที่ได้รับความนิยมไม่จำเป็นต้องเหมาะกับรูปแบบการเล่นของทุกคน ระบบเปิดผ่านเบราว์เซอร์ได้ทั้งบนมือถือและคอมพิวเตอร์โดยไม่ต้องติดตั้งโปรแกรมเพิ่ม ตำแหน่งเมนูและลำดับของข้อมูลจึงอยู่ที่เดิมเมื่อสลับอุปกรณ์ระหว่างวัน
        เนื้อหาบนเว็บไซต์แบ่งเป็นหน้าย่อยไม่กี่หน้าเพื่อให้หาสิ่งที่ต้องการได้เร็ว ได้แก่ หน้าแรกที่อธิบายภาพรวมของระบบและเงื่อนไขการใช้งาน หน้าโปรโมชั่นที่รวมสิทธิพิเศษของแต่ละรายการไว้ด้วยกัน
        หน้าทดลองเล่นสำหรับศึกษากติกา อัตราจ่าย และรูปแบบการเดิมพันก่อนเล่นจริง หน้าทางเข้าสำหรับเข้าใช้งานผ่านช่องทางหลัก หน้าเกี่ยวกับเราซึ่งเป็นหน้านี้ หน้าติดต่อเราสำหรับส่งเรื่องถึงทีมงานโดยตรง
        และหน้าเงื่อนไขการใช้งานกับนโยบายความเป็นส่วนตัวที่ระบุขอบเขตของเว็บไซต์นี้ไว้เป็นลายลักษณ์อักษร หน้านี้ไม่ใช่คู่มือการใช้งาน แต่มีไว้บอกว่าเราเป็นใคร ตั้งใจให้บริการแบบไหน
        และผู้ใช้งานควรคาดหวังอะไรได้จากเว็บไซต์นี้
      </p>

      <h2 class={`mt-8 mb-6 ${sectionHeadingClass}`}>สมาชิกใช้งาน RUAYRUAY888 ได้ตั้งแต่ขั้นไหนจนถึงขั้นไหน</h2>

      <p class="mb-6 text-left text-base leading-relaxed text-[#f6dde8]">
        เส้นทางการใช้งานบน RUAYRUAY888 เดินเป็นลำดับเดียวกันเสมอ เริ่มจากการเปิดบัญชีตามเงื่อนไขที่เว็บไซต์กำหนด ซึ่งเราระบุไว้ตรงไปตรงมาว่าขั้นเปิดบัญชีเป็นคนละเรื่องกับขั้นที่ตามมา
        เงื่อนไขด้านการฝากเงิน การรับสิทธิ์โปรโมชั่น และการถอนเป็นคนละชุดกัน และควรอ่านแยกกันตั้งแต่ต้นแทนที่จะเหมารวมเป็นชุดเดียว จากนั้นจึงเลือกว่ารอบนี้จะเล่นเกมของค่ายใด
        โดยเปรียบเทียบกติกา ฟีเจอร์ อัตราจ่าย ความผันผวน และวงเงินขั้นต่ำต่อรอบให้ครบก่อน โดยเฉพาะผู้ที่สลับเล่นหลายค่ายในวันเดียว จุดที่เราย้ำเสมอคือเกมแต่ละประเภทคิดผลและจ่ายคนละอัตรา
        สล็อต บาคาร่า และคาสิโนสดมีจังหวะการเดิมพันและความเสี่ยงคนละแบบ การเลือกประเภทเกมโดยยังไม่ได้อ่านตารางจ่ายจึงทำให้ผลที่ได้ไม่ตรงกับที่เข้าใจไว้ตั้งแต่แรก หากเพิ่งเริ่มควรเลือกเกมที่เงื่อนไขชัดเจนและตั้งยอดต่อรอบไม่สูงเกินงบ
        แล้วค่อยขยับไปรูปแบบที่ซับซ้อนขึ้นเมื่อเข้าใจวิธีนับผลแล้ว ขั้นก่อนกดยืนยันคือขั้นที่เราอยากให้ใช้เวลามากที่สุด เพราะเป็นขั้นเดียวที่ยังเปลี่ยนใจได้โดยไม่มีต้นทุน
        ควรไล่ดูชื่อเกม รูปแบบการเดิมพัน จำนวนเงินต่อรอบ และยอดรวมที่ตั้งใจใช้ทั้งวันอีกครั้ง พร้อมตรวจว่าสิทธิ์โปรโมชั่นที่ถืออยู่ผูกกับเกมนั้นหรือไม่ เพราะบางรายการกำหนดเกมที่ร่วมรายการและระยะเวลาไว้เฉพาะ
        ฝั่งบัญชีเดินคนละแบบกับฝั่งเกม คือรวมข้อมูลบัญชี สิทธิ์โปรโมชั่นที่ถืออยู่ ยอดคงเหลือ ประวัติธุรกรรม และสถานะของรายการที่ยังดำเนินการอยู่ไว้ในระบบเดียว
        ระบบที่ใช้งานง่ายช่วยลดขั้นตอนตรงนี้ให้สั้นลง แต่ไม่ได้ลดหน้าที่ในการตรวจของผู้ใช้งาน การฝากและถอนผ่าน Wallet ช่วยให้จัดการผ่านมือถือได้สะดวกขึ้น
        แต่ก่อนยืนยันทุกครั้งควรตรวจข้อมูลกระเป๋าเงิน จำนวนเงิน และบัญชีสมาชิกให้ตรงกัน แล้วรอให้รายการเดิมอัปเดตสถานะก่อนทำธุรกรรมใหม่เสมอ การกดส่งซ้ำระหว่างนั้นไม่ได้ทำให้เร็วขึ้น
        แต่เพิ่มโอกาสเกิดรายการซ้ำหรือยอดคลาดเคลื่อน และทำให้การไล่ตรวจย้อนหลังยากขึ้นสำหรับทั้งสองฝ่าย หากพบรายการล่าช้า ควรเก็บเวลา จำนวนเงิน และเลขอ้างอิงไว้จนกว่าระบบจะอัปเดตผล เพื่อใช้ตรวจสอบย้อนหลังเมื่อพบข้อมูลไม่ตรงกัน
        ส่วนสิทธิ์โปรโมชั่นให้ตรวจจากหน้าบัญชีของตัวเองก่อนเริ่มทุกครั้ง ทั้งชื่อโปรโมชั่น จำนวนเครดิต และเงื่อนไขที่เกี่ยวข้อง หากมีหลายโปรพร้อมกันควรดูว่าใช้ร่วมกันได้หรือไม่
        และควรเก็บรายละเอียดสิทธิ์ไว้จนกว่าการใช้งานหรือการถอนจะเสร็จสมบูรณ์
      </p>

      <h2 class={`mt-8 mb-6 ${sectionHeadingClass}`}>สิ่งที่เราไม่รับปาก และขอบเขตที่อยากให้ผู้ใช้งานตั้งไว้ก่อนเริ่ม</h2>

      <p class="mb-2 text-left text-base leading-relaxed text-[#f6dde8]">
        เรื่องที่เราพูดตรงไปตรงมาตั้งแต่ต้นคือ ถ้อยคำที่ใช้กันทั่วไปในวงการนี้เป็นข้อความทางการตลาด ไม่ใช่หลักฐานในตัวเอง คำว่าจ่ายดีไม่ได้หมายความว่าเกมจะให้ผลตอบแทนสูงทุกครั้ง
        เพราะเกมแต่ละประเภทมีอัตราจ่าย ความผันผวน และเงื่อนไขแตกต่างกัน จึงควรดูตารางจ่าย กติกา และข้อมูลจากผู้ให้บริการก่อนเริ่ม แล้วเลือกเกมจากข้อมูลมากกว่าคำโปรโมต
        และไม่ควรถือว่าอัตราจ่ายสูงหมายถึงมีโอกาสชนะมากขึ้น เช่นเดียวกับคำว่าโปรแรง ซึ่งโดยทั่วไปสื่อถึงจำนวนเครดิตหรือสิทธิ์ที่เว็บไซต์กำหนดในช่วงนั้น
        แต่เงื่อนไขจริงต่างกันตามรายการ ทั้งยอดขั้นต่ำ เกมที่ร่วมรายการ ระยะเวลา และเงื่อนไขการถอน จึงควรอ่านให้ครบก่อนกดรับสิทธิ์ทุกครั้ง
        ในทางเดียวกัน โปรโมชั่นที่ดูคุ้มไม่จำเป็นต้องเป็นโปรที่ให้เครดิตมากที่สุด ควรเปรียบเทียบยอดรับโบนัส ยอดขั้นต่ำ เกมที่ร่วม ระยะเวลา และข้อกำหนดการถอนร่วมกัน
        เพราะโปรที่เหมาะกับงบและรูปแบบการเล่นของตัวเองอาจคุ้มกว่าข้อเสนอที่ให้เครดิตสูงแต่มีข้อจำกัดมาก และไม่ควรเป็นโปรที่บังคับให้เพิ่มยอดเกินแผนที่ตั้งไว้ตั้งแต่แรก
        ผลของเกมพนันมีความไม่แน่นอนอยู่เสมอ รอบก่อนหน้าไม่ได้กำหนดรอบถัดไป และการนับสถิติย้อนหลังก็ไม่ได้ทำให้คาดเดาได้แม่นขึ้น เราจึงไม่รับประกันผล รายได้ หรือกำไรไม่ว่ากรณีใด
        ด้วยเหตุนี้เราจึงขอให้ผู้ใช้งานกำหนดวงเงินต่อวันหรือต่อรอบไว้ล่วงหน้า ใช้เฉพาะเงินที่ไม่กระทบค่าใช้จ่ายจำเป็น หยุดเมื่อถึงวงเงินที่ตั้งไว้ และไม่เพิ่มเงินเพื่อตามคืนยอดที่เสียไปแล้ว
        ด้านบัญชี ขอให้เข้าใช้งานผ่านช่องทางหลักที่เว็บไซต์กำหนด ไม่ใช่ลิงก์ที่ส่งต่อกันมาพร้อมคำโฆษณา ตรวจชื่อเว็บไซต์และการเชื่อมต่อแบบ HTTPS ทุกครั้งก่อนกรอกข้อมูล
        ตั้งรหัสผ่านที่คาดเดายากและไม่ซ้ำกับบริการอื่น และออกจากระบบเมื่อใช้อุปกรณ์ร่วมกับผู้อื่น ทีมงานจะไม่ขอรหัสผ่าน รหัส OTP หรือรหัสยืนยันจากสมาชิกไม่ว่ากรณีใดและไม่ว่าผ่านช่องทางใด
        หากมีข้อความในลักษณะนั้นส่งมา ให้ถือว่าไม่ได้มาจากเรา และเมื่อพบรายการที่ผิดปกติ ให้เก็บเวลา จำนวนเงิน และเลขอ้างอิงของรายการไว้แจ้งทีมงานตั้งแต่ข้อความแรก
        เพื่อให้ตรวจสอบต้นเหตุได้ตรงจุดโดยไม่ต้องเปิดเผยข้อมูลลับของบัญชีแก่ผู้ใด
      </p>
