---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement3.astro";
import { pageGraph } from "../lib/schema";

const pageTitle = "เกี่ยวกับเรา DUCK36 เว็บสล็อตออนไลน์ค่ายดัง ระบบออโต้ฝากถอนผ่าน True Wallet";

// One string, three jobs: MainLayout's <meta name="description">, the WebPage
// node's description, and nothing else. 150–160 CHARACTERS (Thai is 3 bytes per
// character, so a byte count reads ~3x too long). This one is 159.
//
// The docx for this brand has no "เกี่ยวกับเรา" section — its SUB-PAGES block
// lists only โปรโมชั่น / บทความ / ติดต่อเรา / เข้าสู่ระบบ / ทางเข้าเล่น / ทดลองเล่น —
// so the Title and Meta here are written from the brief's Main SEO block rather
// than copied from a SUB-PAGES row. Nothing to reconcile against the docx.
//
// Body copy is deliberately written as "about the site" (who we are, how the
// service is set up, what we commit to) so it does not restate the homepage's
// docx sections, which cover the same topics from the how-to-use angle.
const pageDescription =
  "DUCK36 เว็บสล็อตออนไลน์ค่ายดังที่รวมเกมและระบบออโต้ไว้ในที่เดียว ทำความรู้จักแนวทางการให้บริการ การดูแลสมาชิก และมาตรฐานการใช้งานของทีมงาน รวมถึงสิ่งที่ควรทราบ";

const graph = pageGraph(Astro, {
  type: "AboutPage",
  name: pageTitle,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "เกี่ยวกับเรา", path: "/about-us" },
  ],
});
---

<MainLayout title="DUCK36 | เกี่ยวกับเราและแนวทางการให้บริการ" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={pageTitle} as="h1">
    <div>
      <h2 class="mb-6 bg-gradient-to-r from-[#fff8e6] via-[#ffd76a] to-[#f5b70a] bg-clip-text text-2xl leading-normal font-bold text-transparent">DUCK36 คือเว็บแบบไหน และหน้าเว็บไซต์นี้มีอะไรอยู่บ้าง</h2>

      <p class="mb-6 text-left text-base leading-relaxed text-[#efe3c9]">
        <strong class="text-[#ffd76a]">DUCK36</strong> เป็นแพลตฟอร์มสล็อตออนไลน์ที่รวบรวมเกมจากค่ายยอดนิยมไว้ในระบบเดียว ตั้งแต่การสมัคร การเลือกเกมตามธีมหรือรูปแบบฟีเจอร์
        ไปจนถึงการฝากถอนผ่าน True Wallet ด้วยระบบออโต้จากบัญชีเดียว รองรับทั้งมือถือ แท็บเล็ต และคอมพิวเตอร์ เนื้อหาบนเว็บไซต์ถูกจัดเป็นหน้าย่อยไม่กี่หน้าเพื่อให้หาสิ่งที่ต้องการได้เร็ว
        ได้แก่ หน้าแรกที่อธิบายภาพรวมของระบบ หน้าโปรโมชั่นที่แจกแจงสิทธิ์และเงื่อนไขของแต่ละรายการ หน้าทดลองเล่นสำหรับเปิดดูเกมของแต่ละค่ายก่อนตัดสินใจ
        หน้าทางเข้าสำหรับเข้าใช้งานผ่านช่องทางหลัก และหน้าติดต่อเราสำหรับส่งเรื่องถึงทีมงานโดยตรง
        หน้านี้ไม่ได้เป็นคู่มือการใช้งาน แต่มีไว้บอกว่าเราเป็นใคร ตั้งใจให้บริการแบบไหน และผู้ใช้งานควรคาดหวังอะไรได้จากเว็บไซต์นี้
      </p>

      <h2 class="mt-8 mb-6 bg-gradient-to-r from-[#fff8e6] via-[#ffd76a] to-[#f5b70a] bg-clip-text text-2xl leading-normal font-bold text-transparent">แนวทางการวางระบบและการให้ข้อมูลของทีมงาน DUCK36</h2>

      <p class="mb-6 text-left text-base leading-relaxed text-[#efe3c9]">
        แนวทางที่เรายึดในการวางระบบมีอยู่สามข้อ ข้อแรกคือลดขั้นตอนที่ไม่จำเป็นออก ระบบออโต้จึงเปิดให้สมาชิกทำรายการฝากถอนและตรวจสถานะได้จากหน้าบัญชีของตนเอง แทนที่จะต้องส่งข้อมูลเดิมซ้ำหลายรอบ
        และหากรายการยังอยู่ระหว่างดำเนินการ ควรรอผลจากระบบแทนการส่งซ้ำ เพื่อให้ตรวจย้อนหลังได้ตรงรายการ
        ข้อสองคือให้ข้อมูลของเกมครบพอให้เลือกเองได้ ทั้งค่ายผู้พัฒนา ธีมและรูปแบบการเล่น ฟีเจอร์โบนัสภายในเกม ความผันผวน และวงเงินเดิมพันต่อรอบ เพื่อให้แต่ละคนเลือกเกมที่เข้ากับงบประมาณของตนเองได้จริง
        ข้อสามคือเขียนเงื่อนไขให้อ่านได้จริง ทั้งยอดฝากขั้นต่ำของโปรโมชั่น จำนวนเทิร์น เกมที่ร่วมรายการ และเพดานถอน จะถูกระบุไว้ให้ตรวจก่อนกดรับเสมอ
        เราไม่ใช้คำที่รับประกันผลการเล่นและไม่แนะนำสูตรใด เพราะผลของสล็อตแต่ละรอบไม่สามารถรับประกันได้ และสถิติรอบที่ผ่านมาที่เห็นบนหน้าจอเป็นบันทึกของรอบที่จบไปแล้ว ไม่ใช่คำใบ้ของรอบถัดไป
        สิ่งที่เว็บไซต์ให้ได้คือข้อมูลที่ครบพอให้ตัดสินใจเอง ไม่ใช่คำสัญญาเรื่องผลลัพธ์
      </p>

      <h2 class="mt-8 mb-6 bg-gradient-to-r from-[#fff8e6] via-[#ffd76a] to-[#f5b70a] bg-clip-text text-2xl leading-normal font-bold text-transparent">สิ่งที่เรารับผิดชอบต่อบัญชีสมาชิกและการติดต่อกลับ</h2>

      <p class="mb-2 text-left text-base leading-relaxed text-[#efe3c9]">
        เรื่องบัญชีเป็นส่วนที่เราถือว่าสำคัญที่สุด ทีมงานจะไม่ขอรหัสผ่านหรือรหัส OTP จากสมาชิกไม่ว่ากรณีใด ผ่านช่องทางส่วนตัวหรือช่องทางสาธารณะก็ตาม
        ถ้ามีข้อความในลักษณะนั้นส่งมา ให้ถือว่าไม่ได้มาจากเรา และเราแนะนำให้เข้าใช้งานผ่านช่องทางเข้าหลักที่ตรวจชื่อเว็บไซต์และการเชื่อมต่อแบบ HTTPS แล้วเท่านั้น
        ไม่ใช่ลิงก์ที่ส่งต่อกันมาพร้อมคำโฆษณา และควรออกจากระบบทุกครั้งเมื่อใช้อุปกรณ์ร่วมกับผู้อื่น
        ด้านการทำรายการ ควรใช้บัญชี True Wallet ที่ตรงกับข้อมูลตอนสมัคร ตรวจสอบยอดเงินและข้อมูลบัญชีก่อนกดยืนยัน และเก็บหลักฐานรายการไว้จนกว่าระบบจะแสดงสถานะสำเร็จ
        ด้านการติดต่อ ทีมงานดูแลสมาชิกของ DUCK36 รับเรื่องตลอด 24 ชั่วโมงผ่านช่องทางที่เว็บไซต์ระบุ ทั้งเรื่องบัญชี ทางเข้าเล่น โปรโมชั่น และสถานะฝากถอน
        การแจ้งชื่อผู้ใช้ เวลาที่ทำรายการ และยอดเงินของรายการมาให้ครบตั้งแต่ข้อความแรก จะช่วยให้เราตรวจสอบต้นเหตุได้ตรงจุดและเร็วขึ้น โดยไม่ต้องเปิดเผยรหัสผ่านหรือข้อมูลยืนยันส่วนตัว
        สุดท้ายเราขอย้ำว่าการเดิมพันควรอยู่ในวงเงินที่ไม่กระทบค่าใช้จ่ายส่วนตัว และไม่ควรเพิ่มทุนเพื่อตามยอดที่เสียไป
      </p>
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
