---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement5.astro";
import { pageGraph } from "../lib/schema";

const pageTitle = "เกี่ยวกับ DIAMOND789 แพลตฟอร์มสล็อตที่รวมเกมหลายค่ายและระบบบัญชีไว้ในที่เดียว";

// One string, two jobs: MainLayout's <meta name="description"> and the WebPage
// node's description. This page has no docx SUB-PAGES row, so the sentence is
// written here and length-checked against tools/verify-build.mjs, which wants
// 150–160 CHARACTERS (Thai is 3 bytes per character, so a byte count reads ~3x
// too long). This one is 159 — one sentence saying what the page is for, not
// the page's outline packed into a tag.
//
// Body copy is deliberately written as "about the site" — what the platform is,
// what a member does with it end to end, and the limits we ask people to hold —
// so it does not restate the home page's docx sections, which cover the same
// ground as guidance on picking a provider from real data, weighing a low-budget
// promotion against its withdrawal terms, what "ไม่มีขั้นต่ำ" does and does not
// cover, how to verify a licensed title, and reading RTP with volatility. Two
// URLs repeating one set of H2s is the failure mode this page exists to avoid,
// so the three H2s below are this page's own and deliberately do not echo any
// docx heading.
//
// <Announcement /> is bare: Announcement5's default message is this brand's
// copy, so the ticker matches index.astro without a second string here.
const pageDescription = "หน้านี้อธิบายว่า DIAMOND789 เป็นแพลตฟอร์มสล็อตออนไลน์แบบใด ให้บริการด้วยแนวทางแบบไหน สมาชิกใช้งานระบบเลือกเกมและธุรกรรมได้ถึงขั้นไหน และเรื่องใดที่เราไม่รับปาก";

const graph = pageGraph(Astro, {
  type: "AboutPage",
  name: pageTitle,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "เกี่ยวกับเรา", path: "/about-us" },
  ],
});

// h2 inside the card: bright pink → hot pink → magenta, which climbs in
// saturation where ContentBox's own h1 gradient starts on chrome silver
// (#e8e8ef → #ff5cb8 → #f30d8c) and falls, so the two heading levels stay
// visually distinct without either one repeating the other's opening stop. The
// silver stays on the h1, because a second silver heading on a near-black card
// is where the hierarchy would collapse.
const sectionHeadingClass = "bg-gradient-to-r from-[#ff5cb8] via-[#f30d8c] to-[#b312ac] bg-clip-text text-2xl leading-normal font-bold text-transparent";
---

<MainLayout title="DIAMOND789 | เกี่ยวกับเราและแนวทางให้บริการสล็อตออนไลน์" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={pageTitle} as="h1">
    <div>
      <h2 class={`mb-6 ${sectionHeadingClass}`}>DIAMOND789 คือแพลตฟอร์มแบบไหน และเว็บไซต์นี้ประกอบด้วยหน้าอะไรบ้าง</h2>

      <p class="mb-6 text-left text-base leading-relaxed text-[#f8e3f0]">
        <strong class="text-[#ff5cb8]">DIAMOND789</strong> เป็นแพลตฟอร์มสล็อตออนไลน์ที่ทำหน้าที่เดียว คือรวมเกมสล็อตจากหลายค่ายและระบบจัดการบัญชีไว้ในที่เดียวผ่านหน้าจอชุดเดียว แทนที่จะต้องเปิดหลายเว็บไซต์
        สมัครหลายบัญชี และย้ายเครดิตไปมาระหว่างระบบ ทุกหมวดเกมและทุกรายการอยู่ในชุดหน้าจอเดียวกัน จะไล่ดูเกมตามค่ายผู้ให้บริการ ตามธีมและรูปแบบฟีเจอร์โบนัส หรือตามระดับเดิมพันต่อสปินก่อนตัดสินใจก็ได้ ระบบสมาชิก
        โปรโมชั่น ประวัติการเล่น และสถานะธุรกรรมก็อยู่ที่เดียวกันนั้น ระบบเปิดผ่านเบราว์เซอร์ได้ทั้งบนมือถือและคอมพิวเตอร์โดยไม่ต้องติดตั้งโปรแกรมเพิ่ม ตำแหน่งเมนูและลำดับของข้อมูลจึงอยู่ที่เดิมเมื่อเปลี่ยนอุปกรณ์ระหว่างวัน
        สิ่งที่เราให้ความสำคัญไม่ใช่จำนวนเกมในระบบ แต่เป็นการทำให้ข้อมูลที่ต้องใช้ตัดสินใจอยู่ใกล้ปุ่มที่ต้องกด ทั้งชื่อค่ายเกมที่ดูแลเกมนั้น ค่า RTP ที่ผู้ให้บริการระบุไว้ ระดับความผันผวนของเกม ตารางจ่ายและเงื่อนไขของฟีเจอร์โบนัส
        เดิมพันขั้นต่ำและสูงสุดต่อสปิน ขั้นตอนฝากถอนตามช่องทางที่เว็บไซต์กำหนด เงื่อนไขของโปรโมชั่นที่กำลังเปิดอยู่ และสถานะล่าสุดของบัญชี เพราะข้อมูลเหล่านี้ต่างกันในแต่ละเกมและปรับได้ตามรอบ
        การวางไว้ให้เห็นก่อนกดยืนยันจึงช่วยลดการเลือกเกมผิดจากที่ตั้งใจ เข้าใจเงื่อนไขโบนัสหรือยอดเทิร์นคลาดเคลื่อน หรือกดยืนยันรายการฝากถอนซ้ำโดยไม่จำเป็น ซึ่งเป็นความผิดพลาดที่พบบ่อยที่สุดของผู้เล่นใหม่
        เนื้อหาบนเว็บไซต์แบ่งเป็นหน้าย่อยไม่กี่หน้าเพื่อให้หาสิ่งที่ต้องการได้เร็ว ได้แก่ หน้าแรกที่อธิบายภาพรวมของระบบและเงื่อนไขการใช้งาน หน้าโปรโมชั่นที่แจกแจงสิทธิ์และข้อกำหนดของแต่ละรายการ
        หน้าทดลองเล่นสำหรับศึกษาฟีเจอร์และจังหวะของเกมก่อนเล่นด้วยเงินจริง หน้าทางเข้าสำหรับเข้าใช้งานผ่านช่องทางหลัก และหน้าติดต่อเราสำหรับส่งเรื่องถึงทีมงานโดยตรง หน้านี้ไม่ใช่คู่มือการใช้งาน
        แต่มีไว้บอกว่าเราเป็นใคร ตั้งใจให้บริการแบบไหน และผู้ใช้งานควรคาดหวังอะไรได้จากเว็บไซต์นี้
      </p>

      <h2 class={`mt-8 mb-6 ${sectionHeadingClass}`}>สมาชิกใช้งาน DIAMOND789 ได้ตั้งแต่ขั้นไหนจนถึงขั้นไหน</h2>

      <p class="mb-6 text-left text-base leading-relaxed text-[#f8e3f0]">
        เส้นทางการใช้งานบน DIAMOND789 เดินเป็นลำดับเดียวกันเสมอ เริ่มจากเข้าสู่ระบบผ่านช่องทางหลัก แล้วเลือกว่ารอบนี้จะลงเกมไหน ซึ่งแต่ละเกมมีเดิมพันต่อสปินขั้นต่ำ ขั้นสูงสุด ค่า RTP ที่ผู้ให้บริการระบุ
        และระดับความผันผวนไม่เหมือนกัน ตัวเกมเองจบผลในไม่กี่วินาทีและกดสปินรอบใหม่ได้ทันที จุดนี้จึงเป็นจุดที่วงเงินหมดเร็วที่สุดถ้าไม่ได้ตั้งไว้ล่วงหน้า ก่อนลงเดิมพันจริงจึงควรอ่านตารางจ่ายของเกมนั้น
        เงื่อนไขของฟีเจอร์โบนัสและฟรีสปิน รวมถึงจำนวนไลน์หรือรูปแบบการจ่ายให้จบก่อน นี่คือขั้นที่เราอยากให้ใช้เวลามากที่สุด ส่วนฝั่งการเงินเดินคนละแบบ คือผูกกับระบบฝากถอนตามช่องทางที่เว็บไซต์กำหนด
        และจัดการได้จากหน้าบัญชีโดยตรง คำว่าไม่มีขั้นต่ำที่เห็นในหน้าโปรโมชั่นอาจหมายถึงยอดฝาก ยอดถอน หรือขั้นต่ำของตัวเกม ซึ่งไม่จำเป็นต้องเป็นเงื่อนไขเดียวกัน จึงควรอ่านของแต่ละช่องทางแยกกันก่อนทำรายการ
        ก่อนยืนยันควรตรวจช่องทางที่เลือก จำนวนเงิน ข้อมูลบัญชีรับเงิน และเงื่อนไขโปรโมชั่นให้ตรงกันทั้งสี่อย่าง เพราะเมื่อยืนยันแล้วรายการจะเข้าสู่ระบบทันที เมื่อทำรายการแล้ว ทุกอย่างที่เกิดขึ้นกับเครดิตจะไปปรากฏที่หน้าบัญชี
        ทั้งยอดคงเหลือ ประวัติการฝากถอน ประวัติการเล่น สถานะของรายการที่ยังดำเนินการอยู่ และผลของรอบที่จบไปแล้ว เราแนะนำให้ยึดข้อมูลจากหน้าบัญชีเป็นหลักเสมอ
        และเก็บเวลา จำนวนเงิน กับเลขอ้างอิงของรายการไว้จนกว่าสถานะจะปิดรอบ มากกว่าการยึดภาพหน้าจอหรือข้อความที่ส่งต่อกันมาจากแหล่งที่ตรวจสอบต้นทางไม่ได้ และถ้ารายการหนึ่งยังค้างอยู่ ขอให้รอสถานะเดิมจบก่อนเสมอ
        การกดส่งคำขอซ้ำระหว่างนั้นไม่ได้ทำให้เร็วขึ้น แต่ทำให้การไล่ตรวจย้อนหลังยากขึ้นสำหรับทั้งสองฝ่าย
      </p>

      <h2 class={`mt-8 mb-6 ${sectionHeadingClass}`}>สิ่งที่เราไม่รับปาก และขอบเขตที่อยากให้ผู้ใช้งานตั้งไว้ก่อนเริ่ม</h2>

      <p class="mb-2 text-left text-base leading-relaxed text-[#f8e3f0]">
        เรื่องที่เราพูดตรงไปตรงมาตั้งแต่ต้นคือ ผลของสล็อตแต่ละสปินตัดสินจากระบบสุ่มของเกมในรอบนั้นและไม่มีใครรับประกันได้ ถ้อยคำอย่างแตกดีหรือโปรทุนน้อยใช้สื่อถึงลักษณะการจ่ายของเกมและรูปแบบของรายการส่งเสริมการขายเท่านั้น
        ไม่ได้เป็นการรับประกันว่าจะชนะมากขึ้น ไม่ได้เป็นหลักฐานว่าจะได้ผลลัพธ์ตามคาดในรอบใด และไม่ได้เป็นคำมั่นเรื่องระยะเวลาของธุรกรรมทุกกรณี ในทำนองเดียวกัน คำว่าเกมลิขสิทธิ์แท้ควรตรวจจากข้อมูลผู้ให้บริการที่ระบบแสดง
        ไม่ใช่จากชื่อเกมหรือข้อความโฆษณา สิ่งที่ควรใช้ประเมินคือชื่อค่ายเกมที่ระบบแสดง ความชัดเจนของตารางจ่ายและกติกาของเกม ค่า RTP ที่ผู้ให้บริการระบุ ประวัติรายการที่ระบบแสดง และช่องทางติดต่อที่ใช้ได้จริง
        สิ่งที่ควรดูควบคู่กันคือระดับความผันผวนของเกมที่เลือก เพราะเกมความผันผวนสูงจ่ายไม่บ่อยแต่จ่ายก้อนใหญ่กว่า ส่วนเกมความผันผวนต่ำจ่ายถี่กว่าในจำนวนที่เล็กกว่า ทั้งสองแบบไม่ได้ดีกว่ากัน
        แต่เหมาะกับงบคนละขนาดและความอดทนคนละแบบ ด้วยเหตุนี้เราจึงขอให้ผู้ใช้งานกำหนดวงเงินและระยะเวลาไว้ล่วงหน้า ใช้เฉพาะเงินที่ไม่กระทบค่าใช้จ่ายจำเป็น และไม่เพิ่มยอดต่อสปินเพื่อหวังตามคืนยอดที่เสียไปแล้ว
        หรือเพิ่มตามอารมณ์ระหว่างเล่น เพราะแต่ละสปินเป็นผลลัพธ์ที่ไม่ขึ้นกับสปินก่อนหน้า ด้านบัญชี ขอให้เข้าใช้งานผ่านช่องทางหลักที่เว็บไซต์กำหนด ไม่ใช่ลิงก์ที่ส่งต่อกันมาพร้อมคำโฆษณา
        ตรวจชื่อเว็บไซต์และการเชื่อมต่อแบบ HTTPS ทุกครั้งก่อนกรอกข้อมูล ตั้งรหัสผ่านที่คาดเดายากและไม่ซ้ำกับบริการอื่น เลี่ยงเครือข่าย Wi-Fi สาธารณะเมื่อต้องทำธุรกรรม และออกจากระบบเมื่อใช้อุปกรณ์ร่วมกับผู้อื่น
        ทีมงานจะไม่ขอรหัสผ่าน รหัส OTP หรือรหัสยืนยันจากสมาชิกไม่ว่ากรณีใดและไม่ว่าผ่านช่องทางใด หากมีข้อความในลักษณะนั้นส่งมา ให้ถือว่าไม่ได้มาจากเรา และเมื่อพบรายการที่ผิดปกติ ให้เก็บเวลา จำนวนเงิน
        และเลขอ้างอิงของรายการไว้แจ้งทีมงานตั้งแต่ข้อความแรก เพื่อให้ตรวจสอบต้นเหตุได้ตรงจุดโดยไม่ต้องเปิดเผยข้อมูลลับของบัญชีแก่ผู้ใด
      </p>
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
