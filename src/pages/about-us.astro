---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/AnnouncementCyber.astro";
import { pageGraph } from "../lib/schema";

const pageTitle = "เกี่ยวกับ PATTAYA168 แพลตฟอร์มที่รวมค่ายเกมสล็อต ข้อมูลเกม ระบบบัญชี และการรองรับ True Wallet ไว้ในที่เดียว";

// One string, two jobs: MainLayout's <meta name="description"> and the WebPage
// node's description. The docx SUB-PAGES block has no row for /about-us, so this
// sentence is written here and held to the 150–160 CHARACTER window that
// tools/verify-build.mjs enforces on any description an agent writes (Thai is 3
// bytes per character, so a byte count reads ~3x too long). This one is 158.
//
// Body copy is deliberately "about the site" — what the platform is, how far a
// member's own use of it goes, and the limits we do not claim past — so it does
// not restate the home page's docx sections. The three H2s below are this page's
// own and deliberately do not echo any docx heading; every claim in them traces
// back to the brief's own cautious wording (รวมเกมจากผู้ให้บริการหลายรูปแบบ
// พร้อมรองรับ True Wallet ตามช่องทางที่กำหนด, พิจารณาชื่อผู้ให้บริการ รายละเอียดเกม
// ตารางจ่าย และข้อมูลที่ระบบแสดงก่อนเลือกเล่น, ไม่ควรใช้คำว่าลิขสิทธิ์แท้เพียงอย่างเดียว
// เป็นหลักฐาน, ตรวจข้อมูล Wallet จำนวนเงิน และชื่อบัญชีให้ตรงกัน, รอให้สถานะรายการเดิม
// อัปเดตก่อนทำรายการใหม่, ดู RTP ความผันผวน ตารางจ่าย และฟีเจอร์โบนัสร่วมกัน,
// เก็บเวลา จำนวนเงิน และเลขอ้างอิงไว้, จ่ายไวไม่ควรตีความว่าเป็นการรับประกันทุกกรณี,
// อ่านยอดขั้นต่ำ เกมที่ร่วมรายการ และเงื่อนไขการถอนให้ครบ). Nothing here promises a
// payout, an RTP figure or a processing time, and nothing claims a licence, an
// award, a founding date, a user count or an office — the brief states none of
// those and neither does this page.
//
// <Announcement /> is bare: AnnouncementCyber's default message is this brand's
// copy, so the ticker matches index.astro without a second string here. The
// variant rotated off AnnouncementHuay, the outgoing brand's pick, per the
// brand spec.
//
// The page list below names only routes that exist this round. This brand is a
// slot house, so the two lottery routes are parked in src/pages-disabled/ and
// are absent from the prose — this page renders no anchor at all, but a
// sentence pointing at a route that does not exist is the same defect as a
// dead link.
//
// The brief names one payment product (True Wallet) and no bank, so neither does
// this page: everything else stays "ระบบของเว็บไซต์" and "ช่องทางที่เว็บไซต์กำหนด".
const pageDescription = "หน้านี้อธิบายว่า PATTAYA168 เป็นแพลตฟอร์มสล็อตแบบใด รวมค่ายเกม ระบบบัญชี และการรองรับ True Wallet ไว้อย่างไร สมาชิกใช้งานได้ถึงขั้นไหน และเราไม่รับปากเรื่องใด";

const graph = pageGraph(Astro, {
  type: "AboutPage",
  name: pageTitle,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "เกี่ยวกับเรา", path: "/about-us" },
  ],
});

// h2 inside the card: white → gold → deep cyan, i.e. the brand's contrast note
// read into its warm accent, where ContentBox's own h1 gradient opens on pale
// cyan and runs pale cyan → cyan → gold. The two levels stay visually distinct
// without either one repeating the other's opening stop, and the pale cyan stays
// on the h1 — a second cyan-led heading on this deep-ocean card is where the
// hierarchy would collapse. No gold-led opening either: that is the h1's closing
// stop, and repeating it is the other way the two levels blur together.
const sectionHeadingClass = "bg-gradient-to-r from-[#ffffff] via-[#fdac13] to-[#0c8ba4] bg-clip-text text-2xl leading-normal font-bold text-transparent";
---

<MainLayout title="PATTAYA168 | เกี่ยวกับเรา และการรวมค่ายเกมสล็อตไว้ในระบบเดียว" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={pageTitle} as="h1">
    <div>
      <h2 class={`mb-6 ${sectionHeadingClass}`}>PATTAYA168 คือแพลตฟอร์มแบบไหน และเว็บไซต์นี้มีหน้าอะไรบ้าง</h2>

      <p class="mb-6 text-left text-base leading-relaxed text-[#cfeef7]">
        <strong class="text-[#8ff5ff]">PATTAYA168</strong> เป็นแพลตฟอร์มสล็อตออนไลน์ที่รวมเกมจากผู้ให้บริการหลายรูปแบบ รายละเอียดของแต่ละเกม ตารางจ่าย ข้อมูลบัญชี และการรองรับ True Wallet ตามช่องทางที่กำหนดไว้ในระบบเดียว
        และรองรับการใช้งานผ่านมือถือ หน้าที่ของเรามีอย่างเดียว คือจัดวางรายชื่อค่ายเกม ข้อมูลของเกมแต่ละตัว โปรโมชั่นที่เปิดอยู่ และสถานะธุรกรรมให้อยู่ในที่เดียวกัน แทนที่ผู้ใช้จะต้องเปิดหลายหน้าเพื่อดูว่าค่ายไหนมีเกมอะไร
        เทียบ RTP กับความผันผวนของแต่ละเกม แล้วไปตามสถานะรายการจากอีกแหล่งหนึ่ง เมื่อทุกอย่างอยู่ที่จุดเดียว การสลับหน้าไปมาและขั้นตอนที่ไม่จำเป็นจะลดลงเอง แต่การรวมไว้ที่เดียวไม่ได้แปลว่าทุกค่ายใช้กติกาชุดเดียวกัน
        เกมแต่ละตัวยังมีตารางจ่าย ฟีเจอร์โบนัส ความผันผวน และวงเงินต่อรอบของตัวเองอยู่ ระบบจึงแยกหมวดตามผู้ให้บริการและประเภทเกมไว้ให้ชัด การแยกหมวดไม่ได้มีไว้เพื่อความสวยงามของหน้าเว็บ
        แต่มีไว้ให้ตรวจชื่อผู้ให้บริการ รายละเอียดเกม ตารางจ่าย และข้อมูลที่ระบบแสดงได้ง่ายขึ้นก่อนเลือกเล่น ส่วนนี้เป็นเจตนาของเราโดยตรง คืออยากให้เลือกจากข้อมูลที่ตรวจสอบได้จริง มากกว่าเลือกจากคำโปรโมตที่เห็นผ่านตา
        เพราะเกมที่คนเล่นกันมากในช่วงหนึ่งไม่จำเป็นต้องเหมาะกับงบและรูปแบบการเล่นของทุกคน ระบบเปิดผ่านเบราว์เซอร์ได้ทั้งบนมือถือและคอมพิวเตอร์โดยไม่ต้องติดตั้งโปรแกรมเพิ่ม ตำแหน่งเมนูและลำดับของข้อมูลจึงอยู่ที่เดิมเมื่อสลับอุปกรณ์ระหว่างวัน
        เนื้อหาบนเว็บไซต์แบ่งเป็นหน้าย่อยไม่กี่หน้าเพื่อให้หาสิ่งที่ต้องการได้เร็ว ได้แก่ หน้าแรกที่อธิบายภาพรวมของระบบและเงื่อนไขการใช้งาน หน้าโปรโมชั่นที่รวมสิทธิพิเศษของแต่ละรายการไว้ด้วยกัน
        หน้าทดลองเล่นสำหรับศึกษากติกา ตารางจ่าย ฟีเจอร์โบนัส และความผันผวนของเกมก่อนเล่นจริง หน้าทางเข้าสำหรับเข้าใช้งานผ่านช่องทางหลัก หน้าเกี่ยวกับเราซึ่งเป็นหน้านี้
        หน้าติดต่อเราสำหรับส่งเรื่องถึงทีมงานโดยตรง และหน้าเงื่อนไขการใช้งานกับนโยบายความเป็นส่วนตัวที่ระบุขอบเขตของเว็บไซต์นี้ไว้เป็นลายลักษณ์อักษร หน้านี้ไม่ใช่คู่มือการใช้งาน
        แต่มีไว้บอกว่าเราเป็นใคร ตั้งใจให้บริการแบบไหน และผู้ใช้งานควรคาดหวังอะไรได้จากเว็บไซต์นี้
      </p>

      <h2 class={`mt-8 mb-6 ${sectionHeadingClass}`}>สมาชิกใช้งาน PATTAYA168 ได้ตั้งแต่ขั้นไหนจนถึงขั้นไหน</h2>

      <p class="mb-6 text-left text-base leading-relaxed text-[#cfeef7]">
        เส้นทางการใช้งานบน PATTAYA168 เดินเป็นลำดับเดียวกันเสมอ เริ่มจากการเปิดบัญชีตามเงื่อนไขที่เว็บไซต์กำหนด ซึ่งเราระบุไว้ตรงไปตรงมาว่าขั้นเปิดบัญชีเป็นคนละเรื่องกับขั้นที่ตามมา
        เงื่อนไขด้านการเติมเงิน การรับสิทธิ์โปรโมชั่น และการถอนเป็นคนละชุดกัน และควรอ่านแยกกันตั้งแต่ต้นแทนที่จะเหมารวมเป็นชุดเดียว จากนั้นจึงเลือกว่ารอบนี้จะเล่นเกมของค่ายใด
        โดยดูชื่อผู้ให้บริการ รายละเอียดเกม กติกา และข้อมูลที่ระบบแสดงให้ครบก่อน จุดที่เราย้ำเสมอคือเกมแต่ละตัวนับผลคนละแบบและตั้งวงเงินต่อรอบคนละอย่าง
        ค่า RTP ที่ผู้ให้บริการระบุ ความผันผวน ตารางจ่าย และฟีเจอร์โบนัสควรดูร่วมกัน ไม่ใช่ดูทีละตัว การเลือกเกมจากคำว่าแตกง่ายโดยยังไม่ได้เปิดตารางจ่ายจึงทำให้ยอดที่เสียไปต่อรอบไม่ตรงกับที่เข้าใจไว้ตั้งแต่แรก
        หากเพิ่งเริ่มควรเลือกเกมที่กติกาชัดเจนและตั้งวงเงินต่อรอบไม่สูงเกินงบ แล้วค่อยขยับไปเกมที่ฟีเจอร์ซับซ้อนขึ้นเมื่อเข้าใจวิธีนับผลแล้ว ขั้นก่อนกดยืนยันธุรกรรมคือขั้นที่เราอยากให้ใช้เวลามากที่สุด
        เพราะเป็นขั้นเดียวที่ยังแก้ได้โดยไม่มีต้นทุน การรองรับ True Wallet ช่วยให้จัดการรายการผ่านมือถือได้คล่องตัวขึ้น แต่ก่อนยืนยันควรตรวจข้อมูล Wallet จำนวนเงิน และชื่อบัญชีให้ตรงกันทุกครั้ง
        พร้อมตรวจว่าสิทธิ์โปรโมชั่นที่ถืออยู่ผูกกับเกมหรือค่ายนั้นหรือไม่ เพราะบางรายการกำหนดเกมที่ร่วมรายการและระยะเวลาไว้เฉพาะ
        ฝั่งบัญชีเดินคนละแบบกับฝั่งเกม คือรวมข้อมูลบัญชี สิทธิ์โปรโมชั่นที่ถืออยู่ ยอดคงเหลือ ประวัติฝากถอน และสถานะของรายการที่ยังดำเนินการอยู่ไว้ในระบบเดียว
        ระบบที่ใช้งานง่ายช่วยลดขั้นตอนตรงนี้ให้สั้นลง แต่ไม่ได้ลดหน้าที่ในการตรวจของผู้ใช้งาน หลังทำรายการแล้วควรเก็บเวลา จำนวนเงิน และเลขอ้างอิงไว้จนกว่าสถานะจะเสร็จสมบูรณ์
        และควรรอให้รายการเดิมอัปเดตสถานะก่อนทำรายการใหม่เสมอ การกดส่งซ้ำระหว่างนั้นไม่ได้ทำให้เร็วขึ้น แต่เพิ่มโอกาสเกิดรายการซ้ำหรือยอดคลาดเคลื่อน
        และทำให้การไล่ตรวจย้อนหลังยากขึ้นสำหรับทั้งสองฝ่าย หากสถานะยังไม่อัปเดต ให้ติดต่อทีมงานพร้อมข้อมูลรายการเพื่อขอตรวจสอบเพิ่มเติม หรือสอบถามช่องทางที่ระบบรองรับในช่วงนั้น
        ส่วนสิทธิ์โปรโมชั่นให้ตรวจจากหน้าบัญชีก่อนเริ่มทุกครั้ง ทั้งชื่อโปรโมชั่น จำนวนเครดิต และเงื่อนไขที่เกี่ยวข้อง หากมีหลายโปรพร้อมกันควรดูว่าใช้ร่วมกันได้หรือไม่
        และควรเก็บรายละเอียดสิทธิ์ไว้จนกว่าการใช้งานหรือการถอนจะเสร็จสมบูรณ์
      </p>

      <h2 class={`mt-8 mb-6 ${sectionHeadingClass}`}>สิ่งที่เราไม่รับปาก และขอบเขตที่อยากให้ผู้ใช้งานตั้งไว้ก่อนเริ่ม</h2>

      <p class="mb-2 text-left text-base leading-relaxed text-[#cfeef7]">
        เรื่องที่เราพูดตรงไปตรงมาตั้งแต่ต้นคือ ถ้อยคำที่ใช้กันทั่วไปในวงการนี้เป็นข้อความทางการตลาด ไม่ใช่หลักฐานในตัวเอง คำว่าลิขสิทธิ์แท้ควรพิจารณาจากข้อมูลผู้ให้บริการและรายละเอียดเกมที่แสดงในระบบ
        ทั้งชื่อค่าย ฟีเจอร์ กติกา และข้อมูลทางเทคนิคประกอบกัน ไม่ควรใช้คำโฆษณาเป็นหลักฐานเพียงอย่างเดียว คำว่าจ่ายไวก็ควรพิจารณาจากสถานะรายการที่ระบบแสดงจริง
        ไม่ควรตีความว่าเป็นการรับประกันทุกกรณี เพราะระยะเวลาอาจขึ้นอยู่กับสถานะบัญชี ช่องทางการเงิน และขั้นตอนตรวจสอบของระบบในช่วงนั้น เช่นเดียวกับคำว่าแตกง่าย
        ซึ่งไม่ได้หมายความว่าทุกเกมให้ผลตอบแทนเท่ากัน เพราะค่า RTP ความผันผวน และตารางจ่ายต่างกันไปตามเกมและผู้ให้บริการ จึงควรดูข้อมูลที่ระบบแสดงก่อนเลือกเล่นทุกครั้ง
        และไม่ควรถือว่า RTP สูงหมายถึงได้เงินคืนแน่นอนในรอบใดรอบหนึ่ง เช่นเดียวกับคำว่าโปรแรง ซึ่งโดยทั่วไปสื่อถึงจำนวนเครดิตหรือสิทธิ์ที่เว็บไซต์กำหนดในช่วงนั้น
        แต่เงื่อนไขจริงต่างกันตามรายการ ทั้งยอดขั้นต่ำ เกมที่ร่วมรายการ ระยะเวลา และเงื่อนไขการถอน จึงควรอ่านให้ครบก่อนกดรับสิทธิ์ทุกครั้ง
        ในทางเดียวกัน โปรโมชั่นที่ดูคุ้มไม่จำเป็นต้องเป็นโปรที่ให้เครดิตมากที่สุด ควรเปรียบเทียบยอดรับโบนัส ยอดขั้นต่ำ เกมที่ร่วมรายการ ระยะเวลา และข้อกำหนดการถอนร่วมกัน
        เพราะโปรที่เหมาะกับงบและจำนวนรอบที่ตั้งใจเล่นอาจคุ้มกว่าข้อเสนอที่ให้เครดิตสูงแต่มีข้อจำกัดมาก และไม่ควรเป็นโปรที่บังคับให้เพิ่มยอดเกินแผนที่ตั้งไว้ตั้งแต่แรก
        ผลของแต่ละรอบเป็นสิ่งที่คาดเดาไม่ได้ รอบก่อนหน้าไม่ได้กำหนดรอบถัดไป และการนับสถิติย้อนหลังก็ไม่ได้ทำให้คาดเดาได้แม่นขึ้น เราจึงไม่ชี้เกม ไม่ขายสูตร และไม่รับประกันผล รายได้ หรือกำไรไม่ว่ากรณีใด
        ด้วยเหตุนี้เราจึงขอให้ผู้ใช้งานกำหนดวงเงินต่อรอบไว้ล่วงหน้า ใช้เฉพาะเงินที่ไม่กระทบค่าใช้จ่ายจำเป็น หยุดเมื่อถึงวงเงินที่ตั้งไว้ และไม่เพิ่มยอดเพื่อตามคืนสิ่งที่เสียไปในรอบก่อน
        ด้านบัญชี ขอให้เข้าใช้งานผ่านช่องทางหลักที่เว็บไซต์กำหนด ไม่ใช่ลิงก์ที่ส่งต่อกันมาพร้อมคำโฆษณา ตรวจชื่อเว็บไซต์และการเชื่อมต่อแบบ HTTPS ทุกครั้งก่อนกรอกข้อมูล
        ตั้งรหัสผ่านที่คาดเดายากและไม่ซ้ำกับบริการอื่น หลีกเลี่ยงเครือข่ายสาธารณะเมื่อต้องจัดการข้อมูลบัญชีหรือทำธุรกรรม และออกจากระบบเมื่อใช้อุปกรณ์ร่วมกับผู้อื่น
        ทีมงานจะไม่ขอรหัสผ่าน รหัส OTP หรือรหัสยืนยันจากสมาชิกไม่ว่ากรณีใดและไม่ว่าผ่านช่องทางใด หากมีข้อความในลักษณะนั้นส่งมา ให้ถือว่าไม่ได้มาจากเรา
        และเมื่อพบรายการที่ผิดปกติ ให้เก็บเวลา จำนวนเงิน และเลขอ้างอิงของรายการไว้แจ้งทีมงานตั้งแต่ข้อความแรก เพื่อให้ตรวจสอบต้นเหตุได้ตรงจุดโดยไม่ต้องเปิดเผยข้อมูลลับของบัญชีแก่ผู้ใด
      </p>
