---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement5.astro";
import { pageGraph } from "../lib/schema";

const pageTitle = "เกี่ยวกับเรา AMB194 คาสิโนออนไลน์และเกมสล็อตในระบบเดียว";

// One string, three jobs: MainLayout's <meta name="description">, the WebPage
// node's description, and nothing else. 150–160 CHARACTERS (Thai is 3 bytes per
// character, so a byte count reads ~3x too long). This one is 152.
//
// The docx for this brand has no "เกี่ยวกับเรา" SUB-PAGES row — its Title/Meta
// table covers the other pages only — so the Title and Meta here are written
// from the brief's Main SEO block rather than copied from a row. Nothing to
// reconcile against the docx.
//
// Body copy is deliberately written as "about the site" (who we are, how the
// service is set up, what we commit to) so it does not restate the homepage's
// docx sections, which cover the same topics from the how-to-use angle.
const pageDescription =
  "AMB194 คาสิโนออนไลน์และกีฬาที่รวมเกมสล็อตหลายรูปแบบไว้ในระบบเดียว หน้านี้อธิบายว่าเราเป็นใคร วางระบบฝากถอนอย่างไร และดูแลบัญชีสมาชิกด้วยแนวทางแบบไหนบ้าง";

const graph = pageGraph(Astro, {
  type: "AboutPage",
  name: pageTitle,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "เกี่ยวกับเรา", path: "/about-us" },
  ],
});
---

<MainLayout title="AMB194 | เกี่ยวกับเราและแนวทางการให้บริการสมาชิก" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={pageTitle} as="h1">
    <div>
      <h2 class="mb-6 bg-gradient-to-r from-[#fff3ae] via-[#f8d441] to-[#d9a520] bg-clip-text text-2xl leading-normal font-bold text-transparent">AMB194 เป็นเว็บแบบไหน และหน้าเว็บไซต์นี้มีอะไรอยู่บ้าง</h2>

      <p class="mb-6 text-left text-base leading-relaxed text-[#f5ecd6]">
        <strong class="text-[#f8d441]">AMB194</strong> คือแพลตฟอร์มคาสิโนออนไลน์และกีฬาที่รวบรวมเกมสล็อตหลายรูปแบบไว้ในระบบเดียว ทั้งสล็อตคลาสสิก เกมโบนัส และเกมธีมใหม่ ๆ
        ที่มีรูปแบบการเล่น ฟีเจอร์ และระดับความผันผวนต่างกัน สมาชิกเลือกเกมตามความชอบ ตรวจสอบโปรโมชั่น และจัดการบัญชีของตนเองได้จากหน้าเดียว
        พร้อมระบบฝากถอนที่ช่วยลดขั้นตอนและเมนูที่เข้าถึงง่าย เปิดใช้งานได้ทั้งบนมือถือและคอมพิวเตอร์โดยไม่ต้องติดตั้งโปรแกรมเพิ่ม
        เนื้อหาบนเว็บไซต์ถูกจัดเป็นหน้าย่อยไม่กี่หน้าเพื่อให้หาสิ่งที่ต้องการได้เร็ว ได้แก่ หน้าแรกที่อธิบายภาพรวมของระบบ หน้าโปรโมชั่นที่แจกแจงสิทธิ์และเงื่อนไขของแต่ละรายการ
        หน้าทดลองเล่นสำหรับเปิดดูเกมก่อนตัดสินใจ หน้าทางเข้าสำหรับเข้าใช้งานผ่านช่องทางหลัก และหน้าติดต่อเราสำหรับส่งเรื่องถึงทีมงานโดยตรง
        หน้านี้ไม่ได้เป็นคู่มือการใช้งาน แต่มีไว้บอกว่าเราเป็นใคร ตั้งใจให้บริการแบบไหน และผู้ใช้งานควรคาดหวังอะไรได้จากเว็บไซต์นี้
      </p>

      <h2 class="mt-8 mb-6 bg-gradient-to-r from-[#fff3ae] via-[#f8d441] to-[#d9a520] bg-clip-text text-2xl leading-normal font-bold text-transparent">แนวทางการวางระบบและการให้ข้อมูลของทีมงาน AMB194</h2>

      <p class="mb-6 text-left text-base leading-relaxed text-[#f5ecd6]">
        แนวทางที่เรายึดในการวางระบบมีอยู่สามข้อ ข้อแรกคือลดขั้นตอนที่ไม่จำเป็นออก ระบบธุรกรรมจึงเปิดให้สมาชิกทำรายการฝากถอนผ่านหน้าบัญชีได้โดยตรง และตรวจสถานะรายการได้จากหน้าเดียว
        แทนที่จะต้องส่งข้อมูลเดิมซ้ำหลายรอบ ก่อนยืนยันควรตรวจสอบชื่อบัญชี จำนวนเงิน และสถานะรายการให้ครบถ้วนทุกครั้ง และหากรายการยังดำเนินการอยู่ ควรรอผลจากระบบก่อนทำซ้ำ
        เพื่อช่วยลดความสับสนในการตรวจสอบย้อนหลัง
        ข้อสองคือให้ข้อมูลของเกมครบพอให้เลือกเองได้ ทั้งธีมเกม กติกา อัตราจ่าย ระดับความผันผวน และวงเงินเดิมพันต่อรอบ เพื่อให้แต่ละคนเลือกเกมที่เหมาะกับงบประมาณและสไตล์การเล่นของตนเองได้จริง
        ข้อสามคือเขียนเงื่อนไขให้อ่านได้จริง ทั้งยอดฝากขั้นต่ำของโปรโมชั่น จำนวนเทิร์น เกมที่ร่วมรายการ และเพดานถอน จะถูกระบุไว้ให้ตรวจก่อนกดรับเสมอ
        เราไม่ใช้คำที่รับประกันผลการเล่นและไม่แนะนำสูตรใด เพราะคำว่าแตกไม่อั้นเป็นคำโฆษณาที่บอกได้เพียงว่าเกมนั้นมีจังหวะลุ้นรางวัลและฟีเจอร์ที่น่าสนใจ ไม่ใช่การรับประกันผลลัพธ์
        และสถิติรอบที่ผ่านมาที่เห็นบนหน้าจอเป็นบันทึกของรอบที่จบไปแล้ว ไม่ใช่คำใบ้ของรอบถัดไป สิ่งที่เว็บไซต์ให้ได้คือข้อมูลที่ครบพอให้ตัดสินใจเอง ไม่ใช่คำสัญญาเรื่องผลลัพธ์
      </p>

      <h2 class="mt-8 mb-6 bg-gradient-to-r from-[#fff3ae] via-[#f8d441] to-[#d9a520] bg-clip-text text-2xl leading-normal font-bold text-transparent">สิ่งที่เรารับผิดชอบต่อบัญชีสมาชิกและการติดต่อกลับ</h2>

      <p class="mb-2 text-left text-base leading-relaxed text-[#f5ecd6]">
        เรื่องบัญชีเป็นส่วนที่เราถือว่าสำคัญที่สุด ทีมงานจะไม่ขอรหัสผ่านหรือรหัสยืนยันจากสมาชิกไม่ว่ากรณีใด ผ่านช่องทางส่วนตัวหรือช่องทางสาธารณะก็ตาม
        ถ้ามีข้อความในลักษณะนั้นส่งมา ให้ถือว่าไม่ได้มาจากเรา และเราแนะนำให้เข้าใช้งานผ่านช่องทางหลักที่ตรวจชื่อเว็บไซต์และการเชื่อมต่อแบบ HTTPS แล้วเท่านั้น
        ไม่ใช่ลิงก์ที่ส่งต่อกันมาพร้อมคำโฆษณา ควรตั้งรหัสผ่านที่คาดเดายาก หลีกเลี่ยงเครือข่ายสาธารณะเมื่อต้องทำธุรกรรม และออกจากระบบทุกครั้งเมื่อใช้อุปกรณ์ที่ไม่ใช่ของตนเอง
        ด้านการทำรายการ ควรใช้ข้อมูลที่ตรงกับตอนสมัคร ตรวจสอบยอดคงเหลือและเงื่อนไขโปรโมชั่นที่ค้างอยู่ก่อนกดยืนยัน และเก็บรายละเอียดรายการไว้จนกว่าระบบจะแสดงสถานะสำเร็จ
        ด้านการติดต่อ ทีมงานดูแลสมาชิกของ AMB194 รับเรื่องตลอด 24 ชั่วโมงผ่านช่องทางที่เว็บไซต์กำหนด ทั้งเรื่องบัญชี ทางเข้าเล่น โปรโมชั่น และสถานะฝากถอน
        การแจ้งชื่อผู้ใช้ เวลาที่ทำรายการ และรายละเอียดของรายการมาให้ครบตั้งแต่ข้อความแรก จะช่วยให้เราตรวจสอบต้นเหตุได้ตรงจุดและเร็วขึ้น โดยไม่ต้องเปิดเผยรหัสผ่านหรือข้อมูลยืนยันบัญชี
        สุดท้ายเราขอย้ำว่าการเดิมพันควรอยู่ในวงเงินที่ไม่กระทบค่าใช้จ่ายส่วนตัว และไม่ควรเพิ่มทุนเพื่อตามยอดที่เสียไป
      </p>
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
