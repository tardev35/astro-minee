---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement5.astro";
import { pageGraph } from "../lib/schema";

const pageTitle = "เกี่ยวกับเรา TGAZM เว็บสล็อตระบบออโต้ รวมเกมสล็อตหลายรูปแบบในบัญชีเดียว";

// One string, three jobs: MainLayout's <meta name="description">, the WebPage
// node's description, and nothing else. 150–160 CHARACTERS (Thai is 3 bytes per
// character, so a byte count reads ~3x too long). This one is 155.
//
// The docx for this brand has no "เกี่ยวกับเรา" section — its SUB-PAGES block
// lists only โปรโมชั่น / บทความ / ติดต่อเรา / เข้าสู่ระบบ / ทางเข้าเล่น / ทดลองเล่น —
// so the Title and Meta here are written from the brief's Main SEO block rather
// than copied from a SUB-PAGES row. Nothing to reconcile against the docx.
//
// Body copy is deliberately written as "about the site" (who we are, how the
// service is set up, what we commit to) so it does not restate the homepage's
// docx sections, which cover the same topics from the how-to-use angle.
const pageDescription =
  "เกี่ยวกับ TGAZM เว็บสล็อตระบบออโต้ รวมเกมสล็อตหลายรูปแบบไว้ในบัญชีเดียว รองรับมือถือ ฝากไม่มีขั้นต่ำตามช่องทางที่กำหนด พร้อมทีมงานดูแลสมาชิกตลอด 24 ชั่วโมง";

const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "เกี่ยวกับเรา", path: "/about-us" },
  ],
});
---

<MainLayout title="TGAZM | เกี่ยวกับเราและแนวทางให้บริการเว็บสล็อตระบบออโต้" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={pageTitle} as="h1">
    <div>
      <h2 class="mb-6 bg-gradient-to-r from-[#ffeaa0] via-[#ffd54a] to-[#c6f76a] bg-clip-text text-2xl leading-normal font-bold text-transparent">TGAZM คือเว็บแบบไหน และหน้าเว็บไซต์นี้มีอะไรอยู่บ้าง</h2>

      <p class="mb-6 text-left text-base leading-relaxed text-[#e2f3cd]">
        <strong class="text-[#ffeaa0]">TGAZM</strong> เป็นเว็บสล็อตออนไลน์ที่ตั้งใจออกแบบให้ผู้ใช้งานเริ่มต้นได้โดยไม่ต้องผ่านขั้นตอนที่ซับซ้อน ตั้งแต่การสมัคร การเลือกเกม ไปจนถึงการฝากถอนผ่านระบบออโต้
        เนื้อหาบนเว็บไซต์ถูกจัดเป็นหน้าย่อยไม่กี่หน้าเพื่อให้หาสิ่งที่ต้องการได้เร็ว ได้แก่ หน้าแรกที่อธิบายภาพรวมของระบบ หน้าโปรโมชั่นที่แจกแจงสิทธิ์และเงื่อนไขของแต่ละรายการ
        หน้าทดลองเล่นสำหรับเปิดดูเกมของแต่ละค่ายก่อนตัดสินใจ หน้าทางเข้าสำหรับเข้าใช้งานผ่านช่องทางหลัก และหน้าติดต่อเราสำหรับส่งเรื่องถึงทีมงานโดยตรง
        หน้านี้ไม่ได้เป็นคู่มือการใช้งาน แต่มีไว้บอกว่าเราเป็นใคร ตั้งใจให้บริการแบบไหน และผู้ใช้งานควรคาดหวังอะไรได้จากเว็บไซต์นี้
      </p>

      <h2 class="mb-6 bg-gradient-to-r from-[#ffeaa0] via-[#ffd54a] to-[#c6f76a] bg-clip-text text-2xl leading-normal font-bold text-transparent">แนวทางการวางระบบและการให้ข้อมูลของทีมงาน TGAZM</h2>

      <p class="mb-6 text-left text-base leading-relaxed text-[#e2f3cd]">
        แนวทางที่เรายึดในการวางระบบมีอยู่สามข้อ ข้อแรกคือลดขั้นตอนที่ไม่จำเป็นออก ระบบออโต้จึงเปิดให้สมาชิกทำรายการและตรวจสถานะได้จากหน้าบัญชีของตนเอง แทนที่จะต้องส่งข้อมูลเดิมซ้ำหลายรอบ
        ข้อสองคือไม่กำหนดเพดานเริ่มต้นให้สูงเกินจำเป็น เงื่อนไขฝากไม่มีขั้นต่ำจึงเปิดใช้ตามช่องทางที่เว็บไซต์กำหนด เพื่อให้แต่ละคนเลือกยอดเริ่มต้นได้ตามงบของตนเอง
        ข้อสามคือเขียนเงื่อนไขให้อ่านได้จริง ทั้งยอดขั้นต่ำของโปรโมชั่น จำนวนเทิร์น ค่ายเกมที่ร่วมรายการ และเพดานถอน จะถูกระบุไว้ให้ตรวจก่อนกดรับเสมอ
        เราไม่ใช้คำที่รับประกันผลการเล่นและไม่แนะนำสูตรใด เพราะเกมสล็อตทำงานด้วยระบบสุ่ม สิ่งที่เว็บไซต์ให้ได้คือข้อมูลที่ครบพอให้ตัดสินใจเอง ไม่ใช่คำสัญญาเรื่องผลลัพธ์
      </p>

      <h2 class="mb-6 bg-gradient-to-r from-[#ffeaa0] via-[#ffd54a] to-[#c6f76a] bg-clip-text text-2xl leading-normal font-bold text-transparent">สิ่งที่เรารับผิดชอบต่อบัญชีสมาชิกและการติดต่อกลับ</h2>

      <p class="mb-2 text-left text-base leading-relaxed text-[#e2f3cd]">
        เรื่องบัญชีเป็นส่วนที่เราถือว่าสำคัญที่สุด ทีมงานจะไม่ขอรหัสผ่านหรือรหัสยืนยันจากสมาชิกไม่ว่ากรณีใด ผ่านช่องทางส่วนตัวหรือช่องทางสาธารณะก็ตาม
        ถ้ามีข้อความในลักษณะนั้นส่งมา ให้ถือว่าไม่ได้มาจากเรา และเราแนะนำให้เข้าใช้งานผ่านช่องทางเข้าหลักที่ตรวจชื่อเว็บไซต์แล้วเท่านั้น ไม่ใช่ลิงก์ที่ส่งต่อกันมาพร้อมคำโฆษณา
        ด้านการติดต่อ ทีมงานดูแลสมาชิกของ TGAZM รับเรื่องตลอด 24 ชั่วโมงผ่านช่องทางที่เว็บไซต์ระบุ ทั้งเรื่องบัญชี ทางเข้าเล่น โปรโมชั่น และสถานะฝากถอน
        การแจ้งชื่อผู้ใช้ เวลาที่ทำรายการ และรายละเอียดของรายการมาให้ครบตั้งแต่ข้อความแรก จะช่วยให้เราตรวจสอบต้นเหตุได้ตรงจุดและเร็วขึ้น
        สุดท้ายเราขอย้ำว่าการเดิมพันควรอยู่ในวงเงินที่ไม่กระทบค่าใช้จ่ายส่วนตัว และไม่ควรเพิ่มทุนเพื่อตามยอดที่เสียไป
      </p>
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
