---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement3.astro";
import { pageGraph } from "../lib/schema";

const pageTitle = "เกี่ยวกับเรา LCX88 คาสิโนออนไลน์ระบบออโต้ รวมเกมหลายค่ายในระบบเดียว";

// One string, three jobs: MainLayout's <meta name="description">, the WebPage
// node's description, and nothing else. 150–160 CHARACTERS (Thai is 3 bytes per
// character, so a byte count reads ~3x too long). This one is 158.
//
// The docx for this brand has no "เกี่ยวกับเรา" section — it lists only
// โปรโมชั่น / บทความ / ติดต่อเรา / เข้าสู่ระบบ / ทางเข้าเล่น / ทดลองเล่น — so the
// Title and Meta here are written from the brief's Main SEO block rather than
// copied from a SUB-PAGES row. Nothing to reconcile against the docx.
const pageDescription =
  "เกี่ยวกับ LCX88 คาสิโนออนไลน์ระบบออโต้ รวมสล็อต บาคาร่า รูเล็ต และคาสิโนสดไว้ในบัญชีเดียว รองรับมือถือ ฝากถอนไม่มีขั้นต่ำ พร้อมทีมงานดูแลสมาชิกตลอด 24 ชั่วโมง";

const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "เกี่ยวกับเรา", path: "/about-us" },
  ],
});
---

<MainLayout title="LCX88 | เกี่ยวกับเราและบริการคาสิโนออนไลน์ระบบออโต้" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={pageTitle} as="h1">
    <div>
      <h2 class="mb-6 bg-gradient-to-r from-[#ffe08a] via-[#f5c542] to-[#6ea3ff] bg-clip-text text-2xl leading-normal font-bold text-transparent">LCX88 รวมเกมคาสิโนออนไลน์หลายรูปแบบไว้ในบัญชีเดียว</h2>

      <p class="mb-6 text-left text-base leading-relaxed text-[#d7e3ff]">
        <strong class="text-[#ffe08a]">LCX88</strong> เป็นแพลตฟอร์มคาสิโนออนไลน์ที่รวมเกมหลายรูปแบบไว้ในระบบเดียว ทั้งเกมสล็อต บาคาร่า รูเล็ต เกมไพ่ และคาสิโนสดจากหลายค่าย
        สมาชิกเลือกเกมตามประเภท ค่าย หรือรูปแบบที่ถนัดได้จากหน้าเดียว โดยไม่ต้องสลับบัญชีไปมาระหว่างค่าย ก่อนเริ่มเล่นทุกครั้งควรศึกษากติกา อัตราการจ่าย
        และเงื่อนไขของแต่ละเกมให้ครบ เพื่อวางงบประมาณให้เหมาะกับตนเองมากกว่าเลือกจากหน้าปกเกมอย่างเดียว เว็บไซต์รองรับทั้งมือถือ แท็บเล็ต และคอมพิวเตอร์
        จึงเปิดใช้งานผ่านเบราว์เซอร์ได้โดยไม่ต้องติดตั้งโปรแกรมเพิ่ม
      </p>

      <h2 class="mb-6 bg-gradient-to-r from-[#ffe08a] via-[#f5c542] to-[#6ea3ff] bg-clip-text text-2xl leading-normal font-bold text-transparent">ระบบออโต้และเงื่อนไขฝากถอนไม่มีขั้นต่ำของ LCX88</h2>

      <p class="mb-6 text-left text-base leading-relaxed text-[#d7e3ff]">
        ระบบฝากถอนออโต้ช่วยให้สมาชิกทำรายการผ่านหน้าบัญชีของตนเองได้โดยลดขั้นตอนที่ไม่จำเป็นลง ส่วนเงื่อนไขไม่มีขั้นต่ำผ่านระบบของ LCX88
        ช่วยให้กำหนดยอดทำรายการได้ยืดหยุ่นตามช่องทางที่เว็บไซต์กำหนด ก่อนกดยืนยันควรใช้ข้อมูลที่ตรงกับบัญชีที่สมัครไว้ ตรวจสอบชื่อบัญชี จำนวนเงิน ช่องทางที่รองรับ
        และข้อกำหนดของโปรโมชั่นให้ตรงกันทุกครั้ง หากยอดยังไม่เปลี่ยนไม่ควรกดซ้ำทันที เพราะระบบอาจกำลังประมวลผลอยู่ และความเร็วของรายการยังขึ้นอยู่กับธนาคาร
        ช่องทางชำระเงิน และสถานะการตรวจสอบข้อมูลของบัญชีด้วย หลังทำรายการควรเก็บเลขรายการหรือภาพหน้าจอไว้จนกว่าระบบจะแสดงสถานะสำเร็จ
      </p>

      <h2 class="mb-6 bg-gradient-to-r from-[#ffe08a] via-[#f5c542] to-[#6ea3ff] bg-clip-text text-2xl leading-normal font-bold text-transparent">ความปลอดภัยของบัญชีและช่องทางดูแลสมาชิกตลอด 24 ชั่วโมง</h2>

      <p class="mb-2 text-left text-base leading-relaxed text-[#d7e3ff]">
        การใช้งานอย่างปลอดภัยควรเริ่มจากการเข้าสู่ระบบผ่านช่องทางหลักที่ตรวจแล้ว ตั้งรหัสผ่านที่คาดเดายาก ไม่เปิดเผยรหัสยืนยันแก่บุคคลอื่นไม่ว่ากรณีใด
        หลีกเลี่ยงเครือข่ายสาธารณะเมื่อต้องทำธุรกรรม และออกจากระบบทุกครั้งเมื่อใช้อุปกรณ์ร่วมกับผู้อื่น เมื่อพบปัญหาเรื่องบัญชี ทางเข้าเล่น โปรโมชั่น หรือสถานะฝากถอน
        ทีมงานดูแลสมาชิกของ LCX88 รับเรื่องตลอด 24 ชั่วโมงผ่านช่องทางที่เว็บไซต์ระบุ ควรเตรียมชื่อผู้ใช้ เวลาที่ทำรายการ และรายละเอียดรายการให้ครบตั้งแต่ข้อความแรก
        เพื่อให้ตรวจสอบได้เร็วขึ้น โดยไม่ส่งรหัสผ่านหรือรหัสยืนยันให้ผู้ใด เพราะทีมงานไม่ขอข้อมูลเหล่านี้ผ่านช่องทางส่วนตัว
      </p>
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
