---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/AnnouncementCyber.astro";
import { pageGraph } from "../lib/schema";

const pageTitle = "เกี่ยวกับเรา KIKI49 เว็บสล็อตฝากถอนออโต้รวดเร็ว โปรทุนน้อย ไม่มีขั้นต่ำ";

// One string, three jobs: MainLayout's <meta name="description">, the WebPage
// node's description, and nothing else. 150–160 CHARACTERS (Thai is 3 bytes per
// character, so a byte count reads ~3x too long). This one is 159.
//
// The docx for this brand has no "เกี่ยวกับเรา" SUB-PAGES row — its Title/Meta
// table covers the other pages only — so the Title and Meta here are written
// from the brief's Main SEO block rather than copied from a row. Nothing to
// reconcile against the docx.
//
// Body copy is deliberately written as "about the site" (who we are, how the
// service is set up, what we commit to) so it does not restate the homepage's
// docx sections, which cover the same topics from the how-to-use angle.
const pageDescription =
  "KIKI49 เว็บสล็อตฝากถอนออโต้รวดเร็ว โปรทุนน้อย ไม่มีขั้นต่ำตามเงื่อนไข หน้านี้เล่าว่าเราเป็นใคร วางระบบสมาชิกและธุรกรรมอย่างไร และดูแลบัญชีสมาชิกด้วยแนวทางแบบใด";

const graph = pageGraph(Astro, {
  type: "AboutPage",
  name: pageTitle,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "เกี่ยวกับเรา", path: "/about-us" },
  ],
});
---

<MainLayout title="KIKI49 | เกี่ยวกับเราและแนวทางการดูแลสมาชิก" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={pageTitle} as="h1">
    <div>
      <h2 class="mb-6 bg-gradient-to-r from-[#ff5a5f] via-[#e2131d] to-[#a80f16] bg-clip-text text-2xl leading-normal font-bold text-transparent">KIKI49 เป็นเว็บแบบไหน และในเว็บไซต์นี้มีหน้าอะไรอยู่บ้าง</h2>

      <p class="mb-6 text-left text-base leading-relaxed text-[#f2e2e4]">
        <strong class="text-[#ff5a5f]">KIKI49</strong> คือแพลตฟอร์มเกมสล็อตออนไลน์ที่รวมเกมสล็อตจากหลายค่ายไว้ในระบบเดียว ทั้งสล็อตคลาสสิก เกมโบนัส และเกมที่มีฟีเจอร์หลากหลาย
        แต่ละเกมมีกติกา ระดับความผันผวน และรูปแบบการจ่ายต่างกัน สมาชิกจึงเลือกเกมตามงบประมาณของตนเอง ตรวจสอบโปรโมชั่น และจัดการบัญชีได้จากหน้าเดียวโดยไม่ต้องสลับระบบไปมา
        จุดที่เราให้ความสำคัญเป็นอันดับแรกคือความสะดวกของการฝากและการถอน รายการเดินผ่านระบบออโต้ที่สมาชิกทำเองได้จากหน้าบัญชีโดยไม่ต้องรอคนกดอนุมัติทีละรายการ
        เรายังวางโปรโมชั่นสำหรับผู้เล่นทุนน้อยไว้เป็นหมวดหนึ่งของเว็บไซต์ และมีเงื่อนไขไม่มีขั้นต่ำในช่องทางที่กำหนด เพื่อให้เริ่มต้นด้วยงบไม่สูงได้จริง ส่วนเมนูทั้งหมดออกแบบให้เปิดใช้งานได้ทั้งบนมือถือและคอมพิวเตอร์โดยไม่ต้องติดตั้งโปรแกรมเพิ่ม
        เนื้อหาบนเว็บไซต์จัดเป็นหน้าย่อยไม่กี่หน้าเพื่อให้หาสิ่งที่ต้องการได้เร็ว ได้แก่ หน้าแรกที่อธิบายภาพรวมของระบบและเงื่อนไขการใช้งาน หน้าโปรโมชั่นที่แจกแจงสิทธิ์และข้อกำหนดของแต่ละรายการ
        หน้าทดลองเล่นสำหรับเปิดดูเกมก่อนตัดสินใจ หน้าทางเข้าสำหรับเข้าใช้งานผ่านช่องทางหลัก และหน้าติดต่อเราสำหรับส่งเรื่องถึงทีมงานโดยตรง
        หน้านี้ไม่ใช่คู่มือการใช้งาน แต่มีไว้บอกว่าเราเป็นใคร ตั้งใจให้บริการแบบไหน และผู้ใช้งานควรคาดหวังอะไรได้จากเว็บไซต์นี้
      </p>

      <h2 class="mt-8 mb-6 bg-gradient-to-r from-[#ff5a5f] via-[#e2131d] to-[#a80f16] bg-clip-text text-2xl leading-normal font-bold text-transparent">แนวทางที่ทีมงาน KIKI49 ใช้วางระบบและให้ข้อมูลกับสมาชิก</h2>

      <p class="mb-6 text-left text-base leading-relaxed text-[#f2e2e4]">
        แนวทางที่เรายึดในการวางระบบมีอยู่สามข้อ ข้อแรกคือตัดขั้นตอนที่ไม่จำเป็นออกให้มากที่สุด ระบบออโต้จึงเปิดให้สมาชิกฝาก ถอน และตรวจสอบสถานะรายการผ่านหน้าบัญชีได้ด้วยตนเอง เห็นสถานะของทุกรายการจากหน้าเดียว
        และไม่ต้องส่งข้อมูลชุดเดิมซ้ำอีกในรอบถัดไป ก่อนกดยืนยันควรตรวจชื่อบัญชี จำนวนเงิน และข้อมูลของรายการให้ถูกต้องทุกครั้ง และถ้ารายการยังดำเนินการอยู่ ขอให้รอผลจากระบบก่อนทำรายการซ้ำ
        เพราะรายการที่ส่งซ้อนกันคือสาเหตุที่ทำให้การตรวจสอบย้อนหลังใช้เวลานานขึ้น
        ข้อสองคือให้ข้อมูลของเกมครบพอที่จะเลือกเองได้ ทั้งธีมเกม กติกา ระดับความผันผวน รูปแบบการจ่าย และวงเงินเดิมพันต่อรอบ เพื่อให้แต่ละคนจับคู่เกมกับงบประมาณของตนเองได้จริงโดยไม่ต้องเริ่มด้วยเงินจำนวนสูง แทนที่จะเลือกตามอันดับความนิยมเพียงอย่างเดียว
        ข้อสามคือเขียนเงื่อนไขให้อ่านรู้เรื่อง โปรโมชั่นสำหรับผู้เล่นทุนน้อยแต่ละรายการอาจกำหนดยอดเริ่มต้นและเงื่อนไขรับสิทธิ์ไม่เท่ากัน ทั้งโบนัสที่ได้รับ เกมที่ร่วมรายการ และข้อกำหนดการถอน จะถูกระบุไว้ให้เปรียบเทียบก่อนกดรับเสมอ ไม่ซ่อนไว้ในบรรทัดท้ายสุด
        เช่นเดียวกับเงื่อนไขไม่มีขั้นต่ำที่ใช้ได้เฉพาะช่องทางที่กำหนด เราจะระบุไว้ตรงจุดที่ต้องใช้ ไม่ปล่อยให้เข้าใจไปเองว่าใช้ได้ทุกช่องทาง
        เราไม่ใช้คำที่รับประกันผลการเล่นและไม่แนะนำสูตรใด เพราะคำอย่างแตกง่ายบอกได้เพียงว่าเกมนั้นมีจังหวะลุ้นรางวัลและฟีเจอร์ที่น่าสนใจ ไม่ใช่การรับประกันผลลัพธ์
        สถิติรอบที่ผ่านมาที่เห็นบนหน้าจอก็เป็นบันทึกของรอบที่จบไปแล้ว ไม่ใช่คำใบ้ของรอบถัดไป สิ่งที่เว็บไซต์ให้ได้คือข้อมูลที่ครบพอให้ตัดสินใจเอง ไม่ใช่คำสัญญาเรื่องผลลัพธ์
      </p>

      <h2 class="mt-8 mb-6 bg-gradient-to-r from-[#ff5a5f] via-[#e2131d] to-[#a80f16] bg-clip-text text-2xl leading-normal font-bold text-transparent">สิ่งที่เรารับผิดชอบต่อบัญชีสมาชิกและการติดต่อกลับ</h2>

      <p class="mb-2 text-left text-base leading-relaxed text-[#f2e2e4]">
        เรื่องบัญชีเป็นส่วนที่เราถือว่าสำคัญที่สุด ทีมงานจะไม่ขอรหัสผ่านหรือรหัสยืนยันจากสมาชิกไม่ว่ากรณีใด ไม่ว่าจะผ่านช่องทางส่วนตัวหรือช่องทางสาธารณะ
        ถ้ามีข้อความในลักษณะนั้นส่งมา ให้ถือว่าไม่ได้มาจากเรา และเราแนะนำให้เข้าใช้งานผ่านช่องทางหลักที่ตรวจชื่อเว็บไซต์และการเชื่อมต่อแบบ HTTPS แล้วเท่านั้น
        ไม่ใช่ลิงก์ที่ส่งต่อกันมาพร้อมคำโฆษณา ควรตั้งรหัสผ่านที่คาดเดายาก เลี่ยงเครือข่ายสาธารณะเมื่อต้องทำธุรกรรม และออกจากระบบทุกครั้งเมื่อใช้อุปกรณ์ที่ไม่ใช่ของตนเอง
        ด้านการทำรายการ ควรใช้ข้อมูลที่ตรงกับตอนสมัคร ตรวจยอดคงเหลือและเงื่อนไขโปรโมชั่นที่ค้างอยู่ก่อนกดยืนยัน และเก็บรายละเอียดรายการไว้จนกว่าระบบจะแสดงสถานะสำเร็จ
        ด้านการติดต่อ ทีมงานดูแลสมาชิกของ KIKI49 รับเรื่องตลอด 24 ชั่วโมงผ่านช่องทางที่เว็บไซต์ระบุ ทั้งเรื่องบัญชี ทางเข้าเล่น โปรโมชั่น และสถานะฝากถอน
        การแจ้งชื่อผู้ใช้ เวลาที่ทำรายการ และรายละเอียดของรายการมาให้ครบตั้งแต่ข้อความแรก จะช่วยให้เราตรวจสอบต้นเหตุได้ตรงจุดและเร็วขึ้น โดยไม่ต้องเปิดเผยรหัสผ่านหรือรหัสยืนยันบัญชี
        สุดท้ายเราขอย้ำว่าการเล่นสล็อตควรอยู่ในวงเงินที่ไม่กระทบค่าใช้จ่ายส่วนตัว กำหนดเวลาและงบประมาณให้ชัดเจนก่อนเริ่ม และไม่ควรเพิ่มทุนเพื่อตามยอดที่เสียไป
      </p>
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
