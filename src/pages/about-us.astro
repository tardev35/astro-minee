---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement3.astro";
import { pageGraph } from "../lib/schema";

const pageTitle = "เกี่ยวกับ LOTTO77 เว็บซื้อหวยออนไลน์ที่รวมทุกขั้นตอนไว้ในระบบเดียว";

// One string, three jobs: MainLayout's <meta name="description">, the WebPage
// node's description, and nothing else. 150–160 CHARACTERS (Thai is 3 bytes per
// character, so a byte count reads ~3x too long). This one is 154.
//
// Body copy is deliberately written as "about the site" — what the platform is,
// what a member does with it end to end, and the limits we ask people to hold —
// so it does not restate the home page's docx sections, which cover the same
// ground as step-by-step instructions. Two URLs repeating one set of H2s is the
// failure mode this page exists to avoid.
const pageDescription =
  "LOTTO77 เว็บซื้อหวยออนไลน์ที่รวมการเลือกประเภทหวย กรอกเลข ตรวจโพย และติดตามผลรางวัลไว้ในระบบเดียว พร้อมแนวทางการใช้งานอย่างมีขอบเขตและตรวจสอบข้อมูลได้จริง";

const graph = pageGraph(Astro, {
  type: "AboutPage",
  name: pageTitle,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "เกี่ยวกับเรา", path: "/about-us" },
  ],
});

// h2 inside the card: red → gold, the reverse direction of ContentBox's own h1
// gradient (gold → red) so the two heading levels stay visually distinct. Every
// stop is a palette colour that stays legible on the deep maroon card.
const sectionHeadingClass = "bg-gradient-to-r from-[#ff3d3d] via-[#f5c451] to-[#ffe08a] bg-clip-text text-2xl leading-normal font-bold text-transparent";
---

<MainLayout title="LOTTO77 | เกี่ยวกับเราและแนวทางให้บริการหวยออนไลน์" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={pageTitle} as="h1">
    <div>
      <h2 class={`mb-6 ${sectionHeadingClass}`}>LOTTO77 คือแพลตฟอร์มแบบไหน และเว็บไซต์นี้มีหน้าอะไรอยู่บ้าง</h2>

      <p class="mb-6 text-left text-base leading-relaxed">
        <strong>LOTTO77</strong> เป็นแพลตฟอร์มหวยออนไลน์ที่ทำหน้าที่เดียว คือรวมขั้นตอนของการซื้อหวยไว้ในระบบเดียวกัน ตั้งแต่การเลือกประเภทหวย การกรอกตัวเลข การบันทึกโพย ไปจนถึงการตรวจสอบสถานะรายการและผลรางวัล
        โดยไม่ต้องสลับไปมาระหว่างหลายหน้าหรือหลายบัญชี ระบบเปิดผ่านเบราว์เซอร์ได้ทั้งบนมือถือและคอมพิวเตอร์ ตำแหน่งเมนูและลำดับของข้อมูลจึงอยู่ที่เดิมเมื่อเปลี่ยนอุปกรณ์ระหว่างวัน และไม่ต้องติดตั้งโปรแกรมเพิ่ม
        สิ่งที่เราให้ความสำคัญไม่ใช่จำนวนฟีเจอร์ แต่เป็นการทำให้ข้อมูลที่ต้องใช้ตัดสินใจอยู่ใกล้ปุ่มที่ต้องกด ทั้งวันออกรางวัล เวลาเปิดปิดรับเดิมพัน อัตราจ่ายที่ระบบแสดงอยู่ในขณะนั้น และสถานะของเลขที่เลือก
        เพราะข้อมูลเหล่านี้เปลี่ยนได้ตามงวดและตามประเภทหวย การวางไว้ให้เห็นก่อนกดยืนยันจึงช่วยลดการเลือกงวดผิด เลือกประเภทเดิมพันผิด หรือกรอกเลขสลับกัน ซึ่งเป็นความผิดพลาดที่พบบ่อยที่สุดของการซื้อหวยออนไลน์
        เนื้อหาบนเว็บไซต์แบ่งเป็นหน้าย่อยไม่กี่หน้าเพื่อให้หาสิ่งที่ต้องการได้เร็ว ได้แก่ หน้าแรกที่อธิบายภาพรวมของระบบและเงื่อนไขการใช้งาน หน้าโปรโมชั่นที่แจกแจงสิทธิ์และข้อกำหนดของแต่ละรายการ
        หน้าตรวจหวยสำหรับดูวิธีเทียบผลรางวัลกับโพยที่บันทึกไว้ หน้าแนวทางที่รวบรวมข้อมูลประกอบการตัดสินใจพร้อมข้อจำกัดของมัน หน้าทดลองใช้งานสำหรับศึกษาระบบก่อนซื้อจริง หน้าทางเข้าสำหรับเข้าใช้งานผ่านช่องทางหลัก
        และหน้าติดต่อเราสำหรับส่งเรื่องถึงทีมงานโดยตรง หน้านี้ไม่ใช่คู่มือการใช้งาน แต่มีไว้บอกว่าเราเป็นใคร ตั้งใจให้บริการแบบไหน และผู้ใช้งานควรคาดหวังอะไรได้จากเว็บไซต์นี้
      </p>

      <h2 class={`mt-8 mb-6 ${sectionHeadingClass}`}>สมาชิกทำอะไรได้บ้างบน LOTTO77 ตั้งแต่เลือกหวยจนตรวจผลรางวัล</h2>

      <p class="mb-6 text-left text-base leading-relaxed">
        เส้นทางการใช้งานบน LOTTO77 เดินเป็นลำดับเดียวกันเสมอ เริ่มจากเลือกประเภทหวยที่เปิดรับในรอบนั้น ทั้งหวยรัฐบาล หวยลาว หวยฮานอย และหวยยี่กี ซึ่งแต่ละตลาดมีวันออกรางวัลและเวลาปิดรับไม่ตรงกัน
        ระบบจึงจัดหมวดไว้แยกกันพร้อมแสดงงวดที่กำลังเปิดอยู่ เพื่อให้เห็นตั้งแต่ต้นว่ากำลังซื้อของงวดไหน ขั้นถัดมาคือกรอกตัวเลขตามรูปแบบการเดิมพันที่ต้องการ ไม่ว่าจะเป็นสองตัวบน สองตัวล่าง สามตัวบน สามตัวโต๊ด หรือเลขวิ่ง
        ซึ่งแต่ละรูปแบบใช้จำนวนหลักและอัตราจ่ายคนละชุด จากนั้นระบบจะรวมรายการที่กรอกไว้เป็นโพยให้ตรวจทวนก่อนยืนยัน ทั้งตัวเลข ประเภทเดิมพัน จำนวนเงินต่อรายการ และยอดรวมทั้งโพย
        ขั้นตอนตรวจทวนนี้คือจุดที่คุ้มค่าที่สุดในทั้งกระบวนการ โดยเฉพาะเมื่อซื้อหลายเลขพร้อมกัน การแบ่งโพยเป็นชุดย่อยแล้วไล่ดูทีละรายการใช้เวลาไม่กี่สิบวินาที แต่ช่วยตัดปัญหาที่แก้ไม่ได้หลังกดยืนยันออกไปเกือบทั้งหมด
        หลังส่งรายการแล้ว สมาชิกยังกลับมาดูโพยที่ส่งไปได้จากหน้าบัญชีของตนเอง ทั้งสถานะของแต่ละรายการและข้อมูลผลรางวัลตามที่ระบบแสดง รวมถึงประวัติย้อนหลังของงวดก่อนหน้า
        เราแนะนำให้ยึดข้อมูลจากหน้าบัญชีเป็นหลักเสมอ และเก็บเลขอ้างอิงของโพยไว้จนกว่าจะประกาศผลและสถานะรายการปิดรอบ มากกว่าการยึดภาพหน้าจอหรือข้อความที่ส่งต่อกันมาจากแหล่งที่ตรวจสอบต้นทางไม่ได้
      </p>

      <h2 class={`mt-8 mb-6 ${sectionHeadingClass}`}>แนวทางการใช้งานอย่างมีขอบเขต และการดูแลบัญชีของสมาชิก</h2>

      <p class="mb-2 text-left text-base leading-relaxed">
        เรื่องที่เราพูดตรงไปตรงมาตั้งแต่ต้นคือ ผลการออกรางวัลไม่สามารถคาดเดาหรือรับประกันได้ ไม่ว่าจะซื้อผ่านระบบที่สะดวกเพียงใดก็ตาม ความสะดวกของหวยออนไลน์ช่วยลดขั้นตอนของการเลือกเลขและส่งโพยเท่านั้น
        ไม่ได้เปลี่ยนความน่าจะเป็นของงวดใดเลย ด้วยเหตุนี้เราจึงขอให้ผู้ใช้งานกำหนดวงเงินต่อหนึ่งงวดไว้ล่วงหน้า ใช้เฉพาะเงินที่ไม่กระทบค่าใช้จ่ายจำเป็น และไม่เพิ่มยอดเพื่อชดเชยการเสียจากงวดก่อน
        ข้อมูลอย่างสถิติย้อนหลังหรือแนวทางที่รวบรวมไว้บนเว็บไซต์เป็นข้อมูลประกอบการตัดสินใจ ไม่ใช่การชี้เลขและไม่ใช่คำรับประกันผล คำโฆษณาทั่วไปอย่างเลขอั้นน้อยก็เช่นกัน ควรอ่านคู่กับสถานะเลขและอัตราจ่ายที่ระบบแสดงจริงในงวดนั้น
        เพราะเลขบางชุดอาจถูกจำกัดวงเงิน ปรับราคา หรือหยุดรับเมื่อยอดถึงระดับที่กำหนด และเงื่อนไขเหล่านี้ต่างกันได้ในแต่ละงวด ด้านบัญชี ขอให้เข้าใช้งานผ่านช่องทางหลักที่เว็บไซต์กำหนด ไม่ใช่ลิงก์ที่ส่งต่อกันมาพร้อมคำโฆษณา
        ตรวจชื่อเว็บไซต์และการเชื่อมต่อแบบ HTTPS ทุกครั้งก่อนกรอกข้อมูล ตั้งรหัสผ่านที่คาดเดายากและไม่ซ้ำกับบริการอื่น เลี่ยงเครือข่ายสาธารณะเมื่อต้องจัดการข้อมูลบัญชี และออกจากระบบเมื่อใช้อุปกรณ์ร่วมกับผู้อื่น
        ทีมงานจะไม่ขอรหัสผ่านหรือรหัสยืนยันจากสมาชิกไม่ว่ากรณีใดและไม่ว่าผ่านช่องทางใด หากมีข้อความในลักษณะนั้นส่งมา ให้ถือว่าไม่ได้มาจากเรา และเมื่อพบรายการที่ผิดปกติ ให้เก็บเวลา จำนวนเงิน และเลขอ้างอิงของโพยไว้แจ้งทีมงานตั้งแต่ข้อความแรก
        เพื่อให้ตรวจสอบต้นเหตุได้ตรงจุดโดยไม่ต้องเปิดเผยข้อมูลลับของบัญชีแก่ผู้ใด
      </p>
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
