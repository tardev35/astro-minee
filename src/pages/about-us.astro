---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement5.astro";
import { pageGraph } from "../lib/schema";

const pageTitle = "เกี่ยวกับ FINN20 บาคาร่าเว็บตรงที่รวมโต๊ะเกมและระบบฝากถอนออโต้ไว้ในบัญชีเดียว";

// One string, two jobs: MainLayout's <meta name="description"> and the WebPage
// node's description. This page has no docx SUB-PAGES row, so the sentence is
// written here and length-checked against tools/verify-build.mjs, which wants
// 150–160 CHARACTERS (Thai is 3 bytes per character, so a byte count reads ~3x
// too long). This one is 157 — one sentence saying what the page is for, not
// the page's outline packed into a tag.
//
// Body copy is deliberately written as "about the site" — what the platform is,
// what a member does with it end to end, and the limits we ask people to hold —
// so it does not restate the home page's docx sections, which cover the same
// ground as guidance on table choice, provider checks, the auto cashier, the
// "ไม่ล็อคผล" wording and the Banker/Player/Tie payout split. Two URLs repeating
// one set of H2s is the failure mode this page exists to avoid, so the three H2s
// below are this page's own and deliberately do not echo any docx heading.
//
// <Announcement /> is bare: Announcement5's default message is this brand's
// copy, so the ticker matches index.astro without a second string here.
const pageDescription = "หน้านี้อธิบายว่า FINN20 เป็นแพลตฟอร์มบาคาร่าออนไลน์แบบใด ให้บริการด้วยแนวทางแบบไหน สมาชิกใช้งานระบบโต๊ะเกมและฝากถอนออโต้ได้ถึงขั้นไหน และเรื่องใดที่ไม่รับปาก";

const graph = pageGraph(Astro, {
  type: "AboutPage",
  name: pageTitle,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "เกี่ยวกับเรา", path: "/about-us" },
  ],
});

// h2 inside the card: gold → bright gold → silver, the reverse direction of
// ContentBox's own h1 gradient (silver → bright gold → gold) so the two heading
// levels stay visually distinct. Gold and silver carry the type on this brand;
// the deep gold stays on the surfaces, because a #e39d02 heading on a dark
// #14110a card is where the contrast goes.
const sectionHeadingClass = "bg-gradient-to-r from-[#fdd323] via-[#ffe98a] to-[#d7dbe1] bg-clip-text text-2xl leading-normal font-bold text-transparent";
---

<MainLayout title="FINN20 | เกี่ยวกับเราและแนวทางให้บริการบาคาร่าออนไลน์" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={pageTitle} as="h1">
    <div>
      <h2 class={`mb-6 ${sectionHeadingClass}`}>FINN20 คือแพลตฟอร์มแบบไหน และเว็บไซต์นี้ประกอบด้วยหน้าอะไรบ้าง</h2>

      <p class="mb-6 text-left text-base leading-relaxed text-[#f3e7c8]">
        <strong class="text-[#fdd323]">FINN20</strong> เป็นแพลตฟอร์มบาคาร่าออนไลน์ที่ทำหน้าที่เดียว คือรวมโต๊ะบาคาร่าหลายรูปแบบจากหลายผู้ให้บริการและระบบจัดการบัญชีไว้ในที่เดียวผ่านระบบใช้งานชุดเดียว แทนที่จะต้องเปิดหลายเว็บไซต์
        สมัครหลายบัญชี และย้ายเครดิตไปมาระหว่างระบบ ทุกหมวดโต๊ะและทุกรายการอยู่ในชุดหน้าจอเดียวกัน จะไล่ดูโต๊ะตามผู้ให้บริการ ตามระดับวงเงิน หรือเทียบความเร็วของรอบก่อนตัดสินใจก็ได้ ระบบสมาชิก โปรโมชั่น ประวัติเดิมพัน
        และสถานะธุรกรรมก็อยู่ที่เดียวกันนั้น ระบบเปิดผ่านเบราว์เซอร์ได้ทั้งบนมือถือและคอมพิวเตอร์โดยไม่ต้องติดตั้งโปรแกรมเพิ่ม ตำแหน่งเมนูและลำดับของข้อมูลจึงอยู่ที่เดิมเมื่อเปลี่ยนอุปกรณ์ระหว่างวัน สิ่งที่เราให้ความสำคัญไม่ใช่จำนวนโต๊ะในระบบ
        แต่เป็นการทำให้ข้อมูลที่ต้องใช้ตัดสินใจอยู่ใกล้ปุ่มที่ต้องกด ทั้งชื่อผู้ให้บริการเกมที่ดูแลโต๊ะนั้น อัตราจ่ายของ Banker, Player และ Tie ค่าคอมมิชชันที่หักเมื่อชนะฝั่ง Banker เดิมพันขั้นต่ำและสูงสุดต่อรอบ ขั้นตอนฝากถอนออโต้ที่ระบบรองรับ
        เงื่อนไขของโปรโมชั่นที่กำลังเปิดอยู่ และสถานะล่าสุดของบัญชี เพราะข้อมูลเหล่านี้ต่างกันในแต่ละโต๊ะและปรับได้ตามรอบ การวางไว้ให้เห็นก่อนกดยืนยันจึงช่วยลดการเลือกโต๊ะผิดจากที่ตั้งใจ เข้าใจเงื่อนไขค่าคอมมิชชันคลาดเคลื่อน
        หรือกดยืนยันรายการฝากถอนซ้ำโดยไม่จำเป็น ซึ่งเป็นความผิดพลาดที่พบบ่อยที่สุดของผู้เล่นใหม่ เนื้อหาบนเว็บไซต์แบ่งเป็นหน้าย่อยไม่กี่หน้าเพื่อให้หาสิ่งที่ต้องการได้เร็ว ได้แก่ หน้าแรกที่อธิบายภาพรวมของระบบและเงื่อนไขการใช้งาน
        หน้าโปรโมชั่นที่แจกแจงสิทธิ์และข้อกำหนดของแต่ละรายการ หน้าทดลองเล่นสำหรับศึกษากติกาและจังหวะของโต๊ะก่อนเล่นด้วยเงินจริง หน้าทางเข้าสำหรับเข้าใช้งานผ่านช่องทางหลัก และหน้าติดต่อเราสำหรับส่งเรื่องถึงทีมงานโดยตรง
        หน้านี้ไม่ใช่คู่มือการใช้งาน แต่มีไว้บอกว่าเราเป็นใคร ตั้งใจให้บริการแบบไหน และผู้ใช้งานควรคาดหวังอะไรได้จากเว็บไซต์นี้
      </p>

      <h2 class={`mt-8 mb-6 ${sectionHeadingClass}`}>สมาชิกใช้งาน FINN20 ได้ตั้งแต่ขั้นไหนจนถึงขั้นไหน</h2>

      <p class="mb-6 text-left text-base leading-relaxed text-[#f3e7c8]">
        เส้นทางการใช้งานบน FINN20 เดินเป็นลำดับเดียวกันเสมอ เริ่มจากเข้าสู่ระบบผ่านช่องทางหลัก แล้วเลือกว่ารอบนี้จะลงโต๊ะไหน ซึ่งแต่ละโต๊ะมีวงเงินต่อรอบขั้นต่ำ ขั้นสูงสุด และความเร็วของรอบไม่เหมือนกัน
        ตัวเกมเองจบผลในรอบสั้น ๆ และเปิดรอบใหม่ได้ทันที จุดนี้จึงเป็นจุดที่วงเงินหมดเร็วที่สุดถ้าไม่ได้ตั้งไว้ล่วงหน้า ก่อนลงเดิมพันจริงจึงควรอ่านอัตราจ่ายของแต่ละฝั่ง ค่าคอมมิชชัน
        และเงื่อนไขของเดิมพันเสริมบนโต๊ะนั้นให้จบก่อน นี่คือขั้นที่เราอยากให้ใช้เวลามากที่สุด ส่วนฝั่งการเงินเดินคนละแบบ คือผูกกับระบบฝากถอนออโต้ที่จัดการได้จากหน้าบัญชีโดยตรง ก่อนยืนยันควรตรวจชื่อบัญชี
        จำนวนเงิน ข้อมูลรับเงิน และเงื่อนไขโปรโมชั่นให้ตรงกันทั้งสี่อย่าง เพราะเมื่อยืนยันแล้วรายการจะเข้าสู่ระบบทันที เมื่อทำรายการแล้ว ทุกอย่างที่เกิดขึ้นกับเครดิตจะไปปรากฏที่หน้าบัญชี
        ทั้งยอดคงเหลือ ประวัติการฝากถอน ประวัติเดิมพัน สถานะของรายการที่ยังดำเนินการอยู่ และผลของรอบที่จบไปแล้ว เราแนะนำให้ยึดข้อมูลจากหน้าบัญชีเป็นหลักเสมอ และเก็บเวลา จำนวนเงิน
        กับเลขอ้างอิงของรายการไว้จนกว่าสถานะจะปิดรอบ มากกว่าการยึดภาพหน้าจอหรือข้อความที่ส่งต่อกันมาจากแหล่งที่ตรวจสอบต้นทางไม่ได้ และถ้ารายการหนึ่งยังค้างอยู่ ขอให้รอสถานะเดิมจบก่อนเสมอ
        การกดส่งคำขอซ้ำระหว่างนั้นไม่ได้ทำให้เร็วขึ้น แต่ทำให้การไล่ตรวจย้อนหลังยากขึ้นสำหรับทั้งสองฝ่าย
      </p>

      <h2 class={`mt-8 mb-6 ${sectionHeadingClass}`}>สิ่งที่เราไม่รับปาก และขอบเขตที่อยากให้ผู้ใช้งานตั้งไว้ก่อนเริ่ม</h2>

      <p class="mb-2 text-left text-base leading-relaxed text-[#f3e7c8]">
        เรื่องที่เราพูดตรงไปตรงมาตั้งแต่ต้นคือ ผลของบาคาร่าแต่ละรอบตัดสินจากไพ่ที่แจกในรอบนั้นและไม่มีใครรับประกันได้
        ถ้อยคำอย่างไม่ล็อคผลหรือจ่ายไวใช้สื่อถึงลักษณะการดำเนินเกมและความชัดเจนของขั้นตอนที่ตรวจสอบได้เท่านั้น ไม่ได้เป็นการรับประกันความยุติธรรมโดยอัตโนมัติ ไม่ได้เป็นหลักฐานว่าจะได้ผลลัพธ์ตามคาดในรอบใด
        และไม่ได้เป็นคำมั่นเรื่องระยะเวลาของธุรกรรมทุกกรณี สิ่งที่ควรใช้ประเมินคือชื่อผู้ให้บริการเกมที่ระบบแสดง ความชัดเจนของกติกาและอัตราจ่ายบนโต๊ะ ประวัติรายการที่ระบบแสดง และช่องทางติดต่อที่ใช้ได้จริง
        มากกว่าข้อความโฆษณาเพียงอย่างเดียว สิ่งที่ควรดูควบคู่กันคือค่าคอมมิชชันและความเร็วของรอบบนโต๊ะที่เลือก เพราะโต๊ะที่เดินเร็วใช้เงินต่อชั่วโมงมากกว่าโต๊ะที่ให้เวลาตัดสินใจนานกว่า
        ทั้งสองแบบไม่ได้ดีกว่ากัน แต่เหมาะกับงบคนละขนาดและความอดทนคนละแบบ ด้วยเหตุนี้เราจึงขอให้ผู้ใช้งานกำหนดวงเงินและระยะเวลาไว้ล่วงหน้า ใช้เฉพาะเงินที่ไม่กระทบค่าใช้จ่ายจำเป็น
        และไม่เพิ่มยอดต่อรอบเพื่อหวังตามคืนยอดที่เสียไปแล้วหรือเพิ่มตามอารมณ์ระหว่างเล่น เพราะแต่ละรอบเป็นผลลัพธ์ที่ไม่ขึ้นกับรอบก่อนหน้า ด้านบัญชี ขอให้เข้าใช้งานผ่านช่องทางหลักที่เว็บไซต์กำหนด
        ไม่ใช่ลิงก์ที่ส่งต่อกันมาพร้อมคำโฆษณา ตรวจชื่อเว็บไซต์และการเชื่อมต่อแบบ HTTPS ทุกครั้งก่อนกรอกข้อมูล ตั้งรหัสผ่านที่คาดเดายากและไม่ซ้ำกับบริการอื่น เลี่ยงเครือข่าย Wi-Fi
        สาธารณะเมื่อต้องทำธุรกรรม และออกจากระบบเมื่อใช้อุปกรณ์ร่วมกับผู้อื่น ทีมงานจะไม่ขอรหัสผ่านหรือรหัสยืนยันจากสมาชิกไม่ว่ากรณีใดและไม่ว่าผ่านช่องทางใด หากมีข้อความในลักษณะนั้นส่งมา
        ให้ถือว่าไม่ได้มาจากเรา และเมื่อพบรายการที่ผิดปกติ ให้เก็บเวลา จำนวนเงิน และเลขอ้างอิงของรายการไว้แจ้งทีมงานตั้งแต่ข้อความแรก
        เพื่อให้ตรวจสอบต้นเหตุได้ตรงจุดโดยไม่ต้องเปิดเผยข้อมูลลับของบัญชีแก่ผู้ใด
      </p>
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
