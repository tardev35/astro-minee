---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement5.astro";
import { pageGraph } from "../lib/schema";

const pageTitle = "เกี่ยวกับ CHICKYLUCKY แพลตฟอร์มสล็อตที่รวมเกมจากหลายผู้ให้บริการไว้ในระบบเดียว";

// One string, three jobs: MainLayout's <meta name="description">, the WebPage
// node's description, and nothing else. The docx has no /about-us row, so this
// is written here and must land in 150–160 CHARACTERS (Thai is 3 bytes per
// character, so a byte count reads ~3x too long). This one is 152.
//
// Body copy is deliberately written as "about the site" — what the platform is,
// what a member does with it end to end, and the limits we ask people to hold —
// so it does not restate the home page's docx sections, which cover the same
// ground as step-by-step instructions. Two URLs repeating one set of H2s is the
// failure mode this page exists to avoid, so the three H2s below are this
// page's own and deliberately do not echo the docx headings.
const pageDescription =
  "CHICKYLUCKY แพลตฟอร์มสล็อตที่รวมเกมจากผู้ให้บริการหลายรายผ่าน API ตรง พร้อมระบบบัญชี โปรโมชั่น และธุรกรรมในที่เดียว รวมถึงข้อแนะนำการใช้งานอย่างมีขอบเขต";

const graph = pageGraph(Astro, {
  type: "AboutPage",
  name: pageTitle,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "เกี่ยวกับเรา", path: "/about-us" },
  ],
});

// h2 inside the card: red → chick-yellow, the reverse direction of ContentBox's
// own h1 gradient (yellow → red) so the two heading levels stay visually
// distinct. Every stop is a palette colour that stays legible on the deep
// maroon card.
const sectionHeadingClass = "bg-gradient-to-r from-[#ff5252] via-[#fde41a] to-[#fff17a] bg-clip-text text-2xl leading-normal font-bold text-transparent";
---

<MainLayout title="CHICKYLUCKY | เกี่ยวกับเราและหลักการให้บริการเกมสล็อตออนไลน์" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={pageTitle} as="h1">
    <div>
      <h2 class={`mb-6 ${sectionHeadingClass}`}>CHICKYLUCKY คือแพลตฟอร์มแบบไหน และเว็บไซต์นี้ประกอบด้วยหน้าอะไรบ้าง</h2>

      <p class="mb-6 text-left text-base leading-relaxed">
        <strong>CHICKYLUCKY</strong> เป็นแพลตฟอร์มเกมสล็อตออนไลน์ที่ทำหน้าที่เดียว คือเป็นหน้าเดียวที่เชื่อมผู้เล่นเข้ากับเกมจากผู้ให้บริการหลายรายผ่านการเชื่อมต่อแบบ API ตรง แทนที่จะต้องเปิดหลายเว็บไซต์ สมัครหลายบัญชี
        และย้ายเครดิตไปมาระหว่างค่าย เกมทั้งหมดถูกจัดหมวดไว้ที่เดียวกัน จะไล่ดูตามผู้ให้บริการ ตามธีมของเกม หรือตามรูปแบบฟีเจอร์ก็ได้ ระบบบัญชี โปรโมชั่น และประวัติธุรกรรมก็อยู่ในชุดหน้าจอเดียวกันนั้น
        ระบบเปิดผ่านเบราว์เซอร์ได้ทั้งบนมือถือและคอมพิวเตอร์โดยไม่ต้องติดตั้งโปรแกรมเพิ่ม ตำแหน่งเมนูและลำดับของข้อมูลจึงอยู่ที่เดิมเมื่อเปลี่ยนอุปกรณ์ระหว่างวัน
        สิ่งที่เราให้ความสำคัญไม่ใช่จำนวนเกมในระบบ แต่เป็นการทำให้ข้อมูลที่ต้องใช้ตัดสินใจอยู่ใกล้ปุ่มที่ต้องกด ทั้งชื่อผู้ให้บริการของเกมนั้น กติกาและตารางการจ่ายของตัวเกม เงื่อนไขของโปรโมชั่นที่กำลังเปิดอยู่ และสถานะล่าสุดของบัญชี
        เพราะข้อมูลเหล่านี้ต่างกันในแต่ละเกมและปรับได้ตามรอบ การวางไว้ให้เห็นก่อนกดหมุนจึงช่วยลดการเปิดเกมผิดตัว เข้าใจเงื่อนไขโบนัสคลาดเคลื่อน หรือวางเดิมพันต่อสปินคนละระดับกับที่ตั้งใจ ซึ่งเป็นความผิดพลาดที่พบบ่อยที่สุดของผู้เล่นใหม่
        เนื้อหาบนเว็บไซต์แบ่งเป็นหน้าย่อยไม่กี่หน้าเพื่อให้หาสิ่งที่ต้องการได้เร็ว ได้แก่ หน้าแรกที่อธิบายภาพรวมของระบบและเงื่อนไขการใช้งาน หน้าโปรโมชั่นที่แจกแจงสิทธิ์และข้อกำหนดของแต่ละรายการ
        หน้าทดลองเล่นสำหรับศึกษากติกาและฟีเจอร์ของเกมก่อนลงเงินจริง หน้าทางเข้าสำหรับเข้าใช้งานผ่านช่องทางหลัก และหน้าติดต่อเราสำหรับส่งเรื่องถึงทีมงานโดยตรง
        หน้านี้ไม่ใช่คู่มือการใช้งาน แต่มีไว้บอกว่าเราเป็นใคร ตั้งใจให้บริการแบบไหน และผู้ใช้งานควรคาดหวังอะไรได้จากเว็บไซต์นี้
      </p>

      <h2 class={`mt-8 mb-6 ${sectionHeadingClass}`}>สมาชิกใช้งาน CHICKYLUCKY ได้ตั้งแต่ขั้นไหนจนถึงขั้นไหน</h2>

      <p class="mb-6 text-left text-base leading-relaxed">
        เส้นทางการใช้งานบน CHICKYLUCKY เดินเป็นลำดับเดียวกันเสมอ เริ่มจากเข้าสู่ระบบผ่านช่องทางหลัก แล้วเลือกเกมจากหมวดที่ระบบจัดไว้ ซึ่งแยกตามผู้ให้บริการ ตามธีม และตามรูปแบบฟีเจอร์ เช่น เกมที่มีฟรีสปิน เกมที่มีตัวคูณ หรือเกมที่สะสมแจ็กพอต
        ก่อนกดเข้าเกม หน้ารายละเอียดจะแสดงชื่อผู้ให้บริการและข้อมูลที่ระบบมีของเกมนั้นไว้ให้อ่าน จุดนี้คือจุดที่เราอยากให้ใช้เวลามากที่สุด เพราะเป็นที่เดียวที่บอกได้ว่ากำลังจะเปิดเกมของค่ายใด
        ขั้นถัดมาคือการอ่านกติกาในตัวเกม ทั้งจำนวนไลน์ที่จ่าย สัญลักษณ์พิเศษ เงื่อนไขการเข้าฟีเจอร์โบนัส และตารางการจ่ายของแต่ละสัญลักษณ์ ซึ่งเกมแต่ละตัวกำหนดไว้คนละชุด แล้วจึงตั้งระดับเดิมพันต่อสปินให้สอดคล้องกับงบที่เตรียมไว้
        เมื่อเล่นแล้ว ทุกอย่างที่เกิดขึ้นกับเครดิตจะไปปรากฏที่หน้าบัญชี ทั้งยอดคงเหลือ ประวัติการฝากถอน สถานะของรายการที่ยังดำเนินการอยู่ และประวัติย้อนหลังของรอบก่อนหน้า
        เราแนะนำให้ยึดข้อมูลจากหน้าบัญชีเป็นหลักเสมอ และเก็บเวลา จำนวนเงิน กับข้อมูลอ้างอิงของรายการไว้จนกว่าสถานะจะปิดรอบ มากกว่าการยึดภาพหน้าจอหรือข้อความที่ส่งต่อกันมาจากแหล่งที่ตรวจสอบต้นทางไม่ได้
        และถ้ารายการหนึ่งยังค้างอยู่ ขอให้รอสถานะเดิมจบก่อนเสมอ การกดส่งคำขอซ้ำระหว่างนั้นไม่ได้ทำให้เร็วขึ้น แต่ทำให้การไล่ตรวจย้อนหลังยากขึ้นสำหรับทั้งสองฝ่าย
      </p>

      <h2 class={`mt-8 mb-6 ${sectionHeadingClass}`}>สิ่งที่เราไม่รับปาก และขอบเขตที่อยากให้ผู้เล่นตั้งไว้ก่อนเริ่ม</h2>

      <p class="mb-2 text-left text-base leading-relaxed">
        เรื่องที่เราพูดตรงไปตรงมาตั้งแต่ต้นคือ ผลของเกมสล็อตคาดเดาไม่ได้และไม่มีใครรับประกันได้ คำโฆษณาทั่วไปอย่างแตกง่ายหรือจ่ายไวสื่อถึงเกมที่มีฟีเจอร์โบนัสถี่หรือจังหวะลุ้นรางวัลน่าสนใจเท่านั้น
        ไม่ได้แปลว่าจะได้ผลลัพธ์ตามคาดในรอบใด และไม่ได้เป็นคำมั่นเรื่องระยะเวลาของธุรกรรมทุกกรณี สิ่งที่ควรดูควบคู่กันคือระดับความผันผวนของเกม เพราะเกมความผันผวนสูงจ่ายห่างแต่ก้อนใหญ่ ส่วนเกมความผันผวนต่ำจ่ายถี่แต่ก้อนเล็ก
        ทั้งสองแบบไม่ได้ดีกว่ากัน แต่เหมาะกับงบคนละขนาด ด้วยเหตุนี้เราจึงขอให้ผู้ใช้งานกำหนดวงเงินต่อหนึ่งรอบไว้ล่วงหน้า ใช้เฉพาะเงินที่ไม่กระทบค่าใช้จ่ายจำเป็น และไม่เพิ่มยอดเดิมพันเพื่อชดเชยรอบที่เสียไปแล้ว
        คำว่าเกมลิขสิทธิ์แท้ก็อยู่ในกรอบเดียวกัน คือควรพิจารณาจากชื่อผู้ให้บริการและรายละเอียดที่ระบบแสดงในหน้าเกม ไม่ใช่จากข้อความโฆษณาเพียงอย่างเดียว
        ด้านบัญชี ขอให้เข้าใช้งานผ่านช่องทางหลักที่เว็บไซต์กำหนด ไม่ใช่ลิงก์ที่ส่งต่อกันมาพร้อมคำโฆษณา ตรวจชื่อเว็บไซต์และการเชื่อมต่อแบบ HTTPS ทุกครั้งก่อนกรอกข้อมูล ตั้งรหัสผ่านที่คาดเดายากและไม่ซ้ำกับบริการอื่น
        เลี่ยงเครือข่าย Wi-Fi สาธารณะเมื่อต้องทำธุรกรรม และออกจากระบบเมื่อใช้อุปกรณ์ร่วมกับผู้อื่น ทีมงานจะไม่ขอรหัสผ่านหรือรหัสยืนยันจากสมาชิกไม่ว่ากรณีใดและไม่ว่าผ่านช่องทางใด หากมีข้อความในลักษณะนั้นส่งมา ให้ถือว่าไม่ได้มาจากเรา
        และเมื่อพบรายการที่ผิดปกติ ให้เก็บเวลา จำนวนเงิน และข้อมูลอ้างอิงของรายการไว้แจ้งทีมงานตั้งแต่ข้อความแรก เพื่อให้ตรวจสอบต้นเหตุได้ตรงจุดโดยไม่ต้องเปิดเผยข้อมูลลับของบัญชีแก่ผู้ใด
      </p>
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
