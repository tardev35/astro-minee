---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement4.astro";
import { pageGraph } from "../lib/schema";

const pageTitle = "เกี่ยวกับ JERRY69 แพลตฟอร์มสล็อตออนไลน์ที่รวมเกมหลายค่ายและระบบบัญชีไว้ที่เดียว";

// One string, two jobs: MainLayout's <meta name="description"> and the WebPage
// node's description. This page has no docx SUB-PAGES row, so the sentence is
// written here and length-checked against tools/verify-build.mjs, which wants
// 150–160 CHARACTERS (Thai is 3 bytes per character, so a byte count reads ~3x
// too long). This one is 159 — one sentence saying what the page is for, not
// the page's outline packed into a tag.
//
// Body copy is deliberately written as "about the site" — what the platform is,
// what a member does with it end to end, and the limits we ask people to hold —
// so it does not restate the home page's docx sections, which cover the same
// ground as guidance on picking a game by feature rather than by studio name,
// what "สมัครฟรี" does and does not include, weighing a low-budget promotion
// against its withdrawal terms, reading RTP with volatility, managing an account
// through one system, and why "รวยไว" is not an income claim. Two URLs repeating
// one set of H2s is the failure mode this page exists to avoid, so the three H2s
// below are this page's own and deliberately do not echo any docx heading.
//
// <Announcement /> is bare: Announcement4's default message is this brand's
// copy, so the ticker matches index.astro without a second string here. The
// variant rotated off Announcement2, the outgoing brand's pick, per the spec.
//
// The brief names no wallet, no bank and no payment brand, so neither does this
// page: money language stays "ระบบของเว็บไซต์" and "ช่องทางที่เว็บไซต์กำหนด".
const pageDescription = "หน้านี้อธิบายว่า JERRY69 เป็นแพลตฟอร์มสล็อตออนไลน์แบบใด รวมเกมหลายค่ายไว้อย่างไร สมาชิกใช้งานตั้งแต่สมัครจนถึงตรวจสอบรายการได้แค่ไหน และเรื่องใดที่เราไม่รับปาก";

const graph = pageGraph(Astro, {
  type: "AboutPage",
  name: pageTitle,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "เกี่ยวกับเรา", path: "/about-us" },
  ],
});

// h2 inside the card: light gold → primary orange → deep bronze, i.e. the ramp
// read downward, where ContentBox's own h1 gradient starts on cream and climbs
// (#fff4e2 → #ffc94a → #fa8302). The two heading levels stay visually distinct
// without either one repeating the other's opening stop. The cream stays on the
// h1, because a second cream heading on a warm near-black card is where the
// hierarchy would collapse.
const sectionHeadingClass = "bg-gradient-to-r from-[#ffc94a] via-[#fa8302] to-[#c25302] bg-clip-text text-2xl leading-normal font-bold text-transparent";
---

<MainLayout title="JERRY69 | เกี่ยวกับเราและแนวทางให้บริการสล็อตออนไลน์" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={pageTitle} as="h1">
    <div>
      <h2 class={`mb-6 ${sectionHeadingClass}`}>JERRY69 คือแพลตฟอร์มแบบไหน และเว็บไซต์นี้ประกอบด้วยหน้าอะไรบ้าง</h2>

      <p class="mb-6 text-left text-base leading-relaxed text-[#f3e3d0]">
        <strong class="text-[#ffc94a]">JERRY69</strong> เป็นแพลตฟอร์มสล็อตออนไลน์ที่ทำหน้าที่เดียว คือรวบรวมเกมจากหลายค่ายที่ระบบรองรับมาไว้ในระบบเดียว แทนที่ผู้เล่นจะต้องเปิดหลายเว็บไซต์ สมัครหลายบัญชี
        และย้ายเครดิตไปมาระหว่างระบบ ทุกหมวดเกมและทุกรายการอยู่ในชุดหน้าจอเดียวกัน จะไล่ดูจากธีมของเกม จากฟีเจอร์โบนัส จากความเร็วของรอบ หรือจากระดับเดิมพันต่อรอบก่อนตัดสินใจก็ได้ ส่วนนี้เป็นเจตนาของเราโดยตรง
        คืออยากให้เลือกเกมจากลักษณะที่เข้ากับงบและความชอบ แทนการเลือกจากชื่อค่ายเพียงอย่างเดียว ระบบสมาชิก สิทธิ์โปรโมชั่น ประวัติรายการ และสถานะของธุรกรรมก็อยู่ที่เดียวกันนั้น ระบบเปิดผ่านเบราว์เซอร์ได้ทั้งบนมือถือและคอมพิวเตอร์โดยไม่ต้องติดตั้งโปรแกรมเพิ่ม
        ตำแหน่งเมนูและลำดับของข้อมูลจึงอยู่ที่เดิมเมื่อสลับอุปกรณ์ระหว่างวัน สิ่งที่เราให้ความสำคัญไม่ใช่จำนวนเกมในระบบ แต่เป็นการทำให้ข้อมูลที่ต้องใช้ตัดสินใจอยู่ใกล้ปุ่มที่ต้องกด ทั้งค่า RTP ที่ผู้ให้บริการเกมระบุไว้
        ระดับความผันผวนของเกม ตารางจ่ายและเงื่อนไขของฟีเจอร์โบนัส เดิมพันขั้นต่ำและสูงสุดต่อรอบ ยอดเริ่มต้นกับเกมที่ร่วมรายการของโปรโมชั่นที่กำลังเปิดอยู่ เงื่อนไขการถอนของรายการนั้น และสถานะล่าสุดของบัญชี
        เพราะข้อมูลเหล่านี้ต่างกันในแต่ละเกมและปรับได้ตามรอบ การวางไว้ให้เห็นก่อนกดยืนยันจึงช่วยลดการเลือกเกมผิดจากที่ตั้งใจ เข้าใจเงื่อนไขโบนัสหรือยอดเทิร์นคลาดเคลื่อน หรือกดยืนยันรายการซ้ำโดยไม่จำเป็น
        ซึ่งเป็นความผิดพลาดที่พบบ่อยที่สุดของผู้เล่นใหม่ เนื้อหาบนเว็บไซต์แบ่งเป็นหน้าย่อยไม่กี่หน้าเพื่อให้หาสิ่งที่ต้องการได้เร็ว ได้แก่ หน้าแรกที่อธิบายภาพรวมของระบบและเงื่อนไขการใช้งาน หน้าโปรโมชั่นที่แจกแจงสิทธิ์และข้อกำหนดของแต่ละรายการ
        หน้าทดลองเล่นสำหรับศึกษากติกาและฟีเจอร์ของเกมก่อนเล่นด้วยเงินจริง หน้าทางเข้าสำหรับเข้าใช้งานผ่านช่องทางหลัก และหน้าติดต่อเราสำหรับส่งเรื่องถึงทีมงานโดยตรง หน้านี้ไม่ใช่คู่มือการใช้งาน แต่มีไว้บอกว่าเราเป็นใคร
        ตั้งใจให้บริการแบบไหน และผู้ใช้งานควรคาดหวังอะไรได้จากเว็บไซต์นี้
      </p>

      <h2 class={`mt-8 mb-6 ${sectionHeadingClass}`}>สมาชิกใช้งาน JERRY69 ได้ตั้งแต่ขั้นไหนจนถึงขั้นไหน</h2>

      <p class="mb-6 text-left text-base leading-relaxed text-[#f3e3d0]">
        เส้นทางการใช้งานบน JERRY69 เดินเป็นลำดับเดียวกันเสมอ เริ่มจากการเปิดบัญชี ซึ่งเราระบุไว้ตรงไปตรงมาว่าการสมัครไม่มีค่าธรรมเนียมตามเงื่อนไขที่เว็บไซต์กำหนด
        แต่คำว่าสมัครฟรีครอบคลุมเฉพาะขั้นเปิดบัญชีเท่านั้น ไม่ได้แปลว่าทุกขั้นตอนหลังจากนั้นไม่มีเงื่อนไข เงื่อนไขด้านการฝาก การรับสิทธิ์โปรโมชั่น และการถอนเป็นคนละชุดกันและควรอ่านแยกกันตั้งแต่ต้น
        จากนั้นจึงเลือกว่ารอบนี้จะลงเกมไหน ซึ่งแต่ละเกมมีเดิมพันต่อรอบขั้นต่ำ ขั้นสูงสุด ค่า RTP ที่ผู้ให้บริการระบุ และระดับความผันผวนไม่เหมือนกัน
        หากเพิ่งเริ่มควรเลือกเกมที่กติกาชัดเจนและวงเงินต่อรอบไม่สูงเกินงบก่อน แล้วค่อยขยับไปเกมที่ซับซ้อนขึ้นเมื่อเข้าใจรูปแบบการจ่ายแล้ว ตัวเกมเองจบผลในไม่กี่วินาทีและเปิดรอบใหม่ได้ทันที
        จุดนี้จึงเป็นจุดที่วงเงินหมดเร็วที่สุดถ้าไม่ได้ตั้งไว้ล่วงหน้า ก่อนลงเดิมพันจริงจึงควรอ่านตารางจ่ายของเกมนั้น เงื่อนไขของฟีเจอร์โบนัสและฟรีสปิน รวมถึงจำนวนไลน์หรือรูปแบบการจ่ายให้จบก่อน
        นี่คือขั้นที่เราอยากให้ใช้เวลามากที่สุด ส่วนโปรโมชั่นสำหรับผู้เล่นงบไม่สูงที่เห็นในหน้าโปรโมชั่น ขอให้ดูยอดเริ่มต้น เกมที่ร่วมรายการ และเงื่อนไขการถอนพร้อมกันทั้งสามอย่าง
        ไม่ใช่ดูตัวเลขโบนัสอย่างเดียว เพราะโปรที่ให้โบนัสสูงที่สุดไม่จำเป็นต้องเป็นโปรที่เหมาะกับงบที่สุด และโปรที่เหมาะคือโปรที่ไม่บังคับให้ต้องเติมเงินเกินแผนที่ตั้งไว้ตั้งแต่แรก
        ฝั่งบัญชีเดินคนละแบบกับฝั่งเกม คือรวมข้อมูลบัญชี สิทธิ์โปรโมชั่นที่ถืออยู่ ประวัติรายการ และสถานะของรายการที่ยังดำเนินการอยู่ไว้ในระบบเดียว ก่อนยืนยันควรตรวจชื่อบัญชี จำนวนเงิน
        และเงื่อนไขที่เกี่ยวข้องให้ตรงกันทุกอย่าง เพราะเมื่อยืนยันแล้วรายการจะเข้าสู่ระบบทันที เราแนะนำให้ยึดข้อมูลจากระบบเป็นหลักเสมอ และเก็บเวลา จำนวนเงิน
        กับเลขอ้างอิงของรายการไว้จนกว่ารายการจะเสร็จสมบูรณ์ มากกว่าการยึดภาพหน้าจอหรือข้อความที่ส่งต่อกันมาจากแหล่งที่ตรวจสอบต้นทางไม่ได้ และถ้ารายการเดิมยังดำเนินการอยู่
        ขอให้รอให้ระบบอัปเดตก่อนส่งคำขอใหม่เสมอ การกดส่งคำขอซ้ำระหว่างนั้นไม่ได้ทำให้เร็วขึ้น แต่ทำให้การไล่ตรวจย้อนหลังยากขึ้นสำหรับทั้งสองฝ่าย
      </p>

      <h2 class={`mt-8 mb-6 ${sectionHeadingClass}`}>สิ่งที่เราไม่รับปาก และขอบเขตที่อยากให้ผู้ใช้งานตั้งไว้ก่อนเริ่ม</h2>

      <p class="mb-2 text-left text-base leading-relaxed text-[#f3e3d0]">
        เรื่องที่เราพูดตรงไปตรงมาตั้งแต่ต้นคือ ผลของเกมแต่ละรอบตัดสินจากระบบของเกมในรอบนั้นและไม่มีใครรับประกันได้ ถ้อยคำอย่างแตกง่ายและรวยไวที่ปรากฏบนสื่อโฆษณาของวงการนี้เป็นข้อความทางการตลาด
        ใช้สื่อถึงลักษณะการจ่ายของเกมและความตื่นเต้นของการลุ้นรางวัลเท่านั้น ไม่ได้เป็นการรับประกันว่าจะชนะมากขึ้น ไม่ได้เป็นหลักฐานว่าจะได้ผลลัพธ์ตามคาดในรอบใด
        และไม่ได้เป็นคำมั่นเรื่องรายได้หรือกำไรไม่ว่ากรณีใด สิ่งที่ควรใช้ประเมินเกมแทนคำโฆษณาคือค่า RTP ที่ผู้ให้บริการระบุ อ่านควบคู่กับระดับความผันผวนและตารางจ่ายของเกมนั้น เพราะตัวเลข RTP
        เพียงตัวเดียวไม่ได้บอกว่าเงินจะกลับมาในรูปแบบไหน เกมความผันผวนสูงจ่ายไม่บ่อยแต่จ่ายก้อนใหญ่กว่า ส่วนเกมความผันผวนต่ำจ่ายถี่กว่าในจำนวนที่เล็กกว่า
        และฟีเจอร์โบนัสของแต่ละเกมก็มีเงื่อนไขการเข้าถึงต่างกัน ทั้งหมดนี้ไม่ได้ดีกว่ากัน แต่เหมาะกับงบคนละขนาดและความอดทนคนละแบบ ในทางเดียวกัน ความคืบหน้าของธุรกรรมควรตรวจจากสถานะที่ระบบแสดงจริง
        ไม่ใช่จากข้อความโฆษณาหรือคำบอกเล่า ด้วยเหตุนี้เราจึงขอให้ผู้ใช้งานกำหนดวงเงินและระยะเวลาเล่นไว้ล่วงหน้า ใช้เฉพาะเงินที่ไม่กระทบค่าใช้จ่ายจำเป็น
        และไม่เพิ่มยอดต่อรอบเพื่อหวังตามคืนยอดที่เสียไปแล้วหรือเพิ่มตามอารมณ์ระหว่างเล่น เพราะแต่ละรอบเป็นผลลัพธ์ที่ไม่ขึ้นกับรอบก่อนหน้า ด้านบัญชี ขอให้เข้าใช้งานผ่านช่องทางหลักที่เว็บไซต์กำหนด
        ไม่ใช่ลิงก์ที่ส่งต่อกันมาพร้อมคำโฆษณา ตรวจชื่อเว็บไซต์และการเชื่อมต่อแบบ HTTPS ทุกครั้งก่อนกรอกข้อมูล ตั้งรหัสผ่านที่คาดเดายากและไม่ซ้ำกับบริการอื่น เลี่ยงเครือข่าย Wi-Fi
        สาธารณะเมื่อต้องทำธุรกรรม และออกจากระบบเมื่อใช้อุปกรณ์ร่วมกับผู้อื่น ทีมงานจะไม่ขอรหัสผ่าน รหัส OTP หรือรหัสยืนยันจากสมาชิกไม่ว่ากรณีใดและไม่ว่าผ่านช่องทางใด หากมีข้อความในลักษณะนั้นส่งมา
        ให้ถือว่าไม่ได้มาจากเรา และเมื่อพบรายการที่ผิดปกติ ให้เก็บเวลา จำนวนเงิน และเลขอ้างอิงของรายการไว้แจ้งทีมงานตั้งแต่ข้อความแรก
        เพื่อให้ตรวจสอบต้นเหตุได้ตรงจุดโดยไม่ต้องเปิดเผยข้อมูลลับของบัญชีแก่ผู้ใด
      </p>
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
