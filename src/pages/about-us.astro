---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/AnnouncementPremium.astro";
import { pageGraph } from "../lib/schema";

const pageTitle = "เกี่ยวกับ PRODED888 แพลตฟอร์มที่รวมเกมฮิต ระบบบัญชี และข้อมูลธุรกรรมไว้ในที่เดียว";

// One string, two jobs: MainLayout's <meta name="description"> and the WebPage
// node's description. The docx SUB-PAGES block has no row for /about-us, so this
// sentence is written here and held to the 150–160 CHARACTER window that
// tools/verify-build.mjs enforces on any description an agent writes (Thai is 3
// bytes per character, so a byte count reads ~3x too long). This one is 157.
//
// Body copy is deliberately "about the site" — what the platform is, how far a
// member's own use of it goes, and the limits we do not claim past — so it does
// not restate the home page's docx sections. The three H2s below are this page's
// own and deliberately do not echo any docx heading; every claim in them traces
// back to the brief's own cautious wording (รวมเกมยอดนิยมหลายประเภทไว้ในระบบเดียว,
// เลือกเกมจากประเภทที่เข้าใจกติกา, เกมยอดนิยมไม่ได้เหมาะกับทุกคน, โปรโมชั่นเทียบ
// จากเงื่อนไขจริง, แตกง่ายจ่ายจริงไม่ใช่การรับประกัน, ตรวจสถานะผ่านหน้าบัญชี,
// วางงบก่อนเริ่ม). Nothing here promises a payout, a win rate or a processing
// time, and nothing claims a licence, an award, a founding date, a user count or
// an office — the brief states none of those and neither does this page.
//
// <Announcement /> is bare: AnnouncementPremium's default message is this
// brand's copy, so the ticker matches index.astro without a second string here.
// The variant rotated off Announcement5, the outgoing brand's pick, per the
// brand spec.
//
// PRODED888 is a CASINO/slot brand this round: /ตรวจหวย and /แนวทาง are parked in
// src/pages-disabled/, so this page carries no lottery copy and links to neither
// route — a link to a route that does not exist fails the build.
//
// The brief names no wallet, no bank and no payment brand, so neither does this
// page: money language stays "ระบบของเว็บไซต์" and "ช่องทางที่เว็บไซต์กำหนด".
const pageDescription = "หน้านี้อธิบายว่า PRODED888 เป็นแพลตฟอร์มพนันออนไลน์แบบใด รวมเกมฮิตหลายประเภท ระบบบัญชี และธุรกรรมไว้อย่างไร สมาชิกใช้งานได้ถึงขั้นไหน และเราไม่รับปากเรื่องใด";

const graph = pageGraph(Astro, {
  type: "AboutPage",
  name: pageTitle,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "เกี่ยวกับเรา", path: "/about-us" },
  ],
});

// h2 inside the card: light gold → primary gold → deep gold, i.e. the brand ramp
// read downward, where ContentBox's own h1 gradient opens on platinum and runs
// platinum → gold → deep gold. The two heading levels stay visually distinct
// without either one repeating the other's opening stop, and the platinum stays
// on the h1, because a second platinum heading on a deep navy card is where the
// hierarchy would collapse.
const sectionHeadingClass = "bg-gradient-to-r from-[#f8de91] via-[#e3b53f] to-[#8f6614] bg-clip-text text-2xl leading-normal font-bold text-transparent";
---

<MainLayout title="PRODED888 | เกี่ยวกับเรา และการรวมเกมฮิตไว้ในระบบเดียว" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={pageTitle} as="h1">
    <div>
      <h2 class={`mb-6 ${sectionHeadingClass}`}>PRODED888 คือแพลตฟอร์มแบบไหน และเว็บไซต์นี้มีหน้าอะไรบ้าง</h2>

      <p class="mb-6 text-left text-base leading-relaxed text-[#ece0c2]">
        <strong class="text-[#f8de91]">PRODED888</strong> เป็นแพลตฟอร์มพนันออนไลน์ที่รวบรวมเกมยอดนิยมหลายประเภทไว้ในระบบเดียว ทั้งสล็อต บาคาร่า คาสิโน และเกมเดิมพันรูปแบบอื่นตามที่เว็บไซต์รองรับ
        หน้าที่ของเรามีอย่างเดียว คือจัดวางเกม ระบบบัญชี และข้อมูลธุรกรรมให้อยู่ในที่เดียวกัน แทนที่ผู้เล่นจะต้องเปิดหลายเว็บไซต์ สมัครหลายบัญชี แล้วย้ายเครดิตไปมาระหว่างระบบ
        เมื่อทุกอย่างอยู่ที่จุดเดียว การสลับหน้าไปมาและขั้นตอนที่ไม่จำเป็นจะลดลงเอง และการเลือกเกม ตรวจโปรโมชั่น กับติดตามข้อมูลบัญชีก็ทำได้จากหน้าเดียวกัน เกมภายในระบบแบ่งตามประเภทที่เว็บไซต์รองรับ
        การแยกหมวดให้ชัดไม่ได้มีไว้เพื่อความสวยงามของหน้าเว็บ แต่มีไว้ให้เปรียบเทียบกติกา อัตราจ่าย ฟีเจอร์ และวงเงินขั้นต่ำของแต่ละเกมได้ง่ายขึ้นก่อนตัดสินใจ ส่วนนี้เป็นเจตนาของเราโดยตรง
        คืออยากให้เลือกเกมจากประเภทที่เข้าใจกติกาและจากระดับความเสี่ยงที่สอดคล้องกับงบของตนเอง มากกว่าเลือกจากกระแสหรือจากคำโปรโมตที่เห็นผ่านตา
        ระบบเปิดผ่านเบราว์เซอร์ได้ทั้งบนมือถือและคอมพิวเตอร์โดยไม่ต้องติดตั้งโปรแกรมเพิ่ม ตำแหน่งเมนูและลำดับของข้อมูลจึงอยู่ที่เดิมเมื่อสลับอุปกรณ์ระหว่างวัน
        เนื้อหาบนเว็บไซต์แบ่งเป็นหน้าย่อยไม่กี่หน้าเพื่อให้หาสิ่งที่ต้องการได้เร็ว ได้แก่ หน้าแรกที่อธิบายภาพรวมของระบบและเงื่อนไขการใช้งาน หน้าโปรโมชั่นที่รวมสิทธิพิเศษของแต่ละรายการไว้ด้วยกัน
        หน้าทดลองเล่นสำหรับศึกษากติกาและอัตราจ่ายก่อนเล่นจริง หน้าทางเข้าสำหรับเข้าใช้งานผ่านช่องทางหลัก หน้าติดต่อเราสำหรับส่งเรื่องถึงทีมงานโดยตรง
        และหน้าเงื่อนไขการใช้งานกับนโยบายความเป็นส่วนตัวที่ระบุขอบเขตของเว็บไซต์นี้ไว้เป็นลายลักษณ์อักษร หน้านี้ไม่ใช่คู่มือการใช้งาน แต่มีไว้บอกว่าเราเป็นใคร ตั้งใจให้บริการแบบไหน
        และผู้ใช้งานควรคาดหวังอะไรได้จากเว็บไซต์นี้
      </p>

      <h2 class={`mt-8 mb-6 ${sectionHeadingClass}`}>สมาชิกใช้งาน PRODED888 ได้ตั้งแต่ขั้นไหนจนถึงขั้นไหน</h2>

      <p class="mb-6 text-left text-base leading-relaxed text-[#ece0c2]">
        เส้นทางการใช้งานบน PRODED888 เดินเป็นลำดับเดียวกันเสมอ เริ่มจากการเปิดบัญชีตามเงื่อนไขที่เว็บไซต์กำหนด ซึ่งเราระบุไว้ตรงไปตรงมาว่าขั้นเปิดบัญชีเป็นคนละเรื่องกับขั้นที่ตามมา
        เงื่อนไขด้านการฝาก การรับสิทธิ์โปรโมชั่น และการถอนเป็นคนละชุดกัน และควรอ่านแยกกันตั้งแต่ต้นแทนที่จะเหมารวมเป็นชุดเดียว จากนั้นจึงเลือกว่ารอบนี้จะลงเกมไหน
        โดยดูจากประเภทเกมที่เข้าใจกติกาอยู่แล้วก่อน แล้วค่อยเทียบอัตราจ่าย ฟีเจอร์ ความเสี่ยง และวงเงินขั้นต่ำของเกมอื่นในหมวดเดียวกัน จุดที่เราย้ำเสมอคือเกมที่มีผู้เล่นสนใจจำนวนมากไม่ได้แปลว่าเหมาะกับทุกคน
        เพราะรูปแบบการเดิมพันและความผันผวนของแต่ละเกมต่างกัน หากเพิ่งเริ่มควรเลือกเกมที่กติกาชัดเจนและวงเงินต่อรอบไม่สูงเกินงบ แล้วค่อยขยับไปเกมที่ซับซ้อนขึ้นเมื่อเข้าใจรูปแบบการจ่ายแล้ว
        ขั้นตอนอ่านข้อมูลของเกมก่อนลงเดิมพันจริงคือขั้นที่เราอยากให้ใช้เวลามากที่สุด เพราะเป็นขั้นเดียวที่ยังเปลี่ยนใจได้โดยไม่มีต้นทุน
        ฝั่งบัญชีเดินคนละแบบกับฝั่งเกม คือรวมข้อมูลบัญชี สิทธิ์โปรโมชั่นที่ถืออยู่ ยอดคงเหลือ ประวัติธุรกรรม และสถานะของรายการที่ยังดำเนินการอยู่ไว้ในระบบเดียว
        ระบบที่ใช้งานง่ายช่วยลดขั้นตอนตรงนี้ให้สั้นลง แต่ไม่ได้ลดหน้าที่ในการตรวจของผู้ใช้งาน ก่อนยืนยันควรตรวจชื่อบัญชี จำนวนเงิน และข้อมูลรับเงินให้ถูกต้องครบทุกช่อง
        และหากมีรายการถอนอยู่ระหว่างดำเนินการ ควรเก็บเวลา จำนวนเงิน และเลขอ้างอิงไว้จนกว่าระบบจะอัปเดตผล แล้วรอการอัปเดตนั้นก่อนส่งรายการใหม่เสมอ การกดส่งซ้ำระหว่างนั้นไม่ได้ทำให้เร็วขึ้น
        แต่เพิ่มโอกาสเกิดรายการซ้ำหรือยอดคลาดเคลื่อน และทำให้การไล่ตรวจย้อนหลังยากขึ้นสำหรับทั้งสองฝ่าย ส่วนสิทธิ์โปรโมชั่นให้ตรวจจากหน้าบัญชีของตัวเองก่อนเริ่มเกมทุกครั้ง
        ทั้งชื่อโปรโมชั่น จำนวนเครดิต และเงื่อนไขที่เกี่ยวข้อง หากมีหลายโปรพร้อมกันควรดูว่าใช้ร่วมกันได้หรือไม่ และควรเก็บรายละเอียดสิทธิ์ไว้จนกว่าการใช้งานหรือการถอนจะเสร็จสมบูรณ์
      </p>

      <h2 class={`mt-8 mb-6 ${sectionHeadingClass}`}>สิ่งที่เราไม่รับปาก และขอบเขตที่อยากให้ผู้ใช้งานตั้งไว้ก่อนเริ่ม</h2>

      <p class="mb-2 text-left text-base leading-relaxed text-[#ece0c2]">
        เรื่องที่เราพูดตรงไปตรงมาตั้งแต่ต้นคือ ถ้อยคำที่ใช้กันทั่วไปในวงการนี้เป็นข้อความทางการตลาด ไม่ใช่หลักฐานในตัวเอง คำว่าแตกง่ายใช้สื่อถึงความน่าสนใจของเกมเท่านั้น และไม่สามารถรับประกันผลได้
        หากเป็นเกมสล็อตควรดู RTP ความผันผวน ตารางจ่าย และฟีเจอร์โบนัสประกอบกัน ส่วนเกมประเภทอื่นควรอ่านกติกาและอัตราจ่ายก่อนวางเดิมพัน เช่นเดียวกับคำว่าจ่ายจริง ซึ่งควรพิจารณาจากยอดคงเหลือ
        ประวัติธุรกรรม และสถานะรายการที่ระบบแสดงบนหน้าบัญชีเป็นหลัก ไม่ควรตีความเป็นการรับประกันผลหรือเวลาในทุกกรณี เพราะผลเกมและสถานะธุรกรรมขึ้นอยู่กับกติกา บัญชี ช่องทาง และเงื่อนไขที่เกี่ยวข้อง
        ในทางเดียวกัน โปรโมชั่นที่ดูคุ้มไม่จำเป็นต้องเป็นโปรที่ให้เครดิตมากที่สุด ควรเปรียบเทียบยอดรับโบนัส ยอดขั้นต่ำ เกมที่ร่วมรายการ ระยะเวลา และข้อกำหนดการถอนร่วมกัน
        เพราะโปรที่เหมาะกับรูปแบบการเล่นอาจคุ้มกว่าข้อเสนอที่ให้โบนัสสูงแต่มีข้อจำกัดมาก และไม่ควรเป็นโปรที่บังคับให้เติมเงินเกินแผนที่ตั้งไว้ตั้งแต่แรก
        ผลของเกมแต่ละรอบตัดสินจากระบบของเกมในรอบนั้นและมีความไม่แน่นอนอยู่เสมอ เราจึงไม่รับปากผลลัพธ์ รายได้ หรือกำไรไม่ว่ากรณีใด ด้วยเหตุนี้เราจึงขอให้ผู้ใช้งานกำหนดงบต่อวันหรือแต่ละช่วงเวลาไว้ล่วงหน้า
        ใช้เฉพาะเงินที่ไม่กระทบค่าใช้จ่ายจำเป็น หยุดเมื่อถึงวงเงินที่ตั้งไว้ และไม่เพิ่มเดิมพันเพื่อตามคืนยอดที่เสียไปแล้ว ด้านบัญชี ขอให้เข้าใช้งานผ่านช่องทางหลักที่เว็บไซต์กำหนด
        ไม่ใช่ลิงก์ที่ส่งต่อกันมาพร้อมคำโฆษณา ตรวจชื่อเว็บไซต์และการเชื่อมต่อแบบ HTTPS ทุกครั้งก่อนกรอกข้อมูล ตั้งรหัสผ่านที่คาดเดายากและไม่ซ้ำกับบริการอื่น และออกจากระบบเมื่อใช้อุปกรณ์ร่วมกับผู้อื่น
        ทีมงานจะไม่ขอรหัสผ่าน รหัส OTP หรือรหัสยืนยันจากสมาชิกไม่ว่ากรณีใดและไม่ว่าผ่านช่องทางใด หากมีข้อความในลักษณะนั้นส่งมา ให้ถือว่าไม่ได้มาจากเรา และเมื่อพบรายการที่ผิดปกติ
        ให้เก็บเวลา จำนวนเงิน และเลขอ้างอิงของรายการไว้แจ้งทีมงานตั้งแต่ข้อความแรก เพื่อให้ตรวจสอบต้นเหตุได้ตรงจุดโดยไม่ต้องเปิดเผยข้อมูลลับของบัญชีแก่ผู้ใด
      </p>
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
