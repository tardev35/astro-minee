---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/AnnouncementHuay.astro";
import { pageGraph } from "../lib/schema";

const pageTitle = "เกี่ยวกับ หวยพร้อม แพลตฟอร์มที่รวมประเภทหวย ระบบโพย และข้อมูลผลรางวัลไว้ในที่เดียว";

// One string, two jobs: MainLayout's <meta name="description"> and the WebPage
// node's description. The docx SUB-PAGES block has no row for /about-us, so this
// sentence is written here and held to the 150–160 CHARACTER window that
// tools/verify-build.mjs enforces on any description an agent writes (Thai is 3
// bytes per character, so a byte count reads ~3x too long). This one is 157.
//
// Body copy is deliberately "about the site" — what the platform is, how far a
// member's own use of it goes, and the limits we do not claim past — so it does
// not restate the home page's docx sections. The three H2s below are this page's
// own and deliberately do not echo any docx heading; every claim in them traces
// back to the brief's own cautious wording (รวมประเภทหวย ระบบกรอกโพย อัตราจ่าย
// และข้อมูลผลรางวัลไว้ในระบบเดียว, ตรวจชื่อรายการ วันที่ออกรางวัล และเวลาปิดรับ,
// 2 ตัว/3 ตัว/วิ่ง และตรง/โต๊ด คิดผลคนละแบบ, ไม่อั้นเลขต้องดูสถานะล่าสุดของงวด,
// จ่ายเยอะไม่ได้แปลว่าโอกาสถูกมากขึ้น, ไล่ดูโพยทีละรายการและเก็บเลขอ้างอิง,
// รวมครบจบในที่เดียวยังต้องตรวจกติกาของแต่ละงวด). Nothing here promises a
// payout, a win rate or a processing time, and nothing claims a licence, an
// award, a founding date, a user count or an office — the brief states none of
// those and neither does this page.
//
// <Announcement /> is bare: AnnouncementHuay's default message is this brand's
// copy, so the ticker matches index.astro without a second string here. The
// variant rotated off AnnouncementPremium, the outgoing brand's pick, per the
// brand spec.
//
// หวยพร้อม is a LOTTERY brand this round: /แนวทาง is routed in src/pages/ and
// /ตรวจหวย is parked in src/pages-disabled/. The page list below therefore names
// แนวทาง and does NOT name ตรวจหวย. It is prose, not links — this page renders no
// anchor at all — but a sentence pointing at a route that does not exist is the
// same defect as a dead link, so keep the two in step if the toggle moves.
//
// The brief names no wallet, no bank and no payment brand, so neither does this
// page: money language stays "ระบบของเว็บไซต์" and "ช่องทางที่เว็บไซต์กำหนด".
const pageDescription = "หน้านี้อธิบายว่า หวยพร้อม เป็นแพลตฟอร์มหวยออนไลน์แบบใด รวมประเภทหวย ระบบโพย อัตราจ่าย และผลรางวัลไว้อย่างไร สมาชิกใช้งานได้ถึงขั้นไหน และเราไม่รับปากเรื่องใด";

const graph = pageGraph(Astro, {
  type: "AboutPage",
  name: pageTitle,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "เกี่ยวกับเรา", path: "/about-us" },
  ],
});

// h2 inside the card: light gold → prize gold → deep gold, i.e. the brand's gold
// accent read downward, where ContentBox's own h1 gradient opens on soft
// green-white and runs green-white → neon green → gold. The two levels stay
// visually distinct without either one repeating the other's opening stop, and
// the green stays on the h1, because a second green-led heading on this
// near-black green card is where the hierarchy would collapse.
const sectionHeadingClass = "bg-gradient-to-r from-[#ffe08a] via-[#f5c451] to-[#a9791a] bg-clip-text text-2xl leading-normal font-bold text-transparent";
---

<MainLayout title="หวยพร้อม | เกี่ยวกับเรา และการรวมหวยหลายประเภทไว้ในระบบเดียว" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={pageTitle} as="h1">
    <div>
      <h2 class={`mb-6 ${sectionHeadingClass}`}>หวยพร้อม คือแพลตฟอร์มแบบไหน และเว็บไซต์นี้มีหน้าอะไรบ้าง</h2>

      <p class="mb-6 text-left text-base leading-relaxed text-[#d8efdc]">
        <strong class="text-[#6ee7a0]">หวยพร้อม</strong> เป็นแพลตฟอร์มหวยออนไลน์ที่รวบรวมประเภทหวย ระบบกรอกโพย อัตราจ่าย และข้อมูลผลรางวัลไว้ในระบบเดียว ตามรายการที่เว็บไซต์กำหนดในแต่ละช่วง
        หน้าที่ของเรามีอย่างเดียว คือจัดวางรายการหวย ระบบโพย และข้อมูลบัญชีให้อยู่ในที่เดียวกัน แทนที่ผู้ใช้จะต้องเปิดหลายหน้าเพื่อดูงวด กรอกเลข เทียบราคา แล้วไปตามผลรางวัลจากอีกแหล่งหนึ่ง
        เมื่อทุกอย่างอยู่ที่จุดเดียว การสลับหน้าไปมาและขั้นตอนที่ไม่จำเป็นจะลดลงเอง แต่การรวมไว้ที่เดียวไม่ได้แปลว่าทุกรายการใช้กติกาชุดเดียวกัน หวยแต่ละประเภทยังมีงวด เวลาปิดรับ และเงื่อนไขของตัวเองอยู่
        ระบบจึงแยกหมวดตามประเภทและรอบออกรางวัลไว้ให้ชัด การแยกหมวดไม่ได้มีไว้เพื่อความสวยงามของหน้าเว็บ แต่มีไว้ให้เทียบชื่อรายการ วันที่ออกรางวัล เวลาปิดรับ รูปแบบเดิมพัน และอัตราจ่ายได้ง่ายขึ้นก่อนตัดสินใจ
        ส่วนนี้เป็นเจตนาของเราโดยตรง คืออยากให้เลือกจากงวดและรูปแบบที่เข้าใจเงื่อนไขจริง มากกว่าเลือกจากคำโปรโมตที่เห็นผ่านตา
        ระบบเปิดผ่านเบราว์เซอร์ได้ทั้งบนมือถือและคอมพิวเตอร์โดยไม่ต้องติดตั้งโปรแกรมเพิ่ม ตำแหน่งเมนูและลำดับของข้อมูลจึงอยู่ที่เดิมเมื่อสลับอุปกรณ์ระหว่างวัน
        เนื้อหาบนเว็บไซต์แบ่งเป็นหน้าย่อยไม่กี่หน้าเพื่อให้หาสิ่งที่ต้องการได้เร็ว ได้แก่ หน้าแรกที่อธิบายภาพรวมของระบบและเงื่อนไขการใช้งาน หน้าโปรโมชั่นที่รวมสิทธิพิเศษของแต่ละรายการไว้ด้วยกัน
        หน้าทดลองเล่นสำหรับศึกษาวิธีเลือกเลขและกรอกโพยก่อนซื้อจริง หน้าแนวทางที่รวมข้อมูลไว้ประกอบการพิจารณาซึ่งเป็นข้อมูลอ้างอิงเท่านั้นและไม่ใช่การรับประกันผล หน้าทางเข้าสำหรับเข้าใช้งานผ่านช่องทางหลัก
        หน้าติดต่อเราสำหรับส่งเรื่องถึงทีมงานโดยตรง และหน้าเงื่อนไขการใช้งานกับนโยบายความเป็นส่วนตัวที่ระบุขอบเขตของเว็บไซต์นี้ไว้เป็นลายลักษณ์อักษร หน้านี้ไม่ใช่คู่มือการใช้งาน แต่มีไว้บอกว่าเราเป็นใคร
        ตั้งใจให้บริการแบบไหน และผู้ใช้งานควรคาดหวังอะไรได้จากเว็บไซต์นี้
      </p>

      <h2 class={`mt-8 mb-6 ${sectionHeadingClass}`}>สมาชิกใช้งาน หวยพร้อม ได้ตั้งแต่ขั้นไหนจนถึงขั้นไหน</h2>

      <p class="mb-6 text-left text-base leading-relaxed text-[#d8efdc]">
        เส้นทางการใช้งานบน หวยพร้อม เดินเป็นลำดับเดียวกันเสมอ เริ่มจากการเปิดบัญชีตามเงื่อนไขที่เว็บไซต์กำหนด ซึ่งเราระบุไว้ตรงไปตรงมาว่าขั้นเปิดบัญชีเป็นคนละเรื่องกับขั้นที่ตามมา
        เงื่อนไขด้านการเติมเงิน การรับสิทธิ์โปรโมชั่น และการถอนเป็นคนละชุดกัน และควรอ่านแยกกันตั้งแต่ต้นแทนที่จะเหมารวมเป็นชุดเดียว จากนั้นจึงเลือกว่ารอบนี้จะซื้อหวยรายการใด
        โดยตรวจชื่อรายการ วันที่ออกรางวัล และเวลาปิดรับให้ถูกต้องก่อน โดยเฉพาะผู้ที่ซื้อหลายประเภทในวันเดียว แล้วจึงเลือกรูปแบบเดิมพันว่าเป็นเลข 2 ตัว เลข 3 ตัว หรือเลขวิ่ง และเป็นแทงตรงหรือโต๊ด
        จุดที่เราย้ำเสมอคือรูปแบบทั้งสามคิดผลและจ่ายคนละอัตรา การเลือกประเภทผิดจะทำให้โพยไม่ตรงกับความตั้งใจแม้จะใช้เลขชุดเดียวกัน หากเพิ่งเริ่มควรเลือกรายการที่เงื่อนไขชัดเจนและตั้งยอดต่อเลขไม่สูงเกินงบ
        แล้วค่อยขยับไปรูปแบบที่ซับซ้อนขึ้นเมื่อเข้าใจวิธีนับผลแล้ว ขั้นก่อนกดยืนยันคือขั้นที่เราอยากให้ใช้เวลามากที่สุด เพราะเป็นขั้นเดียวที่ยังเปลี่ยนใจได้โดยไม่มีต้นทุน
        ควรไล่ดูเลข ประเภทเดิมพัน จำนวนเงิน และยอดรวมทีละรายการ พร้อมตรวจสถานะของเลขในงวดนั้นอีกครั้ง เพราะบางเลขอาจถูกจำกัดยอด เปลี่ยนอัตราจ่าย หรือหยุดรับเมื่อถึงวงเงินที่กำหนด
        ฝั่งบัญชีเดินคนละแบบกับฝั่งโพย คือรวมข้อมูลบัญชี สิทธิ์โปรโมชั่นที่ถืออยู่ ยอดคงเหลือ ประวัติรายการ และสถานะของรายการที่ยังดำเนินการอยู่ไว้ในระบบเดียว
        ระบบที่ใช้งานง่ายช่วยลดขั้นตอนตรงนี้ให้สั้นลง แต่ไม่ได้ลดหน้าที่ในการตรวจของผู้ใช้งาน หลังยืนยันโพยแล้วควรเก็บเลขอ้างอิงของรายการไว้ เพื่อใช้ตรวจสอบย้อนหลังเมื่อมีการประกาศผลรางวัลหรือพบข้อมูลไม่ตรงกัน
        และหากมีรายการถอนอยู่ระหว่างดำเนินการ ควรเก็บเวลา จำนวนเงิน และเลขอ้างอิงไว้จนกว่าระบบจะอัปเดตผล แล้วรอการอัปเดตนั้นก่อนส่งรายการใหม่เสมอ การกดส่งซ้ำระหว่างนั้นไม่ได้ทำให้เร็วขึ้น
        แต่เพิ่มโอกาสเกิดรายการซ้ำหรือยอดคลาดเคลื่อน และทำให้การไล่ตรวจย้อนหลังยากขึ้นสำหรับทั้งสองฝ่าย ส่วนสิทธิ์โปรโมชั่นให้ตรวจจากหน้าบัญชีของตัวเองก่อนเริ่มทุกครั้ง
        ทั้งชื่อโปรโมชั่น จำนวนเครดิต และเงื่อนไขที่เกี่ยวข้อง หากมีหลายโปรพร้อมกันควรดูว่าใช้ร่วมกันได้หรือไม่ และควรเก็บรายละเอียดสิทธิ์ไว้จนกว่าการใช้งานหรือการถอนจะเสร็จสมบูรณ์
      </p>

      <h2 class={`mt-8 mb-6 ${sectionHeadingClass}`}>สิ่งที่เราไม่รับปาก และขอบเขตที่อยากให้ผู้ใช้งานตั้งไว้ก่อนเริ่ม</h2>

      <p class="mb-2 text-left text-base leading-relaxed text-[#d8efdc]">
        เรื่องที่เราพูดตรงไปตรงมาตั้งแต่ต้นคือ ถ้อยคำที่ใช้กันทั่วไปในวงการนี้เป็นข้อความทางการตลาด ไม่ใช่หลักฐานในตัวเอง คำว่าไม่อั้นเลขไม่ควรตีความว่าไม่มีข้อจำกัดในทุกเลขและทุกงวด
        เพราะบางงวดอาจมีเลขปิดรับ จำกัดยอด หรือปรับอัตราจ่ายตามวงเงินที่กำหนดไว้ สถานะล่าสุดที่ระบบแสดงก่อนกดยืนยันคือสิ่งที่ควรยึด เช่นเดียวกับคำว่าจ่ายเยอะ ซึ่งโดยทั่วไปสื่อถึงอัตราจ่ายที่เว็บไซต์กำหนด
        แต่ราคาจริงต่างกันตามประเภทหวย รูปแบบเดิมพัน และสถานะของเลขที่เลือก จึงควรเทียบราคาที่ระบบแสดงจริงก่อนซื้อทุกครั้ง และไม่ควรถือว่าอัตราจ่ายสูงหมายถึงมีโอกาสถูกรางวัลมากขึ้น
        ในทางเดียวกัน โปรโมชั่นที่ดูคุ้มไม่จำเป็นต้องเป็นโปรที่ให้เครดิตมากที่สุด ควรเปรียบเทียบยอดรับโบนัส ยอดขั้นต่ำ รายการที่ร่วม ระยะเวลา และข้อกำหนดการถอนร่วมกัน
        เพราะโปรที่เหมาะกับรูปแบบการซื้อของตัวเองอาจคุ้มกว่าข้อเสนอที่ให้โบนัสสูงแต่มีข้อจำกัดมาก และไม่ควรเป็นโปรที่บังคับให้เติมเงินเกินแผนที่ตั้งไว้ตั้งแต่แรก
        ผลรางวัลของแต่ละงวดเป็นไปตามการออกรางวัลของรายการนั้นและมีความไม่แน่นอนอยู่เสมอ งวดก่อนหน้าไม่ได้กำหนดงวดถัดไป และการนับสถิติย้อนหลังก็ไม่ได้ทำให้คาดเดาได้แม่นขึ้น เราจึงไม่รับปากผลรางวัล รายได้
        หรือกำไรไม่ว่ากรณีใด ด้วยเหตุนี้เราจึงขอให้ผู้ใช้งานกำหนดงบต่อวันหรือต่องวดไว้ล่วงหน้า ใช้เฉพาะเงินที่ไม่กระทบค่าใช้จ่ายจำเป็น หยุดเมื่อถึงวงเงินที่ตั้งไว้ และไม่เพิ่มยอดในงวดถัดไปเพื่อตามคืนยอดที่เสียไปแล้ว
        ด้านบัญชี ขอให้เข้าใช้งานผ่านช่องทางหลักที่เว็บไซต์กำหนด ไม่ใช่ลิงก์ที่ส่งต่อกันมาพร้อมคำโฆษณา ตรวจชื่อเว็บไซต์และการเชื่อมต่อแบบ HTTPS ทุกครั้งก่อนกรอกข้อมูล
        ตั้งรหัสผ่านที่คาดเดายากและไม่ซ้ำกับบริการอื่น และออกจากระบบเมื่อใช้อุปกรณ์ร่วมกับผู้อื่น ทีมงานจะไม่ขอรหัสผ่าน รหัส OTP หรือรหัสยืนยันจากสมาชิกไม่ว่ากรณีใดและไม่ว่าผ่านช่องทางใด
        หากมีข้อความในลักษณะนั้นส่งมา ให้ถือว่าไม่ได้มาจากเรา และเมื่อพบรายการที่ผิดปกติ ให้เก็บเวลา จำนวนเงิน และเลขอ้างอิงของโพยหรือของรายการไว้แจ้งทีมงานตั้งแต่ข้อความแรก
        เพื่อให้ตรวจสอบต้นเหตุได้ตรงจุดโดยไม่ต้องเปิดเผยข้อมูลลับของบัญชีแก่ผู้ใด
      </p>
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
