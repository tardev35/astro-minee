---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/Announcement6.astro";
import { pageGraph } from "../lib/schema";

const pageTitle = "เกี่ยวกับ HOT189 บาคาร่าเว็บตรงที่รวมโต๊ะและระบบฝากถอนออโต้ไว้ในบัญชีเดียว";

// One string, two jobs: MainLayout's <meta name="description"> and the WebPage
// node's description. This page has no docx SUB-PAGES row, so the sentence is
// written here and length-checked against tools/verify-build.mjs, which wants
// 150–160 CHARACTERS (Thai is 3 bytes per character, so a byte count reads ~3x
// too long). This one is 152.
//
// Body copy is deliberately written as "about the site" — what the platform is,
// what a member does with it end to end, and the limits we ask people to hold —
// so it does not restate the home page's docx sections, which cover the same
// ground as guidance on table choice, Banker/Player/Tie, the auto cashier and
// the "แตกง่าย" disclaimer. Two URLs repeating one set of H2s is the failure
// mode this page exists to avoid, so the three H2s below are this page's own and
// deliberately do not echo any docx heading.
//
// <Announcement /> is bare: Announcement6's default message is this brand's
// copy, so the ticker matches index.astro without a second string here.
const pageDescription = "HOT189 บาคาร่าเว็บตรงที่รวมโต๊ะและระบบฝากถอนออโต้ไว้ในบัญชีเดียว หน้านี้อธิบายแนวทางให้บริการ ขั้นตอนใช้งานของสมาชิกตั้งแต่ต้นจนจบ และการดูแลข้อมูลบัญชี";

const graph = pageGraph(Astro, {
  type: "AboutPage",
  name: pageTitle,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "เกี่ยวกับเรา", path: "/about-us" },
  ],
});

// h2 inside the card: gold deep → gold light, the reverse direction of
// ContentBox's own h1 gradient (light → deep) so the two heading levels stay
// visually distinct. Gold carries the type on this brand; flame red stays on the
// surfaces, because red text on a dark ember card is where the contrast goes.
const sectionHeadingClass = "bg-gradient-to-r from-[#c99400] via-[#fcd304] to-[#ffe86b] bg-clip-text text-2xl leading-normal font-bold text-transparent";
---

<MainLayout title="HOT189 | เกี่ยวกับเราและแนวทางให้บริการบาคาร่าเว็บตรง" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={pageTitle} as="h1">
    <div>
      <h2 class={`mb-6 ${sectionHeadingClass}`}>HOT189 คือแพลตฟอร์มแบบไหน และเว็บไซต์นี้ประกอบด้วยหน้าอะไรบ้าง</h2>

      <p class="mb-6 text-left text-base leading-relaxed text-[#ffe9cf]">
        <strong class="text-[#fcd304]">HOT189</strong> เป็นแพลตฟอร์มบาคาร่าออนไลน์ที่ทำหน้าที่เดียว คือรวมโต๊ะบาคาร่าหลายระดับวงเงินและระบบจัดการบัญชีไว้ในที่เดียวผ่านระบบเว็บตรง แทนที่จะต้องเปิดหลายเว็บไซต์
        สมัครหลายบัญชี และย้ายเครดิตไปมาระหว่างระบบ ทุกโต๊ะและทุกรายการอยู่ในชุดหน้าจอเดียวกัน จะเลือกโต๊ะตามวงเงินหรือเทียบความเร็วของเกมก่อนตัดสินใจก็ได้ ระบบสมาชิก โปรโมชั่น ประวัติการเดิมพัน และสถานะธุรกรรมก็อยู่ที่เดียวกันนั้น
        ระบบเปิดผ่านเบราว์เซอร์ได้ทั้งบนมือถือและคอมพิวเตอร์โดยไม่ต้องติดตั้งโปรแกรมเพิ่ม ตำแหน่งเมนูและลำดับของข้อมูลจึงอยู่ที่เดิมเมื่อเปลี่ยนอุปกรณ์ระหว่างวัน สิ่งที่เราให้ความสำคัญไม่ใช่จำนวนโต๊ะในระบบ
        แต่เป็นการทำให้ข้อมูลที่ต้องใช้ตัดสินใจอยู่ใกล้ปุ่มที่ต้องกด ทั้งกติกาและวิธีนับแต้มของโต๊ะนั้น อัตราจ่ายของแต่ละตัวเลือกเดิมพันและค่าคอมมิชชันที่อาจเกี่ยวข้อง ขั้นตอนฝากถอนออโต้ที่ระบบรองรับ เงื่อนไขของโปรโมชั่นที่กำลังเปิดอยู่
        และสถานะล่าสุดของบัญชี เพราะข้อมูลเหล่านี้ต่างกันในแต่ละโต๊ะและปรับได้ตามรอบ การวางไว้ให้เห็นก่อนกดยืนยันจึงช่วยลดการเลือกโต๊ะผิดจากที่ตั้งใจ เข้าใจเงื่อนไขโบนัสคลาดเคลื่อน หรือกดยืนยันรายการฝากถอนซ้ำโดยไม่จำเป็น
        ซึ่งเป็นความผิดพลาดที่พบบ่อยที่สุดของผู้เล่นใหม่ เนื้อหาบนเว็บไซต์แบ่งเป็นหน้าย่อยไม่กี่หน้าเพื่อให้หาสิ่งที่ต้องการได้เร็ว ได้แก่ หน้าแรกที่อธิบายภาพรวมของระบบและเงื่อนไขการใช้งาน หน้าโปรโมชั่นที่แจกแจงสิทธิ์และข้อกำหนดของแต่ละรายการ
        หน้าทดลองเล่นสำหรับศึกษากติกาและขั้นตอนใช้งานก่อนเดิมพันด้วยเงินจริง หน้าทางเข้าสำหรับเข้าใช้งานผ่านช่องทางหลัก และหน้าติดต่อเราสำหรับส่งเรื่องถึงทีมงานโดยตรง หน้านี้ไม่ใช่คู่มือการใช้งาน แต่มีไว้บอกว่าเราเป็นใคร
        ตั้งใจให้บริการแบบไหน และผู้ใช้งานควรคาดหวังอะไรได้จากเว็บไซต์นี้
      </p>

      <h2 class={`mt-8 mb-6 ${sectionHeadingClass}`}>สมาชิกใช้งาน HOT189 ได้ตั้งแต่ขั้นไหนจนถึงขั้นไหน</h2>

      <p class="mb-6 text-left text-base leading-relaxed text-[#ffe9cf]">
        เส้นทางการใช้งานบน HOT189 เดินเป็นลำดับเดียวกันเสมอ เริ่มจากเข้าสู่ระบบผ่านช่องทางหลัก แล้วเลือกว่ารอบนี้จะลงโต๊ะไหน ซึ่งแต่ละโต๊ะมีขั้นต่ำ ขั้นสูงสุด และจังหวะเวลาไม่เหมือนกัน
        ตัวบาคาร่าเองจบผลในรอบสั้น ๆ และตัวเลือกเดิมพันหลักมีอยู่ไม่กี่ทาง แต่แต่ละทางมีอัตราจ่ายกับความเสี่ยงไม่เท่ากัน และบางฝั่งมีค่าคอมมิชชันเข้ามาเกี่ยวข้อง
        ก่อนลงเดิมพันจึงควรอ่านวิธีตัดสินผลและเงื่อนไขของโต๊ะนั้นให้จบก่อน จุดนี้คือจุดที่เราอยากให้ใช้เวลามากที่สุด ส่วนฝั่งการเงินเดินคนละแบบ คือผูกกับระบบฝากถอนออโต้ที่จัดการได้จากหน้าบัญชีโดยตรง
        ก่อนยืนยันควรตรวจชื่อบัญชี จำนวนเงิน ข้อมูลรับเงิน และเงื่อนไขโปรโมชั่นให้ตรงกันทั้งสี่อย่าง เพราะเมื่อยืนยันแล้วรายการจะเข้าสู่ระบบทันที เมื่อทำรายการแล้ว
        ทุกอย่างที่เกิดขึ้นกับเครดิตจะไปปรากฏที่หน้าบัญชี ทั้งยอดคงเหลือ ประวัติการฝากถอน ประวัติการเดิมพัน สถานะของรายการที่ยังดำเนินการอยู่ และผลของรอบที่จบไปแล้ว
        เราแนะนำให้ยึดข้อมูลจากหน้าบัญชีเป็นหลักเสมอ และเก็บเวลา จำนวนเงิน กับเลขอ้างอิงของรายการไว้จนกว่าสถานะจะปิดรอบ มากกว่าการยึดภาพหน้าจอหรือข้อความที่ส่งต่อกันมาจากแหล่งที่ตรวจสอบต้นทางไม่ได้
        และถ้ารายการหนึ่งยังค้างอยู่ ขอให้รอสถานะเดิมจบก่อนเสมอ การกดส่งคำขอซ้ำระหว่างนั้นไม่ได้ทำให้เร็วขึ้น แต่ทำให้การไล่ตรวจย้อนหลังยากขึ้นสำหรับทั้งสองฝ่าย
      </p>

      <h2 class={`mt-8 mb-6 ${sectionHeadingClass}`}>สิ่งที่เราไม่รับปาก และขอบเขตที่อยากให้ผู้ใช้งานตั้งไว้ก่อนเริ่ม</h2>

      <p class="mb-2 text-left text-base leading-relaxed text-[#ffe9cf]">
        เรื่องที่เราพูดตรงไปตรงมาตั้งแต่ต้นคือ ผลของบาคาร่าคาดเดาไม่ได้และไม่มีใครรับประกันได้ ถ้อยคำอย่างแตกง่ายหรือมั่นคงใช้สื่อถึงความน่าสนใจของการเล่นและความชัดเจนของขั้นตอนที่ตรวจสอบได้เท่านั้น
        ไม่ได้เป็นการรับประกันความปลอดภัยทุกกรณี ไม่ได้เป็นหลักฐานว่าจะได้ผลลัพธ์ตามคาดในรอบใด และไม่ได้เป็นคำมั่นเรื่องระยะเวลาของธุรกรรมทุกกรณี สิ่งที่ควรใช้ประเมินคือความชัดเจนของเงื่อนไข
        ประวัติรายการที่ระบบแสดง และช่องทางติดต่อที่ใช้ได้จริง มากกว่าข้อความโฆษณาเพียงอย่างเดียว สิ่งที่ควรดูควบคู่กันคือระดับความเสี่ยงของตัวเลือกที่ลง
        เพราะตัวเลือกที่อัตราจ่ายสูงมักมีโอกาสออกต่ำกว่า ส่วนตัวเลือกที่จ่ายน้อยกว่าก็แลกมาด้วยความถี่ที่มากกว่า ทั้งสองแบบไม่ได้ดีกว่ากัน แต่เหมาะกับงบคนละขนาด
        ด้วยเหตุนี้เราจึงขอให้ผู้ใช้งานกำหนดวงเงินและระยะเวลาไว้ล่วงหน้า ใช้เฉพาะเงินที่ไม่กระทบค่าใช้จ่ายจำเป็น และไม่เพิ่มยอดเดิมพันเพื่อหวังตามคืนยอดที่เสียไปแล้วหรือเพิ่มตามอารมณ์ระหว่างเล่น
        เพราะแต่ละรอบเป็นผลลัพธ์ที่ไม่ขึ้นกับรอบก่อนหน้า ด้านบัญชี ขอให้เข้าใช้งานผ่านช่องทางหลักที่เว็บไซต์กำหนด ไม่ใช่ลิงก์ที่ส่งต่อกันมาพร้อมคำโฆษณา ตรวจชื่อเว็บไซต์และการเชื่อมต่อแบบ HTTPS
        ทุกครั้งก่อนกรอกข้อมูล ตั้งรหัสผ่านที่คาดเดายากและไม่ซ้ำกับบริการอื่น เลี่ยงเครือข่าย Wi-Fi สาธารณะเมื่อต้องทำธุรกรรม และออกจากระบบเมื่อใช้อุปกรณ์ร่วมกับผู้อื่น
        ทีมงานจะไม่ขอรหัสผ่านหรือรหัสยืนยันจากสมาชิกไม่ว่ากรณีใดและไม่ว่าผ่านช่องทางใด หากมีข้อความในลักษณะนั้นส่งมา ให้ถือว่าไม่ได้มาจากเรา และเมื่อพบรายการที่ผิดปกติ ให้เก็บเวลา จำนวนเงิน
        และเลขอ้างอิงของรายการไว้แจ้งทีมงานตั้งแต่ข้อความแรก เพื่อให้ตรวจสอบต้นเหตุได้ตรงจุดโดยไม่ต้องเปิดเผยข้อมูลลับของบัญชีแก่ผู้ใด
      </p>
    </div>
  </ContentBox>

  <Navfoot />
</MainLayout>
