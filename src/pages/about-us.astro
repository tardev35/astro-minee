---
import MainLayout from "../layouts/MainLayout.astro";
import ContentBox from "../components/ContentBox.astro";
import Navfoot from "../components/Navfoot.astro";
import Announcement from "../components/AnnouncementHuay.astro";
import { pageGraph } from "../lib/schema";

const pageTitle = "เกี่ยวกับ JAIDEEJING แพลตฟอร์มที่รวมประเภทหวย ระบบโพย อัตราจ่าย และผลรางวัลไว้ในบัญชีเดียว";

// One string, two jobs: MainLayout's <meta name="description"> and the WebPage
// node's description. The docx SUB-PAGES block has no row for /about-us, so this
// sentence is written here and held to the 150–160 CHARACTER window that
// tools/verify-build.mjs enforces on any description an agent writes (Thai is 3
// bytes per character, so a byte count reads ~3x too long). This one is 159.
//
// Body copy is deliberately "about the site" — what the platform is, how far a
// member's own use of it goes, and the limits we do not claim past — so it does
// not restate the home page's docx sections. The three H2s below are this page's
// own and deliberately do not echo any docx heading; every claim in them traces
// back to the brief's own cautious wording (รวมประเภทหวย การกรอกเลข ระบบโพย
// อัตราจ่าย และข้อมูลผลรางวัลไว้ในบัญชีเดียว, ตรวจชื่อหวย วันที่ออกรางวัล และเวลา
// ปิดรับให้ครบ, แยกตรวจทีละรายการทั้งเลข ประเภทเดิมพัน และจำนวนเงินก่อนกดยืนยัน,
// เก็บเลขอ้างอิงไว้จนกว่าสถานะโพยจะเสร็จสมบูรณ์, อัตราจ่ายอาจแตกต่างตามประเภทหวย
// รูปแบบเดิมพัน และสถานะของเลข, จ่ายไวไม่ควรตีความว่าเป็นการรับประกันทุกกรณี,
// ตั้งรหัสผ่านที่คาดเดายากและไม่เปิดเผย OTP, หลีกเลี่ยงเครือข่ายสาธารณะ). Nothing
// here promises a prize, a payout rate or a processing time, and nothing claims a
// licence, an award, a founding date, a user count or an office — the brief
// states none of those and neither does this page.
//
// <Announcement /> is bare: AnnouncementHuay's default message is this brand's
// copy, so the ticker matches index.astro without a second string here. The
// variant rotated off AnnouncementCyber, the outgoing brand's pick, per the
// brand spec.
//
// The page list below names only routes that exist this round. /ตรวจหวย stays
// parked in src/pages-disabled/ (operator's uploader toggle), so it is absent —
// it is prose, not links, and this page renders no anchor at all, but a sentence
// pointing at a route that does not exist is the same defect as a dead link.
//
// The brief names no bank, no payment brand and no wallet product, so neither
// does this page: money language stays "ระบบของเว็บไซต์" and "ช่องทางที่เว็บไซต์
// กำหนด".
const pageDescription = "หน้านี้อธิบายว่า JAIDEEJING เป็นแพลตฟอร์มหวยออนไลน์แบบใด รวมประเภทหวย ระบบโพย อัตราจ่าย และผลรางวัลไว้อย่างไร สมาชิกใช้งานได้ถึงขั้นไหน และเราไม่รับปากเรื่องใด";

const graph = pageGraph(Astro, {
  type: "AboutPage",
  name: pageTitle,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "เกี่ยวกับเรา", path: "/about-us" },
  ],
});

// h2 inside the card: white → gold → deep crimson, i.e. the brand's contrast
// note read into its accent, where ContentBox's own h1 gradient opens on pale
// gold and runs pale gold → gold → deep gold. The two levels stay visually
// distinct without either one repeating the other's opening stop, and the pale
// gold stays on the h1 — a second gold-led heading on this maroon-black card is
// where the hierarchy would collapse. No pink: that was the outgoing brand's hue.
const sectionHeadingClass = "bg-gradient-to-r from-[#ffffff] via-[#f5c451] to-[#8f1a10] bg-clip-text text-2xl leading-normal font-bold text-transparent";
---

<MainLayout title="JAIDEEJING | เกี่ยวกับเรา และการรวมประเภทหวยไว้ในระบบเดียว" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBox title={pageTitle} as="h1">
    <div>
      <h2 class={`mb-6 ${sectionHeadingClass}`}>JAIDEEJING คือแพลตฟอร์มแบบไหน และเว็บไซต์นี้มีหน้าอะไรบ้าง</h2>

      <p class="mb-6 text-left text-base leading-relaxed text-[#f7e4c0]">
        <strong class="text-[#ffe08a]">JAIDEEJING</strong> เป็นแพลตฟอร์มหวยออนไลน์ที่รวมประเภทหวย การกรอกเลข ระบบโพย อัตราจ่าย และข้อมูลผลรางวัลไว้ในบัญชีเดียว ตามรายการที่เว็บไซต์กำหนดในแต่ละช่วง
        และรองรับการใช้งานผ่านมือถือ หน้าที่ของเรามีอย่างเดียว คือจัดวางประเภทหวย รอบออกรางวัล โพยที่ส่งไปแล้ว และข้อมูลบัญชีให้อยู่ในที่เดียวกัน แทนที่ผู้ใช้จะต้องเปิดหลายหน้าเพื่อดูว่างวดไหนยังเปิดรับ
        เทียบอัตราจ่ายของเลขแต่ละรูปแบบ แล้วไปตามผลรางวัลจากอีกแหล่งหนึ่ง เมื่อทุกอย่างอยู่ที่จุดเดียว การสลับหน้าไปมาและขั้นตอนที่ไม่จำเป็นจะลดลงเอง แต่การรวมไว้ที่เดียวไม่ได้แปลว่าทุกประเภทหวยใช้กติกาชุดเดียวกัน
        หวยแต่ละรายการยังมีวันออกรางวัล เวลาปิดรับ รูปแบบเดิมพันที่เปิดให้ และอัตราจ่ายของตัวเองอยู่ ระบบจึงแยกหมวดตามประเภทหวยและรอบออกรางวัลไว้ให้ชัด การแยกหมวดไม่ได้มีไว้เพื่อความสวยงามของหน้าเว็บ
        แต่มีไว้ให้ตรวจชื่อหวย วันที่ออกรางวัล เวลาปิดรับ และอัตราจ่ายได้ง่ายขึ้นก่อนกดยืนยัน ส่วนนี้เป็นเจตนาของเราโดยตรง คืออยากให้เลือกจากข้อมูลของงวดที่ตรวจสอบได้จริง มากกว่าเลือกจากคำโปรโมตที่เห็นผ่านตา
        เพราะหวยที่คนซื้อกันมากในงวดหนึ่งไม่จำเป็นต้องเหมาะกับงบและรูปแบบการซื้อของทุกคน ระบบเปิดผ่านเบราว์เซอร์ได้ทั้งบนมือถือและคอมพิวเตอร์โดยไม่ต้องติดตั้งโปรแกรมเพิ่ม ตำแหน่งเมนูและลำดับของข้อมูลจึงอยู่ที่เดิมเมื่อสลับอุปกรณ์ระหว่างวัน
        เนื้อหาบนเว็บไซต์แบ่งเป็นหน้าย่อยไม่กี่หน้าเพื่อให้หาสิ่งที่ต้องการได้เร็ว ได้แก่ หน้าแรกที่อธิบายภาพรวมของระบบและเงื่อนไขการใช้งาน หน้าโปรโมชั่นที่รวมสิทธิพิเศษของแต่ละรายการไว้ด้วยกัน
        หน้าทดลองเล่นสำหรับศึกษาวิธีเลือกเลข รูปแบบเดิมพัน และขั้นตอนตรวจโพยก่อนซื้อจริง หน้าแนวทางที่อธิบายว่าสถิติย้อนหลังใช้ประกอบการตัดสินใจได้แค่ไหน หน้าทางเข้าสำหรับเข้าใช้งานผ่านช่องทางหลัก
        หน้าเกี่ยวกับเราซึ่งเป็นหน้านี้ หน้าติดต่อเราสำหรับส่งเรื่องถึงทีมงานโดยตรง และหน้าเงื่อนไขการใช้งานกับนโยบายความเป็นส่วนตัวที่ระบุขอบเขตของเว็บไซต์นี้ไว้เป็นลายลักษณ์อักษร หน้านี้ไม่ใช่คู่มือการใช้งาน
        แต่มีไว้บอกว่าเราเป็นใคร ตั้งใจให้บริการแบบไหน และผู้ใช้งานควรคาดหวังอะไรได้จากเว็บไซต์นี้
      </p>

      <h2 class={`mt-8 mb-6 ${sectionHeadingClass}`}>สมาชิกใช้งาน JAIDEEJING ได้ตั้งแต่ขั้นไหนจนถึงขั้นไหน</h2>

      <p class="mb-6 text-left text-base leading-relaxed text-[#f7e4c0]">
        เส้นทางการใช้งานบน JAIDEEJING เดินเป็นลำดับเดียวกันเสมอ เริ่มจากการเปิดบัญชีตามเงื่อนไขที่เว็บไซต์กำหนด ซึ่งเราระบุไว้ตรงไปตรงมาว่าขั้นเปิดบัญชีเป็นคนละเรื่องกับขั้นที่ตามมา
        เงื่อนไขด้านการเติมเงิน การรับสิทธิ์โปรโมชั่น และการถอนเป็นคนละชุดกัน และควรอ่านแยกกันตั้งแต่ต้นแทนที่จะเหมารวมเป็นชุดเดียว จากนั้นจึงเลือกว่างวดนี้จะซื้อหวยประเภทใด
        โดยตรวจชื่อหวย วันที่ออกรางวัล และเวลาปิดรับให้ครบก่อน โดยเฉพาะผู้ที่ซื้อหลายงวดในวันเดียว จุดที่เราย้ำเสมอคือหวยแต่ละประเภทปิดรับคนละเวลาและจ่ายคนละอัตรา
        เลข 2 ตัว เลข 3 ตัว และเลขวิ่งนับผลคนละแบบ ส่วนการแทงแบบตรงกับแบบโต๊ดก็คิดเงื่อนไขคนละอย่าง การเลือกรูปแบบเดิมพันโดยยังไม่ได้ดูราคาที่ระบบแสดงจึงทำให้ยอดในโพยไม่ตรงกับที่เข้าใจไว้ตั้งแต่แรก
        หากเพิ่งเริ่มควรเลือกรูปแบบที่เงื่อนไขชัดเจนและตั้งยอดต่อเลขไม่สูงเกินงบ แล้วค่อยขยับไปรูปแบบที่ซับซ้อนขึ้นเมื่อเข้าใจวิธีนับผลแล้ว ขั้นก่อนกดยืนยันโพยคือขั้นที่เราอยากให้ใช้เวลามากที่สุด
        เพราะเป็นขั้นเดียวที่ยังแก้ได้โดยไม่มีต้นทุน เมื่อเลือกเลขหลายชุดควรแยกตรวจทีละรายการทั้งตัวเลข ประเภทเดิมพัน และจำนวนเงินก่อนกดยืนยัน การจัดโพยให้เป็นระเบียบช่วยลดโอกาสกรอกเลขผิดหรือเลือกงวดไม่ตรง
        พร้อมตรวจว่าสิทธิ์โปรโมชั่นที่ถืออยู่ผูกกับประเภทหวยนั้นหรือไม่ เพราะบางรายการกำหนดหวยที่ร่วมรายการและระยะเวลาไว้เฉพาะ
        ฝั่งบัญชีเดินคนละแบบกับฝั่งโพย คือรวมข้อมูลบัญชี สิทธิ์โปรโมชั่นที่ถืออยู่ ยอดคงเหลือ ประวัติรายการ และสถานะของโพยที่ยังรอผลไว้ในระบบเดียว
        ระบบที่ใช้งานง่ายช่วยลดขั้นตอนตรงนี้ให้สั้นลง แต่ไม่ได้ลดหน้าที่ในการตรวจของผู้ใช้งาน หลังส่งโพยแล้วควรเก็บเลขอ้างอิงของรายการไว้จนกว่าจะประกาศผลหรือสถานะของโพยจะเสร็จสมบูรณ์
        และก่อนยืนยันธุรกรรมทุกครั้งควรตรวจจำนวนเงินและบัญชีสมาชิกให้ตรงกัน แล้วรอให้รายการเดิมอัปเดตสถานะก่อนทำรายการใหม่เสมอ การกดส่งซ้ำระหว่างนั้นไม่ได้ทำให้เร็วขึ้น
        แต่เพิ่มโอกาสเกิดรายการซ้ำหรือยอดคลาดเคลื่อน และทำให้การไล่ตรวจย้อนหลังยากขึ้นสำหรับทั้งสองฝ่าย หลังประกาศผลควรตรวจโพยและยอดจากหน้าบัญชีของตัวเองเป็นหลัก หากสถานะยังไม่อัปเดต
        ให้เก็บเวลา จำนวนเงิน และเลขอ้างอิงของรายการไว้ติดต่อทีมงานเพื่อขอตรวจสอบเพิ่มเติม ส่วนสิทธิ์โปรโมชั่นให้ตรวจจากหน้าบัญชีก่อนเริ่มทุกครั้ง ทั้งชื่อโปรโมชั่น จำนวนเครดิต และเงื่อนไขที่เกี่ยวข้อง
        หากมีหลายโปรพร้อมกันควรดูว่าใช้ร่วมกันได้หรือไม่ และควรเก็บรายละเอียดสิทธิ์ไว้จนกว่าการใช้งานหรือการถอนจะเสร็จสมบูรณ์
      </p>

      <h2 class={`mt-8 mb-6 ${sectionHeadingClass}`}>สิ่งที่เราไม่รับปาก และขอบเขตที่อยากให้ผู้ใช้งานตั้งไว้ก่อนเริ่ม</h2>

      <p class="mb-2 text-left text-base leading-relaxed text-[#f7e4c0]">
        เรื่องที่เราพูดตรงไปตรงมาตั้งแต่ต้นคือ ถ้อยคำที่ใช้กันทั่วไปในวงการนี้เป็นข้อความทางการตลาด ไม่ใช่หลักฐานในตัวเอง คำว่าจ่ายไวควรพิจารณาจากสถานะรายการที่ระบบแสดงจริง
        ไม่ควรตีความว่าเป็นการรับประกันทุกกรณี เพราะสถานะของแต่ละรายการขึ้นอยู่กับบัญชี ประเภทหวย และขั้นตอนตรวจสอบของงวดนั้น คำว่าจ่ายดีก็ไม่ได้หมายความว่าทุกรูปแบบเดิมพันให้ผลตอบแทนเท่ากัน
        เพราะอัตราจ่ายอาจแตกต่างตามประเภทหวย รูปแบบเดิมพัน และสถานะของเลขในงวดนั้น จึงควรดูราคาที่ระบบแสดงก่อนยืนยันทุกครั้ง แล้วเลือกจากข้อมูลมากกว่าคำโปรโมต
        และไม่ควรถือว่าอัตราจ่ายสูงหมายถึงมีโอกาสถูกรางวัลมากขึ้น เช่นเดียวกับคำว่าโปรแรง ซึ่งโดยทั่วไปสื่อถึงจำนวนเครดิตหรือสิทธิ์ที่เว็บไซต์กำหนดในช่วงนั้น
        แต่เงื่อนไขจริงต่างกันตามรายการ ทั้งยอดขั้นต่ำ ประเภทหวยที่ร่วมรายการ ระยะเวลา และเงื่อนไขการถอน จึงควรอ่านให้ครบก่อนกดรับสิทธิ์ทุกครั้ง
        ในทางเดียวกัน โปรโมชั่นที่ดูคุ้มไม่จำเป็นต้องเป็นโปรที่ให้เครดิตมากที่สุด ควรเปรียบเทียบยอดรับโบนัส ยอดขั้นต่ำ หวยที่ร่วมรายการ ระยะเวลา และข้อกำหนดการถอนร่วมกัน
        เพราะโปรที่เหมาะกับงบและจำนวนงวดที่ตั้งใจซื้ออาจคุ้มกว่าข้อเสนอที่ให้เครดิตสูงแต่มีข้อจำกัดมาก และไม่ควรเป็นโปรที่บังคับให้เพิ่มยอดเกินแผนที่ตั้งไว้ตั้งแต่แรก
        ผลการออกรางวัลเป็นสิ่งที่คาดเดาไม่ได้ งวดก่อนหน้าไม่ได้กำหนดงวดถัดไป และการนับสถิติย้อนหลังก็ไม่ได้ทำให้คาดเดาได้แม่นขึ้น เราจึงไม่ชี้เลข ไม่ขายสูตร และไม่รับประกันผล รายได้ หรือกำไรไม่ว่ากรณีใด
        ด้วยเหตุนี้เราจึงขอให้ผู้ใช้งานกำหนดวงเงินต่องวดไว้ล่วงหน้า ใช้เฉพาะเงินที่ไม่กระทบค่าใช้จ่ายจำเป็น หยุดเมื่อถึงวงเงินที่ตั้งไว้ และไม่เพิ่มยอดเพื่อตามคืนสิ่งที่เสียไปในงวดก่อน
        ด้านบัญชี ขอให้เข้าใช้งานผ่านช่องทางหลักที่เว็บไซต์กำหนด ไม่ใช่ลิงก์ที่ส่งต่อกันมาพร้อมคำโฆษณา ตรวจชื่อเว็บไซต์และการเชื่อมต่อแบบ HTTPS ทุกครั้งก่อนกรอกข้อมูล
        ตั้งรหัสผ่านที่คาดเดายากและไม่ซ้ำกับบริการอื่น หลีกเลี่ยงเครือข่ายสาธารณะเมื่อต้องจัดการข้อมูลบัญชีหรือทำธุรกรรม และออกจากระบบเมื่อใช้อุปกรณ์ร่วมกับผู้อื่น
        ทีมงานจะไม่ขอรหัสผ่าน รหัส OTP หรือรหัสยืนยันจากสมาชิกไม่ว่ากรณีใดและไม่ว่าผ่านช่องทางใด หากมีข้อความในลักษณะนั้นส่งมา ให้ถือว่าไม่ได้มาจากเรา
        และเมื่อพบรายการที่ผิดปกติ ให้เก็บเวลา จำนวนเงิน และเลขอ้างอิงของรายการไว้แจ้งทีมงานตั้งแต่ข้อความแรก เพื่อให้ตรวจสอบต้นเหตุได้ตรงจุดโดยไม่ต้องเปิดเผยข้อมูลลับของบัญชีแก่ผู้ใด
      </p>
