---
import MainLayout from "../layouts/MainLayout.astro";
import Announcement from "../components/AnnouncementCyber.astro";
import ContentBoxPremium from "../components/ContentBoxPremium.astro";
import ContentBox from "../components/ContentBox.astro";
import ContentBoxSpecial from "../components/ContentBoxSpecial.astro";
import ContentBoxCyberCut from "../components/ContentBoxCyberCut.astro";
import ContentBoxSevenThreePremium from "../components/ContentBoxSevenThreePremium.astro";
import ContentBoxSevenThreeCyberCut from "../components/ContentBoxSevenThreeCyberCut.astro";
import ProviderGrid from "../components/ProviderGrid.astro";
import GameRankingBoard from "../components/GameRankingBoard.astro";
import LoginRtpSection from "../components/LoginRtpSection.astro";
import ReviewCardSumo2 from "../components/ReviewCardSumo2.astro";
import LatestWinners from "../components/LatestWinnersCyber.astro";
import SmoothCarousel from "../components/SmoothCarousel.astro";
import Faq from "../components/Faq.astro";
import Navfoot from "../components/Navfoot.astro";

import { Picture } from "astro:assets";
import { pageGraph } from "../lib/schema";

// Slides live only inside a ContentBoxSevenThree* block and there are at most
// two of those per rebrand — both are spent here.
//
// slide3 prints "สมาชิกใหม่ รับโบนัส 50%", which is the promotion the โปรทุนน้อย
// section is about; slide1 is the brand board and prints "ฝาก-ถอนออโต้ รวดเร็ว"
// with a ระบบออโต้ badge, so it sits with the ฝากถอนออโต้ section. slide2
// (คืนยอดเสีย 0.8%) and slide4 (แนะนำเพื่อน 10%) stay unused here and keep
// rendering in SmoothCarousel and on /promotion.
//
// banner2.png is NOT imported anywhere: it is stale artwork from an older drop.
import imgNewMemberBonus from "../assets/slide3.png";
import imgAutoCashier from "../assets/slide1.png";

const pageTitle = "KIKI49 | เว็บสล็อตฝากถอนออโต้รวดเร็ว แตกง่าย โปรทุนน้อย ไม่มีขั้นต่ำ";
const pageHeading = "KIKI49 เว็บสล็อตฝากถอนออโต้รวดเร็ว แตกง่าย โปรทุนน้อย ไม่มีขั้นต่ำ";

// The docx Meta Description, verbatim at the length it was written (129
// characters). DESC_MIN does not apply to the home page — verify-build.mjs
// exempts it precisely so the brand's own copy ships unpadded. Do not top it
// up to 150.
const pageDescription = "KIKI49 เว็บสล็อตฝากถอนออโต้รวดเร็ว โปรทุนน้อย ไม่มีขั้นต่ำตามเงื่อนไข รองรับมือถือ พร้อมเกมหลากหลายและบริการสมาชิกตลอด 24 ชั่วโมง";

// The docx Q&A block, verbatim. Passed as an explicit prop rather than left to
// Faq's own default, which is always the previous brand's FAQ.
const faqs = [
  {
    q: "KIKI49 เหมาะกับผู้เล่นทุนน้อยหรือไม่?",
    a: "โปรโมชั่นบางรายการถูกออกแบบให้เริ่มต้นด้วยงบไม่สูง แต่ควรตรวจสอบยอดฝาก เงื่อนไขรับโบนัส และข้อกำหนดการถอนก่อนเลือกรับสิทธิ์ทุกครั้ง",
  },
  {
    q: "KIKI49 ฝากถอนไม่มีขั้นต่ำทุกช่องทางหรือไม่?",
    a: "เงื่อนไขไม่มีขั้นต่ำอาจใช้เฉพาะช่องทางที่กำหนด สมาชิกควรตรวจสอบรายละเอียดล่าสุดและเงื่อนไขของโปรโมชั่นก่อนทำรายการ",
  },
  {
    q: "ระบบฝากถอนออโต้ของ KIKI49 รวดเร็วแค่ไหน?",
    a: "ระบบออโต้ช่วยลดขั้นตอนการทำรายการ แต่ระยะเวลาอาจแตกต่างตามช่องทางชำระเงิน สถานะบัญชี และขั้นตอนตรวจสอบของระบบ",
  },
];

// Homepage: no breadcrumb — there is no trail above the root.
const graph = pageGraph(Astro, {
  name: pageHeading,
  description: pageDescription,
  faqs,
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement
    message="KIKI49 เป็นแพลตฟอร์มเกมสล็อตออนไลน์ที่เน้นความสะดวกในการใช้งานและการจัดการธุรกรรมผ่านระบบออโต้ • ภายในมีเกมสล็อตหลายแนวทั้งแบบคลาสสิก เกมโบนัส และเกมที่มีฟีเจอร์หลากหลาย ควรพิจารณากติกา ความผันผวน และรูปแบบการจ่ายก่อนเริ่ม • โปรโมชั่นสำหรับผู้เล่นทุนน้อยมียอดเริ่มต้นและเงื่อนไขรับสิทธิ์ต่างกัน ควรเปรียบเทียบให้ครบก่อนเลือก • เงื่อนไขไม่มีขั้นต่ำใช้ได้เฉพาะช่องทางที่กำหนด • ก่อนยืนยันฝากถอนควรตรวจสอบชื่อบัญชีและจำนวนเงินให้ถูกต้อง หากรายการยังดำเนินการอยู่ควรรอผลจากระบบก่อนทำรายการซ้ำ • รองรับการใช้งานผ่านมือถือได้อย่างคล่องตัว"
  />

  <ContentBoxPremium as="h1" title={pageHeading}>
    <p class="text-left text-base leading-relaxed text-[#f2e2e4]">
      <strong class="text-[#ff5a5f]">KIKI49</strong> เป็นแพลตฟอร์มเกมสล็อตออนไลน์ที่เน้นความสะดวกในการใช้งานและการจัดการธุรกรรมผ่านระบบออโต้ รองรับผู้เล่นที่ต้องการเริ่มต้นด้วยงบประมาณไม่สูง พร้อมเงื่อนไขไม่มีขั้นต่ำในช่องทางที่กำหนด
      ภายในมีเกมสล็อตหลายรูปแบบให้เลือก และรองรับการใช้งานผ่านมือถือได้อย่างคล่องตัว
    </p>
  </ContentBoxPremium>

  <ContentBox as="h2" title="เริ่มเล่นสล็อตด้วยงบที่เหมาะสมบน KIKI49">
    <p class="text-left text-base leading-relaxed text-[#f2e2e4]">
      ภายใน KIKI49 มีเกมสล็อตหลายแนวให้เลือกทั้งแบบคลาสสิก เกมโบนัส และเกมที่มีฟีเจอร์หลากหลาย ผู้เล่นสามารถพิจารณาจากกติกา ความผันผวน และรูปแบบการจ่ายก่อนเริ่ม
      เพื่อเลือกเกมที่สอดคล้องกับงบประมาณและไม่จำเป็นต้องเริ่มด้วยเงินจำนวนสูง
    </p>
  </ContentBox>

  <ProviderGrid />

  <ContentBoxSevenThreePremium titleright="โปรทุนน้อยช่วยให้วางแผนการเล่นได้ยืดหยุ่น">
    <Picture
      slot="left"
      src={imgNewMemberBonus}
      loading="lazy"
      fetchpriority="low"
      widths={[300, 450, 600]}
      sizes="(max-width: 768px) calc(100vw - 6rem), 350px"
      decoding="async"
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      quality={80}
      alt="แบนเนอร์โปรโมชั่น KIKI49 ข้อความ สมาชิกใหม่ รับโบนัส 50% สมัครวันนี้ รับสิทธิ์ทันที และปุ่ม รับโปรเลย พร้อมผู้หญิงในชุดดำแดงติดโลโก้ KIKI49 ชี้มาที่ตัวเลข มาสคอตเพนกวินโครงกระดูกสวมฮู้ดดำบนโลโก้ ตู้สล็อตเลข 777 ลูกเต๋าแดง กล่องของขวัญและเหรียญทองในห้องคาสิโนไฟนีออนแดง"
      class="mx-auto h-auto w-full rounded-2xl border border-[#e2131d]/40 shadow-[0_10px_30px_rgba(226,19,29,0.28)]"
    />
    <p slot="right" class="text-left text-base leading-relaxed text-[#f2e2e4]">
      โปรโมชั่นสำหรับผู้เล่นทุนน้อยอาจกำหนดยอดเริ่มต้นและเงื่อนไขรับสิทธิ์แตกต่างกัน ควรเปรียบเทียบโบนัส เกมที่เข้าร่วม และข้อกำหนดการถอนให้ครบก่อนเลือก
      เพื่อให้โปรโมชั่นช่วยเพิ่มความคุ้มค่าโดยไม่ทำให้ต้องเพิ่มเงินเกินแผนที่ตั้งไว้
    </p>
  </ContentBoxSevenThreePremium>

  <ContentBoxSevenThreeCyberCut titleright="ฝากถอนออโต้รวดเร็วผ่านระบบของ KIKI49">
    <Picture
      slot="left"
      src={imgAutoCashier}
      loading="lazy"
      fetchpriority="low"
      widths={[300, 450, 600]}
      sizes="(max-width: 768px) calc(100vw - 6rem), 380px"
      decoding="async"
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      quality={80}
      alt="แบนเนอร์ KIKI49 ข้อความ เว็บสล็อต แตกง่าย โปรคุ้มทุกวัน ฝาก-ถอนออโต้ รวดเร็ว เล่นง่าย จ่ายจริง ป้าย ระบบออโต้ โบนัสคุ้ม บริการ 24 ชม. และปุ่ม สมัครเลย พร้อมมาสคอตเพนกวินสวมชุดโครงกระดูกบนโลโก้ ผู้หญิงในชุดดำแดงติดโลโก้ KIKI49 วงล้อสล็อตเลข 777 ป้ายไฟ JACKPOT เหรียญทอง ลูกเต๋าแดงและชิปคาสิโน ในห้องคาสิโนไฟนีออนแดง"
      class="mx-auto h-auto w-full rounded-2xl border border-[#e2131d]/40 shadow-[0_10px_30px_rgba(226,19,29,0.28)]"
    />
    <p slot="right" class="text-left text-base leading-relaxed text-[#f2e2e4]">
      ระบบออโต้ของ KIKI49 ช่วยให้สมาชิกฝาก ถอน และตรวจสอบสถานะรายการผ่านหน้าบัญชีได้ด้วยตนเอง ก่อนยืนยันควรตรวจสอบชื่อบัญชี จำนวนเงิน และข้อมูลให้ถูกต้อง
      หากรายการยังดำเนินการอยู่ควรรอผลจากระบบก่อนทำรายการซ้ำ
    </p>
  </ContentBoxSevenThreeCyberCut>

  <LatestWinners />

  <ContentBoxSpecial as="h2" title="ไม่มีขั้นต่ำกับ KIKI49 ช่วยกำหนดยอดได้ง่ายขึ้น" iconleft="💰" iconright="🔍">
    <p slot="left" class="text-left text-base leading-relaxed text-[#f2e2e4]">เงื่อนไขไม่มีขั้นต่ำของ KIKI49 ช่วยให้สมาชิกเลือกจำนวนเงินตามงบของตนเองได้ยืดหยุ่นมากขึ้น</p>
    <p slot="right" class="text-left text-base leading-relaxed text-[#f2e2e4]">
      อย่างไรก็ตาม ควรตรวจสอบช่องทางที่รองรับและเงื่อนไขโปรโมชั่นก่อนทำรายการ รวมถึงกำหนดวงเงินที่สามารถยอมรับความเสี่ยงได้
    </p>
  </ContentBoxSpecial>

  <ContentBoxCyberCut as="h2" title="เกมแตกง่ายควรเลือกจากข้อมูลของเกมเป็นหลัก">
    <p class="text-left text-base leading-relaxed text-[#f2e2e4]">
      คำว่าแตกง่ายใช้สื่อถึงเกมที่มีจังหวะลุ้นรางวัลและฟีเจอร์ที่น่าสนใจ แต่ไม่สามารถรับประกันผลลัพธ์ได้ ผู้เล่นควรตรวจสอบอัตราจ่าย ความผันผวน และกติกาของเกมก่อนเริ่ม
      พร้อมกำหนดเวลาและงบประมาณให้ชัดเจนเพื่อควบคุมการใช้งาน
    </p>
  </ContentBoxCyberCut>

  <GameRankingBoard />

  <ContentBox as="h2" title="ตรวจสอบบัญชีและรับบริการจากทีม KIKI49">
    <p class="text-left text-base leading-relaxed text-[#f2e2e4]">
      เมื่อพบปัญหาเกี่ยวกับบัญชี ทางเข้า โปรโมชั่น หรือสถานะธุรกรรม สมาชิกสามารถติดต่อทีมงาน KIKI49 ผ่านช่องทางที่เว็บไซต์ระบุ ควรเตรียมชื่อผู้ใช้ เวลา และรายละเอียดรายการให้ครบ
      โดยไม่เปิดเผยรหัสผ่านหรือรหัสยืนยัน เพื่อช่วยให้ตรวจสอบได้รวดเร็วขึ้น
    </p>
  </ContentBox>

  <Faq title="คำถามที่พบบ่อยเกี่ยวกับ KIKI49" faqs={faqs} />

  <LoginRtpSection />

  <div class="relative z-10 mx-auto mb-10 flex flex-nowrap justify-center gap-3 px-4 sm:gap-6">
    <a
      href="/login"
      class="group relative flex flex-1 items-center justify-center rounded-full bg-gradient-to-r from-[#ff5a5f] via-[#e2131d] to-[#a80f16] px-4 py-3 text-sm font-black whitespace-nowrap text-[#fff5f5] shadow-[0_10px_30px_rgba(226,19,29,0.32)] transition-all duration-300 hover:-translate-y-1 hover:scale-105 hover:shadow-[0_15px_40px_rgba(226,19,29,0.48)] sm:flex-none sm:px-10 sm:py-3.5 sm:text-base">
      เข้าสู่ระบบ
    </a>

    <a
      href="/register"
      class="group relative flex flex-1 items-center justify-center rounded-full border-2 border-[#ffe08a]/70 bg-gradient-to-r from-[#ffe08a] to-[#f5c542] px-4 py-3 text-sm font-black whitespace-nowrap text-[#2a0206] shadow-[0_10px_30px_rgba(245,197,66,0.35)] transition-all duration-300 hover:-translate-y-1 hover:scale-105 hover:border-[#ffe08a] hover:shadow-[0_15px_40px_rgba(245,197,66,0.5)] sm:flex-none sm:px-10 sm:py-3.5 sm:text-base">
      สมัครสมาชิก
    </a>
  </div>

  <SmoothCarousel />

  <ReviewCardSumo2 />

  <Navfoot />
</MainLayout>
