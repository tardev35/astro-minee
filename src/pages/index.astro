---
import MainLayout from "../layouts/MainLayout.astro";
import Announcement from "../components/Announcement4.astro";
import ContentBoxNeumorphism from "../components/ContentBoxNeumorphism.astro";
import ContentBoxSevenThreeNeumorphism from "../components/ContentBoxSevenThreeNeumorphism.astro";
import ContentBoxSevenThreeFloatingBadge from "../components/ContentBoxSevenThreeFloatingBadge.astro";
import ContentBox from "../components/ContentBox.astro";
import ContentBoxFloatingBadge from "../components/ContentBoxFloatingBadge.astro";
import ContentBoxTwoNeumorphism from "../components/ContentBoxTwoNeumorphism.astro";
import ContentBoxTwoFloatingBadge from "../components/ContentBoxTwoFloatingBadge.astro";
import ProviderGrid from "../components/ProviderGrid.astro";
import GameRankingBoard from "../components/GameRankingBoard.astro";
import LoginRtpSection from "../components/LoginRtpSection.astro";
import ReviewCardSumo2 from "../components/ReviewCardSumo2.astro";
import LatestWinners from "../components/LatestWinners2.astro";
import SmoothCarousel from "../components/SmoothCarousel.astro";
import Faq from "../components/Faq4.astro";
import Navfoot from "../components/Navfoot.astro";

import { Picture } from "astro:assets";
import { pageGraph } from "../lib/schema";

// Slides live only inside a ContentBoxSevenThree* block and there are at most
// two of those per rebrand — both are spent here.
//
// slide2 prints "ฝากครั้งแรก รับเพิ่ม 20% / ฝากง่าย ถอนเร็ว ระบบออโต้", which is the
// deposit/withdraw flow the True Wallet section describes; slide1 prints
// "สมาชิกใหม่ รับโบนัส 50% / สมัครวันนี้ รับสิทธิ์ทันที", the entry point the
// no-minimum/budget section is about. slide3 (แนะนำเพื่อน 10%) and slide4
// (คืนยอดเสีย 0.8%) stay unused here and keep rendering in SmoothCarousel and on
// /promotion.
//
// banner2.png is NOT imported anywhere: it predates this asset drop.
// banner1/banner1-mobile are the hero and belong to MainLayout alone.
import imgTrueWallet from "../assets/slide2.png";
import imgNoMinimum from "../assets/slide1.png";

const pageTitle = "MAX56 | สล็อตฝากถอน true wallet ไม่มีขั้นต่ำ แตกง่ายจ่ายจริงทุกยอด";
const pageHeading = "MAX56 สล็อตฝากถอน true wallet ไม่มีขั้นต่ำ แตกง่ายจ่ายจริงทุกยอด";

// The docx Meta Description, verbatim at the length it was written (137
// characters). DESC_MIN does not apply to the home page — verify-build.mjs
// exempts it precisely so the brand's own copy ships unpadded. Do not top it
// up to 150.
const pageDescription = "MAX56 สล็อตฝากถอนผ่าน True Wallet ไม่มีขั้นต่ำตามเงื่อนไข รองรับมือถือ ระบบใช้งานสะดวก พร้อมเกมหลากหลายและตรวจสอบรายการได้ง่าย";

// The docx Q&A block, verbatim. Passed as an explicit prop rather than left to
// Faq4's own default, which is always the previous brand's FAQ.
const faqs = [
  {
    q: "MAX56 รองรับการฝากถอนผ่าน True Wallet หรือไม่?",
    a: "รองรับ True Wallet ตามช่องทางที่ระบบกำหนด สมาชิกควรตรวจสอบข้อมูล Wallet จำนวนเงิน และสถานะรายการทุกครั้งก่อนและหลังทำธุรกรรม",
  },
  {
    q: "MAX56 ฝากถอนไม่มีขั้นต่ำทุกช่องทางหรือไม่?",
    a: "เงื่อนไขไม่มีขั้นต่ำอาจใช้เฉพาะช่องทางหรือรายการที่กำหนด จึงควรตรวจสอบรายละเอียดล่าสุดและเงื่อนไขโปรโมชั่นก่อนทำรายการทุกครั้ง",
  },
  {
    q: "คำว่าจ่ายจริงทุกยอดหมายถึงรับประกันการถอนได้หรือไม่?",
    a: "ไม่ควรตีความว่าเป็นการรับประกันทุกกรณี เพราะการถอนอาจขึ้นอยู่กับสถานะบัญชี เงื่อนไขโปรโมชั่น และการตรวจสอบของระบบ ควรอ่านข้อกำหนดก่อนใช้งาน",
  },
];

// Homepage: no breadcrumb — there is no trail above the root.
const graph = pageGraph(Astro, {
  name: pageHeading,
  description: pageDescription,
  faqs,
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBoxNeumorphism as="h1" title={pageHeading}>
    <p class="text-left text-base leading-relaxed text-[#f6e4e4]">
      <strong class="text-[#f5c451]">MAX56</strong> เป็นแพลตฟอร์มเกมสล็อตออนไลน์ที่เน้นความสะดวกด้านการทำธุรกรรมผ่าน True Wallet พร้อมเงื่อนไขไม่มีขั้นต่ำในช่องทางที่กำหนด
      รองรับการใช้งานบนมือถือและคอมพิวเตอร์ สมาชิกสามารถเลือกเกม ตรวจสอบโปรโมชั่น และติดตามสถานะรายการได้จากบัญชีเดียว ก่อนเริ่มควรอ่านกติกาและเงื่อนไขที่เกี่ยวข้องให้ครบถ้วน
    </p>
  </ContentBoxNeumorphism>

  <ContentBoxSevenThreeNeumorphism titleright="ฝากถอนผ่าน True Wallet ได้สะดวกกับ MAX56">
    <Picture
      slot="left"
      src={imgTrueWallet}
      loading="lazy"
      fetchpriority="low"
      widths={[300, 450, 600]}
      sizes="(max-width: 768px) calc(100vw - 6rem), 380px"
      decoding="async"
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      quality={80}
      alt="แบนเนอร์โปรโมชั่น MAX56 ข้อความ ฝากครั้งแรก รับเพิ่ม 20% พร้อมป้าย คุ้มตั้งแต่ฝากแรก ฝากง่าย ถอนเร็ว ระบบออโต้ และปุ่มสีแดง ฝากเลย พร้อมโลโก้ MAX56 ช้างเผือกสามมิติ ผู้หญิงในชุดกีฬาสีแดง-ขาวพิมพ์ MAX56 ชี้นิ้วขึ้น วงล้อสล็อตเลข 77 ป้าย BONUS และคำว่า BAR เหรียญทองปลิว ชิปคาสิโนสีแดง-ขาว-ดำ และกล่องของขวัญผูกโบว์แดงบนพื้นหลังคาสิโนโทนแดงเข้ม"
      class="mx-auto h-auto w-full rounded-2xl border border-[#c10d1e]/40 shadow-[0_10px_30px_rgba(232,32,47,0.28)]"
    />
    <p slot="right" class="text-left text-base leading-relaxed text-[#f6e4e4]">
      การรองรับ True Wallet ของ MAX56 ช่วยให้สมาชิกจัดการรายการผ่านมือถือได้สะดวกขึ้น ก่อนยืนยันควรตรวจสอบเบอร์หรือข้อมูล Wallet จำนวนเงิน และรายละเอียดบัญชีให้ตรงกันทุกครั้ง
      รวมถึงรอให้ระบบแสดงสถานะสำเร็จก่อนทำรายการใหม่ เพื่อลดความคลาดเคลื่อน
    </p>
  </ContentBoxSevenThreeNeumorphism>

  <ContentBoxSevenThreeFloatingBadge title="ไม่มีขั้นต่ำช่วยให้กำหนดงบได้ยืดหยุ่นขึ้น">
    <Picture
      slot="left"
      src={imgNoMinimum}
      loading="lazy"
      fetchpriority="low"
      widths={[300, 450, 600]}
      sizes="(max-width: 768px) calc(100vw - 6rem), 350px"
      decoding="async"
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      quality={80}
      alt="แบนเนอร์โปรโมชั่น MAX56 ข้อความ สมาชิกใหม่ รับโบนัส 50% สมัครวันนี้ รับสิทธิ์ทันที โบนัสต้อนรับสำหรับผู้เล่นใหม่ และปุ่มสีแดง รับโปรเลย พร้อมโลโก้ MAX56 ช้างเผือกสามมิติสวมสายสะพาย ผู้หญิงในชุดเดรสสีแดง-ขาวพิมพ์ MAX56 ชี้นิ้วขึ้น วงล้อสล็อตเลข 777 และคำว่า BAR เหรียญทองปั๊มโลโก้ MAX56 กล่องของขวัญผูกโบว์แดง และแถบข้อความ ปลอดภัยมั่นใจ 100% ฝาก-ถอนเร็วภายใน 10 วินาที บริการ 24 ชม."
      class="mx-auto h-auto w-full rounded-2xl border border-[#c10d1e]/40 shadow-[0_10px_30px_rgba(232,32,47,0.28)]"
    />
    <p slot="right" class="text-left text-base leading-relaxed text-[#f6e4e4]">
      เงื่อนไขไม่มีขั้นต่ำช่วยให้ผู้เล่นเลือกจำนวนเงินตามงบประมาณของตนเองได้ง่ายขึ้น แต่ควรตรวจสอบว่าช่องทางใดรองรับ รวมถึงอ่านข้อกำหนดของโปรโมชั่นก่อนทำรายการ
      การกำหนดวงเงินไว้ล่วงหน้าจะช่วยให้ควบคุมค่าใช้จ่ายได้เป็นระบบมากขึ้น
    </p>
  </ContentBoxSevenThreeFloatingBadge>

  <ContentBox as="h2" title="เลือกเกมสล็อตหลายแนวได้บน MAX56">
    <p class="text-left text-base leading-relaxed text-[#f6e4e4]">
      ภายใน MAX56 มีเกมสล็อตหลายรูปแบบ ทั้งเกมคลาสสิก เกมโบนัส และเกมธีมใหม่ ผู้เล่นสามารถพิจารณาจากกติกา ความผันผวน และรูปแบบการจ่ายก่อนเลือกเล่น
      เพื่อช่วยให้ได้เกมที่เหมาะกับสไตล์และงบของตนเองมากกว่าการเลือกจากคำโฆษณาเพียงอย่างเดียว
    </p>
  </ContentBox>

  <ProviderGrid />

  <ContentBoxFloatingBadge as="h2" title="คำว่าแตกง่ายควรดูควบคู่กับข้อมูลของเกม">
    <p class="text-left text-base leading-relaxed text-[#f6e4e4]">
      เกมที่ถูกนำเสนอว่าแตกง่ายอาจมีฟีเจอร์หรือจังหวะลุ้นรางวัลที่น่าสนใจ แต่ไม่ได้หมายความว่าจะได้ผลลัพธ์ตามคาดทุกครั้ง ผู้เล่นควรตรวจสอบอัตราจ่าย ความผันผวน และเงื่อนไขโบนัส
      พร้อมกำหนดวงเงินและระยะเวลาในการเล่นให้ชัดเจน
    </p>
  </ContentBoxFloatingBadge>

  <GameRankingBoard />

  <ContentBoxTwoNeumorphism titleleft="ตรวจสอบสถานะรายการผ่านระบบ MAX56">
    <p slot="left" class="text-left text-base leading-relaxed text-[#f6e4e4]">
      สมาชิก MAX56 สามารถติดตามยอดฝาก ถอน และสถานะธุรกรรมผ่านหน้าบัญชีได้ หากพบว่ารายการยังอยู่ระหว่างดำเนินการควรรอผลจากระบบก่อนส่งรายการซ้ำ และควรเก็บข้อมูลอ้างอิง เวลา
      และจำนวนเงินไว้จนกว่าธุรกรรมจะเสร็จสมบูรณ์
    </p>

    <div slot="right" class="flex flex-col gap-3 rounded-2xl border border-[#c10d1e]/25 bg-[#0d0204]/70 p-5">
      <p class="flex items-center gap-2 text-sm font-black tracking-widest text-[#f5c451] uppercase">
        <span aria-hidden="true">🧭</span>
        ข้อมูลที่ควรเก็บไว้จนรายการเสร็จสมบูรณ์
      </p>
      <span class="flex items-start gap-2.5 text-sm text-[#f6e4e4]">
        <span aria-hidden="true" class="mt-0.5 shrink-0 text-[#ff5a66]">①</span>
        ข้อมูลอ้างอิงของรายการฝากหรือถอน
      </span>
      <span class="flex items-start gap-2.5 text-sm text-[#f6e4e4]">
        <span aria-hidden="true" class="mt-0.5 shrink-0 text-[#ff5a66]">②</span>
        เวลาที่ทำรายการและช่องทางที่ใช้
      </span>
      <span class="flex items-start gap-2.5 text-sm text-[#f6e4e4]">
        <span aria-hidden="true" class="mt-0.5 shrink-0 text-[#ff5a66]">③</span>
        จำนวนเงินและสถานะล่าสุดที่ระบบแสดง
      </span>
      <span class="mt-1 rounded-xl border border-[#f5c451]/35 bg-[#2a070d]/70 px-4 py-2.5 text-xs leading-relaxed text-[#f6e4e4]/80">
        ระหว่างที่รายการยังอยู่ระหว่างดำเนินการ ควรรอผลจากระบบก่อน ไม่ควรส่งรายการซ้ำทันที
      </span>
    </div>
  </ContentBoxTwoNeumorphism>

  <ContentBoxTwoFloatingBadge titleleft="ดูแลบัญชีและข้อมูลการใช้งานกับทีม MAX56">
    <p slot="left" class="text-left text-base leading-relaxed text-[#f6e4e4]">
      หากมีข้อสงสัยเกี่ยวกับบัญชี โปรโมชั่น ทางเข้า หรือสถานะรายการ สามารถติดต่อทีมงาน MAX56 ผ่านช่องทางที่เว็บไซต์กำหนด ควรแจ้งชื่อผู้ใช้ เวลา และรายละเอียดปัญหาให้ครบ
      โดยไม่เปิดเผยรหัสผ่านหรือรหัสยืนยัน เพื่อช่วยให้ตรวจสอบได้ตรงจุด
    </p>

    <div slot="right" class="flex flex-col gap-3 rounded-2xl border border-[#c10d1e]/25 bg-[#0d0204]/70 p-5">
      <p class="flex items-center gap-2 text-sm font-black tracking-widest text-[#f5c451] uppercase">
        <span aria-hidden="true">🛟</span>
        สิ่งที่ควรเตรียมก่อนติดต่อทีมงาน
      </p>
      <span class="flex items-start gap-2.5 text-sm text-[#f6e4e4]">
        <span aria-hidden="true" class="mt-0.5 shrink-0 text-[#ff5a66]">①</span>
        ชื่อผู้ใช้ที่ใช้เข้าสู่ระบบ
      </span>
      <span class="flex items-start gap-2.5 text-sm text-[#f6e4e4]">
        <span aria-hidden="true" class="mt-0.5 shrink-0 text-[#ff5a66]">②</span>
        วันและเวลาที่พบปัญหา
      </span>
      <span class="flex items-start gap-2.5 text-sm text-[#f6e4e4]">
        <span aria-hidden="true" class="mt-0.5 shrink-0 text-[#ff5a66]">③</span>
        รายละเอียดปัญหาของบัญชี โปรโมชั่น ทางเข้า หรือสถานะรายการ
      </span>
      <span class="mt-1 rounded-xl border border-[#f5c451]/35 bg-[#2a070d]/70 px-4 py-2.5 text-xs leading-relaxed text-[#f6e4e4]/80">
        ไม่ต้องแจ้งรหัสผ่านหรือรหัสยืนยันให้ผู้ใด แม้จะเป็นการติดต่อกับทีมงานก็ตาม
      </span>
      <a
        href="/line"
        class="mt-1 flex w-full items-center justify-center gap-2 rounded-xl bg-gradient-to-r from-[#00B900] to-[#009900] p-3 text-sm font-bold text-white shadow-md transition-transform hover:scale-[1.02]">
        <span aria-hidden="true">💬</span> ติดต่อทีมงานผ่าน LINE
      </a>
    </div>
  </ContentBoxTwoFloatingBadge>

  <Faq title="คำถามที่พบบ่อยเกี่ยวกับ MAX56" faqs={faqs} />

  <LoginRtpSection />

  <LatestWinners />

  <div class="relative z-10 mx-auto mb-10 flex flex-nowrap justify-center gap-3 px-4 sm:gap-6">
    <a
      href="/login"
      class="group relative flex flex-1 items-center justify-center rounded-full border-2 border-[#e8202f]/60 bg-gradient-to-r from-[#c10d1e] via-[#8c0512] to-[#5a0209] px-4 py-3 text-sm font-black whitespace-nowrap text-[#fff5f5] shadow-[0_10px_30px_rgba(193,13,30,0.35)] transition-all duration-300 hover:-translate-y-1 hover:scale-105 hover:border-[#ff5a66] hover:shadow-[0_15px_40px_rgba(232,32,47,0.45)] sm:flex-none sm:px-10 sm:py-3.5 sm:text-base">
      เข้าสู่ระบบ
    </a>

    <a
      href="/register"
      class="group relative flex flex-1 items-center justify-center rounded-full border-2 border-[#ffe9a8]/70 bg-gradient-to-r from-[#ffe9a8] to-[#f5c451] px-4 py-3 text-sm font-black whitespace-nowrap text-[#1a0508] shadow-[0_10px_30px_rgba(245,196,81,0.35)] transition-all duration-300 hover:-translate-y-1 hover:scale-105 hover:border-[#ffe9a8] hover:shadow-[0_15px_40px_rgba(245,196,81,0.5)] sm:flex-none sm:px-10 sm:py-3.5 sm:text-base">
      สมัครสมาชิก
    </a>
  </div>

  <SmoothCarousel />

  <ReviewCardSumo2 />

  <Navfoot />
</MainLayout>
