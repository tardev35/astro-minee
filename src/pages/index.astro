---
import MainLayout from "../layouts/MainLayout.astro";
import Announcement from "../components/Announcement3.astro";
import ContentBox from "../components/ContentBox.astro";
import ContentBoxCyberCut from "../components/ContentBoxCyberCut.astro";
import ContentBoxFloatingBadge from "../components/ContentBoxFloatingBadge.astro";
import ContentBoxSevenThreeCyberCut from "../components/ContentBoxSevenThreeCyberCut.astro";
import ContentBoxSevenThreeFloatingBadge from "../components/ContentBoxSevenThreeFloatingBadge.astro";
import LoginRtpSection from "../components/LoginRtpSection.astro";
import ProviderGrid from "../components/ProviderGrid.astro";
import GameRankingBoard from "../components/GameRankingBoard.astro";
import ReviewCardSumo2 from "../components/ReviewCardSumo2.astro";
import LatestWinners from "../components/LatestWinnersPremium.astro";
import SmoothCarousel from "../components/SmoothCarousel.astro";
import Faq from "../components/Faq2.astro";
import Navfoot from "../components/Navfoot.astro";

import { Picture } from "astro:assets";
import { pageGraph } from "../lib/schema";
// slide4 illustrates the ระบบออโต้ section (its own bottom strip reads
// ฝากถอนออโต้ / บริการตลอด 24 ชม.), slide2 the โอนไว/ตรวจสอบสถานะ section.
// Slides may only live inside a ContentBoxSevenThree* block, max two per
// rebrand; SmoothCarousel keeps rendering all four as the promotion carousel.
import imgAutoSystem from "../assets/slide4.png";
import imgFastTransfer from "../assets/slide2.png";

const pageTitle = "LCX88 | คาสิโนออนไลน์ระบบออโต้ ฝากถอนไม่มีขั้นต่ำ ปลอดภัยโอนไว";

// 155 characters. verify-build.mjs errors outside 150–160 CHARACTERS, and the
// docx-supplied description is 127 — the trailing clause closes that gap
// without changing what the brief says.
const pageDescription = "LCX88 คาสิโนออนไลน์ระบบออโต้ ฝากถอนไม่มีขั้นต่ำ รองรับมือถือ ใช้งานปลอดภัย โอนไว พร้อมเกมหลากหลายและบริการสมาชิกตลอด 24 ชั่วโมง ควรอ่านกติกาก่อนเริ่มใช้งาน";

const faqs = [
  {
    q: "LCX88 มีเกมคาสิโนประเภทใดบ้าง?",
    a: "ภายในระบบมีทั้งเกมสล็อต บาคาร่า รูเล็ต เกมไพ่ และคาสิโนสดจากหลายค่าย สมาชิกสามารถเลือกเกมตามประเภทและรูปแบบที่ตนเองสนใจได้",
  },
  {
    q: "LCX88 ฝากถอนไม่มีขั้นต่ำจริงหรือไม่?",
    a: "ระบบรองรับเงื่อนไขไม่มีขั้นต่ำในช่องทางที่เว็บไซต์กำหนด แต่ควรตรวจสอบรายละเอียดล่าสุด เพราะข้อกำหนดอาจแตกต่างตามช่องทางและโปรโมชั่น",
  },
  {
    q: "ระบบโอนไวของ LCX88 ใช้เวลานานหรือไม่?",
    a: "ระบบออโต้ช่วยลดขั้นตอนการทำรายการ แต่ระยะเวลาอาจแตกต่างตามธนาคาร ช่องทางชำระเงิน และสถานะการตรวจสอบข้อมูลของบัญชี",
  },
];

const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  faqs,
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement
    message="LCX88 คาสิโนออนไลน์ระบบออโต้ รวมเกมสล็อต บาคาร่า รูเล็ต เกมไพ่ และคาสิโนสดจากหลายค่ายไว้ในระบบเดียว • ฝากถอนไม่มีขั้นต่ำตามช่องทางที่เว็บไซต์กำหนด • ระบบโอนไวควรตรวจสอบสถานะรายการทุกครั้งก่อนออกจากหน้าเว็บไซต์ • ทีมงานดูแลสมาชิกตลอด 24 ชั่วโมง ควรอ่านกติกาและเงื่อนไขก่อนเริ่มใช้งานทุกครั้ง"
  />

  <ContentBoxCyberCut as="h1" title="LCX88 | คาสิโนออนไลน์ระบบออโต้ ฝากถอนไม่มีขั้นต่ำ ปลอดภัยโอนไว">
    <p class="text-left text-base leading-relaxed text-[#d7e3ff]">
      <strong class="text-[#f5c542]">LCX88</strong> เป็นแพลตฟอร์มคาสิโนออนไลน์ที่รวมเกมหลายรูปแบบไว้ในระบบเดียว รองรับการฝากถอนออโต้และเงื่อนไขไม่มีขั้นต่ำตามช่องทางที่กำหนด สมาชิกสามารถเลือกเกม ตรวจสอบโปรโมชั่น
      และจัดการบัญชีผ่านมือถือได้สะดวก ควรอ่านกติกา เงื่อนไขโบนัส และรายละเอียดธุรกรรมก่อนเริ่มใช้งานทุกครั้ง
    </p>
  </ContentBoxCyberCut>

  <ContentBox as="h2" title="รวมเกมคาสิโนออนไลน์หลายรูปแบบไว้บน LCX88">
    <p class="text-left text-base leading-relaxed text-[#d7e3ff]">
      ภายใน LCX88 มีทั้งเกมสล็อต เกมไพ่ บาคาร่า รูเล็ต และเกมคาสิโนสดจากหลายค่าย ผู้เล่นสามารถเลือกเกมตามประเภท รูปแบบ หรือความถนัดของตนเองได้ง่าย ควรศึกษากติกา อัตราการจ่าย
      และเงื่อนไขของแต่ละเกมก่อนเริ่ม เพื่อวางงบประมาณได้อย่างเหมาะสม
    </p>
  </ContentBox>

  <ProviderGrid />

  <GameRankingBoard />

  <ContentBoxSevenThreeCyberCut titleright="ระบบออโต้ช่วยลดขั้นตอนการฝากและถอน">
    <Picture
      slot="left"
      src={imgAutoSystem}
      loading="lazy"
      fetchpriority="low"
      widths={[300, 450, 600]}
      sizes="(max-width: 768px) calc(100vw - 4rem), 355px"
      decoding="async"
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      quality={80}
      alt="แบนเนอร์โปรโมชั่น LCX88 ข้อความ ชวนเพื่อน รับเครดิตฟรี 300 บาท ชวนมาก ได้มาก พร้อมแถบด้านล่าง มั่นคง ปลอดภัย ระบบมาตรฐานสากล ฝากถอนออโต้ รวดเร็ว ทันใจ รองรับมือถือ แอปใช้งานง่าย และ บริการตลอด 24 ชม. ดูแลทุกการใช้งาน"
      class="mx-auto h-auto w-full rounded-2xl border border-[#2f6bff]/35 shadow-[0_10px_30px_rgba(47,107,255,0.22)]"
    />
    <p slot="right" class="text-left text-base leading-relaxed text-[#d7e3ff]">
      ระบบฝากถอนออโต้ช่วยให้สมาชิกทำรายการผ่านหน้าบัญชีได้ด้วยตนเอง โดยควรใช้ข้อมูลที่ตรงกับบัญชีสมัคร ตรวจสอบยอดก่อนยืนยัน และเก็บหลักฐานรายการไว้จนกว่าระบบจะแสดงสถานะสำเร็จ
      หากพบความล่าช้าควรติดต่อทีมงานผ่านช่องทางหลัก
    </p>
  </ContentBoxSevenThreeCyberCut>

  <ContentBoxFloatingBadge as="h2" title="ฝากถอนไม่มีขั้นต่ำผ่านระบบของ LCX88">
    <p class="text-left text-base leading-relaxed text-[#d7e3ff]">
      เงื่อนไขไม่มีขั้นต่ำของ LCX88 ช่วยให้สมาชิกกำหนดยอดทำรายการได้ยืดหยุ่นมากขึ้น แต่ควรตรวจสอบช่องทางที่รองรับ สถานะบัญชี และข้อกำหนดของโปรโมชั่นก่อนยืนยันทุกครั้ง
      เพื่อช่วยลดปัญหาจากข้อมูลไม่ตรงกันหรือรายการที่ต้องตรวจสอบเพิ่มเติม
    </p>
  </ContentBoxFloatingBadge>

  <ContentBox as="h2" title="LCX88 ให้ความสำคัญกับความปลอดภัยของบัญชี">
    <p class="text-left text-base leading-relaxed text-[#d7e3ff]">
      การใช้งาน LCX88 อย่างปลอดภัยควรเริ่มจากการเข้าสู่ระบบผ่านช่องทางหลัก ตั้งรหัสผ่านที่คาดเดายาก และไม่เปิดเผยรหัสยืนยันแก่บุคคลอื่น สมาชิกควรหลีกเลี่ยงเครือข่ายสาธารณะเมื่อต้องทำธุรกรรม
      และออกจากระบบทุกครั้งเมื่อใช้อุปกรณ์ร่วมกับผู้อื่น
    </p>
  </ContentBox>

  <LoginRtpSection />

  <ContentBoxSevenThreeFloatingBadge title="ระบบโอนไวควรตรวจสอบสถานะรายการทุกครั้ง">
    <Picture
      slot="left"
      src={imgFastTransfer}
      loading="lazy"
      fetchpriority="low"
      widths={[300, 450, 600]}
      sizes="(max-width: 768px) calc(100vw - 4rem), 350px"
      decoding="async"
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      quality={80}
      alt="แบนเนอร์โปรโมชั่น LCX88 ข้อความ ฝากครั้งแรก รับเพิ่ม 50% โบนัสต้อนรับสุดคุ้ม"
      class="mx-auto h-auto w-full rounded-2xl border border-[#f5c542]/35 shadow-[0_10px_30px_rgba(245,197,66,0.22)]"
    />
    <p slot="right" class="text-left text-base leading-relaxed text-[#d7e3ff]">
      ความเร็วของรายการอาจขึ้นอยู่กับธนาคาร ช่องทางชำระเงิน และสถานะบัญชี สมาชิกควรตรวจสอบชื่อบัญชี จำนวนเงิน และผลการทำรายการก่อนออกจากหน้าเว็บไซต์ หากรายการยังไม่สำเร็จ ไม่ควรทำซ้ำทันที
      แต่ควรเก็บข้อมูลไว้และติดต่อทีมงานเพื่อตรวจสอบ
    </p>
  </ContentBoxSevenThreeFloatingBadge>

  <LatestWinners />

  <ContentBoxCyberCut as="h2" title="ช่องทางดูแลสมาชิกจากทีมงาน LCX88">
    <p class="text-left text-base leading-relaxed text-[#d7e3ff]">
      เมื่อพบปัญหาเกี่ยวกับบัญชี ทางเข้าเล่น โปรโมชั่น หรือสถานะฝากถอน สมาชิกสามารถติดต่อทีมงาน <strong class="text-[#f5c542]">LCX88</strong> ผ่านช่องทางที่เว็บไซต์ระบุ ควรเตรียมชื่อผู้ใช้ เวลา และรายละเอียดรายการให้ครบถ้วน
      โดยไม่ส่งรหัสผ่านหรือรหัสยืนยันแก่บุคคลอื่น
    </p>
  </ContentBoxCyberCut>

  <Faq title="คำถามที่พบบ่อยเกี่ยวกับ LCX88" faqs={faqs} />

  <div class="relative z-10 mx-auto mb-10 flex flex-nowrap justify-center gap-3 px-4 sm:gap-6">
    <a
      href="/login"
      class="group relative flex flex-1 items-center justify-center rounded-full bg-gradient-to-r from-[#ffe08a] via-[#f5c542] to-[#c08b1f] px-4 py-3 text-sm font-black whitespace-nowrap text-[#04102e] shadow-[0_10px_30px_rgba(245,197,66,0.3)] transition-all duration-300 hover:-translate-y-1 hover:scale-105 hover:shadow-[0_15px_40px_rgba(245,197,66,0.45)] sm:flex-none sm:px-10 sm:py-3.5 sm:text-base">
      เข้าสู่ระบบ
    </a>

    <a
      href="/register"
      class="group relative flex flex-1 items-center justify-center rounded-full border border-[#2f6bff]/70 bg-[#0a1547]/85 px-4 py-3 text-sm font-black whitespace-nowrap text-[#ffe08a] backdrop-blur-sm transition-all duration-300 hover:scale-105 hover:border-[#f5c542] hover:bg-[#122264]/85 hover:shadow-[0_15px_40px_rgba(47,107,255,0.4)] sm:flex-none sm:px-10 sm:py-3.5 sm:text-base">
      สมัครสมาชิก
    </a>
  </div>

  <SmoothCarousel />

  <ReviewCardSumo2 />

  <Navfoot />
</MainLayout>
