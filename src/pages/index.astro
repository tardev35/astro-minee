---
import MainLayout from "../layouts/MainLayout.astro";
import Announcement from "../components/Announcement3.astro";
import ContentBoxNeumorphism from "../components/ContentBoxNeumorphism.astro";
import ContentBoxFloatingBadge from "../components/ContentBoxFloatingBadge.astro";
import ContentBox from "../components/ContentBox.astro";
import ContentBoxSevenThree from "../components/ContentBoxSevenThree.astro";
import ContentBoxSevenThreeFloatingBadge from "../components/ContentBoxSevenThreeFloatingBadge.astro";
import ProviderGrid from "../components/ProviderGrid.astro";
import GameRankingBoard from "../components/GameRankingBoard.astro";
import LoginRtpSection from "../components/LoginRtpSection.astro";
import ReviewCardSumo2 from "../components/ReviewCardSumo2.astro";
import LatestWinners from "../components/LatestWinners4.astro";
import SmoothCarousel from "../components/SmoothCarousel.astro";
import Faq from "../components/Faq3.astro";
import Navfoot from "../components/Navfoot.astro";

import { Picture } from "astro:assets";
import { pageGraph } from "../lib/schema";

// Slides live only inside a ContentBoxSevenThree* block and there are at most
// two of those per rebrand — both are spent here. slide1 is the general brand
// board ("เว็บสล็อตสายหวาน โบนัสทุกวัน") and sits with the "สำรวจเกมยอดนิยม"
// section; slide2 reads "ฝากครั้งแรก รับเพิ่ม 20%" and sits with the ฝากง่าย
// section. slide3 and slide4 stay unused here and keep rendering in
// SmoothCarousel and on /promotion.
import imgGameStyles from "../assets/slide1.png";
import imgCashier from "../assets/slide2.png";

const pageTitle = "HONEY289 | วันเดิมพันอัตราจ่ายสูง ยอดนิยมอันดับ 1 ฝากง่าย ถอนออโต้";
const pageHeading = "HONEY289 วันเดิมพันอัตราจ่ายสูง ยอดนิยมอันดับ 1 ฝากง่าย ถอนออโต้";

// The docx Meta Description, verbatim at the length it was written (~130
// characters). DESC_MIN does not apply to the home page — verify-build.mjs
// exempts it precisely so the brand's own copy ships unpadded. Do not top it
// up to 150.
const pageDescription = "HONEY289 เกมเดิมพันอัตราจ่ายสูง รวมเกมยอดนิยม ฝากง่าย ถอนออโต้ รองรับมือถือ พร้อมระบบใช้งานสะดวกและบริการสมาชิกตลอด 24 ชั่วโมง";

// The docx Q&A block, verbatim. Passed as an explicit prop rather than left to
// Faq3's own default, which is always the previous brand's FAQ.
const faqs = [
  {
    q: "HONEY289 มีเกมอัตราจ่ายสูงหลายประเภทหรือไม่?",
    a: "เกมแต่ละประเภทมีอัตราจ่ายและเงื่อนไขแตกต่างกัน สมาชิกควรตรวจสอบข้อมูลของเกมที่สนใจ รวมถึงทำความเข้าใจกติกาก่อนเริ่มเดิมพันทุกครั้ง",
  },
  {
    q: "ระบบถอนออโต้ของ HONEY289 ใช้งานอย่างไร?",
    a: "สมาชิกสามารถส่งคำขอถอนผ่านหน้าบัญชีและติดตามสถานะได้โดยตรง โดยควรตรวจสอบยอดคงเหลือ ข้อมูลบัญชี และเงื่อนไขที่เกี่ยวข้องก่อนยืนยัน",
  },
  {
    q: "เกมยอดนิยมอันดับ 1 รับประกันผลตอบแทนได้หรือไม่?",
    a: "ความนิยมหรืออัตราจ่ายไม่สามารถรับประกันผลลัพธ์ได้ ผู้เล่นควรพิจารณากติกา ความเสี่ยง และกำหนดงบประมาณที่เหมาะสมก่อนเริ่มเล่น",
  },
];

// Homepage: no breadcrumb — there is no trail above the root.
const graph = pageGraph(Astro, {
  name: pageHeading,
  description: pageDescription,
  faqs,
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement
    message="HONEY289 รวบรวมเกมเดิมพันหลายรูปแบบไว้ในแพลตฟอร์มเดียว เน้นการเข้าถึงเกมง่าย ระบบฝากสะดวก และการถอนผ่านระบบออโต้ • ควรตรวจสอบกติกา วิธีคิดผล และอัตราจ่ายของแต่ละเกมก่อนเริ่ม เพื่อช่วยให้ตัดสินใจได้จากข้อมูลมากกว่าความนิยมเพียงอย่างเดียว • ก่อนยืนยันรายการฝากควรตรวจสอบชื่อบัญชี จำนวนเงิน และช่องทางที่เลือกให้ถูกต้อง • หากรายการถอนอยู่ระหว่างดำเนินการควรรอผลจากระบบ ไม่ควรส่งรายการซ้ำ • รองรับมือถือ แท็บเล็ต และคอมพิวเตอร์ พร้อมทีมงานดูแลสมาชิกตลอด 24 ชั่วโมง"
  />

  <ContentBoxNeumorphism as="h1" title={pageHeading}>
    <p class="text-left text-base leading-relaxed text-[#fdf0d8]">
      <strong class="text-[#fdbb24]">HONEY289</strong> รวบรวมเกมเดิมพันหลายรูปแบบไว้ในแพลตฟอร์มเดียว เน้นการเข้าถึงเกมง่าย ระบบฝากสะดวก และการถอนผ่านระบบออโต้ รองรับการใช้งานบนมือถือและคอมพิวเตอร์ สมาชิกสามารถตรวจสอบข้อมูลเกม
      โปรโมชั่น และบัญชีได้จากระบบเดียว โดยควรศึกษากติกา อัตราจ่าย และเงื่อนไขต่าง ๆ ก่อนเริ่มใช้งาน
    </p>
  </ContentBoxNeumorphism>

  <ContentBoxSevenThreeFloatingBadge title="สำรวจเกมยอดนิยมและรูปแบบการจ่ายบน HONEY289">
    <Picture
      slot="left"
      src={imgGameStyles}
      loading="lazy"
      fetchpriority="low"
      widths={[300, 450, 600]}
      sizes="(max-width: 768px) calc(100vw - 6rem), 350px"
      decoding="async"
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      quality={80}
      alt="แบนเนอร์ HONEY289 ข้อความ เว็บสล็อตสายหวาน โบนัสทุกวัน เล่นง่าย ฝาก-ถอนออโต้ จ่ายจริง แตกง่ายจ่ายจริง และปุ่ม สมัครเลย พร้อมผึ้งการ์ตูนขยิบตาถือไม้จุ่มน้ำผึ้ง รังผึ้งหกเหลี่ยม โหลน้ำผึ้ง วงล้อสล็อต 777 เหรียญทองและดอกไม้สีชมพู"
      class="mx-auto h-auto w-full rounded-2xl border border-[#fdbb24]/35 shadow-[0_10px_30px_rgba(253,187,36,0.22)]"
    />
    <p slot="right" class="text-left text-base leading-relaxed text-[#fdf0d8]">
      ภายใน HONEY289 มีเกมหลายประเภทที่มีรูปแบบการเดิมพันและอัตราจ่ายแตกต่างกัน ผู้เล่นสามารถเลือกตามความสนใจและระดับความเสี่ยงที่ยอมรับได้ ควรตรวจสอบกติกา วิธีคิดผล และอัตราจ่ายของแต่ละเกมก่อนเริ่ม
      เพื่อช่วยให้ตัดสินใจได้จากข้อมูลมากกว่าความนิยมเพียงอย่างเดียว
    </p>
  </ContentBoxSevenThreeFloatingBadge>

  <ProviderGrid />

  <ContentBox as="h2" title="อัตราจ่ายสูงควรดูควบคู่กับกติกาของแต่ละเกม">
    <p class="text-left text-base leading-relaxed text-[#fdf0d8]">
      ตัวเลขอัตราจ่ายช่วยให้ผู้เล่นเข้าใจผลตอบแทนตามเงื่อนไขของการเดิมพันแต่ละประเภท แต่ไม่ได้หมายความว่าจะได้รับผลตอบแทนทุกครั้ง ควรเปรียบเทียบรูปแบบเกม ความเสี่ยง และจำนวนเงินที่ต้องใช้
      พร้อมกำหนดงบประมาณล่วงหน้าเพื่อควบคุมการเล่นให้อยู่ในขอบเขต
    </p>
  </ContentBox>

  <GameRankingBoard />

  <ContentBoxSevenThree titleright="ฝากง่ายและจัดการบัญชีได้สะดวกกับ HONEY289">
    <Picture
      slot="left"
      src={imgCashier}
      loading="lazy"
      fetchpriority="low"
      widths={[300, 450, 600]}
      sizes="(max-width: 768px) calc(100vw - 6rem), 380px"
      decoding="async"
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      quality={80}
      alt="แบนเนอร์โปรโมชั่น HONEY289 ข้อความ ฝากครั้งแรก รับเพิ่ม 20% คุ้มตั้งแต่ฝากแรก และปุ่ม ฝากเลย พร้อมผึ้งการ์ตูนยกนิ้วโป้งถือไม้จุ่มน้ำผึ้ง ตู้สล็อต 777 กล่องของขวัญสีชมพู โหลน้ำผึ้ง เหรียญทองและดอกไม้"
      class="mx-auto h-auto w-full rounded-2xl border border-[#fdbb24]/35 shadow-[0_10px_30px_rgba(253,187,36,0.22)]"
    />
    <p slot="right" class="text-left text-base leading-relaxed text-[#fdf0d8]">
      ขั้นตอนฝากเงินของ HONEY289 ถูกจัดให้สมาชิกสามารถดำเนินการผ่านหน้าบัญชีได้สะดวก ก่อนยืนยันควรตรวจสอบชื่อบัญชี จำนวนเงิน และช่องทางที่เลือกให้ถูกต้อง
      รวมถึงเก็บรายละเอียดรายการจนกว่าระบบจะแสดงผลสำเร็จ เพื่อลดปัญหาเมื่อต้องตรวจสอบย้อนหลัง
    </p>
  </ContentBoxSevenThree>

  <ContentBoxFloatingBadge as="h2" title="เลือกเกมจากความเข้าใจแทนการยึดอันดับเพียงอย่างเดียว">
    <p class="text-left text-base leading-relaxed text-[#fdf0d8]">
      เกมที่ได้รับความนิยมอาจเหมาะกับผู้เล่นแต่ละคนไม่เหมือนกัน ก่อนเลือกจึงควรพิจารณากติกา ความเร็วของเกม รูปแบบการเดิมพัน และระดับความเสี่ยงร่วมกัน
      การทดลองทำความเข้าใจเกมก่อนช่วยให้ตัดสินใจได้เหมาะกับงบประมาณและรูปแบบที่ตนเองชอบมากกว่า
    </p>
  </ContentBoxFloatingBadge>

  <ContentBoxNeumorphism as="h2" title="ระบบถอนออโต้บน HONEY289 ช่วยลดขั้นตอนการทำรายการ">
    <p class="text-left text-base leading-relaxed text-[#fdf0d8]">
      สมาชิก HONEY289 สามารถส่งคำขอถอนและติดตามสถานะผ่านระบบออโต้ได้โดยตรง ควรตรวจสอบยอดคงเหลือ ข้อมูลบัญชี และเงื่อนไขโปรโมชั่นก่อนยืนยัน หากรายการอยู่ระหว่างดำเนินการควรรอผลจากระบบ
      ไม่ควรส่งรายการซ้ำเพื่อลดความคลาดเคลื่อน
    </p>
  </ContentBoxNeumorphism>

  <LatestWinners />

  <ContentBox as="h2" title="ดูแลบัญชีและติดตามรายการได้กับทีม HONEY289">
    <p class="text-left text-base leading-relaxed text-[#fdf0d8]">
      เมื่อมีข้อสงสัยเกี่ยวกับบัญชี ทางเข้า โปรโมชั่น หรือสถานะธุรกรรม สามารถติดต่อทีมงาน HONEY289 ผ่านช่องทางที่เว็บไซต์กำหนด ควรเตรียมชื่อผู้ใช้ เวลา และรายละเอียดรายการให้ครบถ้วน
      โดยไม่เปิดเผยรหัสผ่านหรือรหัสยืนยัน เพื่อช่วยให้ตรวจสอบได้ตรงประเด็น
    </p>
  </ContentBox>

  <Faq title="คำถามที่พบบ่อยเกี่ยวกับ HONEY289" faqs={faqs} />

  <LoginRtpSection />

  <div class="relative z-10 mx-auto mb-10 flex flex-nowrap justify-center gap-3 px-4 sm:gap-6">
    <a
      href="/login"
      class="group relative flex flex-1 items-center justify-center rounded-full bg-gradient-to-r from-[#ffe3a3] via-[#fdbb24] to-[#b35303] px-4 py-3 text-sm font-black whitespace-nowrap text-[#3d1304] shadow-[0_10px_30px_rgba(253,187,36,0.3)] transition-all duration-300 hover:-translate-y-1 hover:scale-105 hover:shadow-[0_15px_40px_rgba(253,187,36,0.45)] sm:flex-none sm:px-10 sm:py-3.5 sm:text-base">
      เข้าสู่ระบบ
    </a>

    <a
      href="/register"
      class="group relative flex flex-1 items-center justify-center rounded-full border-2 border-[#ffe3a3]/70 bg-[#f2559a] px-4 py-3 text-sm font-black whitespace-nowrap text-[#3d1304] shadow-[0_10px_30px_rgba(242,85,154,0.35)] transition-all duration-300 hover:-translate-y-1 hover:scale-105 hover:border-[#ffe3a3] hover:shadow-[0_15px_40px_rgba(242,85,154,0.5)] sm:flex-none sm:px-10 sm:py-3.5 sm:text-base">
      สมัครสมาชิก
    </a>
  </div>

  <SmoothCarousel />

  <ReviewCardSumo2 />

  <Navfoot />
</MainLayout>
