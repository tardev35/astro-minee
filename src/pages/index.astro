---
import MainLayout from "../layouts/MainLayout.astro";
import Announcement from "../components/Announcement4.astro";
import ContentBoxNeumorphism from "../components/ContentBoxNeumorphism.astro";
import ContentBoxFloatingBadge from "../components/ContentBoxFloatingBadge.astro";
import ContentBoxTwoNeumorphism from "../components/ContentBoxTwoNeumorphism.astro";
import ContentBoxSevenThree from "../components/ContentBoxSevenThree.astro";
import ContentBox from "../components/ContentBox.astro";
import ContentBoxSevenThreeFloatingBadge from "../components/ContentBoxSevenThreeFloatingBadge.astro";
import ContentBoxTwoCyberCut from "../components/ContentBoxTwoCyberCut.astro";
import ProviderGridPremium from "../components/ProviderGridPremium.astro";
import LoginRtpSection from "../components/LoginRtpSection.astro";
import LatestWinners3 from "../components/LatestWinners3.astro";
import Faq4 from "../components/Faq4.astro";
import SmoothCarousel from "../components/SmoothCarousel.astro";
import ReviewCardSumo2 from "../components/ReviewCardSumo2.astro";
import Navfoot from "../components/Navfoot.astro";

import { Picture } from "astro:assets";
import { pageGraph } from "../lib/schema";

// Slides live only inside a ContentBoxSevenThree* block and there are at most
// two of those per rebrand — both are spent here.
//
// slide4 prints "วงล้อโชคดี / ฝากครบ 300 หมุนฟรี 1 ครั้ง" on a prize wheel whose
// segments read 69 / 169 / 269 เครดิต beside ของรางวัล: one promotion carrying
// several printed values and a printed condition, which is docx H2-3's point
// that สมัครฟรี still leaves deposit, promotion and withdrawal conditions to
// check separately, in picture form.
// slide1 prints "ภารกิจรายวัน / ทำครบ 3 ภารกิจ รับสุ่ม" over a four-step row
// (ล็อกอิน → ฝากเงิน → หมุนเกม → รับรางวัล), each step numbered on its own — the
// same shape as docx H2-5's point that account, promotion and transaction
// history all run through one system, checked step by step.
// slide2 and slide3 stay unused on this page and keep rendering in
// SmoothCarousel and on /promotion.
//
// banner2.png is NOT imported anywhere: it predates this asset drop.
// banner1/banner1-mobile/og.png are the hero and the share card and belong to
// MainLayout alone.
import imgLuckyWheel from "../assets/slide4.png";
import imgDailyMission from "../assets/slide1.png";

// The docx "Main SEO" Title and H1, verbatim. They are the brand's own copy,
// not a draft to tidy.
const pageTitle = "JERRY69 | สล็อตรวมเกมค่ายดัง แตกง่าย รวยไว สมัครฟรีรับโปรทุนน้อย";
const pageHeading = "JERRY69 สล็อตรวมเกมค่ายดัง แตกง่าย รวยไว สมัครฟรีรับโปรทุนน้อย";

// The docx Main SEO Meta Description, verbatim at the length it was written.
// DESC_MIN does not apply to the home page — verify-build.mjs exempts it
// precisely so the brand's own copy ships unpadded. Do not top it up to 150.
const pageDescription = "JERRY69 รวมเกมสล็อตค่ายดัง สมัครฟรี โปรทุนน้อยตามเงื่อนไข พร้อมเกมหลายแนว ระบบสมาชิกใช้งานง่าย และข้อมูลรายการตรวจสอบได้สะดวก";

// Byte-identical to Announcement4's own default, which is what every sub-page
// calling <Announcement /> bare lands on. Passing it explicitly here keeps the
// home page and the rest of the site from drifting apart silently. No leading
// emoji — the marquee renders the string twice.
const announcement =
  "JERRY69 รวมเกมสล็อตจากหลายค่ายไว้ในระบบเดียว เลือกได้จากธีม ฟีเจอร์โบนัส ความเร็วของเกม และระดับเดิมพัน แทนการดูจากชื่อค่ายอย่างเดียว • สมัครฟรีหมายถึงไม่มีค่าธรรมเนียมเปิดบัญชี แต่ยังควรตรวจเงื่อนไขการฝาก โปรโมชั่น และการถอนแยกกันให้ชัด • โปรทุนน้อยควรดูยอดเริ่มต้น โบนัส เกมที่ร่วมรายการ และเงื่อนไขการถอนร่วมกัน โปรที่ให้โบนัสสูงสุดไม่จำเป็นต้องเหมาะกับงบที่สุด • คำว่าแตกง่ายและรวยไวเป็นข้อความทางการตลาด ไม่ใช่การรับประกันผล ควรดู RTP ความผันผวน และตารางจ่ายประกอบเสมอ • ก่อนทำธุรกรรมควรตรวจชื่อบัญชีและจำนวนเงินให้ครบ หากรายการเดิมยังดำเนินการอยู่ควรรอระบบอัปเดตก่อนส่งคำขอใหม่";

// Each alt is the text printed on that slide plus the scene around it, read off
// the artwork itself.
const altLuckyWheel =
  "แบนเนอร์โปรโมชั่น JERRY69 ด้านบนเป็นโลโก้ตัวอักษรสีขาวขอบดำเขียนว่า JERRY ต่อด้วยเลข 69 สีส้มไล่เฉดทอง ถัดลงมาเป็นหัวข้อตัวหนาสีส้มเขียนว่า วงล้อโชคดี ด้านขวาเป็นวงล้อเสี่ยงโชคขนาดใหญ่สีส้มสลับดำ มีหลอดไฟสีส้มเรียงรอบขอบและหัวลูกศรสีส้มชี้ลงอยู่ด้านบน ช่องบนวงล้อเขียนว่า 69 เครดิต 169 เครดิต และ 269 เครดิต สลับกับช่องที่มีไอคอนกล่องของขวัญเขียนว่า ของรางวัล ด้านซ้ายเป็นข้อความเขียนว่า ฝากครบ แล้วเป็นตัวเลข 300 ขนาดใหญ่ ใต้ลงมาเขียนว่า หมุนฟรี 1 ครั้ง ด้านล่างเป็นปุ่มวงรีสีส้มขอบทองเขียนว่า หมุนเลย ด้านซ้ายของภาพเป็นผู้หญิงในชุดสีดำสลับส้มติดโลโก้ JERRY69 ชี้นิ้วไปที่วงล้อ รอบด้านเป็นเหรียญทองสลักคำว่า JERRY69 กล่องของขวัญ และเพชรบนพื้นหลังสีดำ";

const altDailyMission =
  "แบนเนอร์โปรโมชั่น JERRY69 ด้านบนเป็นโลโก้ตัวอักษรสีขาวขอบดำเขียนว่า JERRY ต่อด้วยเลข 69 สีส้มไล่เฉดทอง ถัดลงมาเป็นหัวข้อตัวหนาสีส้มเขียนว่า ภารกิจรายวัน และบรรทัดถัดมาเขียนว่า ทำครบ 3 ภารกิจ รับสุ่ม ใต้ลงมาเป็นตัวเลขสีทองขนาดใหญ่ 29 / 69 / 169 เหนือคำว่า เครดิต ถัดลงมาเป็นแถวสี่ขั้นตอนที่มีหมายเลขกำกับและลูกศรชี้ต่อกัน หมายเลข 1 ล็อกอิน พร้อมไอคอนคนติดเครื่องหมายถูก หมายเลข 2 ฝากเงิน พร้อมไอคอนกระเป๋าเงินและเหรียญ หมายเลข 3 หมุนเกม พร้อมไอคอนตู้สล็อตเลข 777 และหมายเลข 4 รับรางวัล พร้อมไอคอนกล่องของขวัญ ด้านล่างเป็นปุ่มวงรีสีส้มขอบทองเขียนว่า รับภารกิจ ด้านซ้ายของภาพเป็นผู้หญิงในชุดสีดำสลับส้มติดโลโก้ JERRY69 ชูสามนิ้ว รอบด้านเป็นเหรียญทองสลักคำว่า JERRY69 กล่องของขวัญ และประกายไฟบนพื้นหลังสีดำ";

// The docx Q&A block, verbatim. Passed as an explicit prop rather than left to
// Faq4's own default, so the rendered markup and the FAQ JSON-LD below come out
// of the same array.
const faqs = [
  {
    q: "JERRY69 สมัครสมาชิกฟรีหรือไม่?",
    a: "การสมัครอาจไม่มีค่าธรรมเนียมตามเงื่อนไขที่เว็บไซต์กำหนด แต่ควรตรวจรายละเอียดเกี่ยวกับการฝาก โปรโมชั่น และการถอนเพิ่มเติมก่อนใช้งานจริง",
  },
  {
    q: "JERRY69 มีเกมสล็อตจากหลายค่ายหรือไม่?",
    a: "ระบบอาจรวมเกมจากหลายผู้ให้บริการ ผู้เล่นควรตรวจรายชื่อค่าย ฟีเจอร์เกม RTP และกติกาก่อนเลือกเล่น เพื่อให้เหมาะกับสไตล์และงบของตนเอง",
  },
  {
    q: "โปรทุนน้อยและคำว่ารวยไวของ JERRY69 รับประกันกำไรไหม?",
    a: "ไม่สามารถรับประกันกำไรจากเกมสล็อตหรือโปรโมชั่นได้ ผู้เล่นควรดูเงื่อนไขโปร ความเสี่ยงของเกม และกำหนดงบประมาณก่อนเริ่มทุกครั้ง",
  },
];

// Homepage: no breadcrumb — there is no trail above the root.
const graph = pageGraph(Astro, {
  name: pageHeading,
  description: pageDescription,
  faqs,
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement message={announcement} />

  <ContentBoxNeumorphism as="h1" title={pageHeading}>
    <p class="text-left text-base leading-relaxed text-[#f3e3d0]">
      <strong class="text-[#ffc94a]">JERRY69</strong> เป็นแพลตฟอร์มสล็อตออนไลน์ที่รวบรวมเกมจากหลายค่ายไว้ในระบบเดียว พร้อมขั้นตอนสมัครสมาชิกและโปรโมชั่นสำหรับผู้ที่ต้องการเริ่มต้นด้วยงบไม่สูง สมาชิกสามารถค้นหาเกม
      ดูสิทธิพิเศษ และตรวจสอบข้อมูลบัญชีได้สะดวก ก่อนเริ่มควรศึกษากติกา ฟีเจอร์ และเงื่อนไขโปรโมชั่นให้ครบถ้วน
    </p>
  </ContentBoxNeumorphism>

  <ContentBoxFloatingBadge as="h2" title="เลือกเกมค่ายดังจากสไตล์ที่ชอบบน JERRY69">
    <p class="text-left text-base leading-relaxed text-[#f3e3d0]">
      ภายใน JERRY69 มีเกมสล็อตหลายธีมและหลายรูปแบบจากค่ายที่ระบบรองรับ ผู้เล่นสามารถเลือกจากฟีเจอร์โบนัส ความเร็วของเกม และระดับเดิมพัน แทนการเลือกจากชื่อค่ายเพียงอย่างเดียว
      การเปรียบเทียบข้อมูลก่อนเล่นช่วยให้หาเกมที่เหมาะกับงบและความชอบได้ง่ายขึ้น
    </p>
  </ContentBoxFloatingBadge>

  <ProviderGridPremium />

  <ContentBoxTwoNeumorphism titleleft="สมัครฟรีควรดูว่ามีค่าใช้จ่ายส่วนไหนเพิ่มเติมหรือไม่">
    <p slot="left" class="text-left text-base leading-relaxed text-[#f3e3d0]">
      คำว่าสมัครฟรีควรหมายถึงไม่มีค่าธรรมเนียมในการเปิดบัญชี แต่ผู้ใช้งานยังควรตรวจสอบเงื่อนไขด้านการฝาก โปรโมชั่น และการถอนแยกกันให้ชัด
    </p>
    <p slot="right" class="text-left text-base leading-relaxed text-[#f3e3d0]">การอ่านรายละเอียดตั้งแต่ต้นช่วยลดความเข้าใจผิดและทำให้เลือกสิทธิ์ที่เหมาะกับตนเองได้มากขึ้น</p>
  </ContentBoxTwoNeumorphism>

  <ContentBoxSevenThree titleright="โปรทุนน้อยของ JERRY69 เหมาะกับการเริ่มแบบมีแผน">
    <Picture
      slot="left"
      src={imgLuckyWheel}
      loading="lazy"
      fetchpriority="low"
      widths={[300, 450, 600]}
      sizes="(max-width: 768px) calc(100vw - 6rem), 380px"
      decoding="async"
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      quality={80}
      alt={altLuckyWheel}
      class="mx-auto h-auto w-full rounded-2xl border border-[#fa8302]/45 shadow-[0_10px_30px_rgba(250,131,2,0.28)]"
    />
    <p slot="right" class="text-left text-base leading-relaxed text-[#f3e3d0]">
      โปรโมชั่นทุนน้อยของ JERRY69 ควรพิจารณาจากยอดเริ่มต้น โบนัส เกมที่ร่วมรายการ และเงื่อนไขการถอนร่วมกัน โปรที่เหมาะไม่จำเป็นต้องให้โบนัสสูงที่สุด แต่ควรสัมพันธ์กับงบและรูปแบบการเล่น
      เพื่อไม่ให้ต้องเพิ่มเงินเกินแผนที่ตั้งไว้
    </p>
  </ContentBoxSevenThree>

  <ContentBox as="h2" title="เกมแตกง่ายควรดู RTP และความผันผวนประกอบ">
    <p class="text-left text-base leading-relaxed text-[#f3e3d0]">
      คำว่าแตกง่ายเป็นข้อความทางการตลาดและไม่สามารถรับประกันผลได้ ผู้เล่นควรดู RTP ที่ผู้ให้บริการระบุ ความผันผวน ตารางจ่าย และฟีเจอร์โบนัสร่วมกัน
      ข้อมูลเหล่านี้ช่วยอธิบายลักษณะของเกมได้ดีกว่าการเลือกจากคำโปรโมตเพียงอย่างเดียว
    </p>
  </ContentBox>

  <LoginRtpSection />

  <ContentBoxSevenThreeFloatingBadge title="จัดการบัญชีและโปรโมชั่นผ่านระบบของ JERRY69">
    <Picture
      slot="left"
      src={imgDailyMission}
      loading="lazy"
      fetchpriority="low"
      widths={[300, 450, 600]}
      sizes="(max-width: 768px) calc(100vw - 6rem), 380px"
      decoding="async"
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      quality={80}
      alt={altDailyMission}
      class="mx-auto h-auto w-full rounded-2xl border border-[#ffc94a]/45 shadow-[0_10px_30px_rgba(194,83,2,0.32)]"
    />
    <p slot="right" class="text-left text-base leading-relaxed text-[#f3e3d0]">
      สมาชิก JERRY69 สามารถตรวจสอบข้อมูลบัญชี สิทธิ์โปรโมชั่น และประวัติรายการผ่านระบบเดียวได้ ก่อนทำธุรกรรมควรตรวจชื่อบัญชี จำนวนเงิน และเงื่อนไขที่เกี่ยวข้องให้ครบ
      หากรายการเดิมยังดำเนินการอยู่ควรรอระบบอัปเดตก่อนส่งคำขอใหม่
    </p>
  </ContentBoxSevenThreeFloatingBadge>

  <LatestWinners3 />

  <ContentBoxTwoCyberCut titleleft="คำว่ารวยไวบน JERRY69 ไม่ใช่การรับประกันรายได้">
    <p slot="left" class="text-left text-base leading-relaxed text-[#f3e3d0]">คำว่ารวยไวของ JERRY69 ใช้สื่อถึงโอกาสลุ้นรางวัลและความตื่นเต้นของเกมสล็อต แต่ไม่สามารถรับประกันรายได้หรือกำไรได้</p>
    <p slot="right" class="text-left text-base leading-relaxed text-[#f3e3d0]">ผู้เล่นควรกำหนดวงเงินและเวลาเล่นไว้ล่วงหน้า และหลีกเลี่ยงการเพิ่มเดิมพันเพื่อตามคืนยอดที่เสียไป</p>
  </ContentBoxTwoCyberCut>

  <Faq4 title="คำถามที่พบบ่อยเกี่ยวกับ JERRY69" faqs={faqs} />

  <SmoothCarousel />

  <div class="relative z-10 mx-auto mb-10 flex flex-nowrap justify-center gap-3 px-4 sm:gap-6">
    <a
      href="/login"
      class="group relative flex flex-1 items-center justify-center rounded-full border-2 border-[#fff4e2]/55 bg-gradient-to-r from-[#261305] via-[#160b03] to-[#0a0503] px-4 py-3 text-sm font-black whitespace-nowrap text-[#fff4e2] shadow-[0_10px_30px_rgba(250,131,2,0.22)] transition-all duration-300 hover:-translate-y-1 hover:scale-105 hover:border-[#ffc94a] hover:shadow-[0_15px_40px_rgba(250,131,2,0.35)] sm:flex-none sm:px-10 sm:py-3.5 sm:text-base">
      เข้าสู่ระบบ
    </a>

    <a
      href="/register"
      class="group relative flex flex-1 items-center justify-center rounded-full border-2 border-[#ffc94a]/70 bg-gradient-to-r from-[#ffc94a] to-[#fa8302] px-4 py-3 text-sm font-black whitespace-nowrap text-[#160b03] shadow-[0_10px_30px_rgba(250,131,2,0.35)] transition-all duration-300 hover:-translate-y-1 hover:scale-105 hover:border-[#fff4e2] hover:shadow-[0_15px_40px_rgba(250,131,2,0.5)] sm:flex-none sm:px-10 sm:py-3.5 sm:text-base">
      สมัครสมาชิก
    </a>
  </div>

  <ReviewCardSumo2 />

  <Navfoot />
</MainLayout>
