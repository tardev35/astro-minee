---
import MainLayout from "../layouts/MainLayout.astro";
import Announcement from "../components/Announcement5.astro";
import ContentBoxFloatingBadge from "../components/ContentBoxFloatingBadge.astro";
import ContentBoxNeumorphism from "../components/ContentBoxNeumorphism.astro";
import ContentBoxSevenThreeFloatingBadge from "../components/ContentBoxSevenThreeFloatingBadge.astro";
import ContentBoxSevenThreeNeumorphism from "../components/ContentBoxSevenThreeNeumorphism.astro";
import ContentBoxTwoNeumorphism from "../components/ContentBoxTwoNeumorphism.astro";
import ContentBox from "../components/ContentBox.astro";
import ProviderGrid from "../components/ProviderGrid.astro";
import LoginRtpSection from "../components/LoginRtpSection.astro";
import LatestWinnersCyber from "../components/LatestWinnersCyber.astro";
import Faq4 from "../components/Faq4.astro";
import SmoothCarousel from "../components/SmoothCarousel.astro";
import ReviewCardSumo2 from "../components/ReviewCardSumo2.astro";
import Navfoot from "../components/Navfoot.astro";

import { Picture } from "astro:assets";
import { pageGraph } from "../lib/schema";

// Slides live only inside a ContentBoxSevenThree* block and there are at most
// two of those per rebrand — both are spent here.
//
// slide4 prints "วงล้อเพชรแตก / ฝากครบ 300 รับสิทธิ์หมุน 1 ครั้ง" on a prize
// wheel whose segments read 39 / 89 / 189 เครดิต beside ของรางวัล and หมุนฟรี:
// one promotion with several printed values and a printed condition, which is
// docx H2-2's "ดูยอดฝาก เกมที่ร่วมรายการ ระยะเวลา และข้อกำหนดการถอนร่วมกัน"
// point in picture form.
// slide1 prints "ภารกิจประจำวัน / ทำครบ 3 ภารกิจ รับกล่องสุ่ม 79 บาท" over a
// three-step checklist (ล็อกอิน → ฝากเงิน → หมุนเกม), each step ticked
// separately — the same shape as docx H2-3's point that ฝาก, ถอน and ขั้นต่ำ
// ของเกม are separate conditions to be read one at a time.
// slide2 and slide3 stay unused on this page and keep rendering in
// SmoothCarousel and on /promotion.
//
// banner2.png is NOT imported anywhere: it predates this asset drop.
// banner1/banner1-mobile/og.png are the hero and the share card and belong to
// MainLayout alone.
import imgDiamondWheel from "../assets/slide4.png";
import imgDailyMission from "../assets/slide1.png";

// The docx "Main SEO" Title and H1, verbatim. They are the brand's own copy,
// not a draft to tidy.
const pageTitle = "DIAMOND789 | เว็บสล็อตรวมเกมลิขสิทธิ์แท้ โปรทุนน้อยแตกดีไม่มีขั้นต่ำ";
const pageHeading = "DIAMOND789 เว็บสล็อตรวมเกมลิขสิทธิ์แท้ โปรทุนน้อยแตกดีไม่มีขั้นต่ำ";

// The docx Main SEO Meta Description, verbatim at the length it was written
// (126 characters). DESC_MIN does not apply to the home page — verify-build.mjs
// exempts it precisely so the brand's own copy ships unpadded. Do not top it up
// to 150.
const pageDescription = "DIAMOND789 รวมเกมสล็อตลิขสิทธิ์หลายแนว โปรทุนน้อย ไม่มีขั้นต่ำตามเงื่อนไข พร้อมข้อมูลค่ายเกม ระบบบัญชี และรายการตรวจสอบได้ง่าย";

// Byte-identical to Announcement5's own default, which is what every sub-page
// calling <Announcement /> bare lands on. Passing it explicitly here keeps the
// home page and the rest of the site from drifting apart silently. No leading
// emoji — the marquee renders the string twice.
const announcement =
  "DIAMOND789 รวมเกมสล็อตจากหลายค่ายไว้ในระบบเดียว เลือกเกมจากค่าย ธีม และรูปแบบฟีเจอร์ได้จากหน้าเดียว • ก่อนเริ่มควรตรวจชื่อผู้ให้บริการ ตารางจ่าย รายละเอียดเกม และกติกาให้ครบทุกครั้ง • โปรทุนน้อยควรดูยอดฝาก เกมที่ร่วมรายการ ระยะเวลา และข้อกำหนดการถอนร่วมกัน โบนัสสูงไม่ได้แปลว่าคุ้มที่สุดเสมอไป • คำว่าไม่มีขั้นต่ำอาจใช้กับยอดฝาก ยอดถอน หรือขั้นต่ำของเกม ซึ่งไม่จำเป็นต้องเป็นเงื่อนไขเดียวกัน ควรตรวจแต่ละส่วนก่อนทำรายการ • คำว่าแตกดีใช้สื่อถึงความน่าสนใจของเกม ไม่ใช่การรับประกันผลลัพธ์ ควรกำหนดวงเงินและหยุดเมื่อถึงขีดจำกัดที่วางไว้ล่วงหน้า";

// Each alt is the text printed on that slide plus the scene around it, read off
// the artwork — the same strings SmoothCarousel uses for the same two files.
const altDiamondWheel =
  "แบนเนอร์โปรโมชั่น DIAMOND789 ข้อความ Diamond789 สีเงินเงา และบรรทัดล่างเขียนว่า วงล้อเพชรแตก สีชมพูบานเย็น ใต้ลงมาเป็นแถบสีดำเขียนว่า ฝากครบ 300 รับสิทธิ์หมุน 1 ครั้ง ด้านขวาเป็นวงล้อเสี่ยงโชคขอบไฟชมพูแบ่งเป็นช่อง ช่องบนซ้ายเขียน 39 เครดิต ช่องบนขวาเขียน 89 เครดิต ช่องขวาเขียน 189 เครดิต สลับกับช่องที่มีไอคอนกล่องของขวัญเขียนว่า ของรางวัล และช่องที่เขียนว่า หมุนฟรี กลางวงล้อเป็นเพชรสีชมพู และมีหัวลูกศรรูปเพชรชี้ลงอยู่ด้านบน ใต้วงล้อเป็นบรรทัดเขียนว่า ลุ้นได้ทุกวันตามเงื่อนไข และปุ่มสีขาวขอบชมพูเขียนว่า หมุนเลย ด้านบนเป็นโลโก้ Diamond789 ตัวอักษรสีเงินสลับชมพู มีเพชรเจียระไนสีขาวอยู่ข้างหน้า ใต้โลโก้เขียนว่า GAME CASIO ONLINE AND SPORT BETTING ด้านซ้ายเป็นผู้หญิงในชุดสีดำสลับชมพูติดโลโก้ Diamond789 ชี้นิ้วไปที่วงล้อ ด้านหลังเป็นชิปคาสิโนมีเลข 789 กองเหรียญทอง และเพชรสีชมพูกับสีขาวกระจายอยู่บนพื้นหลังสีดำ";

const altDailyMission =
  "แบนเนอร์โปรโมชั่น DIAMOND789 ข้อความ Diamond789 สีเงินเงา และบรรทัดล่างเขียนว่า ภารกิจประจำวัน สีชมพูบานเย็น ใต้ลงมาเป็นแถบสีดำเขียนว่า ทำครบ 3 ภารกิจ และ รับกล่องสุ่ม 79 บาท ถัดลงมาเป็นรายการภารกิจสามข้อเรียงลงมา ล็อกอิน ฝากเงิน และ หมุนเกม แต่ละข้อมีไอคอนอยู่หน้าและเครื่องหมายถูกในกรอบอยู่ท้าย ข้างขวาเป็นวงกลมขอบชมพูเขียนเลข 79 ตัวใหญ่และคำว่า บาท ถัดขึ้นไปเป็นกล่องของขวัญสีชมพูผูกโบว์ ด้านล่างเป็นปุ่มสีชมพูบานเย็นเขียนว่า รับภารกิจ ขนาบด้วยรูปเพชร ด้านบนเป็นโลโก้ Diamond789 ตัวอักษรสีเงินสลับชมพู มีเพชรเจียระไนสีขาวอยู่ข้างหน้า ใต้โลโก้เขียนว่า GAME CASIO ONLINE AND SPORT BETTING ด้านซ้ายเป็นผู้หญิงในชุดสีดำสลับชมพูติดโลโก้ Diamond789 ข้างหลังเป็นวงล้อรูเล็ต ชิปคาสิโนมีเลข 789 ไพ่เอซ และเพชรสีชมพูกับสีขาวกระจายอยู่ ด้านล่างสุดเป็นแถบสี่ช่องเขียนว่า มั่นคง ปลอดภัย ข้อมูลส่วนตัวปลอดภัย บริการรวดเร็ว และ จ่ายจริง การันตี บนพื้นหลังสีดำ";

// The docx Q&A block, verbatim. Passed as an explicit prop rather than left to
// Faq4's own default, so the rendered markup and the FAQ JSON-LD below come out
// of the same array.
const faqs = [
  {
    q: "DIAMOND789 มีเกมสล็อตลิขสิทธิ์แท้หลายค่ายหรือไม่?",
    a: "ระบบอาจมีเกมจากหลายผู้ให้บริการตามที่เว็บไซต์กำหนด ผู้เล่นควรตรวจชื่อค่าย รายละเอียดเกม ตารางจ่าย และกติกาก่อนเลือกเล่นทุกครั้ง",
  },
  {
    q: "DIAMOND789 ไม่มีขั้นต่ำหมายถึงอะไร?",
    a: "คำว่าไม่มีขั้นต่ำอาจใช้กับการฝาก ถอน หรือเงื่อนไขบางรายการ จึงควรตรวจรายละเอียดของแต่ละช่องทางและโปรโมชั่นก่อนเริ่มทำธุรกรรม",
  },
  {
    q: "โปรทุนน้อยแตกดีของ DIAMOND789 รับประกันกำไรหรือไม่?",
    a: "ไม่สามารถรับประกันกำไรจากโปรโมชั่นหรือเกมสล็อตได้ ผู้เล่นควรดูเงื่อนไขโปร RTP ความผันผวน และกำหนดงบที่เหมาะกับตนเองก่อนเริ่มเล่น",
  },
];

// Homepage: no breadcrumb — there is no trail above the root.
const graph = pageGraph(Astro, {
  name: pageHeading,
  description: pageDescription,
  faqs,
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement message={announcement} />

  <ContentBoxFloatingBadge as="h1" title={pageHeading}>
    <p class="text-left text-base leading-relaxed text-[#f8e3f0]">
      <strong class="text-[#ff5cb8]">DIAMOND789</strong> เป็นแพลตฟอร์มสล็อตออนไลน์ที่รวบรวมเกมจากหลายค่ายไว้ในระบบเดียว พร้อมโปรโมชั่นสำหรับผู้ที่ต้องการเริ่มต้นด้วยงบไม่สูงและเงื่อนไขไม่มีขั้นต่ำในบางช่องทาง
      สมาชิกสามารถเปรียบเทียบเกม โปรโมชั่น และข้อมูลบัญชีได้สะดวก โดยควรตรวจรายละเอียดค่ายเกม กติกา และเงื่อนไขก่อนเริ่มทุกครั้ง
    </p>
  </ContentBoxFloatingBadge>

  <SmoothCarousel />

  <ContentBoxNeumorphism as="h2" title="เลือกค่ายเกมสล็อตจากข้อมูลจริงบน DIAMOND789">
    <p class="text-left text-base leading-relaxed text-[#f8e3f0]">
      ภายใน DIAMOND789 ผู้เล่นสามารถเลือกเกมจากค่าย ธีม และรูปแบบฟีเจอร์ที่แตกต่างกัน ก่อนเริ่มควรตรวจชื่อผู้ให้บริการ ตารางจ่าย และรายละเอียดเกม
      เพื่อช่วยให้เลือกได้ตรงความชอบมากกว่าการตัดสินจากคำว่าเกมลิขสิทธิ์หรือเกมยอดนิยมเพียงอย่างเดียว
    </p>
  </ContentBoxNeumorphism>

  <ProviderGrid />

  <ContentBoxSevenThreeFloatingBadge title="โปรทุนน้อยควรดูทั้งโบนัสและเงื่อนไขการถอน">
    <Picture
      slot="left"
      src={imgDiamondWheel}
      loading="lazy"
      fetchpriority="low"
      widths={[300, 450, 600]}
      sizes="(max-width: 768px) calc(100vw - 6rem), 380px"
      decoding="async"
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      quality={80}
      alt={altDiamondWheel}
      class="mx-auto h-auto w-full rounded-2xl border border-[#f30d8c]/45 shadow-[0_10px_30px_rgba(243,13,140,0.28)]"
    />
    <p slot="right" class="text-left text-base leading-relaxed text-[#f8e3f0]">
      โปรโมชั่นที่ใช้เงินเริ่มต้นไม่สูงอาจเหมาะกับผู้ที่ต้องการควบคุมงบ แต่ควรดูยอดฝาก เกมที่ร่วมรายการ ระยะเวลา และข้อกำหนดการถอนร่วมกัน โปรที่ให้โบนัสสูงอาจไม่ได้คุ้มที่สุด
      หากมีเงื่อนไขที่ไม่สอดคล้องกับรูปแบบการเล่นของผู้ใช้
    </p>
  </ContentBoxSevenThreeFloatingBadge>

  <ContentBoxSevenThreeNeumorphism title="ไม่มีขั้นต่ำบน DIAMOND789 ต้องแยกฝาก ถอน และเดิมพันให้ชัด">
    <Picture
      slot="left"
      src={imgDailyMission}
      loading="lazy"
      fetchpriority="low"
      widths={[300, 450, 600]}
      sizes="(max-width: 768px) calc(100vw - 6rem), 380px"
      decoding="async"
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      quality={80}
      alt={altDailyMission}
      class="mx-auto h-auto w-full rounded-2xl border border-[#b312ac]/45 shadow-[0_10px_30px_rgba(179,18,172,0.28)]"
    />
    <p slot="right" class="text-left text-base leading-relaxed text-[#f8e3f0]">
      คำว่าไม่มีขั้นต่ำของ DIAMOND789 อาจเกี่ยวข้องกับยอดฝาก ยอดถอน หรือขั้นต่ำของเกม ซึ่งไม่จำเป็นต้องเป็นเงื่อนไขเดียวกัน ผู้เล่นควรตรวจรายละเอียดแต่ละส่วนก่อนทำรายการ
      เพื่อช่วยให้กำหนดงบและเลือกช่องทางได้ตรงกับความต้องการมากขึ้น
    </p>
  </ContentBoxSevenThreeNeumorphism>

  <ContentBoxTwoNeumorphism titleleft="เกมลิขสิทธิ์แท้ควรตรวจผู้ให้บริการมากกว่าดูจากชื่อเกม">
    <p slot="left" class="text-left text-base leading-relaxed text-[#f8e3f0]">หากเว็บไซต์ระบุว่าเป็นเกมลิขสิทธิ์แท้ ควรมีข้อมูลผู้ให้บริการหรือรายละเอียดเกมให้ตรวจสอบ</p>
    <p slot="right" class="text-left text-base leading-relaxed text-[#f8e3f0]">
      ผู้เล่นควรพิจารณาแหล่งที่มาของเกม กติกา และข้อมูลระบบร่วมกัน ไม่ควรใช้ข้อความโฆษณาเพียงอย่างเดียวเป็นหลักในการประเมินความน่าเชื่อถือ
    </p>
  </ContentBoxTwoNeumorphism>

  <ContentBox as="h2" title="ใช้ RTP และความผันผวนช่วยคัดเกมบน DIAMOND789">
    <p class="text-left text-base leading-relaxed text-[#f8e3f0]">
      แทนที่จะเลือกเพียงเกมที่โฆษณาว่าแตกดี ผู้ใช้ DIAMOND789 สามารถพิจารณา RTP ที่ผู้ให้บริการระบุ ฟีเจอร์โบนัส และระดับความผันผวนร่วมกัน เกมแต่ละประเภทมีรูปแบบการจ่ายต่างกัน
      จึงควรเลือกวงเงินต่อรอบให้เหมาะกับงบและระดับความเสี่ยงที่ยอมรับได้
    </p>
  </ContentBox>

  <LoginRtpSection />

  <ContentBoxNeumorphism as="h2" title="แตกดีไม่ใช่การรับประกันผลลัพธ์จาก DIAMOND789">
    <p class="text-left text-base leading-relaxed text-[#f8e3f0]">
      คำว่าแตกดีของ DIAMOND789 ใช้สื่อถึงความน่าสนใจของเกม แต่ไม่สามารถรับประกันว่าผู้เล่นจะได้รับกำไรหรือรางวัลตามคาดทุกครั้ง ผลของเกมสล็อตมีความไม่แน่นอน
      จึงควรกำหนดวงเงินและหยุดเมื่อถึงขีดจำกัดที่วางไว้ล่วงหน้า
    </p>
  </ContentBoxNeumorphism>

  <Faq4 title="คำถามที่พบบ่อยเกี่ยวกับ DIAMOND789" faqs={faqs} />

  <div class="relative z-10 mx-auto mb-10 flex flex-nowrap justify-center gap-3 px-4 sm:gap-6">
    <a
      href="/login"
      class="group relative flex flex-1 items-center justify-center rounded-full border-2 border-[#e8e8ef]/55 bg-gradient-to-r from-[#2a1122] via-[#150810] to-[#070308] px-4 py-3 text-sm font-black whitespace-nowrap text-[#e8e8ef] shadow-[0_10px_30px_rgba(243,13,140,0.22)] transition-all duration-300 hover:-translate-y-1 hover:scale-105 hover:border-[#ff5cb8] hover:shadow-[0_15px_40px_rgba(243,13,140,0.35)] sm:flex-none sm:px-10 sm:py-3.5 sm:text-base">
      เข้าสู่ระบบ
    </a>

    <a
      href="/register"
      class="group relative flex flex-1 items-center justify-center rounded-full border-2 border-[#ff5cb8]/70 bg-gradient-to-r from-[#f30d8c] to-[#b80568] px-4 py-3 text-sm font-black whitespace-nowrap text-white shadow-[0_10px_30px_rgba(243,13,140,0.35)] transition-all duration-300 hover:-translate-y-1 hover:scale-105 hover:border-[#e8e8ef] hover:shadow-[0_15px_40px_rgba(243,13,140,0.5)] sm:flex-none sm:px-10 sm:py-3.5 sm:text-base">
      สมัครสมาชิก
    </a>
  </div>

  <LatestWinnersCyber />

  <ReviewCardSumo2 />

  <Navfoot />
</MainLayout>
