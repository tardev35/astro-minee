---
import MainLayout from "../layouts/MainLayout.astro";
import Announcement from "../components/Announcement5.astro";
import ContentBoxFloatingBadge from "../components/ContentBoxFloatingBadge.astro";
import ContentBoxNeumorphism from "../components/ContentBoxNeumorphism.astro";
import ContentBoxTwoNeumorphism from "../components/ContentBoxTwoNeumorphism.astro";
import ContentBox from "../components/ContentBox.astro";
import ContentBoxSevenThreeFloatingBadge from "../components/ContentBoxSevenThreeFloatingBadge.astro";
import ContentBoxSevenThreeNeumorphism from "../components/ContentBoxSevenThreeNeumorphism.astro";
import ContentBoxTwoCyberCut from "../components/ContentBoxTwoCyberCut.astro";
import ProviderGrid from "../components/ProviderGrid.astro";
import LoginRtpSection from "../components/LoginRtpSection.astro";
import LatestWinnersCyber from "../components/LatestWinnersCyber.astro";
import Faq4 from "../components/Faq4.astro";
import SmoothCarousel from "../components/SmoothCarousel.astro";
import ReviewCardSumo2 from "../components/ReviewCardSumo2.astro";
import Navfoot from "../components/Navfoot.astro";

import { Picture } from "astro:assets";
import { pageGraph } from "../lib/schema";

// Slides live only inside a ContentBoxSevenThree* block and there are at most
// two of those per rebrand — both are spent here.
//
// slide3 prints "เปิดหีบแดง / ลุ้นรางวัล" over four chests reading โบนัส 18 / 38 /
// 68 / 128 beside a phone marked ของรางวัลพิเศษ: one promotion whose printed
// values differ from each other, which is docx H2-5's point — a promotion is
// compared on its conditions and not on the biggest number.
// slide2 prints "ภารกิจสายลุย / ทำครบ 3 ขั้น รับแต้ม RANGER PASS" over a numbered
// ล็อกอิน → เล่นเกม → สะสมแต้ม row, the same "check the entitlement through your
// own account before you start" shape as docx H2-6.
// slide1 (เช็กอิน 7 วัน) and slide4 (ศึกสุดสัปดาห์) stay unused on this page and
// keep rendering in SmoothCarousel and on /promotion.
//
// banner2.png is NOT imported anywhere: it predates this asset drop.
// banner1/banner1-mobile/og.png are the hero and the share card and belong to
// MainLayout alone.
import imgRedChests from "../assets/slide3.png";
import imgQuestPass from "../assets/slide2.png";

// The docx "Main SEO" Title and H1, verbatim. They are the brand's own copy,
// not a draft to tidy.
const pageTitle = "RENGER8888 | คาสิโนเว็บหลักระบบออโต้ ฝากถอนง่ายไว โปรดีสุดคุ้ม";
const pageHeading = "RENGER8888 คาสิโนเว็บหลักระบบออโต้ ฝากถอนง่ายไว โปรดีสุดคุ้ม";

// The docx Main SEO Meta Description, verbatim at the length it was written.
// DESC_MIN does not apply to the home page — verify-build.mjs exempts it
// precisely so the brand's own copy ships unpadded. Do not top it up to 150.
const pageDescription = "RENGER8888 คาสิโนเว็บหลักระบบออโต้ ฝากถอนสะดวกตามเงื่อนไข พร้อมเกมหลายประเภท โปรโมชั่น และสถานะรายการให้ตรวจสอบได้ง่าย";

// Byte-identical to Announcement5's own default, which is what every sub-page
// calling <Announcement /> bare lands on. Passing it explicitly here keeps the
// home page and the rest of the site from drifting apart silently. No leading
// emoji — the marquee renders the string twice.
const announcement =
  "RENGER8888 คาสิโนเว็บหลักระบบออโต้ รวมเกมหลายประเภท ระบบบัญชี และการทำธุรกรรมไว้ในช่องทางเดียว • เลือกเกมตามหมวดที่สนใจ เช่น บาคาร่า สล็อต หรือคาสิโนสด ตามที่ระบบรองรับ แล้วเทียบกติกา อัตราจ่าย และวงเงินขั้นต่ำก่อนเริ่ม • คำว่าเว็บหลักไม่ใช่หลักฐานยืนยันคุณภาพเพียงอย่างเดียว ควรดูช่องทางเข้า ระบบสมาชิก ประวัติธุรกรรม และช่องทางติดต่อประกอบกัน • ก่อนยืนยันฝากถอนควรตรวจชื่อบัญชี จำนวนเงิน และข้อมูลรับเงินให้ถูกต้อง หากรายการเดิมยังดำเนินการอยู่ควรรอการอัปเดตก่อนส่งใหม่ • โปรโมชั่นที่ดูคุ้มไม่จำเป็นต้องให้เครดิตมากที่สุด ควรเทียบยอดฝากขั้นต่ำ เกมที่ร่วมรายการ ระยะเวลา และข้อกำหนดการถอนร่วมกัน • คำว่าฝากถอนง่ายไวควรดูจากสถานะธุรกรรมจริงในระบบ ไม่ใช่การรับประกันเวลาทุกกรณี";

// Each alt is the text actually printed on that slide plus the scene around it,
// read off the artwork itself. The logo artwork spells the word "RANGER 8888",
// so the alt says so where it is describing the picture — everything else on the
// site is the brand's own spelling, RENGER8888.
const altRedChests =
  "แบนเนอร์โปรโมชั่น RENGER8888 หัวข้อตัวหนาสองบรรทัดเขียนว่า เปิดหีบแดง และ ลุ้นรางวัล ใต้ลงมาเป็นแถบเงื่อนไขเขียนว่า รับสิทธิ์เปิดหีบทุกวัน ลุ้นเครดิตและของรางวัล ถัดลงมาเป็นหีบสมบัติสีเงินสลับแดงสี่ใบเรียงกันมีเหรียญทองล้นออกมา ใต้แต่ละใบเขียนว่า โบนัส 18 โบนัส 38 โบนัส 68 และ โบนัส 128 ถัดไปทางขวาเป็นโทรศัพท์มือถือเขียนกำกับว่า ของรางวัลพิเศษ ใต้แถวหีบเขียนว่า สุ่มรับรางวัลได้ทุกวัน ด้านล่างเป็นปุ่มเขียนว่า เปิดหีบเลย ด้านขวาของภาพเป็นผู้หญิงในชุดราตรีสีแดงเป็นประกาย ฉากหลังเป็นห้องโถงหินสีแดงเข้มและธงตราโล่อักษร R มุมบนซ้ายเป็นโลโก้ RENGER8888 รูปอัศวินสวมเกราะถือดาบไขว้ ตัวอักษรบนภาพเขียนว่า RANGER 8888";

const altQuestPass =
  "แบนเนอร์โปรโมชั่น RENGER8888 หัวข้อตัวหนาเขียนว่า ภารกิจสายลุย บรรทัดถัดมาเขียนว่า ทำครบ 3 ขั้น รับแต้ม RANGER PASS ถัดลงมาเป็นแถวสามขั้นตอนเชื่อมกันด้วยลูกศรสีแดงเขียนว่า 1 ล็อกอิน 2 เล่นเกม และ 3 สะสมแต้ม แต่ละขั้นมีไอคอนหมวกอัศวิน ดาบไขว้ และเหรียญอักษร R ถัดลงมาเขียนว่า แลกของรางวัลสุดพิเศษ ใต้บรรทัดนั้นเป็นโล่อักษร R บัตรสมาชิกเขียนว่า R VIP RANGER8888 และกองเหรียญอักษร R ถัดลงมาเขียนว่า สะสมแต้มครบ รับโบนัสรายสัปดาห์ ด้านล่างเป็นปุ่มเขียนว่า รับภารกิจ ด้านซ้ายของภาพเป็นผู้หญิงในชุดเกราะสีดำสลับแดงพร้อมผ้าคลุมสีแดง ฉากหลังเป็นปราสาทสีเข้มและธงอักษร R ด้านบนเป็นโลโก้ RENGER8888 รูปอัศวินสวมเกราะถือดาบไขว้ ตัวอักษรบนภาพเขียนว่า RANGER 8888";

// The docx Q&A block, verbatim. Passed as an explicit prop rather than left to
// Faq4's own default, so the rendered markup and the FAQ JSON-LD below come out
// of the same array.
const faqs = [
  {
    q: "RENGER8888 มีเกมคาสิโนประเภทใดให้เลือกบ้าง?",
    a: "ระบบอาจรวมเกมหลายประเภทตามที่เว็บไซต์กำหนด ผู้เล่นควรตรวจหมวดเกม กติกา อัตราจ่าย และวงเงินขั้นต่ำก่อนเลือกเล่นทุกครั้ง",
  },
  {
    q: "ระบบออโต้ของ RENGER8888 ช่วยเรื่องอะไร?",
    a: "ระบบออโต้ช่วยลดขั้นตอนการจัดการบัญชีและธุรกรรม พร้อมให้สมาชิกติดตามสถานะรายการได้สะดวกขึ้น โดยระยะเวลาดำเนินการอาจแตกต่างตามช่องทาง",
  },
  {
    q: "โปรโมชั่นดีสุดคุ้มของ RENGER8888 ควรดูอะไรบ้าง?",
    a: "ควรดูทั้งจำนวนโบนัส ยอดฝากขั้นต่ำ เกมที่ร่วมรายการ ระยะเวลา และเงื่อนไขการถอน เพื่อเลือกโปรโมชั่นที่เหมาะกับงบและรูปแบบการเล่นของตนเอง",
  },
];

// Homepage: no breadcrumb — there is no trail above the root.
const graph = pageGraph(Astro, {
  name: pageHeading,
  description: pageDescription,
  faqs,
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement message={announcement} />

  <SmoothCarousel />

  <ContentBoxFloatingBadge as="h1" title={pageHeading}>
    <p class="text-left text-base leading-relaxed text-[#f0dcdc]">
      <strong class="text-[#ff2b38]">RENGER8888</strong> เป็นแพลตฟอร์มคาสิโนออนไลน์ที่รวมเกมหลายประเภท ระบบบัญชี และการทำธุรกรรมไว้ในช่องทางเดียว พร้อมระบบออโต้ช่วยลดขั้นตอนในการฝากและถอน สมาชิกสามารถเลือกเกม
      ตรวจโปรโมชั่น และติดตามสถานะรายการได้สะดวก โดยควรศึกษากติกา อัตราจ่าย และเงื่อนไขของแต่ละเกมก่อนเริ่มใช้งานทุกครั้ง
    </p>
  </ContentBoxFloatingBadge>

  <ContentBoxNeumorphism as="h2" title="เริ่มเลือกเกมจากหมวดที่สนใจบน RENGER8888">
    <p class="text-left text-base leading-relaxed text-[#f0dcdc]">
      ภายใน RENGER8888 ผู้เล่นสามารถเลือกเกมตามประเภท เช่น บาคาร่า สล็อต หรือคาสิโนสด ตามที่ระบบรองรับ การแยกหมวดให้ชัดช่วยให้เปรียบเทียบกติกา อัตราจ่าย และวงเงินขั้นต่ำได้ง่ายขึ้น
      ก่อนเลือกควรดูข้อมูลของเกมและระดับความเสี่ยงให้สอดคล้องกับงบของตนเอง
    </p>
  </ContentBoxNeumorphism>

  <ProviderGrid />

  <ContentBoxTwoNeumorphism as="h2" titleleft="เว็บหลักควรดูจากระบบบัญชีและข้อมูลที่ตรวจสอบได้">
    <p slot="left" class="text-left text-base leading-relaxed text-[#f0dcdc]">
      คำว่าเว็บหลักไม่ควรใช้เป็นหลักฐานยืนยันคุณภาพเพียงอย่างเดียว ผู้ใช้งานควรดูช่องทางเข้า ระบบสมาชิก ประวัติธุรกรรม ข้อมูลเกม และช่องทางติดต่อประกอบกัน
    </p>
    <p slot="right" class="text-left text-base leading-relaxed text-[#f0dcdc]">หากองค์ประกอบเหล่านี้ชัดเจนจะช่วยให้ตรวจสอบการใช้งานและสถานะรายการได้ง่ายขึ้น</p>
  </ContentBoxTwoNeumorphism>

  <ContentBox as="h2" title="ฝากถอนผ่านระบบออโต้ของ RENGER8888 ให้ตรวจข้อมูลก่อนยืนยัน">
    <p class="text-left text-base leading-relaxed text-[#f0dcdc]">
      สมาชิก RENGER8888 สามารถจัดการฝากถอนผ่านระบบที่เว็บไซต์กำหนด ก่อนทำรายการควรตรวจชื่อบัญชี จำนวนเงิน และข้อมูลรับเงินให้ถูกต้อง หากรายการเดิมยังอยู่ระหว่างดำเนินการควรรอการอัปเดตก่อนส่งใหม่
      เพื่อลดโอกาสเกิดรายการซ้ำหรือยอดคลาดเคลื่อน
    </p>
  </ContentBox>

  <ContentBoxSevenThreeFloatingBadge title="โปรโมชั่นสุดคุ้มควรเทียบมากกว่าแค่จำนวนโบนัส">
    <Picture
      slot="left"
      src={imgRedChests}
      loading="lazy"
      fetchpriority="low"
      widths={[300, 450, 600]}
      sizes="(max-width: 768px) calc(100vw - 6rem), 380px"
      decoding="async"
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      quality={80}
      alt={altRedChests}
      class="mx-auto h-auto w-full rounded-2xl border border-[#e8121f]/45 shadow-[0_10px_30px_rgba(232,18,31,0.28)]"
    />
    <p slot="right" class="text-left text-base leading-relaxed text-[#f0dcdc]">
      โปรโมชั่นที่ดูคุ้มไม่จำเป็นต้องเป็นโปรที่ให้เครดิตมากที่สุด ควรเปรียบเทียบยอดฝากขั้นต่ำ เกมที่ร่วมรายการ ระยะเวลา และข้อกำหนดการถอนร่วมกัน
      การเลือกโปรที่ตรงกับงบและประเภทเกมที่เล่นช่วยให้เข้าใจต้นทุนและเงื่อนไขได้ชัดเจนกว่า
    </p>
  </ContentBoxSevenThreeFloatingBadge>

  <ContentBoxSevenThreeNeumorphism as="h2" title="ตรวจสิทธิ์โปรโมชั่นผ่านบัญชี RENGER8888 ก่อนเริ่มเกม">
    <Picture
      slot="left"
      src={imgQuestPass}
      loading="lazy"
      fetchpriority="low"
      widths={[300, 450, 600]}
      sizes="(max-width: 768px) calc(100vw - 6rem), 380px"
      decoding="async"
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      quality={80}
      alt={altQuestPass}
      class="mx-auto h-auto w-full rounded-2xl border border-[#8f0c14]/55 shadow-[0_10px_30px_rgba(232,18,31,0.24)]"
    />
    <p slot="right" class="text-left text-base leading-relaxed text-[#f0dcdc]">
      ก่อนรับสิทธิ์ ผู้ใช้ RENGER8888 ควรตรวจชื่อโปรโมชั่น จำนวนเครดิต และเงื่อนไขที่เกี่ยวข้องจากหน้าบัญชีให้ครบ หากมีหลายโปรพร้อมกันควรดูว่าสามารถใช้ร่วมกันได้หรือไม่
      และควรเก็บรายละเอียดสิทธิ์ไว้จนกว่าการใช้งานหรือการถอนจะเสร็จสมบูรณ์
    </p>
  </ContentBoxSevenThreeNeumorphism>

  <ContentBoxTwoCyberCut as="h2" title="ฝากถอนง่ายไวบน RENGER8888 ควรดูสถานะจริงของรายการ">
    <p slot="left" class="text-left text-base leading-relaxed text-[#f0dcdc]">คำว่าฝากถอนง่ายไวของ RENGER8888 ควรพิจารณาจากสถานะธุรกรรมจริงในระบบ ไม่ควรตีความเป็นการรับประกันเวลาทุกกรณี</p>
    <p slot="right" class="text-left text-base leading-relaxed text-[#f0dcdc]">ความเร็วอาจขึ้นอยู่กับช่องทาง สถานะบัญชี และขั้นตอนตรวจสอบ จึงควรติดตามรายการจากหน้าประวัติเป็นหลัก</p>
  </ContentBoxTwoCyberCut>

  <Faq4 title="คำถามที่พบบ่อยเกี่ยวกับ RENGER8888" faqs={faqs} />

  <LatestWinnersCyber />

  <LoginRtpSection />

  <div class="relative z-10 mx-auto mb-10 flex flex-nowrap justify-center gap-3 px-4 sm:gap-6">
    <a
      href="/login"
      class="group relative flex flex-1 items-center justify-center rounded-full border-2 border-[#e6ecf2]/55 bg-gradient-to-r from-[#28080b] via-[#160406] to-[#080203] px-4 py-3 text-sm font-black whitespace-nowrap text-[#f7e8e8] shadow-[0_10px_30px_rgba(232,18,31,0.22)] transition-all duration-300 hover:-translate-y-1 hover:scale-105 hover:border-[#e8121f] hover:shadow-[0_15px_40px_rgba(232,18,31,0.35)] sm:flex-none sm:px-10 sm:py-3.5 sm:text-base">
      เข้าสู่ระบบ
    </a>

    <a
      href="/register"
      class="group relative flex flex-1 items-center justify-center rounded-full border-2 border-[#ff2b38]/70 bg-gradient-to-r from-[#e8121f] to-[#8f0c14] px-4 py-3 text-sm font-black whitespace-nowrap text-[#f7e8e8] shadow-[0_10px_30px_rgba(232,18,31,0.35)] transition-all duration-300 hover:-translate-y-1 hover:scale-105 hover:border-[#e6ecf2] hover:shadow-[0_15px_40px_rgba(232,18,31,0.5)] sm:flex-none sm:px-10 sm:py-3.5 sm:text-base">
      สมัครสมาชิก
    </a>
  </div>

  <ReviewCardSumo2 />

  <Navfoot />
</MainLayout>
