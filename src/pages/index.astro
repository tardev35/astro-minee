---
import MainLayout from "../layouts/MainLayout.astro";
import Announcement from "../components/Announcement5.astro";
import ContentBoxPremium from "../components/ContentBoxPremium.astro";
import ContentBoxSevenThreePremium from "../components/ContentBoxSevenThreePremium.astro";
import ContentBox from "../components/ContentBox.astro";
import ContentBoxSevenThreeNeumorphism from "../components/ContentBoxSevenThreeNeumorphism.astro";
import ContentBoxSpecial from "../components/ContentBoxSpecial.astro";
import ProviderGrid from "../components/ProviderGrid.astro";
import GameRankingBoard from "../components/GameRankingBoard.astro";
import LoginRtpSection from "../components/LoginRtpSection.astro";
import ReviewCardSumo2 from "../components/ReviewCardSumo2.astro";
import LatestWinners from "../components/LatestWinnersPremium.astro";
import SmoothCarousel from "../components/SmoothCarousel.astro";
import Faq from "../components/Faq4.astro";
import Navfoot from "../components/Navfoot.astro";

import { Picture } from "astro:assets";
import { pageGraph } from "../lib/schema";

// Slides may only live inside a ContentBoxSevenThree* block and there are at
// most two of those per rebrand — both are spent here. slide1 reads
// "สมาชิกใหม่ รับโบนัส 50%", which sits with the game-selection section;
// slide2 reads "ฝากแรกของวัน รับเพิ่ม 20%" and sits with the ไม่มีขั้นต่ำ
// section. slide3 and slide4 stay unused here and keep rendering in
// SmoothCarousel and on /promotion.
import imgGameTypes from "../assets/slide1.png";
import imgNoMinimum from "../assets/slide2.png";

const pageTitle = "BUGGY888 | เว็บรวมเกมคาสิโนออนไลน์ ระบบออโต้ฝากถอน ไม่มีขั้นต่ำ";

// 155 characters. verify-build.mjs errors outside 150–160 CHARACTERS, and the
// docx-supplied description runs short — the trailing clause closes that gap
// without changing what the brief says. Measured; do not reword.
const pageDescription =
  "BUGGY888 เว็บรวมเกมคาสิโนออนไลน์ ระบบฝากถอนออโต้ ไม่มีขั้นต่ำตามเงื่อนไข รองรับมือถือ พร้อมเกมหลากหลายและบริการสมาชิกตลอด 24 ชั่วโมง ควรศึกษากติกาก่อนเริ่ม";

// The docx Q&A block, verbatim. Passed as an explicit prop rather than left to
// Faq4's own default, which is always the previous brand's FAQ.
const faqs = [
  {
    q: "BUGGY888 มีเกมคาสิโนประเภทใดบ้าง?",
    a: "ภายในระบบมีเกมสล็อต บาคาร่า รูเล็ต เกมไพ่ และคาสิโนสดหลายรูปแบบ สมาชิกสามารถเลือกเกมตามกติกา ความสนใจ และงบประมาณของตนเองได้",
  },
  {
    q: "BUGGY888 ฝากถอนไม่มีขั้นต่ำทุกช่องทางหรือไม่?",
    a: "เงื่อนไขไม่มีขั้นต่ำอาจรองรับเฉพาะช่องทางที่กำหนด สมาชิกควรตรวจสอบรายละเอียดล่าสุด รวมถึงเงื่อนไขของโปรโมชั่นก่อนทำรายการทุกครั้ง",
  },
  {
    q: "ระบบฝากถอนออโต้ของ BUGGY888 ทำงานอย่างไร?",
    a: "สมาชิกสามารถทำรายการผ่านหน้าบัญชีและติดตามสถานะได้ด้วยตนเอง ระยะเวลาดำเนินการอาจแตกต่างตามช่องทางชำระเงินและการตรวจสอบของระบบ",
  },
];

// Homepage: no breadcrumb — there is no trail above the root.
const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  faqs,
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement
    message="BUGGY888 เว็บรวมเกมคาสิโนออนไลน์ ทั้งสล็อต บาคาร่า รูเล็ต เกมไพ่ และคาสิโนสดในระบบเดียว • ระบบฝากถอนออโต้ทำรายการผ่านหน้าบัญชีได้ด้วยตนเอง ควรตรวจสอบชื่อบัญชีและจำนวนเงินก่อนยืนยันทุกครั้ง • เงื่อนไขไม่มีขั้นต่ำรองรับเฉพาะช่องทางที่กำหนด • รองรับมือถือ แท็บเล็ต และคอมพิวเตอร์ พร้อมทีมงานดูแลสมาชิกตลอด 24 ชั่วโมง"
  />

  <ContentBoxPremium as="h1" title="BUGGY888 | เว็บรวมเกมคาสิโนออนไลน์ ระบบออโต้ฝากถอน ไม่มีขั้นต่ำ">
    <p class="text-left text-base leading-relaxed text-[#f7e2c4]">
      <strong class="text-[#ffe98a]">BUGGY888</strong> เป็นแพลตฟอร์มคาสิโนออนไลน์ที่รวบรวมเกมหลายประเภทไว้ในระบบเดียว ทั้งสล็อต บาคาร่า รูเล็ต เกมไพ่ และคาสิโนสด
      พร้อมระบบฝากถอนออโต้ที่ช่วยลดขั้นตอนการทำรายการ และรองรับเงื่อนไขไม่มีขั้นต่ำในช่องทางที่กำหนด สมาชิกควรตรวจสอบกติกา โปรโมชั่น และรายละเอียดธุรกรรมก่อนเริ่มใช้งานทุกครั้ง
    </p>
  </ContentBoxPremium>

  <ContentBoxSevenThreePremium titleright="เลือกเกมคาสิโนหลายประเภทได้ใน BUGGY888">
    <Picture
      slot="left"
      src={imgGameTypes}
      loading="lazy"
      fetchpriority="low"
      widths={[300, 450, 600]}
      sizes="(max-width: 768px) calc(100vw - 6rem), 350px"
      decoding="async"
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      quality={80}
      alt="แบนเนอร์โปรโมชั่นของ BUGGY888 ข้อความ สมาชิกใหม่ รับโบนัส 50% สมัครวันนี้ รับสิทธิ์ทันที และปุ่ม รับโปรเลย พร้อมป้ายทอง BUGGY 888 ตัวมาสคอตโจรสลัดหน้าตัวตลก นางแบบชุดแดงทอง วงล้อ 777 เหรียญทองและอัญมณีสีแดง"
      class="mx-auto h-auto w-full rounded-2xl border border-[#ffd233]/35 shadow-[0_10px_30px_rgba(255,210,51,0.22)]"
    />
    <p slot="right" class="text-left text-base leading-relaxed text-[#f7e2c4]">
      ภายใน BUGGY888 มีทั้งเกมสล็อต บาคาร่า รูเล็ต เกมไพ่ และคาสิโนสดให้เลือกตามความสนใจ ผู้เล่นสามารถพิจารณาเกมจากกติกา รูปแบบการเดิมพัน และระดับความเสี่ยงของแต่ละประเภท
      เพื่อเลือกเกมที่เหมาะกับงบประมาณและสไตล์การเล่นของตนเองได้ง่ายขึ้น
    </p>
  </ContentBoxSevenThreePremium>

  <ProviderGrid />

  <ContentBox as="h2" title="ระบบออโต้ช่วยให้จัดการรายการได้เป็นขั้นตอน">
    <p class="text-left text-base leading-relaxed text-[#f7e2c4]">
      ระบบออโต้ช่วยให้สมาชิกฝาก ถอน และตรวจสอบสถานะรายการผ่านหน้าบัญชีได้ด้วยตนเอง ก่อนยืนยันควรตรวจสอบชื่อบัญชี จำนวนเงิน และข้อมูลให้ถูกต้อง หากธุรกรรมยังอยู่ระหว่างดำเนินการ
      ควรรอผลจากระบบก่อนส่งรายการใหม่ เพื่อป้องกันความสับสนในการตรวจสอบ
    </p>
  </ContentBox>

  <ContentBoxSevenThreeNeumorphism titleright="ฝากถอนไม่มีขั้นต่ำกับ BUGGY888 เพิ่มความยืดหยุ่น">
    <Picture
      slot="left"
      src={imgNoMinimum}
      loading="lazy"
      fetchpriority="low"
      widths={[300, 450, 600]}
      sizes="(max-width: 768px) calc(100vw - 6rem), 380px"
      decoding="async"
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      quality={80}
      alt="แบนเนอร์โปรโมชั่นของ BUGGY888 ข้อความ ฝากแรกของวัน รับเพิ่ม 20% คุ้มตั้งแต่ฝากแรก และปุ่ม ฝากเลย พร้อมป้ายทอง BUGGY 888 ตัวมาสคอตโจรสลัดหน้าตัวตลก นางแบบชุดแดงทองถือเหรียญ ตู้สล็อต JACKPOT เลข 777 และกองเหรียญทอง"
      class="mx-auto h-auto w-full rounded-2xl border border-[#ffd233]/35 shadow-[0_10px_30px_rgba(255,210,51,0.22)]"
    />
    <p slot="right" class="text-left text-base leading-relaxed text-[#f7e2c4]">
      เงื่อนไขไม่มีขั้นต่ำของ BUGGY888 ช่วยให้สมาชิกเลือกยอดทำรายการตามงบของตนเองได้ยืดหยุ่นมากขึ้น อย่างไรก็ตาม ควรตรวจสอบช่องทางที่รองรับ สถานะบัญชี และข้อกำหนดของโปรโมชั่นก่อนทำรายการ
      เพื่อให้เข้าใจเงื่อนไขการฝากถอนอย่างครบถ้วน
    </p>
  </ContentBoxSevenThreeNeumorphism>

  <ContentBoxSpecial as="h2" title="เปรียบเทียบเกมจากกติกาและรูปแบบการจ่าย">
    <p slot="left" class="text-left text-base leading-relaxed text-[#f7e2c4]">
      เกมคาสิโนแต่ละประเภทมีวิธีเล่น อัตราจ่าย และระดับความเสี่ยงต่างกัน ผู้เล่นควรศึกษากติกาและเงื่อนไขของเกมก่อนเริ่ม ไม่ควรเลือกจากความนิยมเพียงอย่างเดียว
    </p>
    <p slot="right" class="text-left text-base leading-relaxed text-[#f7e2c4]">
      การกำหนดงบและระยะเวลาไว้ล่วงหน้าจะช่วยให้ควบคุมการใช้งานได้เป็นระบบมากขึ้น
    </p>
  </ContentBoxSpecial>

  <GameRankingBoard />

  <ContentBoxPremium as="h2" title="BUGGY888 รองรับมือถือและการใช้งานหลายอุปกรณ์">
    <p class="text-left text-base leading-relaxed text-[#f7e2c4]">
      เว็บไซต์ BUGGY888 รองรับมือถือ แท็บเล็ต และคอมพิวเตอร์ สมาชิกสามารถเข้าสู่ระบบ เลือกเกม ดูโปรโมชั่น และตรวจสอบธุรกรรมผ่านเบราว์เซอร์ได้
      ควรใช้อินเทอร์เน็ตที่เสถียรและเข้าใช้งานผ่านช่องทางหลักเพื่อช่วยรักษาความปลอดภัยของบัญชี
    </p>
  </ContentBoxPremium>

  <ContentBox as="h2" title="ตรวจสอบบัญชีและรับความช่วยเหลือจาก BUGGY888">
    <p class="text-left text-base leading-relaxed text-[#f7e2c4]">
      เมื่อพบปัญหาเกี่ยวกับบัญชี ทางเข้า โปรโมชั่น หรือสถานะฝากถอน สมาชิกสามารถติดต่อทีมงาน BUGGY888 ผ่านช่องทางที่เว็บไซต์กำหนด ควรแจ้งชื่อผู้ใช้ เวลา และรายละเอียดรายการให้ครบ
      โดยไม่เปิดเผยรหัสผ่านหรือรหัสยืนยัน เพื่อช่วยให้ตรวจสอบปัญหาได้ตรงจุด
    </p>
  </ContentBox>

  <Faq title="คำถามที่พบบ่อยเกี่ยวกับ BUGGY888" faqs={faqs} />

  <LoginRtpSection />

  <LatestWinners />

  <div class="relative z-10 mx-auto mb-10 flex flex-nowrap justify-center gap-3 px-4 sm:gap-6">
    <a
      href="/login"
      class="group relative flex flex-1 items-center justify-center rounded-full bg-gradient-to-r from-[#ffe98a] via-[#ffd233] to-[#8d630b] px-4 py-3 text-sm font-black whitespace-nowrap text-[#2a0704] shadow-[0_10px_30px_rgba(255,210,51,0.3)] transition-all duration-300 hover:-translate-y-1 hover:scale-105 hover:shadow-[0_15px_40px_rgba(255,210,51,0.45)] sm:flex-none sm:px-10 sm:py-3.5 sm:text-base">
      เข้าสู่ระบบ
    </a>

    <a
      href="/register"
      class="group relative flex flex-1 items-center justify-center rounded-full border border-[#ffd233]/70 bg-[#1b0806]/85 px-4 py-3 text-sm font-black whitespace-nowrap text-[#f7e2c4] backdrop-blur-sm transition-all duration-300 hover:scale-105 hover:border-[#e8241a] hover:bg-[#2a0d09]/85 hover:shadow-[0_15px_40px_rgba(232,36,26,0.4)] sm:flex-none sm:px-10 sm:py-3.5 sm:text-base">
      สมัครสมาชิก
    </a>
  </div>

  <SmoothCarousel />

  <ReviewCardSumo2 />

  <Navfoot />
</MainLayout>
