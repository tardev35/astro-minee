---
import MainLayout from "../layouts/MainLayout.astro";
import Announcement from "../components/AnnouncementPremium.astro";
import ContentBoxPremium from "../components/ContentBoxPremium.astro";
import ContentBoxSevenThreePremium from "../components/ContentBoxSevenThreePremium.astro";
import ContentBoxCyberCut from "../components/ContentBoxCyberCut.astro";
import ContentBoxSpecial from "../components/ContentBoxSpecial.astro";
import ContentBoxSevenThreeCyberCut from "../components/ContentBoxSevenThreeCyberCut.astro";
import ContentBoxTwo from "../components/ContentBoxTwo.astro";
import ContentBox from "../components/ContentBox.astro";
import ProviderGrid from "../components/ProviderGrid.astro";
import LoginRtpSection from "../components/LoginRtpSection.astro";
import LatestWinners3 from "../components/LatestWinners3.astro";
import Faq3 from "../components/Faq3.astro";
import SmoothCarousel from "../components/SmoothCarousel.astro";
import ReviewCardSumo2 from "../components/ReviewCardSumo2.astro";
import Navfoot from "../components/Navfoot.astro";

import { Picture } from "astro:assets";
import { pageGraph } from "../lib/schema";

// Slides live only inside a ContentBoxSevenThree* block and there are at most
// two of those per rebrand — both are spent here.
//
// slide2 prints "ภารกิจประจำวัน / DAILY MISSIONS" with a four-item checklist and
// a รับฟรีสปิน 25 ครั้ง reward, i.e. the account doing the tracking for you,
// which is the "ระบบใหม่ช่วยให้เลือกเกมและจัดการบัญชีง่ายขึ้น" idea of docx H2-1.
// slide4 prints "LAVA HOUR 20:00 - 22:00 เปิดกล่องสุ่ม ลุ้น 18/88/188/432
// เครดิต" — one spread with several possible outcomes printed on it, which is
// the RTP/ความผันผวน section's own point in picture form.
// slide1 (เช็กอิน 7 วัน รับเครดิตสะสม 432 บาท) and slide3 (ชวนเพื่อนมันส์ รับ
// โบนัสคู่หู คนละ 50 บาท) stay unused here and keep rendering in SmoothCarousel
// and on /promotion.
//
// banner2.png is NOT imported anywhere: it predates this asset drop.
// banner1/banner1-mobile/og.png are the hero and the share card, and belong to
// MainLayout alone.
import imgDailyMissions from "../assets/slide2.png";
import imgLavaHour from "../assets/slide4.png";

const pageTitle = "LAVA432 | สล็อตเว็บใหญ่มั่นคง ระบบใหม่ฝากถอนออโต้ แตกง่ายจ่ายไว";
const pageHeading = "LAVA432 สล็อตเว็บใหญ่มั่นคง ระบบใหม่ฝากถอนออโต้ แตกง่ายจ่ายไว";

// The docx Main SEO Meta Description, verbatim at the length it was written
// (123 characters). DESC_MIN does not apply to the home page — verify-build.mjs
// exempts it precisely so the brand's own copy ships unpadded. Do not top it up
// to 150.
const pageDescription = "LAVA432 สล็อตเว็บใหญ่ระบบใหม่ ฝากถอนออโต้ รองรับมือถือ พร้อมเกมหลายแนว ระบบบัญชีใช้งานสะดวก และตรวจสอบสถานะรายการได้ง่าย";

// Byte-identical to AnnouncementPremium's own default, which is what every
// sub-page calling <Announcement /> bare lands on. Passing it explicitly here
// keeps the home page and the rest of the site from drifting apart silently. No
// leading emoji — the marquee renders the string twice.
const announcement =
  "LAVA432 สล็อตเว็บใหญ่ระบบใหม่ รวมเกมหลายรูปแบบไว้ในบัญชีเดียว เลือกหมวดเกม ดูโปรโมชั่น และตรวจข้อมูลบัญชีได้จากหน้าเดียวโดยไม่ต้องสลับหลายหน้า • ระบบฝากถอนออโต้จัดการได้จากหน้าบัญชีโดยตรง ก่อนยืนยันควรตรวจชื่อบัญชี จำนวนเงิน และข้อมูลรับเงินให้ครบถ้วน • หากรายการเดิมยังดำเนินการอยู่ ควรรอผลจากระบบก่อนส่งรายการใหม่ เพื่อป้องกันรายการซ้ำ • เลือกเกมจาก RTP ตารางจ่าย ฟีเจอร์โบนัส และระดับความผันผวนร่วมกัน แทนการดูจากคำว่าแตกง่ายเพียงอย่างเดียว • คำว่าแตกง่ายและมั่นคงเป็นถ้อยคำทางการตลาด ไม่ใช่การรับประกันผล กำหนดงบและเวลาไว้ก่อนเริ่มทุกครั้ง";

const altDailyMissions =
  "แบนเนอร์โปรโมชั่น LAVA432 ข้อความ ภารกิจประจำวัน พร้อมไอคอนเป้าธนูและกระดานเช็กลิสต์ ใต้ลงมาเป็นแผงหัวข้อ DAILY MISSIONS ไล่รายการ เข้าสู่ระบบ เดิมพันครบตามกำหนด เล่นเกมสล็อต และ ชวนเพื่อน โดยมีเครื่องหมายถูกสีแดงอยู่ท้ายทุกข้อ ถัดลงมาเขียนว่า ครบ 4 ภารกิจ รับฟรีสปิน 25 ครั้ง ทำครบ รับสิทธิ์ทันที และปุ่ม รับภารกิจ ด้านบนเป็นโลโก้ LAVA432 ตัวอักษรขาวและเลข 432 บนบล็อกสีแดง ข้างขวาเป็นผู้หญิงในชุดกีฬาสีดำ-แดงติดโลโก้ LAVA432 ขยิบตาและชี้นิ้วขึ้น ข้างหลังเป็นวงล้อสล็อตเลข 7 และช่อง BAR ด้านซ้ายล่างเป็นหีบสมบัติที่มีเหรียญทองและป้ายเลข 432 บนพื้นหลังสีดำแดงมีประกายไฟ";

const altLavaHour =
  "แบนเนอร์โปรโมชั่น LAVA432 ข้อความขนาดใหญ่ LAVA HOUR พร้อมไอคอนนาฬิกาและช่วงเวลา 20:00 - 22:00 ใต้ลงมาเขียนว่า เปิดกล่องสุ่ม ลุ้น 18 / 88 / 188 / 432 เครดิต และป้ายเล็กเขียนว่า ร่วมสนุกเฉพาะช่วงเวลาที่กำหนด พร้อมปุ่ม เปิดเลย ด้านบนเป็นโลโก้ LAVA432 ตัวอักษรขาวและเลข 432 บนบล็อกสีแดง ข้างหลังเป็นหน้าปัดนาฬิกาขนาดใหญ่และสายฟ้าสีแดง ข้างขวาเป็นผู้หญิงในเสื้อสีแดงติดโลโก้ LAVA432 ยกมือประกบแก้มทำท่าตกใจดีใจ ด้านล่างซ้ายเป็นกล่องสุ่มสีดำแดงมีเครื่องหมายคำถามและเหรียญทองกระจายรอบ ๆ บนพื้นหลังสีดำแดงมีประกายไฟ";

// The docx Q&A block, verbatim. Passed as an explicit prop rather than left to
// Faq3's own default, so the rendered markup and the FAQ JSON-LD below come out
// of the same array.
const faqs = [
  {
    q: "LAVA432 ระบบใหม่แตกต่างจากเว็บสล็อตทั่วไปอย่างไร?",
    a: "จุดที่ควรพิจารณาคือความสะดวกในการเลือกเกม การจัดการบัญชี ระบบฝากถอน และการตรวจสอบประวัติรายการ มากกว่าดูจากคำว่า “ระบบใหม่” เพียงอย่างเดียว",
  },
  {
    q: "LAVA432 ฝากถอนผ่านระบบออโต้หรือไม่?",
    a: "ระบบรองรับการจัดการฝากถอนแบบออโต้ตามช่องทางที่กำหนด สมาชิกควรตรวจข้อมูลบัญชี จำนวนเงิน และสถานะรายการก่อนและหลังยืนยันทุกครั้ง",
  },
  {
    q: "สล็อตแตกง่ายของ LAVA432 รับประกันกำไรหรือไม่?",
    a: "ไม่สามารถรับประกันผลลัพธ์หรือกำไรจากเกมสล็อตได้ ผู้เล่นควรดู RTP ความผันผวน กติกา และกำหนดงบที่เหมาะกับตนเองก่อนเริ่มเล่น",
  },
];

// Homepage: no breadcrumb — there is no trail above the root.
const graph = pageGraph(Astro, {
  name: pageHeading,
  description: pageDescription,
  faqs,
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement message={announcement} />

  <ContentBoxPremium as="h1" title={pageHeading}>
    <p class="text-left text-base leading-relaxed text-[#f4e3e0]">
      <strong class="text-[#ff6a13]">LAVA432</strong> เป็นแพลตฟอร์มสล็อตออนไลน์ที่เน้นระบบใช้งานแบบใหม่และการรวมเกมหลายรูปแบบไว้ในบัญชีเดียว พร้อมระบบฝากถอนออโต้และหน้าตรวจสอบธุรกรรม
      รองรับทั้งมือถือและคอมพิวเตอร์ ผู้เล่นสามารถเลือกเกม ดูโปรโมชั่น และติดตามสถานะรายการได้สะดวก โดยควรศึกษากติกาและเงื่อนไขต่าง ๆ ก่อนเริ่มทุกครั้ง
    </p>
  </ContentBoxPremium>

  <ContentBoxSevenThreePremium title="ระบบใหม่ของ LAVA432 ช่วยให้เลือกเกมและจัดการบัญชีง่ายขึ้น">
    <Picture
      slot="left"
      src={imgDailyMissions}
      loading="lazy"
      fetchpriority="low"
      widths={[300, 450, 600]}
      sizes="(max-width: 768px) calc(100vw - 6rem), 380px"
      decoding="async"
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      quality={80}
      alt={altDailyMissions}
      class="mx-auto h-auto w-full rounded-2xl border border-[#ec000e]/40 shadow-[0_10px_30px_rgba(236,0,14,0.3)]"
    />
    <p slot="right" class="text-left text-base leading-relaxed text-[#f4e3e0]">
      การออกแบบระบบของ LAVA432 ควรช่วยให้ผู้เล่นเข้าถึงหมวดเกม โปรโมชั่น และข้อมูลบัญชีได้โดยไม่ต้องสลับหลายหน้า เมนูที่ชัดเจนและประวัติรายการที่ตรวจสอบได้ช่วยลดความสับสนระหว่างใช้งาน
      โดยเฉพาะผู้ที่เล่นผ่านมือถือเป็นหลัก
    </p>
  </ContentBoxSevenThreePremium>

  <ContentBoxCyberCut as="h2" title="เว็บสล็อตขนาดใหญ่ควรมีมากกว่าแค่จำนวนเกมเยอะ">
    <p class="text-left text-base leading-relaxed text-[#f4e3e0]">
      คำว่าเว็บใหญ่ไม่ควรหมายถึงจำนวนเกมเพียงอย่างเดียว แต่ควรรวมถึงความเสถียรของระบบ การจัดหมวดเกม ข้อมูลค่ายเกม และการจัดการบัญชีที่เป็นระบบ ผู้เล่นควรดูองค์ประกอบเหล่านี้ร่วมกันก่อนตัดสินใจ
      ไม่ควรเลือกจากคำโปรโมตเพียงอย่างเดียว
    </p>
  </ContentBoxCyberCut>

  <ProviderGrid />

  <ContentBoxSpecial as="h2" title="ฝากถอนออโต้บน LAVA432 ช่วยลดขั้นตอนธุรกรรม" iconleft="🏧" iconright="🧾">
    <div slot="left" class="flex flex-col gap-3">
      <p class="text-left text-base leading-relaxed text-[#f4e3e0]">
        สมาชิก LAVA432 สามารถจัดการฝาก ถอน และตรวจสอบสถานะรายการผ่านระบบเดียว ก่อนยืนยันควรตรวจชื่อบัญชี จำนวนเงิน และข้อมูลรับเงินให้ถูกต้อง
      </p>
      <p class="flex items-center gap-2 text-xs font-black tracking-widest text-[#ff6a13] uppercase">
        <span aria-hidden="true">✅</span>
        ตรวจให้ครบก่อนกดยืนยัน
      </p>
    </div>

    <div slot="right" class="flex flex-col gap-3">
      <p class="text-left text-base leading-relaxed text-[#f4e3e0]">
        หากรายการเดิมยังดำเนินการอยู่ควรรอผลจากระบบก่อนส่งใหม่ เพื่อป้องกันรายการซ้ำ ทุกรายการมีเวลาและเลขอ้างอิงของตัวเองแยกจากกัน จึงเปิดย้อนดูจากประวัติธุรกรรมได้เสมอ
      </p>
      <p class="flex items-center gap-2 text-xs font-black tracking-widest text-[#ff6a13] uppercase">
        <span aria-hidden="true">⏳</span>
        รอผลจากระบบก่อนส่งรายการใหม่
      </p>
    </div>
  </ContentBoxSpecial>

  <ContentBoxSevenThreeCyberCut titleright="เลือกสล็อตจาก RTP ฟีเจอร์ และความผันผวนให้เหมาะกับงบ">
    <Picture
      slot="left"
      src={imgLavaHour}
      loading="lazy"
      fetchpriority="low"
      widths={[300, 450, 600]}
      sizes="(max-width: 768px) calc(100vw - 6rem), 380px"
      decoding="async"
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      quality={80}
      alt={altLavaHour}
      class="mx-auto h-auto w-full rounded-2xl border border-[#ec000e]/40 shadow-[0_10px_30px_rgba(236,0,14,0.3)]"
    />
    <p slot="right" class="text-left text-base leading-relaxed text-[#f4e3e0]">
      แทนที่จะมองหาเกมจากคำว่าแตกง่ายอย่างเดียว ผู้เล่นควรพิจารณา RTP ที่ผู้ให้บริการระบุ ตารางจ่าย ฟีเจอร์โบนัส และระดับความผันผวนของเกมร่วมกัน
      ข้อมูลเหล่านี้ช่วยให้เข้าใจลักษณะของเกมและเลือกวงเงินต่อรอบได้เหมาะสมมากขึ้น
    </p>
  </ContentBoxSevenThreeCyberCut>

  <LoginRtpSection />

  <ContentBoxTwo as="h2" titleleft="ตรวจสถานะจ่ายไวผ่านหน้าบัญชีของ LAVA432" iconleft="🕘">
    <p slot="left" class="text-left text-base leading-relaxed text-[#f4e3e0]">
      สมาชิก LAVA432 ควรใช้ประวัติธุรกรรมและสถานะรายการในหน้าบัญชีเป็นจุดหลักในการติดตามยอดถอน หากรายการยังอยู่ระหว่างดำเนินการควรเก็บเวลา จำนวนเงิน และเลขอ้างอิงไว้จนกว่าระบบจะอัปเดตผล
      เพื่อช่วยให้ตรวจสอบย้อนหลังได้ง่ายขึ้น
    </p>

    <div slot="right" class="flex flex-col gap-3 rounded-2xl border border-[#ec000e]/35 bg-[#120303]/75 p-5">
      <p class="flex items-center gap-2 text-sm font-black tracking-widest text-[#ff6a13] uppercase">
        <span aria-hidden="true">🧾</span>
        สี่อย่างที่ควรเก็บไว้ระหว่างรอผลรายการ
      </p>
      <span class="flex items-start gap-2.5 text-sm text-[#f4e3e0]">
        <span aria-hidden="true" class="mt-0.5 shrink-0 text-[#ffa040]">①</span>
        เวลาที่ส่งรายการ เพื่อใช้เทียบกับสถานะที่ระบบอัปเดตให้
      </span>
      <span class="flex items-start gap-2.5 text-sm text-[#f4e3e0]">
        <span aria-hidden="true" class="mt-0.5 shrink-0 text-[#ffa040]">②</span>
        จำนวนเงินของรายการนั้น แยกจากรายการอื่นในวันเดียวกัน
      </span>
      <span class="flex items-start gap-2.5 text-sm text-[#f4e3e0]">
        <span aria-hidden="true" class="mt-0.5 shrink-0 text-[#ffa040]">③</span>
        เลขอ้างอิงที่ระบบออกให้ ซึ่งใช้ค้นย้อนหลังได้ตรงที่สุด
      </span>
      <span class="flex items-start gap-2.5 text-sm text-[#f4e3e0]">
        <span aria-hidden="true" class="mt-0.5 shrink-0 text-[#ffa040]">④</span>
        สถานะล่าสุดที่หน้าบัญชีแสดง ก่อนจะส่งรายการใหม่ซ้ำ
      </span>
      <span class="mt-1 rounded-xl border border-[#ff6a13]/35 bg-[#2a0808]/80 px-4 py-2.5 text-xs leading-relaxed text-[#c9a8a4]">
        ประวัติธุรกรรมคือจุดที่เห็นความคืบหน้าของยอดถอนได้เร็วที่สุด เพราะทุกรายการมีเวลาและเลขอ้างอิงของตัวเองแยกจากกัน จึงเทียบย้อนหลังได้ทีละรายการ
      </span>
    </div>
  </ContentBoxTwo>

  <LatestWinners3 />

  <ContentBox as="h2" title="คำว่าแตกง่ายและมั่นคงควรดูจากข้อมูลจริงของ LAVA432">
    <p class="text-left text-base leading-relaxed text-[#f4e3e0]">
      ข้อความแตกง่ายหรือมั่นคงของ LAVA432 เป็นคำทางการตลาด ไม่สามารถใช้รับประกันผลของเกมหรือความสำเร็จของทุกธุรกรรมได้ ผู้เล่นควรดูข้อมูลเกม ระบบบัญชี เงื่อนไขถอน และช่องทางติดต่อประกอบ
      พร้อมกำหนดงบก่อนเริ่มเล่นทุกครั้ง
    </p>
  </ContentBox>

  <Faq3 title="คำถามที่พบบ่อยเกี่ยวกับ LAVA432" faqs={faqs} />

  <div class="relative z-10 mx-auto mb-10 flex flex-nowrap justify-center gap-3 px-4 sm:gap-6">
    <a
      href="/login"
