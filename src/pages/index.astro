---
import MainLayout from "../layouts/MainLayout.astro";
import Announcement from "../components/AnnouncementPremium.astro";
import ContentBoxCyberCut from "../components/ContentBoxCyberCut.astro";
import ContentBoxSevenThreePremium from "../components/ContentBoxSevenThreePremium.astro";
import ContentBoxTwoPremium from "../components/ContentBoxTwoPremium.astro";
import ContentBoxSevenThreeCyberCut from "../components/ContentBoxSevenThreeCyberCut.astro";
import ContentBoxSpecial from "../components/ContentBoxSpecial.astro";
import ContentBox3ThreePremium from "../components/ContentBox3ThreePremium.astro";
import ContentBoxPremium from "../components/ContentBoxPremium.astro";
import ProviderGrid from "../components/ProviderGridPremium.astro";
import LatestWinners from "../components/LatestWinners2.astro";
import LoginRtpSection from "../components/LoginRtpSection.astro";
import Faq from "../components/Faq3.astro";
import SmoothCarousel from "../components/SmoothCarousel.astro";
import ReviewCardSumo2 from "../components/ReviewCardSumo2.astro";
import Navfoot from "../components/Navfoot.astro";

import { Picture } from "astro:assets";
import { pageGraph } from "../lib/schema";

// Slides live only inside a ContentBoxSevenThree* block and there are at most
// two of those per rebrand — both are spent here.
//
// slide4 prints "วงล้อโชคดี" with a wheel of eight different prize amounts,
// i.e. "one spread, many options to pick from", which is the หลายรูปแบบให้เลือก
// idea of docx H2-2; slide2 prints "ฝากครั้งแรก รับเพิ่ม 20% / ฝาก-ถอนออโต้",
// which is exactly what the H2-4 ฝากถอน section is about.
// slide1 (สมาชิกใหม่ รับโบนัส 50%) and slide3 (นาทีทอง 21:00 - 23:00) stay
// unused here and keep rendering in SmoothCarousel and on /promotion.
//
// banner2.png is NOT imported anywhere: it predates this asset drop.
// banner1/banner1-mobile/og.png are the hero and the share card, and belong to
// MainLayout alone.
import imgPrizeWheel from "../assets/slide4.png";
import imgFirstDeposit from "../assets/slide2.png";

const pageTitle = "VEGUS1 | เว็บพนันออนไลน์ครบวงจร ฝากถอนง่ายรับ true wallet มั่นคง";
const pageHeading = "VEGUS1 เว็บพนันออนไลน์ครบวงจร ฝากถอนง่ายรับ true wallet มั่นคง";

// The docx Main SEO Meta Description, verbatim at the length it was written
// (127 characters). DESC_MIN does not apply to the home page — verify-build.mjs
// exempts it precisely so the brand's own copy ships unpadded. Do not top it up
// to 150.
const pageDescription = "VEGUS1 เว็บพนันออนไลน์ครบวงจร ฝากถอนผ่าน True Wallet รองรับมือถือ ใช้งานสะดวก พร้อมเกมหลายประเภทและระบบตรวจสอบรายการเป็นขั้นตอน";

// The ticker default in AnnouncementPremium is what sub-pages get; the home page
// always passes its own copy so the two never drift apart silently. No leading
// emoji — the marquee renders the string twice.
const announcement =
  "VEGUS1 รวมเกมเดิมพันหลายประเภทไว้ในบัญชีเดียว ตั้งแต่สล็อต บาคาร่า ไปจนถึงเกมรูปแบบอื่นที่ระบบรองรับ ควรเปรียบเทียบกติกา อัตราจ่าย และระดับความเสี่ยงของแต่ละประเภทก่อนเริ่ม • รองรับฝากถอนผ่าน True Wallet ผ่านโทรศัพท์มือถือ ก่อนยืนยันควรตรวจข้อมูลบัญชี จำนวนเงิน และช่องทางรับเงินให้ถูกต้องทุกครั้ง • จัดการรายการฝากถอนได้จากหน้าบัญชีโดยตรง หากรายการยังอยู่ระหว่างดำเนินการควรรอผลจากระบบก่อนส่งคำขอซ้ำ เพื่อไม่ให้เกิดรายการซ้อนกัน • คำว่ามั่นคงควรดูจากขั้นตอนใช้งาน ประวัติธุรกรรม ช่องทางติดต่อ และการดูแลข้อมูลบัญชีร่วมกัน • กำหนดวงเงินและระยะเวลาไว้ก่อนเริ่มเดิมพันทุกครั้ง";

const altPrizeWheel =
  "แบนเนอร์โปรโมชั่น VEGUS1 ข้อความ วงล้อโชคดี ลุ้นเครดิตฟรี 888 บาท หมุนฟรีทุกวัน ลุ้นรับทันที และปุ่ม หมุนเลย ด้านซ้ายบนเป็นโลโก้ Vegus1 ภาพวงล้อเสี่ยงโชคสีแดง-ทองแบ่งช่องเป็นเงินรางวัล 500 888 188 288 80 100 50 และ 300 บาท มีคำว่า ลุ้นเลย ตรงดุมวงล้อ ข้างขวาเป็นผู้หญิงในชุดผ้าซาตินสีแดง-ทอง ตู้สล็อต JACKPOT 777 กองเหรียญทองและชิปคาสิโนบนพื้นหลังสีแดงเข้ม";

const altFirstDeposit =
  "แบนเนอร์โปรโมชั่น VEGUS1 ข้อความ ฝากครั้งแรก รับเพิ่ม 20% คุ้มตั้งแต่ฝากแรก ฝาก-ถอนออโต้ รวดเร็ว ปลอดภัย และปุ่ม ฝากเลย ด้านซ้ายบนเป็นโลโก้ Vegus1 ภาพผู้หญิงในชุดผ้าซาตินสีแดง-ทอง ข้างหลังเป็นตู้สล็อต JACKPOT 777 ไพ่เอซ กองเหรียญทอง และชิปคาสิโนสีแดง-ทองบนพื้นหลังสีแดงเข้ม";

// The docx Q&A block, verbatim. Passed as an explicit prop rather than left to
// Faq3's own default, so the rendered markup and the FAQ JSON-LD below come out
// of the same array.
const faqs = [
  {
    q: "VEGUS1 รองรับการเดิมพันประเภทใดบ้าง?",
    a: "ระบบสามารถรวมเกมเดิมพันหลายประเภทตามหมวดที่เว็บไซต์กำหนด ผู้เล่นควรตรวจสอบกติกา อัตราจ่าย และระดับความเสี่ยงของเกมที่สนใจก่อนเริ่มทุกครั้ง",
  },
  {
    q: "VEGUS1 รองรับ True Wallet หรือไม่?",
    a: "รองรับ True Wallet ตามช่องทางที่ระบบกำหนด สมาชิกควรตรวจสอบข้อมูลบัญชี จำนวนเงิน และสถานะรายการให้ครบก่อนและหลังยืนยันธุรกรรม",
  },
  {
    q: "คำว่ามั่นคงหมายถึงรับประกันความปลอดภัยทุกกรณีหรือไม่?",
    a: "ไม่ควรตีความว่าเป็นการรับประกันทั้งหมด ความปลอดภัยยังขึ้นอยู่กับระบบ เว็บไซต์ และพฤติกรรมของผู้ใช้ จึงควรตรวจสอบข้อมูลและดูแลบัญชีของตนเองร่วมด้วย",
  },
];

// Homepage: no breadcrumb — there is no trail above the root.
const graph = pageGraph(Astro, {
  name: pageHeading,
  description: pageDescription,
  faqs,
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement message={announcement} />

  <ContentBoxCyberCut as="h1" title={pageHeading}>
    <p class="text-left text-base leading-relaxed text-[#f7e3c8]">
      <strong class="text-[#f5c451]">VEGUS1</strong> เป็นแพลตฟอร์มเดิมพันออนไลน์ที่รวมเกมหลายประเภทไว้ในบัญชีเดียว พร้อมช่องทางฝากถอนผ่าน True Wallet และระบบสำหรับตรวจสอบรายการ รองรับการใช้งานทั้งมือถือและคอมพิวเตอร์
      สมาชิกสามารถเลือกเกม ดูโปรโมชั่น และจัดการข้อมูลบัญชีได้สะดวก โดยควรศึกษากติกา อัตราจ่าย และเงื่อนไขก่อนเริ่มเดิมพันทุกครั้ง
    </p>
  </ContentBoxCyberCut>

  <ContentBoxSevenThreePremium titleright="รวมการเดิมพันหลายรูปแบบไว้ให้เลือกบน VEGUS1">
    <Picture
      slot="left"
      src={imgPrizeWheel}
      loading="lazy"
      fetchpriority="low"
      widths={[300, 450, 600]}
      sizes="(max-width: 768px) calc(100vw - 6rem), 380px"
      decoding="async"
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      quality={80}
      alt={altPrizeWheel}
      class="mx-auto h-auto w-full rounded-2xl border border-[#f5c451]/40 shadow-[0_10px_30px_rgba(216,31,38,0.3)]"
    />
    <p slot="right" class="text-left text-base leading-relaxed text-[#f7e3c8]">
      ภายใน VEGUS1 สามารถจัดหมวดเกมเดิมพันหลายประเภทไว้ให้เลือกตามความสนใจ ตั้งแต่สล็อต บาคาร่า ไปจนถึงเกมรูปแบบอื่นที่ระบบรองรับ ผู้เล่นควรเปรียบเทียบกติกา อัตราจ่าย
      และระดับความเสี่ยงของแต่ละประเภทก่อนเริ่ม เพื่อเลือกเกมให้เหมาะกับงบและสไตล์ของตนเอง
    </p>
  </ContentBoxSevenThreePremium>

  <ProviderGrid />

  <ContentBoxTwoPremium as="h2" title="True Wallet ช่วยให้จัดการเงินผ่านมือถือได้คล่องตัว">
    <p slot="left" class="text-left text-base leading-relaxed text-[#f7e3c8]">
      การรองรับ True Wallet ช่วยลดขั้นตอนในการฝากและถอนผ่านโทรศัพท์มือถือ ก่อนยืนยันควรตรวจสอบข้อมูลบัญชี จำนวนเงิน และช่องทางรับเงินให้ถูกต้อง รวมถึงรอให้ระบบแสดงสถานะสำเร็จก่อนทำรายการใหม่
      เพื่อช่วยลดความผิดพลาดในการตรวจสอบย้อนหลัง
    </p>

    <div slot="right" class="flex flex-col gap-3 rounded-2xl border border-[#d81f26]/35 bg-[#150404]/75 p-5">
      <p class="flex items-center gap-2 text-sm font-black tracking-widest text-[#f5c451] uppercase">
        <span aria-hidden="true">🎯</span>
        สี่จุดที่ควรตรวจก่อนกดยืนยันรายการ
      </p>
      <span class="flex items-start gap-2.5 text-sm text-[#f7e3c8]">
        <span aria-hidden="true" class="mt-0.5 shrink-0 text-[#ffe08a]">①</span>
        ตรวจข้อมูลบัญชีที่ผูกไว้กับ True Wallet ให้ตรงกับที่ใช้งานอยู่จริง
      </span>
      <span class="flex items-start gap-2.5 text-sm text-[#f7e3c8]">
        <span aria-hidden="true" class="mt-0.5 shrink-0 text-[#ffe08a]">②</span>
        ตรวจจำนวนเงินที่กรอกอีกครั้งก่อนกดยืนยัน ไม่ว่าจะเป็นรายการฝากหรือถอน
      </span>
      <span class="flex items-start gap-2.5 text-sm text-[#f7e3c8]">
        <span aria-hidden="true" class="mt-0.5 shrink-0 text-[#ffe08a]">③</span>
        ตรวจช่องทางรับเงินให้ถูกต้องตามที่ตั้งใจไว้ก่อนส่งรายการ
      </span>
      <span class="flex items-start gap-2.5 text-sm text-[#f7e3c8]">
        <span aria-hidden="true" class="mt-0.5 shrink-0 text-[#ffe08a]">④</span>
        รอให้ระบบแสดงสถานะสำเร็จก่อน แล้วค่อยเริ่มทำรายการใหม่
      </span>
      <span class="mt-1 rounded-xl border border-[#f5c451]/35 bg-[#2b0808]/80 px-4 py-2.5 text-xs leading-relaxed text-[#d8b48f]">
        การรอสถานะจากระบบก่อนเริ่มรายการถัดไปคือสิ่งที่ช่วยลดความผิดพลาดในการตรวจสอบย้อนหลังได้มากที่สุด เพราะทุกรายการจะมีเลขอ้างอิงของตัวเองแยกจากกัน
      </span>
    </div>
  </ContentBoxTwoPremium>

  <ContentBoxSevenThreeCyberCut titleright="ฝากถอนกับ VEGUS1 ควรตรวจรายละเอียดก่อนยืนยัน">
    <Picture
      slot="left"
      src={imgFirstDeposit}
      loading="lazy"
      fetchpriority="low"
      widths={[300, 450, 600]}
      sizes="(max-width: 768px) calc(100vw - 6rem), 380px"
      decoding="async"
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      quality={80}
      alt={altFirstDeposit}
      class="mx-auto h-auto w-full rounded-2xl border border-[#f5c451]/40 shadow-[0_10px_30px_rgba(216,31,38,0.3)]"
    />
    <p slot="right" class="text-left text-base leading-relaxed text-[#f7e3c8]">
      สมาชิก VEGUS1 สามารถจัดการรายการฝากถอนผ่านหน้าบัญชีได้โดยตรง ก่อนยืนยันควรดูยอดคงเหลือ ข้อมูลรับเงิน และเงื่อนไขโปรโมชั่นให้ครบ หากรายการยังอยู่ระหว่างดำเนินการควรรอผลจากระบบก่อนส่งคำขอซ้ำ
      เพื่อไม่ให้เกิดรายการซ้อนกัน
    </p>
  </ContentBoxSevenThreeCyberCut>

  <ContentBoxSpecial as="h2" title="เว็บครบวงจรช่วยลดการสลับหลายระบบระหว่างใช้งาน" iconleft="🗂️" iconright="🔍">
    <div slot="left">
      <p class="text-left text-base leading-relaxed text-[#f7e3c8]">การมีทั้งเกม บัญชี โปรโมชั่น และข้อมูลธุรกรรมอยู่ในแพลตฟอร์มเดียวช่วยให้สมาชิกติดตามการใช้งานได้ง่ายขึ้น</p>
    </div>

    <div slot="right">
      <p class="text-left text-base leading-relaxed text-[#f7e3c8]">อย่างไรก็ตาม ควรตรวจสอบข้อมูลของแต่ละเกมแยกกัน เพราะกติกา อัตราจ่าย และความเสี่ยงอาจแตกต่างกัน แม้จะอยู่ภายในระบบเดียวกันก็ตาม</p>
    </div>
  </ContentBoxSpecial>

  <ContentBox3ThreePremium as="h2" title="ความมั่นคงของ VEGUS1 ควรดูจากระบบที่ตรวจสอบได้">
    <p slot="left" class="text-left text-base leading-relaxed text-[#f7e3c8]">การประเมิน VEGUS1 ควรพิจารณาจากความชัดเจนของขั้นตอนใช้งาน ประวัติธุรกรรม ช่องทางติดต่อ และการดูแลข้อมูลบัญชีร่วมกัน</p>
    <p slot="center" class="text-left text-base leading-relaxed text-[#f7e3c8]">ผู้ใช้ควรตั้งรหัสผ่านที่รัดกุม ไม่เปิดเผยรหัสยืนยัน</p>
    <p slot="right" class="text-left text-base leading-relaxed text-[#f7e3c8]">และเข้าเว็บไซต์ผ่านช่องทางหลักทุกครั้ง</p>
  </ContentBox3ThreePremium>

  <LatestWinners />

  <ContentBoxPremium as="h2" title="วางงบก่อนใช้งาน VEGUS1 เพื่อควบคุมการเดิมพันได้ง่ายขึ้น">
    <p class="text-left text-base leading-relaxed text-[#f7e3c8]">
      ผู้ใช้ VEGUS1 ควรกำหนดวงเงินและระยะเวลาไว้ก่อนเริ่มเดิมพัน เลือกเกมที่เข้าใจกติกา และหยุดเมื่อถึงขีดจำกัดที่ตั้งไว้ ไม่ควรเพิ่มเงินเพื่อหวังตามคืนยอดเสีย
      เพราะผลของเกมมีความไม่แน่นอนและไม่สามารถรับประกันกำไรได้
    </p>
  </ContentBoxPremium>

  <LoginRtpSection />

  <Faq title="คำถามที่พบบ่อยเกี่ยวกับ VEGUS1" faqs={faqs} />

  <div class="relative z-10 mx-auto mb-10 flex flex-nowrap justify-center gap-3 px-4 sm:gap-6">
    <a
      href="/login"
      class="group relative flex flex-1 items-center justify-center rounded-full border-2 border-[#f5c451]/60 bg-gradient-to-r from-[#d81f26] via-[#6d0d10] to-[#150404] px-4 py-3 text-sm font-black whitespace-nowrap text-[#f7e3c8] shadow-[0_10px_30px_rgba(216,31,38,0.38)] transition-all duration-300 hover:-translate-y-1 hover:scale-105 hover:border-[#f5c451] hover:shadow-[0_15px_40px_rgba(245,196,81,0.42)] sm:flex-none sm:px-10 sm:py-3.5 sm:text-base">
      เข้าสู่ระบบ
    </a>

    <a
      href="/register"
      class="group relative flex flex-1 items-center justify-center rounded-full border-2 border-[#ffe08a]/70 bg-gradient-to-r from-[#ffe08a] via-[#f5c451] to-[#c9931a] px-4 py-3 text-sm font-black whitespace-nowrap text-[#2a0606] shadow-[0_10px_30px_rgba(245,196,81,0.35)] transition-all duration-300 hover:-translate-y-1 hover:scale-105 hover:border-[#ffe08a] hover:shadow-[0_15px_40px_rgba(245,196,81,0.5)] sm:flex-none sm:px-10 sm:py-3.5 sm:text-base">
      สมัครสมาชิก
    </a>
  </div>

  <SmoothCarousel />

  <ReviewCardSumo2 />

  <Navfoot />
</MainLayout>
