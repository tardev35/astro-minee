---
import MainLayout from "../layouts/MainLayout.astro";
import Announcement from "../components/AnnouncementCyber.astro";
import ContentBox from "../components/ContentBox.astro";
import ContentBoxCyberCut from "../components/ContentBoxCyberCut.astro";
import ContentBoxFloatingBadge from "../components/ContentBoxFloatingBadge.astro";
import ContentBoxSevenThreeCyberCut from "../components/ContentBoxSevenThreeCyberCut.astro";
import ContentBoxSevenThreeFloatingBadge from "../components/ContentBoxSevenThreeFloatingBadge.astro";
import LoginRtpSection from "../components/LoginRtpSection.astro";
import ProviderGrid from "../components/ProviderGridPremium.astro";
import GameRankingBoard from "../components/GameRankingBoard.astro";
import ReviewCardSumo2 from "../components/ReviewCardSumo2.astro";
import LatestWinners from "../components/LatestWinnersCyber.astro";
import SmoothCarousel from "../components/SmoothCarousel.astro";
import Faq from "../components/Faq2.astro";
import Navfoot from "../components/Navfoot.astro";

import { Picture } from "astro:assets";
import { pageGraph } from "../lib/schema";
// slide1 illustrates the ระบบออโต้ section (it reads เริ่มสนุกได้ทันที over a
// ฝากถอนออโต้ badge strip); slide3 the ตรวจสอบยอดจ่าย section (คืนยอดเสียทุกวัน
// 10% สูงสุด 5,000 บาท — a payout/amount image). Slides may only live inside a
// ContentBoxSevenThree* block, max two per rebrand; slide2 and slide4 go unused
// here and keep rendering in SmoothCarousel and on /promotion.
import imgAutoSystem from "../assets/slide1.png";
import imgPayout from "../assets/slide3.png";

const pageTitle = "KOHKAE789 | บาคาร่าออโต้ แตกง่าย มั่นคง ไม่ผ่านเอเย่นต์ จ่ายไว";

// 156 characters. verify-build.mjs errors outside 150–160 CHARACTERS, and the
// docx-supplied description is 133 — the trailing clause closes that gap
// without changing what the brief says.
const pageDescription =
  "KOHKAE789 บาคาร่าเว็บตรงระบบออโต้ ไม่ผ่านเอเย่นต์ ฝากถอนไว รองรับมือถือ ใช้งานมั่นคง พร้อมโต๊ะเกมหลากหลายและบริการสมาชิกตลอด 24 ชั่วโมง ควรอ่านกติกาก่อนเล่น";

const faqs = [
  {
    q: "KOHKAE789 เป็นบาคาร่าเว็บตรงไม่ผ่านเอเย่นต์อย่างไร?",
    a: "สมาชิกสามารถเข้าสู่ระบบ เลือกโต๊ะบาคาร่า และจัดการธุรกรรมผ่านบัญชีของตนเองโดยตรง ควรตรวจสอบช่องทางเข้าให้ถูกต้องก่อนกรอกข้อมูลทุกครั้ง",
  },
  {
    q: "ระบบออโต้ของ KOHKAE789 ช่วยเรื่องอะไร?",
    a: "ระบบออโต้ช่วยลดขั้นตอนการฝาก ถอน และตรวจสอบสถานะธุรกรรม ทำให้สมาชิกจัดการรายการจากหน้าบัญชีได้โดยไม่ต้องส่งข้อมูลหลายรอบ",
  },
  {
    q: "บาคาร่าแตกง่ายสามารถรับประกันผลกำไรได้หรือไม่?",
    a: "ไม่สามารถรับประกันผลหรือกำไรจากบาคาร่าได้ เพราะผลแต่ละรอบมีความไม่แน่นอน ผู้เล่นควรเข้าใจกติกา กำหนดงบประมาณ และหลีกเลี่ยงการไล่ตามผลเสีย",
  },
];

const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  faqs,
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement
    message="KOHKAE789 บาคาร่าเว็บตรงระบบออโต้ ไม่ผ่านเอเย่นต์ เลือกโต๊ะ ตรวจยอด และจัดการธุรกรรมได้จากบัญชีเดียว • ระบบออโต้ช่วยลดขั้นตอนฝากถอน ควรตรวจชื่อบัญชีและจำนวนเงินก่อนยืนยันทุกครั้ง • ผลบาคาร่าแต่ละรอบไม่สามารถรับประกันได้ ควรศึกษากติกา Banker Player และ Tie พร้อมกำหนดงบประมาณก่อนเริ่มเล่น • ทีมงานดูแลสมาชิกตลอด 24 ชั่วโมง"
  />

  <ContentBoxCyberCut as="h1" title="KOHKAE789 บาคาร่าออโต้ แตกง่าย มั่นคง ไม่ผ่านเอเย่นต์ จ่ายไว">
    <p class="text-left text-base leading-relaxed text-[#cfe6f7]">
      <strong class="text-[#7fdcff]">KOHKAE789</strong> เป็นแพลตฟอร์มบาคาร่าออนไลน์ที่เน้นการใช้งานผ่านระบบตรงและระบบออโต้ สมาชิกสามารถเลือกโต๊ะเกม ตรวจสอบยอด และจัดการธุรกรรมจากบัญชีเดียวโดยไม่ต้องผ่านตัวแทน
      รองรับทั้งมือถือและคอมพิวเตอร์ ก่อนเริ่มควรทำความเข้าใจกติกา รูปแบบเดิมพัน และกำหนดงบประมาณให้เหมาะกับตนเอง
    </p>
  </ContentBoxCyberCut>

  <ContentBox as="h2" title="เลือกโต๊ะบาคาร่าให้เข้ากับสไตล์บน KOHKAE789">
    <p class="text-left text-base leading-relaxed text-[#cfe6f7]">
      ภายใน KOHKAE789 มีโต๊ะบาคาร่าและรูปแบบการเดิมพันให้เลือกหลายระดับ ผู้เล่นควรพิจารณาวงเงินขั้นต่ำ ความเร็วของแต่ละรอบ และกติกาของโต๊ะก่อนเข้าเล่น
      การเลือกโต๊ะที่สอดคล้องกับงบประมาณช่วยให้ควบคุมจำนวนเดิมพันและวางแผนการเล่นได้เป็นระบบมากขึ้น
    </p>
  </ContentBox>

  <ProviderGrid />

  <GameRankingBoard />

  <ContentBoxSevenThreeCyberCut titleright="ทำรายการได้คล่องตัวด้วยระบบออโต้">
    <Picture
      slot="left"
      src={imgAutoSystem}
      loading="lazy"
      fetchpriority="low"
      widths={[300, 450, 600]}
      sizes="(max-width: 768px) calc(100vw - 4rem), 355px"
      decoding="async"
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      quality={80}
      alt="แบนเนอร์โปรโมชั่น KOHKAE789 ข้อความ สมาชิกใหม่ รับโบนัส 100% เริ่มสนุกได้ทันที พร้อมแถบด้านล่าง มั่นคงปลอดภัย ฝากถอนออโต้ รองรับมือถือ และบริการ 24 ชม."
      class="mx-auto h-auto w-full rounded-2xl border border-[#29abe3]/35 shadow-[0_10px_30px_rgba(41,171,227,0.22)]"
    />
    <p slot="right" class="text-left text-base leading-relaxed text-[#cfe6f7]">
      ระบบออโต้ช่วยลดขั้นตอนระหว่างการฝาก ถอน และตรวจสอบสถานะรายการ สมาชิกควรตรวจสอบชื่อบัญชี จำนวนเงิน และข้อมูลทุกครั้งก่อนยืนยัน หากธุรกรรมยังอยู่ระหว่างดำเนินการควรรอผลจากระบบแทนการส่งรายการซ้ำ
      เพื่อป้องกันความสับสนในการตรวจสอบภายหลัง
    </p>
  </ContentBoxSevenThreeCyberCut>

  <ContentBoxFloatingBadge as="h2" title="ไม่ผ่านเอเย่นต์ เข้าถึงระบบ KOHKAE789 ได้โดยตรง">
    <p class="text-left text-base leading-relaxed text-[#cfe6f7]">
      การใช้งาน KOHKAE789 ผ่านช่องทางตรงช่วยให้สมาชิกจัดการบัญชี เลือกเกม และตรวจสอบธุรกรรมได้ด้วยตนเอง โดยไม่ต้องส่งข้อมูลส่วนตัวผ่านตัวแทน ควรตรวจสอบชื่อโดเมนก่อนเข้าสู่ระบบ
      และหลีกเลี่ยงการกรอกรหัสผ่านผ่านลิงก์ที่ไม่สามารถยืนยันแหล่งที่มาได้
    </p>
  </ContentBoxFloatingBadge>

  <ContentBox as="h2" title="ทำความเข้าใจบาคาร่าแทนการมองเพียงคำว่าแตกง่าย">
    <p class="text-left text-base leading-relaxed text-[#cfe6f7]">
      ผลบาคาร่าในแต่ละรอบไม่สามารถรับประกันได้ แม้คำว่าแตกง่ายจะถูกใช้เพื่อสื่อถึงโอกาสลุ้นผลตอบแทน ผู้เล่นควรให้ความสำคัญกับกติกา Banker, Player และ Tie รวมถึงอัตราจ่ายของแต่ละตัวเลือก
      พร้อมกำหนดวงเงินสูงสุดก่อนเล่นแทนการเพิ่มเดิมพันเพื่อตามผลรอบก่อนหน้า
    </p>
  </ContentBox>

  <ContentBoxCyberCut as="h2" title="ความมั่นคงของบัญชีเริ่มต้นที่ KOHKAE789 และผู้ใช้งาน">
    <p class="text-left text-base leading-relaxed text-[#cfe6f7]">
      KOHKAE789 ควรใช้งานผ่านทางเข้าหลักร่วมกับการตั้งรหัสผ่านที่คาดเดายากและไม่ซ้ำกับบริการอื่น สมาชิกไม่ควรส่ง OTP หรือรหัสยืนยันให้บุคคลใด และควรออกจากระบบเมื่อใช้อุปกรณ์ร่วมกับผู้อื่น
      โดยเฉพาะเมื่อต้องตรวจสอบยอดหรือดำเนินธุรกรรมทางการเงิน
    </p>
  </ContentBoxCyberCut>

  <ContentBoxSevenThreeFloatingBadge title="ตรวจสอบยอดจ่ายและสถานะธุรกรรมกับ KOHKAE789">
    <Picture
      slot="left"
      src={imgPayout}
      loading="lazy"
      fetchpriority="low"
      widths={[300, 450, 600]}
      sizes="(max-width: 768px) calc(100vw - 4rem), 350px"
      decoding="async"
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      quality={80}
      alt="แบนเนอร์โปรโมชั่น 3 ของ KOHKAE789 ข้อความ คืนยอดเสียทุกวัน 10% สูงสุด 5,000 บาท พร้อมแถบด้านล่าง มั่นคงปลอดภัย ฝากถอนออโต้ รองรับมือถือ และบริการ 24 ชม."
      class="mx-auto h-auto w-full rounded-2xl border border-[#1573e6]/35 shadow-[0_10px_30px_rgba(21,115,230,0.22)]"
    />
    <p slot="right" class="text-left text-base leading-relaxed text-[#cfe6f7]">
      ก่อนส่งคำขอถอนผ่าน KOHKAE789 ควรตรวจสอบยอดคงเหลือ สถานะบัญชี และข้อกำหนดของโปรโมชั่นให้ครบ หากรายการล่าช้าควรเก็บเวลา ยอดเงิน และข้อมูลอ้างอิงไว้สำหรับติดต่อทีมงาน
      โดยไม่เปิดเผยรหัสผ่านหรือข้อมูลยืนยันที่ใช้เข้าถึงบัญชี
    </p>
  </ContentBoxSevenThreeFloatingBadge>

  <Faq title="คำถามที่พบบ่อยเกี่ยวกับ KOHKAE789" faqs={faqs} />

  <LoginRtpSection />

  <LatestWinners />

  <div class="relative z-10 mx-auto mb-10 flex flex-nowrap justify-center gap-3 px-4 sm:gap-6">
    <a
      href="/login"
      class="group relative flex flex-1 items-center justify-center rounded-full bg-gradient-to-r from-[#7fdcff] via-[#29abe3] to-[#0b3f96] px-4 py-3 text-sm font-black whitespace-nowrap text-[#050c1a] shadow-[0_10px_30px_rgba(41,171,227,0.3)] transition-all duration-300 hover:-translate-y-1 hover:scale-105 hover:shadow-[0_15px_40px_rgba(41,171,227,0.45)] sm:flex-none sm:px-10 sm:py-3.5 sm:text-base">
      เข้าสู่ระบบ
    </a>

    <a
      href="/register"
      class="group relative flex flex-1 items-center justify-center rounded-full border border-[#29abe3]/70 bg-[#0b1c33]/85 px-4 py-3 text-sm font-black whitespace-nowrap text-[#bfe9ff] backdrop-blur-sm transition-all duration-300 hover:scale-105 hover:border-[#1573e6] hover:bg-[#12294a]/85 hover:shadow-[0_15px_40px_rgba(21,115,230,0.4)] sm:flex-none sm:px-10 sm:py-3.5 sm:text-base">
      สมัครสมาชิก
    </a>
  </div>

  <SmoothCarousel />

  <ReviewCardSumo2 />

  <Navfoot />
</MainLayout>
