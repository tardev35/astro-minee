---
import MainLayout from "../layouts/MainLayout.astro";
import Announcement from "../components/Announcement5.astro";
import ContentBoxFloatingBadge from "../components/ContentBoxFloatingBadge.astro";
import ContentBox from "../components/ContentBox.astro";
import ContentBoxNeumorphism from "../components/ContentBoxNeumorphism.astro";
import ContentBoxTwoNeumorphism from "../components/ContentBoxTwoNeumorphism.astro";
import ContentBoxSevenThreeFloatingBadge from "../components/ContentBoxSevenThreeFloatingBadge.astro";
import ContentBoxSevenThreeNeumorphism from "../components/ContentBoxSevenThreeNeumorphism.astro";
import ProviderGrid from "../components/ProviderGrid.astro";
import GameRankingBoard from "../components/GameRankingBoard.astro";
import LoginRtpSection from "../components/LoginRtpSection.astro";
import ReviewCardSumo2 from "../components/ReviewCardSumo2.astro";
import LatestWinners from "../components/LatestWinners3.astro";
import SmoothCarousel from "../components/SmoothCarousel.astro";
import Faq from "../components/Faq3.astro";
import Navfoot from "../components/Navfoot.astro";

import { Picture } from "astro:assets";
import { pageGraph } from "../lib/schema";

// Slides live only inside a ContentBoxSevenThree* block and there are at most
// two of those per rebrand — both are spent here.
//
// slide1 prints "สมาชิกใหม่ รับโบนัส 50% / โบนัสต้อนรับสำหรับผู้เล่นใหม่", the
// starter offer the โปรทุนน้อย section is about; slide2 prints "ฝากครั้งแรก
// รับเพิ่ม 20%", which is credit granted against a deposit, so it sits with the
// ลุ้นรับเครดิตเพิ่มเติม section. slide3 (แนะนำเพื่อน 10%) and slide4
// (คืนยอดเสีย 0.8%) stay unused here and keep rendering in SmoothCarousel and
// on /promotion.
//
// banner2.png is NOT imported anywhere: it predates this asset drop.
// banner1/banner1-mobile are the hero and belong to MainLayout alone.
import imgLowBudgetPromo from "../assets/slide1.png";
import imgExtraCredit from "../assets/slide2.png";

const pageTitle = "ABM96 | รวมเกมสล็อตแตกง่าย เล่นสนุกจ่ายจริง โปรทุนน้อยลุ้นรับเครดิต";
const pageHeading = "ABM96 รวมเกมสล็อตแตกง่าย เล่นสนุกจ่ายจริง โปรทุนน้อยลุ้นรับเครดิต";

// The docx Meta Description, verbatim at the length it was written (148
// characters). DESC_MIN does not apply to the home page — verify-build.mjs
// exempts it precisely so the brand's own copy ships unpadded. Do not top it
// up to 150.
const pageDescription = "ABM96 รวมเกมสล็อตหลายแนว เล่นสนุก โปรทุนน้อยลุ้นรับเครดิตตามเงื่อนไข รองรับมือถือ พร้อมระบบใช้งานสะดวกและบริการสมาชิกตลอด 24 ชั่วโมง";

// The docx Q&A block, verbatim. Passed as an explicit prop rather than left to
// Faq3's own default, which is always the previous brand's FAQ.
const faqs = [
  {
    q: "ABM96 มีโปรโมชั่นสำหรับผู้เล่นทุนน้อยหรือไม่?",
    a: "โปรโมชั่นบางรายการเหมาะกับการเริ่มต้นด้วยงบไม่สูง แต่ควรตรวจสอบยอดฝาก เงื่อนไขรับสิทธิ์ เกมที่ร่วมรายการ และข้อกำหนดการถอนก่อนเลือกทุกครั้ง",
  },
  {
    q: "เครดิตจากโปรโมชั่น ABM96 ได้รับอย่างไร?",
    a: "เครดิตอาจได้รับตามยอดฝากหรือกิจกรรมที่กำหนด โดยจำนวนเครดิต วิธีรับ และเงื่อนไขการนำไปใช้จะแตกต่างกันตามแต่ละโปรโมชั่น",
  },
  {
    q: "เกมแตกง่ายของ ABM96 รับประกันผลตอบแทนหรือไม่?",
    a: "ไม่สามารถรับประกันผลลัพธ์หรือกำไรจากเกมสล็อตได้ ผู้เล่นควรศึกษากติกา ความผันผวน และกำหนดงบประมาณที่เหมาะสมก่อนเริ่มเล่น",
  },
];

// Homepage: no breadcrumb — there is no trail above the root.
const graph = pageGraph(Astro, {
  name: pageHeading,
  description: pageDescription,
  faqs,
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBoxFloatingBadge as="h1" title={pageHeading}>
    <p class="text-left text-base leading-relaxed text-[#f6e3ee]">
      <strong class="text-[#fda3cd]">ABM96</strong> เป็นแพลตฟอร์มเกมสล็อตออนไลน์ที่รวบรวมเกมหลายรูปแบบไว้ในระบบเดียว เหมาะกับผู้เล่นที่ต้องการเลือกเกมได้หลากหลาย พร้อมโปรโมชั่นทุนน้อยและเครดิตตามเงื่อนไขที่กำหนด
      รองรับการใช้งานบนมือถือและคอมพิวเตอร์ ควรอ่านกติกา รายละเอียดโบนัส และเงื่อนไขต่าง ๆ ก่อนเริ่มใช้งานทุกครั้ง
    </p>
  </ContentBoxFloatingBadge>

  <ContentBoxNeumorphism as="h2" title="รวมเกมสล็อตหลายสไตล์ให้เลือกบน ABM96">
    <p class="text-left text-base leading-relaxed text-[#f6e3ee]">
      ภายใน ABM96 มีทั้งเกมสล็อตคลาสสิก เกมฟีเจอร์โบนัส และเกมธีมใหม่ ๆ ให้เลือกตามความสนใจ ผู้เล่นสามารถพิจารณาจากกติกา รูปแบบการจ่าย และระดับความผันผวน
      เพื่อเลือกเกมที่เหมาะกับงบประมาณและสไตล์การเล่นของตนเองมากขึ้น
    </p>
  </ContentBoxNeumorphism>

  <ProviderGrid />

  <ContentBoxSevenThreeFloatingBadge title="โปรทุนน้อยช่วยให้เริ่มต้นได้ตามงบประมาณ">
    <Picture
      slot="left"
      src={imgLowBudgetPromo}
      loading="lazy"
      fetchpriority="low"
      widths={[300, 450, 600]}
      sizes="(max-width: 768px) calc(100vw - 6rem), 350px"
      decoding="async"
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      quality={80}
      alt="แบนเนอร์โปรโมชั่น ABM96 ข้อความ สมาชิกใหม่ รับโบนัส 50% สมัครวันนี้ รับสิทธิ์ทันที โบนัสต้อนรับสำหรับผู้เล่นใหม่ และปุ่ม รับโปรเลย พร้อมผู้หญิงในชุดกีฬาครอปสีชมพู-ขาว-ดำ พิมพ์ ABM96 ชี้นิ้วขึ้น มาสคอตหมูสีชมพูสวมเสื้อยืดขาวพิมพ์ ABM96 ป้ายไฟ JACKPOT BIG WIN ตู้สล็อตเลข 777 BAR เหรียญทองและชิปคาสิโนสีชมพูในห้องคาสิโนไฟนีออนสีชมพู"
      class="mx-auto h-auto w-full rounded-2xl border border-[#f1509b]/40 shadow-[0_10px_30px_rgba(241,80,155,0.28)]"
    />
    <p slot="right" class="text-left text-base leading-relaxed text-[#f6e3ee]">
      โปรโมชั่นทุนน้อยเหมาะกับผู้ที่ต้องการกำหนดวงเงินเริ่มต้นให้ชัดเจน โดยควรตรวจสอบยอดฝากที่กำหนด เกมที่เข้าร่วม และเงื่อนไขการถอนก่อนรับสิทธิ์ การเลือกโปรที่พอดีกับงบช่วยให้ใช้งานได้ยืดหยุ่น
      โดยไม่จำเป็นต้องเพิ่มเงินเกินแผน
    </p>
  </ContentBoxSevenThreeFloatingBadge>

  <ContentBoxSevenThreeNeumorphism titleright="ลุ้นรับเครดิตเพิ่มเติมผ่านโปรโมชั่นของ ABM96">
    <Picture
      slot="left"
      src={imgExtraCredit}
      loading="lazy"
      fetchpriority="low"
      widths={[300, 450, 600]}
      sizes="(max-width: 768px) calc(100vw - 6rem), 380px"
      decoding="async"
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      quality={80}
      alt="แบนเนอร์โปรโมชั่น ABM96 ข้อความ ฝากครั้งแรก รับเพิ่ม 20% คุ้มตั้งแต่ฝากแรก ฝากง่าย ถอนเร็ว ระบบออโต้ และปุ่ม ฝากเลย พร้อมแถบ ระบบออโต้ ฝาก-ถอนอัตโนมัติ 24 ชม. โบนัสคุ้ม จัดเต็มทุกโปรโมชั่น และบริการ 24 ชม. มีผู้หญิงในชุดกีฬาครอปสีชมพู-ขาว-ดำ พิมพ์ ABM96 มาสคอตหมูสีชมพูแลบลิ้น ป้ายไฟ JACKPOT BIG WIN ตู้สล็อตเลข 777 BAR ไพ่โพแดงโพดำ เหรียญทองและชิปคาสิโนสีชมพู"
      class="mx-auto h-auto w-full rounded-2xl border border-[#f1509b]/40 shadow-[0_10px_30px_rgba(241,80,155,0.28)]"
    />
    <p slot="right" class="text-left text-base leading-relaxed text-[#f6e3ee]">
      โปรโมชั่นบางรายการของ ABM96 อาจมีเครดิตเพิ่มเติมสำหรับสมาชิกตามยอดฝากหรือกิจกรรมที่กำหนด ก่อนรับสิทธิ์ควรตรวจสอบจำนวนเครดิต ระยะเวลา และข้อกำหนดการนำเครดิตไปใช้ให้ครบ
      เพื่อช่วยให้เข้าใจสิทธิประโยชน์และเงื่อนไขได้ชัดเจนตั้งแต่ต้น
    </p>
  </ContentBoxSevenThreeNeumorphism>

  <LatestWinners />

  <ContentBox as="h2" title="เล่นสนุกได้มากขึ้นเมื่อเลือกเกมให้ตรงความชอบ">
    <p class="text-left text-base leading-relaxed text-[#f6e3ee]">
      ความสนุกของเกมสล็อตขึ้นอยู่กับหลายปัจจัย ทั้งธีม ฟีเจอร์ ความเร็ว และรูปแบบโบนัส ผู้เล่นควรทดลองหลายเกมและเลือกแบบที่เข้าใจกติกาได้ง่าย ไม่ควรยึดเฉพาะคำว่าแตกง่าย
      เพราะผลของเกมไม่สามารถรับประกันได้ และควรกำหนดวงเงินก่อนเริ่มทุกครั้ง
    </p>
  </ContentBox>

  <GameRankingBoard />

  <ContentBox as="h2" title="ABM96 รองรับการเล่นผ่านมือถือได้คล่องตัว">
    <p class="text-left text-base leading-relaxed text-[#f6e3ee]">
      เว็บไซต์ ABM96 รองรับมือถือ แท็บเล็ต และคอมพิวเตอร์ สมาชิกสามารถเข้าสู่ระบบ เลือกเกม ตรวจสอบโปรโมชั่น และติดตามเครดิตผ่านเบราว์เซอร์ได้ ควรใช้อินเทอร์เน็ตที่เสถียร เข้าผ่านช่องทางหลัก
      และรักษาข้อมูลบัญชีให้ปลอดภัยตลอดการใช้งาน
    </p>
  </ContentBox>

  <ContentBoxTwoNeumorphism titleleft="ตรวจสอบสิทธิ์และรายการกับทีมงาน ABM96">
    <p slot="left" class="text-left text-base leading-relaxed text-[#f6e3ee]">
      หากมีข้อสงสัยเรื่องเครดิต โปรโมชั่น บัญชี หรือสถานะธุรกรรม สมาชิกสามารถติดต่อทีมงาน ABM96 ผ่านช่องทางที่เว็บไซต์กำหนด ควรเตรียมชื่อผู้ใช้ เวลา และรายละเอียดรายการให้ครบถ้วน
      โดยไม่เปิดเผยรหัสผ่านหรือรหัสยืนยัน เพื่อช่วยให้ตรวจสอบได้ตรงประเด็น
    </p>

    <div slot="right" class="flex flex-col gap-3 rounded-2xl border border-[#f1509b]/25 bg-[#0d0207]/70 p-5">
      <p class="flex items-center gap-2 text-sm font-black tracking-widest text-[#f5c542] uppercase">
        <span aria-hidden="true">🛟</span>
        สิ่งที่ควรเตรียมก่อนแจ้งทีมงาน
      </p>
      <span class="flex items-start gap-2.5 text-sm text-[#f6e3ee]">
        <span aria-hidden="true" class="mt-0.5 shrink-0 text-[#fda3cd]">①</span>
        ชื่อผู้ใช้ที่ใช้เข้าสู่ระบบ
      </span>
      <span class="flex items-start gap-2.5 text-sm text-[#f6e3ee]">
        <span aria-hidden="true" class="mt-0.5 shrink-0 text-[#fda3cd]">②</span>
        วันและเวลาที่ทำรายการ
      </span>
      <span class="flex items-start gap-2.5 text-sm text-[#f6e3ee]">
        <span aria-hidden="true" class="mt-0.5 shrink-0 text-[#fda3cd]">③</span>
        รายละเอียดรายการหรือโปรโมชั่นที่ต้องการให้ตรวจสอบ
      </span>
      <span class="mt-1 rounded-xl border border-[#f5c542]/35 bg-[#2a0a1b]/70 px-4 py-2.5 text-xs leading-relaxed text-[#f6e3ee]/80">
        ไม่ต้องแจ้งรหัสผ่านหรือรหัสยืนยันให้ผู้ใด แม้จะเป็นการติดต่อกับทีมงานก็ตาม
      </span>
      <a
        href="/line"
        class="mt-1 flex w-full items-center justify-center gap-2 rounded-xl bg-gradient-to-r from-[#00B900] to-[#009900] p-3 text-sm font-bold text-white shadow-md transition-transform hover:scale-[1.02]">
        <span aria-hidden="true">💬</span> ติดต่อทีมงานผ่าน LINE
      </a>
    </div>
  </ContentBoxTwoNeumorphism>

  <Faq title="คำถามที่พบบ่อยเกี่ยวกับ ABM96" faqs={faqs} />

  <LoginRtpSection />

  <div class="relative z-10 mx-auto mb-10 flex flex-nowrap justify-center gap-3 px-4 sm:gap-6">
    <a
      href="/login"
      class="group relative flex flex-1 items-center justify-center rounded-full bg-gradient-to-r from-[#fda3cd] via-[#f1509b] to-[#b5054f] px-4 py-3 text-sm font-black whitespace-nowrap text-[#fff5fa] shadow-[0_10px_30px_rgba(241,80,155,0.32)] transition-all duration-300 hover:-translate-y-1 hover:scale-105 hover:shadow-[0_15px_40px_rgba(241,80,155,0.48)] sm:flex-none sm:px-10 sm:py-3.5 sm:text-base">
      เข้าสู่ระบบ
    </a>

    <a
      href="/register"
      class="group relative flex flex-1 items-center justify-center rounded-full border-2 border-[#ffe08a]/70 bg-gradient-to-r from-[#ffe08a] to-[#f5c542] px-4 py-3 text-sm font-black whitespace-nowrap text-[#2a0210] shadow-[0_10px_30px_rgba(245,197,66,0.35)] transition-all duration-300 hover:-translate-y-1 hover:scale-105 hover:border-[#ffe08a] hover:shadow-[0_15px_40px_rgba(245,197,66,0.5)] sm:flex-none sm:px-10 sm:py-3.5 sm:text-base">
      สมัครสมาชิก
    </a>
  </div>

  <SmoothCarousel />

  <ReviewCardSumo2 />

  <Navfoot />
</MainLayout>
