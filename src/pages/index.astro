---
import MainLayout from "../layouts/MainLayout.astro";
import Announcement from "../components/AnnouncementHuay.astro";
import ContentBoxHuay from "../components/ContentBoxHuay.astro";
import ContentBoxSevenThreeHuay from "../components/ContentBoxSevenThreeHuay.astro";
import ContentBoxNeumorphism from "../components/ContentBoxNeumorphism.astro";
import ContentBox3ThreeHuay from "../components/ContentBox3ThreeHuay.astro";
import ContentBoxSevenThreeNeumorphism from "../components/ContentBoxSevenThreeNeumorphism.astro";
import ContentBox from "../components/ContentBox.astro";
import ContentBoxTwoHuay from "../components/ContentBoxTwoHuay.astro";
import FaqHuay from "../components/FaqHuay.astro";
import LottoGrid from "../components/LottoGrid.astro";
import LatestWinnersHuay from "../components/LatestWinnersHuay.astro";
import LoginRtpSection from "../components/LoginRtpSection.astro";
import SmoothCarousel from "../components/SmoothCarousel.astro";
import ReviewCardSumo2 from "../components/ReviewCardSumo2.astro";
import Navfoot from "../components/Navfoot.astro";

import { Picture } from "astro:assets";
import { pageGraph } from "../lib/schema";

// Slides live only inside a ContentBoxSevenThree* block and there are at most
// two of those per rebrand — both are spent here.
//
// slide1 is the first-โพย welcome offer: a member holding a single government
// lottery ticket, which is docx H2-2's point about picking the right หวย and the
// right งวด before any number is typed.
// slide2 is the "ภารกิจสะสมโพย" mission card — one running tally of งวด bought,
// tickets and coins in one chest, the same shape as docx H2-5's "ระบบเดียวช่วย
// ลดการสลับหลายหน้า".
// slide3 (ชวนเพื่อนสายหวย) and slide4 (นาทีทองเลขเฮง) stay unused here and keep
// rendering in SmoothCarousel and on /promotion.
//
// banner2.png is NOT imported anywhere: it predates this asset drop.
// banner1/banner1-mobile/og.png are the hero and the share card and belong to
// MainLayout alone.
import imgFirstSlip from "../assets/slide1.png";
import imgSlipMission from "../assets/slide2.png";

// The docx "Main SEO" Title and H1, verbatim. They are the brand's own copy,
// not a draft to tidy.
const pageTitle = "JAIDEEJING | เว็บแทงหวยออนไลน์ครบวงจร สะดวกง่าย ปลอดภัยจ่ายไว";
const pageHeading = "JAIDEEJING เว็บแทงหวยออนไลน์ครบวงจร สะดวกง่าย ปลอดภัยจ่ายไว";

// The docx Main SEO Meta Description, verbatim at the length it was written.
// DESC_MIN does not apply to the home page — verify-build.mjs exempts any
// description that appears literally in src/assets/content.txt, precisely so the
// brand's own copy ships unpadded. Do not top it up.
const pageDescription = "JAIDEEJING เว็บแทงหวยออนไลน์ครบวงจร ที่ระบบรองรับมือถือ พร้อมระบบจัดโพย ตรวจอัตราจ่าย ผลรางวัล และสถานะรายการได้สะดวกรวดเร็ว";

// Each alt is the Thai promotional text actually printed on that slide plus the
// scene around it, read off the artwork itself. The wordmark baked into these
// files is written as "โลโก้เว็บไซต์" rather than transcribed — alt text
// describes the picture, it does not repeat a logotype.
const altFirstSlip =
  "แบนเนอร์โปรโมชั่นโทนแดงทอง มุมบนซ้ายเป็นโลโก้เว็บไซต์รูปมังกรทองพันรอบเหรียญ ข้างกันเป็นป้ายผ้าสีแดงเขียนว่า โชคดีวันนี้ รายได้ที่นี่ มุมบนขวาเขียนว่า เลขดี ชีวิตดีขึ้นทุกงวด หัวข้อตัวหนาสองบรรทัดเขียนว่า เปิดโพยแรก และ รับโบนัส ใต้หัวข้อเป็นแถบเขียนว่า ซื้อหวยครั้งแรก รับเครดิตฟรี โดยเลข 88 เป็นตัวใหญ่สีทอง ถัดลงมาเป็นกรอบเขียนว่า เฉพาะสมาชิกใหม่ ขอบขวาเขียนว่า ลุ้นทุกตัว รวยทุกงวด แถบล่างสุดมีสามช่องเขียนว่า แทงง่าย จ่ายไว และ ใช้งานสะดวก ในภาพเป็นผู้หญิงสวมชุดเลื่อมสีทองยิ้มพร้อมชูสลากกินแบ่งรัฐบาลหนึ่งใบ รอบตัวมีลูกบอลหวยสีทองพิมพ์เลข 6 8 9 และ 5 สลากกินแบ่งรัฐบาลอีกหลายใบ เหรียญทองกองอยู่ และยอดปราสาททองกับผ้าไหมสีแดงเป็นฉากหลัง";

const altSlipMission =
  "แบนเนอร์โปรโมชั่นโทนแดงทอง มุมบนซ้ายเป็นโลโก้เว็บไซต์รูปมังกรทองพันรอบเหรียญ ข้างกันเป็นป้ายผ้าสีแดงเขียนว่า โชคดีวันนี้ รายได้ที่นี่ มุมบนขวาเขียนว่า ตัวเลขเปลี่ยนชีวิต เริ่มได้วันนี้ หัวข้อตัวหนาสองบรรทัดเขียนว่า ภารกิจ และ สะสมโพย โดยมีช่องเครื่องหมายถูกสีทองสองช่องอยู่ข้างหัวข้อ ใต้หัวข้อเป็นแถบเขียนว่า ซื้อครบ 5 งวด รับโบนัส โดยเลข 188 เป็นตัวใหญ่สีทอง ถัดลงมาเขียนว่า ยิ่งซื้อ ยิ่งคุ้ม ด้านล่างเป็นแถวขั้นตอนสามช่องพร้อมลูกศรเขียนว่า ซื้อหวย สะสมงวด และ รับโบนัส คู่กับไอคอนรถเข็น เอกสาร และกล่องของขวัญ ในภาพเป็นผู้หญิงชี้นิ้วขึ้นด้านบนและถือสลากกินแบ่งรัฐบาลไว้ในอีกมือ ข้างกันเป็นหีบสมบัติเปิดอยู่ล้นด้วยเหรียญทองและสลากกินแบ่งรัฐบาล รอบภาพมีลูกบอลหวยสีทองพิมพ์เลข 8 9 6 และ 5 กับผ้าไหมสีแดง";

// The docx Q&A block, verbatim. Passed as an explicit prop rather than left to
// FaqHuay's own default, so the rendered markup and the FAQ JSON-LD below come
// out of the same array.
const faqs = [
  {
    q: "JAIDEEJING มีหวยหลายประเภทให้เลือกหรือไม่?",
    a: "ระบบอาจรวมหวยหลายประเภทตามที่เว็บไซต์กำหนด ผู้สนใจสามารถสมัครสมาชิกเพื่อดูรายการล่าสุด พร้อมตรวจเวลาเปิดปิด อัตราจ่าย และรูปแบบเดิมพันก่อนส่งโพย",
  },
  {
    q: "JAIDEEJING ตรวจโพยและผลรางวัลได้อย่างไร?",
    a: "สมาชิกควรตรวจจากหน้าประวัติรายการและข้อมูลผลรางวัลที่ระบบแสดง พร้อมเก็บเลขอ้างอิงของโพยไว้จนกว่าสถานะจะเสร็จสมบูรณ์",
  },
  {
    q: "คำว่าปลอดภัยจ่ายไวของ JAIDEEJING รับประกันทุกกรณีหรือไม่?",
    a: "ไม่ควรตีความว่าเป็นการรับประกัน เพราะสถานะรายการอาจขึ้นอยู่กับบัญชี ประเภทหวย และขั้นตอนตรวจสอบ ควรดูข้อมูลจริงจากระบบและติดต่อทีมงานหากพบความผิดปกติ",
  },
];

// Homepage: no breadcrumb — there is no trail above the root.
const graph = pageGraph(Astro, {
  name: pageHeading,
  description: pageDescription,
  faqs,
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <SmoothCarousel />

  <ContentBoxHuay as="h1" title={pageHeading}>
    <p class="text-left text-base leading-relaxed text-[#f7e4c0]">
      <strong class="text-[#f5c451]">JAIDEEJING</strong> เป็นแพลตฟอร์มหวยออนไลน์ที่รวมประเภทหวย การกรอกเลข ระบบโพย อัตราจ่าย และข้อมูลผลรางวัลไว้ในบัญชีเดียว ช่วยให้สมาชิกตรวจงวดและจัดรายการได้เป็นขั้นตอน
      รองรับการใช้งานผ่านมือถือ ผู้ที่สนใจสามารถสมัครสมาชิกเพื่อดูประเภทหวยและโปรโมชั่นล่าสุด พร้อมตรวจเงื่อนไขก่อนส่งโพยจริงทุกครั้ง
    </p>
  </ContentBoxHuay>

  <ContentBoxSevenThreeHuay titleright="เลือกประเภทหวยให้ตรงกับงวดได้ง่ายบน JAIDEEJING">
    <Picture
      slot="left"
      src={imgFirstSlip}
      loading="lazy"
      fetchpriority="low"
      widths={[300, 450, 600]}
      sizes="(max-width: 768px) calc(100vw - 6rem), 380px"
      decoding="async"
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      quality={80}
      alt={altFirstSlip}
      class="mx-auto h-auto w-full rounded-2xl border border-[#f5c451]/55 shadow-[0_10px_30px_rgba(245,196,81,0.28)]"
    />
    <p slot="right" class="text-left text-base leading-relaxed text-[#f7e4c0]">
      ภายใน JAIDEEJING ผู้ใช้งานสามารถเลือกประเภทหวยตามรายการและรอบออกรางวัลที่ระบบรองรับ ก่อนกรอกเลขควรตรวจชื่อหวย วันที่ออกรางวัล และเวลาปิดรับให้ครบ โดยเฉพาะผู้ที่ซื้อหลายงวดในวันเดียว
      หากยังไม่แน่ใจสามารถติดต่อทีมงานเพื่อสอบถามข้อมูลก่อนส่งโพย
    </p>
  </ContentBoxSevenThreeHuay>

  <LottoGrid />

  <ContentBoxNeumorphism as="h2" title="จัดโพยหลายเลขให้ตรวจง่ายก่อนยืนยันรายการ">
    <p class="text-left text-base leading-relaxed text-[#f7e4c0]">
      เมื่อเลือกเลขหลายชุด ควรแยกตรวจทีละรายการทั้งเลข ประเภทเดิมพัน และจำนวนเงินก่อนกดยืนยัน การจัดโพยให้เป็นระเบียบช่วยลดโอกาสกรอกเลขผิดหรือเลือกงวดไม่ตรง
      และควรเก็บเลขอ้างอิงหลังส่งรายการไว้จนกว่าจะประกาศผลหรือสถานะโพยเสร็จสมบูรณ์
    </p>
  </ContentBoxNeumorphism>

  <ContentBox3ThreeHuay as="h2" title="ตรวจอัตราจ่ายบน JAIDEEJING ก่อนเลือกเลข 2 ตัว 3 ตัว">
    <p slot="left" class="text-left text-base leading-relaxed text-[#f7e4c0]">อัตราจ่ายของ JAIDEEJING อาจแตกต่างตามประเภทหวย รูปแบบเดิมพัน และสถานะของเลข</p>
    <p slot="center" class="text-left text-base leading-relaxed text-[#f7e4c0]">ผู้ใช้งานควรตรวจราคาที่ระบบแสดงก่อนยืนยันทุกครั้ง เพราะเลข 2 ตัว 3 ตัว วิ่ง หรือรูปแบบอื่นอาจมีเงื่อนไขไม่เหมือนกัน</p>
    <p slot="right" class="text-left text-base leading-relaxed text-[#f7e4c0]">การดูอัตราจ่ายล่วงหน้าช่วยให้เข้าใจยอดในโพยได้ชัดเจนขึ้น</p>
  </ContentBox3ThreeHuay>

  <ContentBoxSevenThreeNeumorphism title="เว็บหวยครบวงจรควรช่วยลดการสลับหลายหน้า">
    <Picture
      slot="left"
      src={imgSlipMission}
      loading="lazy"
      fetchpriority="low"
      widths={[300, 450, 600]}
      sizes="(max-width: 768px) calc(100vw - 6rem), 360px"
      decoding="async"
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      quality={80}
      alt={altSlipMission}
      class="mx-auto h-auto w-full rounded-2xl border border-[#f5c451]/55 shadow-[0_10px_30px_rgba(245,196,81,0.24)]"
    />
    <p slot="right" class="text-left text-base leading-relaxed text-[#f7e4c0]">
      แพลตฟอร์มที่รวมประเภทหวย โพย ผลรางวัล โปรโมชั่น และประวัติรายการไว้ในระบบเดียวช่วยให้ตรวจข้อมูลได้ง่ายขึ้น แต่ผู้ใช้ยังควรอ่านกติกาของแต่ละรายการแยกกัน เพราะเวลาเปิดปิด อัตราจ่าย
      และข้อกำหนดอาจแตกต่างกันในแต่ละงวด
    </p>
  </ContentBoxSevenThreeNeumorphism>

  <ContentBox as="h2" title="ความปลอดภัยของ JAIDEEJING เริ่มจากการดูแลบัญชี">
    <p class="text-left text-base leading-relaxed text-[#f7e4c0]">
      การใช้งาน JAIDEEJING ควรเริ่มจากช่องทางหลัก ตั้งรหัสผ่านที่คาดเดายาก และไม่เปิดเผย OTP หรือรหัสยืนยันแก่บุคคลอื่น
      ควรตรวจประวัติรายการเป็นระยะและหลีกเลี่ยงเครือข่ายสาธารณะเมื่อต้องจัดการข้อมูลบัญชีหรือทำธุรกรรม
    </p>
  </ContentBox>

  <ContentBoxTwoHuay titleleft="จ่ายไวบน JAIDEEJING ควรดูจากสถานะรายการจริง" iconleft="⏱️">
    <p slot="left" class="text-left text-base leading-relaxed text-[#f7e4c0]">คำว่าจ่ายไวของ JAIDEEJING ควรพิจารณาจากสถานะรายการในระบบ ไม่ควรตีความว่าเป็นการรับประกันทุกกรณี</p>
    <p slot="right" class="text-left text-base leading-relaxed text-[#f7e4c0]">
      หลังประกาศผลควรตรวจโพยและยอดจากหน้าบัญชี หากสถานะยังไม่อัปเดตสามารถเก็บเลขอ้างอิงและติดต่อทีมงานเพื่อขอตรวจสอบเพิ่มเติมได้
    </p>
  </ContentBoxTwoHuay>

  <FaqHuay title="คำถามที่พบบ่อยเกี่ยวกับ JAIDEEJING" faqs={faqs} />

  <LatestWinnersHuay />

  <LoginRtpSection />

  <div class="relative z-10 mx-auto mb-10 flex flex-nowrap justify-center gap-3 px-4 sm:gap-6">
    <a
      href="/login"
      class="group relative flex flex-1 items-center justify-center rounded-full border-2 border-[#f5c451]/60 bg-[#1e0705]/90 px-4 py-3 text-sm font-black whitespace-nowrap text-[#f7e4c0] shadow-[0_10px_30px_rgba(245,196,81,0.22)] transition-all duration-300 hover:-translate-y-1 hover:scale-105 hover:border-[#ffe08a] hover:text-[#ffe08a] hover:shadow-[0_15px_40px_rgba(245,196,81,0.38)] sm:flex-none sm:px-10 sm:py-3.5 sm:text-base">
      เข้าสู่ระบบ
    </a>

    <a
      href="/register"
      class="group relative flex flex-1 items-center justify-center rounded-full border-2 border-[#ffe08a]/70 bg-gradient-to-r from-[#d12027] to-[#8f1a10] px-4 py-3 text-sm font-black whitespace-nowrap text-white shadow-[0_10px_30px_rgba(209,32,39,0.34)] transition-all duration-300 hover:-translate-y-1 hover:scale-105 hover:border-[#ffffff] hover:from-[#f0434a] hover:shadow-[0_15px_40px_rgba(209,32,39,0.48)] sm:flex-none sm:px-10 sm:py-3.5 sm:text-base">
      สมัครสมาชิก
    </a>
  </div>

  <ReviewCardSumo2 />

  <Navfoot />
</MainLayout>
