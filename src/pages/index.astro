---
import MainLayout from "../layouts/MainLayout.astro";
import Announcement from "../components/Announcement3.astro";
import ContentBoxNeumorphism from "../components/ContentBoxNeumorphism.astro";
import ContentBoxFloatingBadge from "../components/ContentBoxFloatingBadge.astro";
import ContentBoxSevenThree from "../components/ContentBoxSevenThree.astro";
import ContentBoxSevenThreeNeumorphism from "../components/ContentBoxSevenThreeNeumorphism.astro";
import ContentBoxTwoNeumorphism from "../components/ContentBoxTwoNeumorphism.astro";
import ContentBoxTwoFloatingBadge from "../components/ContentBoxTwoFloatingBadge.astro";
import LottoGrid from "../components/LottoGrid.astro";
import LoginRtpSection from "../components/LoginRtpSection.astro";
import ReviewCardSumo2 from "../components/ReviewCardSumo2.astro";
import LatestWinners from "../components/LatestWinners2.astro";
import SmoothCarousel from "../components/SmoothCarousel.astro";
import Faq from "../components/Faq3.astro";
import Navfoot from "../components/Navfoot.astro";

import { Picture } from "astro:assets";
import { pageGraph } from "../lib/schema";

// Slides live only inside a ContentBoxSevenThree* block and there are at most
// two of those per rebrand — both are spent here.
//
// slide3 prints "วงล้อเลขนำโชค" with a wheel of numbers around the logo, which
// is the "pick a lottery type and enter your numbers" idea of docx section H2-1;
// slide4 prints "ซื้อหวยครบ 300 บาท / รับคืน 5% ทุกงวด", i.e. a rate expressed
// per งวด, which is what the H2-2 payout-rate section is about. slide1
// (เครดิตฟรี 50 บาท) and slide2 (นาทีทอง 19:00–21:00) stay unused here and keep
// rendering in SmoothCarousel and on /promotion.
//
// banner2.png is NOT imported anywhere: it predates this asset drop.
// banner1/banner1-mobile are the hero and belong to MainLayout alone.
import imgLuckyWheel from "../assets/slide3.png";
import imgRebate from "../assets/slide4.png";

const pageTitle = "LOTTO77 | เว็บซื้อหวยออนไลน์อันดับ 1 ซื้อง่ายสะดวกจ่ายไว เลขอั้นน้อย";
const pageHeading = "LOTTO77 เว็บซื้อหวยออนไลน์อันดับ 1 ซื้อง่ายสะดวกจ่ายไว เลขอั้นน้อย";

// The docx Main SEO Meta Description, verbatim at the length it was written
// (120 characters). DESC_MIN does not apply to the home page — verify-build.mjs
// exempts it precisely so the brand's own copy ships unpadded. Do not top it up
// to 150.
const pageDescription = "LOTTO77 เว็บซื้อหวยออนไลน์ เลือกเลขง่าย รองรับมือถือ เลขอั้นน้อยตามเงื่อนไข พร้อมตรวจโพย ผลรางวัล และสถานะรายการได้สะดวก";

// The ticker default in Announcement3 is what sub-pages get; the home page
// always passes its own copy so the two never drift apart silently. No leading
// emoji — the marquee renders the string twice.
const announcement =
  "LOTTO77 รวมทุกขั้นตอนของการซื้อหวยไว้ในระบบเดียว เลือกประเภทหวย กรอกตัวเลข และตรวจสอบโพยได้จากหน้าเดียว • ควรตรวจวันออกรางวัล เวลาเปิดรับ และอัตราจ่ายของแต่ละตลาดก่อนกรอกเลขทุกครั้ง • เลขอั้นน้อยพิจารณาตามสถานะที่ระบบแสดงในแต่ละงวด จึงควรเช็กสถานะเลขก่อนกดยืนยันโพย • ผลการออกรางวัลคาดเดาไม่ได้ ควรกำหนดวงเงินต่อหนึ่งงวดและใช้เฉพาะเงินที่ไม่กระทบค่าใช้จ่ายจำเป็น";

const altLuckyWheel =
  "แบนเนอร์โปรโมชั่น LOTTO77 ข้อความ วงล้อเลขนำโชค ลุ้นเครดิตซื้อหวยสูงสุด 888 บาท พร้อมป้าย หมุนฟรีทุกวัน ลุ้นรับทันที และปุ่ม หมุนเลย ภาพวงล้อเสี่ยงโชคขนาดใหญ่สีแดง-ทองมีตัวเลข 77 99 24 38 17 89 45 16 เรียงรอบโลโก้ LOTTO77 ตรงกลาง ล้อมด้วยใบสลากกินแบ่งรัฐบาลและกองเหรียญทองบนพื้นหลังสีแดงเข้ม";

const altRebate =
  "แบนเนอร์โปรโมชั่น LOTTO77 ข้อความ ซื้อหวยครบ 300 บาท รับคืน 5% ทุกงวด พร้อมป้าย ยิ่งซื้อ ยิ่งคุ้ม และปุ่ม รับสิทธิ์ ภาพผู้หญิงในชุดสีแดงถือใบสลากกินแบ่งรัฐบาลคลี่เป็นรูปพัด ตารางเลขหวย เหรียญสีแดง-ทอง และลูกบอลหวยเลข 7 3 8 บนพื้นหลังสีแดงเข้ม";

// The docx Q&A block, verbatim. Passed as an explicit prop rather than left to
// Faq3's own default, so the rendered markup and the FAQ JSON-LD below come out
// of the same array.
const faqs = [
  {
    q: "LOTTO77 ซื้อหวยออนไลน์ผ่านมือถือได้หรือไม่?",
    a: "ระบบสามารถรองรับการใช้งานผ่านมือถือได้ตามช่องทางที่เว็บไซต์กำหนด สมาชิกควรตรวจประเภทหวย งวด เลข และจำนวนเงินให้ครบก่อนยืนยันโพย",
  },
  {
    q: "เลขอั้นน้อยของ LOTTO77 หมายถึงไม่มีเลขอั้นเลยหรือไม่?",
    a: "ไม่ได้หมายความว่าไม่มีข้อจำกัดทุกเลข สถานะเลขอั้น ราคา และวงเงินรับอาจแตกต่างกันในแต่ละงวด จึงควรตรวจข้อมูลล่าสุดจากระบบก่อนซื้อ",
  },
  {
    q: "LOTTO77 จ่ายไวทุกโพยหรือไม่?",
    a: "ระยะเวลาการตรวจผลและสถานะรายการอาจขึ้นอยู่กับประเภทหวย การประกาศผล และขั้นตอนของระบบ จึงควรตรวจสถานะจากบัญชีและเงื่อนไขที่เกี่ยวข้องเป็นหลัก",
  },
];

// Homepage: no breadcrumb — there is no trail above the root.
const graph = pageGraph(Astro, {
  name: pageHeading,
  description: pageDescription,
  faqs,
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement message={announcement} />

  <ContentBoxNeumorphism as="h1" title={pageHeading}>
    <p class="text-left text-base leading-relaxed text-[#f3ded7]">
      <strong class="text-[#f5c451]">LOTTO77</strong> เป็นแพลตฟอร์มหวยออนไลน์ที่ช่วยให้สมาชิกเลือกประเภทหวย กรอกตัวเลข และตรวจสอบโพยได้ผ่านระบบเดียว รองรับการใช้งานทั้งมือถือและคอมพิวเตอร์ พร้อมข้อมูลอัตราจ่าย
      เวลาเปิดปิดรับเดิมพัน และสถานะรายการที่ตรวจสอบได้ก่อนยืนยัน ผู้เล่นควรกำหนดงบประมาณและตรวจรายละเอียดของหวยแต่ละประเภทก่อนซื้อทุกครั้ง
    </p>
  </ContentBoxNeumorphism>

  <ContentBoxSevenThree titleright="เลือกประเภทหวยและกรอกเลขได้ง่ายบน LOTTO77">
    <Picture
      slot="left"
      src={imgLuckyWheel}
      loading="lazy"
      fetchpriority="low"
      widths={[300, 450, 600]}
      sizes="(max-width: 768px) calc(100vw - 6rem), 380px"
      decoding="async"
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      quality={80}
      alt={altLuckyWheel}
      class="mx-auto h-auto w-full rounded-2xl border border-[#f5c451]/40 shadow-[0_10px_30px_rgba(216,18,32,0.3)]"
    />
    <p slot="right" class="text-left text-base leading-relaxed text-[#f3ded7]">
      ภายใน LOTTO77 สามารถจัดหมวดหวยให้ค้นหาได้สะดวก ไม่ว่าจะเป็นหวยรัฐบาล หวยรายวัน หรือประเภทอื่นที่ระบบรองรับ สมาชิกควรตรวจสอบวันออกรางวัล เวลาเปิดรับ และกติกาของแต่ละรายการก่อนกรอกเลข
      เพื่อป้องกันการเลือกงวดหรือประเภทการเดิมพันผิด
    </p>
  </ContentBoxSevenThree>

  <LottoGrid />

  <ContentBoxSevenThreeNeumorphism titleright="ตรวจอัตราจ่ายก่อนซื้อ ช่วยให้เข้าใจโพยมากขึ้น">
    <Picture
      slot="left"
      src={imgRebate}
      loading="lazy"
      fetchpriority="low"
      widths={[300, 450, 600]}
      sizes="(max-width: 768px) calc(100vw - 6rem), 380px"
      decoding="async"
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      quality={80}
      alt={altRebate}
      class="mx-auto h-auto w-full rounded-2xl border border-[#f5c451]/40 shadow-[0_10px_30px_rgba(216,18,32,0.3)]"
    />
    <p slot="right" class="text-left text-base leading-relaxed text-[#f3ded7]">
      อัตราจ่ายของเลข 2 ตัว 3 ตัว วิ่ง หรือรูปแบบการเดิมพันอื่นอาจแตกต่างกัน ผู้เล่นควรตรวจราคาที่แสดงในระบบก่อนยืนยันโพยทุกครั้ง เพราะอัตราจ่ายและเงื่อนไขอาจเปลี่ยนตามประเภทหวย งวด หรือเลขที่เลือก
      การตรวจข้อมูลก่อนซื้อช่วยลดความเข้าใจคลาดเคลื่อนภายหลัง
    </p>
  </ContentBoxSevenThreeNeumorphism>

  <ContentBoxFloatingBadge as="h2" title="เลขอั้นน้อยบน LOTTO77 ควรตรวจสถานะเลขก่อนยืนยัน">
    <p class="text-left text-base leading-relaxed text-[#f3ded7]">
      คำว่าเลขอั้นน้อยของ LOTTO77 ควรพิจารณาตามสถานะที่ระบบแสดงในแต่ละงวด เพราะเลขบางชุดอาจมีข้อจำกัด ราคาเปลี่ยน หรือหยุดรับเมื่อยอดถึงระดับที่กำหนด
      สมาชิกจึงควรตรวจสถานะเลขและอัตราจ่ายล่าสุดก่อนกดยืนยันโพยทุกครั้ง
    </p>
  </ContentBoxFloatingBadge>

  <ContentBoxTwoNeumorphism titleleft="จัดโพยหวยให้เป็นระเบียบก่อนส่งรายการ">
    <p slot="left" class="text-left text-base leading-relaxed text-[#f3ded7]">
      ก่อนยืนยันควรตรวจตัวเลข ประเภทเดิมพัน จำนวนเงิน และยอดรวมของโพยอีกครั้ง โดยเฉพาะกรณีซื้อหลายเลขพร้อมกัน การแบ่งโพยเป็นชุดและตรวจทีละรายการช่วยลดความผิดพลาดจากการกรอกเลขสลับ
      และควรเก็บเลขอ้างอิงของโพยไว้จนกว่าจะประกาศผลรางวัล
    </p>

    <div slot="right" class="flex flex-col gap-3 rounded-2xl border border-[#d81220]/35 bg-[#150202]/75 p-5">
      <p class="flex items-center gap-2 text-sm font-black tracking-widest text-[#f5c451] uppercase">
        <span aria-hidden="true">🧾</span>
        สี่จุดที่ควรไล่ตรวจก่อนกดยืนยันโพย
      </p>
      <span class="flex items-start gap-2.5 text-sm text-[#f3ded7]">
        <span aria-hidden="true" class="mt-0.5 shrink-0 text-[#ff3d3d]">①</span>
        ตัวเลขของทุกรายการตรงกับที่ตั้งใจกรอกไว้
      </span>
      <span class="flex items-start gap-2.5 text-sm text-[#f3ded7]">
        <span aria-hidden="true" class="mt-0.5 shrink-0 text-[#ff3d3d]">②</span>
        ประเภทเดิมพันของแต่ละเลขถูกต้องตามที่เลือก
      </span>
      <span class="flex items-start gap-2.5 text-sm text-[#f3ded7]">
        <span aria-hidden="true" class="mt-0.5 shrink-0 text-[#ff3d3d]">③</span>
        จำนวนเงินต่อรายการตรงกับที่ตั้งใจซื้อ
      </span>
      <span class="flex items-start gap-2.5 text-sm text-[#f3ded7]">
        <span aria-hidden="true" class="mt-0.5 shrink-0 text-[#ff3d3d]">④</span>
        ยอดรวมของโพยทั้งชุดตรงกับงบที่กำหนดไว้
      </span>
      <span class="mt-1 rounded-xl border border-[#f5c451]/35 bg-[#2a0507]/80 px-4 py-2.5 text-xs leading-relaxed text-[#c9a49c]">
        ซื้อหลายเลขพร้อมกันควรแบ่งโพยเป็นชุดแล้วตรวจทีละรายการ และเก็บเลขอ้างอิงของโพยไว้จนกว่าจะประกาศผลรางวัล
      </span>
    </div>
  </ContentBoxTwoNeumorphism>

  <ContentBoxTwoFloatingBadge as="h2" title="LOTTO77 ช่วยให้ติดตามโพยและผลรางวัลได้สะดวก">
    <p slot="left" class="text-left text-base leading-relaxed text-[#f3ded7]">
      สมาชิก LOTTO77 สามารถใช้หน้าบัญชีเพื่อตรวจสอบโพยที่ส่งแล้ว สถานะรายการ และข้อมูลผลรางวัลตามที่ระบบแสดง การเช็กข้อมูลจากหน้าประวัติช่วยให้ตรวจสอบย้อนหลังได้ง่ายขึ้น
      และควรหลีกเลี่ยงการยึดเฉพาะภาพหน้าจอหรือข้อความที่ส่งต่อจากแหล่งที่ไม่ชัดเจน
    </p>

    <div slot="right" class="flex flex-col gap-3 rounded-2xl border border-[#d81220]/35 bg-[#150202]/75 p-5">
      <p class="flex items-center gap-2 text-sm font-black tracking-widest text-[#f5c451] uppercase">
        <span aria-hidden="true">🔎</span>
        ข้อมูลที่ดูได้จากหน้าบัญชีสมาชิก
      </p>
      <span class="flex items-start gap-2.5 text-sm text-[#f3ded7]">
        <span aria-hidden="true" class="mt-0.5 shrink-0 text-[#ff3d3d]">①</span>
        โพยที่ส่งแล้วในแต่ละงวด พร้อมเลขอ้างอิงของรายการ
      </span>
      <span class="flex items-start gap-2.5 text-sm text-[#f3ded7]">
        <span aria-hidden="true" class="mt-0.5 shrink-0 text-[#ff3d3d]">②</span>
        สถานะรายการว่ายังตรวจสอบอยู่หรือดำเนินการเสร็จแล้ว
      </span>
      <span class="flex items-start gap-2.5 text-sm text-[#f3ded7]">
        <span aria-hidden="true" class="mt-0.5 shrink-0 text-[#ff3d3d]">③</span>
        ข้อมูลผลรางวัลของงวดนั้นตามที่ระบบแสดง
      </span>
      <span class="mt-1 rounded-xl border border-[#f5c451]/35 bg-[#2a0507]/80 px-4 py-2.5 text-xs leading-relaxed text-[#c9a49c]">
        ควรยึดข้อมูลจากหน้าประวัติของบัญชีตนเองเป็นหลัก แทนการเชื่อภาพหน้าจอหรือข้อความที่ส่งต่อกันมาจากแหล่งที่ไม่ชัดเจน
      </span>
    </div>
  </ContentBoxTwoFloatingBadge>

  <LatestWinners />

  <ContentBoxNeumorphism as="h2" title="ซื้อง่ายไม่ได้หมายถึงควรเพิ่มยอดเกินงบ">
    <p class="text-left text-base leading-relaxed text-[#f3ded7]">
      แม้ระบบหวยออนไลน์จะช่วยลดขั้นตอนในการเลือกเลขและส่งโพย แต่ผลการออกรางวัลไม่สามารถคาดเดาหรือรับประกันได้ ผู้ใช้ <strong class="text-[#f5c451]">LOTTO77</strong> ควรกำหนดวงเงินต่อหนึ่งงวด ไม่เพิ่มยอดเพื่อชดเชยการเสียจากงวดก่อน
      และใช้เฉพาะเงินที่ไม่กระทบค่าใช้จ่ายจำเป็น
    </p>
  </ContentBoxNeumorphism>

  <Faq title="คำถามที่พบบ่อยเกี่ยวกับ LOTTO77" faqs={faqs} />

  <LoginRtpSection />

  <div class="relative z-10 mx-auto mb-10 flex flex-nowrap justify-center gap-3 px-4 sm:gap-6">
    <a
      href="/login"
      class="group relative flex flex-1 items-center justify-center rounded-full border-2 border-[#ff3d3d]/60 bg-gradient-to-r from-[#d81220] via-[#7d0000] to-[#150202] px-4 py-3 text-sm font-black whitespace-nowrap text-[#f3ded7] shadow-[0_10px_30px_rgba(216,18,32,0.38)] transition-all duration-300 hover:-translate-y-1 hover:scale-105 hover:border-[#f5c451] hover:shadow-[0_15px_40px_rgba(245,196,81,0.42)] sm:flex-none sm:px-10 sm:py-3.5 sm:text-base">
      เข้าสู่ระบบ
    </a>

    <a
      href="/register"
      class="group relative flex flex-1 items-center justify-center rounded-full border-2 border-[#ffe08a]/70 bg-gradient-to-r from-[#ffe08a] to-[#f5c451] px-4 py-3 text-sm font-black whitespace-nowrap text-[#150202] shadow-[0_10px_30px_rgba(245,196,81,0.35)] transition-all duration-300 hover:-translate-y-1 hover:scale-105 hover:border-[#ffe08a] hover:shadow-[0_15px_40px_rgba(245,196,81,0.5)] sm:flex-none sm:px-10 sm:py-3.5 sm:text-base">
      สมัครสมาชิก
    </a>
  </div>

  <SmoothCarousel />

  <ReviewCardSumo2 />

  <Navfoot />
</MainLayout>
