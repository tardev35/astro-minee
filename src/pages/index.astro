---
import MainLayout from "../layouts/MainLayout.astro";
import Announcement from "../components/Announcement5.astro";
import ContentBoxNeumorphism from "../components/ContentBoxNeumorphism.astro";
import ContentBoxTwoNeumorphism from "../components/ContentBoxTwoNeumorphism.astro";
import ContentBoxFloatingBadge from "../components/ContentBoxFloatingBadge.astro";
import ContentBoxSevenThreeNeumorphism from "../components/ContentBoxSevenThreeNeumorphism.astro";
import ContentBox from "../components/ContentBox.astro";
import ContentBoxSevenThreeFloatingBadge from "../components/ContentBoxSevenThreeFloatingBadge.astro";
import ContentBoxTwoFloatingBadge from "../components/ContentBoxTwoFloatingBadge.astro";
import ProviderGrid from "../components/ProviderGrid.astro";
import LoginRtpSection from "../components/LoginRtpSection.astro";
import LatestWinnersPremium from "../components/LatestWinnersPremium.astro";
import Faq4 from "../components/Faq4.astro";
import SmoothCarousel from "../components/SmoothCarousel.astro";
import ReviewCardSumo2 from "../components/ReviewCardSumo2.astro";
import Navfoot from "../components/Navfoot.astro";

import { Picture } from "astro:assets";
import { pageGraph } from "../lib/schema";

// Slides live only inside a ContentBoxSevenThree* block and there are at most
// two of those per rebrand — both are spent here.
//
// slide3 prints "ชวนเพื่อนรับคู่ คนละ 20 บาท" over a three-step flow diagram
// (ชวนเพื่อน → เพื่อนสมัครสำเร็จ → รับโบนัส): a sequential process that ends in a
// credited status, which is docx H2-4's auto-system point in picture form.
// slide4 prints "FINN HOUR 20:20 - 21:20 เปิดกล่องสุ่ม ลุ้น 20 / 120 / 520
// เครดิต" — one action with several printed payout values, which is H2-6's
// Banker / Player / Tie payout point in picture form.
// slide1 and slide2 stay unused on this page and keep rendering in
// SmoothCarousel and on /promotion.
//
// banner2.png is NOT imported anywhere: it predates this asset drop.
// banner1/banner1-mobile/og.png are the hero and the share card and belong to
// MainLayout alone.
import imgReferFriend from "../assets/slide3.png";
import imgFinnHour from "../assets/slide4.png";

const pageTitle = "FINN20 | บาคาร่าลิขสิทธิ์แท้เว็บตรง เล่นง่ายไม่ล็อคผล ระบบออโต้จ่ายไว";
const pageHeading = "FINN20 บาคาร่า ลิขสิทธิ์แท้เว็บตรง เล่นง่ายไม่ล็อคผล ระบบออโต้จ่ายไว";

// The docx Main SEO Meta Description, verbatim at the length it was written
// (128 characters). DESC_MIN does not apply to the home page — verify-build.mjs
// exempts it precisely so the brand's own copy ships unpadded. Do not top it up
// to 150.
const pageDescription = "FINN20 บาคาร่าเว็บตรง ระบบออโต้ รวมโต๊ะหลายรูปแบบ พร้อมข้อมูลผู้ให้บริการ อัตราจ่าย ประวัติเดิมพัน และสถานะธุรกรรมให้ตรวจสอบได้";

// Byte-identical to Announcement5's own default, which is what every sub-page
// calling <Announcement /> bare lands on. Passing it explicitly here keeps the
// home page and the rest of the site from drifting apart silently. No leading
// emoji — the marquee renders the string twice.
const announcement =
  "FINN20 รวมโต๊ะบาคาร่าหลายรูปแบบไว้ในระบบเดียว เลือกโต๊ะจากยอดเดิมพันขั้นต่ำ ความเร็วของแต่ละรอบ และรูปแบบการเล่นได้จากหน้าเดียว • ก่อนเริ่มควรตรวจชื่อผู้ให้บริการเกม กติกา อัตราจ่าย และค่าคอมมิชชันของแต่ละโต๊ะให้ครบ • ระบบออโต้ช่วยให้ตรวจยอด ประวัติรายการ และสถานะธุรกรรมได้จากบัญชีเดียว ก่อนยืนยันควรตรวจชื่อบัญชี จำนวนเงิน และข้อมูลรับเงินให้ถูกต้อง • หากรายการเดิมยังดำเนินการอยู่ ควรรอระบบอัปเดตก่อนทำรายการใหม่ เพื่อลดความซ้ำซ้อน • คำว่าไม่ล็อคผลและจ่ายไวเป็นถ้อยคำทางการตลาด ไม่ใช่การรับประกันผลของเกมหรือการถอนทุกกรณี ควรกำหนดงบก่อนเริ่มเล่นทุกครั้ง";

const altReferFriend =
  "แบนเนอร์โปรโมชั่น FINN20 ข้อความ ชวนเพื่อนรับคู่ คนละ 20 บาท และบรรทัดล่างเขียนว่า เพื่อนสมัครสำเร็จ รับโบนัสทันที ใต้ลงมาเป็นแผงสามขั้นตอนเรียงจากซ้ายไปขวา ไอคอนคนเขียนว่า ชวนเพื่อน มีลูกศรชี้ไปยังไอคอนคนที่มีเครื่องหมายถูกเขียนว่า เพื่อนสมัครสำเร็จ แล้วลูกศรชี้ต่อไปยังกล่องของขวัญที่มีเหรียญทองกองอยู่ เขียนว่า รับโบนัส และปุ่มสีทองเขียนว่า ชวนเลย ด้านบนเป็นโลโก้ FINN20 ตัวอักษร FiNN สีทองเงาและเลข 20 สีเงินพร้อมสัญลักษณ์โพดำ ใต้โลโก้เป็นแถบดำเขียนว่า WWW.FINN20.COM ข้างขวาเป็นผู้หญิงในชุดสีดำสลับทองติดโลโก้ FINN20 ถือโทรศัพท์ที่เปิดหน้าแอป FINN20 แล้วชี้นิ้วไปที่จอ ด้านซ้ายเป็นวงล้อรูเล็ตและไพ่โพดำ ด้านขวาเป็นวงล้อสล็อตช่อง BAR บนพื้นหลังสีดำที่มีเหรียญทองและประกายทองกระจายอยู่";

const altFinnHour =
  "แบนเนอร์โปรโมชั่น FINN20 ข้อความขนาดใหญ่ FINN HOUR โดยคำว่า FINN เป็นสีทองและ HOUR เป็นสีเงิน ใต้ลงมาเป็นไอคอนนาฬิกาพร้อมช่วงเวลา 20:20 - 21:20 ถัดมาเขียนว่า เปิดกล่องสุ่ม และ ลุ้น 20 / 120 / 520 เครดิต พร้อมไอคอนปฏิทินและข้อความ ร่วมสนุกเฉพาะช่วงเวลาที่กำหนด ด้านล่างซ้ายเป็นกล่องสุ่มสีดำขอบทองมีเครื่องหมายคำถามและป้ายเขียนว่า LUCKY BOX ข้างกันเป็นปุ่มสีทองเขียนว่า เปิดเลย ด้านบนเป็นโลโก้ FINN20 ตัวอักษร FiNN สีทองเงาและเลข 20 สีเงินพร้อมสัญลักษณ์โพดำ ใต้โลโก้เป็นแถบดำเขียนว่า WWW.FINN20.COM ข้างขวาเป็นผู้หญิงในชุดสีดำสลับทองติดโลโก้ FINN20 ยกมือขึ้นข้างแก้มทำท่าตื่นเต้น ข้างหลังเป็นนาฬิกาเรือนทอง วงล้อรูเล็ต และวงล้อสล็อตเลข 777 บนพื้นหลังสีดำที่มีเหรียญทองและประกายทองกระจายอยู่";

// The docx Q&A block, verbatim. Passed as an explicit prop rather than left to
// Faq4's own default, so the rendered markup and the FAQ JSON-LD below come out
// of the same array.
const faqs = [
  {
    q: "FINN20 มีบาคาร่าให้เลือกหลายรูปแบบหรือไม่?",
    a: "ระบบอาจมีโต๊ะบาคาร่าในหลายระดับวงเงินและรูปแบบ ผู้เล่นควรตรวจชื่อผู้ให้บริการ ขั้นต่ำ อัตราจ่าย และกติกาของแต่ละโต๊ะก่อนเริ่มเดิมพัน",
  },
  {
    q: "FINN20 ที่ระบุว่าไม่ล็อคผลหมายความว่าอย่างไร?",
    a: "โดยทั่วไปใช้สื่อว่าผลเกมไม่ได้ถูกกำหนดล่วงหน้าโดยเว็บไซต์ แต่ควรตรวจข้อมูลผู้ให้บริการ วิธีดำเนินเกม และรายละเอียดที่ระบบแสดงประกอบด้วย",
  },
  {
    q: "ระบบออโต้จ่ายไวของ FINN20 รับประกันการถอนทุกครั้งหรือไม่?",
    a: "ไม่ควรตีความว่าเป็นการรับประกันทุกกรณี ระยะเวลาอาจขึ้นอยู่กับสถานะบัญชี ช่องทางธุรกรรม โปรโมชั่น และขั้นตอนตรวจสอบของระบบ",
  },
];

// Homepage: no breadcrumb — there is no trail above the root.
const graph = pageGraph(Astro, {
  name: pageHeading,
  description: pageDescription,
  faqs,
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement message={announcement} />

  <ContentBoxNeumorphism as="h1" title={pageHeading}>
    <p class="text-left text-base leading-relaxed text-[#f3e7c8]">
      <strong class="text-[#fdd323]">FINN20</strong> เป็นแพลตฟอร์มบาคาร่าออนไลน์ที่เน้นการเข้าถึงโต๊ะเกมหลายรูปแบบผ่านระบบเดียว พร้อมระบบออโต้สำหรับจัดการบัญชีและธุรกรรม ผู้เล่นสามารถเปรียบเทียบวงเงิน อัตราจ่าย
      และรายละเอียดของโต๊ะก่อนเริ่ม รองรับการใช้งานผ่านมือถือ โดยควรตรวจข้อมูลผู้ให้บริการและกติกาของแต่ละเกมก่อนเดิมพันทุกครั้ง
    </p>
  </ContentBoxNeumorphism>

  <ContentBoxTwoNeumorphism titleleft="FINN20 ช่วยให้เลือกโต๊ะจากวงเงินและรูปแบบเกมได้ง่ายขึ้น">
    <p slot="left" class="text-left text-base leading-relaxed text-[#f3e7c8]">
      ผู้เล่น FINN20 สามารถพิจารณาโต๊ะจากยอดเดิมพันขั้นต่ำ ความเร็วของแต่ละรอบ และรูปแบบการเล่นที่แตกต่างกัน การเลือกโต๊ะให้ตรงกับงบช่วยให้วางแผนจำนวนรอบได้ง่ายขึ้น
      และลดโอกาสต้องปรับวงเงินตามสถานการณ์ระหว่างเกมโดยไม่จำเป็น
    </p>

    <div slot="right" class="flex flex-col gap-3 rounded-2xl border border-[#fdd323]/30 bg-[#1f1a10]/80 p-5">
      <p class="flex items-center gap-2 text-sm font-black tracking-widest text-[#fdd323] uppercase">
        <span aria-hidden="true">🎴</span>
        จุดที่ควรดูก่อนเลือกโต๊ะ
      </p>
      <span class="flex items-start gap-2.5 text-sm text-[#f3e7c8]">
        <span aria-hidden="true" class="mt-0.5 shrink-0 text-[#ffe98a]">①</span>
        ยอดเดิมพันขั้นต่ำของโต๊ะ ซึ่งกำหนดว่างบก้อนเดียวเล่นได้กี่รอบ
      </span>
      <span class="flex items-start gap-2.5 text-sm text-[#f3e7c8]">
        <span aria-hidden="true" class="mt-0.5 shrink-0 text-[#ffe98a]">②</span>
        ความเร็วของแต่ละรอบ เพราะโต๊ะที่เดินเร็วใช้งบต่อชั่วโมงมากกว่า
      </span>
      <span class="flex items-start gap-2.5 text-sm text-[#f3e7c8]">
        <span aria-hidden="true" class="mt-0.5 shrink-0 text-[#ffe98a]">③</span>
        รูปแบบการเล่นของโต๊ะนั้น ทั้งกติกาย่อยและตัวเลือกเดิมพันที่เปิดให้
      </span>
      <span class="flex items-start gap-2.5 text-sm text-[#f3e7c8]">
        <span aria-hidden="true" class="mt-0.5 shrink-0 text-[#ffe98a]">④</span>
        งบที่เตรียมไว้ล่วงหน้า เพื่อไม่ต้องปรับวงเงินกลางเกมโดยไม่จำเป็น
      </span>
      <span class="mt-1 rounded-xl border border-[#e39d02]/35 bg-[#14110a]/85 px-4 py-2.5 text-xs leading-relaxed text-[#bfae86]">
        รายละเอียดขั้นต่ำ ความเร็วรอบ และกติกาของแต่ละโต๊ะถูกกำหนดโดยผู้ให้บริการเกม จึงต่างกันได้ในแต่ละโต๊ะ ควรอ่านข้อมูลที่ระบบแสดงจริงก่อนนั่งโต๊ะทุกครั้ง
      </span>
    </div>
  </ContentBoxTwoNeumorphism>

  <ContentBoxFloatingBadge as="h2" title="บาคาร่าเว็บตรงควรตรวจผู้ให้บริการเกมก่อนเลือกเล่น">
    <p class="text-left text-base leading-relaxed text-[#f3e7c8]">
      คำว่าเว็บตรงหรือลิขสิทธิ์แท้ไม่ควรพิจารณาจากข้อความโฆษณาเพียงอย่างเดียว ผู้ใช้งานควรดูชื่อผู้ให้บริการเกม รายละเอียดโต๊ะ กติกา และข้อมูลระบบที่แสดง
      หากมีข้อมูลชัดเจนจะช่วยให้เปรียบเทียบเกมและตรวจสอบแหล่งที่มาได้ง่ายขึ้น
    </p>
  </ContentBoxFloatingBadge>

  <ProviderGrid />

  <ContentBoxSevenThreeNeumorphism titleright="ระบบออโต้ของ FINN20 ช่วยลดขั้นตอนด้านบัญชีและธุรกรรม">
    <Picture
      slot="left"
      src={imgReferFriend}
      loading="lazy"
      fetchpriority="low"
      widths={[300, 450, 600]}
      sizes="(max-width: 768px) calc(100vw - 6rem), 380px"
      decoding="async"
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      quality={80}
      alt={altReferFriend}
      class="mx-auto h-auto w-full rounded-2xl border border-[#fdd323]/40 shadow-[0_10px_30px_rgba(253,211,35,0.28)]"
    />
    <p slot="right" class="text-left text-base leading-relaxed text-[#f3e7c8]">
      สมาชิก FINN20 สามารถตรวจยอด ประวัติรายการ และสถานะธุรกรรมผ่านระบบเดียวได้ ก่อนยืนยันควรตรวจชื่อบัญชี จำนวนเงิน และข้อมูลรับเงินให้ครบ หากรายการเดิมยังดำเนินการอยู่ควรรอระบบอัปเดตก่อนทำรายการใหม่
      เพื่อลดความซ้ำซ้อน
    </p>
  </ContentBoxSevenThreeNeumorphism>

  <ContentBox as="h2" title="คำว่าไม่ล็อคผลควรดูจากความโปร่งใสของตัวเกม">
    <p class="text-left text-base leading-relaxed text-[#f3e7c8]">
      ข้อความไม่ล็อคผลควรพิจารณาร่วมกับวิธีดำเนินเกม ผู้ให้บริการ และขั้นตอนการตัดสินผล หากเป็นบาคาร่าแบบสด ผู้เล่นสามารถดูการดำเนินเกมแบบเรียลไทม์ได้
      แต่ไม่ควรตีความว่าคำดังกล่าวเป็นการรับประกันความยุติธรรมโดยอัตโนมัติ
    </p>
  </ContentBox>

  <LoginRtpSection />

  <ContentBoxSevenThreeFloatingBadge title="ทำความเข้าใจอัตราจ่ายบน FINN20 ก่อนเลือก Banker Player หรือ Tie">
    <Picture
      slot="left"
      src={imgFinnHour}
      loading="lazy"
      fetchpriority="low"
      widths={[300, 450, 600]}
      sizes="(max-width: 768px) calc(100vw - 6rem), 380px"
      decoding="async"
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      quality={80}
      alt={altFinnHour}
      class="mx-auto h-auto w-full rounded-2xl border border-[#fdd323]/40 shadow-[0_10px_30px_rgba(253,211,35,0.28)]"
    />
    <p slot="right" class="text-left text-base leading-relaxed text-[#f3e7c8]">
      ตัวเลือก Banker, Player และ Tie มีอัตราจ่ายและความเสี่ยงแตกต่างกัน ผู้ใช้ FINN20 ควรตรวจรายละเอียดของโต๊ะ โดยเฉพาะค่าคอมมิชชันและเงื่อนไขเฉพาะก่อนวางเดิมพัน
      การเข้าใจข้อมูลเหล่านี้ช่วยให้เลือกวงเงินได้เหมาะสมกว่าการตามผลจากรอบที่ผ่านมา
    </p>
  </ContentBoxSevenThreeFloatingBadge>

  <LatestWinnersPremium />

  <ContentBoxTwoFloatingBadge as="h2" title="จ่ายไวบน FINN20 ควรตรวจจากสถานะรายการจริง">
    <p slot="left" class="text-left text-base leading-relaxed text-[#f3e7c8]">
      คำว่าจ่ายไวของ FINN20 ควรใช้ประกอบกับข้อมูลสถานะธุรกรรมจริงในระบบ ก่อนถอนควรตรวจยอดคงเหลือ ข้อมูลบัญชี และเงื่อนไขโปรโมชั่น หากรายการล่าช้าควรเก็บเวลา จำนวนเงิน และเลขอ้างอิงไว้จนกว่าจะตรวจสอบเสร็จ
      ไม่ควรถือเป็นการรับประกันทุกกรณี
    </p>

    <div slot="right" class="flex flex-col gap-3 rounded-2xl border border-[#fdd323]/30 bg-[#1f1a10]/80 p-5">
      <p class="flex items-center gap-2 text-sm font-black tracking-widest text-[#fdd323] uppercase">
        <span aria-hidden="true">🧾</span>
        สี่อย่างที่ควรเก็บไว้ระหว่างรอผลรายการ
      </p>
