---
import MainLayout from "../layouts/MainLayout.astro";
import Announcement from "../components/Announcement5.astro";
import ContentBoxPremium from "../components/ContentBoxPremium.astro";
import ContentBoxCyberCut from "../components/ContentBoxCyberCut.astro";
import ContentBoxSevenThreePremium from "../components/ContentBoxSevenThreePremium.astro";
import ContentBoxSevenThreeCyberCut from "../components/ContentBoxSevenThreeCyberCut.astro";
import ContentBoxTwo from "../components/ContentBoxTwo.astro";
import ContentBoxTwoPremium from "../components/ContentBoxTwoPremium.astro";
import ContentBoxSpecial from "../components/ContentBoxSpecial.astro";
import ProviderGrid from "../components/ProviderGrid.astro";
import LoginRtpSection from "../components/LoginRtpSection.astro";
import LatestWinners from "../components/LatestWinners4.astro";
import ReviewCardSumo2 from "../components/ReviewCardSumo2.astro";
import SmoothCarousel from "../components/SmoothCarousel.astro";
import Faq from "../components/Faq2.astro";
import Navfoot from "../components/Navfoot.astro";

import { Picture } from "astro:assets";
import { pageGraph } from "../lib/schema";

// Slides live only inside a ContentBoxSevenThree* block and there are at most
// two of those per rebrand — both are spent here.
//
// slide4 prints "วงล้อไก่นำโชค" with a wheel of prizes around the rooster, i.e.
// "pick something from a spread of options", which is the choose-a-game-by-
// provider idea of docx H2-1; slide2 prints "ฝากครั้งแรก รับเพิ่ม 20%", a
// deposit transaction, which is what the H2-5 transaction-status section is
// about. slide1 (สมาชิกใหม่ รับโบนัส 50%) and slide3 (นาทีทอง 12:00–14:00) stay
// unused here and keep rendering in SmoothCarousel and on /promotion.
//
// banner2.png is NOT imported anywhere: it predates this asset drop.
// banner1/banner1-mobile/og.png are the hero and the share card, and belong to
// MainLayout alone.
import imgLuckyWheel from "../assets/slide4.png";
import imgFirstDeposit from "../assets/slide2.png";

const pageTitle = "CHICKYLUCKY | สล็อตเกมลิขสิทธิ์แท้ API ตรง แตกง่ายจ่ายไวปลอดภัย";
const pageHeading = "CHICKYLUCKY สล็อตเกมลิขสิทธิ์แท้ API ตรง แตกง่ายจ่ายไวปลอดภัย";

// The docx Main SEO Meta Description, verbatim at the length it was written
// (122 characters). DESC_MIN does not apply to the home page — verify-build.mjs
// exempts it precisely so the brand's own copy ships unpadded. Do not top it up
// to 150.
const pageDescription = "CHICKYLUCKY สล็อตเกมลิขสิทธิ์แท้ 100% API ตรง รองรับมือถือ ระบบใช้งานสะดวก ปลอดภัย พร้อมเกมหลากหลายและตรวจสอบรายการได้ง่าย";

// The ticker default in Announcement5 is what sub-pages get; the home page
// always passes its own copy so the two never drift apart silently. No leading
// emoji — the marquee renders the string twice.
const announcement =
  "CHICKYLUCKY รวมเกมสล็อตจากผู้ให้บริการหลายรายไว้ในระบบเดียว เชื่อมต่อผ่าน API ตรง เลือกเกมตามค่าย ธีม หรือรูปแบบฟีเจอร์ได้จากหน้าเดียว • ก่อนเลือกเกมควรตรวจกติกา ตารางการจ่าย และระดับความผันผวนให้เหมาะกับงบและสไตล์การเล่น • คำว่าเกมลิขสิทธิ์แท้ควรพิจารณาจากชื่อผู้ให้บริการและรายละเอียดที่ระบบแสดง ไม่ใช่จากข้อความโฆษณาเพียงอย่างเดียว • ควรตรวจยอดคงเหลือ ประวัติฝากถอน และสถานะรายการจากหน้าบัญชีทุกครั้ง และหลีกเลี่ยงการส่งคำขอซ้ำขณะรายการเดิมยังดำเนินการอยู่ • แตกง่ายจ่ายไวไม่ใช่การรับประกันผล ควรกำหนดวงเงินก่อนเริ่มเล่นทุกครั้ง";

const altLuckyWheel =
  "แบนเนอร์โปรโมชั่น CHICKYLUCKY ข้อความ วงล้อไก่นำโชค ลุ้นเครดิตฟรีสูงสุด 888 บาท หมุนฟรีทุกวัน ลุ้นรับทันที และปุ่ม หมุนเลย ภาพวงล้อเสี่ยงโชคสีแดง-ครีมมีตัวเลข 888 200 100 50 30 20 และรูปไก่ตรงกลาง ข้างขวาเป็นผู้หญิงในชุดสีแดง-เหลืองชี้นิ้วขึ้น ล้อมด้วยเหรียญทองและชิปคาสิโนบนพื้นหลังสีแดงเข้ม";

const altFirstDeposit =
  "แบนเนอร์โปรโมชั่น CHICKYLUCKY ข้อความ ฝากครั้งแรก รับเพิ่ม 20% คุ้มตั้งแต่ฝากแรก และปุ่ม ฝากเลย ภาพผู้หญิงในชุดสีแดง-เหลืองยืนกอดอก ข้างหลังเป็นตู้สล็อต JACKPOT 777 มีไก่สวมผ้าคลุมสีแดง กองเหรียญทอง ชิปคาสิโน และไพ่ A กับ K บนพื้นหลังสีแดงเข้ม";

// The docx Q&A block, verbatim. Passed as an explicit prop rather than left to
// Faq2's own default, so the rendered markup and the FAQ JSON-LD below come out
// of the same array.
const faqs = [
  {
    q: "CHICKYLUCKY ใช้ระบบ API ตรงหมายความว่าอย่างไร?",
    a: "โดยทั่วไปหมายถึงการเชื่อมต่อระบบเว็บไซต์กับผู้ให้บริการเกมผ่าน API โดยตรง แต่ผู้ใช้งานควรตรวจสอบข้อมูลผู้ให้บริการและรายละเอียดที่เว็บไซต์แสดงประกอบด้วย",
  },
  {
    q: "เกมลิขสิทธิ์แท้ของ CHICKYLUCKY ตรวจสอบได้อย่างไร?",
    a: "ควรดูชื่อผู้ให้บริการเกม ข้อมูลที่แสดงในหน้าเกม และรายละเอียดจากช่องทางหลักของเว็บไซต์ ไม่ควรตัดสินจากข้อความโฆษณาเพียงอย่างเดียว",
  },
  {
    q: "คำว่าแตกง่ายจ่ายไวรับประกันผลหรือไม่?",
    a: "ไม่สามารถรับประกันผลของเกมสล็อตหรือระยะเวลาธุรกรรมทุกกรณีได้ ผลลัพธ์ขึ้นอยู่กับเกม สถานะระบบ บัญชี และเงื่อนไขที่เกี่ยวข้อง",
  },
];

// Homepage: no breadcrumb — there is no trail above the root.
const graph = pageGraph(Astro, {
  name: pageHeading,
  description: pageDescription,
  faqs,
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement message={announcement} />

  <ContentBoxPremium as="h1" title={pageHeading}>
    <p class="text-left text-base leading-relaxed text-[#fdf3d8]">
      <strong class="text-[#fde41a]">CHICKYLUCKY</strong> เป็นแพลตฟอร์มเกมสล็อตออนไลน์ที่เน้นการเชื่อมต่อเกมผ่านระบบ API ตรงและการเข้าถึงเกมจากผู้ให้บริการหลายรูปแบบ รองรับทั้งมือถือและคอมพิวเตอร์ พร้อมระบบบัญชี
      โปรโมชั่น และธุรกรรมที่จัดการจากหน้าเดียว ผู้ใช้งานควรตรวจสอบข้อมูลเกม กติกา และเงื่อนไขต่าง ๆ ก่อนเริ่มทุกครั้ง
    </p>
  </ContentBoxPremium>

  <ContentBoxSevenThreePremium titleright="เลือกเกมสล็อตจากผู้ให้บริการได้ง่ายบน CHICKYLUCKY">
    <Picture
      slot="left"
      src={imgLuckyWheel}
      loading="lazy"
      fetchpriority="low"
      widths={[300, 450, 600]}
      sizes="(max-width: 768px) calc(100vw - 6rem), 380px"
      decoding="async"
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      quality={80}
      alt={altLuckyWheel}
      class="mx-auto h-auto w-full rounded-2xl border border-[#fde41a]/40 shadow-[0_10px_30px_rgba(224,27,36,0.3)]"
    />
    <p slot="right" class="text-left text-base leading-relaxed text-[#fdf3d8]">
      ภายใน CHICKYLUCKY สามารถจัดหมวดเกมตามผู้ให้บริการ ธีม หรือรูปแบบฟีเจอร์ ช่วยให้ผู้เล่นค้นหาเกมที่สนใจได้สะดวกขึ้น ก่อนเลือกควรตรวจสอบกติกา ตารางการจ่าย และระดับความผันผวนของแต่ละเกม
      เพื่อให้เหมาะกับงบและสไตล์การเล่นของตนเอง
    </p>
  </ContentBoxSevenThreePremium>

  <ProviderGrid />

  <ContentBoxTwo as="h2" titleleft="API ตรงช่วยให้การเชื่อมต่อเกมเป็นระบบมากขึ้น" iconleft="🔌">
    <p slot="left" class="text-left text-base leading-relaxed text-[#fdf3d8]">
      การเชื่อมต่อผ่าน API ช่วยส่งข้อมูลระหว่างหน้าเว็บไซต์กับระบบเกมโดยตรงในเชิงเทคนิค ทำให้การเปิดเกมและอัปเดตสถานะต่าง ๆ เป็นขั้นตอนเดียวกัน อย่างไรก็ตาม ความเสถียรจริงอาจขึ้นอยู่กับผู้ให้บริการเกม
      เครือข่าย และระบบของเว็บไซต์ในช่วงเวลานั้นด้วย
    </p>

    <div slot="right" class="flex flex-col gap-3 rounded-2xl border border-[#e01b24]/35 bg-[#1c0100]/75 p-5">
      <p class="flex items-center gap-2 text-sm font-black tracking-widest text-[#fde41a] uppercase">
        <span aria-hidden="true">📶</span>
        สี่จุดที่ควรไล่ดูเมื่อเกมเปิดไม่ขึ้น
      </p>
      <span class="flex items-start gap-2.5 text-sm text-[#fdf3d8]">
        <span aria-hidden="true" class="mt-0.5 shrink-0 text-[#ff5252]">①</span>
        ตรวจสัญญาณอินเทอร์เน็ต แล้วลองสลับระหว่าง Wi-Fi กับเน็ตมือถือดูหนึ่งรอบ
      </span>
      <span class="flex items-start gap-2.5 text-sm text-[#fdf3d8]">
        <span aria-hidden="true" class="mt-0.5 shrink-0 text-[#ff5252]">②</span>
        ปิดเกมแล้วเปิดใหม่จากหน้ารวมเกม แทนการกดซ้ำค้างไว้ในหน้าเดิม
      </span>
      <span class="flex items-start gap-2.5 text-sm text-[#fdf3d8]">
        <span aria-hidden="true" class="mt-0.5 shrink-0 text-[#ff5252]">③</span>
        ตรวจว่าเบราว์เซอร์ที่ใช้อยู่เป็นเวอร์ชันล่าสุดและเปิดจากช่องทางหลักของเว็บไซต์
      </span>
      <span class="flex items-start gap-2.5 text-sm text-[#fdf3d8]">
        <span aria-hidden="true" class="mt-0.5 shrink-0 text-[#ff5252]">④</span>
        ถ้ายังเปิดไม่ขึ้น ให้เก็บชื่อเกม เวลา และอาการที่พบไว้แจ้งทีมงาน
      </span>
      <span class="mt-1 rounded-xl border border-[#fde41a]/35 bg-[#3a0806]/80 px-4 py-2.5 text-xs leading-relaxed text-[#e0bfa8]">
        ความเสถียรของการเชื่อมต่อขึ้นอยู่กับผู้ให้บริการเกม เครือข่าย และระบบของเว็บไซต์ในช่วงเวลานั้น จึงอาจไม่เท่ากันในแต่ละช่วงเวลาและแต่ละเกม
      </span>
    </div>
  </ContentBoxTwo>

  <ContentBoxCyberCut as="h2" title="ตรวจสอบแหล่งที่มาของเกมบน CHICKYLUCKY ก่อนเริ่มเล่น">
    <p class="text-left text-base leading-relaxed text-[#fdf3d8]">
      หาก CHICKYLUCKY ระบุว่าเป็นเกมลิขสิทธิ์แท้ 100% ผู้ใช้งานควรพิจารณาข้อมูลผู้ให้บริการ ชื่อเกม และรายละเอียดที่แสดงในระบบประกอบ ไม่ควรอาศัยคำโฆษณาเพียงอย่างเดียว
      การมีข้อมูลที่ตรวจสอบได้ช่วยให้ตัดสินใจเลือกเกมได้อย่างรอบคอบมากขึ้น
    </p>
  </ContentBoxCyberCut>

  <ContentBoxTwoPremium as="h2" title="แตกง่ายควรพิจารณาควบคู่กับความผันผวนของเกม">
    <p slot="left" class="text-left text-base leading-relaxed text-[#fdf3d8]">
      คำว่าแตกง่ายมักใช้สื่อถึงเกมที่มีฟีเจอร์โบนัสหรือจังหวะลุ้นรางวัลน่าสนใจ แต่ไม่ได้หมายความว่าจะได้ผลลัพธ์ตามคาดทุกครั้ง ผู้เล่นควรตรวจสอบอัตราจ่าย ความผันผวน และเงื่อนไขของเกม
      พร้อมกำหนดวงเงินก่อนเริ่มเล่น
    </p>

    <div slot="right" class="flex flex-col gap-3 rounded-2xl border border-[#fde41a]/30 bg-[#1c0100]/75 p-5">
      <p class="flex items-center gap-2 text-sm font-black tracking-widest text-[#fde41a] uppercase">
        <span aria-hidden="true">🎯</span>
        สี่ข้อที่ควรชั่งก่อนกดเดิมพันรอบแรก
      </p>
      <span class="flex items-start gap-2.5 text-sm text-[#fdf3d8]">
        <span aria-hidden="true" class="mt-0.5 shrink-0 text-[#ff5252]">①</span>
        อัตราจ่ายที่เกมระบุไว้เป็นค่าเฉลี่ยระยะยาว ไม่ใช่ผลของรอบใดรอบหนึ่ง
      </span>
      <span class="flex items-start gap-2.5 text-sm text-[#fdf3d8]">
        <span aria-hidden="true" class="mt-0.5 shrink-0 text-[#ff5252]">②</span>
        ความผันผวนต่ำจ่ายย่อยถี่ ส่วนความผันผวนสูงต้องรอรอบใหญ่และใช้เงินทุนต่างกัน
      </span>
      <span class="flex items-start gap-2.5 text-sm text-[#fdf3d8]">
        <span aria-hidden="true" class="mt-0.5 shrink-0 text-[#ff5252]">③</span>
        อ่านเงื่อนไขของรอบโบนัสและตัวคูณให้จบก่อนปรับเงินเดิมพันต่อรอบ
      </span>
      <span class="flex items-start gap-2.5 text-sm text-[#fdf3d8]">
        <span aria-hidden="true" class="mt-0.5 shrink-0 text-[#ff5252]">④</span>
        กำหนดวงเงินต่อรอบและวงเงินรวมไว้ล่วงหน้า แล้วหยุดเมื่อถึงเพดานที่ตั้งไว้
      </span>
      <span class="mt-1 rounded-xl border border-[#fde41a]/35 bg-[#3a0806]/80 px-4 py-2.5 text-xs leading-relaxed text-[#e0bfa8]">
        คำว่าแตกง่ายจ่ายไวไม่ใช่การรับประกันผล ผลลัพธ์ขึ้นอยู่กับเกม สถานะระบบ บัญชี และเงื่อนไขที่เกี่ยวข้องในแต่ละกรณี
      </span>
    </div>
  </ContentBoxTwoPremium>

  <LoginRtpSection />

  <ContentBoxSevenThreeCyberCut titleright="ติดตามสถานะธุรกรรมผ่านระบบของ CHICKYLUCKY">
    <Picture
      slot="left"
      src={imgFirstDeposit}
      loading="lazy"
      fetchpriority="low"
      widths={[300, 450, 600]}
      sizes="(max-width: 768px) calc(100vw - 6rem), 380px"
      decoding="async"
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      quality={80}
      alt={altFirstDeposit}
      class="mx-auto h-auto w-full rounded-2xl border border-[#fde41a]/40 shadow-[0_10px_30px_rgba(224,27,36,0.3)]"
    />
    <p slot="right" class="text-left text-base leading-relaxed text-[#fdf3d8]">
      สมาชิก CHICKYLUCKY ควรตรวจสอบยอดคงเหลือ ประวัติฝากถอน และสถานะรายการผ่านหน้าบัญชีทุกครั้ง หากพบรายการล่าช้าควรเก็บเวลา จำนวนเงิน และข้อมูลอ้างอิงไว้สำหรับตรวจสอบ
      โดยหลีกเลี่ยงการส่งคำขอซ้ำขณะที่รายการเดิมยังดำเนินการอยู่
    </p>
  </ContentBoxSevenThreeCyberCut>

  <LatestWinners />

  <ContentBoxSpecial as="h2" title="ใช้งาน CHICKYLUCKY อย่างปลอดภัยด้วยการดูแลบัญชี" iconleft="🔐" iconright="🛡️">
    <p slot="left" class="text-left text-base leading-relaxed text-[#fdf3d8]">
      การใช้งาน CHICKYLUCKY ควรเริ่มจากช่องทางหลัก ตั้งรหัสผ่านที่ไม่ซ้ำกับบริการอื่น และไม่เปิดเผยรหัสยืนยันแก่บุคคลภายนอก ควรหลีกเลี่ยง Wi-Fi สาธารณะเมื่อต้องทำธุรกรรม
      และออกจากระบบทุกครั้งเมื่อใช้อุปกรณ์ที่ไม่ใช่ของตนเอง
    </p>

    <div slot="right" class="flex flex-col gap-2.5">
      <p class="text-sm font-black tracking-widest text-[#fde41a] uppercase">ห้าจุดที่ควรทำเป็นนิสัยทุกครั้งที่เข้าใช้งาน</p>
      <span class="flex items-start gap-2.5 text-sm text-[#fdf3d8]">
        <span aria-hidden="true" class="mt-0.5 shrink-0 text-[#ff5252]">①</span>
        เข้าใช้งานจากช่องทางหลักของเว็บไซต์เท่านั้น
      </span>
      <span class="flex items-start gap-2.5 text-sm text-[#fdf3d8]">
        <span aria-hidden="true" class="mt-0.5 shrink-0 text-[#ff5252]">②</span>
