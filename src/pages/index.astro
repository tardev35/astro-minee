---
import MainLayout from "../layouts/MainLayout.astro";
import Announcement from "../components/Announcement3.astro";
import ContentBoxPremium from "../components/ContentBoxPremium.astro";
import ContentBoxCyberCut from "../components/ContentBoxCyberCut.astro";
import ContentBoxTwoPremium from "../components/ContentBoxTwoPremium.astro";
import ContentBoxSevenThreePremium from "../components/ContentBoxSevenThreePremium.astro";
import ContentBoxSevenThreeCyberCut from "../components/ContentBoxSevenThreeCyberCut.astro";
import ContentBox from "../components/ContentBox.astro";
import ContentBoxSpecial from "../components/ContentBoxSpecial.astro";
import ProviderGrid from "../components/ProviderGrid.astro";
import LoginRtpSection from "../components/LoginRtpSection.astro";
import LatestWinners2 from "../components/LatestWinners2.astro";
import Faq3 from "../components/Faq3.astro";
import SmoothCarousel from "../components/SmoothCarousel.astro";
import ReviewCardSumo2 from "../components/ReviewCardSumo2.astro";
import Navfoot from "../components/Navfoot.astro";

import { Picture } from "astro:assets";
import { pageGraph } from "../lib/schema";

// Slides live only inside a ContentBoxSevenThree* block and there are at most
// two of those per rebrand — both are spent here.
//
// slide4 prints "วงล้อราชัน / ฝากครบ 500 รับสิทธิ์หมุนฟรี 1 ครั้ง" around a prize
// wheel whose segments read 68 / 168 / 368 เครดิต beside ของรางวัล: one
// promotion carrying a printed condition and several printed values, which is
// docx H2-3's point — check the minimum, the qualifying games and the withdrawal
// terms before taking a promotion — in picture form.
// slide2 prints "เช็กอิน 5 วัน / รับกล่องสุ่มโบนัส" over a five-step row where
// each day is a numbered marker joined to the next by an arrow, the same
// step-by-step shape as docx H2-4's point about working an auto transaction one
// checked step at a time.
// slide1 and slide3 stay unused on this page and keep rendering in
// SmoothCarousel and on /promotion.
//
// banner2.png is NOT imported anywhere: it predates this asset drop.
// banner1/banner1-mobile/og.png are the hero and the share card and belong to
// MainLayout alone.
import imgPrizeWheel from "../assets/slide4.png";
import imgCheckIn from "../assets/slide2.png";

// The docx "Main SEO" Title and H1, verbatim. They are the brand's own copy,
// not a draft to tidy.
const pageTitle = "MVP928 | เว็บตรงสล็ออันดับหนึ่ง รวมโปรสุดคุ้ม ระบบใหม่ออโต้ แตกง่าย";
const pageHeading = "MVP928 เว็บตรงสล็ออันดับหนึ่ง รวมโปรสุดคุ้ม ระบบใหม่ออโต้ แตกง่าย";

// The docx Main SEO Meta Description, verbatim at the length it was written.
// DESC_MIN does not apply to the home page — verify-build.mjs exempts it
// precisely so the brand's own copy ships unpadded. Do not top it up to 150.
const pageDescription = "MVP928 สล็อตเว็บตรงระบบใหม่ออโต้ รวมโปรโมชั่นหลายรูปแบบ พร้อมเกมยอดนิยม ระบบสมาชิกใช้งานง่าย และข้อมูลรายการตรวจสอบได้สะดวก";

// Byte-identical to Announcement3's own default, which is what every sub-page
// calling <Announcement /> bare lands on. Passing it explicitly here keeps the
// home page and the rest of the site from drifting apart silently. No leading
// emoji — the marquee renders the string twice.
const announcement =
  "MVP928 สล็อตเว็บตรงระบบใหม่ออโต้ รวมเกม โปรโมชั่น และข้อมูลบัญชีไว้ที่จุดเดียว ช่วยลดการสลับหน้าและขั้นตอนที่ไม่จำเป็น • คำว่าอันดับหนึ่งเป็นถ้อยคำทางการตลาด ควรดูข้อมูลค่ายเกม ระบบบัญชี ช่องทางติดต่อ และเงื่อนไขธุรกรรมประกอบกัน • โปรโมชั่นมีทั้งโบนัสสมาชิกใหม่ สิทธิ์ตามยอดฝาก และกิจกรรมตามช่วงเวลา ก่อนรับควรตรวจยอดขั้นต่ำ เกมที่ร่วมรายการ และเงื่อนไขการถอนให้ครบ • ระบบออโต้ช่วยลดขั้นตอนจัดการรายการ ควรตรวจชื่อบัญชีและจำนวนเงินก่อนยืนยัน หากรายการเดิมยังดำเนินการอยู่ควรรอผลจากระบบก่อนส่งใหม่ • คำว่าแตกง่ายไม่ใช่การรับประกันผลลัพธ์ ควรดู RTP ความผันผวน และตารางจ่ายประกอบ พร้อมกำหนดวงเงินและเวลาเล่นไว้ล่วงหน้า";

// Each alt is the text printed on that slide plus the scene around it, read off
// the artwork itself.
const altPrizeWheel =
  "แบนเนอร์โปรโมชั่น MVP928 หัวข้อตัวหนาเขียนว่า วงล้อราชัน ใต้ลงมาเป็นบรรทัดเงื่อนไขเขียนว่า ฝากครบ 500 รับสิทธิ์หมุนฟรี 1 ครั้ง ด้านขวาเป็นวงล้อเสี่ยงโชคขนาดใหญ่สีทองสลับดำ ช่องบนวงล้อเขียนว่า 68 เครดิต 168 เครดิต และ 368 เครดิต สลับกับช่องที่เขียนว่า ของรางวัล ช่องรูปหีบสมบัติ ช่องรูปถุงเงิน และช่องรูปเพชร ใต้วงล้อเขียนว่า หมุนรับสิทธิ์ลุ้นของรางวัลได้ทุกวัน ด้านล่างเป็นปุ่มเขียนว่า หมุนเลย ด้านซ้ายของภาพเป็นผู้หญิงในชุดสีดำสลับทองแดงติดโลโก้ MVP928 ชี้นิ้วไปที่วงล้อ ด้านบนเป็นโลโก้ MVP928 ตัวอักษร MVP สีขาวเงินและเลข 928 สีส้มพีชบนพื้นหลังสีดำ";

const altCheckIn =
  "แบนเนอร์โปรโมชั่น MVP928 หัวข้อตัวหนาเขียนว่า เช็กอิน 5 วัน บรรทัดถัดมาเขียนว่า รับกล่องสุ่มโบนัส ใต้ลงมาเขียนว่า ลุ้น 28 / 58 / 128 เครดิต ถัดลงมาเป็นแถวห้าขั้นตอนเขียนว่า วันที่ 1 วันที่ 2 วันที่ 3 วันที่ 4 และ วันที่ 5 แต่ละขั้นเป็นเครื่องหมายถูกสีทองในวงกลมเชื่อมต่อกันด้วยลูกศร ใต้แถวเขียนว่า ทำเช็กอินต่อเนื่องครบ รับสิทธิ์สุ่มทันที ถัดลงมาเป็นหีบสมบัติสามใบเขียนว่า 28 เครดิต 58 เครดิต และ 128 เครดิต ด้านล่างเป็นปุ่มเขียนว่า เช็กอินเลย ด้านซ้ายของภาพเป็นผู้หญิงในชุดสีดำสลับทองแดงติดโลโก้ MVP928 ชี้นิ้วไปที่แถวขั้นตอน ด้านบนเป็นโลโก้ MVP928 ตัวอักษร MVP สีขาวเงินและเลข 928 สีส้มพีชบนพื้นหลังสีดำ";

// The docx Q&A block, verbatim. Passed as an explicit prop rather than left to
// Faq3's own default, so the rendered markup and the FAQ JSON-LD below come out
// of the same array.
const faqs = [
  {
    q: "MVP928 มีโปรโมชั่นหลายรูปแบบหรือไม่?",
    a: "ระบบอาจมีโปรโมชั่นหลายประเภทตามช่วงเวลาและเงื่อนไข ผู้เล่นควรตรวจยอดฝาก เกมที่ร่วมรายการ และข้อกำหนดการถอนก่อนเลือกรับสิทธิ์ทุกครั้ง",
  },
  {
    q: "ระบบออโต้ของ MVP928 ช่วยเรื่องอะไร?",
    a: "ระบบออโต้ช่วยลดขั้นตอนในการจัดการบัญชีและธุรกรรม พร้อมให้สมาชิกตรวจสอบสถานะรายการได้สะดวกขึ้น โดยระยะเวลาดำเนินการอาจแตกต่างตามช่องทาง",
  },
  {
    q: "คำว่าอันดับหนึ่งและแตกง่ายของ MVP928 รับประกันผลหรือไม่?",
    a: "ไม่ควรตีความว่าเป็นการรับประกัน เพราะคำดังกล่าวเป็นข้อความทางการตลาด ผู้เล่นควรดูข้อมูลเกม กติกา RTP ความผันผวน และเงื่อนไขก่อนเริ่มเล่น",
  },
];

// Homepage: no breadcrumb — there is no trail above the root.
const graph = pageGraph(Astro, {
  name: pageHeading,
  description: pageDescription,
  faqs,
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement message={announcement} />

  <ContentBoxPremium as="h1" title={pageHeading}>
    <p class="text-left text-base leading-relaxed text-[#ece0d6]">
      <strong class="text-[#f0b243]">MVP928</strong> เป็นแพลตฟอร์มสล็อตออนไลน์ที่เน้นการใช้งานผ่านระบบเว็บตรง พร้อมระบบออโต้และโปรโมชั่นหลายรูปแบบภายในบัญชีเดียว สมาชิกสามารถเลือกเกม ตรวจสอบสิทธิ์ และติดตามสถานะรายการได้สะดวก
      รองรับการใช้งานผ่านมือถือ โดยควรศึกษากติกา เงื่อนไขโปรโมชั่น และข้อมูลเกมก่อนเริ่มทุกครั้ง
    </p>
  </ContentBoxPremium>

  <ContentBoxCyberCut as="h2" title="ระบบใหม่ของ MVP928 ช่วยให้เข้าถึงเกมได้ง่ายขึ้น">
    <p class="text-left text-base leading-relaxed text-[#ece0d6]">
      ภายใน MVP928 ระบบถูกออกแบบให้ผู้เล่นค้นหาเกม โปรโมชั่น และข้อมูลบัญชีได้จากจุดเดียว ช่วยลดการสลับหน้าและขั้นตอนที่ไม่จำเป็น
      การจัดหมวดเกมที่ชัดเจนยังช่วยให้เปรียบเทียบฟีเจอร์และรูปแบบการเล่นก่อนเลือกได้สะดวกมากขึ้น
    </p>
  </ContentBoxCyberCut>

  <ProviderGrid />

  <ContentBoxTwoPremium as="h2" title="เว็บตรงอันดับหนึ่งควรดูจากข้อมูลมากกว่าคำโปรโมต">
    <p slot="left" class="text-left text-base leading-relaxed text-[#ece0d6]">คำว่าอันดับหนึ่งเป็นถ้อยคำทางการตลาดที่ใช้สื่อถึงความนิยม แต่ไม่ควรใช้เป็นหลักฐานเพียงอย่างเดียว</p>
    <p slot="right" class="text-left text-base leading-relaxed text-[#ece0d6]">
      ผู้เล่นควรดูข้อมูลค่ายเกม ระบบบัญชี ช่องทางติดต่อ และเงื่อนไขธุรกรรมประกอบกัน เพื่อให้การตัดสินใจมีข้อมูลรองรับมากขึ้น
    </p>
  </ContentBoxTwoPremium>

  <ContentBoxSevenThreePremium titleright="รวมโปรสุดคุ้มบน MVP928 ควรเลือกให้ตรงกับงบ">
    <Picture
      slot="left"
      src={imgPrizeWheel}
      loading="lazy"
      fetchpriority="low"
      widths={[300, 450, 600]}
      sizes="(max-width: 768px) calc(100vw - 6rem), 380px"
      decoding="async"
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      quality={80}
      alt={altPrizeWheel}
      class="mx-auto h-auto w-full rounded-2xl border border-[#ef6a17]/45 shadow-[0_10px_30px_rgba(239,106,23,0.28)]"
    />
    <p slot="right" class="text-left text-base leading-relaxed text-[#ece0d6]">
      โปรโมชั่นของ MVP928 อาจมีทั้งโบนัสสมาชิกใหม่ สิทธิ์ตามยอดฝาก หรือกิจกรรมตามช่วงเวลา ก่อนรับควรตรวจยอดขั้นต่ำ เกมที่ร่วมรายการ และเงื่อนไขการถอนให้ครบ
      โปรที่เหมาะควรสัมพันธ์กับงบและพฤติกรรมการเล่นมากกว่าดูจากโบนัสสูงเพียงอย่างเดียว
    </p>
  </ContentBoxSevenThreePremium>

  <SmoothCarousel />

  <ContentBoxSevenThreeCyberCut as="h2" titleright="ระบบออโต้ช่วยจัดการรายการได้เป็นขั้นตอน">
    <Picture
      slot="left"
      src={imgCheckIn}
      loading="lazy"
      fetchpriority="low"
      widths={[300, 450, 600]}
      sizes="(max-width: 768px) calc(100vw - 6rem), 380px"
      decoding="async"
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      quality={80}
      alt={altCheckIn}
      class="mx-auto h-auto w-full rounded-2xl border border-[#f0b243]/45 shadow-[0_10px_30px_rgba(179,74,8,0.32)]"
    />
    <p slot="right" class="text-left text-base leading-relaxed text-[#ece0d6]">
      ระบบออโต้ช่วยลดขั้นตอนในการจัดการบัญชีและธุรกรรม ผู้ใช้งานควรตรวจชื่อบัญชี จำนวนเงิน และสถานะรายการก่อนยืนยันทุกครั้ง หากรายการเดิมยังดำเนินการอยู่ควรรอผลจากระบบก่อนส่งใหม่
      เพื่อลดโอกาสเกิดรายการซ้ำและความคลาดเคลื่อน
    </p>
  </ContentBoxSevenThreeCyberCut>

  <LatestWinners2 />

  <ContentBox as="h2" title="เลือกเกมสล็อตบน MVP928 จาก RTP และความผันผวน">
    <p class="text-left text-base leading-relaxed text-[#ece0d6]">
      ผู้เล่น MVP928 ควรพิจารณา RTP ที่ผู้ให้บริการระบุ ฟีเจอร์โบนัส และระดับความผันผวนของเกมร่วมกัน เกมแต่ละประเภทให้ประสบการณ์ต่างกัน
      การเข้าใจข้อมูลเหล่านี้ช่วยให้เลือกวงเงินและรูปแบบเกมได้เหมาะกับงบมากกว่าการเลือกจากคำว่าแตกง่ายอย่างเดียว
    </p>
  </ContentBox>

  <LoginRtpSection />

  <ContentBoxSpecial as="h2" title="แตกง่ายบน MVP928 ไม่ใช่การรับประกันผลลัพธ์" iconleft="📣" iconright="🛡️">
    <div slot="left">
      <p class="text-left text-base leading-relaxed text-[#ece0d6]">คำว่าแตกง่ายของ MVP928 เป็นข้อความทางการตลาดที่ใช้สื่อถึงความน่าสนใจของเกม แต่ไม่สามารถรับประกันรางวัลหรือกำไรได้</p>
    </div>
    <div slot="right">
      <p class="text-left text-base leading-relaxed text-[#ece0d6]">ผู้เล่นควรกำหนดวงเงินและเวลาเล่นไว้ล่วงหน้า และหลีกเลี่ยงการเพิ่มเดิมพันเพื่อตามคืนยอดเสีย</p>
    </div>
  </ContentBoxSpecial>

  <Faq3 title="คำถามที่พบบ่อยเกี่ยวกับ MVP928" faqs={faqs} />

  <div class="relative z-10 mx-auto mb-10 flex flex-nowrap justify-center gap-3 px-4 sm:gap-6">
    <a
      href="/login"
      class="group relative flex flex-1 items-center justify-center rounded-full border-2 border-[#f7ece2]/55 bg-gradient-to-r from-[#2a1508] via-[#1c0e05] to-[#0b0502] px-4 py-3 text-sm font-black whitespace-nowrap text-[#f7ece2] shadow-[0_10px_30px_rgba(239,106,23,0.22)] transition-all duration-300 hover:-translate-y-1 hover:scale-105 hover:border-[#f0b243] hover:shadow-[0_15px_40px_rgba(239,106,23,0.35)] sm:flex-none sm:px-10 sm:py-3.5 sm:text-base">
      เข้าสู่ระบบ
    </a>

    <a
      href="/register"
      class="group relative flex flex-1 items-center justify-center rounded-full border-2 border-[#f0b243]/70 bg-gradient-to-r from-[#f0b243] to-[#ef6a17] px-4 py-3 text-sm font-black whitespace-nowrap text-[#1c0e05] shadow-[0_10px_30px_rgba(239,106,23,0.35)] transition-all duration-300 hover:-translate-y-1 hover:scale-105 hover:border-[#f7ece2] hover:shadow-[0_15px_40px_rgba(239,106,23,0.5)] sm:flex-none sm:px-10 sm:py-3.5 sm:text-base">
      สมัครสมาชิก
    </a>
  </div>

  <ReviewCardSumo2 />

  <Navfoot />
</MainLayout>
