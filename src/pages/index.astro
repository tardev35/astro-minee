---
import MainLayout from "../layouts/MainLayout.astro";
import Announcement from "../components/AnnouncementCyber.astro";
import ContentBoxPremium from "../components/ContentBoxPremium.astro";
import ContentBox from "../components/ContentBox.astro";
import ProviderGrid from "../components/ProviderGrid.astro";
import ContentBoxSevenThreePremium from "../components/ContentBoxSevenThreePremium.astro";
import ContentBoxCyberCut from "../components/ContentBoxCyberCut.astro";
import ContentBox3ThreePremium from "../components/ContentBox3ThreePremium.astro";
import ContentBoxSevenThree from "../components/ContentBoxSevenThree.astro";
import ContentBoxSpecial from "../components/ContentBoxSpecial.astro";
import Faq from "../components/Faq.astro";
import LatestWinners4 from "../components/LatestWinners4.astro";
import LoginRtpSection from "../components/LoginRtpSection.astro";
import SmoothCarousel from "../components/SmoothCarousel.astro";
import ReviewCardSumo2 from "../components/ReviewCardSumo2.astro";
import Navfoot from "../components/Navfoot.astro";

import { Picture } from "astro:assets";
import { pageGraph } from "../lib/schema";

// Slides live only inside a ContentBoxSevenThree* block and there are at most
// two of those per rebrand — both are spent here.
//
// slide1 is a seven-day check-in calendar whose reward is a mystery box: the
// offer is real but what it pays is behind the condition, which is docx H2-3's
// point about reading a promotion's terms rather than its headline number.
// slide2 is a DAILY MISSION checklist with four ticked items and a phone in
// hand — a member's own list of what has been done and what is still open,
// the same shape as docx H2-6's "ตรวจสิทธิ์และประวัติรายการก่อนทำธุรกรรม".
// slide3 (เล่นง่าย ลุ้นสนุกทุกวัน) and slide4 (ชวนเพื่อนรับรางวัล) stay unused
// here and keep rendering in SmoothCarousel and on /promotion.
//
// banner2.png is NOT imported anywhere: it predates this asset drop.
// banner1/banner1-mobile/og.png are the hero and the share card and belong to
// MainLayout alone.
import imgCheckin from "../assets/slide1.png";
import imgDailyMission from "../assets/slide2.png";

// The docx "Main SEO" Title and H1, verbatim. They are the brand's own copy,
// not a draft to tidy.
const pageTitle = "RUAYRUAY888 | รวมค่ายเกมพนันจ่ายดี โปรแรง ฝากถอนวอลเลทสะดวก";
const pageHeading = "RUAYRUAY888 รวมค่ายเกมพนันจ่ายดี โปรแรง ฝากถอนวอลเลทสะดวก";

// The docx Main SEO Meta Description, verbatim at the length it was written
// (120 characters). DESC_MIN does not apply to the home page — verify-build.mjs
// exempts any description that appears literally in src/assets/content.txt,
// precisely so the brand's own copy ships unpadded. Do not top it up.
const pageDescription = "RUAYRUAY888 รวมค่ายเกมพนันหลายรูปแบบ โปรแรงตามเงื่อนไข รองรับ Wallet พร้อมระบบบัญชีใช้งานง่าย และตรวจสถานะรายการได้สะดวก";

// Each alt is the Thai promotional text actually printed on that slide plus the
// scene around it, read off the artwork itself. The wordmark baked into these
// files belongs to an unrelated brand, so it is written as "โลโก้เว็บไซต์" and
// never transcribed.
const altCheckin =
  "แบนเนอร์โปรโมชั่นโทนชมพูนีออน ด้านบนกลางภาพเป็นโลโก้เว็บไซต์บนพื้นดำ หัวข้อตัวหนาเขียนว่า เช็กอิน 7 วัน โดยเลข 7 เป็นตัวใหญ่ ใต้หัวข้อเป็นแถบสีชมพูเขียนว่า รับกล่องสุ่มโบนัสฟรี คู่กับไอคอนกล่องของขวัญ ถัดลงมาเป็นปฏิทินตั้งโต๊ะเจ็ดช่องเขียนว่า วันที่ 1 ถึง วันที่ 7 ทุกช่องมีเครื่องหมายถูกสีชมพู ด้านขวาเป็นตราวงกลมมีมงกุฎเขียนว่า ลุ้นรางวัลทุกวัน ข้อความลายมือด้านซ้ายเขียนว่า Play More Be Happier และ GOOD PLAY BRIGHTER DAYS มุมบนขวาเขียนว่า GAMES REWARDS FRIENDS BIGGER HAPPINESS แถบล่างสุดเขียนว่า MORE REWARDS A BRIGHTER YOU ในภาพเป็นผู้หญิงเกล้าผมสวมชุดเลื่อมสีเงินและต่างหูระย้า ด้านหน้ามีกล่องสุ่มสีดำพิมพ์โลโก้เว็บไซต์กับเครื่องหมายคำถาม กล่องของขวัญผูกโบว์ชมพู และเหรียญรูปมงกุฎวางอยู่ ฉากหลังเป็นซุ้มโค้งเรืองแสงสีชมพู";

const altDailyMission =
  "แบนเนอร์โปรโมชั่นโทนชมพูนีออน มุมบนซ้ายเป็นโลโก้เว็บไซต์บนพื้นดำ ใต้โลโก้เขียนว่า PLAY MORE WIN MORE หัวข้อตัวหนาด้านล่างเขียนว่า ภารกิจรายวัน ใต้หัวข้อเป็นแถบเขียนว่า ทำครบ รับเครดิตพิเศษทุกวัน ด้านซ้ายเป็นคลิปบอร์ดหัวข้อ DAILY MISSION มีรายการสี่บรรทัดเขียนว่า เข้าเล่นเกม ทำยอดเดิมพัน รับโบนัส และ ภารกิจพิเศษ ทุกบรรทัดมีเครื่องหมายถูกสีชมพู ด้านขวาเป็นการ์ดสามใบเขียนว่า BONUS FREE CREDIT และ CASH BACK พร้อมตราวงกลมมีมงกุฎเขียนว่า ของรางวัลเพียบ ข้อความลายมือเขียนว่า Daily Mission และ Good Game Better You แถบล่างสุดมีสี่ช่องเขียนว่า เล่น ลุ้น รับ และ ชนะ คู่กับไอคอนจอยเกม ลูกเต๋า กล่องของขวัญ และถ้วยรางวัล ในภาพเป็นผู้หญิงผมยาวสวมชุดวอร์มสีชมพูดำพิมพ์โลโก้เว็บไซต์ กำลังชี้มือมาข้างหน้าและถือโทรศัพท์ที่มีข้อความ PLAY ANYTIME ANYWHERE ฉากหลังมีลูกเต๋า จอยเกม และเหรียญรูปมงกุฎลอยอยู่";

// The docx Q&A block, verbatim. Passed as an explicit prop rather than left to
// Faq's own default, so the rendered markup and the FAQ JSON-LD below come out
// of the same array.
const faqs = [
  {
    q: "RUAYRUAY888 มีเกมจากหลายค่ายหรือไม่?",
    a: "ระบบอาจรวมเกมจากหลายผู้ให้บริการตามที่เว็บไซต์กำหนด ผู้เล่นควรตรวจประเภทเกม กติกา อัตราจ่าย และวงเงินของค่ายที่สนใจก่อนเริ่ม",
  },
  {
    q: "RUAYRUAY888 รองรับการฝากถอนผ่าน Wallet หรือไม่?",
    a: "ระบบถูกนำเสนอว่ารองรับ Wallet ตามช่องทางที่กำหนด สมาชิกควรตรวจข้อมูลบัญชี จำนวนเงิน และสถานะรายการก่อนและหลังทำธุรกรรมทุกครั้ง",
  },
  {
    q: "โปรแรงและคำว่าจ่ายดีของ RUAYRUAY888 รับประกันกำไรหรือไม่?",
    a: "ไม่สามารถรับประกันกำไรจากโปรโมชั่นหรือเกมได้ ผู้เล่นควรดูเงื่อนไขโปร อัตราจ่าย ความเสี่ยง และกำหนดงบประมาณที่เหมาะสมก่อนเริ่มเล่น",
  },
];

// Homepage: no breadcrumb — there is no trail above the root.
const graph = pageGraph(Astro, {
  name: pageHeading,
  description: pageDescription,
  faqs,
});
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <SmoothCarousel />

  <ContentBoxPremium as="h1" title={pageHeading}>
    <p class="text-left text-base leading-relaxed text-[#f6dde8]">
      <strong class="text-[#fdb4d4]">RUAYRUAY888</strong> เป็นแพลตฟอร์มพนันออนไลน์ที่รวบรวมเกมจากหลายค่ายไว้ในระบบเดียว พร้อมโปรโมชั่นหลายรูปแบบและช่องทาง Wallet สำหรับจัดการธุรกรรมผ่านมือถือ สมาชิกสามารถเลือกเกม ตรวจสอบโปรโมชั่น
      และติดตามสถานะรายการได้สะดวก ก่อนเริ่มควรศึกษากติกา อัตราจ่าย และเงื่อนไขของแต่ละค่ายให้ครบถ้วน
    </p>
  </ContentBoxPremium>

  <ContentBox as="h2" title="เปรียบเทียบค่ายเกมหลายรูปแบบได้บน RUAYRUAY888">
    <p class="text-left text-base leading-relaxed text-[#f6dde8]">
      ภายใน RUAYRUAY888 อาจมีทั้งสล็อต บาคาร่า คาสิโนสด และเกมรูปแบบอื่นจากหลายผู้ให้บริการ ผู้เล่นควรเปรียบเทียบกติกา ฟีเจอร์ อัตราจ่าย และวงเงินก่อนเลือก
      เพราะค่ายที่ได้รับความนิยมไม่จำเป็นต้องเหมาะกับรูปแบบการเล่นของทุกคน
    </p>
  </ContentBox>

  <ProviderGrid />

  <ContentBoxSevenThreePremium title="โปรแรงควรดูเงื่อนไขจริงมากกว่าจำนวนโบนัส">
    <Picture
      slot="left"
      src={imgCheckin}
      loading="lazy"
      fetchpriority="low"
      widths={[300, 450, 600]}
      sizes="(max-width: 768px) calc(100vw - 6rem), 380px"
      decoding="async"
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      quality={80}
      alt={altCheckin}
      class="mx-auto h-auto w-full rounded-2xl border border-[#f874a1]/55 shadow-[0_10px_30px_rgba(248,116,161,0.28)]"
    />
    <p slot="right" class="text-left text-base leading-relaxed text-[#f6dde8]">
      โปรโมชั่นที่ดูแรงอาจมีทั้งโบนัสสมาชิกใหม่ สิทธิ์ตามยอดฝาก หรือกิจกรรมเฉพาะช่วงเวลา ผู้เล่นควรตรวจยอดขั้นต่ำ เกมที่ร่วมรายการ ระยะเวลา และเงื่อนไขการถอนให้ครบ
      เพราะโปรที่เหมาะกับงบอาจคุ้มกว่าข้อเสนอที่ให้เครดิตสูงแต่มีข้อจำกัดมาก
    </p>
  </ContentBoxSevenThreePremium>

  <ContentBoxCyberCut as="h2" title="ฝากถอนผ่าน Wallet บน RUAYRUAY888 ช่วยลดขั้นตอนบนมือถือ">
    <p class="text-left text-base leading-relaxed text-[#f6dde8]">
      การรองรับ Wallet ของ RUAYRUAY888 ช่วยให้สมาชิกจัดการฝากและถอนผ่านมือถือได้สะดวกขึ้น ก่อนยืนยันควรตรวจข้อมูลกระเป๋าเงิน จำนวนเงิน และบัญชีสมาชิกให้ตรงกัน
      พร้อมรอให้รายการเดิมอัปเดตสถานะก่อนทำธุรกรรมใหม่
    </p>
  </ContentBoxCyberCut>

  <ContentBox3ThreePremium as="h2" title="คำว่าจ่ายดีควรดูจากอัตราจ่ายของแต่ละเกม">
    <p slot="left" class="text-left text-base leading-relaxed text-[#f6dde8]">คำว่าจ่ายดีไม่ได้หมายความว่าเกมจะให้ผลตอบแทนสูงทุกครั้ง</p>
    <p slot="center" class="text-left text-base leading-relaxed text-[#f6dde8]">เกมแต่ละประเภทมีอัตราจ่าย ความผันผวน และเงื่อนไขแตกต่างกัน</p>
    <p slot="right" class="text-left text-base leading-relaxed text-[#f6dde8]">ผู้เล่นควรดูตารางจ่าย กติกา และข้อมูลจากผู้ให้บริการก่อนเริ่ม เพื่อให้เลือกเกมจากข้อมูลมากกว่าคำโปรโมต</p>
  </ContentBox3ThreePremium>

  <ContentBoxSevenThree titleright="ตรวจสิทธิ์และประวัติรายการผ่าน RUAYRUAY888 ก่อนทำธุรกรรม">
    <Picture
      slot="left"
      src={imgDailyMission}
      loading="lazy"
      fetchpriority="low"
      widths={[300, 450, 600]}
      sizes="(max-width: 768px) calc(100vw - 6rem), 360px"
      decoding="async"
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      quality={80}
      alt={altDailyMission}
      class="mx-auto h-auto w-full rounded-2xl border border-[#f874a1]/55 shadow-[0_10px_30px_rgba(248,116,161,0.24)]"
    />
    <p slot="right" class="text-left text-base leading-relaxed text-[#f6dde8]">
      สมาชิก RUAYRUAY888 ควรตรวจโปรโมชั่นที่เปิดใช้งาน ยอดคงเหลือ และประวัติธุรกรรมก่อนฝากหรือถอน หากพบรายการล่าช้าควรเก็บเวลา จำนวนเงิน และเลขอ้างอิงไว้จนกว่าระบบจะอัปเดตผล
      เพื่อช่วยให้ตรวจสอบย้อนหลังได้ง่ายขึ้น
    </p>
  </ContentBoxSevenThree>

  <ContentBoxSpecial as="h2" title="เลือก RUAYRUAY888 ให้เหมาะกับงบด้วยการวางแผนก่อนเล่น" iconleft="🧭" iconright="🛡️">
    <p slot="left" class="text-left text-base leading-relaxed text-[#f6dde8]">
      การใช้งาน RUAYRUAY888 ควรเริ่มจากการกำหนดวงเงิน เลือกเกมที่เข้าใจกติกา และเลือกโปรโมชั่นที่ไม่บังคับให้เพิ่มยอดเกินแผน
    </p>
    <p slot="right" class="text-left text-base leading-relaxed text-[#f6dde8]">ไม่ควรเพิ่มเงินเพื่อตามคืนยอดเสีย เพราะเกมพนันมีความไม่แน่นอนและไม่สามารถรับประกันกำไรได้</p>
  </ContentBoxSpecial>

  <Faq title="คำถามที่พบบ่อยเกี่ยวกับ RUAYRUAY888" faqs={faqs} />

  <LatestWinners4 />

  <LoginRtpSection />

  <div class="relative z-10 mx-auto mb-10 flex flex-nowrap justify-center gap-3 px-4 sm:gap-6">
    <a
      href="/login"
      class="group relative flex flex-1 items-center justify-center rounded-full border-2 border-[#f874a1]/60 bg-[#1a1113]/90 px-4 py-3 text-sm font-black whitespace-nowrap text-[#f6dde8] shadow-[0_10px_30px_rgba(248,116,161,0.22)] transition-all duration-300 hover:-translate-y-1 hover:scale-105 hover:border-[#fdb4d4] hover:text-[#fdb4d4] hover:shadow-[0_15px_40px_rgba(248,116,161,0.38)] sm:flex-none sm:px-10 sm:py-3.5 sm:text-base">
      เข้าสู่ระบบ
    </a>

    <a
      href="/register"
      class="group relative flex flex-1 items-center justify-center rounded-full border-2 border-[#fdb4d4]/70 bg-gradient-to-r from-[#f874a1] to-[#8f1140] px-4 py-3 text-sm font-black whitespace-nowrap text-white shadow-[0_10px_30px_rgba(214,55,122,0.34)] transition-all duration-300 hover:-translate-y-1 hover:scale-105 hover:border-[#ffffff] hover:shadow-[0_15px_40px_rgba(248,116,161,0.48)] sm:flex-none sm:px-10 sm:py-3.5 sm:text-base">
      สมัครสมาชิก
    </a>
  </div>

  <ReviewCardSumo2 />

  <Navfoot />
</MainLayout>
