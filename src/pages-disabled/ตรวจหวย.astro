---
import MainLayout from "../layouts/MainLayout.astro";
import Announcement from "../components/AnnouncementHuay.astro";
import ContentBoxHuay from "../components/ContentBoxHuay.astro";
import Navfoot from "../components/Navfoot.astro";
import { pageGraph } from "../lib/schema";

// This page shipped with two things that could not stay. The first was a
// "ตรวจหวย" widget whose script always answered "ยินดีด้วย! คุณถูกรางวัล"
// whatever number was typed. The second was a results table of made-up winning
// numbers labelled "อัปเดตวันนี้" with every row marked จ่ายแล้ว. Both are
// claims the site cannot back, and a lottery page that fabricates a win is the
// worst version of that. What replaces them is a reference table of the markets
// the site opens and what each one publishes — no numbers, no dates, nothing
// that goes stale between builds.
const markets = [
  {
    name: "หวยรัฐบาล",
    draw: "ประกาศตามปฏิทินของงวดที่ระบบเปิดรับ",
    compare: "รางวัลที่ 1 สามตัวบน และสองตัวล่าง ตามรูปแบบที่บันทึกไว้ในโพย",
  },
  {
    name: "หวยลาว",
    draw: "ประกาศเป็นรอบตามตารางที่ระบบแสดงในแต่ละสัปดาห์",
    compare: "เลขที่ประกาศของรอบนั้น เทียบกับประเภทเดิมพันที่เลือกไว้",
  },
  {
    name: "หวยฮานอย",
    draw: "ประกาศเป็นรอบรายวันตามที่ระบบระบุไว้ในแต่ละงวด",
    compare: "เลขของรอบที่ซื้อ ไม่ใช่รอบล่าสุดที่เห็นบนหน้าจอ",
  },
  {
    name: "หวยยี่กี",
    draw: "ออกผลหลายรอบต่อวันตามตารางรอบที่ระบบกำหนด",
    compare: "หมายเลขรอบให้ตรงกันก่อน แล้วจึงเทียบตัวเลขของรอบนั้น",
  },
];

const pageTitle = "ตรวจหวยออนไลน์กับ LOTTO77 ครบทุกตลาดที่เปิดรับ";

// 150–160 CHARACTERS, counted as characters not bytes (Thai is 3 bytes each).
// This one is 155.
const pageDescription =
  "LOTTO77 หน้าตรวจหวยออนไลน์ ตรวจผลรางวัลหวยรัฐบาล หวยลาว หวยฮานอย และหวยยี่กี พร้อมวิธีเทียบเลขกับโพยที่บันทึกไว้ และข้อควรตรวจสอบก่อนยืนยันผลรางวัลทุกครั้ง";

const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "ตรวจหวย", path: "/ตรวจหวย" },
  ],
});
---

<MainLayout title="LOTTO77 | ตรวจหวยออนไลน์ ตรวจผลรางวัลทุกตลาดที่เปิดรับ" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBoxHuay title={pageTitle} as="h1">
    <p class="text-left text-base leading-relaxed">
      หน้านี้อธิบายวิธีตรวจผลรางวัลของตลาดหวยที่ LOTTO77 เปิดรับ และวิธีเทียบเลขที่ออกกับโพยที่บันทึกไว้ให้ครบทุกรายการ ผลรางวัลของแต่ละตลาดประกาศคนละรอบและใช้รูปแบบการประกาศคนละแบบ
      การรู้ว่าตลาดที่ซื้อไว้ประกาศอะไรออกมาบ้างจึงเป็นขั้นแรกของการตรวจ ก่อนจะลงไปเทียบตัวเลขทีละรายการ ข้อมูลที่ยึดเป็นหลักได้คือสถานะโพยและผลรางวัลที่แสดงในหน้าบัญชีของสมาชิกเอง
      ไม่ใช่ภาพหน้าจอหรือข้อความที่ส่งต่อกันมาจากแหล่งที่ตรวจสอบต้นทางไม่ได้
    </p>
  </ContentBoxHuay>

  <ContentBoxHuay title="ตรวจผลรางวัลของแต่ละตลาดหวยที่ LOTTO77 เปิดรับ" as="h2">
    <div>
      <p class="mb-6 text-left text-base leading-relaxed">
        ตลาดที่เปิดรับบน LOTTO77 มีสี่กลุ่มหลัก คือหวยรัฐบาล หวยลาว หวยฮานอย และหวยยี่กี ทั้งสี่กลุ่มนี้ต่างกันทั้งรอบการประกาศผล จำนวนรอบต่อวัน และรูปแบบของเลขที่ประกาศออกมา
        ตารางด้านล่างสรุปว่าแต่ละตลาดประกาศอะไร และควรเทียบอะไรกับโพยที่บันทึกไว้ รายละเอียดของงวดจริง ทั้งวันที่ เวลาปิดรับ และเลขที่ออก ให้ยึดตามที่ระบบแสดงในงวดนั้นเสมอ เพราะตารางรอบของแต่ละตลาดปรับได้
      </p>

      <div class="mb-6 overflow-x-auto rounded-xl border border-[#f5c451]/25 bg-[#150202]">
        <table class="w-full min-w-[600px] text-left text-base">
          <caption class="sr-only">สรุปรอบการประกาศผลและสิ่งที่ต้องเทียบกับโพยของตลาดหวยที่ LOTTO77 เปิดรับ</caption>
          <thead class="bg-gradient-to-r from-[#7d0000] to-[#2a0507]">
            <tr class="text-[#f5c451]">
              <th scope="col" class="p-4 font-bold">ประเภทหวย</th>
              <th scope="col" class="p-4 font-bold">รอบการประกาศผล</th>
              <th scope="col" class="p-4 font-bold">สิ่งที่ต้องเทียบกับโพย</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-[#f5c451]/15">
            {
              markets.map((market) => (
                <tr class="transition-colors hover:bg-[#3f070a]/60">
                  <th scope="row" class="p-4 text-left font-bold text-[#ffe08a]">
                    {market.name}
                  </th>
                  <td class="p-4 leading-relaxed">{market.draw}</td>
                  <td class="p-4 leading-relaxed">{market.compare}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>

      <p class="text-left text-base leading-relaxed">
        จุดที่พลาดกันบ่อยที่สุดไม่ใช่การอ่านเลขผิด แต่เป็นการเทียบผิดงวดหรือผิดรอบ โดยเฉพาะตลาดที่ออกผลหลายรอบต่อวันอย่างยี่กี ซึ่งหน้าจอมักแสดงรอบล่าสุดไว้ก่อน ทั้งที่โพยที่ต้องตรวจเป็นของรอบก่อนหน้า
        วิธีที่ปลอดภัยกว่าคือเปิดโพยที่ต้องการตรวจขึ้นมาก่อน อ่านว่ามันเป็นของตลาดใด งวดใด รอบที่เท่าไร แล้วจึงไปหาผลของงวดนั้นมาเทียบ ไม่ใช่ไล่จากผลที่ประกาศล่าสุดย้อนกลับมาหาโพย
      </p>
    </div>
  </ContentBoxHuay>

  <ContentBoxHuay title="เทียบเลขที่ออกกับโพยที่บันทึกไว้อย่างไรให้ครบทุกรายการ" as="h2">
    <div>
      <p class="mb-4 text-left text-base leading-relaxed">
        โพยหนึ่งใบอาจมีหลายรายการและหลายรูปแบบการเดิมพันปนกันอยู่ การเทียบจึงต้องทำทีละรายการ ไม่ใช่ทีละโพย เพราะรายการที่ถูกและไม่ถูกอยู่ในใบเดียวกันได้ วิธีที่ผิดพลาดน้อยที่สุดคือไล่จากบนลงล่างตามลำดับที่ระบบบันทึกไว้
        และดูสามอย่างของแต่ละรายการก่อนตัดสิน คือตัวเลขที่กรอกไว้ ประเภทเดิมพันที่เลือก และงวดหรือรอบที่รายการนั้นผูกอยู่ ถ้าสามอย่างนี้ตรงกับผลที่ประกาศแล้วจึงค่อยดูว่าเข้าเงื่อนไขรางวัลหรือไม่
      </p>

      <p class="mb-4 text-left text-base leading-relaxed">
        ประเภทเดิมพันเป็นตัวกำหนดว่าเลขในผลรางวัลชุดไหนที่เกี่ยวข้องกับรายการนั้น สองตัวบนกับสองตัวล่างอ่านจากคนละตำแหน่งของผลที่ประกาศ สามตัวบนกับสามตัวโต๊ดใช้ตัวเลขชุดเดียวกันแต่นับการเรียงลำดับต่างกัน
        ส่วนเลขวิ่งนับจากการปรากฏของตัวเลขหลักเดียวในตำแหน่งที่กติกาของรูปแบบนั้นกำหนดไว้ การเทียบโดยดูแค่ว่าตัวเลขเหมือนกันหรือไม่จึงยังไม่พอ ต้องดูด้วยว่ารูปแบบที่ซื้อไว้นับผลอย่างไร
        อัตราจ่ายที่ใช้กับรายการนั้นก็อ่านจากที่ระบบบันทึกไว้ตอนยืนยันโพย ไม่ใช่ราคาที่แสดงอยู่บนหน้าจอในวันที่มาตรวจ เพราะราคาปรับได้ระหว่างงวดและระหว่างเลข
      </p>

      <p class="text-left text-base leading-relaxed">
        เมื่อเทียบครบแล้ว ให้ดูสถานะที่ระบบแสดงให้กับแต่ละรายการอีกชั้นหนึ่ง สถานะคือสิ่งที่บอกว่าระบบตรวจรายการนั้นเสร็จแล้วหรือยัง ซึ่งเป็นคนละเรื่องกับการที่ผลรางวัลประกาศออกมาแล้ว
        ระยะเวลาการตรวจผลและการอัปเดตสถานะขึ้นอยู่กับประเภทหวย รอบการประกาศผล และขั้นตอนของระบบ จึงอาจไม่พร้อมกันทุกตลาด และควรเก็บเลขอ้างอิงของโพยไว้จนกว่าสถานะของทุกรายการจะปิดรอบ
      </p>
    </div>
  </ContentBoxHuay>

  <ContentBoxHuay title="ตรวจอะไรก่อนถือว่าผลรางวัลเป็นข้อสรุปสุดท้าย" as="h2">
    <div>
      <p class="mb-4 text-left text-base leading-relaxed">
        ก่อนจะสรุปว่ารายการหนึ่งถูกหรือไม่ถูกรางวัล มีสี่อย่างที่ควรยืนยันให้ครบ อย่างแรกคือแหล่งของผล ให้ยึดผลและสถานะที่แสดงในหน้าบัญชีของตนเองเป็นหลัก ภาพหน้าจอที่ส่งต่อกันมา ข้อความในกลุ่มแชต
        และหน้าเว็บที่ไม่ทราบต้นทาง ไม่ใช่หลักฐานที่ใช้ยืนยันอะไรได้ อย่างที่สองคืองวดและรอบ ต้องเป็นงวดเดียวกับที่รายการนั้นผูกอยู่ ไม่ใช่งวดล่าสุดที่ประกาศ
        อย่างที่สามคือความครบถ้วนของผล บางตลาดทยอยประกาศผลเป็นชุด การอ่านตอนที่ประกาศยังไม่ครบแล้วสรุปทันทีจึงคลาดเคลื่อนได้ อย่างที่สี่คือสถานะของรายการในระบบ ซึ่งเป็นตัวบอกว่าการตรวจสอบฝั่งระบบเสร็จสมบูรณ์แล้วหรือยัง
      </p>

      <p class="text-left text-base leading-relaxed">
        หากพบว่าสถานะของรายการยังไม่อัปเดตหลังผลประกาศไปแล้ว หรือผลที่เห็นไม่ตรงกับที่บันทึกไว้ในโพย ให้เก็บเลขอ้างอิงของโพย เวลาที่ส่งรายการ และจำนวนเงินไว้แจ้งทีมงานตั้งแต่ข้อความแรก
        ข้อมูลชุดนี้ทำให้ตรวจสอบย้อนหลังได้ตรงจุดโดยไม่ต้องเปิดเผยรหัสผ่านหรือรหัสยืนยันของบัญชีแก่ผู้ใด ทีมงานไม่มีเหตุผลที่จะขอสองสิ่งนี้ไม่ว่ากรณีใด
        และขอย้ำไว้ตรงนี้อีกครั้งว่าผลการออกรางวัลของทุกตลาดคาดเดาไม่ได้และไม่มีใครรับประกันได้ หน้านี้ช่วยเรื่องการตรวจสอบผลที่ประกาศไปแล้วเท่านั้น ไม่ได้ช่วยเรื่องการเลือกเลขของงวดถัดไป
      </p>
    </div>
  </ContentBoxHuay>

  <Navfoot />
</MainLayout>
