---
import MainLayout from "../layouts/MainLayout.astro";
import Announcement from "../components/AnnouncementHuay.astro";
import ContentBoxHuay from "../components/ContentBoxHuay.astro";
import Navfoot from "../components/Navfoot.astro";
import { pageGraph } from "../lib/schema";

// The previous brand shipped this page as six "เลขเด็ด" teaser cards —
// "เข้ามาแล้ว 3 งวดติด รีบส่งโพยก่อนเลขเต็ม", "รวมเลขเด็ด สำนักดัง" — plus a
// โหลดบทความเพิ่มเติม button wired to nothing. Every one of those is a promise
// about a future draw, which is exactly what this page has to say cannot be
// made. The cards below name the KINDS of supporting information a member will
// meet and what each one can and cannot tell them; the last one is a warning,
// not a source. Each label is a <p>/<span> with an aria-label on the region,
// because only the article body may produce a heading.
const infoTypes = [
  {
    icon: "📊",
    label: "สถิติย้อนหลังของแต่ละตลาด",
    detail: "บันทึกของงวดที่จบไปแล้ว ใช้ดูภาพรวมว่าตลาดหนึ่งประกาศผลในรูปแบบใดได้ แต่ไม่ได้บอกอะไรเกี่ยวกับงวดที่ยังไม่ออก",
  },
  {
    icon: "🗓️",
    label: "ตารางวันออกรางวัลและเวลาปิดรับ",
    detail: "ข้อมูลที่ตรวจสอบได้จริงและมีผลกับการซื้อโดยตรง เพราะกำหนดว่าจะส่งโพยของงวดนั้นได้ถึงเมื่อไร ควรยึดตามที่ระบบแสดงในงวดนั้น",
  },
  {
    icon: "🔖",
    label: "สถานะเลขและอัตราจ่ายของงวด",
    detail: "เลขบางชุดอาจถูกจำกัดวงเงิน ปรับราคา หรือหยุดรับเมื่อยอดถึงระดับที่กำหนด ข้อมูลนี้เปลี่ยนระหว่างงวดได้ จึงต้องอ่านก่อนกดยืนยันทุกครั้ง",
  },
  {
    icon: "⚠️",
    label: "ข้อความที่ส่งต่อกันมาโดยไม่ระบุที่มา",
    detail: "เลขที่อ้างว่ามาจากสำนักหรือแหล่งวงใน ตรวจสอบต้นทางไม่ได้และไม่มีสถานะเป็นข้อมูล ไม่ควรใช้เป็นเหตุผลในการเพิ่มยอดซื้อไม่ว่ากรณีใด",
  },
];

const pageTitle = "แนวทางหวยและสถิติย้อนหลังบน LOTTO77 ใช้เป็นข้อมูลประกอบเท่านั้น";

// 150–160 CHARACTERS, counted as characters not bytes (Thai is 3 bytes each).
// This one is 153.
const pageDescription =
  "LOTTO77 รวมแนวทางหวยและสถิติย้อนหลังไว้เป็นข้อมูลประกอบการตัดสินใจ พร้อมคำอธิบายวิธีอ่านสถิติอย่างมีขอบเขต และข้อเตือนว่าผลการออกรางวัลไม่สามารถคาดเดาได้";

const graph = pageGraph(Astro, {
  name: pageTitle,
  description: pageDescription,
  breadcrumb: [
    { name: "หน้าแรก", path: "/" },
    { name: "แนวทาง", path: "/แนวทาง" },
  ],
});
---

<MainLayout title="LOTTO77 | แนวทางหวยและสถิติย้อนหลังเพื่อประกอบการตัดสินใจ" description={pageDescription}>
  <script type="application/ld+json" set:html={graph} />

  <Announcement />

  <ContentBoxHuay title={pageTitle} as="h1">
    <p class="text-left text-base leading-relaxed">
      หน้านี้รวบรวมข้อมูลประกอบการตัดสินใจสำหรับสมาชิก LOTTO77 และอธิบายขอบเขตของมันไปพร้อมกัน คำว่าแนวทางบนเว็บไซต์นี้หมายถึงข้อมูลที่ช่วยให้เข้าใจว่าตลาดหนึ่งทำงานอย่างไร
      เช่น รอบการประกาศผล เวลาปิดรับ สถิติของงวดที่ผ่านไปแล้ว และสถานะของเลขในงวดปัจจุบัน ไม่ได้หมายถึงการชี้เลขหรือการคาดการณ์ผลของงวดถัดไป ซึ่งเป็นสิ่งที่ทำไม่ได้และไม่มีใครรับประกันได้
      เราเขียนหน้านี้ให้อ่านแล้วรู้ว่าข้อมูลแต่ละชนิดใช้ทำอะไรได้จริง และตรงไหนที่ควรหยุด มากกว่าจะรวมตัวเลขมากองไว้เฉย ๆ
    </p>
  </ContentBoxHuay>

  <ContentBoxHuay title="แนวทางหวยและสถิติย้อนหลังคืออะไร และบอกอะไรได้บ้าง" as="h2">
    <div>
      <p class="mb-6 text-left text-base leading-relaxed">
        ข้อมูลประกอบที่ผู้ซื้อหวยพบบ่อยแบ่งได้เป็นไม่กี่ชนิด และแต่ละชนิดมีน้ำหนักไม่เท่ากันเลย บางชนิดตรวจสอบได้และมีผลกับการซื้อโดยตรง บางชนิดเป็นเพียงบันทึกของอดีต และบางชนิดไม่มีต้นทางให้ตรวจเลย
        การแยกให้ออกว่ากำลังอ่านอะไรอยู่คือสิ่งที่ช่วยได้มากที่สุด มากกว่าการหาข้อมูลเพิ่ม ตารางด้านล่างจัดกลุ่มไว้ให้เห็นภาพ
      </p>

      <div class="mb-6 grid grid-cols-1 gap-5 sm:grid-cols-2" role="list" aria-label="ชนิดของข้อมูลประกอบการตัดสินใจที่พบบ่อย และขอบเขตของแต่ละชนิด">
        {
          infoTypes.map((info) => (
            <div role="listitem" class="rounded-2xl border border-[#f5c451]/25 bg-[#3f070a]/55 p-5 transition-colors duration-300 hover:border-[#f5c451]/55">
              <p class="mb-2 flex items-center gap-3 text-base font-bold text-[#f5c451]">
                <span aria-hidden="true" class="text-2xl">
                  {info.icon}
                </span>
                {info.label}
              </p>
              <p class="text-left text-base leading-relaxed">{info.detail}</p>
            </div>
          ))
        }
      </div>

      <p class="text-left text-base leading-relaxed">
        จะเห็นว่าสองชนิดแรกในกลุ่มนี้เป็นข้อมูลของระบบที่ตรวจสอบได้ ส่วนสถิติย้อนหลังเป็นบันทึกของสิ่งที่เกิดขึ้นแล้ว และชนิดสุดท้ายไม่ใช่ข้อมูลในความหมายที่ใช้ตัดสินใจได้เลย
        เส้นแบ่งที่ควรจำคือ ข้อมูลที่บอกเงื่อนไขของการซื้อ เช่น เวลาปิดรับ อัตราจ่าย และสถานะเลข มีผลกับสิ่งที่กำลังจะกดยืนยันจริง ส่วนข้อมูลที่พูดถึงผลของงวดที่ยังไม่ออก ไม่ว่าจะนำเสนอด้วยตัวเลขหรือกราฟที่ดูน่าเชื่อเพียงใด
        ก็ยังเป็นการคาดเดาอยู่ดี
      </p>
    </div>
  </ContentBoxHuay>

  <ContentBoxHuay title="วิธีอ่านสถิติย้อนหลังอย่างมีขอบเขต" as="h2">
    <div>
      <p class="mb-4 text-left text-base leading-relaxed">
        สถิติย้อนหลังของหวยเป็นบันทึกของงวดที่จบไปแล้ว ไม่ใช่คำใบ้ของงวดถัดไป ข้อนี้ฟังดูตรงไปตรงมา แต่สิ่งที่ทำให้คนอ่านผิดคือรูปแบบที่สมองมองเห็นเองโดยอัตโนมัติ เมื่อไล่ดูตัวเลขยาว ๆ
        เราจะเห็นเลขที่ออกซ้ำ เห็นช่วงที่เลขบางตัวหายไปนาน และตีความสองอย่างนั้นว่าเป็นแนวโน้ม ทั้งที่การออกรางวัลแต่ละงวดไม่ได้รับอิทธิพลจากงวดก่อนหน้า
        เลขที่ไม่ออกมานานไม่ได้ถึงคิว และเลขที่เพิ่งออกไปก็ไม่ได้หมดโอกาส สองประโยคนี้เป็นความเข้าใจผิดที่พบบ่อยที่สุดของการอ่านสถิติหวย
      </p>

      <p class="mb-4 text-left text-base leading-relaxed">
        สิ่งที่สถิติย้อนหลังใช้ได้จริงมีอยู่บ้าง คือใช้ทำความคุ้นเคยกับรูปแบบการประกาศผลของแต่ละตลาด ว่าตลาดหนึ่งประกาศเลขกี่ชุด ชุดละกี่หลัก และรางวัลแต่ละประเภทอ่านจากตำแหน่งไหนของผล
        ซึ่งช่วยตอนตรวจโพยมากกว่าตอนเลือกเลข นอกจากนี้ยังใช้เป็นเครื่องเตือนความจริงได้ดี เพราะเมื่อไล่ดูย้อนหลังหลายงวดจะเห็นชัดว่าตัวเลขกระจายไปทั่ว ไม่ได้เกาะกลุ่มอย่างที่ความรู้สึกบอก
        ส่วนการนำสถิติมาสรุปเป็นเลขเด่นของงวดหน้า ไม่ว่าจะคำนวณด้วยวิธีใด ก็ยังไม่เปลี่ยนความน่าจะเป็นของงวดนั้นแม้แต่น้อย
      </p>

      <p class="text-left text-base leading-relaxed">
        ข้อควรระวังที่สุดคือการใช้แนวทางเป็นเหตุผลในการเพิ่มยอด ความรู้สึกมั่นใจที่ได้จากการอ่านข้อมูลมาเยอะเป็นสิ่งที่เกิดขึ้นได้จริง แต่มันเป็นความรู้สึก ไม่ใช่ความน่าจะเป็นที่เปลี่ยนไป
        วิธีที่ปลอดภัยกว่าคือกำหนดวงเงินต่อหนึ่งงวดไว้ล่วงหน้าก่อนจะเปิดอ่านแนวทางใด ๆ แล้วไม่ขยับวงเงินนั้นตามสิ่งที่อ่านเจอระหว่างทาง ใช้เฉพาะเงินที่ไม่กระทบค่าใช้จ่ายจำเป็น
        และไม่เพิ่มยอดเพื่อชดเชยการเสียจากงวดก่อน
      </p>
    </div>
  </ContentBoxHuay>

  <ContentBoxHuay title="ผลการออกรางวัลคาดเดาไม่ได้ และไม่มีใครรับประกันได้" as="h2">
    <div>
      <p class="mb-4 text-left text-base leading-relaxed">
        LOTTO77 ไม่ให้บริการชี้เลข ไม่ขายสูตร และไม่รับรองแหล่งข้อมูลใดว่าแม่นยำ ผลการออกรางวัลของทุกตลาดที่เปิดรับเป็นสิ่งที่คาดเดาไม่ได้ และไม่มีบุคคล สำนัก โปรแกรม หรือระบบใดรับประกันได้
        ข้อความที่อ้างว่ารู้ผลล่วงหน้า อ้างว่ามีเลขวงใน หรือเสนอขายเลขโดยรับประกันว่าถูกรางวัล เป็นสิ่งที่ควรปฏิเสธทันทีไม่ว่าจะมาจากช่องทางใด และไม่ใช่สิ่งที่ทีมงานของเราส่งถึงสมาชิก
      </p>

      <p class="text-left text-base leading-relaxed">
        สิ่งที่เว็บไซต์นี้ให้ได้จึงเป็นเรื่องของกระบวนการ ไม่ใช่ผลลัพธ์ ได้แก่ ข้อมูลของงวดที่ตรวจสอบได้ ขั้นตอนการซื้อที่ไล่ตามได้เป็นลำดับ โพยที่กลับมาตรวจย้อนหลังได้ และเงื่อนไขที่เขียนไว้ให้อ่านก่อนตัดสินใจ
        เมื่อรวมกับการกำหนดงบล่วงหน้าและการหยุดตามที่ตั้งไว้ นั่นคือขอบเขตที่ผู้ใช้งานควบคุมได้จริงทั้งหมด ส่วนตัวเลขที่จะออกในงวดถัดไปอยู่นอกขอบเขตนั้นเสมอ
        หากรู้สึกว่าเริ่มควบคุมการซื้อของตนเองไม่ได้ ขอให้หยุดและปรึกษาผู้ที่ไว้ใจได้ นั่นสำคัญกว่าแนวทางใดบนหน้านี้
      </p>
    </div>
  </ContentBoxHuay>

  <Navfoot />
</MainLayout>
