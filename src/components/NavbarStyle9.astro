---
import { isActivePath } from "../lib/nav";
import { Picture } from "astro:assets";
import { BRAND_NAME } from "../lib/brandProfile";
const images = import.meta.glob<{ default: ImageMetadata }>("../assets/logo.{png,webp,jpg}", { eager: true });

const imagePaths = Object.keys(images);
const mainLogo = imagePaths.length > 0 ? images[imagePaths[0]].default : null;

const currentPath = Astro.url.pathname;

const isActive = (path: string) => isActivePath(currentPath, path);

// เมนูชุดเดียวใช้ทั้งจอคอมและ drawer มือถือ — ไอคอนอยู่ในอาร์เรย์ แล้วเรนเดอร์เป็น
// <span aria-hidden="true"> แยกจากตัวอักษร ห้ามต่อ emoji เข้าไปในข้อความชื่อเมนู
// เพราะ screen reader จะอ่านชื่อไอคอนติดมากับชื่อเมนู
//
// ลำดับ: หน้าแรก ต้องมาก่อนเสมอ แล้วตามด้วย โปรโมชั่น ส่วนหน้าอ่านข้อมูลที่เหลือ
// ต่อท้าย แบรนด์นี้ปิด cta toggle (login/register ยังเป็นหน้า interstitial)
// จึงไม่มีเมนู สมัครสมาชิก/เข้าสู่ระบบ และ ทางเข้า ยังอยู่ในเมนูตามปกติ
//
// ไอคอนเลือกให้ตรงแนวบาคาร่า+หวยของ BANANAV3 (ไม่ใช่แบรนด์สล็อตล้วน) — ทดลองเล่น
// เป็นไพ่ ไม่ใช่ตู้สล็อต
//
// แนวทาง อยู่ในเมนูเพราะ operator เปิดหน้านี้ไว้ ส่วน /ตรวจหวย ถูกพักไว้ใน
// src/pages-disabled/ จึงต้องไม่มีลิงก์ไปหาที่ไหนเลย — route นั้นไม่มีอยู่จริง
const links = [
  { name: "หน้าแรก", path: "/", icon: "🏠" },
  { name: "โปรโมชั่น", path: "/promotion", icon: "🎁" },
  { name: "ทดลองเล่น", path: "/ทดลองเล่น", icon: "🎴" },
  { name: "แนวทาง", path: "/แนวทาง", icon: "📊" },
  { name: "ทางเข้า", path: "/ทางเข้า", icon: "🚪" },
  { name: "เกี่ยวกับเรา", path: "/about-us", icon: "🏢" },
  { name: "ติดต่อเรา", path: "/contact-us", icon: "💬" },
];

const logoAlt = `โลโก้ ${BRAND_NAME} ตัวอักษร BANANAV3 สีเหลืองกล้วยไล่เฉดทอง ขอบหนาสีน้ำตาลเข้ม มีรูปกล้วยลูกหนึ่งพาดเฉียงอยู่หลังตัวอักษร และมีเปลือกกล้วยโค้งรับอยู่ด้านล่าง`;
---

<header class="sticky top-0 z-50 w-full font-sans">
  <nav class="relative z-50 w-full border-b border-[#fed624]/30 bg-gradient-to-r from-[#140b02] via-[#2e1a05] to-[#140b02] shadow-[0_4px_25px_rgba(20,11,2,0.75)]" aria-label={`เมนูหลัก ${BRAND_NAME}`}>
    <div class="mx-auto flex h-[70px] w-full max-w-[1600px] items-center justify-between px-4 lg:h-[85px] lg:px-8">
      <div class="flex items-center">
        <a href="/" class="relative flex-shrink-0 transition-transform hover:scale-105">
          <div aria-hidden="true" class="absolute inset-0 rounded-full bg-[#fed624]/20 blur-xl"></div>
          <Picture
            src={mainLogo!}
            alt={logoAlt}
            loading="eager"
            fetchpriority="high"
            widths={[120, 240, 360]}
            sizes="120px"
            class="relative h-[40px] w-auto drop-shadow-[0_0_8px_rgba(254,214,36,0.45)] lg:h-[50px]"
            formats={["avif", "webp"]}
            fallbackFormat="webp"
          />
        </a>
      </div>

      <div class="hidden h-full items-center justify-center gap-1 lg:flex xl:gap-3">
        {
          links.map((link) => (
            <a
              href={link.path}
              class={`group relative flex h-full items-center gap-1.5 px-3 text-sm font-bold transition-all duration-300 xl:px-5 xl:text-base ${isActive(link.path) ? "text-[#ffe97a]" : "text-[#d9bd82]/85 hover:text-[#fed624]"}`}>
              <div
                aria-hidden="true"
                class={`absolute inset-0 bg-gradient-to-b from-transparent to-[#fed624]/12 transition-opacity duration-300 ${isActive(link.path) ? "opacity-100" : "opacity-0 group-hover:opacity-100"}`}
              />
              <span aria-hidden="true" class="relative z-10 text-base">
                {link.icon}
              </span>
              <span class="relative z-10">{link.name}</span>
              <div class={`absolute bottom-0 left-1/2 h-[3px] -translate-x-1/2 bg-[#fed624] transition-all duration-300 ${isActive(link.path) ? "w-full" : "w-0 group-hover:w-full"}`} />
            </a>
          ))
        }
      </div>

      <div class="flex items-center gap-3 md:gap-4">
        <a
          href="/login"
          class="hidden items-center justify-center rounded-full border border-[#fed624]/70 px-6 py-2.5 text-sm font-bold text-[#fed624] shadow-[0_0_10px_rgba(254,214,36,0.2)] transition-all hover:bg-[#fed624] hover:text-[#241303] lg:flex">
          เข้าสู่ระบบ
        </a>
        <a
          href="/register"
          class="hidden items-center justify-center rounded-full bg-gradient-to-r from-[#ffe97a] via-[#fed624] to-[#e8a317] px-6 py-2.5 text-sm font-extrabold text-[#241303] shadow-[0_0_20px_rgba(254,214,36,0.4)] transition-all hover:scale-105 hover:brightness-110 lg:flex">
          สมัครสมาชิก
        </a>

        <button
          id="hamburger-btn"
          class="relative z-[60] flex h-10 w-10 flex-col items-center justify-center overflow-hidden rounded-full border-2 border-[#e8a317]/70 bg-gradient-to-tr from-[#e8a317] to-[#fed624] shadow-[0_0_15px_rgba(254,214,36,0.5)] lg:hidden"
          aria-label="เปิดเมนู">
          <span class="hamburger-line absolute h-[2px] w-5 -translate-y-1.5 transform rounded-full bg-[#241303] transition-all duration-300"></span>
          <span class="hamburger-line absolute h-[2px] w-5 rounded-full bg-[#241303] transition-all duration-300"></span>
          <span class="hamburger-line absolute h-[2px] w-5 translate-y-1.5 transform rounded-full bg-[#241303] transition-all duration-300"></span>
        </button>
      </div>
    </div>
  </nav>

  <div id="mobile-circular-menu" class="pointer-events-none fixed inset-0 z-40 flex flex-col items-center justify-center bg-[#140b02]/98 backdrop-blur-2xl lg:hidden">
    <div class="flex w-full flex-col items-center space-y-5 px-6">
      <Picture
        src={mainLogo!}
        alt=""
        widths={[150, 300]}
        sizes="150px"
        loading="lazy"
        decoding="async"
        class="menu-item mb-4 h-[50px] w-auto opacity-0 drop-shadow-[0_0_15px_rgba(254,214,36,0.5)]"
        formats={["avif", "webp"]}
        fallbackFormat="webp"
      />

      {
        links.map((link) => (
          <a
            href={link.path}
            class={`menu-item flex items-center gap-3 text-2xl font-black tracking-wider uppercase opacity-0 transition-all duration-300 ${isActive(link.path) ? "text-[#ffe97a] drop-shadow-[0_0_8px_rgba(254,214,36,0.8)]" : "text-[#d9bd82]/85 hover:text-[#fdf1b3]"}`}>
            <span aria-hidden="true">{link.icon}</span>
            <span>{link.name}</span>
          </a>
        ))
      }

      <div class="menu-item mt-4 flex w-full max-w-[280px] flex-col gap-4 border-t border-[#e8a317]/60 pt-8 opacity-0">
        <a
          href="/register"
          class="flex w-full items-center justify-center gap-2 rounded-full bg-gradient-to-r from-[#ffe97a] via-[#fed624] to-[#e8a317] py-3.5 text-lg font-extrabold text-[#241303] shadow-[0_0_20px_rgba(254,214,36,0.4)]">
          <span aria-hidden="true">🍌</span> สมัครสมาชิก
        </a>
        <a href="/login" class="flex w-full items-center justify-center rounded-full border border-[#fed624]/50 py-3.5 text-lg font-bold text-[#fed624] hover:bg-[#fed624]/10">เข้าสู่ระบบ</a>
      </div>
    </div>
  </div>
</header>

<style is:global>
  /* อนิเมชั่น Hamburger กลายเป็น X (ตัวเส้นเป็น absolute เลยต้องกำหนดองศาใหม่) */
  #hamburger-btn.active .hamburger-line:nth-child(1) {
    transform: translateY(0) rotate(45deg);
  }
  #hamburger-btn.active .hamburger-line:nth-child(2) {
    opacity: 0;
  }
  #hamburger-btn.active .hamburger-line:nth-child(3) {
    transform: translateY(0) rotate(-45deg);
  }

  /* หัวใจสำคัญ: อนิเมชั่น Circular Reveal ด้วย clip-path
     วงกลมเริ่มต้นอยู่ที่มุมขวาบน (ซ่อนไว้ขนาด 0%) */
  #mobile-circular-menu {
    clip-path: circle(0% at calc(100% - 35px) 35px);
    transition: clip-path 0.6s cubic-bezier(0.4, 0, 0.2, 1);
  }

  /* เมื่อใส่คลาส open วงกลมจะขยายตัวเป็น 150% กินพื้นที่เต็มจอ */
  #mobile-circular-menu.menu-open {
    clip-path: circle(150% at calc(100% - 35px) 35px);
    pointer-events: auto; /* อนุญาตให้คลิกได้ตอนเปิด */
  }

  /* อนิเมชั่นเด้งไล่ระดับของเมนู (ลอยขึ้นมาจากข้างล่าง) */
  .menu-item {
    transform: translateY(30px);
    transition: all 0.5s cubic-bezier(0.4, 0, 0.2, 1);
  }
  .menu-item.item-show {
    opacity: 1 !important; /* บังคับทับ opacity-0 ของ Tailwind */
    transform: translateY(0);
  }

  /* หน่วงเวลาให้ข้อความเด้งขึ้นมาทีละอัน (1 = โลโก้, ตัวสุดท้าย = กล่องปุ่ม) */
  .menu-item:nth-child(1) {
    transition-delay: 0.2s;
  }
  .menu-item:nth-child(2) {
    transition-delay: 0.25s;
  }
  .menu-item:nth-child(3) {
    transition-delay: 0.3s;
  }
  .menu-item:nth-child(4) {
    transition-delay: 0.35s;
  }
  .menu-item:nth-child(5) {
    transition-delay: 0.4s;
  }
  .menu-item:nth-child(6) {
    transition-delay: 0.45s;
  }
  .menu-item:nth-child(7) {
    transition-delay: 0.5s;
  }
  .menu-item:nth-child(8) {
    transition-delay: 0.55s;
  }
  .menu-item:nth-child(9) {
    transition-delay: 0.6s;
  }

  @media (prefers-reduced-motion: reduce) {
    #mobile-circular-menu,
    .menu-item {
      transition-duration: 0.01ms;
    }
  }
</style>

<script>
  const hamburgerBtn = document.getElementById("hamburger-btn");
  const circularMenu = document.getElementById("mobile-circular-menu");
  const menuItems = document.querySelectorAll(".menu-item");

  const toggleCircularMenu = () => {
    // 1. สลับหน้าตาปุ่ม Hamburger
    hamburgerBtn?.classList.toggle("active");

    // 2. ขยายวงกลม (Circular Reveal)
    circularMenu?.classList.toggle("menu-open");

    // 3. ล็อกหน้าจอ & ใส่คลาสให้ตัวหนังสือเด้ง
    if (circularMenu?.classList.contains("menu-open")) {
      document.body.style.overflow = "hidden";
      menuItems.forEach((item) => item.classList.add("item-show"));
    } else {
      document.body.style.overflow = "";
      menuItems.forEach((item) => item.classList.remove("item-show"));
    }
  };

  hamburgerBtn?.addEventListener("click", toggleCircularMenu);

  // ปิดเมนูเวลากดเลือกลิงก์
  menuItems.forEach((item) => {
    item.addEventListener("click", () => {
      if (circularMenu?.classList.contains("menu-open")) {
        toggleCircularMenu();
      }
    });
  });
</script>
