---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;
const headingSize = HeadingTag === "h1" ? "text-xl sm:text-2xl md:text-3xl" : "text-lg sm:text-xl md:text-2xl";

// pt-32/md:pt-28 rather than the pt-28/md:pt-24 this file shipped with. The
// badge is anchored at -top-6 (24px above the card), so its bottom edge sits at
// (badge height − 24px) from the card's top. A full-sentence Thai H2 wraps the
// badge to two or three lines — up to ~108px tall on a phone — which put the
// last line of the badge on top of the first line of body copy. Keep this value
// in sync with ContentBoxSevenThreeFloatingBadge.astro, which uses the same
// anchor.
---

<section class="my-10 flex w-full justify-center px-4 font-sans">
  <div
    class="relative isolate w-full max-w-[1400px] rounded-2xl border-2 border-[#ff3d9a]/25 bg-gradient-to-b from-[#1c0614]/95 to-[#100309]/95 p-8 pt-32 text-left text-base leading-relaxed text-[#fdeaf4] shadow-[0_10px_30px_rgba(255,61,154,0.16)] md:pt-28">
    <div class="pointer-events-none absolute -top-16 -right-10 -z-10 h-40 w-40 rounded-full bg-[#ff3d9a]/25 blur-[60px]"></div>
    <div class="pointer-events-none absolute -bottom-16 -left-10 -z-10 h-40 w-40 rounded-full bg-[#22d3ee]/35 blur-[60px]"></div>

    {
      title && (
        <div class="absolute -top-6 left-1/2 flex w-[92%] max-w-2xl -translate-x-1/2 items-center justify-center gap-2 rounded-lg border-2 border-[#ff3d9a]/35 bg-[#1c0614] px-4 py-2.5 text-center shadow-[0_10px_30px_rgba(255,61,154,0.22)] sm:px-8">
          <span aria-hidden="true" class="shrink-0 text-[#22d3ee]">
            ✦
          </span>
          <HeadingTag class={`bg-gradient-to-r from-[#ffa6d2] via-[#ff3d9a] to-[#c21a70] bg-clip-text ${headingSize} leading-normal font-black tracking-tight text-transparent uppercase`}>{title}</HeadingTag>
          <span aria-hidden="true" class="shrink-0 text-[#22d3ee]">
            ✦
          </span>
        </div>
      )
    }

    <slot />
  </div>
</section>
