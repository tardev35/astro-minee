---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h2" } = Astro.props;
const headingSize = HeadingTag === "h1" ? "text-xl sm:text-2xl md:text-3xl" : "text-lg sm:text-xl md:text-2xl";

// `as` defaults to "h2" because the docx is flat H1 + H2 and only the block
// carrying the page title asks for "h1" explicitly. A default of "h1" is how a
// second <h1> reaches an indexable page without anyone typing one.
//
// The title badge is absolutely positioned at -top-6, so two things are load
// bearing and must survive any restyle: the width cap (w-[92%] max-w-2xl) plus
// text-center, which lets a full docx sentence wrap instead of blowing past the
// viewport, and the card's pt-32/md:pt-28, which reserves clearance for that
// wrapped badge. There is no whitespace-nowrap here and none may come back.
//
// Re-measured for TT1BET's H2-1, the sentence this brand feeds it
// ("เปรียบเทียบค่ายคาสิโนและสล็อตได้ง่ายบน TT1BET", 45 chars, at the h2 ramp).
// Mobile at a 375px viewport: the card is 343px wide inside the section's px-4,
// the badge is w-[92%] of that = 316px, and after px-4 (32px), border-2 (4px),
// the two ✦ spans (~28px) and their gap-2 pair (16px) about 236px is left for
// text. text-lg wraps that title to 2 lines, 3 at worst; leading-normal on 18px
// = 27px a line, so 3×27 + 20 (py-2.5) + 4 (border-2) = 105px tall and the
// bottom edge sits at 105 − 24 = 81px into the card — well inside pt-32 (128px).
// Desktop: md:text-2xl at 36px a line over ~560px of usable width inside
// max-w-2xl wraps to 2 lines at worst = 96px tall, bottom edge at 72px, inside
// md:pt-28 (112px). Both clear as they stand; do not shrink either padding.
// pt-16/pt-18 are the documented floor, and these sit well above it.
//
// TT1BET: bronze deep frames the card and primary gold takes the badge border
// and the first glow on a warm near-black ground; bronze takes the second glow
// and gold light the two ✦ marks. The heading ramp runs gold pale -> primary
// gold -> bronze. The crimson from the artwork's red gown stays out: it is the
// rare second accent, never a section colour.
//
// The card is `isolate` and every decorative layer is `-z-10`, so the blurs
// paint above the card background but below the slot content. No `relative z-10`
// wrapper is needed and none may be re-added.
---

<section class="my-10 flex w-full justify-center px-4 font-sans">
  <div
    class="relative isolate w-full max-w-[1400px] rounded-2xl border-2 border-[#6d4a13]/55 bg-gradient-to-b from-[#171008]/95 to-[#0b0805]/95 p-8 pt-32 text-left text-base leading-relaxed text-[#f2e7cd] shadow-[0_10px_30px_rgba(233,195,65,0.2)] md:pt-28">
    <div aria-hidden="true" class="pointer-events-none absolute -top-16 -right-10 -z-10 h-40 w-40 rounded-full bg-[#e9c341]/22 blur-[60px]"></div>
    <div aria-hidden="true" class="pointer-events-none absolute -bottom-16 -left-10 -z-10 h-40 w-40 rounded-full bg-[#b8862a]/28 blur-[60px]"></div>

    {
      title && (
        <div class="absolute -top-6 left-1/2 flex w-[92%] max-w-2xl -translate-x-1/2 items-center justify-center gap-2 rounded-lg border-2 border-[#e9c341]/45 bg-[#241a0d] px-4 py-2.5 text-center shadow-[0_10px_30px_rgba(233,195,65,0.28)] sm:px-8">
          <span aria-hidden="true" class="shrink-0 text-[#fcf1b0]">
            ✦
          </span>
          <HeadingTag class={`min-w-0 bg-gradient-to-r from-[#fff8d6] via-[#e9c341] to-[#b8862a] bg-clip-text ${headingSize} leading-normal font-black tracking-tight text-transparent uppercase`}>
            {title}
          </HeadingTag>
          <span aria-hidden="true" class="shrink-0 text-[#fcf1b0]">
            ✦
          </span>
        </div>
      )
    }

    <slot />
  </div>
</section>
