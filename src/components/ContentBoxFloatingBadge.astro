---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;
const headingSize = HeadingTag === "h1" ? "text-xl sm:text-2xl md:text-3xl" : "text-lg sm:text-xl md:text-2xl";

// The title badge is absolutely positioned at -top-6, so two things are load
// bearing and must survive any restyle: the width cap (w-[92%] max-w-2xl) plus
// text-center, which lets a full docx sentence wrap instead of blowing past the
// viewport, and the card's pt-32/md:pt-28, which reserves clearance for that
// wrapped badge.
//
// Re-measured for BANANAV3's H2-6 title, which is the one this brand feeds it
// ("คำว่าไม่โกงควรพิจารณาจากสิ่งที่ตรวจสอบได้", 40 chars). Mobile: text-lg at
// leading-normal = 27px a line; the badge's usable text width inside w-[92%] of
// a 375px viewport, minus px-4 and the two ✦ spans, is ~240px, so the title
// wraps to 3 lines at worst. 3×27 + 20 (py-2.5) + 4 (border-2) = 105px tall,
// bottom edge at 105 − 24 = 81px into the card, well inside pt-32 (128px).
// Desktop: text-2xl at 36px a line over ~560px of usable width wraps to 2 lines
// = 96px tall, bottom edge at 72px, inside md:pt-28 (112px). Do not shrink
// either padding.
---

<section class="my-10 flex w-full justify-center px-4 font-sans">
  <div
    class="relative isolate w-full max-w-[1400px] rounded-2xl border-2 border-[#e8a317]/30 bg-gradient-to-b from-[#2e1a05]/95 to-[#241303]/95 p-8 pt-32 text-left text-base leading-relaxed text-[#fdf1b3] shadow-[0_10px_30px_rgba(232,163,23,0.16)] md:pt-28">
    <div aria-hidden="true" class="pointer-events-none absolute -top-16 -right-10 -z-10 h-40 w-40 rounded-full bg-[#e8a317]/25 blur-[60px]"></div>
    <div aria-hidden="true" class="pointer-events-none absolute -bottom-16 -left-10 -z-10 h-40 w-40 rounded-full bg-[#fed624]/30 blur-[60px]"></div>

    {
      title && (
        <div class="absolute -top-6 left-1/2 flex w-[92%] max-w-2xl -translate-x-1/2 items-center justify-center gap-2 rounded-lg border-2 border-[#e8a317]/40 bg-[#2e1a05] px-4 py-2.5 text-center shadow-[0_10px_30px_rgba(254,214,36,0.22)] sm:px-8">
          <span aria-hidden="true" class="shrink-0 text-[#fed624]">
            ✦
          </span>
          <HeadingTag class={`min-w-0 bg-gradient-to-r from-[#ffe97a] via-[#fed624] to-[#ffc94d] bg-clip-text ${headingSize} leading-normal font-black tracking-tight text-transparent uppercase`}>
            {title}
          </HeadingTag>
          <span aria-hidden="true" class="shrink-0 text-[#fed624]">
            ✦
          </span>
        </div>
      )
    }

    <slot />
  </div>
</section>
