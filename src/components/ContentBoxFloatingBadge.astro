---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;
const headingSize = HeadingTag === "h1" ? "text-xl sm:text-2xl md:text-3xl" : "text-lg sm:text-xl md:text-2xl";

// Badge clearance, re-measured for MAX56 against the real docx H2 this brand
// renders here ("คำว่าแตกง่ายควรดูควบคู่กับข้อมูลของเกม", 37 chars) rather than a
// short placeholder. The badge is `absolute -top-6`, so its bottom edge sits at
// (badge height - 24px) measured from the card's top:
//   mobile  375px viewport -> card 343px wide, badge w-[92%] = ~316px; minus
//           px-4 and the two ✦ spans plus their gap-2 the title's text box is
//           ~236px, so the 37-char H2 wraps to 2 lines. text-lg 18px x 1.5 =
//           27px/line. Budget 3 lines: 81px + py-2.5 (20px) + 2px borders =
//           105px  ->  81px below the card top, vs pt-40 (160px). 79px of
//           daylight at 3 lines, 106px at the 2 it actually takes.
//   md      text-2xl 24px x 1.5 = 36px/line; badge max-w-2xl leaves a ~592px
//           text box after the ✦ spans, so the title fits on 1 line. Budget 2
//           lines: 72 + 20 + 4 = 96px  ->  72px below the card top, vs
//           md:pt-36 (144px). 72px of daylight.
// The padding stays at pt-40/md:pt-36 — it was bumped a step for a long
// two-line title and trimming it back is how the overlap bug returns. The title
// has no `whitespace-nowrap` on purpose: it is width-capped (w-[92%] max-w-2xl)
// and centered so a full sentence wraps instead of blowing past the viewport.
---

<section class="my-10 flex w-full justify-center px-4 font-sans">
  <div
    class="relative isolate w-full max-w-[1400px] rounded-2xl border-2 border-[#c10d1e]/30 bg-gradient-to-b from-[#2a070d]/95 to-[#0d0204]/95 p-8 pt-40 text-left text-base leading-relaxed text-[#f6e4e4] shadow-[0_10px_30px_rgba(193,13,30,0.18)] md:pt-36">
    <div class="pointer-events-none absolute -top-16 -right-10 -z-10 h-40 w-40 rounded-full bg-[#ff5a66]/22 blur-[60px]"></div>
    <div class="pointer-events-none absolute -bottom-16 -left-10 -z-10 h-40 w-40 rounded-full bg-[#c10d1e]/30 blur-[60px]"></div>

    {
      title && (
        <div class="absolute -top-6 left-1/2 flex w-[92%] max-w-2xl -translate-x-1/2 items-center justify-center gap-2 rounded-lg border-2 border-[#c10d1e]/45 bg-[#0d0204] px-4 py-2.5 text-center shadow-[0_10px_30px_rgba(232,32,47,0.22)] sm:px-8">
          <span aria-hidden="true" class="shrink-0 text-[#f5c451]">
            ✦
          </span>
          <HeadingTag class={`bg-gradient-to-r from-[#ffe9a8] via-[#f5c451] to-[#c10d1e] bg-clip-text ${headingSize} leading-normal font-black tracking-tight text-transparent uppercase`}>
            {title}
          </HeadingTag>
          <span aria-hidden="true" class="shrink-0 text-[#f5c451]">
            ✦
          </span>
        </div>
      )
    }

    <slot />
  </div>
</section>
