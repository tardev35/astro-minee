---
export interface Props {
  title?: string;
  titleleft?: string;
  titleright?: string;
}
const { title, titleleft, titleright } = Astro.props;
const rightHeading = titleright ?? title;

// FINN20 neumorphic pair: the page ground (#080705) casts the dark side of the
// extrusion and the panel tone (#1f1a10) the lit side, matching
// ContentBoxNeumorphism and ContentBoxTwoNeumorphism so the three read as one
// raised system on the near-black page.
//
// Both column titles are <h2>: the FINN20 docx is flat H1 + H2 with no nested
// sub-headings, and the page's heading inventory is diffed against that brief.
// A column that carries no docx heading simply omits its prop — index.astro
// passes only titleright here, so the image column stays headingless.
---

<section class="relative z-10 mx-auto mb-8 w-full max-w-[1400px] px-4 font-sans">
  <div
    class="w-full rounded-[25px] border border-[#fdd323]/35 bg-[#14110a] p-8 shadow-[10px_10px_20px_#080705,-10px_-10px_20px_#1f1a10] transition-all duration-300 hover:shadow-[15px_15px_30px_#080705,-15px_-15px_30px_#1f1a10]">
    <div class="grid grid-cols-1 gap-8 md:grid-cols-[3fr_7fr] md:items-center">
      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#f3e7c8]">
        {titleleft && <h2 class="text-2xl leading-normal font-black text-[#fdd323]">{titleleft}</h2>}
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#f3e7c8] md:border-l md:border-[#fdd323]/35 md:pl-8">
        {rightHeading && <h2 class="text-2xl leading-normal font-black text-[#fdd323]">{rightHeading}</h2>}
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
