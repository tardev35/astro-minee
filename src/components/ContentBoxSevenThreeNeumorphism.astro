---
export interface Props {
  title?: string;
  titleleft?: string;
  titleright?: string;
}
const { title, titleleft, titleright } = Astro.props;
const rightHeading = titleright ?? title;
---

<section class="relative z-10 mx-auto mb-8 w-full max-w-[1400px] px-4 font-sans">
  <div
    class="w-full rounded-[25px] border border-[#a3e635]/25 bg-[#0a2411] p-8 shadow-[10px_10px_20px_#010a04,-10px_-10px_20px_#16391f] transition-all duration-300 hover:shadow-[15px_15px_30px_#010603,-15px_-15px_30px_#1c4526]">
    <div class="grid grid-cols-1 gap-8 md:grid-cols-[3fr_7fr] md:items-center">
      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#e2f3cd]">
        {titleleft && <h2 class="text-2xl leading-normal font-black text-[#a3e635]">{titleleft}</h2>}
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#e2f3cd] md:border-l md:border-[#ffd54a]/30 md:pl-8">
        {rightHeading && <h2 class="text-2xl leading-normal font-black text-[#a3e635]">{rightHeading}</h2>}
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
