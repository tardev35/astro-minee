---
export interface Props {
  title?: string;
  titleleft?: string;
  titleright?: string;
}
const { title, titleleft, titleright } = Astro.props;
const rightHeading = titleright ?? title;

// MAX56 neumorphic pair: the page ground (#0d0204) against the raised red-black
// tone (#2a070d), matching ContentBoxNeumorphism and ContentBoxTwoNeumorphism so
// the three read as one extruded system on the near-black crimson page.
//
// Both column titles are <h2>: the MAX56 docx is flat H1 + H2 with no nested
// sub-headings, and the page's heading inventory is diffed against that brief.
---

<section class="relative z-10 mx-auto mb-8 w-full max-w-[1400px] px-4 font-sans">
  <div
    class="w-full rounded-[25px] border border-[#c10d1e]/25 bg-[#1a0508] p-8 shadow-[10px_10px_20px_#0d0204,-10px_-10px_20px_#2a070d] transition-all duration-300 hover:shadow-[15px_15px_30px_#000000,-15px_-15px_30px_#3d0106]">
    <div class="grid grid-cols-1 gap-8 md:grid-cols-[3fr_7fr] md:items-center">
      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#f6e4e4]">
        {titleleft && <h2 class="text-2xl leading-normal font-black text-[#f5c451]">{titleleft}</h2>}
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#f6e4e4] md:border-l md:border-[#c10d1e]/30 md:pl-8">
        {rightHeading && <h2 class="text-2xl leading-normal font-black text-[#f5c451]">{rightHeading}</h2>}
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
