---
import { isActivePath } from "../lib/nav";
import { Picture } from "astro:assets";
import { BRAND_NAME } from "../lib/brandProfile";

const images = import.meta.glob<{ default: ImageMetadata }>("../assets/logo.*", { eager: true });
const imagePaths = Object.keys(images);
const mainLogo = imagePaths.length > 0 ? images[imagePaths[0]].default : null;

const currentPath = Astro.url.pathname;
const isActive = (path: string) => isActivePath(currentPath, path);

// ONE array, rendered twice (desktop bar + mobile drawer). It used to be declared
// separately in each, which is how the two drift apart.
//
// Icons are required on every item (owner's call, 2026-08-01) and are rendered as
// a SIBLING <span aria-hidden="true"> of the label, never inside its text — an
// emoji inside the label is announced as a word by a screen reader.
//
// Order: หน้าแรก first, then โปรโมชั่น, then the informational pages. สมัครสมาชิก
// and เข้าสู่ระบบ would slot in right after โปรโมชั่น if they were menu entries,
// but this brand has the cta toggle OFF — they are the header buttons below and
// /ทางเข้า keeps its menu slot.
//
// /ตรวจหวย is NOT here: the operator left it parked in src/pages-disabled this
// round, and a link to a route that does not exist fails the build.
const menu = [
  { name: "หน้าแรก", path: "/", icon: "🏠" },
  { name: "โปรโมชั่น", path: "/promotion", icon: "🎁" },
  { name: "ทางเข้า", path: "/ทางเข้า", icon: "🔑" },
  { name: "ทดลองเล่น", path: "/ทดลองเล่น", icon: "🎯" },
  { name: "แนวทาง", path: "/แนวทาง", icon: "📊" },
  { name: "เกี่ยวกับเรา", path: "/about-us", icon: "🏢" },
  { name: "ติดต่อเรา", path: "/contact-us", icon: "💬" },
];

const logoAlt = `โลโก้ ${BRAND_NAME} รูปมังกรทองขดเป็นวงกลมล้อมรอบเหรียญสีแดงสามเหรียญที่มีสัญลักษณ์สกุลเงินสีทอง ใต้เหรียญเป็นตัวอักษรไทยสีทองเขียนว่า จ่ายดีจริง และตัวอักษรโรมันสีแดงเขียนว่า JAIIDEEJING`;
---

<header class="sticky top-0 z-[100] w-full font-sans">
  <nav class="relative mx-auto flex h-[85px] w-full items-center justify-between border-b border-[#f5c451]/35 bg-[#5c1008]/95 px-4 shadow-[0_5px_20px_rgba(0,0,0,0.55)] backdrop-blur-xl xl:px-8">
    <a href="/" class="z-[110] flex-shrink-0 rounded-xl border border-[#ffe08a]/25 bg-[#f5c451]/10 px-4 py-2 backdrop-blur-sm transition-transform duration-300 hover:scale-105">
      {
        mainLogo ? (
          <Picture src={mainLogo} alt={logoAlt} loading="eager" widths={[110, 220, 330]} sizes="110px" class="h-[45px] w-auto drop-shadow-md xl:h-[55px]" formats={["avif", "webp"]} fallbackFormat="webp" />
        ) : (
          <p class="text-2xl font-black tracking-widest text-white italic drop-shadow-md">
            <span class="rounded-md bg-gradient-to-r from-[#ffe08a] to-[#f5c451] px-2 text-[#5c1008]">JAIDEE</span>JING
          </p>
        )
      }
    </a>

    <div class="hidden h-full flex-1 items-center justify-center gap-3 lg:flex xl:gap-5">
      {
        menu.map((item) => (
          <a
            href={item.path}
            class={`group relative flex h-full items-center gap-1.5 px-1.5 text-xs font-bold tracking-wider uppercase transition-colors xl:text-sm ${isActive(item.path) ? "text-[#ffe08a]" : "text-[#f7e4c0]/80 hover:text-white"}`}>
            <span aria-hidden="true" class="text-base leading-none">
              {item.icon}
            </span>
            <span>{item.name}</span>
            <div
              class={`absolute bottom-0 left-0 h-[4px] w-full rounded-t-full bg-gradient-to-r from-[#ffe08a] to-[#c8901a] shadow-[0_-2px_10px_rgba(245,196,81,0.8)] transition-transform duration-300 ${isActive(item.path) ? "scale-x-100" : "scale-x-0 group-hover:scale-x-100"}`}
            />
          </a>
        ))
      }
    </div>

    <div class="z-[110] flex items-center gap-3">
      <a
        href="/login"
        class="hidden rounded-full border-2 border-[#ffe08a]/30 bg-black/25 px-5 py-2.5 text-sm font-bold text-white backdrop-blur-md transition-all hover:border-[#ffe08a]/60 hover:bg-[#f5c451]/10 lg:flex">
        เข้าสู่ระบบ
      </a>
      <a
        href="/register"
        class="hidden rounded-full bg-gradient-to-r from-[#ffe08a] via-[#f5c451] to-[#c8901a] px-5 py-2.5 text-sm font-black text-[#2a0806] shadow-[0_4px_15px_rgba(245,196,81,0.45)] transition-all hover:-translate-y-0.5 hover:shadow-[0_8px_20px_rgba(245,196,81,0.65)] lg:flex">
        สมัครสมาชิก
      </a>

      <button id="hamburger-btn" class="relative flex h-[45px] w-[45px] flex-col items-center justify-center gap-[6px] rounded-full border border-[#f5c451]/35 bg-[#2a0806]/70 lg:hidden" aria-label="เปิดเมนู">
        <span class="line-1 h-[2px] w-5 origin-center rounded-full bg-[#ffe08a] transition-all duration-300"></span>
        <span class="line-2 h-[2px] w-5 origin-center rounded-full bg-[#ffe08a] transition-all duration-300"></span>
        <span class="line-3 h-[2px] w-5 origin-center rounded-full bg-[#ffe08a] transition-all duration-300"></span>
      </button>
    </div>
  </nav>

  <div
    id="mobile-menu"
    class="pointer-events-none absolute top-[85px] left-0 w-full origin-top -translate-y-4 scale-y-95 flex-col rounded-b-3xl border-b border-[#f5c451]/50 bg-[#5c1008]/98 px-6 pt-4 pb-8 opacity-0 shadow-2xl backdrop-blur-2xl transition-all duration-300 lg:hidden">
    <div class="flex flex-col gap-2">
      {
        menu.map((item) => (
          <a
            href={item.path}
            class={`flex items-center gap-3 rounded-xl px-4 py-3.5 text-lg font-bold tracking-widest uppercase transition-colors ${isActive(item.path) ? "border-l-4 border-[#f5c451] bg-[#f5c451]/10 text-[#ffe08a]" : "text-[#f7e4c0]/80 hover:bg-[#f5c451]/5 hover:text-white"}`}>
            <span aria-hidden="true" class="text-xl leading-none">
              {item.icon}
            </span>
            <span>{item.name}</span>
          </a>
        ))
      }
    </div>
    <div class="mt-6 flex flex-col gap-4">
      <a
        href="/register"
        class="flex w-full justify-center rounded-full bg-gradient-to-r from-[#ffe08a] via-[#f5c451] to-[#c8901a] py-3.5 text-lg font-black text-[#2a0806] shadow-[0_5px_15px_rgba(245,196,81,0.45)]">
        สมัครสมาชิก
      </a>
      <a href="/login" class="flex w-full justify-center rounded-full border-2 border-[#ffe08a]/30 bg-black/25 py-3.5 text-lg font-bold text-white">เข้าสู่ระบบ</a>
    </div>
  </div>
</header>

<style is:global>
  /* `nav, header { font-family: var(--font-sans) }` used to sit here and was
     dead weight: MainLayout already sets that on <body> with !important and it
     inherits. Only the two toggle states below are load-bearing. */
  #hamburger-btn.active .line-1 {
    transform: translateY(8px) rotate(45deg);
  }
  #hamburger-btn.active .line-2 {
    opacity: 0;
  }
  #hamburger-btn.active .line-3 {
    transform: translateY(-8px) rotate(-45deg);
  }
  #mobile-menu.show {
    opacity: 1;
    transform: translateY(0) scaleY(100%);
    pointer-events: auto;
  }
</style>

<script>
  const hamburgerBtn = document.getElementById("hamburger-btn");
  const mobileMenu = document.getElementById("mobile-menu");
  hamburgerBtn?.addEventListener("click", () => {
    const open = hamburgerBtn.classList.toggle("active");
    mobileMenu?.classList.toggle("show", open);
    hamburgerBtn.setAttribute("aria-label", open ? "ปิดเมนู" : "เปิดเมนู");
  });
</script>
