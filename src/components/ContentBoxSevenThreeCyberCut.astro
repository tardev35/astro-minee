---
export interface Props {
  titleleft?: string;
  titleright?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { titleleft, titleright, as: HeadingTag = "h2" } = Astro.props;

// Both column titles receive their text from the page (the docx), so pass only
// the column the brief actually has a heading for.
// The clipped corner rules are decorative and carry -z-10 against the card's
// `isolate`, so the slot content always paints above them without a wrapper.
//
// TT1BET: the headings are flat #fcf1b0 rather than clip-text — gold light
// clears contrast on the warm near-black card at this size, and the >_ glyph
// beside them takes the primary gold so the terminal motif stays inside the
// brand ramp without dropping under 3:1 the way bronze deep would. The second
// pair of corner rules runs bronze, so the two corners still read as a pair of
// different weights rather than one colour twice.
---

<section class="mx-auto mb-6 w-full max-w-7xl px-4 font-sans">
  <div
    class="relative isolate w-full border border-[#e9c341]/35 bg-[#171008]/92 p-8 text-[#f2e7cd] shadow-[0_10px_30px_rgba(233,195,65,0.22)] backdrop-blur-md transition-all duration-300 hover:border-[#fcf1b0]/60 hover:shadow-[0_15px_40px_rgba(233,195,65,0.28)]"
    style="clip-path: polygon(30px 0, 100% 0, 100% calc(100% - 30px), calc(100% - 30px) 100%, 0 100%, 0 30px);">
    <div aria-hidden="true" class="absolute top-0 left-0 -z-10 h-[2px] w-24 bg-gradient-to-r from-[#fcf1b0] to-transparent"></div>
    <div aria-hidden="true" class="absolute right-0 bottom-0 -z-10 h-[2px] w-24 bg-gradient-to-l from-[#b8862a] to-transparent"></div>
    <div aria-hidden="true" class="absolute top-0 left-0 -z-10 h-16 w-[2px] bg-gradient-to-b from-[#fcf1b0] to-transparent"></div>
    <div aria-hidden="true" class="absolute right-0 bottom-0 -z-10 h-16 w-[2px] bg-gradient-to-t from-[#b8862a] to-transparent"></div>

    <div class="grid grid-cols-1 gap-8 md:grid-cols-[3fr_7fr] md:items-center">
      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#f2e7cd]">
        {
          titleleft && (
            <div class="flex items-baseline gap-2 border-b border-[#6d4a13]/55 pb-2">
              <span aria-hidden="true" class="font-mono text-[#e9c341]">
                &gt;_
              </span>
              <HeadingTag class="text-xl leading-normal font-black text-[#fcf1b0] uppercase">{titleleft}</HeadingTag>
            </div>
          )
        }
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#f2e7cd] md:border-l md:border-[#6d4a13]/55 md:pl-8">
        {
          titleright && (
            <div class="flex items-baseline gap-2 border-b border-[#6d4a13]/55 pb-2">
              <span aria-hidden="true" class="font-mono text-[#e9c341]">
                &gt;_
              </span>
              <HeadingTag class="text-xl leading-normal font-black text-[#fcf1b0] uppercase">{titleright}</HeadingTag>
            </div>
          )
        }
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
