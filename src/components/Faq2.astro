---
export interface FaqItem {
  q: string;
  a: string;
}

export interface Props {
  title?: string;
  faqs?: FaqItem[];
}

const { title, faqs = [] } = Astro.props;

// The section title is the docx's FAQ H2. The questions themselves render as a
// <span> carrying the same classes, not an <h3>: this brand's docx is flat
// H1 + H2, and the page's heading inventory is diffed against that checklist
// every rebrand. <details>/<summary> already exposes each question as a
// disclosure control, so nothing is lost by dropping the tag.
//
// TAKO168: the clipped card runs a gold → crimson hairline over a deep red
// panel. The "?" tile keeps a gold-only fill so its near-black ink stays
// readable end to end — a gold → crimson fade would have put #0a0403 on a dark
// red at the bottom.
---

<section class="mx-auto max-w-[950px] space-y-6 px-4 py-6 font-sans">
  {
    title && (
      <header class="mb-8 text-center">
        <h2 class="bg-gradient-to-r from-[#ffd97a] via-[#e8b23a] to-[#ff6a5a] bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase drop-shadow-sm md:text-3xl">
          {title}
        </h2>
        <div class="mx-auto mt-3 h-[3px] w-24 rounded-full bg-gradient-to-r from-transparent via-[#e8b23a] to-transparent" />
      </header>
    )
  }

  {
    faqs.map((faq) => (
      <div class="group relative bg-[#8f0f0a] p-[1px] [clip-path:polygon(0_0,calc(100%-20px)_0,100%_20px,100%_100%,20px_100%,0_calc(100%-20px))]">
        <div class="absolute inset-0 bg-gradient-to-r from-[#e8b23a] via-[#e11d16] to-transparent opacity-40 transition-opacity group-hover:opacity-100" />

        <details class="faq-item relative bg-[#1a0806] p-4 [clip-path:polygon(0_0,calc(100%-19px)_0,100%_19px,100%_100%,19px_100%,0_calc(100%-19px))]">
          <summary class="flex w-full cursor-pointer items-center gap-4 text-left">
            <span
              aria-hidden="true"
              class="flex h-10 w-10 shrink-0 items-center justify-center bg-gradient-to-br from-[#ffd97a] to-[#e8b23a] font-black text-[#0a0403] italic [clip-path:polygon(20%_0,100%_0,80%_100%,0_100%)]">
              ?
            </span>
            <span class="flex-1 text-base leading-normal font-bold tracking-tight text-[#f6e5df]">{faq.q}</span>
            <span aria-hidden="true" class="faq-arrow shrink-0 text-[#e8b23a] transition-transform duration-300">
              ▼
            </span>
          </summary>

          <p class="faq-answer mt-4 border-l-2 border-[#e11d16]/70 pl-4 text-left text-base leading-relaxed text-[#f6e5df]/90">{faq.a}</p>
        </details>
      </div>
    ))
  }
</section>

<style>
  .faq-item > summary {
    list-style: none;
  }
  .faq-item > summary::-webkit-details-marker {
    display: none;
  }
  .faq-item[open] .faq-arrow {
    transform: rotate(180deg);
  }
  .faq-item[open] .faq-answer {
    animation: faq-reveal 0.25s ease-out;
  }

  @keyframes faq-reveal {
    from {
      opacity: 0;
      transform: translateY(-4px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .faq-item[open] .faq-answer {
      animation: none;
    }
  }
</style>
