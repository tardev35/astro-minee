---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;
---

<section class="relative z-10 my-8 flex w-full justify-center px-4 font-sans">
  <div
    class="group relative isolate w-full max-w-[1400px] overflow-hidden rounded-3xl border border-[#22d3ee]/25 bg-[#0d0a2b]/92 p-8 text-left text-base leading-relaxed text-[#cfe3f5] shadow-[0_10px_30px_rgba(34,211,238,0.14)] backdrop-blur-xl transition-all duration-500 hover:border-[#22d3ee]/50 hover:shadow-[0_15px_40px_rgba(34,211,238,0.24)] md:p-10">
    <div class="pointer-events-none absolute -top-20 -left-20 -z-10 h-40 w-40 rounded-full bg-[#22d3ee]/20 blur-[60px] transition-all duration-500 group-hover:bg-[#22d3ee]/30"></div>
    <div class="pointer-events-none absolute -right-20 -bottom-20 -z-10 h-40 w-40 rounded-full bg-[#6d28d9]/30 blur-[60px] transition-all duration-500 group-hover:bg-[#a855f7]/35"></div>

    {
      title && (
        <header class="mb-6 flex items-center gap-4 border-b border-[#22d3ee]/25 pb-4">
          <div class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#a5f3fc] to-[#a855f7] shadow-[0_0_10px_rgba(34,211,238,0.45)]" />
          <HeadingTag class="bg-gradient-to-r from-[#a5f3fc] via-[#22d3ee] to-[#a855f7] bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase">{title}</HeadingTag>
        </header>
      )
    }
    <slot />
  </div>
</section>
