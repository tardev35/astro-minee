---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;
---

<section class="relative z-10 my-8 flex w-full justify-center px-4 font-sans">
  <div
    class="group relative isolate w-full max-w-[1400px] overflow-hidden rounded-3xl border border-[#f1509b]/30 bg-[#1d0512]/92 p-8 text-left text-base leading-relaxed text-[#f6e3ee] shadow-[0_10px_30px_rgba(241,80,155,0.16)] backdrop-blur-xl transition-all duration-500 hover:border-[#b5054f]/55 hover:shadow-[0_15px_40px_rgba(181,5,79,0.22)] md:p-10">
    <div class="pointer-events-none absolute -top-20 -left-20 -z-10 h-40 w-40 rounded-full bg-[#f1509b]/25 blur-[60px] transition-all duration-500 group-hover:bg-[#f1509b]/35"></div>
    <div class="pointer-events-none absolute -right-20 -bottom-20 -z-10 h-40 w-40 rounded-full bg-[#5c0428]/40 blur-[60px] transition-all duration-500 group-hover:bg-[#8c0a3c]/45"></div>

    {
      title && (
        <header class="mb-6 flex items-center gap-4 border-b border-[#f1509b]/25 pb-4">
          <div class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#fda3cd] to-[#8c0a3c] shadow-[0_0_10px_rgba(241,80,155,0.5)]" />
          <HeadingTag class="bg-gradient-to-r from-[#fda3cd] via-[#f1509b] to-[#b5054f] bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase">{title}</HeadingTag>
        </header>
      )
    }
    <slot />
  </div>
</section>
