---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;
---

<section class="relative z-10 my-8 flex w-full justify-center px-4 font-sans">
  <div
    class="group relative isolate w-full max-w-[1400px] overflow-hidden rounded-3xl border border-[#f5c518]/30 bg-[#0a1a44]/92 p-8 text-left text-base leading-relaxed text-[#dbe6ff] shadow-[0_10px_30px_rgba(245,197,24,0.16)] backdrop-blur-xl transition-all duration-500 hover:border-[#5b9dff]/55 hover:shadow-[0_15px_40px_rgba(26,92,245,0.24)] md:p-10">
    <div class="pointer-events-none absolute -top-20 -left-20 -z-10 h-40 w-40 rounded-full bg-[#f5c518]/25 blur-[60px] transition-all duration-500 group-hover:bg-[#f5c518]/35"></div>
    <div class="pointer-events-none absolute -right-20 -bottom-20 -z-10 h-40 w-40 rounded-full bg-[#0b2f8f]/55 blur-[60px] transition-all duration-500 group-hover:bg-[#1a5cf5]/45"></div>

    {
      title && (
        <header class="mb-6 flex items-center gap-4 border-b border-[#f5c518]/25 pb-4">
          <div class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#ffe9a8] to-[#b8770a] shadow-[0_0_10px_rgba(245,197,24,0.5)]" />
          <HeadingTag class="bg-gradient-to-r from-[#ffe9a8] via-[#f5c518] to-[#b8770a] bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase">{title}</HeadingTag>
        </header>
      )
    }
    <slot />
  </div>
</section>
