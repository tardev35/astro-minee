---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;
---

<section class="relative z-10 my-8 flex w-full justify-center px-4 font-sans">
  <div
    class="group relative isolate w-full max-w-[1400px] overflow-hidden rounded-3xl border border-[#f8d441]/30 bg-[#150f05]/92 p-8 text-left text-base leading-relaxed text-[#f5ecd6] shadow-[0_10px_30px_rgba(248,212,65,0.16)] backdrop-blur-xl transition-all duration-500 hover:border-[#d9a520]/55 hover:shadow-[0_15px_40px_rgba(217,165,32,0.22)] md:p-10">
    <div class="pointer-events-none absolute -top-20 -left-20 -z-10 h-40 w-40 rounded-full bg-[#f8d441]/25 blur-[60px] transition-all duration-500 group-hover:bg-[#f8d441]/35"></div>
    <div class="pointer-events-none absolute -right-20 -bottom-20 -z-10 h-40 w-40 rounded-full bg-[#6d4f06]/40 blur-[60px] transition-all duration-500 group-hover:bg-[#8a6205]/45"></div>

    {
      title && (
        <header class="mb-6 flex items-center gap-4 border-b border-[#f8d441]/25 pb-4">
          <div class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#fff3ae] to-[#8a6205] shadow-[0_0_10px_rgba(248,212,65,0.5)]" />
          <HeadingTag class="bg-gradient-to-r from-[#fff3ae] via-[#f8d441] to-[#d9a520] bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase">{title}</HeadingTag>
        </header>
      )
    }
    <slot />
  </div>
</section>
