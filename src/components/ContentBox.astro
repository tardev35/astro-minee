---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;

// The permanent pages (terms, privacy) render through THIS file and no other, so
// it can never follow the per-brand ContentBox rotation. It also has to carry the
// body text colour itself: nothing inside those pages names a colour, by design.
//
// No slot wrapper. `isolate` makes the card its own stacking context and the two
// decorative blurs sit at -z-10, so they paint above the card background but
// below the text without a `relative z-10` div in between.
//
// RENGER8888 is a crimson brand with a chrome-silver second metal, taken from the
// logo: a red-caped knight in silver plate, "RANGER" in brushed steel over "8888"
// in crimson. So the rule and the glows carry the crimson, and the heading runs
// steel → crimson → blood-red left to right, which is the wordmark's own bevel.
// Warm off-white body copy sits on a near-black maroon card; putting the accent
// crimson on a crimson surface is where the contrast would go.
---

<section class="relative z-10 my-8 flex w-full justify-center px-4 font-sans">
  <div
    class="group relative isolate w-full max-w-[1400px] overflow-hidden rounded-3xl border border-[#8f0c14]/45 bg-[#160406]/92 p-8 text-left text-base leading-relaxed text-[#f0dcdc] shadow-[0_10px_30px_rgba(232,18,31,0.22)] backdrop-blur-xl transition-all duration-500 hover:border-[#e8121f]/70 hover:shadow-[0_15px_40px_rgba(232,18,31,0.3)] md:p-10">
    <div aria-hidden="true" class="pointer-events-none absolute -top-20 -left-20 -z-10 h-40 w-40 rounded-full bg-[#8f0c14]/28 blur-[60px] transition-all duration-500 group-hover:bg-[#e8121f]/32"></div>
    <div aria-hidden="true" class="pointer-events-none absolute -right-20 -bottom-20 -z-10 h-40 w-40 rounded-full bg-[#28080b]/80 blur-[60px] transition-all duration-500 group-hover:bg-[#8f0c14]/45"></div>

    {
      title && (
        <header class="mb-6 flex items-center gap-4 border-b border-[#8f0c14]/35 pb-4">
          <div aria-hidden="true" class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#e6ecf2] to-[#8f0c14] shadow-[0_0_10px_rgba(232,18,31,0.5)]" />
          <HeadingTag class="bg-gradient-to-r from-[#e6ecf2] via-[#e8121f] to-[#8f0c14] bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase">{title}</HeadingTag>
        </header>
      )
    }
    <slot />
  </div>
</section>
