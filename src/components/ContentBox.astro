---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;

// The permanent pages (terms, privacy) render through THIS file and no other, so
// it can never follow the per-brand ContentBox rotation. It also has to carry the
// body text colour itself: nothing inside those pages names a colour, by design.
//
// No slot wrapper. `isolate` makes the card its own stacking context and the two
// decorative blurs sit at -z-10, so they paint above the card background but
// below the text without a `relative z-10` div in between.
---

<section class="relative z-10 my-8 flex w-full justify-center px-4 font-sans">
  <div
    class="group relative isolate w-full max-w-[1400px] overflow-hidden rounded-3xl border border-[#2b8cff]/35 bg-[#08152f]/92 p-8 text-left text-base leading-relaxed text-[#dbe9fb] shadow-[0_10px_30px_rgba(43,140,255,0.18)] backdrop-blur-xl transition-all duration-500 hover:border-[#5eb0ff]/60 hover:shadow-[0_15px_40px_rgba(157,206,240,0.26)] md:p-10">
    <div aria-hidden="true" class="pointer-events-none absolute -top-20 -left-20 -z-10 h-40 w-40 rounded-full bg-[#2b8cff]/25 blur-[60px] transition-all duration-500 group-hover:bg-[#5eb0ff]/35"></div>
    <div aria-hidden="true" class="pointer-events-none absolute -right-20 -bottom-20 -z-10 h-40 w-40 rounded-full bg-[#0d2350]/55 blur-[60px] transition-all duration-500 group-hover:bg-[#123061]/60"></div>

    {
      title && (
        <header class="mb-6 flex items-center gap-4 border-b border-[#2b8cff]/25 pb-4">
          <div aria-hidden="true" class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#ffcc33] to-[#0d2350] shadow-[0_0_10px_rgba(255,204,51,0.5)]" />
          <HeadingTag class="bg-gradient-to-r from-[#ffe488] via-[#ffcc33] to-[#9dcef0] bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase">{title}</HeadingTag>
        </header>
      )
    }
    <slot />
  </div>
</section>
