---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;

// The permanent pages (terms, privacy) render through THIS file and no other, so
// it can never follow the per-brand ContentBox rotation. It also has to carry the
// body text colour itself: nothing inside those pages names a colour, by design.
//
// No slot wrapper. `isolate` makes the card its own stacking context and the two
// decorative blurs sit at -z-10, so they paint above the card background but
// below the text without a `relative z-10` div in between.
//
// MVP928 is a burnt copper-orange brand with a chrome-silver second metal, taken
// from the logo: "MVP" is white-to-silver, "928" is peach-to-orange. So the rule
// and the glows carry the copper, and the heading runs chrome → gold → copper
// left to right, which is the wordmark's own bevel. Warm ivory body copy sits on
// a warm near-black card; putting the accent copper on a copper surface is where
// the contrast would go.
---

<section class="relative z-10 my-8 flex w-full justify-center px-4 font-sans">
  <div
    class="group relative isolate w-full max-w-[1400px] overflow-hidden rounded-3xl border border-[#ef6a17]/40 bg-[#1c0e05]/92 p-8 text-left text-base leading-relaxed text-[#ece0d6] shadow-[0_10px_30px_rgba(239,106,23,0.22)] backdrop-blur-xl transition-all duration-500 hover:border-[#f0b243]/65 hover:shadow-[0_15px_40px_rgba(239,106,23,0.3)] md:p-10">
    <div aria-hidden="true" class="pointer-events-none absolute -top-20 -left-20 -z-10 h-40 w-40 rounded-full bg-[#ef6a17]/24 blur-[60px] transition-all duration-500 group-hover:bg-[#f0b243]/30"></div>
    <div aria-hidden="true" class="pointer-events-none absolute -right-20 -bottom-20 -z-10 h-40 w-40 rounded-full bg-[#2a1508]/80 blur-[60px] transition-all duration-500 group-hover:bg-[#b34a08]/40"></div>

    {
      title && (
        <header class="mb-6 flex items-center gap-4 border-b border-[#ef6a17]/30 pb-4">
          <div aria-hidden="true" class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#eaeef3] to-[#b34a08] shadow-[0_0_10px_rgba(239,106,23,0.5)]" />
          <HeadingTag class="bg-gradient-to-r from-[#eaeef3] via-[#f0b243] to-[#ef6a17] bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase">{title}</HeadingTag>
        </header>
      )
    }
    <slot />
  </div>
</section>
