---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;

// The permanent pages (terms, privacy) render through THIS file and no other, so
// it can never follow the per-brand ContentBox rotation. It also has to carry the
// body text colour itself: nothing inside those pages names a colour, by design.
//
// No slot wrapper. `isolate` makes the card its own stacking context and the two
// decorative blurs sit at -z-10, so they paint above the card background but
// below the text without a `relative z-10` div in between.
//
// TT1BET is a Thai casino/slot brand in gold on warm near-black, taken from its
// own artwork: a brushed-silver "TT1" beside a gold "BET", shot over chandeliers,
// a roulette wheel and stacked gold chips. Gold (#e9c341) is the identity hue and
// carries the rule, the heading gradient and every glow; the card sits on warm
// ink with ivory body copy. Bronze (#b8862a) is the secondary accent, kept for
// the heading gradient's deep end and the card edge.
---

<section class="relative z-10 my-8 flex w-full justify-center px-4 font-sans">
  <div
    class="group relative isolate w-full max-w-[1400px] overflow-hidden rounded-3xl border border-[#6d4a13]/55 bg-[#171008]/92 p-8 text-left text-base leading-relaxed text-[#f2e7cd] shadow-[0_10px_30px_rgba(233,195,65,0.18)] backdrop-blur-xl transition-all duration-500 hover:border-[#e9c341]/70 hover:shadow-[0_15px_40px_rgba(233,195,65,0.3)] md:p-10">
    <div aria-hidden="true" class="pointer-events-none absolute -top-20 -left-20 -z-10 h-40 w-40 rounded-full bg-[#b8862a]/45 blur-[60px] transition-all duration-500 group-hover:bg-[#e9c341]/28"></div>
    <div aria-hidden="true" class="pointer-events-none absolute -right-20 -bottom-20 -z-10 h-40 w-40 rounded-full bg-[#241a0d]/80 blur-[60px] transition-all duration-500 group-hover:bg-[#6d4a13]/70"></div>

    {
      title && (
        <header class="mb-6 flex items-center gap-4 border-b border-[#6d4a13]/45 pb-4">
          <div aria-hidden="true" class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#fff8d6] to-[#b8862a] shadow-[0_0_10px_rgba(233,195,65,0.55)]" />
          <HeadingTag class="bg-gradient-to-r from-[#fff8d6] via-[#e9c341] to-[#b8862a] bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase">{title}</HeadingTag>
        </header>
      )
    }
    <slot />
  </div>
</section>
