---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;

// The permanent pages (terms, privacy) render through THIS file and no other, so
// it can never follow the per-brand ContentBox rotation. It also has to carry the
// body text colour itself: nothing inside those pages names a colour, by design.
//
// No slot wrapper. `isolate` makes the card its own stacking context and the two
// decorative blurs sit at -z-10, so they paint above the card background but
// below the text without a `relative z-10` div in between.
//
// JAIDEEJING is a Thai lottery brand in gold on oxblood, taken from its own
// artwork: a gold dragon coiled around a red-and-gold coin emblem, gold temple
// spires and lotto balls over red silk. Gold (#f5c451) is the accent and carries
// the rule, the heading gradient and every glow; the card sits on the deepest
// maroon ink with warm cream body copy. Crimson (#d12027) is reserved for calls
// to action — a red card border reads as a button, so the edge here is gold.
---

<section class="relative z-10 my-8 flex w-full justify-center px-4 font-sans">
  <div
    class="group relative isolate w-full max-w-[1400px] overflow-hidden rounded-3xl border border-[#8f1a10]/55 bg-[#1e0705]/92 p-8 text-left text-base leading-relaxed text-[#f7e4c0] shadow-[0_10px_30px_rgba(245,196,81,0.18)] backdrop-blur-xl transition-all duration-500 hover:border-[#f5c451]/70 hover:shadow-[0_15px_40px_rgba(245,196,81,0.3)] md:p-10">
    <div aria-hidden="true" class="pointer-events-none absolute -top-20 -left-20 -z-10 h-40 w-40 rounded-full bg-[#8f1a10]/45 blur-[60px] transition-all duration-500 group-hover:bg-[#f5c451]/28"></div>
    <div aria-hidden="true" class="pointer-events-none absolute -right-20 -bottom-20 -z-10 h-40 w-40 rounded-full bg-[#3a1008]/80 blur-[60px] transition-all duration-500 group-hover:bg-[#8f1a10]/70"></div>

    {
      title && (
        <header class="mb-6 flex items-center gap-4 border-b border-[#8f1a10]/45 pb-4">
          <div aria-hidden="true" class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#ffe08a] to-[#c8901a] shadow-[0_0_10px_rgba(245,196,81,0.55)]" />
          <HeadingTag class="bg-gradient-to-r from-[#ffe08a] via-[#f5c451] to-[#c8901a] bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase">{title}</HeadingTag>
        </header>
      )
    }
    <slot />
  </div>
</section>
