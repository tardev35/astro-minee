---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;

// The permanent pages (terms, privacy) render through THIS file and no other, so
// it can never follow the per-brand ContentBox rotation. It also has to carry the
// body text colour itself: nothing inside those pages names a colour, by design.
//
// No slot wrapper. `isolate` makes the card its own stacking context and the two
// decorative blurs sit at -z-10, so they paint above the card background but
// below the text without a `relative z-10` div in between.
//
// DIAMOND789 two-tone: hot pink carries the surfaces (border, rule, glows) and
// the soft pink-white body copy sits on a near-black card. The heading runs
// chrome silver → bright pink → magenta, which is the logo read left to right
// (the silver "aimond" into the pink 789); putting pink on pink is where the
// contrast would go.
---

<section class="relative z-10 my-8 flex w-full justify-center px-4 font-sans">
  <div
    class="group relative isolate w-full max-w-[1400px] overflow-hidden rounded-3xl border border-[#f30d8c]/40 bg-[#150810]/92 p-8 text-left text-base leading-relaxed text-[#f8e3f0] shadow-[0_10px_30px_rgba(243,13,140,0.22)] backdrop-blur-xl transition-all duration-500 hover:border-[#ff5cb8]/65 hover:shadow-[0_15px_40px_rgba(243,13,140,0.3)] md:p-10">
    <div aria-hidden="true" class="pointer-events-none absolute -top-20 -left-20 -z-10 h-40 w-40 rounded-full bg-[#f30d8c]/24 blur-[60px] transition-all duration-500 group-hover:bg-[#ff5cb8]/30"></div>
    <div aria-hidden="true" class="pointer-events-none absolute -right-20 -bottom-20 -z-10 h-40 w-40 rounded-full bg-[#2b0620]/80 blur-[60px] transition-all duration-500 group-hover:bg-[#b312ac]/40"></div>

    {
      title && (
        <header class="mb-6 flex items-center gap-4 border-b border-[#f30d8c]/30 pb-4">
          <div aria-hidden="true" class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#e8e8ef] to-[#b80568] shadow-[0_0_10px_rgba(243,13,140,0.5)]" />
          <HeadingTag class="bg-gradient-to-r from-[#e8e8ef] via-[#ff5cb8] to-[#f30d8c] bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase">{title}</HeadingTag>
        </header>
      )
    }
    <slot />
  </div>
</section>
