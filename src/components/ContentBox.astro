---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;

// The permanent pages (terms, privacy) render through THIS file and no other, so
// it can never follow the per-brand ContentBox rotation. It also has to carry the
// body text colour itself: nothing inside those pages names a colour, by design.
//
// No slot wrapper. `isolate` makes the card its own stacking context and the two
// decorative blurs sit at -z-10, so they paint above the card background but
// below the text without a `relative z-10` div in between.
//
// หวยพร้อม is a lottery brand in deep neon green with gold prize accents, taken
// from its own artwork: green city-glow behind gold lottery balls, and a red
// tick in the wordmark that this file deliberately does NOT use — red is
// reserved for calls to action, so a card border in it would read as a button.
// The rule and the glows carry the green, the heading runs mint → neon green →
// gold left to right (the artwork's own ramp), and soft green-white body copy
// sits on a near-black green card.
---

<section class="relative z-10 my-8 flex w-full justify-center px-4 font-sans">
  <div
    class="group relative isolate w-full max-w-[1400px] overflow-hidden rounded-3xl border border-[#1e7a3a]/45 bg-[#0a2413]/92 p-8 text-left text-base leading-relaxed text-[#d8efdc] shadow-[0_10px_30px_rgba(34,197,94,0.22)] backdrop-blur-xl transition-all duration-500 hover:border-[#22c55e]/70 hover:shadow-[0_15px_40px_rgba(34,197,94,0.3)] md:p-10">
    <div aria-hidden="true" class="pointer-events-none absolute -top-20 -left-20 -z-10 h-40 w-40 rounded-full bg-[#1e7a3a]/28 blur-[60px] transition-all duration-500 group-hover:bg-[#22c55e]/32"></div>
    <div aria-hidden="true" class="pointer-events-none absolute -right-20 -bottom-20 -z-10 h-40 w-40 rounded-full bg-[#10361c]/80 blur-[60px] transition-all duration-500 group-hover:bg-[#1e7a3a]/60"></div>

    {
      title && (
        <header class="mb-6 flex items-center gap-4 border-b border-[#1e7a3a]/35 pb-4">
          <div aria-hidden="true" class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#6ee7a0] to-[#1e7a3a] shadow-[0_0_10px_rgba(34,197,94,0.5)]" />
          <HeadingTag class="bg-gradient-to-r from-[#d8efdc] via-[#22c55e] to-[#f5c451] bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase">{title}</HeadingTag>
        </header>
      )
    }
    <slot />
  </div>
</section>
