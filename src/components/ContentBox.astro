---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;

// The permanent pages (terms, privacy) render through THIS file and no other, so
// it can never follow the per-brand ContentBox rotation. It also has to carry the
// body text colour itself: nothing inside those pages names a colour, by design.
//
// No slot wrapper. `isolate` makes the card its own stacking context and the two
// decorative blurs sit at -z-10, so they paint above the card background but
// below the text without a `relative z-10` div in between.
//
// RUAYRUAY888 is a multi-provider casino brand in neon hot pink on near-black,
// taken from its own artwork: pink neon rings and glow over a rose-tinted black
// casino floor, with white as the contrast note. The measured logo hue (#f874a1)
// carries the rule and the glows; the heading runs pink-white → hot pink → deep
// pink left to right, and soft pink-white body copy sits on a rose-black card.
// No gold anywhere — that was the previous brand's secondary.
---

<section class="relative z-10 my-8 flex w-full justify-center px-4 font-sans">
  <div
    class="group relative isolate w-full max-w-[1400px] overflow-hidden rounded-3xl border border-[#8f1140]/45 bg-[#1a1113]/92 p-8 text-left text-base leading-relaxed text-[#f6dde8] shadow-[0_10px_30px_rgba(248,116,161,0.22)] backdrop-blur-xl transition-all duration-500 hover:border-[#f874a1]/70 hover:shadow-[0_15px_40px_rgba(248,116,161,0.32)] md:p-10">
    <div aria-hidden="true" class="pointer-events-none absolute -top-20 -left-20 -z-10 h-40 w-40 rounded-full bg-[#8f1140]/32 blur-[60px] transition-all duration-500 group-hover:bg-[#f874a1]/32"></div>
    <div aria-hidden="true" class="pointer-events-none absolute -right-20 -bottom-20 -z-10 h-40 w-40 rounded-full bg-[#3a1d24]/80 blur-[60px] transition-all duration-500 group-hover:bg-[#8f1140]/60"></div>

    {
      title && (
        <header class="mb-6 flex items-center gap-4 border-b border-[#8f1140]/35 pb-4">
          <div aria-hidden="true" class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#fdb4d4] to-[#8f1140] shadow-[0_0_10px_rgba(248,116,161,0.55)]" />
          <HeadingTag class="bg-gradient-to-r from-[#fdb4d4] via-[#f874a1] to-[#d6377a] bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase">{title}</HeadingTag>
        </header>
      )
    }
    <slot />
  </div>
</section>
