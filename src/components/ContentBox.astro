---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;
---

<section class="relative z-10 my-8 flex w-full justify-center px-4 font-sans">
  <div
    class="group relative isolate w-full max-w-[1400px] overflow-hidden rounded-3xl border border-[#8fd318]/30 bg-[#08210f]/92 p-8 text-left text-base leading-relaxed text-[#e6f3dd] shadow-[0_10px_30px_rgba(143,211,24,0.16)] backdrop-blur-xl transition-all duration-500 hover:border-[#1c7a2f]/60 hover:shadow-[0_15px_40px_rgba(28,122,47,0.24)] md:p-10">
    <div class="pointer-events-none absolute -top-20 -left-20 -z-10 h-40 w-40 rounded-full bg-[#8fd318]/25 blur-[60px] transition-all duration-500 group-hover:bg-[#8fd318]/35"></div>
    <div class="pointer-events-none absolute -right-20 -bottom-20 -z-10 h-40 w-40 rounded-full bg-[#0a3d1c]/50 blur-[60px] transition-all duration-500 group-hover:bg-[#125c26]/55"></div>

    {
      title && (
        <header class="mb-6 flex items-center gap-4 border-b border-[#8fd318]/25 pb-4">
          <div class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#e4f223] to-[#125c26] shadow-[0_0_10px_rgba(143,211,24,0.5)]" />
          <HeadingTag class="bg-gradient-to-r from-[#e4f223] via-[#8fd318] to-[#1c7a2f] bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase">{title}</HeadingTag>
        </header>
      )
    }
    <slot />
  </div>
</section>
