---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;

// The permanent pages (terms, privacy) render through THIS file and no other, so
// it can never follow the per-brand ContentBox rotation. It also has to carry the
// body text colour itself: nothing inside those pages names a colour, by design.
//
// No slot wrapper. `isolate` makes the card its own stacking context and the two
// decorative blurs sit at -z-10, so they paint above the card background but
// below the text without a `relative z-10` div in between.
---

<section class="relative z-10 my-8 flex w-full justify-center px-4 font-sans">
  <div
    class="group relative isolate w-full max-w-[1400px] overflow-hidden rounded-3xl border border-[#c10d1e]/35 bg-[#1a0508]/92 p-8 text-left text-base leading-relaxed text-[#f6e4e4] shadow-[0_10px_30px_rgba(193,13,30,0.18)] backdrop-blur-xl transition-all duration-500 hover:border-[#e8202f]/60 hover:shadow-[0_15px_40px_rgba(232,32,47,0.26)] md:p-10">
    <div class="pointer-events-none absolute -top-20 -left-20 -z-10 h-40 w-40 rounded-full bg-[#c10d1e]/25 blur-[60px] transition-all duration-500 group-hover:bg-[#e8202f]/35"></div>
    <div class="pointer-events-none absolute -right-20 -bottom-20 -z-10 h-40 w-40 rounded-full bg-[#5a0209]/55 blur-[60px] transition-all duration-500 group-hover:bg-[#8c0512]/60"></div>

    {
      title && (
        <header class="mb-6 flex items-center gap-4 border-b border-[#c10d1e]/25 pb-4">
          <div class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#ffe9a8] to-[#8c0512] shadow-[0_0_10px_rgba(245,196,81,0.5)]" />
          <HeadingTag class="bg-gradient-to-r from-[#ffe9a8] via-[#f5c451] to-[#c10d1e] bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase">{title}</HeadingTag>
        </header>
      )
    }
    <slot />
  </div>
</section>
