---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;

// The permanent pages (terms, privacy) render through THIS file and no other, so
// it can never follow the per-brand ContentBox rotation. It also has to carry the
// body text colour itself: nothing inside those pages names a colour, by design.
//
// No slot wrapper. `isolate` makes the card its own stacking context and the two
// decorative blurs sit at -z-10, so they paint above the card background but
// below the text without a `relative z-10` div in between.
//
// PATTAYA168 is a Thai slot brand in turquoise on deep ocean ink, taken from its
// own artwork: a cyan disc holding a stylised palm over water ripples, a night
// Pattaya bay and gold "168" balls. Cyan (#02c4e3) is the identity hue and
// carries the rule, the heading gradient and every glow; the card sits on the
// deepest teal with pale seafoam body copy. Gold (#fdac13) is the secondary
// accent, kept for the heading gradient's warm end rather than the card edge.
---

<section class="relative z-10 my-8 flex w-full justify-center px-4 font-sans">
  <div
    class="group relative isolate w-full max-w-[1400px] overflow-hidden rounded-3xl border border-[#0c8ba4]/55 bg-[#04222b]/92 p-8 text-left text-base leading-relaxed text-[#cfeef7] shadow-[0_10px_30px_rgba(2,196,227,0.18)] backdrop-blur-xl transition-all duration-500 hover:border-[#02c4e3]/70 hover:shadow-[0_15px_40px_rgba(2,196,227,0.3)] md:p-10">
    <div aria-hidden="true" class="pointer-events-none absolute -top-20 -left-20 -z-10 h-40 w-40 rounded-full bg-[#0c8ba4]/45 blur-[60px] transition-all duration-500 group-hover:bg-[#02c4e3]/28"></div>
    <div aria-hidden="true" class="pointer-events-none absolute -right-20 -bottom-20 -z-10 h-40 w-40 rounded-full bg-[#032c3c]/80 blur-[60px] transition-all duration-500 group-hover:bg-[#0c8ba4]/70"></div>

    {
      title && (
        <header class="mb-6 flex items-center gap-4 border-b border-[#0c8ba4]/45 pb-4">
          <div aria-hidden="true" class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#8ff5ff] to-[#0c8ba4] shadow-[0_0_10px_rgba(2,196,227,0.55)]" />
          <HeadingTag class="bg-gradient-to-r from-[#8ff5ff] via-[#02c4e3] to-[#fdac13] bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase">{title}</HeadingTag>
        </header>
      )
    }
    <slot />
  </div>
</section>
