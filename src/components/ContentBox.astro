---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;

// The permanent pages (terms, privacy) render through THIS file and no other, so
// it can never follow the per-brand ContentBox rotation. It also has to carry the
// body text colour itself: nothing inside those pages names a colour, by design.
//
// No slot wrapper. `isolate` makes the card its own stacking context and the two
// decorative blurs sit at -z-10, so they paint above the card background but
// below the text without a `relative z-10` div in between.
//
// PRODED888 is a royal navy-and-gold brand, taken from the logo: bevelled gold
// "PRODED" on a gold ribbon over a navy roulette disc, "888" in navy under a
// gold crown. So the rule and the glows carry the gold, and the heading runs
// platinum → gold → deep gold left to right, which is the wordmark's own bevel.
// Warm ivory body copy sits on a deep navy card; putting the accent gold on a
// gold surface is where the contrast would go.
---

<section class="relative z-10 my-8 flex w-full justify-center px-4 font-sans">
  <div
    class="group relative isolate w-full max-w-[1400px] overflow-hidden rounded-3xl border border-[#8f6614]/45 bg-[#0d1338]/92 p-8 text-left text-base leading-relaxed text-[#ece0c2] shadow-[0_10px_30px_rgba(227,181,63,0.22)] backdrop-blur-xl transition-all duration-500 hover:border-[#e3b53f]/70 hover:shadow-[0_15px_40px_rgba(227,181,63,0.3)] md:p-10">
    <div aria-hidden="true" class="pointer-events-none absolute -top-20 -left-20 -z-10 h-40 w-40 rounded-full bg-[#8f6614]/28 blur-[60px] transition-all duration-500 group-hover:bg-[#e3b53f]/32"></div>
    <div aria-hidden="true" class="pointer-events-none absolute -right-20 -bottom-20 -z-10 h-40 w-40 rounded-full bg-[#18225c]/80 blur-[60px] transition-all duration-500 group-hover:bg-[#2a3a8f]/60"></div>

    {
      title && (
        <header class="mb-6 flex items-center gap-4 border-b border-[#8f6614]/35 pb-4">
          <div aria-hidden="true" class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#dbe3f5] to-[#8f6614] shadow-[0_0_10px_rgba(227,181,63,0.5)]" />
          <HeadingTag class="bg-gradient-to-r from-[#dbe3f5] via-[#e3b53f] to-[#8f6614] bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase">{title}</HeadingTag>
        </header>
      )
    }
    <slot />
  </div>
</section>
