---
export interface Props {
  titleleft?: string;
  titleright?: string;
  label?: string;
}
const { titleleft, titleright, label } = Astro.props;

// The two column titles render as <p>, never <h2>: this is a UI widget, not
// article content, and the page's heading inventory is diffed against the docx
// on every rebrand. The accessible name for the region lives on aria-label.
const sectionLabel = label ?? titleleft ?? titleright ?? "ข้อมูลประกอบ";
---

<section aria-label={sectionLabel} class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:gap-8">
    <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#f7e2c4]">
      {
        titleleft && (
          <p class="flex items-center gap-3 border-b border-[#ffd233]/30 pb-3 text-xl leading-normal font-black tracking-widest text-[#ffe98a] uppercase">
            <span
              aria-hidden="true"
              class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-[#ffd233]/40 bg-gradient-to-br from-[#ffe98a] via-[#ffd233] to-[#8d630b] text-sm text-[#2a0704] shadow-[0_5px_15px_rgba(255,210,51,0.32)]">
              🔐
            </span>
            {titleleft}
          </p>
        )
      }
      <slot name="left" />
    </article>

    <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#f7e2c4]">
      {
        titleright && (
          <p class="flex items-center gap-3 border-b border-[#e8241a]/35 pb-3 text-xl leading-normal font-black tracking-widest text-[#ffd233] uppercase">
            <span
              aria-hidden="true"
              class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-[#ffd233]/40 bg-gradient-to-br from-[#e8241a] via-[#a5140b] to-[#6b0603] text-sm text-[#fff3cf] shadow-[0_5px_15px_rgba(232,36,26,0.35)]">
              🎰
            </span>
            {titleright}
          </p>
        )
      }
      <slot name="right" />
    </article>
  </div>
</section>
