---
export interface Props {
  titleleft?: string;
  titleright?: string;
  label?: string;
  iconleft?: string;
  iconright?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6" | "p";
}
const { titleleft, titleright, label, iconleft = "🔐", iconright = "🎯", as: TitleTag = "p" } = Astro.props;

const sectionLabel = label ?? titleleft ?? titleright ?? "ข้อมูลประกอบ";

// `as` defaults to "p" because this box is reused as a widget shell
// (LoginRtpSection), and chrome may not take a heading tag — the region's
// accessible name comes from the section's aria-label instead. A page that
// feeds it a real docx section heading passes as="h2" and gets a proper <h2>
// with identical classes. `as` applies to BOTH columns, so a page using this for
// a docx section passes only the one title the brief has a heading for.
//
// PATTAYA168: the left tile takes the bright end of the ramp (pale seafoam ->
// cyan) and the right tile the gold accent, which is the artwork's own pairing.
// Both glyphs are the deep ocean ink because both fills are the light ends —
// pale seafoam on the cyan, or gold on the gold, would drop under 3:1.
---

<section aria-label={sectionLabel} class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:gap-8">
    <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#cfeef7]">
      {
        titleleft && (
          <div class="flex items-center gap-3 border-b border-[#0c8ba4]/60 pb-3">
            <span
              aria-hidden="true"
              class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-[#8ff5ff]/50 bg-gradient-to-br from-[#8ff5ff] to-[#02c4e3] text-sm text-[#021c22] shadow-[0_5px_15px_rgba(2,196,227,0.32)]">
              {iconleft}
            </span>
            <TitleTag class="text-xl leading-normal font-black tracking-widest text-[#8ff5ff] uppercase">{titleleft}</TitleTag>
          </div>
        )
      }
      <slot name="left" />
    </article>

    <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#cfeef7]">
      {
        titleright && (
          <div class="flex items-center gap-3 border-b border-[#0c8ba4]/60 pb-3">
            <span
              aria-hidden="true"
              class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-[#fdac13]/55 bg-gradient-to-br from-[#fdac13] to-[#f0820c] text-sm text-[#021c22] shadow-[0_5px_15px_rgba(253,172,19,0.38)]">
              {iconright}
            </span>
            <TitleTag class="text-xl leading-normal font-black tracking-widest text-[#8ff5ff] uppercase">{titleright}</TitleTag>
          </div>
        )
      }
      <slot name="right" />
    </article>
  </div>
</section>
