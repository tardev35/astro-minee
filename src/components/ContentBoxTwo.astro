---
export interface Props {
  titleleft?: string;
  titleright?: string;
  label?: string;
  iconleft?: string;
  iconright?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6" | "p";
}
const { titleleft, titleright, label, iconleft = "🔐", iconright = "🎯", as: TitleTag = "p" } = Astro.props;

const sectionLabel = label ?? titleleft ?? titleright ?? "ข้อมูลประกอบ";

// `as` defaults to "p" because this box is reused as a widget shell
// (LoginRtpSection), and chrome may not take a heading tag — the region's
// accessible name comes from the section's aria-label instead. A page that
// feeds it a real docx section heading passes as="h2" and gets a proper <h2>
// with identical classes. `as` applies to BOTH columns, so a page using this for
// a docx section passes only the one title the brief has a heading for.
//
// หวยพร้อม: the left tile takes the prize-gold end of the ramp with ink
// lettering and the right tile the neon-green end, which is the artwork's own
// pairing. The glyph colour is picked against the middle of each fill — a
// green-white glyph on the gold would drop under 3:1, and ink on the green
// likewise.
---

<section aria-label={sectionLabel} class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:gap-8">
    <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#d8efdc]">
      {
        titleleft && (
          <div class="flex items-center gap-3 border-b border-[#1e7a3a]/45 pb-3">
            <span
              aria-hidden="true"
              class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-[#ffe08a]/50 bg-gradient-to-br from-[#ffe08a] to-[#a9791a] text-sm text-[#04140a] shadow-[0_5px_15px_rgba(245,196,81,0.3)]">
              {iconleft}
            </span>
            <TitleTag class="text-xl leading-normal font-black tracking-widest text-[#f5c451] uppercase">{titleleft}</TitleTag>
          </div>
        )
      }
      <slot name="left" />
    </article>

    <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#d8efdc]">
      {
        titleright && (
          <div class="flex items-center gap-3 border-b border-[#1e7a3a]/45 pb-3">
            <span
              aria-hidden="true"
              class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-[#6ee7a0]/50 bg-gradient-to-br from-[#22c55e] to-[#1e7a3a] text-sm text-[#04140a] shadow-[0_5px_15px_rgba(34,197,94,0.35)]">
              {iconright}
            </span>
            <TitleTag class="text-xl leading-normal font-black tracking-widest text-[#f5c451] uppercase">{titleright}</TitleTag>
          </div>
        )
      }
      <slot name="right" />
    </article>
  </div>
</section>
