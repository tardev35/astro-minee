---
export interface Props {
  titleleft?: string;
  titleright?: string;
  label?: string;
}
const { titleleft, titleright, label } = Astro.props;

// The two column titles render as <p>, never <h2>: this is a UI widget, not
// article content, and the page's heading inventory is diffed against the docx
// on every rebrand. The accessible name for the region lives on aria-label.
const sectionLabel = label ?? titleleft ?? titleright ?? "ข้อมูลประกอบ";
---

<section aria-label={sectionLabel} class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:gap-8">
    <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#fdf0d8]">
      {
        titleleft && (
          <p class="flex items-center gap-3 border-b border-[#fdbb24]/30 pb-3 text-xl leading-normal font-black tracking-widest text-[#ffe3a3] uppercase">
            <span
              aria-hidden="true"
              class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-[#fdbb24]/40 bg-gradient-to-br from-[#ffe3a3] via-[#fdbb24] to-[#b35303] text-sm text-[#3d1304] shadow-[0_5px_15px_rgba(253,187,36,0.32)]">
              🔐
            </span>
            {titleleft}
          </p>
        )
      }
      <slot name="left" />
    </article>

    <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#fdf0d8]">
      {
        titleright && (
          <p class="flex items-center gap-3 border-b border-[#7a3a02]/60 pb-3 text-xl leading-normal font-black tracking-widest text-[#fdbb24] uppercase">
            <span
              aria-hidden="true"
              class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-[#fdbb24]/40 bg-gradient-to-br from-[#eb9413] via-[#b35303] to-[#7a3a02] text-sm text-[#ffe3a3] shadow-[0_5px_15px_rgba(179,83,3,0.4)]">
              🎰
            </span>
            {titleright}
          </p>
        )
      }
      <slot name="right" />
    </article>
  </div>
</section>
