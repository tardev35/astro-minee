---
export interface Props {
  titleleft?: string;
  titleright?: string;
  label?: string;
  iconleft?: string;
  iconright?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6" | "p";
}
const { titleleft, titleright, label, iconleft = "🔐", iconright = "🎯", as: TitleTag = "p" } = Astro.props;

const sectionLabel = label ?? titleleft ?? titleright ?? "ข้อมูลประกอบ";

// `as` defaults to "p" because this box is reused as a widget shell
// (LoginRtpSection), and chrome may not take a heading tag — the region's
// accessible name comes from the section's aria-label instead. A page that
// feeds it a real docx section heading passes as="h2" and gets a proper <h2>
// with identical classes. `as` applies to BOTH columns, so a page using this for
// a docx section passes only the one title the brief has a heading for.
//
// RUAYRUAY888: the left tile takes the bright end of the ramp with ink
// lettering and the right tile the deep end with pink-white lettering, which is
// the artwork's own pairing. The glyph colour is picked against the middle of
// each fill — a pink-white glyph on the light pink would drop under 3:1, and ink
// on the deep pink likewise.
---

<section aria-label={sectionLabel} class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:gap-8">
    <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#f6dde8]">
      {
        titleleft && (
          <div class="flex items-center gap-3 border-b border-[#8f1140]/55 pb-3">
            <span
              aria-hidden="true"
              class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-[#fdb4d4]/50 bg-gradient-to-br from-[#ffffff] to-[#f874a1] text-sm text-[#0c0a0a] shadow-[0_5px_15px_rgba(248,116,161,0.32)]">
              {iconleft}
            </span>
            <TitleTag class="text-xl leading-normal font-black tracking-widest text-[#fdb4d4] uppercase">{titleleft}</TitleTag>
          </div>
        )
      }
      <slot name="left" />
    </article>

    <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#f6dde8]">
      {
        titleright && (
          <div class="flex items-center gap-3 border-b border-[#8f1140]/55 pb-3">
            <span
              aria-hidden="true"
              class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-[#f874a1]/50 bg-gradient-to-br from-[#d6377a] to-[#8f1140] text-sm text-[#fdb4d4] shadow-[0_5px_15px_rgba(143,17,64,0.45)]">
              {iconright}
            </span>
            <TitleTag class="text-xl leading-normal font-black tracking-widest text-[#fdb4d4] uppercase">{titleright}</TitleTag>
          </div>
        )
      }
      <slot name="right" />
    </article>
  </div>
</section>
