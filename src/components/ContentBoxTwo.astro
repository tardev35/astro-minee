---
export interface Props {
  titleleft?: string;
  titleright?: string;
  label?: string;
}
const { titleleft, titleright, label } = Astro.props;

// The two column titles render as <p>, never <h2>: this is a UI widget, not
// article content, and the page's heading inventory is diffed against the docx
// on every rebrand. The accessible name for the region lives on aria-label.
const sectionLabel = label ?? titleleft ?? titleright ?? "ข้อมูลประกอบ";
---

<section aria-label={sectionLabel} class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:gap-8">
    <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#f2e2e4]">
      {
        titleleft && (
          <p class="flex items-center gap-3 border-b border-[#e2131d]/30 pb-3 text-xl leading-normal font-black tracking-widest text-[#ff5a5f] uppercase">
            <span
              aria-hidden="true"
              class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-[#f5c542]/40 bg-gradient-to-br from-[#ffe08a] via-[#f5c542] to-[#a80f16] text-sm text-[#2a0206] shadow-[0_5px_15px_rgba(245,197,66,0.32)]">
              🔐
            </span>
            {titleleft}
          </p>
        )
      }
      <slot name="left" />
    </article>

    <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#f2e2e4]">
      {
        titleright && (
          <p class="flex items-center gap-3 border-b border-[#5c070b]/70 pb-3 text-xl leading-normal font-black tracking-widest text-[#f5c542] uppercase">
            <span
              aria-hidden="true"
              class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-[#e2131d]/40 bg-gradient-to-br from-[#ff5a5f] via-[#e2131d] to-[#5c070b] text-sm text-[#fff5f5] shadow-[0_5px_15px_rgba(226,19,29,0.4)]">
              🎰
            </span>
            {titleright}
          </p>
        )
      }
      <slot name="right" />
    </article>
  </div>
</section>
