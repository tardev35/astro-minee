---
export interface Props {
  titleleft?: string;
  titleright?: string;
  label?: string;
  iconleft?: string;
  iconright?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6" | "p";
}
const { titleleft, titleright, label, iconleft = "🔐", iconright = "🎰", as: TitleTag = "p" } = Astro.props;

const sectionLabel = label ?? titleleft ?? titleright ?? "ข้อมูลประกอบ";

// `as` defaults to "p" because this box is reused as a widget shell
// (LoginRtpSection), and chrome may not take a heading tag — the region's
// accessible name comes from the section's aria-label instead. A page that
// feeds it a real docx section heading passes as="h2" and gets a proper <h2>
// with identical classes.
//
// CHICKYLUCKY: the left tile carries the brand crimson, the right tile the
// chick-yellow, and both put near-black maroon ink on their bright fill. Both
// gradients stay in the bright half of their ramp on purpose — a fill that
// fades to a deep shade would leave #1c0100 ink unreadable at the bottom.
---

<section aria-label={sectionLabel} class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:gap-8">
    <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#fdf3d8]">
      {
        titleleft && (
          <div class="flex items-center gap-3 border-b border-[#e01b24]/30 pb-3">
            <span
              aria-hidden="true"
              class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-[#ff5252]/45 bg-gradient-to-br from-[#ff8a8a] via-[#ff5252] to-[#e01b24] text-sm text-[#1c0100] shadow-[0_5px_15px_rgba(224,27,36,0.35)]">
              {iconleft}
            </span>
            <TitleTag class="text-xl leading-normal font-black tracking-widest text-[#fde41a] uppercase">{titleleft}</TitleTag>
          </div>
        )
      }
      <slot name="left" />
    </article>

    <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#fdf3d8]">
      {
        titleright && (
          <div class="flex items-center gap-3 border-b border-[#e01b24]/30 pb-3">
            <span
              aria-hidden="true"
              class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-[#fde41a]/60 bg-gradient-to-br from-[#fff17a] via-[#fde41a] to-[#f0b429] text-sm text-[#1c0100] shadow-[0_5px_15px_rgba(253,228,26,0.35)]">
              {iconright}
            </span>
            <TitleTag class="text-xl leading-normal font-black tracking-widest text-[#fde41a] uppercase">{titleright}</TitleTag>
          </div>
        )
      }
      <slot name="right" />
    </article>
  </div>
</section>
