---
export interface Props {
  titleleft?: string;
  titleright?: string;
  label?: string;
}
const { titleleft, titleright, label } = Astro.props;

// The two column titles render as <p>, never <h2>: this is a UI widget, not
// article content, and the page's heading inventory is diffed against the docx
// on every rebrand. The accessible name for the region lives on aria-label.
const sectionLabel = label ?? titleleft ?? titleright ?? "ข้อมูลประกอบ";
---

<section aria-label={sectionLabel} class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:gap-8">
    <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#dbe6ff]">
      {
        titleleft && (
          <p class="flex items-center gap-3 border-b border-[#f5c518]/30 pb-3 text-xl leading-normal font-black tracking-widest text-[#ffe9a8] uppercase">
            <span
              aria-hidden="true"
              class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-[#f5c518]/40 bg-gradient-to-br from-[#ffe9a8] via-[#f5c518] to-[#b8770a] text-sm text-[#08122e] shadow-[0_5px_15px_rgba(245,197,24,0.32)]">
              🔐
            </span>
            {titleleft}
          </p>
        )
      }
      <slot name="left" />
    </article>

    <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#dbe6ff]">
      {
        titleright && (
          <p class="flex items-center gap-3 border-b border-[#1a5cf5]/60 pb-3 text-xl leading-normal font-black tracking-widest text-[#f5c518] uppercase">
            <span
              aria-hidden="true"
              class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-[#5b9dff]/40 bg-gradient-to-br from-[#5b9dff] via-[#1a5cf5] to-[#0b2f8f] text-sm text-[#ffe9a8] shadow-[0_5px_15px_rgba(26,92,245,0.4)]">
              🎰
            </span>
            {titleright}
          </p>
        )
      }
      <slot name="right" />
    </article>
  </div>
</section>
