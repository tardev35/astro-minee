---
export interface Props {
  titleleft?: string;
  titleright?: string;
  label?: string;
  iconleft?: string;
  iconright?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6" | "p";
}
const { titleleft, titleright, label, iconleft = "🔐", iconright = "🎴", as: TitleTag = "p" } = Astro.props;

const sectionLabel = label ?? titleleft ?? titleright ?? "ข้อมูลประกอบ";

// `as` defaults to "p" because this box is reused as a widget shell
// (LoginRtpSection), and chrome may not take a heading tag — the region's
// accessible name comes from the section's aria-label instead. A page that
// feeds it a real docx section heading passes as="h2" and gets a proper <h2>
// with identical classes.
//
// VEGUS1: both tiles carry the gold ramp with near-black maroon ink, and the
// rules under each title run crimson. Both gradients stay in the bright half of
// their ramp on purpose — a fill that fades to a deep shade would leave #2a0606
// ink unreadable at the bottom.
---

<section aria-label={sectionLabel} class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:gap-8">
    <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#f7e3c8]">
      {
        titleleft && (
          <div class="flex items-center gap-3 border-b border-[#d81f26]/30 pb-3">
            <span
              aria-hidden="true"
              class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-[#ffe08a]/45 bg-gradient-to-br from-[#ffe08a] via-[#f5c451] to-[#c9931a] text-sm text-[#2a0606] shadow-[0_5px_15px_rgba(245,196,81,0.35)]">
              {iconleft}
            </span>
            <TitleTag class="text-xl leading-normal font-black tracking-widest text-[#f5c451] uppercase">{titleleft}</TitleTag>
          </div>
        )
      }
      <slot name="left" />
    </article>

    <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#f7e3c8]">
      {
        titleright && (
          <div class="flex items-center gap-3 border-b border-[#d81f26]/30 pb-3">
            <span
              aria-hidden="true"
              class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-[#f5c451]/60 bg-gradient-to-br from-[#ffe08a] via-[#f5c451] to-[#c9931a] text-sm text-[#2a0606] shadow-[0_5px_15px_rgba(245,196,81,0.35)]">
              {iconright}
            </span>
            <TitleTag class="text-xl leading-normal font-black tracking-widest text-[#f5c451] uppercase">{titleright}</TitleTag>
          </div>
        )
      }
      <slot name="right" />
    </article>
  </div>
</section>
