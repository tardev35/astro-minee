---
export interface Props {
  titleleft?: string;
  titleright?: string;
  label?: string;
  iconleft?: string;
  iconright?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6" | "p";
}
const { titleleft, titleright, label, iconleft = "🔐", iconright = "🎰", as: TitleTag = "p" } = Astro.props;

const sectionLabel = label ?? titleleft ?? titleright ?? "ข้อมูลประกอบ";

// `as` defaults to "p" because this box is reused as a widget shell
// (LoginRtpSection), and chrome may not take a heading tag — the region's
// accessible name comes from the section's aria-label instead. A page that
// feeds it a real docx section heading passes as="h2" and gets a proper <h2>
// with identical classes. `as` applies to BOTH columns, so a page using this for
// a docx section passes only the one title the brief has a heading for.
//
// PRODED888: the left tile takes the gold end of the ramp with ink lettering and
// the right tile the navy end with ivory lettering, which is the crest's own
// pairing. The glyph colour is picked against the middle of each fill —
// an ivory glyph on the gold would drop under 3:1, and ink on the navy likewise.
---

<section aria-label={sectionLabel} class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:gap-8">
    <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#ece0c2]">
      {
        titleleft && (
          <div class="flex items-center gap-3 border-b border-[#e3b53f]/35 pb-3">
            <span
              aria-hidden="true"
              class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-[#f8de91]/50 bg-gradient-to-br from-[#f8de91] to-[#8f6614] text-sm text-[#070b20] shadow-[0_5px_15px_rgba(227,181,63,0.3)]">
              {iconleft}
            </span>
            <TitleTag class="text-xl leading-normal font-black tracking-widest text-[#f8de91] uppercase">{titleleft}</TitleTag>
          </div>
        )
      }
      <slot name="left" />
    </article>

    <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#ece0c2]">
      {
        titleright && (
          <div class="flex items-center gap-3 border-b border-[#e3b53f]/35 pb-3">
            <span
              aria-hidden="true"
              class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-[#2a3a8f]/70 bg-gradient-to-br from-[#2a3a8f] to-[#18225c] text-sm text-[#faf3de] shadow-[0_5px_15px_rgba(42,58,143,0.4)]">
              {iconright}
            </span>
            <TitleTag class="text-xl leading-normal font-black tracking-widest text-[#f8de91] uppercase">{titleright}</TitleTag>
          </div>
        )
      }
      <slot name="right" />
    </article>
  </div>
</section>
