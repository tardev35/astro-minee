---
// Sub-pages call <Announcement /> with no props, so this default IS the copy
// that ships on every page except the homepage — it has to be the current
// brand's, never left as whatever the previous brand wrote.
//
// No leading emoji in the string: the marquee renders `message` twice, so an
// emoji baked into the text is announced twice and cannot be marked
// aria-hidden. The decorative 👑 lives in its own span in the label below.
const {
  message = "TT1BET เป็นแพลตฟอร์มคาสิโนและสล็อตออนไลน์ที่รวบรวมเกมจากหลายค่ายไว้ในระบบเดียว เลือกเกม ตรวจโปรโมชั่น ดูโบนัส และติดตามสถานะธุรกรรมได้จากบัญชีเดียว รองรับทั้งมือถือและคอมพิวเตอร์ • แต่ละค่ายอาจมีฟีเจอร์ อัตราจ่าย และวงเงินต่างกัน การเปรียบเทียบข้อมูลก่อนเลือกช่วยให้หาเกมที่ตรงกับงบและสไตล์ของตนเองได้มากขึ้น • โบนัสที่ดูคุ้มไม่ควรพิจารณาเฉพาะจำนวนเครดิต ควรดูยอดฝากขั้นต่ำ เกมที่ร่วมรายการ ระยะเวลา และเงื่อนไขการถอนร่วมกัน • ก่อนกดยืนยันควรตรวจชื่อบัญชี จำนวนเงิน และสถานะรายการทุกครั้ง หากรายการเดิมยังดำเนินการอยู่ควรรอระบบอัปเดตก่อนทำรายการใหม่ • คำว่าฝากง่ายจ่ายไวไม่ใช่การรับประกันทุกธุรกรรม ระยะเวลาอาจขึ้นอยู่กับสถานะบัญชี ช่องทางธุรกรรม และขั้นตอนตรวจสอบของระบบ • ควรดู RTP ความผันผวน และตารางจ่ายของเกมประกอบกัน แล้วกำหนดวงเงินต่อรอบให้เหมาะกับงบก่อนเริ่มเล่น",
} = Astro.props;
---

<div class="mx-auto w-full max-w-7xl px-4 py-4 font-sans">
  <div
    class="relative flex overflow-hidden rounded-full border border-[#e9c341]/45 bg-[#171008]/92 shadow-[0_8px_20px_rgba(233,195,65,0.24)] backdrop-blur-lg transition-shadow duration-300 hover:shadow-[0_8px_25px_rgba(252,241,176,0.32)]">
    <div
      class="relative z-10 flex shrink-0 items-center justify-center rounded-full bg-gradient-to-r from-[#fcf1b0] via-[#e9c341] to-[#6d4a13] px-8 py-2.5 font-black text-[#0b0805] shadow-[4px_0_15px_rgba(233,195,65,0.3)]">
      <span aria-hidden="true" class="mr-2 text-lg">👑</span> ประกาศ
    </div>

    <div class="marquee-container relative flex-1 overflow-hidden py-2.5 pr-6">
      <div class="pointer-events-none absolute top-0 left-0 z-10 h-full w-12 bg-gradient-to-r from-[#171008] to-transparent"></div>

      <div class="marquee-content inline-block pl-4 text-sm font-medium tracking-wide whitespace-nowrap text-[#f2e7cd]">
        <span class="mr-10 inline-flex items-center gap-3"><span class="h-2 w-2 rounded-full bg-[#fcf1b0] shadow-[0_0_8px_rgba(252,241,176,0.75)]"></span>{message}</span>
        <span class="mr-10 inline-flex items-center gap-3"><span class="h-2 w-2 rounded-full bg-[#fcf1b0] shadow-[0_0_8px_rgba(252,241,176,0.75)]"></span>{message}</span>
      </div>
    </div>
  </div>
</div>

<style>
  .marquee-content {
    animation: marquee 25s linear infinite;
  }
  .marquee-container:hover .marquee-content {
    animation-play-state: paused;
  }
  @media (prefers-reduced-motion: reduce) {
    .marquee-content {
      animation: none;
    }
  }
  @keyframes marquee {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-50%);
    }
  }
</style>
