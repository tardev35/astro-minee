---
// Sub-pages call <Announcement /> with no props, so this default IS the copy
// that ships on every page except the homepage — it has to be the current
// brand's, never left as whatever the previous brand wrote.
const {
  message = "AMBKING1234 รวมเกมสล็อตยอดนิยมหลายรูปแบบไว้ในระบบเดียว เมนูเข้าใจง่าย เลือกเกมได้ตามความสนใจ • รองรับมือถือ แท็บเล็ต และคอมพิวเตอร์ ใช้งานผ่านเบราว์เซอร์ได้ทันที ควรใช้อินเทอร์เน็ตที่เสถียรและเข้าผ่านช่องทางหลักทุกครั้ง • ทีมงานดูแลสมาชิกตลอด 24 ชั่วโมง ควรศึกษากติกา รูปแบบการจ่าย และกำหนดงบประมาณก่อนเริ่มเล่น",
} = Astro.props;
---

<div class="mx-auto w-full max-w-7xl px-4 py-4 font-sans">
  <div
    class="relative flex overflow-hidden rounded-full border border-[#8fd318]/40 bg-[#06190d]/92 shadow-[0_8px_20px_rgba(143,211,24,0.18)] backdrop-blur-lg transition-shadow duration-300 hover:shadow-[0_8px_25px_rgba(143,211,24,0.30)]">
    <div
      class="relative z-10 flex shrink-0 items-center justify-center rounded-full bg-gradient-to-r from-[#e4f223] via-[#8fd318] to-[#1c7a2f] px-8 py-2.5 font-black text-[#04140a] shadow-[4px_0_15px_rgba(143,211,24,0.25)]">
      <span aria-hidden="true" class="mr-2 text-lg">💎</span> ประกาศ
    </div>

    <div class="marquee-container relative flex-1 overflow-hidden py-2.5 pr-6">
      <div class="pointer-events-none absolute top-0 left-0 z-10 h-full w-12 bg-gradient-to-r from-[#06190d] to-transparent"></div>

      <div class="marquee-content inline-block pl-4 text-sm font-medium tracking-wide whitespace-nowrap text-[#e6f3dd]">
        <span class="mr-10 inline-flex items-center gap-3"><span class="h-2 w-2 rounded-full bg-[#fbd503] shadow-[0_0_8px_rgba(251,213,3,0.6)]"></span>{message}</span>
        <span class="mr-10 inline-flex items-center gap-3"><span class="h-2 w-2 rounded-full bg-[#fbd503] shadow-[0_0_8px_rgba(251,213,3,0.6)]"></span>{message}</span>
      </div>
    </div>
  </div>
</div>

<style>
  .marquee-content {
    animation: marquee 25s linear infinite;
  }
  .marquee-container:hover .marquee-content {
    animation-play-state: paused;
  }
  @media (prefers-reduced-motion: reduce) {
    .marquee-content {
      animation: none;
    }
  }
  @keyframes marquee {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-50%);
    }
  }
</style>
