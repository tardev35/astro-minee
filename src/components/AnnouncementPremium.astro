---
// Sub-pages call <Announcement /> with no props, so this default IS the copy
// that ships on every page except the homepage — it has to be the current
// brand's, never left as whatever the previous brand wrote.
const {
  message = "WIN666 คาสิโนออนไลน์ระบบใหม่ รวมเกมสล็อต บาคาร่า และเกมไพ่ไว้ในระบบเดียว • ฝากถอนผ่านระบบออโต้จากหน้าบัญชีได้ด้วยตนเอง ควรตรวจสอบยอดเงินและข้อมูลบัญชีก่อนยืนยันทุกครั้ง • รองรับมือถือ แท็บเล็ต และคอมพิวเตอร์ ใช้งานผ่านเบราว์เซอร์ได้ทันที • ทีมงานดูแลสมาชิกตลอด 24 ชั่วโมง ควรศึกษากติกาและเงื่อนไขของแต่ละเกมก่อนเริ่มใช้งาน",
} = Astro.props;
---

<div class="mx-auto w-full max-w-7xl px-4 py-4 font-sans">
  <div
    class="relative flex overflow-hidden rounded-full border border-[#f6931e]/35 bg-[#161009]/92 shadow-[0_8px_20px_rgba(246,147,30,0.18)] backdrop-blur-lg transition-shadow duration-300 hover:shadow-[0_8px_25px_rgba(246,147,30,0.30)]">
    <div
      class="relative z-10 flex shrink-0 items-center justify-center rounded-full bg-gradient-to-r from-[#ffb35c] via-[#f6931e] to-[#8f4b06] px-8 py-2.5 font-black text-[#180d02] shadow-[4px_0_15px_rgba(246,147,30,0.25)]">
      <span aria-hidden="true" class="mr-2 text-lg">💎</span> ประกาศ
    </div>

    <div class="marquee-container relative flex-1 overflow-hidden py-2.5 pr-6">
      <div class="pointer-events-none absolute top-0 left-0 z-10 h-full w-12 bg-gradient-to-r from-[#161009] to-transparent"></div>

      <div class="marquee-content inline-block pl-4 text-sm font-medium tracking-wide whitespace-nowrap text-[#f2dfc4]">
        <span class="mr-10 inline-flex items-center gap-3"><span class="h-2 w-2 rounded-full bg-[#f6931e] shadow-[0_0_8px_rgba(246,147,30,0.6)]"></span>{message}</span>
        <span class="mr-10 inline-flex items-center gap-3"><span class="h-2 w-2 rounded-full bg-[#f6931e] shadow-[0_0_8px_rgba(246,147,30,0.6)]"></span>{message}</span>
      </div>
    </div>
  </div>
</div>

<style>
  .marquee-content {
    animation: marquee 25s linear infinite;
  }
  .marquee-container:hover .marquee-content {
    animation-play-state: paused;
  }
  @media (prefers-reduced-motion: reduce) {
    .marquee-content {
      animation: none;
    }
  }
  @keyframes marquee {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-50%);
    }
  }
</style>
