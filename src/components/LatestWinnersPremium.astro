---
import kbankLogo from "../assets/banks/kbank.png";
import scbLogo from "../assets/banks/scb.png";
import krungsriLogo from "../assets/banks/krungsri.png";
import ktbLogo from "../assets/banks/ktb.png";
import { brandPick } from "../lib/brandProfile";

// Bank swatches are the real corporate colours of each bank and are NOT part of
// the brand palette — they stay as they are through every rebrand.
const bankPool = [
  { name: "KBank", color: "bg-[#1155cc]", icon: kbankLogo.src },
  { name: "SCB", color: "bg-[#4e1c80]", icon: scbLogo.src },
  { name: "Krungsri", color: "bg-[#fcd34d]", icon: krungsriLogo.src },
  { name: "KTB", color: "bg-[#0ea5e9]", icon: ktbLogo.src },
];

// Seeded from brandPick, never Math.random()/Date.now(): frontmatter runs at
// build time, so a random call here would make two builds of the same domain
// differ. The rows are server-rendered and src/lib/winnersFeed.ts only takes
// over the rotation from the data-* hooks below.
const BIG_WIN = 40000;
const pick = (salt: string, n: number) => brandPick(Astro.site, salt, n);
const digits = (salt: string, n: number) => Array.from({ length: n }, (_, d) => pick(`${salt}-${d}`, 10)).join("");

const initialRows = Array.from({ length: 5 }, (_, i) => {
  const amount = 100 + pick(`feed-amount-${i}`, 48901);
  return {
    bank: bankPool[pick(`feed-bank-${i}`, bankPool.length)],
    user: `0${pick(`feed-p-${i}`, 2) === 0 ? "8" : "9"}***${digits(`feed-u${i}`, 4)}`,
    amount,
    big: amount > BIG_WIN,
    // Same 35% the client rotation uses, decided from the domain instead of a
    // coin flip so the shipped HTML is stable build to build.
    pending: pick(`feed-pending-${i}`, 100) < 35,
  };
});

const seedTotal = initialRows.reduce((sum, row) => sum + row.amount, 0);

const ROW_NORMAL = "border-[#e3b53f]/25";
const ROW_BIG = "border-[#f8de91]/70 shadow-[0_0_15px_rgba(227,181,63,0.3)]";

// Wording for the two states of a withdrawal on this brand. The rotation module
// reads these off the markup — it never learns the palette or the copy.
const STATUS_PENDING = "text-[#f8de91] font-bold";
const STATUS_DONE = "text-green-400 font-bold";
const TEXT_PENDING = "อยู่ระหว่างดำเนินการ";
const TEXT_DONE = "โอนเข้าบัญชีแล้ว";
---

<div class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  <section
    aria-label="รายการถอนเงินล่าสุดของสมาชิก PRODED888"
    class="relative overflow-hidden rounded-3xl border border-[#e3b53f]/40 bg-[#0d1338]/92 shadow-[0_10px_40px_rgba(7,11,32,0.85)] backdrop-blur-xl">
    <div class="relative z-10 flex flex-col gap-4 border-b border-[#e3b53f]/30 px-5 py-5 sm:flex-row sm:items-center sm:justify-between md:px-8">
      <div class="flex items-center gap-3">
        <span aria-hidden="true" class="flex h-10 w-10 items-center justify-center rounded-full border border-[#f8de91]/45 bg-[#18225c] text-2xl text-[#e3b53f]">🏆</span>
        <div class="flex flex-col">
          <p class="text-2xl font-black tracking-widest text-[#ece0c2] drop-shadow-sm">
            รายการถอนเงินล่าสุด <span class="text-[#f8de91]">PRODED888</span>
          </p>
          <span class="text-[11px] font-medium tracking-wide text-[#dbe3f5]">อัปเดตอัตโนมัติจากระบบบัญชี ผ่าน True Wallet และ Mobile Banking</span>
        </div>
      </div>
      <div class="flex items-center gap-2 self-start rounded-full border border-green-500/40 bg-green-900/20 px-3 py-1.5 sm:self-auto">
        <span class="h-1.5 w-1.5 animate-pulse rounded-full bg-green-400 shadow-[0_0_8px_rgba(74,222,128,0.8)]"></span>
        <span class="text-[10px] font-bold tracking-widest text-green-400 uppercase">Live</span>
      </div>
    </div>

    <div class="relative z-10 grid grid-cols-2 gap-px overflow-hidden border-b border-[#e3b53f]/25 bg-[#e3b53f]/40 sm:grid-cols-3">
      <div class="flex flex-col items-center gap-1 bg-[#0d1338] px-4 py-4">
        <span class="text-[11px] font-medium tracking-wide text-[#dbe3f5]">ยอดถอนรวมวันนี้</span>
        <span data-winners-total data-prefix="฿" data-seed={seedTotal} class="bg-gradient-to-r from-[#f8de91] to-[#e3b53f] bg-clip-text font-mono text-lg font-black text-transparent sm:text-xl">
          ฿{seedTotal.toLocaleString("en-US")}
        </span>
      </div>
      <div class="flex flex-col items-center gap-1 bg-[#0d1338] px-4 py-4">
        <span class="text-[11px] font-medium tracking-wide text-[#dbe3f5]">รายการสำเร็จวันนี้</span>
        <span data-winners-count data-seed={initialRows.length} class="font-mono text-lg font-black text-[#ece0c2] sm:text-xl">{initialRows.length}</span>
      </div>
      <div class="col-span-2 flex flex-col items-center gap-1 bg-[#0d1338] px-4 py-4 sm:col-span-1">
        <span class="text-[11px] font-medium tracking-wide text-[#dbe3f5]">ถอนได้ต่อรายการ</span>
        <span class="font-mono text-lg font-black text-[#ece0c2] sm:text-xl">฿100–49,000</span>
      </div>
    </div>

    <div class="relative z-10 hidden grid-cols-[2fr_1.3fr_1fr_0.8fr] gap-4 px-8 pt-4 text-[11px] font-bold tracking-widest text-[#dbe3f5] uppercase sm:grid">
      <span>ผู้ใช้งาน</span>
      <span>สถานะ</span>
      <span class="text-right">จำนวนเงิน</span>
      <span class="text-right">เวลา</span>
    </div>

    <div
      data-winners-feed
      data-interval="3500"
      data-max-rows="5"
      data-amount-min="100"
      data-amount-max="49000"
      data-pending-chance="0.35"
      data-user-style="phone"
      data-big-win-above={BIG_WIN}
      class="relative z-10 flex h-[380px] flex-col gap-2 overflow-hidden px-4 py-4 md:px-8">
      {
        initialRows.map((row) => (
          <div data-winner-row class="winner-row origin-top transition-all duration-500 ease-out">
            <div
              data-winner-big
              data-normal-class={ROW_NORMAL}
              data-big-class={ROW_BIG}
              class={`grid grid-cols-[auto_1fr] items-center gap-4 rounded-xl border bg-[#070b20]/90 p-3.5 shadow-sm transition-colors duration-300 hover:border-[#f8de91]/60 hover:bg-[#18225c] sm:grid-cols-[2fr_1.3fr_1fr_0.8fr] ${row.big ? ROW_BIG : ROW_NORMAL}`}>
              <div class="col-span-2 flex items-center gap-3 sm:col-span-1">
                <div data-winner-bank class={`flex h-9 w-9 shrink-0 items-center justify-center rounded-full border border-white/10 shadow-inner ${row.bank.color}`}>
                  <img data-winner-icon src={row.bank.icon} alt="" width="20" height="20" loading="lazy" decoding="async" class="h-5 w-5 object-contain grayscale" />
                </div>
                <span data-winner-user class="font-mono text-sm font-bold text-[#ece0c2]">
                  {row.user}
                </span>
              </div>
              <div class="flex items-center gap-1.5 text-[11px] tracking-wide sm:text-xs">
                <span data-winner-big data-normal-text="✓" data-big-text="🔥" aria-hidden="true" class="shrink-0">
                  {row.big ? "🔥" : "✓"}
                </span>
                <span
                  data-winner-status
                  data-pending-text={TEXT_PENDING}
                  data-done-text={TEXT_DONE}
                  data-pending-class={STATUS_PENDING}
                  data-done-class={STATUS_DONE}
                  class={row.pending ? STATUS_PENDING : STATUS_DONE}>
                  {row.pending ? TEXT_PENDING : TEXT_DONE}
                </span>
              </div>
              <div class="bg-gradient-to-r from-[#f8de91] to-[#e3b53f] bg-clip-text text-right font-mono text-base font-black text-transparent sm:text-lg">
                ฿<span data-winner-amount>{row.amount.toLocaleString("en-US")}</span>
              </div>
              <div class="text-right text-[11px] font-medium text-[#dbe3f5] sm:text-xs">เมื่อสักครู่</div>
            </div>
          </div>
        ))
      }
    </div>

    <script type="application/json" data-winners-banks set:html={JSON.stringify(bankPool)} />
  </section>
</div>

<script>
  import { startWinnersFeed } from "../lib/winnersFeed";

  startWinnersFeed();
</script>

<style>
  .font-mono {
    font-family: var(--font-sans);
  }

  .winner-row.is-entering {
    transform: translateY(-0.75rem);
    opacity: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .winner-row {
      transition: none;
    }
  }
</style>
