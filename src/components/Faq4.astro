---
export interface FaqItem {
  q: string;
  a: string;
}

export interface Props {
  title?: string;
  faqs?: FaqItem[];
}

const { title, faqs = [] } = Astro.props;

// The title is the only heading here and it is prop-driven, i.e. it comes from
// the page's own FAQ section. Each question stays a <span> inside <summary> so
// the page's heading inventory keeps matching the flat H1 + H2 docx.
//
// <details>/<summary> stays: it opens with no JavaScript, it is in the HTML for
// a crawler whether or not it is open, and `name="faq-terminal"` gives the group
// accordion behaviour natively.
//
// DIAMOND789: hot pink carries every surface and rule, the bright pink is the
// hover/prompt tone, and the answers sit on the soft pink-white body colour.
---

<div class="mx-auto max-w-[1000px] px-4 py-10 font-sans">
  {
    title && (
      <div
        class="mb-8 flex items-center gap-3 border-l-4 border-[#f30d8c] bg-gradient-to-r from-[#2a1122] via-[#2a1122]/60 to-transparent px-4 py-2.5"
        style="clip-path: polygon(0 0, 100% 0, calc(100% - 15px) 100%, 0 100%);">
        <h2 class="text-xl leading-normal font-black tracking-widest text-[#ff5cb8] uppercase md:text-2xl">{title}</h2>
      </div>
    )
  }

  <div class="space-y-4">
    {
      faqs.map((faq) => (
        <details
          name="faq-terminal"
          class="faq-item group relative overflow-hidden border border-[#f30d8c]/25 bg-[#150810]/92 backdrop-blur-sm transition-all duration-300 hover:border-[#f30d8c]/50 hover:shadow-[0_15px_40px_rgba(243,13,140,0.3)]"
          style="clip-path: polygon(15px 0, 100% 0, 100% calc(100% - 15px), calc(100% - 15px) 100%, 0 100%, 0 15px);">
          <div aria-hidden="true" class="absolute top-0 left-0 h-[2px] w-16 bg-gradient-to-r from-[#e8e8ef] to-transparent" />

          <summary class="flex w-full cursor-pointer items-center justify-between p-5 text-left transition-all">
            <span class="flex items-center gap-2 text-base font-bold text-[#f8e3f0] transition-colors group-hover:text-[#ff5cb8] md:text-lg">
              <span aria-hidden="true" class="font-mono text-[#ff8ccc]">
                &gt;_
              </span>
              {faq.q}
            </span>

            <span
              aria-hidden="true"
              class="faq-icon ml-4 flex h-8 w-8 shrink-0 items-center justify-center border border-[#f30d8c]/30 bg-[#2a1122] text-lg font-black text-[#f30d8c] transition-all duration-300 group-hover:border-[#f30d8c]/50 group-hover:text-[#ff8ccc]"
              style="clip-path: polygon(25% 0, 100% 0, 100% 75%, 75% 100%, 0 100%, 0 25%);">
              +
            </span>
          </summary>

          <div class="faq-answer border-t border-[#b312ac]/45 p-5 pt-4 text-left text-base leading-relaxed text-[#f8e3f0]">{faq.a}</div>
        </details>
      ))
    }
  </div>
</div>

<style>
  .faq-item > summary {
    list-style: none;
  }
  .faq-item > summary::-webkit-details-marker {
    display: none;
  }
  .faq-item[open] {
    border-color: rgba(243, 13, 140, 0.6);
    box-shadow: 0 15px 40px rgba(243, 13, 140, 0.3);
  }
  .faq-item[open] .faq-icon {
    transform: rotate(45deg);
    border-color: #f30d8c;
    color: #ff8ccc;
  }
  .faq-item[open] .faq-answer {
    animation: faq-reveal 0.25s ease-out;
  }

  @keyframes faq-reveal {
    from {
      opacity: 0;
      transform: translateY(-4px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .faq-item[open] .faq-answer {
      animation: none;
    }
  }
</style>
