---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  titleleft?: string;
  titlecenter?: string;
  titleright?: string;
}
const { title, as: HeadingTag = "h2", titleleft, titlecenter, titleright } = Astro.props;

// The three column labels render as <p>, not <h3>. One docx H2 section feeds
// this box, so exactly one heading belongs to it — the `title` above the grid.
// The column labels below split that one section into readable columns, which
// makes them chrome, and the HOT189 docx is flat H1 + H2 with no nested
// sub-headings for them to be. They keep their size/weight classes, so the
// visual result is identical.
//
// `title` + `as` were added for this reason: the file previously had no section
// heading at all and emitted three <h3>, which is both a heading the docx never
// wrote and a level it never uses.
//
// text-center sits on the <header> only — an ancestor carrying it would inherit
// straight into the column slots and centre the body paragraphs with it.
//
// HOT189 neumorphic pair: page ground (#0d0402) dark side, panel tone (#2e100a)
// lit side, matching the other three *Neumorphism boxes.
---

<section class="relative z-10 mx-auto mb-8 w-full max-w-7xl px-4 font-sans">
  <div
    class="w-full rounded-[25px] border border-[#ef2b09]/35 bg-[#1c0705] p-8 shadow-[10px_10px_20px_#0d0402,-10px_-10px_20px_#2e100a] transition-all duration-300 hover:shadow-[15px_15px_30px_#000000,-15px_-15px_30px_#8f1505]">
    {
      title && (
        <header class="mb-8 border-b border-[#ef2b09]/35 pb-4 text-center">
          <HeadingTag class="bg-gradient-to-r from-[#ffe86b] via-[#fcd304] to-[#c99400] bg-clip-text text-2xl leading-normal font-black tracking-wide text-transparent">{title}</HeadingTag>
        </header>
      )
    }

    <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
      <article class="flex flex-col gap-4 border-b border-[#ef2b09]/25 pb-6 text-left text-base leading-relaxed text-[#ffe9cf] md:border-r md:border-b-0 md:pr-6 md:pb-0">
        {titleleft && <p class="text-xl leading-normal font-bold text-[#fcd304]">{titleleft}</p>}
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-4 border-b border-[#ef2b09]/25 pb-6 text-left text-base leading-relaxed text-[#ffe9cf] md:border-r md:border-b-0 md:px-4 md:pb-0">
        {titlecenter && <p class="text-xl leading-normal font-bold text-[#fcd304]">{titlecenter}</p>}
        <slot name="center" />
      </article>

      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#ffe9cf] md:pl-6">
        {titleright && <p class="text-xl leading-normal font-bold text-[#fcd304]">{titleright}</p>}
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
