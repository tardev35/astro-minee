---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  titleleft?: string;
  titlecenter?: string;
  titleright?: string;
}
const { title, as: HeadingTag = "h2", titleleft, titlecenter, titleright } = Astro.props;

// The three column labels render as <p>, not <h3>. One docx H2 section feeds
// this box, so exactly one heading belongs to it — the `title` above the grid.
// The column labels below split that one section into readable columns, which
// makes them chrome, and the หวยพร้อม docx is flat H1 + H2 with no nested
// sub-headings for them to be. They keep their size/weight classes, so the
// visual result is identical.
//
// `title` + `as` were added for this reason: the file previously had no section
// heading at all and emitted three <h3>, which is both a heading the docx never
// wrote and a level it never uses.
//
// text-center sits on the <header> only — an ancestor carrying it would inherit
// straight into the column slots and centre the body paragraphs with it.
//
// หวยพร้อม neumorphic pair: page ink (#04140a) dark side, lifted surface
// (#10361c) lit side, matching the other three *Neumorphism boxes. The column
// labels take the prize gold so the three bet types read as values, and the
// section heading runs the gold ramp above them.
---

<section class="relative z-10 mx-auto mb-8 w-full max-w-7xl px-4 font-sans">
  <div
    class="w-full rounded-[25px] border border-[#1e7a3a]/45 bg-[#0a2413] p-8 shadow-[10px_10px_20px_#04140a,-10px_-10px_20px_#10361c] transition-all duration-300 hover:shadow-[15px_15px_30px_#000000,-15px_-15px_30px_#1e7a3a]">
    {
      title && (
        <header class="mb-8 border-b border-[#1e7a3a]/45 pb-4 text-center">
          <HeadingTag class="bg-gradient-to-r from-[#ffe08a] via-[#f5c451] to-[#22c55e] bg-clip-text text-2xl leading-normal font-black tracking-wide text-transparent">{title}</HeadingTag>
        </header>
      )
    }

    <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
      <article class="flex flex-col gap-4 border-b border-[#1e7a3a]/30 pb-6 text-left text-base leading-relaxed text-[#d8efdc] md:border-r md:border-b-0 md:pr-6 md:pb-0">
        {titleleft && <p class="text-xl leading-normal font-bold text-[#f5c451]">{titleleft}</p>}
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-4 border-b border-[#1e7a3a]/30 pb-6 text-left text-base leading-relaxed text-[#d8efdc] md:border-r md:border-b-0 md:px-4 md:pb-0">
        {titlecenter && <p class="text-xl leading-normal font-bold text-[#f5c451]">{titlecenter}</p>}
        <slot name="center" />
      </article>

      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#d8efdc] md:pl-6">
        {titleright && <p class="text-xl leading-normal font-bold text-[#f5c451]">{titleright}</p>}
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
