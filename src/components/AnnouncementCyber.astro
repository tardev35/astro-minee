---
// The default is the CURRENT brand's copy on purpose: sub-pages call
// <Announcement /> bare, so whatever sits here is what every page but the
// homepage renders. Leaving a previous brand's slogan in this slot is the
// classic way half a site keeps advertising the last client. (This one still
// read BMK289 when RUAYRUAY888 picked the variant up.)
//
// No leading emoji — the marquee renders `message` twice, so a decorative glyph
// baked into the string is announced twice and cannot be marked aria-hidden.
const {
  message = "PATTAYA168 รวมเกมสล็อตจากผู้ให้บริการหลายรูปแบบไว้ในระบบเดียว รองรับ True Wallet ตามช่องทางที่กำหนด ทั้งบนมือถือและคอมพิวเตอร์ • ก่อนเลือกเล่นควรพิจารณาชื่อผู้ให้บริการ รายละเอียดเกม ตารางจ่าย และข้อมูลที่ระบบแสดง ไม่ควรตัดสินจากคำว่าลิขสิทธิ์แท้เพียงอย่างเดียว • ก่อนยืนยันฝากถอนควรตรวจข้อมูล Wallet จำนวนเงิน และชื่อบัญชีให้ตรงกัน หากรายการเดิมยังไม่อัปเดตสถานะควรรอผลจากระบบก่อนทำรายการใหม่ • โปรโมชั่นแต่ละรายการมีเงื่อนไขต่างกัน ควรตรวจยอดขั้นต่ำ เกมที่ร่วมรายการ และเงื่อนไขการถอนก่อนรับสิทธิ์ทุกครั้ง • คำว่าจ่ายไวไม่ใช่การรับประกันทุกกรณี ควรดู RTP ความผันผวน และกำหนดงบประมาณก่อนเริ่มเล่น",
} = Astro.props;
---

<div class="mx-auto w-full max-w-7xl px-4 py-3 font-sans">
  <div
    class="relative flex overflow-hidden border border-[#02c4e3]/50 bg-[#021c22]/90 shadow-[0_0_15px_rgba(2,196,227,0.3)] backdrop-blur-md"
    style="clip-path: polygon(15px 0, 100% 0, calc(100% - 15px) 100%, 0 100%);">
    <div
      class="relative z-10 flex shrink-0 items-center justify-center bg-gradient-to-r from-[#0c8ba4] to-[#02c4e3] px-6 py-2.5 font-black text-[#eafcff]"
      style="clip-path: polygon(0 0, 100% 0, calc(100% - 10px) 100%, 0 100%);">
      ประกาศ
    </div>

    <div class="marquee-container relative flex-1 overflow-hidden py-2.5 pr-6">
      <div class="pointer-events-none absolute top-0 left-0 z-10 h-full w-8 bg-gradient-to-r from-[#021c22] to-transparent"></div>

      <div class="marquee-content inline-block pl-4 text-sm font-bold tracking-widest whitespace-nowrap text-[#cfeef7]">
        <span class="mr-8 inline-flex items-center gap-2"><span aria-hidden="true" class="h-2 w-2 bg-[#8ff5ff] shadow-[0_0_8px_rgba(143,245,255,1)]"></span>{message}</span>
        <span class="mr-8 inline-flex items-center gap-2"><span aria-hidden="true" class="h-2 w-2 bg-[#8ff5ff] shadow-[0_0_8px_rgba(143,245,255,1)]"></span>{message}</span>
      </div>
    </div>
  </div>
</div>

<style>
  .marquee-content {
    animation: marquee 20s linear infinite;
  }
  .marquee-container:hover .marquee-content {
    animation-play-state: paused;
  }
  @keyframes marquee {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-50%);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .marquee-content {
      animation: none;
    }
  }
</style>
