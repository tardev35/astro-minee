---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;

// The Huay card, rendered by the two lottery pages (/ตรวจหวย, /แนวทาง). Its
// red/gold is the sanctioned lottery theme, tuned here to this brand's exact
// palette so the pages sit in the same family as the rest of the site.
//
// No slot wrapper and no `text-center` anywhere on the card or the section:
// both are inheritable, so centering an ancestor of the slot silently centers
// the body copy too. The heading owns its own alignment; paragraphs stay flush
// left. `isolate` on the card plus `-z-10` on the blurs keeps the decoration
// above the card background but below the text without a wrapper div.
---

<section class="relative z-10 my-8 flex w-full justify-center px-4 font-sans">
  <div
    class="group relative isolate w-full max-w-[1400px] overflow-hidden rounded-3xl border border-[#f5c451]/35 bg-[#2a0507]/95 p-8 text-left text-base leading-relaxed text-[#f3ded7] shadow-[0_10px_30px_rgba(245,196,81,0.14)] backdrop-blur-xl transition-all duration-500 hover:border-[#f5c451]/60 hover:shadow-[0_15px_40px_rgba(216,18,32,0.28)] md:p-10">
    <div aria-hidden="true" class="pointer-events-none absolute -top-20 -left-20 -z-10 h-40 w-40 rounded-full bg-[#f5c451]/22 blur-[50px] transition-all duration-500 group-hover:bg-[#ffe08a]/30"></div>
    <div aria-hidden="true" class="pointer-events-none absolute -right-20 -bottom-20 -z-10 h-40 w-40 rounded-full bg-[#7d0000]/60 blur-[50px] transition-all duration-500 group-hover:bg-[#d81220]/60"></div>

    {
      title && (
        <header class="mb-6 flex items-center gap-4 border-b border-[#f5c451]/30 pb-4">
          <div aria-hidden="true" class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#ffe08a] to-[#b8860b] shadow-[0_0_10px_rgba(245,196,81,0.45)]" />
          <HeadingTag class="bg-gradient-to-r from-[#ffe08a] via-[#f5c451] to-[#b8860b] bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase">{title}</HeadingTag>
        </header>
      )
    }
    <slot />
  </div>
</section>
