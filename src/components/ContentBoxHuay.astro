---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;

// The Huay card. Rendered by index.astro (the H1 hero block) and by /แนวทาง —
// two zones, which is why it is rethemed with the shared chrome rather than by
// either fan-out agent. /ตรวจหวย is parked in src/pages-disabled by the operator.
//
// This card used to carry a separate maroon "lottery page" theme, which exists
// so a CASINO brand does not push its own hue onto a lottery sub-page.
// JAIDEEJING IS the lottery brand — red and gold is its own identity — so that
// exemption does not apply and this card sits on the site palette like
// everything else. A gold site with one differently-themed page reads as broken.
//
// It stays distinguishable from ContentBox.astro by inverting which colour holds
// the edge: ContentBox rims itself in oxblood over a lifted maroon surface, this
// one rims itself in the prize gold over the deepest ink, and its heading runs
// the gradient the other way.
//
// No slot wrapper and no `text-center` anywhere on the card or the section:
// both are inheritable, so centering an ancestor of the slot silently centers
// the body copy too. The heading owns its own alignment; paragraphs stay flush
// left. `isolate` on the card plus `-z-10` on the blurs keeps the decoration
// above the card background but below the text without a wrapper div.
---

<section class="relative z-10 my-8 flex w-full justify-center px-4 font-sans">
  <div
    class="group relative isolate w-full max-w-[1400px] overflow-hidden rounded-3xl border border-[#f5c451]/40 bg-[#120403]/95 p-8 text-left text-base leading-relaxed text-[#f7e4c0] shadow-[0_10px_30px_rgba(245,196,81,0.18)] backdrop-blur-xl transition-all duration-500 hover:border-[#f5c451]/70 hover:shadow-[0_15px_40px_rgba(245,196,81,0.32)] md:p-10">
    <div aria-hidden="true" class="pointer-events-none absolute -top-20 -left-20 -z-10 h-40 w-40 rounded-full bg-[#f5c451]/22 blur-[50px] transition-all duration-500 group-hover:bg-[#ffe08a]/30"></div>
    <div aria-hidden="true" class="pointer-events-none absolute -right-20 -bottom-20 -z-10 h-40 w-40 rounded-full bg-[#5c1008]/85 blur-[50px] transition-all duration-500 group-hover:bg-[#8f1a10]/80"></div>

    {
      title && (
        <header class="mb-6 flex items-center gap-4 border-b border-[#f5c451]/35 pb-4">
          <div aria-hidden="true" class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#ffe08a] to-[#c8901a] shadow-[0_0_10px_rgba(245,196,81,0.5)]" />
          <HeadingTag class="bg-gradient-to-r from-[#ffe08a] via-[#f5c451] to-[#c8901a] bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase">{title}</HeadingTag>
        </header>
      )
    }
    <slot />
  </div>
</section>
