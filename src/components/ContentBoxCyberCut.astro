---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;
const headingSize = HeadingTag === "h1" ? "text-2xl md:text-3xl" : "text-xl md:text-2xl";

// isolate on the card + -z-10 on each decorative corner rule is what lets the
// slot content paint above the decoration without a wrapper <div>. Keep both.
//
// LAVA432: the top-left corner rules run molten orange, the bottom-right ones
// bright scarlet, so the clipped frame carries both halves of the logo (white
// wordmark over the scarlet 432 block) rather than one flat colour. The heading
// gradient stays in the white → ember half — deep scarlet as clip-text on the
// ember card falls under 3:1 even at this size.
---

<section class="my-6 flex w-full justify-center px-4 font-sans">
  <div
    class="relative isolate w-full max-w-7xl border border-[#ec000e]/35 bg-[#1c0505]/92 p-8 text-left text-base leading-relaxed text-[#f4e3e0] shadow-[0_10px_30px_rgba(236,0,14,0.24)] backdrop-blur-md"
    style="clip-path: polygon(40px 0, 100% 0, 100% calc(100% - 40px), calc(100% - 40px) 100%, 0 100%, 0 40px);">
    <div aria-hidden="true" class="absolute top-0 left-0 -z-10 h-1 w-32 bg-gradient-to-r from-[#ff6a13] to-transparent"></div>
    <div aria-hidden="true" class="absolute right-0 bottom-0 -z-10 h-1 w-32 bg-gradient-to-l from-[#ff3d2e] to-transparent"></div>
    <div aria-hidden="true" class="absolute top-0 left-0 -z-10 h-32 w-1 bg-gradient-to-b from-[#ff6a13] to-transparent"></div>
    <div aria-hidden="true" class="absolute right-0 bottom-0 -z-10 h-32 w-1 bg-gradient-to-t from-[#ff3d2e] to-transparent"></div>

    {
      title && (
        <header class="mb-8 border-l-4 border-[#ec000e] pl-6">
          <HeadingTag class={`bg-gradient-to-r from-[#ffffff] via-[#ffa040] to-[#ff6a13] bg-clip-text ${headingSize} leading-normal font-black text-transparent uppercase`}>{title}</HeadingTag>
        </header>
      )
    }
    <slot />
  </div>
</section>
