---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;
const headingSize = HeadingTag === "h1" ? "text-2xl md:text-3xl" : "text-xl md:text-2xl";

// isolate on the card + -z-10 on each decorative corner rule is what lets the
// slot content paint above the decoration without a wrapper <div>. Keep both.
//
// AMBKING1234: the top-left corner rules run lime, the bottom-right ones gold,
// so the clipped frame reads as the brand's two hues rather than one flat
// colour. The heading gradient ends on #8fd318 and never on #1c7a2f — deep green
// as clip-text on near-black falls under 3:1 even at this size.
---

<section class="my-6 flex w-full justify-center px-4 font-sans">
  <div
    class="relative isolate w-full max-w-7xl border border-[#8fd318]/35 bg-[#08210f]/92 p-8 text-left text-base leading-relaxed text-[#e6f3dd] shadow-[0_10px_30px_rgba(143,211,24,0.18)] backdrop-blur-md"
    style="clip-path: polygon(40px 0, 100% 0, 100% calc(100% - 40px), calc(100% - 40px) 100%, 0 100%, 0 40px);">
    <div class="absolute top-0 left-0 -z-10 h-1 w-32 bg-gradient-to-r from-[#d4ea23] to-transparent"></div>
    <div class="absolute right-0 bottom-0 -z-10 h-1 w-32 bg-gradient-to-l from-[#fbd503] to-transparent"></div>
    <div class="absolute top-0 left-0 -z-10 h-32 w-1 bg-gradient-to-b from-[#d4ea23] to-transparent"></div>
    <div class="absolute right-0 bottom-0 -z-10 h-32 w-1 bg-gradient-to-t from-[#fbd503] to-transparent"></div>

    {
      title && (
        <header class="mb-8 border-l-4 border-[#8fd318] pl-6">
          <HeadingTag class={`bg-gradient-to-r from-[#f2fbe8] via-[#d4ea23] to-[#8fd318] bg-clip-text ${headingSize} leading-normal font-black text-transparent uppercase`}>{title}</HeadingTag>
        </header>
      )
    }
    <slot />
  </div>
</section>
