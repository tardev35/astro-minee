---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;
const headingSize = HeadingTag === "h1" ? "text-2xl md:text-3xl" : "text-xl md:text-2xl";

// isolate on the card + -z-10 on each decorative corner rule is what lets the
// slot content paint above the decoration without a wrapper <div>. Keep both.
//
// PATTAYA168: the top-left corner rules run pale seafoam and the bottom-right
// ones the deep teal, so the clipped frame reads as the two ends of the brand
// ramp. The heading gradient stops at #02c4e3 — the deep teal #0c8ba4 as
// clip-text on this ocean-ink card falls close to 3:1 even at heading size.
---

<section class="my-6 flex w-full justify-center px-4 font-sans">
  <div
    class="relative isolate w-full max-w-7xl border border-[#02c4e3]/40 bg-[#04222b]/92 p-8 text-left text-base leading-relaxed text-[#cfeef7] shadow-[0_10px_30px_rgba(2,196,227,0.22)] backdrop-blur-md"
    style="clip-path: polygon(40px 0, 100% 0, 100% calc(100% - 40px), calc(100% - 40px) 100%, 0 100%, 0 40px);">
    <div aria-hidden="true" class="absolute top-0 left-0 -z-10 h-1 w-32 bg-gradient-to-r from-[#8ff5ff] to-transparent"></div>
    <div aria-hidden="true" class="absolute right-0 bottom-0 -z-10 h-1 w-32 bg-gradient-to-l from-[#0c8ba4] to-transparent"></div>
    <div aria-hidden="true" class="absolute top-0 left-0 -z-10 h-32 w-1 bg-gradient-to-b from-[#8ff5ff] to-transparent"></div>
    <div aria-hidden="true" class="absolute right-0 bottom-0 -z-10 h-32 w-1 bg-gradient-to-t from-[#0c8ba4] to-transparent"></div>

    {
      title && (
        <header class="mb-8 border-l-4 border-[#02c4e3] pl-6">
          <HeadingTag class={`bg-gradient-to-r from-[#8ff5ff] via-[#5afef1] to-[#02c4e3] bg-clip-text ${headingSize} leading-normal font-black text-transparent uppercase`}>{title}</HeadingTag>
        </header>
      )
    }
    <slot />
  </div>
</section>
