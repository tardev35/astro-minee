---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;
const headingSize = HeadingTag === "h1" ? "text-2xl md:text-3xl" : "text-xl md:text-2xl";

// isolate on the card + -z-10 on each decorative corner rule is what lets the
// slot content paint above the decoration without a wrapper <div>. Keep both.
//
// MVP928: the top-left corner rules run gold and the bottom-right ones the burnt
// copper, so the clipped frame reads as the two metals in the wordmark. The
// heading gradient stops at #ef6a17 — the deep copper #b34a08 as clip-text on
// this warm near-black card falls close to 3:1 even at heading size.
---

<section class="my-6 flex w-full justify-center px-4 font-sans">
  <div
    class="relative isolate w-full max-w-7xl border border-[#ef6a17]/40 bg-[#1c0e05]/92 p-8 text-left text-base leading-relaxed text-[#ece0d6] shadow-[0_10px_30px_rgba(239,106,23,0.24)] backdrop-blur-md"
    style="clip-path: polygon(40px 0, 100% 0, 100% calc(100% - 40px), calc(100% - 40px) 100%, 0 100%, 0 40px);">
    <div aria-hidden="true" class="absolute top-0 left-0 -z-10 h-1 w-32 bg-gradient-to-r from-[#f0b243] to-transparent"></div>
    <div aria-hidden="true" class="absolute right-0 bottom-0 -z-10 h-1 w-32 bg-gradient-to-l from-[#ef6a17] to-transparent"></div>
    <div aria-hidden="true" class="absolute top-0 left-0 -z-10 h-32 w-1 bg-gradient-to-b from-[#f0b243] to-transparent"></div>
    <div aria-hidden="true" class="absolute right-0 bottom-0 -z-10 h-32 w-1 bg-gradient-to-t from-[#ef6a17] to-transparent"></div>

    {
      title && (
        <header class="mb-8 border-l-4 border-[#ef6a17] pl-6">
          <HeadingTag class={`bg-gradient-to-r from-[#eaeef3] via-[#f0b243] to-[#ef6a17] bg-clip-text ${headingSize} leading-normal font-black text-transparent uppercase`}>{title}</HeadingTag>
        </header>
      )
    }
    <slot />
  </div>
</section>
