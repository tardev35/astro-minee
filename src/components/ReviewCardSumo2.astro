---
const reviews = [
  {
    name: "สมาชิกที่เลือกเกมตามค่ายและธีม",
    role: "ดูอัตราจ่ายและความผันผวนก่อนกดเล่น",
    stars: 5,
    tag: "รวมเกมหลายค่าย",
    content:
      "ในระบบมีทั้งสล็อตคลาสสิก วิดีโอสล็อต เกมโบนัส และเกมที่มาพร้อมฟีเจอร์พิเศษ การค้นหาตามค่าย ธีม หรือรูปแบบที่ชอบทำให้ไม่ต้องไล่เปิดทีละหน้า สิ่งที่ใช้แล้วช่วยได้จริงคือเปิดดูกติกา อัตราจ่าย และระดับความผันผวนของเกมก่อน แล้วค่อยเลือกให้เหมาะกับงบประมาณของตัวเอง",
    avatar: "🎰",
  },
  {
    name: "สมาชิกที่ใช้งานผ่านระบบเว็บตรง",
    role: "ตรวจช่องทางเข้าให้ถูกต้องก่อนกรอกข้อมูล",
    stars: 5,
    tag: "เว็บตรงและความปลอดภัย",
    content:
      "การสมัคร เข้าสู่ระบบ เลือกเกม และตรวจสอบรายการอยู่ในหน้าเว็บไซต์เดียว จึงลดขั้นตอนไปได้พอสมควร ส่วนที่ควรทำทุกครั้งคือตรวจช่องทางเข้าให้ถูกต้องก่อนกรอกข้อมูล ตั้งรหัสผ่านที่คาดเดายาก และไม่เปิดเผยรหัสยืนยันแก่ผู้อื่น เพราะความสะดวกกับความปลอดภัยของบัญชีต้องมาคู่กัน",
    avatar: "🔐",
  },
  {
    name: "สมาชิกที่ทำรายการผ่านมือถือเป็นหลัก",
    role: "กำหนดยอดทำรายการตามช่องทางที่รองรับ",
    stars: 4,
    tag: "ไม่มีขั้นต่ำและรองรับมือถือ",
    content:
      "เงื่อนไขฝากถอนไม่มีขั้นต่ำช่วยให้กำหนดยอดทำรายการได้ยืดหยุ่นขึ้น แต่ก่อนยืนยันควรตรวจช่องทางที่รองรับ สถานะบัญชี และข้อกำหนดของโปรโมชั่นก่อนทุกครั้ง ฝั่งการใช้งานรองรับทั้งมือถือ แท็บเล็ต และคอมพิวเตอร์ ควรใช้อินเทอร์เน็ตที่เสถียรและเลี่ยงเครือข่ายสาธารณะเมื่อต้องทำธุรกรรม",
    avatar: "📱",
  },
];

const totalStars = reviews.reduce((sum, r) => sum + r.stars, 0);
const average = (totalStars / reviews.length).toFixed(1);
---

<section aria-label="เสียงจากสมาชิก XFINITYPLAY" class="relative z-10 mx-auto mb-12 w-full max-w-[1400px] px-4 font-sans">
  <div class="mb-8 flex w-full flex-col items-center justify-center gap-2 text-center">
    <p class="bg-gradient-to-r from-[#a5f3fc] via-[#22d3ee] to-[#a855f7] bg-clip-text text-3xl font-black tracking-widest text-transparent uppercase">
      เสียงจากสมาชิก <span class="text-[#e879f9]">XFINITYPLAY</span>
    </p>
    <div class="mt-2 h-[4px] w-24 rounded-full bg-gradient-to-r from-transparent via-[#22d3ee] to-transparent"></div>
  </div>

  <div class="mx-auto mb-8 flex max-w-md items-center justify-center gap-5 rounded-2xl border border-[#22d3ee]/25 bg-[#0d0a2b]/92 px-6 py-4 shadow-[0_10px_30px_rgba(34,211,238,0.18)] backdrop-blur-xl">
    <div class="flex flex-col items-center">
      <span class="bg-gradient-to-b from-[#a5f3fc] to-[#a855f7] bg-clip-text text-4xl leading-none font-black text-transparent">{average}</span>
      <span class="mt-1 text-[10px] font-bold tracking-widest text-[#9fb3cc] uppercase">คะแนนเฉลี่ย</span>
    </div>
    <div class="h-12 w-px bg-[#a855f7]/35"></div>
    <div class="flex flex-col gap-1.5">
      <div aria-hidden="true" class="flex gap-1 text-lg">
        {Array.from({ length: 5 }).map((_, i) => <span class={i < Math.round(Number(average)) ? "text-[#22d3ee]" : "text-[#2a1f6b]"}>★</span>)}
      </div>
      <span class="text-xs font-bold text-[#9fb3cc]">คะแนนเฉลี่ย {average} จาก 5 ดาว จากการใช้งานจริงของสมาชิก {reviews.length} ด้าน</span>
    </div>
  </div>

  <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
    {
      reviews.map((review) => (
        <article class="group relative isolate flex flex-col gap-4 overflow-hidden rounded-2xl border border-[#22d3ee]/25 bg-[#0d0a2b]/92 p-6 text-left shadow-[0_10px_30px_rgba(34,211,238,0.18)] backdrop-blur-xl transition-all duration-300 hover:-translate-y-1 hover:border-[#22d3ee]/50 hover:shadow-[0_15px_40px_rgba(34,211,238,0.3)]">
          <span class="absolute inset-y-0 left-0 -z-10 w-1 bg-gradient-to-b from-[#a5f3fc] to-[#a855f7] opacity-80 transition-opacity duration-300 group-hover:opacity-100" />
          <span class="pointer-events-none absolute -top-14 -right-14 -z-10 h-32 w-32 rounded-full bg-[#6d28d9]/45 blur-[50px] transition-all duration-300 group-hover:bg-[#a855f7]/45" />

          <div class="flex items-center justify-between gap-3">
            <span class="inline-flex items-center gap-1.5 rounded-full border border-[#22d3ee]/25 bg-[#080520] px-3 py-1 text-[10px] font-bold tracking-widest text-[#22d3ee] uppercase">
              <span class="h-1.5 w-1.5 animate-pulse rounded-full bg-[#e879f9]" />
              {review.tag}
            </span>
            <span class="flex gap-0.5 text-sm">
              <span aria-hidden="true" class="flex gap-0.5">
                {Array.from({ length: 5 }).map((_, i) => (
                  <span class={i < review.stars ? "text-[#22d3ee]" : "text-[#2a1f6b]"}>★</span>
                ))}
              </span>
              <span class="sr-only">ให้คะแนน {review.stars} จาก 5 ดาว</span>
            </span>
          </div>

          <p class="text-left text-base leading-relaxed text-[#cfe3f5]">{review.content}</p>

          <div class="mt-auto flex items-center gap-3 border-t border-[#a855f7]/30 pt-4">
            <span aria-hidden="true" class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl border border-[#22d3ee]/30 bg-gradient-to-br from-[#a5f3fc] via-[#22d3ee] to-[#a855f7] text-xl shadow-inner transition-transform duration-300 group-hover:scale-110">
              {review.avatar}
            </span>
            <span class="flex flex-col">
              <span class="text-sm font-black text-[#cfe3f5] transition-colors group-hover:text-[#a5f3fc]">{review.name}</span>
              <span class="text-[10px] font-bold tracking-wider text-[#9fb3cc] uppercase">{review.role}</span>
            </span>
          </div>
        </article>
      ))
    }
  </div>
</section>
