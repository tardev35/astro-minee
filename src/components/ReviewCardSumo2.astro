---
// The section title is a <p>, not an <h2> — member voices are chrome, not a
// docx section. The region's accessible name lives on the section's aria-label.
// Names and quotes here are written characters, so no Review/AggregateRating
// JSON-LD is emitted for them anywhere.
//
// Every ★ sits inside an aria-hidden="true" wrapper and the real score is in the
// sr-only line beside it: U+2605 counts as Extended_Pictographic, so a bare one
// would be read out five times per card.
//
// Each card echoes one section of the RENGER8888 brief — choosing a game from
// the category that interests you, treating "เว็บหลัก" as something to verify
// rather than accept, checking the account and amount before confirming a
// transfer, comparing a promotion on its conditions instead of its bonus,
// checking an entitlement through the account page before starting, and reading
// "ฝากถอนง่ายไว" as the transaction's real status — so nothing here claims more
// than the brief.
const reviews = [
  {
    name: "สมาชิกที่เริ่มจากหมวดที่สนใจ",
    role: "เลือกจากบาคาร่า สล็อต หรือคาสิโนสดตามที่ระบบรองรับ",
    stars: 5,
    tag: "เริ่มจากหมวด",
    content:
      "พอเลือกเกมจากหมวดที่สนใจก่อนก็ไล่ดูได้ง่ายขึ้นมาก การแยกหมวดไว้ชัดทำให้เทียบกติกา อัตราจ่าย และวงเงินขั้นต่ำของแต่ละเกมได้เร็ว ก่อนเลือกก็ยังดูข้อมูลของเกมและระดับความเสี่ยงให้พอดีกับงบที่เตรียมไว้",
    avatar: "🗂️",
  },
  {
    name: "สมาชิกที่ตรวจข้อมูลก่อนเชื่อคำโปรโมต",
    role: "ดูช่องทางเข้า ระบบสมาชิก ประวัติธุรกรรม และช่องทางติดต่อ",
    stars: 5,
    tag: "ดูให้ครบก่อนตัดสิน",
    content:
      "คำว่าเว็บหลักไม่ได้ใช้เป็นหลักฐานยืนยันคุณภาพอย่างเดียว ก่อนตัดสินใจก็ดูช่องทางเข้า ระบบสมาชิก ประวัติธุรกรรม ข้อมูลเกม และช่องทางติดต่อประกอบกัน พอองค์ประกอบพวกนี้ชัดเจนก็ตรวจสอบการใช้งานและสถานะรายการได้ง่ายขึ้น",
    avatar: "🔎",
  },
  {
    name: "สมาชิกที่ตรวจข้อมูลก่อนกดยืนยัน",
    role: "ดูชื่อบัญชี จำนวนเงิน และข้อมูลรับเงินทุกครั้ง",
    stars: 5,
    tag: "ตรวจก่อนยืนยัน",
    content:
      "จัดการฝากถอนผ่านระบบที่เว็บไซต์กำหนดแล้วสะดวกขึ้นจริง แต่ก่อนทำรายการก็ยังไล่ดูชื่อบัญชี จำนวนเงิน และข้อมูลรับเงินให้ถูกต้องอยู่ดี ถ้ารายการเดิมยังอยู่ระหว่างดำเนินการก็รอการอัปเดตก่อนส่งใหม่ จะได้ไม่เกิดรายการซ้ำหรือยอดคลาดเคลื่อน",
    avatar: "🧾",
  },
  {
    name: "สมาชิกที่เทียบโปรมากกว่าจำนวนโบนัส",
    role: "ดูยอดฝากขั้นต่ำ เกมที่ร่วมรายการ ระยะเวลา และการถอน",
    stars: 4,
    tag: "เทียบเงื่อนไขก่อนรับ",
    content:
      "โปรที่ดูคุ้มไม่ได้แปลว่าเป็นโปรที่ให้เครดิตมากที่สุด เลยเปรียบเทียบยอดฝากขั้นต่ำ เกมที่ร่วมรายการ ระยะเวลา และข้อกำหนดการถอนไปพร้อมกัน พอเลือกโปรที่ตรงกับงบและประเภทเกมที่เล่นก็เข้าใจต้นทุนและเงื่อนไขได้ชัดกว่าเดิม",
    avatar: "🏷️",
  },
  {
    name: "สมาชิกที่ตรวจสิทธิ์จากหน้าบัญชี",
    role: "ดูชื่อโปรโมชั่น จำนวนเครดิต และเงื่อนไขที่เกี่ยวข้อง",
    stars: 5,
    tag: "ตรวจสิทธิ์ก่อนเริ่ม",
    content:
      "ก่อนรับสิทธิ์จะเปิดหน้าบัญชีดูชื่อโปรโมชั่น จำนวนเครดิต และเงื่อนไขที่เกี่ยวข้องให้ครบก่อน ถ้ามีหลายโปรพร้อมกันก็ดูว่าใช้ร่วมกันได้หรือไม่ แล้วเก็บรายละเอียดสิทธิ์ไว้จนกว่าการใช้งานหรือการถอนจะเสร็จสมบูรณ์",
    avatar: "🎫",
  },
  {
    name: "สมาชิกที่ติดตามสถานะจากหน้าประวัติ",
    role: "ดูสถานะธุรกรรมจริงแทนการคาดเวลาไว้ล่วงหน้า",
    stars: 4,
    tag: "ดูสถานะจริง",
    content:
      "คำว่าฝากถอนง่ายไวดูจากสถานะธุรกรรมจริงในระบบเป็นหลัก ไม่ได้ตีความว่าเป็นการรับประกันเวลาทุกกรณี ความเร็วขึ้นอยู่กับช่องทาง สถานะบัญชี และขั้นตอนตรวจสอบ เลยติดตามรายการจากหน้าประวัติแล้วรอผลตามที่ระบบแสดง",
    avatar: "⏳",
  },
];

const totalStars = reviews.reduce((sum, r) => sum + r.stars, 0);
const average = (totalStars / reviews.length).toFixed(1);
---

<section aria-label="เสียงจากสมาชิก RENGER8888" class="relative z-10 mx-auto mb-12 w-full max-w-[1400px] px-4 font-sans">
  <div class="mb-8 flex w-full flex-col items-center justify-center gap-2 text-center">
    <p class="bg-gradient-to-r from-[#e6ecf2] via-[#e8121f] to-[#8f0c14] bg-clip-text text-3xl font-black tracking-widest text-transparent uppercase">
      เสียงจากสมาชิก <span class="text-[#ff2b38]">RENGER8888</span>
    </p>
    <div aria-hidden="true" class="mt-2 h-[4px] w-24 rounded-full bg-gradient-to-r from-transparent via-[#e8121f] to-transparent"></div>
  </div>

  <div class="mx-auto mb-8 flex max-w-md items-center justify-center gap-5 rounded-2xl border border-[#e8121f]/35 bg-[#160406]/92 px-6 py-4 shadow-[0_10px_30px_rgba(232,18,31,0.22)] backdrop-blur-xl">
    <div class="flex flex-col items-center">
      <span class="bg-gradient-to-b from-[#e6ecf2] to-[#e8121f] bg-clip-text text-4xl leading-none font-black text-transparent">{average}</span>
      <span class="mt-1 text-[10px] font-bold tracking-widest text-[#c5a0a2] uppercase">คะแนนเฉลี่ย</span>
    </div>
    <div aria-hidden="true" class="h-12 w-px bg-[#e8121f]/40"></div>
    <div class="flex flex-col gap-1.5">
      <div aria-hidden="true" class="flex gap-1 text-lg">
        {Array.from({ length: 5 }).map((_, i) => <span class={i < Math.round(Number(average)) ? "text-[#ff2b38]" : "text-[#4a060a]"}>★</span>)}
      </div>
      <span class="text-xs font-bold text-[#c5a0a2]">คะแนนเฉลี่ย {average} จาก 5 ดาว จากการใช้งานจริงของสมาชิก {reviews.length} ด้าน</span>
    </div>
  </div>

  <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
    {
      reviews.map((review) => (
        <article class="group relative isolate flex flex-col gap-4 overflow-hidden rounded-2xl border border-[#e8121f]/35 bg-[#160406]/92 p-6 text-left shadow-[0_10px_30px_rgba(232,18,31,0.22)] backdrop-blur-xl transition-all duration-300 hover:-translate-y-1 hover:border-[#ff2b38]/60 hover:shadow-[0_15px_40px_rgba(255,43,56,0.28)]">
          <span aria-hidden="true" class="absolute inset-y-0 left-0 -z-10 w-1 bg-gradient-to-b from-[#e6ecf2] to-[#8f0c14] opacity-80 transition-opacity duration-300 group-hover:opacity-100" />
          <span
            aria-hidden="true"
            class="pointer-events-none absolute -top-14 -right-14 -z-10 h-32 w-32 rounded-full bg-[#8f0c14]/50 blur-[50px] transition-all duration-300 group-hover:bg-[#e8121f]/35"
          />

          <div class="flex items-center justify-between gap-3">
            <span class="inline-flex items-center gap-1.5 rounded-full border border-[#e8121f]/35 bg-[#080203] px-3 py-1 text-[10px] font-bold tracking-widest text-[#ff2b38] uppercase">
              <span aria-hidden="true" class="h-1.5 w-1.5 animate-pulse rounded-full bg-[#e8121f]" />
              {review.tag}
            </span>
            <span class="flex gap-0.5 text-sm">
              <span aria-hidden="true" class="flex gap-0.5">
                {Array.from({ length: 5 }).map((_, i) => (
                  <span class={i < review.stars ? "text-[#ff2b38]" : "text-[#4a060a]"}>★</span>
                ))}
              </span>
              <span class="sr-only">ให้คะแนน {review.stars} จาก 5 ดาว</span>
            </span>
          </div>

          <p class="text-left text-base leading-relaxed text-[#f0dcdc]">{review.content}</p>

          <div class="mt-auto flex items-center gap-3 border-t border-[#e8121f]/35 pt-4">
            <span
              aria-hidden="true"
              class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl border border-[#ff2b38]/50 bg-gradient-to-br from-[#e8121f] to-[#8f0c14] text-xl shadow-inner transition-transform duration-300 group-hover:scale-110">
              {review.avatar}
            </span>
            <span class="flex flex-col">
              <span class="text-sm font-black text-[#f0dcdc] transition-colors group-hover:text-[#ff2b38]">{review.name}</span>
              <span class="text-[10px] font-bold tracking-wider text-[#c5a0a2] uppercase">{review.role}</span>
            </span>
          </div>
        </article>
      ))
    }
  </div>
</section>
