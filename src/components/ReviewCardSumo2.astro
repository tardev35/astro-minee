---
// The section title is a <p>, not an <h2> — member voices are chrome, not a
// docx section. The region's accessible name lives on the section's aria-label.
// Names and quotes here are written characters, so no Review/AggregateRating
// JSON-LD is emitted for them anywhere.
const reviews = [
  {
    name: "สมาชิกที่เริ่มเล่นด้วยงบไม่สูง",
    role: "เทียบกติกาและความผันผวนก่อนเลือกเกม",
    stars: 5,
    tag: "เริ่มเล่นด้วยงบที่เหมาะสม",
    content:
      "ในระบบมีเกมสล็อตหลายแนวทั้งแบบคลาสสิก เกมโบนัส และเกมที่มีฟีเจอร์หลากหลาย การไล่ดูกติกา ความผันผวน และรูปแบบการจ่ายก่อนเริ่ม ช่วยให้เลือกเกมที่สอดคล้องกับงบประมาณของตัวเองได้ โดยไม่จำเป็นต้องเริ่มด้วยเงินจำนวนสูง",
    avatar: "🎰",
  },
  {
    name: "สมาชิกที่ทำรายการฝากถอนเป็นประจำ",
    role: "ตรวจยอดก่อนยืนยันและรอสถานะให้ครบ",
    stars: 5,
    tag: "ฝากถอนออโต้และไม่มีขั้นต่ำ",
    content:
      "ระบบออโต้ทำให้ฝาก ถอน และตรวจสอบสถานะรายการผ่านหน้าบัญชีได้ด้วยตนเอง สิ่งที่ควรทำทุกครั้งคือตรวจชื่อบัญชี จำนวนเงิน และข้อมูลให้ถูกต้องก่อนยืนยัน ส่วนเงื่อนไขไม่มีขั้นต่ำอาจใช้เฉพาะช่องทางที่กำหนด จึงควรดูรายละเอียดก่อนทำรายการ และถ้ารายการยังดำเนินการอยู่ก็รอผลจากระบบ ไม่ส่งซ้ำ",
    avatar: "⚡",
  },
  {
    name: "สมาชิกที่ใช้งานผ่านมือถือเป็นหลัก",
    role: "เก็บรายละเอียดรายการไว้ตรวจย้อนหลัง",
    stars: 4,
    tag: "ตรวจสอบบัญชีและรับบริการ",
    content:
      "เว็บไซต์เปิดผ่านเบราว์เซอร์บนมือถือ แท็บเล็ต และคอมพิวเตอร์ได้เหมือนกัน จึงเข้าถึงเกมสล็อต โปรโมชั่น และข้อมูลบัญชีจากระบบเดียวได้คล่องตัว เวลามีข้อสงสัยเรื่องบัญชี ทางเข้า โปรโมชั่น หรือสถานะธุรกรรม การเตรียมชื่อผู้ใช้ เวลา และรายละเอียดรายการไว้ให้ครบ ช่วยให้ทีมงานตรวจสอบได้เร็วขึ้น โดยไม่ต้องเปิดเผยรหัสผ่านหรือรหัสยืนยัน",
    avatar: "📱",
  },
];

const totalStars = reviews.reduce((sum, r) => sum + r.stars, 0);
const average = (totalStars / reviews.length).toFixed(1);
---

<section aria-label="เสียงจากสมาชิก KIKI49" class="relative z-10 mx-auto mb-12 w-full max-w-[1400px] px-4 font-sans">
  <div class="mb-8 flex w-full flex-col items-center justify-center gap-2 text-center">
    <p class="bg-gradient-to-r from-[#ffe08a] via-[#f5c542] to-[#ff5a5f] bg-clip-text text-3xl font-black tracking-widest text-transparent uppercase">
      เสียงจากสมาชิก <span class="text-[#e9edf2]">KIKI49</span>
    </p>
    <div class="mt-2 h-[4px] w-24 rounded-full bg-gradient-to-r from-transparent via-[#e2131d] to-transparent"></div>
  </div>

  <div class="mx-auto mb-8 flex max-w-md items-center justify-center gap-5 rounded-2xl border border-[#e2131d]/30 bg-[#1c0407]/92 px-6 py-4 shadow-[0_10px_30px_rgba(226,19,29,0.2)] backdrop-blur-xl">
    <div class="flex flex-col items-center">
      <span class="bg-gradient-to-b from-[#ffe08a] to-[#f5c542] bg-clip-text text-4xl leading-none font-black text-transparent">{average}</span>
      <span class="mt-1 text-[10px] font-bold tracking-widest text-[#f2e2e4]/60 uppercase">คะแนนเฉลี่ย</span>
    </div>
    <div class="h-12 w-px bg-[#e2131d]/35"></div>
    <div class="flex flex-col gap-1.5">
      <div aria-hidden="true" class="flex gap-1 text-lg">
        {Array.from({ length: 5 }).map((_, i) => <span class={i < Math.round(Number(average)) ? "text-[#f5c542]" : "text-[#5c070b]"}>★</span>)}
      </div>
      <span class="text-xs font-bold text-[#f2e2e4]/75">คะแนนเฉลี่ย {average} จาก 5 ดาว จากการใช้งานจริงของสมาชิก {reviews.length} ด้าน</span>
    </div>
  </div>

  <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
    {
      reviews.map((review) => (
        <article class="group relative isolate flex flex-col gap-4 overflow-hidden rounded-2xl border border-[#e2131d]/30 bg-[#1c0407]/92 p-6 text-left shadow-[0_10px_30px_rgba(226,19,29,0.2)] backdrop-blur-xl transition-all duration-300 hover:-translate-y-1 hover:border-[#e2131d]/60 hover:shadow-[0_15px_40px_rgba(168,15,22,0.3)]">
          <span class="absolute inset-y-0 left-0 -z-10 w-1 bg-gradient-to-b from-[#ffe08a] to-[#e2131d] opacity-80 transition-opacity duration-300 group-hover:opacity-100" />
          <span class="pointer-events-none absolute -top-14 -right-14 -z-10 h-32 w-32 rounded-full bg-[#5c070b]/70 blur-[50px] transition-all duration-300 group-hover:bg-[#e2131d]/35" />

          <div class="flex items-center justify-between gap-3">
            <span class="inline-flex items-center gap-1.5 rounded-full border border-[#e2131d]/30 bg-[#100205] px-3 py-1 text-[10px] font-bold tracking-widest text-[#ff5a5f] uppercase">
              <span class="h-1.5 w-1.5 animate-pulse rounded-full bg-[#f5c542]" />
              {review.tag}
            </span>
            <span class="flex gap-0.5 text-sm">
              <span aria-hidden="true" class="flex gap-0.5">
                {Array.from({ length: 5 }).map((_, i) => (
                  <span class={i < review.stars ? "text-[#f5c542]" : "text-[#5c070b]"}>★</span>
                ))}
              </span>
              <span class="sr-only">ให้คะแนน {review.stars} จาก 5 ดาว</span>
            </span>
          </div>

          <p class="text-left text-base leading-relaxed text-[#f2e2e4]">{review.content}</p>

          <div class="mt-auto flex items-center gap-3 border-t border-[#e2131d]/30 pt-4">
            <span
              aria-hidden="true"
              class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl border border-[#f5c542]/40 bg-gradient-to-br from-[#ff5a5f] via-[#e2131d] to-[#5c070b] text-xl shadow-inner transition-transform duration-300 group-hover:scale-110">
              {review.avatar}
            </span>
            <span class="flex flex-col">
              <span class="text-sm font-black text-[#f2e2e4] transition-colors group-hover:text-[#ff5a5f]">{review.name}</span>
              <span class="text-[10px] font-bold tracking-wider text-[#f2e2e4]/60 uppercase">{review.role}</span>
            </span>
          </div>
        </article>
      ))
    }
  </div>
</section>
