---
// The section title is a <p>, not an <h2> — member voices are chrome, not a
// docx section. The region's accessible name lives on the section's aria-label.
// Names and quotes here are written characters, so no Review/AggregateRating
// JSON-LD is emitted for them anywhere.
//
// Every ★ sits inside an aria-hidden="true" wrapper and the real score is in the
// sr-only line beside it: U+2605 counts as Extended_Pictographic, so a bare one
// would be read out five times per card.
//
// Each card echoes one section of the MVP928 brief — finding games, promotions
// and account data from one place, treating "อันดับหนึ่ง" as marketing and
// checking the data behind it, matching a promotion to the budget rather than to
// the headline bonus, working the auto system step by step, reading RTP with
// volatility and the bonus features, and setting a limit because "แตกง่าย"
// guarantees nothing — so nothing here claims more than the brief.
const reviews = [
  {
    name: "สมาชิกที่ใช้ระบบจากจุดเดียว",
    role: "ค้นหาเกม โปรโมชั่น และข้อมูลบัญชีในหน้าเดียวกัน",
    stars: 5,
    tag: "ลดการสลับหน้า",
    content:
      "ตั้งแต่เปลี่ยนมาไล่ดูจากจุดเดียวก็หาเกมกับโปรโมชั่นได้เร็วขึ้น ไม่ต้องเปิดสลับหลายหน้าเหมือนเมื่อก่อน หมวดเกมที่แยกไว้ชัดเจนทำให้เทียบฟีเจอร์และรูปแบบการเล่นก่อนตัดสินใจได้สะดวกกว่าเดิมพอสมควร",
    avatar: "🗂️",
  },
  {
    name: "สมาชิกที่ดูข้อมูลมากกว่าคำโปรโมต",
    role: "ดูค่ายเกม ระบบบัญชี ช่องทางติดต่อ และเงื่อนไขธุรกรรม",
    stars: 5,
    tag: "อ่านข้อมูลก่อนเชื่อ",
    content:
      "คำว่าอันดับหนึ่งเป็นถ้อยคำทางการตลาด เลยไม่ได้ใช้เป็นหลักฐานอย่างเดียว ก่อนตัดสินใจก็ดูข้อมูลค่ายเกม ระบบบัญชี ช่องทางติดต่อ และเงื่อนไขธุรกรรมประกอบกัน วิธีนี้ทำให้มีข้อมูลรองรับมากกว่าดูจากคำโฆษณา",
    avatar: "🔎",
  },
  {
    name: "สมาชิกที่เลือกโปรให้ตรงกับงบ",
    role: "ดูยอดขั้นต่ำ เกมที่ร่วมรายการ และเงื่อนไขการถอน",
    stars: 5,
    tag: "อ่านเงื่อนไขก่อนรับ",
    content:
      "โปรโมชั่นมีทั้งโบนัสสมาชิกใหม่ สิทธิ์ตามยอดฝาก และกิจกรรมตามช่วงเวลา ก่อนรับเลยตรวจยอดขั้นต่ำ เกมที่ร่วมรายการ และเงื่อนไขการถอนให้ครบก่อน โปรที่โบนัสสูงสุดไม่ได้แปลว่าเหมาะกับงบและพฤติกรรมการเล่นที่สุด",
    avatar: "🏷️",
  },
  {
    name: "สมาชิกที่ตรวจรายการทีละขั้นตอน",
    role: "ดูชื่อบัญชี จำนวนเงิน และสถานะรายการก่อนยืนยัน",
    stars: 4,
    tag: "ตรวจก่อนยืนยัน",
    content:
      "ระบบออโต้ช่วยลดขั้นตอนจัดการบัญชีและธุรกรรมได้จริง แต่ก่อนกดยืนยันก็ยังไล่ดูชื่อบัญชีและจำนวนเงินให้ถูกต้องทุกครั้ง ถ้ารายการเดิมยังดำเนินการอยู่ก็รอผลจากระบบก่อนส่งใหม่ จะได้ไม่เกิดรายการซ้ำหรือคลาดเคลื่อน",
    avatar: "🧾",
  },
  {
    name: "สมาชิกที่อ่าน RTP คู่กับความผันผวน",
    role: "ดูค่าที่ผู้ให้บริการระบุ ฟีเจอร์โบนัส และระดับความผันผวน",
    stars: 5,
    tag: "ดูข้อมูลก่อนเล่น",
    content:
      "แทนที่จะเลือกจากคำว่าแตกง่ายอย่างเดียว ก็ดูค่า RTP ที่ผู้ให้บริการระบุ ฟีเจอร์โบนัส และระดับความผันผวนของเกมร่วมกัน เกมแต่ละประเภทให้ประสบการณ์ต่างกัน พอเข้าใจข้อมูลพวกนี้ก็เลือกวงเงินได้เหมาะกับงบมากขึ้น",
    avatar: "🎯",
  },
  {
    name: "สมาชิกที่กำหนดวงเงินไว้ล่วงหน้า",
    role: "ตั้งงบและเวลาเล่นก่อนเริ่มทุกครั้ง",
    stars: 4,
    tag: "เล่นตามแผนที่ตั้งไว้",
    content:
      "คำว่าแตกง่ายเป็นข้อความทางการตลาดที่ใช้สื่อถึงความน่าสนใจของเกม ไม่ได้รับประกันรางวัลหรือกำไร เลยกำหนดวงเงินและเวลาเล่นไว้ล่วงหน้า และเลี่ยงการเพิ่มเดิมพันเพื่อตามคืนยอดเสีย ทำให้คุมค่าใช้จ่ายได้ตามที่วางไว้",
    avatar: "⏱️",
  },
];

const totalStars = reviews.reduce((sum, r) => sum + r.stars, 0);
const average = (totalStars / reviews.length).toFixed(1);
---

<section aria-label="เสียงจากสมาชิก MVP928" class="relative z-10 mx-auto mb-12 w-full max-w-[1400px] px-4 font-sans">
  <div class="mb-8 flex w-full flex-col items-center justify-center gap-2 text-center">
    <p class="bg-gradient-to-r from-[#eaeef3] via-[#f0b243] to-[#ef6a17] bg-clip-text text-3xl font-black tracking-widest text-transparent uppercase">
      เสียงจากสมาชิก <span class="text-[#f0b243]">MVP928</span>
    </p>
    <div class="mt-2 h-[4px] w-24 rounded-full bg-gradient-to-r from-transparent via-[#ef6a17] to-transparent"></div>
  </div>

  <div
    class="mx-auto mb-8 flex max-w-md items-center justify-center gap-5 rounded-2xl border border-[#ef6a17]/35 bg-[#1c0e05]/92 px-6 py-4 shadow-[0_10px_30px_rgba(239,106,23,0.22)] backdrop-blur-xl">
    <div class="flex flex-col items-center">
      <span class="bg-gradient-to-b from-[#eaeef3] to-[#ef6a17] bg-clip-text text-4xl leading-none font-black text-transparent">{average}</span>
      <span class="mt-1 text-[10px] font-bold tracking-widest text-[#c6ab97] uppercase">คะแนนเฉลี่ย</span>
    </div>
    <div class="h-12 w-px bg-[#ef6a17]/40"></div>
    <div class="flex flex-col gap-1.5">
      <div aria-hidden="true" class="flex gap-1 text-lg">
        {Array.from({ length: 5 }).map((_, i) => <span class={i < Math.round(Number(average)) ? "text-[#fb8b32]" : "text-[#3a2109]"}>★</span>)}
      </div>
      <span class="text-xs font-bold text-[#c6ab97]">คะแนนเฉลี่ย {average} จาก 5 ดาว จากการใช้งานจริงของสมาชิก {reviews.length} ด้าน</span>
    </div>
  </div>

  <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
    {
      reviews.map((review) => (
        <article class="group relative isolate flex flex-col gap-4 overflow-hidden rounded-2xl border border-[#ef6a17]/35 bg-[#1c0e05]/92 p-6 text-left shadow-[0_10px_30px_rgba(239,106,23,0.22)] backdrop-blur-xl transition-all duration-300 hover:-translate-y-1 hover:border-[#f0b243]/60 hover:shadow-[0_15px_40px_rgba(251,139,50,0.28)]">
          <span class="absolute inset-y-0 left-0 -z-10 w-1 bg-gradient-to-b from-[#eaeef3] to-[#b34a08] opacity-80 transition-opacity duration-300 group-hover:opacity-100" />
          <span class="pointer-events-none absolute -top-14 -right-14 -z-10 h-32 w-32 rounded-full bg-[#b34a08]/50 blur-[50px] transition-all duration-300 group-hover:bg-[#ef6a17]/35" />

          <div class="flex items-center justify-between gap-3">
            <span class="inline-flex items-center gap-1.5 rounded-full border border-[#ef6a17]/35 bg-[#0b0502] px-3 py-1 text-[10px] font-bold tracking-widest text-[#f0b243] uppercase">
              <span aria-hidden="true" class="h-1.5 w-1.5 animate-pulse rounded-full bg-[#ef6a17]" />
              {review.tag}
            </span>
            <span class="flex gap-0.5 text-sm">
              <span aria-hidden="true" class="flex gap-0.5">
                {Array.from({ length: 5 }).map((_, i) => (
                  <span class={i < review.stars ? "text-[#fb8b32]" : "text-[#3a2109]"}>★</span>
                ))}
              </span>
              <span class="sr-only">ให้คะแนน {review.stars} จาก 5 ดาว</span>
            </span>
          </div>

          <p class="text-left text-base leading-relaxed text-[#ece0d6]">{review.content}</p>

          <div class="mt-auto flex items-center gap-3 border-t border-[#ef6a17]/35 pt-4">
            <span
              aria-hidden="true"
              class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl border border-[#f0b243]/50 bg-gradient-to-br from-[#f0b243] to-[#ef6a17] text-xl shadow-inner transition-transform duration-300 group-hover:scale-110">
              {review.avatar}
            </span>
            <span class="flex flex-col">
              <span class="text-sm font-black text-[#ece0d6] transition-colors group-hover:text-[#f0b243]">{review.name}</span>
              <span class="text-[10px] font-bold tracking-wider text-[#c6ab97] uppercase">{review.role}</span>
            </span>
          </div>
        </article>
      ))
    }
  </div>
</section>
