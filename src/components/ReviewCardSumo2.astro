---
const reviews = [
  {
    name: "สมาชิกที่เลือกเกมจากกติกาและอัตราจ่าย",
    role: "อ่านรายละเอียดเกมก่อนเริ่มทุกครั้ง",
    stars: 5,
    tag: "รวมเกมคาสิโนหลายแบบ",
    content:
      "ในระบบมีเกมคาสิโนหลายประเภทให้เลือก ทั้งสล็อตที่มีรอบโบนัสหลายชั้น บาคาร่าที่กติกาสั้น รูเล็ต เกมไพ่ และคาสิโนสด การเลือกตามความสนใจและรูปแบบการเดิมพันทำให้ไม่ต้องไล่เปิดทีละหน้า สิ่งที่ช่วยได้จริงคืออ่านกติกา อัตราจ่าย และระดับความเสี่ยงของแต่ละเกมก่อน แล้วค่อยเลือกให้เหมาะกับงบประมาณของตัวเอง",
    avatar: "🎰",
  },
  {
    name: "สมาชิกที่ฝากถอนผ่านระบบออโต้",
    role: "ตรวจยอดก่อนยืนยันและรอสถานะให้ครบ",
    stars: 5,
    tag: "ฝากถอนออโต้ ไม่มีขั้นต่ำ",
    content:
      "ระบบออโต้ทำรายการผ่านหน้าบัญชีได้ด้วยตัวเอง จึงลดขั้นตอนการส่งข้อมูลซ้ำไปได้พอสมควร ส่วนที่ควรทำทุกครั้งคือตรวจชื่อบัญชี จำนวนเงิน และสถานะรายการก่อนปิดหน้าเว็บ ถ้ารายการยังอยู่ระหว่างดำเนินการก็ควรรอผลจากระบบแทนการส่งรายการใหม่ ส่วนเงื่อนไขไม่มีขั้นต่ำรองรับเฉพาะช่องทางที่กำหนด ควรอ่านรายละเอียดล่าสุดก่อนทำรายการ",
    avatar: "⚡",
  },
  {
    name: "สมาชิกที่ใช้งานผ่านมือถือเป็นหลัก",
    role: "เปิดผ่านเบราว์เซอร์ได้ทุกอุปกรณ์",
    stars: 4,
    tag: "รองรับมือถือและความปลอดภัย",
    content:
      "เว็บไซต์เปิดผ่านเบราว์เซอร์บนมือถือ แท็บเล็ต และคอมพิวเตอร์ได้เหมือนกัน จึงเข้าถึงเกม โปรโมชั่น และข้อมูลบัญชีจากหน้าเดียวได้สะดวก แต่ก่อนกรอกข้อมูลควรตรวจช่องทางเข้าให้ถูกต้องทุกครั้ง ฝั่งความปลอดภัยควรใช้อินเทอร์เน็ตที่เสถียร ตั้งรหัสผ่านที่คาดเดายาก และไม่เปิดเผยรหัสผ่านหรือรหัสยืนยันแก่ผู้อื่น",
    avatar: "📱",
  },
];

const totalStars = reviews.reduce((sum, r) => sum + r.stars, 0);
const average = (totalStars / reviews.length).toFixed(1);
---

<section aria-label="เสียงจากสมาชิก BUGGY888" class="relative z-10 mx-auto mb-12 w-full max-w-[1400px] px-4 font-sans">
  <div class="mb-8 flex w-full flex-col items-center justify-center gap-2 text-center">
    <p class="bg-gradient-to-r from-[#fff3cf] via-[#ffd233] to-[#e0a81c] bg-clip-text text-3xl font-black tracking-widest text-transparent uppercase">
      เสียงจากสมาชิก <span class="text-[#ffe98a]">BUGGY888</span>
    </p>
    <div class="mt-2 h-[4px] w-24 rounded-full bg-gradient-to-r from-transparent via-[#ffd233] to-transparent"></div>
  </div>

  <div class="mx-auto mb-8 flex max-w-md items-center justify-center gap-5 rounded-2xl border border-[#ffd233]/30 bg-[#1b0806]/92 px-6 py-4 shadow-[0_10px_30px_rgba(255,210,51,0.2)] backdrop-blur-xl">
    <div class="flex flex-col items-center">
      <span class="bg-gradient-to-b from-[#fff3cf] to-[#e0a81c] bg-clip-text text-4xl leading-none font-black text-transparent">{average}</span>
      <span class="mt-1 text-[10px] font-bold tracking-widest text-[#a8825f] uppercase">คะแนนเฉลี่ย</span>
    </div>
    <div class="h-12 w-px bg-[#ffd233]/35"></div>
    <div class="flex flex-col gap-1.5">
      <div aria-hidden="true" class="flex gap-1 text-lg">
        {Array.from({ length: 5 }).map((_, i) => <span class={i < Math.round(Number(average)) ? "text-[#ffd233]" : "text-[#6b0603]"}>★</span>)}
      </div>
      <span class="text-xs font-bold text-[#d6ab7e]">คะแนนเฉลี่ย {average} จาก 5 ดาว จากการใช้งานจริงของสมาชิก {reviews.length} ด้าน</span>
    </div>
  </div>

  <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
    {
      reviews.map((review) => (
        <article class="group relative isolate flex flex-col gap-4 overflow-hidden rounded-2xl border border-[#ffd233]/30 bg-[#1b0806]/92 p-6 text-left shadow-[0_10px_30px_rgba(255,210,51,0.2)] backdrop-blur-xl transition-all duration-300 hover:-translate-y-1 hover:border-[#ffd233]/60 hover:shadow-[0_15px_40px_rgba(232,36,26,0.26)]">
          <span class="absolute inset-y-0 left-0 -z-10 w-1 bg-gradient-to-b from-[#ffe98a] to-[#e0a81c] opacity-80 transition-opacity duration-300 group-hover:opacity-100" />
          <span class="pointer-events-none absolute -top-14 -right-14 -z-10 h-32 w-32 rounded-full bg-[#a5140b]/55 blur-[50px] transition-all duration-300 group-hover:bg-[#ffd233]/30" />

          <div class="flex items-center justify-between gap-3">
            <span class="inline-flex items-center gap-1.5 rounded-full border border-[#ffd233]/30 bg-[#0b0302] px-3 py-1 text-[10px] font-bold tracking-widest text-[#ffe98a] uppercase">
              <span class="h-1.5 w-1.5 animate-pulse rounded-full bg-[#e8241a]" />
              {review.tag}
            </span>
            <span class="flex gap-0.5 text-sm">
              <span aria-hidden="true" class="flex gap-0.5">
                {Array.from({ length: 5 }).map((_, i) => (
                  <span class={i < review.stars ? "text-[#ffd233]" : "text-[#6b0603]"}>★</span>
                ))}
              </span>
              <span class="sr-only">ให้คะแนน {review.stars} จาก 5 ดาว</span>
            </span>
          </div>

          <p class="text-left text-base leading-relaxed text-[#f7e2c4]">{review.content}</p>

          <div class="mt-auto flex items-center gap-3 border-t border-[#ffd233]/30 pt-4">
            <span
              aria-hidden="true"
              class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl border border-[#ffd233]/40 bg-gradient-to-br from-[#e8241a] via-[#a5140b] to-[#6b0603] text-xl shadow-inner transition-transform duration-300 group-hover:scale-110">
              {review.avatar}
            </span>
            <span class="flex flex-col">
              <span class="text-sm font-black text-[#f7e2c4] transition-colors group-hover:text-[#ffe98a]">{review.name}</span>
              <span class="text-[10px] font-bold tracking-wider text-[#a8825f] uppercase">{review.role}</span>
            </span>
          </div>
        </article>
      ))
    }
  </div>
</section>
