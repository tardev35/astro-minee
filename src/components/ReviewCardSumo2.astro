---
// The section title is a <p>, not an <h2> — member voices are chrome, not a
// docx section. The region's accessible name lives on the section's aria-label.
// Names and quotes here are written characters, so no Review/AggregateRating
// JSON-LD is emitted for them anywhere.
const reviews = [
  {
    name: "สมาชิกที่เลือกเกมจากกติกาก่อนเริ่ม",
    role: "ดูรูปแบบการเล่น ฟีเจอร์ และความผันผวนของแต่ละเกม",
    stars: 5,
    tag: "เลือกเกมตามสไตล์",
    content:
      "ในระบบมีเกมสล็อตหลายแนว ทั้งแบบคลาสสิก เกมโบนัส และเกมธีมใหม่ การไล่ดูรูปแบบการเล่น ฟีเจอร์ ความผันผวน และกติกาของแต่ละเกมก่อนกดเข้าเล่น ทำให้ได้ตัวเลือกที่ตรงกับงบประมาณและความชอบของตัวเองมากกว่าการเลือกจากหน้าปกเกมอย่างเดียว",
    avatar: "🎰",
  },
  {
    name: "สมาชิกที่ฝากผ่านระบบออโต้เป็นประจำ",
    role: "ตรวจชื่อบัญชี จำนวนเงิน และช่องทางก่อนยืนยันทุกครั้ง",
    stars: 5,
    tag: "ฝากแบบออโต้",
    content:
      "ระบบฝากแบบออโต้ช่วยลดขั้นตอนการส่งข้อมูลซ้ำไปได้เยอะ สิ่งที่ยังต้องทำเองคือตรวจชื่อบัญชี จำนวนเงิน และช่องทางที่ใช้ก่อนกดยืนยัน แล้วรอให้ระบบขึ้นสถานะสำเร็จก่อนค่อยทำรายการใหม่ ทำแบบนี้ความคลาดเคลื่อนน้อยลงและย้อนกลับมาตรวจทีหลังได้ง่าย",
    avatar: "⚡",
  },
  {
    name: "สมาชิกที่ส่งคำขอถอนจากหน้าบัญชี",
    role: "ตรวจยอดคงเหลือ ข้อมูลรับเงิน และเงื่อนไขโปรโมชั่นให้ครบ",
    stars: 5,
    tag: "ถอนเป็นขั้นตอน",
    content:
      "ส่งคำขอถอนและดูสถานะได้จากหน้าบัญชีโดยตรง ก่อนกดยืนยันจะไล่เช็กยอดคงเหลือ ข้อมูลรับเงิน และเงื่อนไขโปรโมชั่นให้ครบก่อนเสมอ ถ้ารายการยังดำเนินการอยู่ก็รอผลจากระบบก่อน ไม่ส่งคำขอซ้ำ เพราะระยะเวลาดำเนินการต่างกันไปตามช่องทางและสถานะรายการ",
    avatar: "💳",
  },
  {
    name: "สมาชิกที่กำหนดวงเงินไว้ล่วงหน้า",
    role: "ศึกษาความผันผวน รูปแบบโบนัส และจำนวนเงินต่อรอบก่อนเลือก",
    stars: 4,
    tag: "ยอดนิยมไม่ใช่คำตอบเสมอ",
    content:
      "ความนิยมของเกมช่วยบอกได้แค่ว่าเกมไหนคนสนใจเยอะ ไม่ได้แปลว่าเหมาะกับเราด้วย พอลองอ่านความผันผวน รูปแบบโบนัส และจำนวนเงินต่อรอบก่อนเลือก แล้วตั้งวงเงินไว้ล่วงหน้า ก็คุมค่าใช้จ่ายได้เป็นระบบกว่าเดิม และไม่ต้องไปไล่ตามผลที่เสียไป",
    avatar: "📊",
  },
  {
    name: "สมาชิกที่ติดตามสถานะธุรกรรมทุกครั้ง",
    role: "เก็บเวลา จำนวนเงิน และข้อมูลอ้างอิงไว้สำหรับการตรวจสอบ",
    stars: 5,
    tag: "ตรวจสอบย้อนหลังได้",
    content:
      "หน้าบัญชีทำให้ติดตามรายการฝาก ถอน และข้อมูลที่เกี่ยวข้องได้ในที่เดียว ถ้าเจอรายการที่ดูผิดปกติก็เก็บเวลา จำนวนเงิน และข้อมูลอ้างอิงไว้ก่อนแจ้งทีมงาน ที่สำคัญคือไม่เปิดเผยรหัสผ่านหรือรหัสยืนยันให้ใครไม่ว่ากรณีไหน",
    avatar: "🧭",
  },
];

const totalStars = reviews.reduce((sum, r) => sum + r.stars, 0);
const average = (totalStars / reviews.length).toFixed(1);
---

<section aria-label="เสียงจากสมาชิก BMK289" class="relative z-10 mx-auto mb-12 w-full max-w-[1400px] px-4 font-sans">
  <div class="mb-8 flex w-full flex-col items-center justify-center gap-2 text-center">
    <p class="bg-gradient-to-r from-[#ffe488] via-[#ffcc33] to-[#9dcef0] bg-clip-text text-3xl font-black tracking-widest text-transparent uppercase">
      เสียงจากสมาชิก <span class="text-[#dbe9fb]">BMK289</span>
    </p>
    <div class="mt-2 h-[4px] w-24 rounded-full bg-gradient-to-r from-transparent via-[#2b8cff] to-transparent"></div>
  </div>

  <div class="mx-auto mb-8 flex max-w-md items-center justify-center gap-5 rounded-2xl border border-[#2b8cff]/30 bg-[#08152f]/92 px-6 py-4 shadow-[0_10px_30px_rgba(43,140,255,0.2)] backdrop-blur-xl">
    <div class="flex flex-col items-center">
      <span class="bg-gradient-to-b from-[#ffe488] to-[#ffcc33] bg-clip-text text-4xl leading-none font-black text-transparent">{average}</span>
      <span class="mt-1 text-[10px] font-bold tracking-widest text-[#96abcb] uppercase">คะแนนเฉลี่ย</span>
    </div>
    <div class="h-12 w-px bg-[#2b8cff]/35"></div>
    <div class="flex flex-col gap-1.5">
      <div aria-hidden="true" class="flex gap-1 text-lg">
        {Array.from({ length: 5 }).map((_, i) => <span class={i < Math.round(Number(average)) ? "text-[#ffcc33]" : "text-[#0d2350]"}>★</span>)}
      </div>
      <span class="text-xs font-bold text-[#96abcb]">คะแนนเฉลี่ย {average} จาก 5 ดาว จากการใช้งานจริงของสมาชิก {reviews.length} ด้าน</span>
    </div>
  </div>

  <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
    {
      reviews.map((review) => (
        <article class="group relative isolate flex flex-col gap-4 overflow-hidden rounded-2xl border border-[#2b8cff]/30 bg-[#08152f]/92 p-6 text-left shadow-[0_10px_30px_rgba(43,140,255,0.2)] backdrop-blur-xl transition-all duration-300 hover:-translate-y-1 hover:border-[#5eb0ff]/60 hover:shadow-[0_15px_40px_rgba(43,140,255,0.3)]">
          <span class="absolute inset-y-0 left-0 -z-10 w-1 bg-gradient-to-b from-[#ffe488] to-[#2b8cff] opacity-80 transition-opacity duration-300 group-hover:opacity-100" />
          <span class="pointer-events-none absolute -top-14 -right-14 -z-10 h-32 w-32 rounded-full bg-[#0d2350]/70 blur-[50px] transition-all duration-300 group-hover:bg-[#2b8cff]/35" />

          <div class="flex items-center justify-between gap-3">
            <span class="inline-flex items-center gap-1.5 rounded-full border border-[#2b8cff]/30 bg-[#02081c] px-3 py-1 text-[10px] font-bold tracking-widest text-[#9dcef0] uppercase">
              <span class="h-1.5 w-1.5 animate-pulse rounded-full bg-[#ffcc33]" />
              {review.tag}
            </span>
            <span class="flex gap-0.5 text-sm">
              <span aria-hidden="true" class="flex gap-0.5">
                {Array.from({ length: 5 }).map((_, i) => (
                  <span class={i < review.stars ? "text-[#ffcc33]" : "text-[#0d2350]"}>★</span>
                ))}
              </span>
              <span class="sr-only">ให้คะแนน {review.stars} จาก 5 ดาว</span>
            </span>
          </div>

          <p class="text-left text-base leading-relaxed text-[#dbe9fb]">{review.content}</p>

          <div class="mt-auto flex items-center gap-3 border-t border-[#2b8cff]/30 pt-4">
            <span
              aria-hidden="true"
              class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl border border-[#ffcc33]/40 bg-gradient-to-br from-[#5eb0ff] via-[#2b8cff] to-[#0d2350] text-xl shadow-inner transition-transform duration-300 group-hover:scale-110">
              {review.avatar}
            </span>
            <span class="flex flex-col">
              <span class="text-sm font-black text-[#dbe9fb] transition-colors group-hover:text-[#9dcef0]">{review.name}</span>
              <span class="text-[10px] font-bold tracking-wider text-[#96abcb] uppercase">{review.role}</span>
            </span>
          </div>
        </article>
      ))
    }
  </div>
</section>
