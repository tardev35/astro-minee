---
// The section title is a <p>, not an <h2> — member voices are chrome, not a
// docx section. The region's accessible name lives on the section's aria-label.
// Names and quotes here are written characters, so no Review/AggregateRating
// JSON-LD is emitted for them anywhere.
const reviews = [
  {
    name: "สมาชิกที่ทำรายการผ่าน True Wallet",
    role: "ตรวจข้อมูล Wallet และจำนวนเงินก่อนกดยืนยันทุกครั้ง",
    stars: 5,
    tag: "ฝากถอนผ่านมือถือสะดวก",
    content:
      "การรองรับ True Wallet ทำให้จัดการรายการผ่านมือถือได้สะดวกขึ้น ก่อนยืนยันจึงเช็กเบอร์หรือข้อมูล Wallet จำนวนเงิน และรายละเอียดบัญชีให้ตรงกันทุกครั้ง แล้วรอให้ระบบแสดงสถานะสำเร็จก่อนทำรายการใหม่ เพื่อลดความคลาดเคลื่อน",
    avatar: "💳",
  },
  {
    name: "สมาชิกที่กำหนดวงเงินไว้ล่วงหน้า",
    role: "อ่านเงื่อนไขโปรโมชั่นก่อนใช้สิทธิ์ทุกครั้ง",
    stars: 5,
    tag: "ไม่มีขั้นต่ำช่วยคุมงบ",
    content:
      "เงื่อนไขไม่มีขั้นต่ำช่วยให้เลือกจำนวนเงินตามงบประมาณของตัวเองได้ง่ายขึ้น แต่ยังต้องดูว่าช่องทางไหนรองรับ และอ่านข้อกำหนดของโปรโมชั่นก่อนทำรายการ การตั้งวงเงินไว้ล่วงหน้าทำให้ควบคุมค่าใช้จ่ายได้เป็นระบบมากกว่าเดิม",
    avatar: "🧾",
  },
  {
    name: "สมาชิกที่ดูข้อมูลเกมก่อนเลือกเล่น",
    role: "เก็บข้อมูลอ้างอิงและเวลาไว้จนธุรกรรมเสร็จสมบูรณ์",
    stars: 4,
    tag: "แตกง่ายต้องดูคู่กับข้อมูลเกม",
    content:
      "ในระบบมีทั้งเกมคลาสสิก เกมโบนัส และเกมธีมใหม่ให้เลือก การไล่ดูกติกา ความผันผวน และรูปแบบการจ่ายก่อนเริ่ม ช่วยให้เลือกได้ตรงกับสไตล์และงบมากกว่าการเลือกจากคำโฆษณา ส่วนสถานะฝากถอนก็ตามได้จากหน้าบัญชี ถ้ายังดำเนินการอยู่ก็รอผลก่อนส่งรายการซ้ำ",
    avatar: "📊",
  },
];

const totalStars = reviews.reduce((sum, r) => sum + r.stars, 0);
const average = (totalStars / reviews.length).toFixed(1);
---

<section aria-label="เสียงจากสมาชิก MAX56" class="relative z-10 mx-auto mb-12 w-full max-w-[1400px] px-4 font-sans">
  <div class="mb-8 flex w-full flex-col items-center justify-center gap-2 text-center">
    <p class="bg-gradient-to-r from-[#ffe9a8] via-[#f5c451] to-[#ff5a66] bg-clip-text text-3xl font-black tracking-widest text-transparent uppercase">
      เสียงจากสมาชิก <span class="text-[#fff5f5]">MAX56</span>
    </p>
    <div class="mt-2 h-[4px] w-24 rounded-full bg-gradient-to-r from-transparent via-[#c10d1e] to-transparent"></div>
  </div>

  <div class="mx-auto mb-8 flex max-w-md items-center justify-center gap-5 rounded-2xl border border-[#c10d1e]/30 bg-[#1a0508]/92 px-6 py-4 shadow-[0_10px_30px_rgba(232,32,47,0.2)] backdrop-blur-xl">
    <div class="flex flex-col items-center">
      <span class="bg-gradient-to-b from-[#ffe9a8] to-[#f5c451] bg-clip-text text-4xl leading-none font-black text-transparent">{average}</span>
      <span class="mt-1 text-[10px] font-bold tracking-widest text-[#f6e4e4]/60 uppercase">คะแนนเฉลี่ย</span>
    </div>
    <div class="h-12 w-px bg-[#c10d1e]/35"></div>
    <div class="flex flex-col gap-1.5">
      <div aria-hidden="true" class="flex gap-1 text-lg">
        {Array.from({ length: 5 }).map((_, i) => <span class={i < Math.round(Number(average)) ? "text-[#f5c451]" : "text-[#3d0106]"}>★</span>)}
      </div>
      <span class="text-xs font-bold text-[#f6e4e4]/75">คะแนนเฉลี่ย {average} จาก 5 ดาว จากการใช้งานจริงของสมาชิก {reviews.length} ด้าน</span>
    </div>
  </div>

  <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
    {
      reviews.map((review) => (
        <article class="group relative isolate flex flex-col gap-4 overflow-hidden rounded-2xl border border-[#c10d1e]/30 bg-[#1a0508]/92 p-6 text-left shadow-[0_10px_30px_rgba(232,32,47,0.2)] backdrop-blur-xl transition-all duration-300 hover:-translate-y-1 hover:border-[#e8202f]/60 hover:shadow-[0_15px_40px_rgba(193,13,30,0.3)]">
          <span class="absolute inset-y-0 left-0 -z-10 w-1 bg-gradient-to-b from-[#ffe9a8] to-[#c10d1e] opacity-80 transition-opacity duration-300 group-hover:opacity-100" />
          <span class="pointer-events-none absolute -top-14 -right-14 -z-10 h-32 w-32 rounded-full bg-[#3d0106]/70 blur-[50px] transition-all duration-300 group-hover:bg-[#c10d1e]/35" />

          <div class="flex items-center justify-between gap-3">
            <span class="inline-flex items-center gap-1.5 rounded-full border border-[#c10d1e]/30 bg-[#0d0204] px-3 py-1 text-[10px] font-bold tracking-widest text-[#ff5a66] uppercase">
              <span class="h-1.5 w-1.5 animate-pulse rounded-full bg-[#f5c451]" />
              {review.tag}
            </span>
            <span class="flex gap-0.5 text-sm">
              <span aria-hidden="true" class="flex gap-0.5">
                {Array.from({ length: 5 }).map((_, i) => (
                  <span class={i < review.stars ? "text-[#f5c451]" : "text-[#3d0106]"}>★</span>
                ))}
              </span>
              <span class="sr-only">ให้คะแนน {review.stars} จาก 5 ดาว</span>
            </span>
          </div>

          <p class="text-left text-base leading-relaxed text-[#f6e4e4]">{review.content}</p>

          <div class="mt-auto flex items-center gap-3 border-t border-[#c10d1e]/30 pt-4">
            <span
              aria-hidden="true"
              class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl border border-[#f5c451]/40 bg-gradient-to-br from-[#e8202f] via-[#c10d1e] to-[#3d0106] text-xl shadow-inner transition-transform duration-300 group-hover:scale-110">
              {review.avatar}
            </span>
            <span class="flex flex-col">
              <span class="text-sm font-black text-[#f6e4e4] transition-colors group-hover:text-[#ff5a66]">{review.name}</span>
              <span class="text-[10px] font-bold tracking-wider text-[#f6e4e4]/60 uppercase">{review.role}</span>
            </span>
          </div>
        </article>
      ))
    }
  </div>
</section>
