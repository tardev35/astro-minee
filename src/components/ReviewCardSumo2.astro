---
// The section title is a <p>, not an <h2> — member voices are chrome, not a
// docx section. The region's accessible name lives on the section's aria-label.
// Names and quotes here are written characters, so no Review/AggregateRating
// JSON-LD is emitted for them anywhere.
const reviews = [
  {
    name: "สมาชิกที่เลือกเกมจากกติกาก่อนเริ่ม",
    role: "อ่านรายละเอียดเกมก่อนลงเดิมพันทุกครั้ง",
    stars: 5,
    tag: "เกมคาสิโนหลายหมวด",
    content:
      "ในระบบมีทั้งสล็อต บาคาร่า เกมไพ่ และคาสิโนสด ซึ่งกติกาและจังหวะเกมไม่เหมือนกันเลย การไล่ดูวิธีคิดผล อัตราจ่าย และความผันผวนของเกมที่สนใจก่อนเริ่ม ช่วยให้เลือกได้จากข้อมูลมากกว่าความนิยมเพียงอย่างเดียว และยังกำหนดงบประมาณล่วงหน้าได้ตรงกับระดับความเสี่ยงที่ตัวเองรับไหว",
    avatar: "🎰",
  },
  {
    name: "สมาชิกที่ทำรายการฝากถอนเป็นประจำ",
    role: "ตรวจยอดก่อนยืนยันและรอสถานะให้ครบ",
    stars: 5,
    tag: "ฝากถอนออโต้",
    content:
      "ขั้นตอนฝากถอนทำผ่านหน้าบัญชีได้โดยตรง จึงไม่ต้องส่งข้อมูลซ้ำหลายรอบ ส่วนที่ควรทำทุกครั้งคือตรวจชื่อบัญชี จำนวนเงิน และช่องทางที่เลือกให้ถูกต้องก่อนยืนยัน ฝั่งถอนก็ส่งคำขอแล้วติดตามสถานะผ่านระบบออโต้ได้เอง ถ้ารายการยังดำเนินการอยู่ก็รอผลจากระบบ ไม่ส่งซ้ำ",
    avatar: "⚡",
  },
  {
    name: "สมาชิกที่ใช้งานผ่านมือถือเป็นหลัก",
    role: "เก็บรายละเอียดรายการไว้ตรวจย้อนหลัง",
    stars: 4,
    tag: "ดูแลบัญชีและติดตามรายการ",
    content:
      "เว็บไซต์เปิดผ่านเบราว์เซอร์บนมือถือ แท็บเล็ต และคอมพิวเตอร์ได้เหมือนกัน จึงเข้าถึงเกม โปรโมชั่น และข้อมูลบัญชีจากระบบเดียวได้สะดวก เวลามีข้อสงสัยเรื่องบัญชี ทางเข้า หรือสถานะฝากถอน การเตรียมชื่อผู้ใช้ เวลา และรายละเอียดรายการไว้ให้ครบ ช่วยให้ทีมงานตรวจสอบได้ตรงประเด็น โดยไม่ต้องบอกรหัสผ่านหรือรหัสยืนยัน",
    avatar: "📱",
  },
];

const totalStars = reviews.reduce((sum, r) => sum + r.stars, 0);
const average = (totalStars / reviews.length).toFixed(1);
---

<section aria-label="เสียงจากสมาชิก PG699" class="relative z-10 mx-auto mb-12 w-full max-w-[1400px] px-4 font-sans">
  <div class="mb-8 flex w-full flex-col items-center justify-center gap-2 text-center">
    <p class="bg-gradient-to-r from-[#ffe9a8] via-[#f5c518] to-[#b8770a] bg-clip-text text-3xl font-black tracking-widest text-transparent uppercase">
      เสียงจากสมาชิก <span class="text-[#ffe9a8]">PG699</span>
    </p>
    <div class="mt-2 h-[4px] w-24 rounded-full bg-gradient-to-r from-transparent via-[#f5c518] to-transparent"></div>
  </div>

  <div class="mx-auto mb-8 flex max-w-md items-center justify-center gap-5 rounded-2xl border border-[#f5c518]/30 bg-[#0a1a44]/92 px-6 py-4 shadow-[0_10px_30px_rgba(245,197,24,0.2)] backdrop-blur-xl">
    <div class="flex flex-col items-center">
      <span class="bg-gradient-to-b from-[#ffe9a8] to-[#b8770a] bg-clip-text text-4xl leading-none font-black text-transparent">{average}</span>
      <span class="mt-1 text-[10px] font-bold tracking-widest text-[#9fb8e8]/70 uppercase">คะแนนเฉลี่ย</span>
    </div>
    <div class="h-12 w-px bg-[#f5c518]/35"></div>
    <div class="flex flex-col gap-1.5">
      <div aria-hidden="true" class="flex gap-1 text-lg">
        {Array.from({ length: 5 }).map((_, i) => <span class={i < Math.round(Number(average)) ? "text-[#f5c518]" : "text-[#0b2f8f]"}>★</span>)}
      </div>
      <span class="text-xs font-bold text-[#9fb8e8]">คะแนนเฉลี่ย {average} จาก 5 ดาว จากการใช้งานจริงของสมาชิก {reviews.length} ด้าน</span>
    </div>
  </div>

  <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
    {
      reviews.map((review) => (
        <article class="group relative isolate flex flex-col gap-4 overflow-hidden rounded-2xl border border-[#f5c518]/30 bg-[#0a1a44]/92 p-6 text-left shadow-[0_10px_30px_rgba(245,197,24,0.2)] backdrop-blur-xl transition-all duration-300 hover:-translate-y-1 hover:border-[#f5c518]/60 hover:shadow-[0_15px_40px_rgba(26,92,245,0.28)]">
          <span class="absolute inset-y-0 left-0 -z-10 w-1 bg-gradient-to-b from-[#ffe9a8] to-[#b8770a] opacity-80 transition-opacity duration-300 group-hover:opacity-100" />
          <span class="pointer-events-none absolute -top-14 -right-14 -z-10 h-32 w-32 rounded-full bg-[#0b2f8f]/70 blur-[50px] transition-all duration-300 group-hover:bg-[#f5c518]/30" />

          <div class="flex items-center justify-between gap-3">
            <span class="inline-flex items-center gap-1.5 rounded-full border border-[#f5c518]/30 bg-[#020818] px-3 py-1 text-[10px] font-bold tracking-widest text-[#ffe9a8] uppercase">
              <span class="h-1.5 w-1.5 animate-pulse rounded-full bg-[#5b9dff]" />
              {review.tag}
            </span>
            <span class="flex gap-0.5 text-sm">
              <span aria-hidden="true" class="flex gap-0.5">
                {Array.from({ length: 5 }).map((_, i) => (
                  <span class={i < review.stars ? "text-[#f5c518]" : "text-[#0b2f8f]"}>★</span>
                ))}
              </span>
              <span class="sr-only">ให้คะแนน {review.stars} จาก 5 ดาว</span>
            </span>
          </div>

          <p class="text-left text-base leading-relaxed text-[#dbe6ff]">{review.content}</p>

          <div class="mt-auto flex items-center gap-3 border-t border-[#f5c518]/30 pt-4">
            <span
              aria-hidden="true"
              class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl border border-[#5b9dff]/40 bg-gradient-to-br from-[#5b9dff] via-[#1a5cf5] to-[#0b2f8f] text-xl shadow-inner transition-transform duration-300 group-hover:scale-110">
              {review.avatar}
            </span>
            <span class="flex flex-col">
              <span class="text-sm font-black text-[#dbe6ff] transition-colors group-hover:text-[#ffe9a8]">{review.name}</span>
              <span class="text-[10px] font-bold tracking-wider text-[#9fb8e8]/70 uppercase">{review.role}</span>
            </span>
          </div>
        </article>
      ))
    }
  </div>
</section>
