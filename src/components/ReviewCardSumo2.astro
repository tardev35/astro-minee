---
const reviews = [
  {
    name: "สมาชิกที่เลือกเกมตามประเภทและค่าย",
    role: "ดูกติกาและอัตราการจ่ายก่อนกดเล่น",
    stars: 5,
    tag: "รวมเกมหลายรูปแบบ",
    content:
      "ในระบบมีทั้งเกมสล็อต เกมไพ่ บาคาร่า รูเล็ต และคาสิโนสดจากหลายค่าย การเลือกตามประเภทหรือความถนัดทำให้ไม่ต้องไล่เปิดทีละหน้า สิ่งที่ใช้แล้วช่วยได้จริงคือเปิดดูกติกา อัตราการจ่าย และเงื่อนไขของแต่ละเกมก่อน แล้วค่อยวางงบประมาณให้เหมาะกับตัวเอง",
    avatar: "🎰",
  },
  {
    name: "สมาชิกที่ทำรายการผ่านระบบออโต้",
    role: "ตรวจยอดก่อนยืนยันและเก็บหลักฐานไว้",
    stars: 5,
    tag: "ฝากถอนออโต้",
    content:
      "ระบบฝากถอนออโต้ทำรายการผ่านหน้าบัญชีได้ด้วยตัวเอง จึงลดขั้นตอนไปได้พอสมควร ส่วนที่ควรทำทุกครั้งคือใช้ข้อมูลที่ตรงกับบัญชีสมัคร ตรวจสอบยอดก่อนยืนยัน และเก็บหลักฐานรายการไว้จนกว่าระบบจะแสดงสถานะสำเร็จ หากพบความล่าช้าค่อยติดต่อทีมงานผ่านช่องทางหลัก",
    avatar: "⚡",
  },
  {
    name: "สมาชิกที่ใช้งานผ่านมือถือเป็นหลัก",
    role: "กำหนดยอดทำรายการตามช่องทางที่รองรับ",
    stars: 4,
    tag: "ไม่มีขั้นต่ำและความปลอดภัย",
    content:
      "เงื่อนไขฝากถอนไม่มีขั้นต่ำช่วยให้กำหนดยอดทำรายการได้ยืดหยุ่นขึ้น แต่ก่อนยืนยันควรตรวจช่องทางที่รองรับ สถานะบัญชี และข้อกำหนดของโปรโมชั่นทุกครั้ง ฝั่งความปลอดภัยควรเข้าสู่ระบบผ่านช่องทางหลัก เลี่ยงเครือข่ายสาธารณะเมื่อทำธุรกรรม และออกจากระบบเมื่อใช้อุปกรณ์ร่วมกับผู้อื่น",
    avatar: "📱",
  },
];

const totalStars = reviews.reduce((sum, r) => sum + r.stars, 0);
const average = (totalStars / reviews.length).toFixed(1);
---

<section aria-label="เสียงจากสมาชิก LCX88" class="relative z-10 mx-auto mb-12 w-full max-w-[1400px] px-4 font-sans">
  <div class="mb-8 flex w-full flex-col items-center justify-center gap-2 text-center">
    <p class="bg-gradient-to-r from-[#ffe08a] via-[#f5c542] to-[#6ea3ff] bg-clip-text text-3xl font-black tracking-widest text-transparent uppercase">
      เสียงจากสมาชิก <span class="text-[#f5c542]">LCX88</span>
    </p>
    <div class="mt-2 h-[4px] w-24 rounded-full bg-gradient-to-r from-transparent via-[#2f6bff] to-transparent"></div>
  </div>

  <div class="mx-auto mb-8 flex max-w-md items-center justify-center gap-5 rounded-2xl border border-[#2f6bff]/30 bg-[#0a1547]/92 px-6 py-4 shadow-[0_10px_30px_rgba(47,107,255,0.2)] backdrop-blur-xl">
    <div class="flex flex-col items-center">
      <span class="bg-gradient-to-b from-[#ffe08a] to-[#c08b1f] bg-clip-text text-4xl leading-none font-black text-transparent">{average}</span>
      <span class="mt-1 text-[10px] font-bold tracking-widest text-[#9db0dd] uppercase">คะแนนเฉลี่ย</span>
    </div>
    <div class="h-12 w-px bg-[#2f6bff]/35"></div>
    <div class="flex flex-col gap-1.5">
      <div aria-hidden="true" class="flex gap-1 text-lg">
        {Array.from({ length: 5 }).map((_, i) => <span class={i < Math.round(Number(average)) ? "text-[#f5c542]" : "text-[#1b3fa8]"}>★</span>)}
      </div>
      <span class="text-xs font-bold text-[#9db0dd]">คะแนนเฉลี่ย {average} จาก 5 ดาว จากการใช้งานจริงของสมาชิก {reviews.length} ด้าน</span>
    </div>
  </div>

  <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
    {
      reviews.map((review) => (
        <article class="group relative isolate flex flex-col gap-4 overflow-hidden rounded-2xl border border-[#2f6bff]/30 bg-[#0a1547]/92 p-6 text-left shadow-[0_10px_30px_rgba(47,107,255,0.2)] backdrop-blur-xl transition-all duration-300 hover:-translate-y-1 hover:border-[#f5c542]/50 hover:shadow-[0_15px_40px_rgba(245,197,66,0.26)]">
          <span class="absolute inset-y-0 left-0 -z-10 w-1 bg-gradient-to-b from-[#ffe08a] to-[#2f6bff] opacity-80 transition-opacity duration-300 group-hover:opacity-100" />
          <span class="pointer-events-none absolute -top-14 -right-14 -z-10 h-32 w-32 rounded-full bg-[#1b3fa8]/55 blur-[50px] transition-all duration-300 group-hover:bg-[#f5c542]/30" />

          <div class="flex items-center justify-between gap-3">
            <span class="inline-flex items-center gap-1.5 rounded-full border border-[#2f6bff]/30 bg-[#040b2e] px-3 py-1 text-[10px] font-bold tracking-widest text-[#6ea3ff] uppercase">
              <span class="h-1.5 w-1.5 animate-pulse rounded-full bg-[#f5c542]" />
              {review.tag}
            </span>
            <span class="flex gap-0.5 text-sm">
              <span aria-hidden="true" class="flex gap-0.5">
                {Array.from({ length: 5 }).map((_, i) => (
                  <span class={i < review.stars ? "text-[#f5c542]" : "text-[#1b3fa8]"}>★</span>
                ))}
              </span>
              <span class="sr-only">ให้คะแนน {review.stars} จาก 5 ดาว</span>
            </span>
          </div>

          <p class="text-left text-base leading-relaxed text-[#d7e3ff]">{review.content}</p>

          <div class="mt-auto flex items-center gap-3 border-t border-[#2f6bff]/30 pt-4">
            <span
              aria-hidden="true"
              class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl border border-[#f5c542]/35 bg-gradient-to-br from-[#ffe08a] via-[#f5c542] to-[#c08b1f] text-xl shadow-inner transition-transform duration-300 group-hover:scale-110">
              {review.avatar}
            </span>
            <span class="flex flex-col">
              <span class="text-sm font-black text-[#d7e3ff] transition-colors group-hover:text-[#ffe08a]">{review.name}</span>
              <span class="text-[10px] font-bold tracking-wider text-[#9db0dd] uppercase">{review.role}</span>
            </span>
          </div>
        </article>
      ))
    }
  </div>
</section>
