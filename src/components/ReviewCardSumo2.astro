---
const reviews = [
  {
    name: "สมาชิกสายสล็อต PG",
    role: "เลือกเกมจากเดิมพันเริ่มต้นและฟีเจอร์โบนัสก่อนกดเล่น",
    stars: 5,
    tag: "สล็อตหลายค่าย",
    content:
      "หมวดสล็อตมีทั้งเกมจาก PG และผู้ให้บริการอีกหลายกลุ่มรวมอยู่ในบัญชีเดียว จึงเลือกเกมได้โดยไม่ต้องสมัครแยกทีละค่าย เวลาเลือกจริงจะเริ่มจากเดิมพันเริ่มต้น ฟีเจอร์โบนัส ความผันผวน และรูปแบบการจ่าย มากกว่าไล่ตามว่าเกมไหนกำลังดัง งบร่างประมาณ 1–10 บาทต่อรอบก็พอเห็นจังหวะเกมแล้ว",
    avatar: "🎰",
  },
  {
    name: "สมาชิกที่เล่นคาสิโนสดและกีฬา",
    role: "ตรวจวงเงินโต๊ะและราคาปัจจุบันก่อนยืนยันทุกครั้ง",
    stars: 5,
    tag: "คาสิโนสดและแทงบอล",
    content:
      "คาสิโนสดเลือกจาก 4 จุดคือ ค่ายเกม วงเงินโต๊ะ ความเร็วรอบ และสถานะเปิดรับเดิมพัน ส่วนฝั่งกีฬาจะแยกตลาดก่อนแข่งกับบอลสดให้ชัดก่อน แล้วค่อยตรวจคู่แข่งขัน ตลาดที่เลือก และราคาปัจจุบัน เกมสดเดินต่อโดยไม่รอคนเปลี่ยนใจ โต๊ะเลือกใหม่ได้ แต่บิลที่ส่งไปแล้วไม่ย้อนกลับมาถามซ้ำ",
    avatar: "🎴",
  },
  {
    name: "สมาชิกที่ใช้กระเป๋าเดียวและระบบออโต้",
    role: "แบ่งงบต่อหมวดก่อน แล้วค่อยเริ่มทำรายการ",
    stars: 4,
    tag: "กระเป๋าเดียวและฝากถอนออโต้",
    content:
      "กระเป๋าเดียวทำให้ยอดเครดิตใช้ร่วมกันได้ทุกหมวด ไม่ต้องโยกเงินจากสล็อตไปคาสิโนหรือเปิดบัญชีใหม่ตอนอยากลองกีฬา ส่วนระบบออโต้ทำรายการเองได้ตลอด 24 ชั่วโมง ฝากราว 5–30 วินาที ถอนราว 1–5 นาที ข้อควรระวังคือระบบรวมยอดให้ แต่ไม่ได้แบ่งงบให้ ถ้าไม่ตั้งกรอบไว้ก่อน กระเป๋าเดียวก็เบาพร้อมกันทุกหมวด",
    avatar: "👛",
  },
];

const totalStars = reviews.reduce((sum, r) => sum + r.stars, 0);
const average = (totalStars / reviews.length).toFixed(1);
---

<section aria-label="เสียงจากสมาชิก MIRACLE55" class="relative z-10 mx-auto mb-12 w-full max-w-[1400px] px-4 font-sans">
  <div class="mb-8 flex w-full flex-col items-center justify-center gap-2 text-center">
    <p class="bg-gradient-to-r from-[#f7d97a] via-[#e8b43a] to-[#a9741c] bg-clip-text text-3xl font-black tracking-widest text-transparent uppercase">
      เสียงจากสมาชิก <span class="text-[#e0b98a]">MIRACLE55</span>
    </p>
    <div class="mt-2 h-[4px] w-24 rounded-full bg-gradient-to-r from-transparent via-[#e8b43a] to-transparent"></div>
  </div>

  <div class="mx-auto mb-8 flex max-w-md items-center justify-center gap-5 rounded-2xl border border-[#e8b43a]/25 bg-[#15110b]/92 px-6 py-4 shadow-[0_10px_30px_rgba(232,180,58,0.18)] backdrop-blur-xl">
    <div class="flex flex-col items-center">
      <span class="bg-gradient-to-b from-[#f7d97a] to-[#a9741c] bg-clip-text text-4xl leading-none font-black text-transparent">{average}</span>
      <span class="mt-1 text-[10px] font-bold tracking-widest text-[#e0b98a] uppercase">คะแนนเฉลี่ย</span>
    </div>
    <div class="h-12 w-px bg-[#3a2e1c]"></div>
    <div class="flex flex-col gap-1.5">
      <div aria-hidden="true" class="flex gap-1 text-lg">
        {Array.from({ length: 5 }).map((_, i) => <span class={i < Math.round(Number(average)) ? "text-[#f7d97a]" : "text-[#3a2e1c]"}>★</span>)}
      </div>
      <span class="text-xs font-bold text-[#e0b98a]">คะแนนเฉลี่ย {average} จาก 5 ดาว จากการใช้งานจริงของสมาชิก {reviews.length} ด้าน</span>
    </div>
  </div>

  <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
    {
      reviews.map((review) => (
        <article class="group relative isolate flex flex-col gap-4 overflow-hidden rounded-2xl border border-[#e8b43a]/25 bg-[#15110b]/92 p-6 text-left shadow-[0_10px_30px_rgba(232,180,58,0.18)] backdrop-blur-xl transition-all duration-300 hover:-translate-y-1 hover:border-[#e8b43a]/50 hover:shadow-[0_15px_40px_rgba(232,180,58,0.3)]">
          <span class="absolute inset-y-0 left-0 -z-10 w-1 bg-gradient-to-b from-[#f7d97a] to-[#a9741c] opacity-80 transition-opacity duration-300 group-hover:opacity-100" />
          <span class="pointer-events-none absolute -top-14 -right-14 -z-10 h-32 w-32 rounded-full bg-[#8a5a28]/40 blur-[50px] transition-all duration-300 group-hover:bg-[#a55a22]/35" />

          <div class="flex items-center justify-between gap-3">
            <span class="inline-flex items-center gap-1.5 rounded-full border border-[#e8b43a]/25 bg-[#0f0c07] px-3 py-1 text-[10px] font-bold tracking-widest text-[#e8b43a] uppercase">
              <span class="h-1.5 w-1.5 animate-pulse rounded-full bg-[#e8b43a]" />
              {review.tag}
            </span>
            <span class="flex gap-0.5 text-sm">
              <span aria-hidden="true" class="flex gap-0.5">
                {Array.from({ length: 5 }).map((_, i) => (
                  <span class={i < review.stars ? "text-[#f7d97a]" : "text-[#3a2e1c]"}>★</span>
                ))}
              </span>
              <span class="sr-only">ให้คะแนน {review.stars} จาก 5 ดาว</span>
            </span>
          </div>

          <p class="text-left text-base leading-relaxed text-[#f4e3c8]">{review.content}</p>

          <div class="mt-auto flex items-center gap-3 border-t border-[#3a2e1c] pt-4">
            <span aria-hidden="true" class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl border border-[#e8b43a]/30 bg-gradient-to-br from-[#f7d97a] via-[#e8b43a] to-[#a9741c] text-xl shadow-inner transition-transform duration-300 group-hover:scale-110">
              {review.avatar}
            </span>
            <span class="flex flex-col">
              <span class="text-sm font-black text-[#f4e3c8] transition-colors group-hover:text-[#f7d97a]">{review.name}</span>
              <span class="text-[10px] font-bold tracking-wider text-[#e0b98a] uppercase">{review.role}</span>
            </span>
          </div>
        </article>
      ))
    }
  </div>
</section>
