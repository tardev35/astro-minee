---
// The section title is a <p>, not an <h2> — member voices are chrome, not a
// docx section. The region's accessible name lives on the section's aria-label.
// Names and quotes here are written characters, so no Review/AggregateRating
// JSON-LD is emitted for them anywhere.
const reviews = [
  {
    name: "สมาชิกที่เลือกเกมจากกติกาก่อนเริ่ม",
    role: "ดูฟีเจอร์ ระดับความเสี่ยง และรูปแบบการจ่ายของแต่ละเกม",
    stars: 5,
    tag: "เลือกเกมตามสไตล์",
    content:
      "ในระบบมีทั้งเกมสล็อตหลายแนวและบาคาร่าหลายรูปแบบ การไล่ดูกติกา ฟีเจอร์ ระดับความเสี่ยง และรูปแบบการจ่ายก่อนกดเข้าเล่น ทำให้ได้ตัวเลือกที่ตรงกับสไตล์ของตัวเองมากกว่าการเลือกตามกระแสอย่างเดียว",
    avatar: "🎰",
  },
  {
    name: "สมาชิกที่เล่นบาคาร่าเป็นหลัก",
    role: "อ่านกติกาและตัวเลือกการเดิมพันให้เข้าใจก่อนลงมือ",
    stars: 5,
    tag: "กติกาชัดเจน",
    content:
      "บาคาร่าเน้นกติกาและตัวเลือกการเดิมพันที่ชัดเจน ต่างจากสล็อตที่มีฟีเจอร์และความผันผวนหลายแบบ พอเข้าใจทั้งสองประเภทก่อนเลือก แล้วกำหนดวงเงินไว้ล่วงหน้า ก็ควบคุมการใช้งานได้เหมาะสมกว่าเดิม",
    avatar: "🃏",
  },
  {
    name: "สมาชิกที่ทำรายการผ่าน True Wallet",
    role: "ตรวจข้อมูล Wallet จำนวนเงิน และชื่อบัญชีก่อนยืนยันทุกครั้ง",
    stars: 5,
    tag: "จัดการบนมือถือ",
    content:
      "True Wallet ช่วยลดขั้นตอนฝากถอนบนมือถือไปได้เยอะ สิ่งที่ยังต้องทำเองคือตรวจข้อมูล Wallet จำนวนเงิน และชื่อบัญชีให้ถูกก่อนกดยืนยัน แล้วรอให้ระบบขึ้นสถานะสำเร็จก่อนค่อยทำรายการใหม่ ความคลาดเคลื่อนจะน้อยลงมาก",
    avatar: "👛",
  },
  {
    name: "สมาชิกที่ส่งรายการจากหน้าบัญชี",
    role: "ตรวจยอดคงเหลือ ข้อมูลรับเงิน และเงื่อนไขโปรโมชั่นให้ครบ",
    stars: 5,
    tag: "ฝากถอนเป็นขั้นตอน",
    content:
      "ส่งรายการฝากหรือถอนและติดตามสถานะได้จากหน้าบัญชีโดยตรง ก่อนกดยืนยันจะไล่เช็กยอดคงเหลือ ข้อมูลรับเงิน และเงื่อนไขโปรโมชั่นให้ครบก่อนเสมอ ถ้ารายการยังอยู่ระหว่างดำเนินการก็รอผลจากระบบก่อน ไม่ส่งซ้ำ",
    avatar: "💳",
  },
  {
    name: "สมาชิกที่ตรวจสอบรายการทุกครั้ง",
    role: "เก็บเวลา จำนวนเงิน และข้อมูลอ้างอิงไว้สำหรับการตรวจสอบ",
    stars: 4,
    tag: "ตรวจสอบย้อนหลังได้",
    content:
      "ดูข้อมูลบัญชี โปรโมชั่น และสถานะธุรกรรมได้จากระบบในที่เดียว ถ้าเจอรายการที่ดูผิดปกติก็เก็บเวลา จำนวนเงิน และข้อมูลอ้างอิงไว้ก่อนแจ้งทีมงาน ที่สำคัญคือไม่เปิดเผยรหัสผ่านหรือรหัสยืนยันให้ใครไม่ว่ากรณีไหน",
    avatar: "🧭",
  },
];

const totalStars = reviews.reduce((sum, r) => sum + r.stars, 0);
const average = (totalStars / reviews.length).toFixed(1);
---

<section aria-label="เสียงจากสมาชิก LASVEGAS889" class="relative z-10 mx-auto mb-12 w-full max-w-[1400px] px-4 font-sans">
  <div class="mb-8 flex w-full flex-col items-center justify-center gap-2 text-center">
    <p class="bg-gradient-to-r from-[#ffdd7a] via-[#f2b829] to-[#3fdcff] bg-clip-text text-3xl font-black tracking-widest text-transparent uppercase">
      เสียงจากสมาชิก <span class="text-[#e8eefb]">LASVEGAS889</span>
    </p>
    <div class="mt-2 h-[4px] w-24 rounded-full bg-gradient-to-r from-transparent via-[#3fdcff] to-transparent"></div>
  </div>

  <div class="mx-auto mb-8 flex max-w-md items-center justify-center gap-5 rounded-2xl border border-[#1f5ce0]/30 bg-[#0b1740]/92 px-6 py-4 shadow-[0_10px_30px_rgba(31,92,224,0.2)] backdrop-blur-xl">
    <div class="flex flex-col items-center">
      <span class="bg-gradient-to-b from-[#ffdd7a] to-[#f2b829] bg-clip-text text-4xl leading-none font-black text-transparent">{average}</span>
      <span class="mt-1 text-[10px] font-bold tracking-widest text-[#7f96c4] uppercase">คะแนนเฉลี่ย</span>
    </div>
    <div class="h-12 w-px bg-[#1f5ce0]/35"></div>
    <div class="flex flex-col gap-1.5">
      <div aria-hidden="true" class="flex gap-1 text-lg">
        {Array.from({ length: 5 }).map((_, i) => <span class={i < Math.round(Number(average)) ? "text-[#f2b829]" : "text-[#122a63]"}>★</span>)}
      </div>
      <span class="text-xs font-bold text-[#7f96c4]">คะแนนเฉลี่ย {average} จาก 5 ดาว จากการใช้งานจริงของสมาชิก {reviews.length} ด้าน</span>
    </div>
  </div>

  <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
    {
      reviews.map((review) => (
        <article class="group relative isolate flex flex-col gap-4 overflow-hidden rounded-2xl border border-[#1f5ce0]/30 bg-[#0b1740]/92 p-6 text-left shadow-[0_10px_30px_rgba(31,92,224,0.2)] backdrop-blur-xl transition-all duration-300 hover:-translate-y-1 hover:border-[#3fdcff]/60 hover:shadow-[0_15px_40px_rgba(63,220,255,0.3)]">
          <span class="absolute inset-y-0 left-0 -z-10 w-1 bg-gradient-to-b from-[#ffdd7a] to-[#1f5ce0] opacity-80 transition-opacity duration-300 group-hover:opacity-100" />
          <span class="pointer-events-none absolute -top-14 -right-14 -z-10 h-32 w-32 rounded-full bg-[#122a63]/70 blur-[50px] transition-all duration-300 group-hover:bg-[#3fdcff]/30" />

          <div class="flex items-center justify-between gap-3">
            <span class="inline-flex items-center gap-1.5 rounded-full border border-[#1f5ce0]/30 bg-[#050b24] px-3 py-1 text-[10px] font-bold tracking-widest text-[#3fdcff] uppercase">
              <span class="h-1.5 w-1.5 animate-pulse rounded-full bg-[#f2b829]" />
              {review.tag}
            </span>
            <span class="flex gap-0.5 text-sm">
              <span aria-hidden="true" class="flex gap-0.5">
                {Array.from({ length: 5 }).map((_, i) => (
                  <span class={i < review.stars ? "text-[#f2b829]" : "text-[#122a63]"}>★</span>
                ))}
              </span>
              <span class="sr-only">ให้คะแนน {review.stars} จาก 5 ดาว</span>
            </span>
          </div>

          <p class="text-left text-base leading-relaxed text-[#cddcf7]">{review.content}</p>

          <div class="mt-auto flex items-center gap-3 border-t border-[#1f5ce0]/30 pt-4">
            <span
              aria-hidden="true"
              class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl border border-[#f2b829]/40 bg-gradient-to-br from-[#3fdcff] via-[#1f5ce0] to-[#0a1a45] text-xl shadow-inner transition-transform duration-300 group-hover:scale-110">
              {review.avatar}
            </span>
            <span class="flex flex-col">
              <span class="text-sm font-black text-[#cddcf7] transition-colors group-hover:text-[#3fdcff]">{review.name}</span>
              <span class="text-[10px] font-bold tracking-wider text-[#7f96c4] uppercase">{review.role}</span>
            </span>
          </div>
        </article>
      ))
    }
  </div>
</section>
