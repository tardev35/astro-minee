---
// The section title is a <p>, not an <h2> — member voices are chrome, not a
// docx section. The region's accessible name lives on the section's aria-label.
const reviews = [
  {
    name: "สมาชิกที่เลือกเกมจากอัตราจ่ายและความผันผวน",
    role: "อ่านรายละเอียดเกมก่อนเริ่มทุกครั้ง",
    stars: 5,
    tag: "รวมเกมสล็อตหลายสไตล์",
    content:
      "ในระบบมีเกมสล็อตหลายประเภทให้เลือก ทั้งเกมคลาสสิกที่กติกาสั้น เกมที่มีรอบฟีเจอร์โบนัสหลายชั้น และเกมที่มีรูปแบบการจ่ายต่างกัน การค้นหาตามค่าย ธีม หรือสไตล์ที่สนใจทำให้ไม่ต้องไล่เปิดทีละหน้า สิ่งที่ช่วยได้จริงคืออ่านกติกา อัตราจ่าย และความผันผวนของแต่ละเกมก่อน แล้วค่อยเลือกให้เหมาะกับงบประมาณของตัวเอง",
    avatar: "🎰",
  },
  {
    name: "สมาชิกที่ฝากถอนผ่าน Wallet เป็นหลัก",
    role: "ตรวจยอดก่อนยืนยันและรอสถานะให้ครบ",
    stars: 5,
    tag: "ระบบออโต้และ Wallet",
    content:
      "ระบบออโต้ทำรายการผ่านหน้าบัญชีได้ด้วยตัวเอง จึงไม่ต้องส่งข้อมูลซ้ำหลายครั้ง ส่วนที่ควรทำทุกครั้งคือตรวจชื่อบัญชี จำนวนเงิน และสถานะรายการก่อนปิดหน้าเว็บ ถ้ารายการยังดำเนินการอยู่ก็ควรรอผลจากระบบแทนการส่งรายการใหม่ ฝั่ง Wallet ควรใช้ข้อมูลกระเป๋าเงินที่ตรงกับบัญชีสมัคร และเก็บรายละเอียดรายการไว้จนกว่าระบบจะแสดงสถานะสำเร็จ",
    avatar: "👛",
  },
  {
    name: "สมาชิกที่ใช้งานผ่านมือถือเป็นหลัก",
    role: "เปิดผ่านเบราว์เซอร์ได้ทุกอุปกรณ์",
    stars: 4,
    tag: "รองรับหลายอุปกรณ์",
    content:
      "เว็บไซต์เปิดผ่านเบราว์เซอร์บนมือถือ แท็บเล็ต และคอมพิวเตอร์ได้เหมือนกัน จึงเข้าถึงเกม โปรโมชั่น และข้อมูลบัญชีจากหน้าเดียวได้สะดวก แต่ก่อนกรอกข้อมูลควรตรวจช่องทางเข้าให้ถูกต้องทุกครั้ง ฝั่งความปลอดภัยควรใช้อินเทอร์เน็ตที่เสถียร หลีกเลี่ยงเครือข่ายสาธารณะเมื่อทำรายการทางการเงิน และไม่เปิดเผยรหัสผ่านหรือรหัสยืนยันแก่ผู้อื่น",
    avatar: "📱",
  },
];

const totalStars = reviews.reduce((sum, r) => sum + r.stars, 0);
const average = (totalStars / reviews.length).toFixed(1);
---

<section aria-label="เสียงจากสมาชิก AMBPLUS" class="relative z-10 mx-auto mb-12 w-full max-w-[1400px] px-4 font-sans">
  <div class="mb-8 flex w-full flex-col items-center justify-center gap-2 text-center">
    <p class="bg-gradient-to-r from-[#fbf2c4] via-[#ecd48c] to-[#c9a24a] bg-clip-text text-3xl font-black tracking-widest text-transparent uppercase">
      เสียงจากสมาชิก <span class="text-[#fbf2c4]">AMBPLUS</span>
    </p>
    <div class="mt-2 h-[4px] w-24 rounded-full bg-gradient-to-r from-transparent via-[#ecd48c] to-transparent"></div>
  </div>

  <div class="mx-auto mb-8 flex max-w-md items-center justify-center gap-5 rounded-2xl border border-[#ecd48c]/30 bg-[#16110a]/92 px-6 py-4 shadow-[0_10px_30px_rgba(236,212,140,0.2)] backdrop-blur-xl">
    <div class="flex flex-col items-center">
      <span class="bg-gradient-to-b from-[#fbf2c4] to-[#c9a24a] bg-clip-text text-4xl leading-none font-black text-transparent">{average}</span>
      <span class="mt-1 text-[10px] font-bold tracking-widest text-[#8c7a58] uppercase">คะแนนเฉลี่ย</span>
    </div>
    <div class="h-12 w-px bg-[#ecd48c]/35"></div>
    <div class="flex flex-col gap-1.5">
      <div aria-hidden="true" class="flex gap-1 text-lg">
        {Array.from({ length: 5 }).map((_, i) => <span class={i < Math.round(Number(average)) ? "text-[#ecd48c]" : "text-[#3a2d16]"}>★</span>)}
      </div>
      <span class="text-xs font-bold text-[#bfaa85]">คะแนนเฉลี่ย {average} จาก 5 ดาว จากการใช้งานจริงของสมาชิก {reviews.length} ด้าน</span>
    </div>
  </div>

  <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
    {
      reviews.map((review) => (
        <article class="group relative isolate flex flex-col gap-4 overflow-hidden rounded-2xl border border-[#ecd48c]/30 bg-[#16110a]/92 p-6 text-left shadow-[0_10px_30px_rgba(236,212,140,0.2)] backdrop-blur-xl transition-all duration-300 hover:-translate-y-1 hover:border-[#ecd48c]/60 hover:shadow-[0_15px_40px_rgba(201,162,74,0.26)]">
          <span class="absolute inset-y-0 left-0 -z-10 w-1 bg-gradient-to-b from-[#fbf2c4] to-[#c9a24a] opacity-80 transition-opacity duration-300 group-hover:opacity-100" />
          <span class="pointer-events-none absolute -top-14 -right-14 -z-10 h-32 w-32 rounded-full bg-[#6b4e17]/60 blur-[50px] transition-all duration-300 group-hover:bg-[#ecd48c]/30" />

          <div class="flex items-center justify-between gap-3">
            <span class="inline-flex items-center gap-1.5 rounded-full border border-[#ecd48c]/30 bg-[#0a0806] px-3 py-1 text-[10px] font-bold tracking-widest text-[#fbf2c4] uppercase">
              <span class="h-1.5 w-1.5 animate-pulse rounded-full bg-[#c9a24a]" />
              {review.tag}
            </span>
            <span class="flex gap-0.5 text-sm">
              <span aria-hidden="true" class="flex gap-0.5">
                {Array.from({ length: 5 }).map((_, i) => (
                  <span class={i < review.stars ? "text-[#ecd48c]" : "text-[#3a2d16]"}>★</span>
                ))}
              </span>
              <span class="sr-only">ให้คะแนน {review.stars} จาก 5 ดาว</span>
            </span>
          </div>

          <p class="text-left text-base leading-relaxed text-[#efe3c8]">{review.content}</p>

          <div class="mt-auto flex items-center gap-3 border-t border-[#ecd48c]/30 pt-4">
            <span
              aria-hidden="true"
              class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl border border-[#ecd48c]/40 bg-gradient-to-br from-[#c9a24a] via-[#8c6b22] to-[#6b4e17] text-xl shadow-inner transition-transform duration-300 group-hover:scale-110">
              {review.avatar}
            </span>
            <span class="flex flex-col">
              <span class="text-sm font-black text-[#efe3c8] transition-colors group-hover:text-[#fbf2c4]">{review.name}</span>
              <span class="text-[10px] font-bold tracking-wider text-[#8c7a58] uppercase">{review.role}</span>
            </span>
          </div>
        </article>
      ))
    }
  </div>
</section>
