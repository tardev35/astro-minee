---
// The section title is a <p>, not an <h2> — member voices are chrome, not a
// docx section. The region's accessible name lives on the section's aria-label.
// Names and quotes here are written characters, so no Review/AggregateRating
// JSON-LD is emitted for them anywhere.
//
// Every ★ sits inside an aria-hidden="true" wrapper and the real score is in the
// sr-only line beside it: U+2605 counts as Extended_Pictographic, so a bare one
// would be read out five times per card.
const reviews = [
  {
    name: "สมาชิกที่เลือกโต๊ะจากวงเงินก่อน",
    role: "ดูขั้นต่ำของโต๊ะและความเร็วของเกมก่อนเข้าเล่นทุกครั้ง",
    stars: 5,
    tag: "เลือกโต๊ะตามงบ",
    content: "โต๊ะบาคาร่ามีให้เลือกหลายรูปแบบตามวงเงินและความเร็วของเกม เลยไล่ดูขั้นต่ำกับตัวเลือกเดิมพันก่อนแล้วค่อยเลือกโต๊ะที่เข้ากับงบที่วางไว้ ไม่ต้องมาปรับวงเงินระหว่างเล่นบ่อย ๆ",
    avatar: "🎴",
  },
  {
    name: "สมาชิกที่อ่านกติกาก่อนลงเดิมพัน",
    role: "เข้าใจวิธีคิดผลของ Banker Player และ Tie ก่อนเริ่ม",
    stars: 5,
    tag: "เริ่มจากกติกา",
    content: "กติกาหลักไม่ซับซ้อน แต่ Banker Player กับ Tie มีอัตราจ่ายและความน่าจะเป็นไม่เท่ากัน เลยไปอ่านวิธีคิดผลกับค่าคอมมิชชันที่เกี่ยวข้องให้เข้าใจก่อน ไม่ตัดสินใจจากรูปแบบผลย้อนหลังอย่างเดียว",
    avatar: "📘",
  },
  {
    name: "สมาชิกที่ทำรายการผ่านหน้าบัญชี",
    role: "ตรวจชื่อบัญชี จำนวนเงิน และข้อมูลรับเงินก่อนกดยืนยัน",
    stars: 5,
    tag: "ตรวจก่อนยืนยัน",
    content:
      "ฝาก ถอน และดูสถานะธุรกรรมทำได้จากหน้าบัญชีตรง ๆ ก่อนกดยืนยันยังไล่ดูชื่อบัญชี จำนวนเงิน และข้อมูลรับเงินให้ครบทุกครั้ง ถ้ารายการเดิมยังขึ้นว่าดำเนินการอยู่ก็รอผลจากระบบก่อน ไม่ส่งรายการใหม่ซ้อนลงไป",
    avatar: "🧾",
  },
  {
    name: "สมาชิกที่ดูจากสิ่งที่ตรวจสอบได้",
    role: "ดูช่องทางเข้า ข้อมูลเกม ขั้นตอนธุรกรรม และการจัดการบัญชี",
    stars: 5,
    tag: "ดูจากระบบจริง",
    content: "คำว่าเว็บตรงเอาไปเทียบกันตรง ๆ ไม่ได้ เลยดูจากรายละเอียดที่เปิดตรวจได้แทน ทั้งช่องทางเข้า ข้อมูลเกม ขั้นตอนธุรกรรม และหน้าจัดการบัญชี แล้วค่อยอ่านเงื่อนไขให้ครบก่อนเริ่มใช้งานจริง",
    avatar: "🔍",
  },
  {
    name: "สมาชิกที่วางงบไว้ก่อนเริ่มทุกครั้ง",
    role: "ตั้งรหัสผ่านไม่ซ้ำกับบริการอื่น และเข้าใช้งานผ่านช่องทางหลัก",
    stars: 4,
    tag: "ดูแลบัญชีตัวเอง",
    content:
      "ที่ยึดไว้เป็นนิสัยคือกำหนดวงเงินกับเวลาไว้ก่อนเริ่ม และไม่เพิ่มเดิมพันเพื่อตามคืนยอดเสีย เพราะแต่ละรอบเป็นผลลัพธ์ที่ไม่แน่นอน ส่วนเรื่องบัญชีก็ตั้งรหัสผ่านไม่ซ้ำกับที่อื่น ไม่ส่งรหัสยืนยันให้ใคร และเลี่ยงเครือข่ายสาธารณะตอนทำรายการ",
    avatar: "🛡️",
  },
];

const totalStars = reviews.reduce((sum, r) => sum + r.stars, 0);
const average = (totalStars / reviews.length).toFixed(1);
---

<section aria-label="เสียงจากสมาชิก HOT189" class="relative z-10 mx-auto mb-12 w-full max-w-[1400px] px-4 font-sans">
  <div class="mb-8 flex w-full flex-col items-center justify-center gap-2 text-center">
    <p class="bg-gradient-to-r from-[#ffe86b] via-[#fcd304] to-[#c99400] bg-clip-text text-3xl font-black tracking-widest text-transparent uppercase">
      เสียงจากสมาชิก <span class="text-[#ffe9cf]">HOT189</span>
    </p>
    <div class="mt-2 h-[4px] w-24 rounded-full bg-gradient-to-r from-transparent via-[#ef2b09] to-transparent"></div>
  </div>

  <div class="mx-auto mb-8 flex max-w-md items-center justify-center gap-5 rounded-2xl border border-[#ef2b09]/35 bg-[#1c0705]/92 px-6 py-4 shadow-[0_10px_30px_rgba(239,43,9,0.22)] backdrop-blur-xl">
    <div class="flex flex-col items-center">
      <span class="bg-gradient-to-b from-[#ffe86b] to-[#fcd304] bg-clip-text text-4xl leading-none font-black text-transparent">{average}</span>
      <span class="mt-1 text-[10px] font-bold tracking-widest text-[#d9ac86] uppercase">คะแนนเฉลี่ย</span>
    </div>
    <div class="h-12 w-px bg-[#ef2b09]/40"></div>
    <div class="flex flex-col gap-1.5">
      <div aria-hidden="true" class="flex gap-1 text-lg">
        {Array.from({ length: 5 }).map((_, i) => <span class={i < Math.round(Number(average)) ? "text-[#fcd304]" : "text-[#2e100a]"}>★</span>)}
      </div>
      <span class="text-xs font-bold text-[#d9ac86]">คะแนนเฉลี่ย {average} จาก 5 ดาว จากการใช้งานจริงของสมาชิก {reviews.length} ด้าน</span>
    </div>
  </div>

  <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
    {
      reviews.map((review) => (
        <article class="group relative isolate flex flex-col gap-4 overflow-hidden rounded-2xl border border-[#ef2b09]/35 bg-[#1c0705]/92 p-6 text-left shadow-[0_10px_30px_rgba(239,43,9,0.22)] backdrop-blur-xl transition-all duration-300 hover:-translate-y-1 hover:border-[#fcd304]/60 hover:shadow-[0_15px_40px_rgba(252,211,4,0.28)]">
          <span class="absolute inset-y-0 left-0 -z-10 w-1 bg-gradient-to-b from-[#ffe86b] to-[#c99400] opacity-80 transition-opacity duration-300 group-hover:opacity-100" />
          <span class="pointer-events-none absolute -top-14 -right-14 -z-10 h-32 w-32 rounded-full bg-[#8f1505]/70 blur-[50px] transition-all duration-300 group-hover:bg-[#fcd304]/28" />

          <div class="flex items-center justify-between gap-3">
            <span class="inline-flex items-center gap-1.5 rounded-full border border-[#ef2b09]/35 bg-[#0d0402] px-3 py-1 text-[10px] font-bold tracking-widest text-[#ff7a18] uppercase">
              <span aria-hidden="true" class="h-1.5 w-1.5 animate-pulse rounded-full bg-[#fcd304]" />
              {review.tag}
            </span>
            <span class="flex gap-0.5 text-sm">
              <span aria-hidden="true" class="flex gap-0.5">
                {Array.from({ length: 5 }).map((_, i) => (
                  <span class={i < review.stars ? "text-[#fcd304]" : "text-[#2e100a]"}>★</span>
                ))}
              </span>
              <span class="sr-only">ให้คะแนน {review.stars} จาก 5 ดาว</span>
            </span>
          </div>

          <p class="text-left text-base leading-relaxed text-[#ffe9cf]">{review.content}</p>

          <div class="mt-auto flex items-center gap-3 border-t border-[#ef2b09]/35 pt-4">
            <span
              aria-hidden="true"
              class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl border border-[#fcd304]/45 bg-gradient-to-br from-[#ffe86b] via-[#fcd304] to-[#8f1505] text-xl shadow-inner transition-transform duration-300 group-hover:scale-110">
              {review.avatar}
            </span>
            <span class="flex flex-col">
              <span class="text-sm font-black text-[#ffe9cf] transition-colors group-hover:text-[#fcd304]">{review.name}</span>
              <span class="text-[10px] font-bold tracking-wider text-[#d9ac86] uppercase">{review.role}</span>
            </span>
          </div>
        </article>
      ))
    }
  </div>
</section>
