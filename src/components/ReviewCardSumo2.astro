---
// The section title is a <p>, not an <h2> — member voices are chrome, not a
// docx section. The region's accessible name lives on the section's aria-label.
// Names and quotes here are written characters, so no Review/AggregateRating
// JSON-LD is emitted for them anywhere.
const reviews = [
  {
    name: "สมาชิกที่ดูอัตราจ่ายควบคู่กับกติกา",
    role: "อ่านรายละเอียดเกมก่อนเริ่มทุกครั้ง",
    stars: 5,
    tag: "เกมยอดนิยมหลายรูปแบบ",
    content:
      "ในระบบมีเกมหลายประเภทที่รูปแบบการเดิมพันและอัตราจ่ายไม่เหมือนกัน การไล่ดูกติกา วิธีคิดผล และอัตราจ่ายของเกมที่สนใจก่อนเริ่ม ช่วยให้เลือกได้จากข้อมูลมากกว่าความนิยมเพียงอย่างเดียว และยังกำหนดงบประมาณล่วงหน้าได้ตรงกับระดับความเสี่ยงที่ตัวเองรับไหว",
    avatar: "📊",
  },
  {
    name: "สมาชิกที่ทำรายการฝากถอนเป็นประจำ",
    role: "ตรวจยอดก่อนยืนยันและรอสถานะให้ครบ",
    stars: 5,
    tag: "ฝากง่าย ถอนออโต้",
    content:
      "ขั้นตอนฝากทำผ่านหน้าบัญชีได้โดยตรง จึงไม่ต้องส่งข้อมูลซ้ำหลายรอบ ส่วนที่ควรทำทุกครั้งคือตรวจชื่อบัญชี จำนวนเงิน และช่องทางที่เลือกให้ถูกต้องก่อนยืนยัน ฝั่งถอนก็ส่งคำขอแล้วติดตามสถานะผ่านระบบออโต้ได้เอง ถ้ารายการยังดำเนินการอยู่ก็รอผลจากระบบ ไม่ส่งซ้ำ",
    avatar: "⚡",
  },
  {
    name: "สมาชิกที่ใช้งานผ่านมือถือเป็นหลัก",
    role: "เก็บรายละเอียดรายการไว้ตรวจย้อนหลัง",
    stars: 4,
    tag: "ดูแลบัญชีและติดตามรายการ",
    content:
      "เว็บไซต์เปิดผ่านเบราว์เซอร์บนมือถือ แท็บเล็ต และคอมพิวเตอร์ได้เหมือนกัน จึงเข้าถึงเกม โปรโมชั่น และข้อมูลบัญชีจากระบบเดียวได้สะดวก เวลามีข้อสงสัยเรื่องบัญชี ทางเข้า หรือสถานะธุรกรรม การเตรียมชื่อผู้ใช้ เวลา และรายละเอียดรายการไว้ให้ครบ ช่วยให้ทีมงานตรวจสอบได้ตรงประเด็น โดยไม่ต้องบอกรหัสผ่านหรือรหัสยืนยัน",
    avatar: "📱",
  },
];

const totalStars = reviews.reduce((sum, r) => sum + r.stars, 0);
const average = (totalStars / reviews.length).toFixed(1);
---

<section aria-label="เสียงจากสมาชิก HONEY289" class="relative z-10 mx-auto mb-12 w-full max-w-[1400px] px-4 font-sans">
  <div class="mb-8 flex w-full flex-col items-center justify-center gap-2 text-center">
    <p class="bg-gradient-to-r from-[#ffe3a3] via-[#fdbb24] to-[#eb9413] bg-clip-text text-3xl font-black tracking-widest text-transparent uppercase">
      เสียงจากสมาชิก <span class="text-[#ffe3a3]">HONEY289</span>
    </p>
    <div class="mt-2 h-[4px] w-24 rounded-full bg-gradient-to-r from-transparent via-[#fdbb24] to-transparent"></div>
  </div>

  <div class="mx-auto mb-8 flex max-w-md items-center justify-center gap-5 rounded-2xl border border-[#fdbb24]/30 bg-[#2a1206]/92 px-6 py-4 shadow-[0_10px_30px_rgba(253,187,36,0.2)] backdrop-blur-xl">
    <div class="flex flex-col items-center">
      <span class="bg-gradient-to-b from-[#ffe3a3] to-[#eb9413] bg-clip-text text-4xl leading-none font-black text-transparent">{average}</span>
      <span class="mt-1 text-[10px] font-bold tracking-widest text-[#d8bd8e]/70 uppercase">คะแนนเฉลี่ย</span>
    </div>
    <div class="h-12 w-px bg-[#fdbb24]/35"></div>
    <div class="flex flex-col gap-1.5">
      <div aria-hidden="true" class="flex gap-1 text-lg">
        {Array.from({ length: 5 }).map((_, i) => <span class={i < Math.round(Number(average)) ? "text-[#fdbb24]" : "text-[#7a3a02]"}>★</span>)}
      </div>
      <span class="text-xs font-bold text-[#d8bd8e]">คะแนนเฉลี่ย {average} จาก 5 ดาว จากการใช้งานจริงของสมาชิก {reviews.length} ด้าน</span>
    </div>
  </div>

  <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
    {
      reviews.map((review) => (
        <article class="group relative isolate flex flex-col gap-4 overflow-hidden rounded-2xl border border-[#fdbb24]/30 bg-[#2a1206]/92 p-6 text-left shadow-[0_10px_30px_rgba(253,187,36,0.2)] backdrop-blur-xl transition-all duration-300 hover:-translate-y-1 hover:border-[#fdbb24]/60 hover:shadow-[0_15px_40px_rgba(235,148,19,0.26)]">
          <span class="absolute inset-y-0 left-0 -z-10 w-1 bg-gradient-to-b from-[#ffe3a3] to-[#eb9413] opacity-80 transition-opacity duration-300 group-hover:opacity-100" />
          <span class="pointer-events-none absolute -top-14 -right-14 -z-10 h-32 w-32 rounded-full bg-[#7a3a02]/60 blur-[50px] transition-all duration-300 group-hover:bg-[#fdbb24]/30" />

          <div class="flex items-center justify-between gap-3">
            <span class="inline-flex items-center gap-1.5 rounded-full border border-[#fdbb24]/30 bg-[#1a0c03] px-3 py-1 text-[10px] font-bold tracking-widest text-[#ffe3a3] uppercase">
              <span class="h-1.5 w-1.5 animate-pulse rounded-full bg-[#eb9413]" />
              {review.tag}
            </span>
            <span class="flex gap-0.5 text-sm">
              <span aria-hidden="true" class="flex gap-0.5">
                {Array.from({ length: 5 }).map((_, i) => (
                  <span class={i < review.stars ? "text-[#fdbb24]" : "text-[#7a3a02]"}>★</span>
                ))}
              </span>
              <span class="sr-only">ให้คะแนน {review.stars} จาก 5 ดาว</span>
            </span>
          </div>

          <p class="text-left text-base leading-relaxed text-[#fdf0d8]">{review.content}</p>

          <div class="mt-auto flex items-center gap-3 border-t border-[#fdbb24]/30 pt-4">
            <span
              aria-hidden="true"
              class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl border border-[#fdbb24]/40 bg-gradient-to-br from-[#eb9413] via-[#b35303] to-[#7a3a02] text-xl shadow-inner transition-transform duration-300 group-hover:scale-110">
              {review.avatar}
            </span>
            <span class="flex flex-col">
              <span class="text-sm font-black text-[#fdf0d8] transition-colors group-hover:text-[#ffe3a3]">{review.name}</span>
              <span class="text-[10px] font-bold tracking-wider text-[#d8bd8e]/70 uppercase">{review.role}</span>
            </span>
          </div>
        </article>
      ))
    }
  </div>
</section>
