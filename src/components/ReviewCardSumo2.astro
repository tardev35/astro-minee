---
// The section title is a <p>, not an <h2> — member voices are chrome, not a
// docx section. The region's accessible name lives on the section's aria-label.
// Names and quotes here are written characters, so no Review/AggregateRating
// JSON-LD is emitted for them anywhere.
const reviews = [
  {
    name: "สมาชิกที่วางงบไว้ก่อนเริ่มเล่น",
    role: "ตรวจข้อกำหนดของช่องทางฝากถอนก่อนทำรายการทุกครั้ง",
    stars: 5,
    tag: "ไม่กำหนดขั้นต่ำช่วยคุมงบ",
    content:
      "เงื่อนไขไม่กำหนดขั้นต่ำในบางช่องทางทำให้เลือกจำนวนเงินตามงบของตัวเองได้สะดวกขึ้น แต่ยังต้องดูว่าช่องทางไหนรองรับ และอ่านข้อกำหนดของโปรโมชั่นแต่ละรายการให้ครบก่อนทำธุรกรรมจริง การตั้งวงเงินไว้ล่วงหน้าทำให้ควบคุมค่าใช้จ่ายได้เป็นระบบมากกว่าเดิม",
    avatar: "🧾",
  },
  {
    name: "สมาชิกที่เทียบเงื่อนไขโปรโมชั่นก่อนกดรับ",
    role: "ดูยอดที่กำหนด เกมที่เข้าร่วม และเงื่อนไขการถอนร่วมกัน",
    stars: 5,
    tag: "เลือกโปรจากเงื่อนไข",
    content:
      "โปรโมชั่นมีทั้งโบนัสสำหรับสมาชิกใหม่ สิทธิพิเศษตามยอดฝาก และกิจกรรมตามช่วงเวลา การไล่ดูยอดที่กำหนด เกมที่เข้าร่วม และเงื่อนไขการถอนพร้อมกันก่อนกดรับ ช่วยให้เลือกโปรที่สอดคล้องกับงบของตัวเองได้มากกว่าการดูแค่ตัวเลขโบนัส",
    avatar: "🎁",
  },
  {
    name: "สมาชิกที่ดูข้อมูลเกมก่อนเลือกเล่น",
    role: "ติดตามสถานะรายการจากหน้าบัญชีจนกว่าจะเสร็จสมบูรณ์",
    stars: 4,
    tag: "แตกหนักไม่ใช่การรับประกัน",
    content:
      "ในระบบมีทั้งสล็อตคลาสสิก เกมฟีเจอร์โบนัส และเกมธีมสมัยใหม่ให้เลือก การอ่านกติกา ความผันผวน และอัตราจ่ายก่อนเริ่ม ช่วยให้เลือกได้ตรงกับสไตล์และงบมากกว่าการเลือกจากคำโฆษณา ส่วนสถานะฝากถอนก็ติดตามได้จากหน้าบัญชี ถ้ารายการยังดำเนินการอยู่ก็รอผลก่อนส่งรายการใหม่",
    avatar: "📊",
  },
];

const totalStars = reviews.reduce((sum, r) => sum + r.stars, 0);
const average = (totalStars / reviews.length).toFixed(1);
---

<section aria-label="เสียงจากสมาชิก เฮงเฮง888" class="relative z-10 mx-auto mb-12 w-full max-w-[1400px] px-4 font-sans">
  <div class="mb-8 flex w-full flex-col items-center justify-center gap-2 text-center">
    <p class="bg-gradient-to-r from-[#ffdf7a] via-[#f5c518] to-[#9fcf3a] bg-clip-text text-3xl font-black tracking-widest text-transparent uppercase">
      เสียงจากสมาชิก <span class="text-[#e8f3e0]">เฮงเฮง888</span>
    </p>
    <div class="mt-2 h-[4px] w-24 rounded-full bg-gradient-to-r from-transparent via-[#12a34f] to-transparent"></div>
  </div>

  <div class="mx-auto mb-8 flex max-w-md items-center justify-center gap-5 rounded-2xl border border-[#12a34f]/30 bg-[#072b14]/92 px-6 py-4 shadow-[0_10px_30px_rgba(18,163,79,0.2)] backdrop-blur-xl">
    <div class="flex flex-col items-center">
      <span class="bg-gradient-to-b from-[#ffdf7a] to-[#f5c518] bg-clip-text text-4xl leading-none font-black text-transparent">{average}</span>
      <span class="mt-1 text-[10px] font-bold tracking-widest text-[#a7c295] uppercase">คะแนนเฉลี่ย</span>
    </div>
    <div class="h-12 w-px bg-[#12a34f]/35"></div>
    <div class="flex flex-col gap-1.5">
      <div aria-hidden="true" class="flex gap-1 text-lg">
        {Array.from({ length: 5 }).map((_, i) => <span class={i < Math.round(Number(average)) ? "text-[#f5c518]" : "text-[#05461f]"}>★</span>)}
      </div>
      <span class="text-xs font-bold text-[#a7c295]">คะแนนเฉลี่ย {average} จาก 5 ดาว จากการใช้งานจริงของสมาชิก {reviews.length} ด้าน</span>
    </div>
  </div>

  <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
    {
      reviews.map((review) => (
        <article class="group relative isolate flex flex-col gap-4 overflow-hidden rounded-2xl border border-[#12a34f]/30 bg-[#072b14]/92 p-6 text-left shadow-[0_10px_30px_rgba(18,163,79,0.2)] backdrop-blur-xl transition-all duration-300 hover:-translate-y-1 hover:border-[#1fc465]/60 hover:shadow-[0_15px_40px_rgba(18,163,79,0.3)]">
          <span class="absolute inset-y-0 left-0 -z-10 w-1 bg-gradient-to-b from-[#ffdf7a] to-[#12a34f] opacity-80 transition-opacity duration-300 group-hover:opacity-100" />
          <span class="pointer-events-none absolute -top-14 -right-14 -z-10 h-32 w-32 rounded-full bg-[#05461f]/70 blur-[50px] transition-all duration-300 group-hover:bg-[#12a34f]/35" />

          <div class="flex items-center justify-between gap-3">
            <span class="inline-flex items-center gap-1.5 rounded-full border border-[#12a34f]/30 bg-[#03170c] px-3 py-1 text-[10px] font-bold tracking-widest text-[#9fcf3a] uppercase">
              <span class="h-1.5 w-1.5 animate-pulse rounded-full bg-[#f5c518]" />
              {review.tag}
            </span>
            <span class="flex gap-0.5 text-sm">
              <span aria-hidden="true" class="flex gap-0.5">
                {Array.from({ length: 5 }).map((_, i) => (
                  <span class={i < review.stars ? "text-[#f5c518]" : "text-[#05461f]"}>★</span>
                ))}
              </span>
              <span class="sr-only">ให้คะแนน {review.stars} จาก 5 ดาว</span>
            </span>
          </div>

          <p class="text-left text-base leading-relaxed text-[#e8f3e0]">{review.content}</p>

          <div class="mt-auto flex items-center gap-3 border-t border-[#12a34f]/30 pt-4">
            <span
              aria-hidden="true"
              class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl border border-[#f5c518]/40 bg-gradient-to-br from-[#1fc465] via-[#12a34f] to-[#05461f] text-xl shadow-inner transition-transform duration-300 group-hover:scale-110">
              {review.avatar}
            </span>
            <span class="flex flex-col">
              <span class="text-sm font-black text-[#e8f3e0] transition-colors group-hover:text-[#c3e558]">{review.name}</span>
              <span class="text-[10px] font-bold tracking-wider text-[#a7c295] uppercase">{review.role}</span>
            </span>
          </div>
        </article>
      ))
    }
  </div>
</section>
