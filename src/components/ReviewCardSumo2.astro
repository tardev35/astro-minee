---
// The section title is a <p>, not an <h2> — member voices are chrome, not a
// docx section. The region's accessible name lives on the section's aria-label.
// Names and quotes here are written characters, so no Review/AggregateRating
// JSON-LD is emitted for them anywhere.
const reviews = [
  {
    name: "สมาชิกที่เลือกเกมจากกติกาก่อน",
    role: "อ่านตารางการจ่ายและระดับความผันผวนก่อนเริ่ม",
    stars: 5,
    tag: "เลือกเกมได้ตรงสไตล์",
    content:
      "ในระบบมีทั้งสล็อตคลาสสิก เกมโบนัส และเกมธีมสมัยใหม่ให้เลือกตามความสนใจ การไล่ดูกติกา ฟีเจอร์ และระดับความผันผวนของแต่ละเกมก่อนเริ่ม ช่วยให้เลือกได้ตรงกับสไตล์และงบประมาณมากกว่าการเลือกตามกระแสเพียงอย่างเดียว",
    avatar: "🎰",
  },
  {
    name: "สมาชิกที่กำหนดวงเงินไว้ทุกรอบ",
    role: "มองการเล่นเป็นความบันเทิง ไม่ใช่รายได้ประจำ",
    stars: 5,
    tag: "อ่านกติกาให้เข้าใจก่อน",
    content:
      "เกมที่ใช้งานไม่ซับซ้อนช่วยให้เข้าใจสัญลักษณ์ ฟีเจอร์ และรอบโบนัสได้ง่ายขึ้น ก่อนเริ่มจึงควรอ่านตารางการจ่าย ทดลองฟีเจอร์ที่มี และกำหนดวงเงินสำหรับแต่ละรอบไว้ล่วงหน้า เพราะผลของเกมสล็อตไม่แน่นอนและไม่ควรมองเป็นแหล่งรายได้ประจำ",
    avatar: "📘",
  },
  {
    name: "สมาชิกที่ใช้งานผ่านมือถือเป็นหลัก",
    role: "เก็บรายละเอียดรายการไว้ตรวจย้อนหลัง",
    stars: 4,
    tag: "ใช้งานหลายอุปกรณ์และติดต่อทีมงาน",
    content:
      "เว็บไซต์เปิดผ่านเบราว์เซอร์บนมือถือ แท็บเล็ต และคอมพิวเตอร์ได้เหมือนกัน จึงเลือกเกม ตรวจสอบโปรโมชั่น และดูข้อมูลบัญชีจากระบบเดียวได้สะดวก เวลามีข้อสงสัยเรื่องบัญชี ทางเข้า หรือสถานะรายการ การเตรียมชื่อผู้ใช้ เวลา และรายละเอียดปัญหาไว้ให้ครบ ช่วยให้ทีมงานตรวจสอบได้เร็วขึ้น โดยไม่ต้องเปิดเผยรหัสผ่านหรือรหัสยืนยัน",
    avatar: "📱",
  },
];

const totalStars = reviews.reduce((sum, r) => sum + r.stars, 0);
const average = (totalStars / reviews.length).toFixed(1);
---

<section aria-label="เสียงจากสมาชิก AMBKING1234" class="relative z-10 mx-auto mb-12 w-full max-w-[1400px] px-4 font-sans">
  <div class="mb-8 flex w-full flex-col items-center justify-center gap-2 text-center">
    <p class="bg-gradient-to-r from-[#ffe873] via-[#fbd503] to-[#d4ea23] bg-clip-text text-3xl font-black tracking-widest text-transparent uppercase">
      เสียงจากสมาชิก <span class="text-[#f2fbe8]">AMBKING1234</span>
    </p>
    <div class="mt-2 h-[4px] w-24 rounded-full bg-gradient-to-r from-transparent via-[#8fd318] to-transparent"></div>
  </div>

  <div class="mx-auto mb-8 flex max-w-md items-center justify-center gap-5 rounded-2xl border border-[#8fd318]/30 bg-[#08210f]/92 px-6 py-4 shadow-[0_10px_30px_rgba(143,211,24,0.2)] backdrop-blur-xl">
    <div class="flex flex-col items-center">
      <span class="bg-gradient-to-b from-[#ffe873] to-[#fbd503] bg-clip-text text-4xl leading-none font-black text-transparent">{average}</span>
      <span class="mt-1 text-[10px] font-bold tracking-widest text-[#e6f3dd]/60 uppercase">คะแนนเฉลี่ย</span>
    </div>
    <div class="h-12 w-px bg-[#8fd318]/35"></div>
    <div class="flex flex-col gap-1.5">
      <div aria-hidden="true" class="flex gap-1 text-lg">
        {Array.from({ length: 5 }).map((_, i) => <span class={i < Math.round(Number(average)) ? "text-[#fbd503]" : "text-[#0a3d1c]"}>★</span>)}
      </div>
      <span class="text-xs font-bold text-[#e6f3dd]/75">คะแนนเฉลี่ย {average} จาก 5 ดาว จากการใช้งานจริงของสมาชิก {reviews.length} ด้าน</span>
    </div>
  </div>

  <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
    {
      reviews.map((review) => (
        <article class="group relative isolate flex flex-col gap-4 overflow-hidden rounded-2xl border border-[#8fd318]/30 bg-[#08210f]/92 p-6 text-left shadow-[0_10px_30px_rgba(143,211,24,0.2)] backdrop-blur-xl transition-all duration-300 hover:-translate-y-1 hover:border-[#8fd318]/60 hover:shadow-[0_15px_40px_rgba(28,122,47,0.3)]">
          <span class="absolute inset-y-0 left-0 -z-10 w-1 bg-gradient-to-b from-[#ffe873] to-[#8fd318] opacity-80 transition-opacity duration-300 group-hover:opacity-100" />
          <span class="pointer-events-none absolute -top-14 -right-14 -z-10 h-32 w-32 rounded-full bg-[#0a3d1c]/70 blur-[50px] transition-all duration-300 group-hover:bg-[#8fd318]/35" />

          <div class="flex items-center justify-between gap-3">
            <span class="inline-flex items-center gap-1.5 rounded-full border border-[#8fd318]/30 bg-[#04140a] px-3 py-1 text-[10px] font-bold tracking-widest text-[#d4ea23] uppercase">
              <span class="h-1.5 w-1.5 animate-pulse rounded-full bg-[#fbd503]" />
              {review.tag}
            </span>
            <span class="flex gap-0.5 text-sm">
              <span aria-hidden="true" class="flex gap-0.5">
                {Array.from({ length: 5 }).map((_, i) => (
                  <span class={i < review.stars ? "text-[#fbd503]" : "text-[#0a3d1c]"}>★</span>
                ))}
              </span>
              <span class="sr-only">ให้คะแนน {review.stars} จาก 5 ดาว</span>
            </span>
          </div>

          <p class="text-left text-base leading-relaxed text-[#e6f3dd]">{review.content}</p>

          <div class="mt-auto flex items-center gap-3 border-t border-[#8fd318]/30 pt-4">
            <span
              aria-hidden="true"
              class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl border border-[#fbd503]/40 bg-gradient-to-br from-[#8fd318] via-[#1c7a2f] to-[#0a3d1c] text-xl shadow-inner transition-transform duration-300 group-hover:scale-110">
              {review.avatar}
            </span>
            <span class="flex flex-col">
              <span class="text-sm font-black text-[#e6f3dd] transition-colors group-hover:text-[#d4ea23]">{review.name}</span>
              <span class="text-[10px] font-bold tracking-wider text-[#e6f3dd]/60 uppercase">{review.role}</span>
            </span>
          </div>
        </article>
      ))
    }
  </div>
</section>
