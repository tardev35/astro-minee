---
// The section title is a <p>, not an <h2> — member voices are chrome, not a
// docx section. The region's accessible name lives on the section's aria-label.
// Names and quotes here are written characters, so no Review/AggregateRating
// JSON-LD is emitted for them anywhere.
//
// Every ★ sits inside an aria-hidden="true" wrapper and the real score is in the
// sr-only line beside it: U+2605 counts as Extended_Pictographic, so a bare one
// would be read out five times per card.
//
// Each card echoes one docx section of the DIAMOND789 brief — choosing a studio
// from real data, weighing โปรทุนน้อย against withdrawal terms, what ไม่มี
// ขั้นต่ำ actually covers, checking the provider behind a "ลิขสิทธิ์แท้" claim,
// reading RTP with volatility, and แตกดี guaranteeing nothing — so nothing here
// claims more than the brief.
const reviews = [
  {
    name: "สมาชิกที่ดูชื่อค่ายก่อนเลือกเกม",
    role: "ตรวจผู้ให้บริการ ตารางจ่าย และรายละเอียดเกมก่อนเริ่ม",
    stars: 5,
    tag: "เลือกจากข้อมูลจริง",
    content:
      "เลือกเกมจากค่าย ธีม และรูปแบบฟีเจอร์ที่ชอบก่อน แล้วค่อยไล่ดูชื่อผู้ให้บริการ ตารางจ่าย และรายละเอียดเกมประกอบกัน วิธีนี้ตรงกับความชอบมากกว่าตัดสินจากคำว่าเกมลิขสิทธิ์หรือเกมยอดนิยมอย่างเดียว",
    avatar: "💠",
  },
  {
    name: "สมาชิกที่เริ่มจากงบไม่สูง",
    role: "ดูยอดฝาก เกมที่ร่วมรายการ ระยะเวลา และข้อกำหนดการถอน",
    stars: 5,
    tag: "อ่านเงื่อนไขก่อนรับ",
    content:
      "โปรที่ใช้เงินเริ่มต้นไม่สูงช่วยคุมงบได้จริง แต่ต้องดูยอดฝาก เกมที่ร่วมรายการ ระยะเวลา และข้อกำหนดการถอนไปพร้อมกัน เคยเจอโปรที่โบนัสสูงกว่าแต่เงื่อนไขไม่เข้ากับรูปแบบการเล่นของตัวเอง สุดท้ายเลยไม่ได้คุ้มที่สุด",
    avatar: "🏷️",
  },
  {
    name: "สมาชิกที่แยกดูขั้นต่ำทีละส่วน",
    role: "แยกยอดฝาก ยอดถอน และขั้นต่ำของเกมออกจากกัน",
    stars: 4,
    tag: "ตรวจก่อนทำรายการ",
    content:
      "คำว่าไม่มีขั้นต่ำอาจเกี่ยวกับยอดฝาก ยอดถอน หรือขั้นต่ำของเกม ซึ่งไม่จำเป็นต้องเป็นเงื่อนไขเดียวกัน พอไล่อ่านรายละเอียดแต่ละส่วนก่อนทำรายการ ก็กำหนดงบและเลือกช่องทางได้ตรงกับที่ต้องการมากขึ้น",
    avatar: "🧾",
  },
  {
    name: "สมาชิกที่ตรวจแหล่งที่มาของเกม",
    role: "ดูข้อมูลผู้ให้บริการ กติกา และข้อมูลระบบร่วมกัน",
    stars: 5,
    tag: "ไม่ดูจากคำโฆษณา",
    content:
      "ถ้าหน้าเว็บระบุว่าเป็นเกมลิขสิทธิ์แท้ ก็ควรมีข้อมูลผู้ให้บริการหรือรายละเอียดเกมให้เปิดดูได้จริง เลยพิจารณาแหล่งที่มาของเกม กติกา และข้อมูลระบบประกอบกัน ไม่ใช้ข้อความโฆษณาอย่างเดียวเป็นหลักในการประเมิน",
    avatar: "🔎",
  },
  {
    name: "สมาชิกที่อ่าน RTP คู่กับความผันผวน",
    role: "ดูค่าที่ผู้ให้บริการระบุ ฟีเจอร์โบนัส และระดับความเสี่ยง",
    stars: 5,
    tag: "ดูข้อมูลก่อนเล่น",
    content:
      "แทนที่จะเลือกเฉพาะเกมที่โฆษณาว่าแตกดี ก็ดู RTP ที่ผู้ให้บริการระบุ ฟีเจอร์โบนัส และระดับความผันผวนร่วมกัน เกมแต่ละประเภทจ่ายคนละแบบ เลยเลือกวงเงินต่อรอบให้เหมาะกับงบและระดับความเสี่ยงที่รับได้",
    avatar: "📈",
  },
  {
    name: "สมาชิกที่ตั้งวงเงินไว้ล่วงหน้า",
    role: "กำหนดงบก่อนเริ่มและหยุดเมื่อถึงขีดจำกัดที่วางไว้",
    stars: 4,
    tag: "เล่นตามงบที่ตั้งไว้",
    content:
      "คำว่าแตกดีใช้สื่อถึงความน่าสนใจของเกม ไม่ได้แปลว่าจะได้กำไรหรือรางวัลตามคาดทุกครั้ง ผลของเกมสล็อตไม่แน่นอนอยู่แล้ว เลยกำหนดวงเงินไว้ตั้งแต่ก่อนเริ่มและหยุดเมื่อถึงขีดจำกัดที่วางไว้ทุกรอบ",
    avatar: "🎯",
  },
];

const totalStars = reviews.reduce((sum, r) => sum + r.stars, 0);
const average = (totalStars / reviews.length).toFixed(1);
---

<section aria-label="เสียงจากสมาชิก DIAMOND789" class="relative z-10 mx-auto mb-12 w-full max-w-[1400px] px-4 font-sans">
  <div class="mb-8 flex w-full flex-col items-center justify-center gap-2 text-center">
    <p class="bg-gradient-to-r from-[#e8e8ef] via-[#ff5cb8] to-[#f30d8c] bg-clip-text text-3xl font-black tracking-widest text-transparent uppercase">
      เสียงจากสมาชิก <span class="text-[#ff5cb8]">DIAMOND789</span>
    </p>
    <div class="mt-2 h-[4px] w-24 rounded-full bg-gradient-to-r from-transparent via-[#f30d8c] to-transparent"></div>
  </div>

  <div
    class="mx-auto mb-8 flex max-w-md items-center justify-center gap-5 rounded-2xl border border-[#f30d8c]/35 bg-[#1a0d16]/92 px-6 py-4 shadow-[0_10px_30px_rgba(243,13,140,0.22)] backdrop-blur-xl">
    <div class="flex flex-col items-center">
      <span class="bg-gradient-to-b from-[#ffffff] to-[#f30d8c] bg-clip-text text-4xl leading-none font-black text-transparent">{average}</span>
      <span class="mt-1 text-[10px] font-bold tracking-widest text-[#d9b6cc] uppercase">คะแนนเฉลี่ย</span>
    </div>
    <div class="h-12 w-px bg-[#f30d8c]/40"></div>
    <div class="flex flex-col gap-1.5">
      <div aria-hidden="true" class="flex gap-1 text-lg">
        {Array.from({ length: 5 }).map((_, i) => <span class={i < Math.round(Number(average)) ? "text-[#ff5cb8]" : "text-[#3a0a28]"}>★</span>)}
      </div>
      <span class="text-xs font-bold text-[#d9b6cc]">คะแนนเฉลี่ย {average} จาก 5 ดาว จากการใช้งานจริงของสมาชิก {reviews.length} ด้าน</span>
    </div>
  </div>

  <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
    {
      reviews.map((review) => (
        <article class="group relative isolate flex flex-col gap-4 overflow-hidden rounded-2xl border border-[#f30d8c]/35 bg-[#1a0d16]/92 p-6 text-left shadow-[0_10px_30px_rgba(243,13,140,0.22)] backdrop-blur-xl transition-all duration-300 hover:-translate-y-1 hover:border-[#ff5cb8]/60 hover:shadow-[0_15px_40px_rgba(255,92,184,0.28)]">
          <span class="absolute inset-y-0 left-0 -z-10 w-1 bg-gradient-to-b from-[#e8e8ef] to-[#b80568] opacity-80 transition-opacity duration-300 group-hover:opacity-100" />
          <span class="pointer-events-none absolute -top-14 -right-14 -z-10 h-32 w-32 rounded-full bg-[#5c0a33]/50 blur-[50px] transition-all duration-300 group-hover:bg-[#f30d8c]/35" />

          <div class="flex items-center justify-between gap-3">
            <span class="inline-flex items-center gap-1.5 rounded-full border border-[#f30d8c]/35 bg-[#070308] px-3 py-1 text-[10px] font-bold tracking-widest text-[#ff5cb8] uppercase">
              <span aria-hidden="true" class="h-1.5 w-1.5 animate-pulse rounded-full bg-[#f30d8c]" />
              {review.tag}
            </span>
            <span class="flex gap-0.5 text-sm">
              <span aria-hidden="true" class="flex gap-0.5">
                {Array.from({ length: 5 }).map((_, i) => (
                  <span class={i < review.stars ? "text-[#ff5cb8]" : "text-[#3a0a28]"}>★</span>
                ))}
              </span>
              <span class="sr-only">ให้คะแนน {review.stars} จาก 5 ดาว</span>
            </span>
          </div>

          <p class="text-left text-base leading-relaxed text-[#f8e3f0]">{review.content}</p>

          <div class="mt-auto flex items-center gap-3 border-t border-[#f30d8c]/35 pt-4">
            <span
              aria-hidden="true"
              class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl border border-[#ff5cb8]/50 bg-gradient-to-br from-[#ff5cb8] to-[#f30d8c] text-xl shadow-inner transition-transform duration-300 group-hover:scale-110">
              {review.avatar}
            </span>
            <span class="flex flex-col">
              <span class="text-sm font-black text-[#f8e3f0] transition-colors group-hover:text-[#ff5cb8]">{review.name}</span>
              <span class="text-[10px] font-bold tracking-wider text-[#d9b6cc] uppercase">{review.role}</span>
            </span>
          </div>
        </article>
      ))
    }
  </div>
</section>
