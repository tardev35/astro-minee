---
// The section title is a <p>, not an <h2> — member voices are chrome, not a
// docx section. The region's accessible name lives on the section's aria-label.
// Names and quotes here are written characters, so no Review/AggregateRating
// JSON-LD is emitted for them anywhere.
//
// Every ★ sits inside an aria-hidden="true" wrapper and the real score is in the
// sr-only line beside it: U+2605 counts as Extended_Pictographic, so a bare one
// would be read out five times per card.
//
// Each card echoes one section of the JAIDEEJING brief — checking ชื่อหวย
// วันที่ออกรางวัล และเวลาปิดรับ before filling numbers in, splitting a
// multi-number โพย line by line before confirming, reading the อัตราจ่าย the
// system shows for 2 ตัว 3 ตัว and วิ่ง, keeping everything in one account
// instead of switching pages, looking after the account itself, and reading
// "จ่ายไว" against the real status of a submitted โพย — so nothing here claims
// more than the brief.
//
// JAIDEEJING: oxblood cards with gold rules and a gold spine, and the stars,
// tags and scores in the brand gold.
const reviews = [
  {
    name: "สมาชิกที่ตรวจงวดก่อนกรอกเลข",
    role: "ดูชื่อหวย วันที่ออกรางวัล และเวลาปิดรับให้ครบ",
    stars: 5,
    tag: "เลือกให้ตรงงวด",
    content:
      "เลือกประเภทหวยตามรายการและรอบออกรางวัลที่ระบบรองรับ ก่อนกรอกเลขก็ไล่ดูชื่อหวย วันที่ออกรางวัล และเวลาปิดรับให้ครบก่อนทุกครั้ง โดยเฉพาะวันที่ซื้อหลายงวด ถ้าตรงไหนไม่แน่ใจก็ทักทีมงานถามก่อนส่งโพย",
    avatar: "🎫",
  },
  {
    name: "สมาชิกที่แยกตรวจโพยทีละรายการ",
    role: "ดูเลข ประเภทเดิมพัน และจำนวนเงินก่อนกดยืนยัน",
    stars: 5,
    tag: "ตรวจก่อนยืนยัน",
    content:
      "พอเลือกเลขหลายชุดก็แยกตรวจทีละรายการทั้งเลข ประเภทเดิมพัน และจำนวนเงินก่อนกดยืนยัน จัดโพยให้เป็นระเบียบแบบนี้ช่วยลดโอกาสกรอกเลขผิดหรือเลือกงวดไม่ตรงได้เยอะ แล้วเก็บเลขอ้างอิงไว้จนกว่าสถานะจะเสร็จสมบูรณ์",
    avatar: "🧾",
  },
  {
    name: "สมาชิกที่ดูอัตราจ่ายก่อนเลือกรูปแบบ",
    role: "เทียบราคาของเลข 2 ตัว 3 ตัว และเลขวิ่ง",
    stars: 4,
    tag: "ดูราคาก่อน",
    content:
      "อัตราจ่ายต่างกันตามประเภทหวย รูปแบบเดิมพัน และสถานะของเลข เลยดูราคาที่ระบบแสดงก่อนยืนยันทุกครั้ง เพราะเลข 2 ตัว 3 ตัว วิ่ง หรือรูปแบบอื่นมีเงื่อนไขไม่เหมือนกัน ดูล่วงหน้าไว้ทำให้เข้าใจยอดในโพยชัดขึ้น",
    avatar: "💰",
  },
  {
    name: "สมาชิกที่ใช้ระบบเดียวจบทุกขั้นตอน",
    role: "ดูประเภทหวย โพย ผลรางวัล และประวัติรายการในที่เดียว",
    stars: 5,
    tag: "ไม่ต้องสลับหน้า",
    content:
      "รวมประเภทหวย โพย ผลรางวัล โปรโมชั่น และประวัติรายการไว้ในระบบเดียวทำให้ตรวจข้อมูลง่ายขึ้นจริง แต่ก็ยังอ่านกติกาของแต่ละรายการแยกกันอยู่ดี เพราะเวลาเปิดปิด อัตราจ่าย และข้อกำหนดอาจต่างกันในแต่ละงวด",
    avatar: "🗂️",
  },
  {
    name: "สมาชิกที่ดูแลบัญชีเป็นอันดับแรก",
    role: "เข้าจากช่องทางหลักและไม่เปิดเผยรหัสยืนยัน",
    stars: 5,
    tag: "บัญชีปลอดภัย",
    content: "เข้าใช้งานจากช่องทางหลัก ตั้งรหัสผ่านที่คาดเดายาก และไม่บอกรหัส OTP หรือรหัสยืนยันให้ใครเด็ดขาด ตรวจประวัติรายการเป็นระยะ แล้วก็เลี่ยงเครือข่ายสาธารณะตอนจัดการข้อมูลบัญชีหรือทำธุรกรรม",
    avatar: "🔐",
  },
  {
    name: "สมาชิกที่อ่านคำว่าจ่ายไวจากสถานะจริง",
    role: "ตรวจโพยและยอดจากหน้าบัญชีหลังประกาศผล",
    stars: 4,
    tag: "ดูสถานะจริง",
    content:
      "คำว่าจ่ายไวดูจากสถานะรายการในระบบดีกว่า ไม่ตีความว่าเป็นการรับประกันทุกกรณี หลังประกาศผลก็ตรวจโพยกับยอดจากหน้าบัญชี ถ้าสถานะยังไม่อัปเดตก็เก็บเลขอ้างอิงไว้แล้วติดต่อทีมงานให้ช่วยตรวจสอบเพิ่ม",
    avatar: "⏱️",
  },
];

const totalStars = reviews.reduce((sum, r) => sum + r.stars, 0);
const average = (totalStars / reviews.length).toFixed(1);
---

<section aria-label="เสียงจากสมาชิก JAIDEEJING" class="relative z-10 mx-auto mb-12 w-full max-w-[1400px] px-4 font-sans">
  <div class="mb-8 flex w-full flex-col items-center justify-center gap-2 text-center">
    <p class="bg-gradient-to-r from-[#ffe08a] via-[#f5c451] to-[#c8901a] bg-clip-text text-3xl font-black tracking-widest text-transparent uppercase">
      เสียงจากสมาชิก <span class="text-[#f5c451]">JAIDEEJING</span>
    </p>
    <div aria-hidden="true" class="mt-2 h-[4px] w-24 rounded-full bg-gradient-to-r from-transparent via-[#f5c451] to-transparent"></div>
  </div>

  <div
    class="mx-auto mb-8 flex max-w-md items-center justify-center gap-5 rounded-2xl border border-[#f5c451]/40 bg-[#1e0705]/92 px-6 py-4 shadow-[0_10px_30px_rgba(245,196,81,0.22)] backdrop-blur-xl">
    <div class="flex flex-col items-center">
      <span class="bg-gradient-to-b from-[#ffe08a] to-[#c8901a] bg-clip-text text-4xl leading-none font-black text-transparent">{average}</span>
      <span class="mt-1 text-[10px] font-bold tracking-widest text-[#e0c79c] uppercase">คะแนนเฉลี่ย</span>
    </div>
    <div aria-hidden="true" class="h-12 w-px bg-[#8f1a10]/70"></div>
    <div class="flex flex-col gap-1.5">
      <div aria-hidden="true" class="flex gap-1 text-lg">
        {Array.from({ length: 5 }).map((_, i) => <span class={i < Math.round(Number(average)) ? "text-[#f5c451]" : "text-[#3a1008]"}>★</span>)}
      </div>
      <span class="text-xs font-bold text-[#e0c79c]">คะแนนเฉลี่ย {average} จาก 5 ดาว จากการใช้งานจริงของสมาชิก {reviews.length} ด้าน</span>
    </div>
  </div>

  <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
    {
      reviews.map((review) => (
        <article class="group relative isolate flex flex-col gap-4 overflow-hidden rounded-2xl border border-[#f5c451]/35 bg-[#1e0705]/92 p-6 text-left shadow-[0_10px_30px_rgba(245,196,81,0.2)] backdrop-blur-xl transition-all duration-300 hover:-translate-y-1 hover:border-[#f5c451]/70 hover:shadow-[0_15px_40px_rgba(245,196,81,0.3)]">
          <span aria-hidden="true" class="absolute inset-y-0 left-0 -z-10 w-1 bg-gradient-to-b from-[#ffe08a] to-[#c8901a] opacity-80 transition-opacity duration-300 group-hover:opacity-100" />
          <span
            aria-hidden="true"
            class="pointer-events-none absolute -top-14 -right-14 -z-10 h-32 w-32 rounded-full bg-[#8f1a10]/60 blur-[50px] transition-all duration-300 group-hover:bg-[#f5c451]/30"
          />

          <div class="flex items-center justify-between gap-3">
            <span class="inline-flex items-center gap-1.5 rounded-full border border-[#f5c451]/45 bg-[#120403] px-3 py-1 text-[10px] font-bold tracking-widest text-[#ffe08a] uppercase">
              <span aria-hidden="true" class="h-1.5 w-1.5 animate-pulse rounded-full bg-[#f5c451]" />
              {review.tag}
            </span>
            <span class="flex gap-0.5 text-sm">
              <span aria-hidden="true" class="flex gap-0.5">
                {Array.from({ length: 5 }).map((_, i) => (
                  <span class={i < review.stars ? "text-[#f5c451]" : "text-[#3a1008]"}>★</span>
                ))}
              </span>
              <span class="sr-only">ให้คะแนน {review.stars} จาก 5 ดาว</span>
            </span>
          </div>

          <p class="text-left text-base leading-relaxed text-[#f7e4c0]">{review.content}</p>

          <div class="mt-auto flex items-center gap-3 border-t border-[#8f1a10]/60 pt-4">
            <span
              aria-hidden="true"
              class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl border border-[#ffe08a]/50 bg-gradient-to-br from-[#d12027] to-[#8f1a10] text-xl shadow-inner transition-transform duration-300 group-hover:scale-110">
              {review.avatar}
            </span>
            <span class="flex flex-col">
              <span class="text-sm font-black text-[#f7e4c0] transition-colors group-hover:text-[#ffe08a]">{review.name}</span>
              <span class="text-[10px] font-bold tracking-wider text-[#e0c79c] uppercase">{review.role}</span>
            </span>
          </div>
        </article>
      ))
    }
  </div>
</section>
