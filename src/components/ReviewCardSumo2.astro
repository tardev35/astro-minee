---
// The section title is a <p>, not an <h2> — member voices are chrome, not a
// docx section. The region's accessible name lives on the section's aria-label.
// Names and quotes here are written characters, so no Review/AggregateRating
// JSON-LD is emitted for them anywhere.
const reviews = [
  {
    name: "สมาชิกที่เลือกเกมจากฟีเจอร์และความผันผวน",
    role: "อ่านรายละเอียดเกมก่อนเริ่มทุกครั้ง",
    stars: 5,
    tag: "เกมสล็อตหลายสไตล์",
    content:
      "ในระบบมีทั้งสล็อตคลาสสิกที่กติกาสั้น เกมโบนัสที่มีรอบฟรีสปิน และเกมสล็อตธีมใหม่ ๆ ให้เลือกตามความชอบ การพิจารณาจากรูปแบบการเล่น ฟีเจอร์ และระดับความผันผวนก่อนเริ่ม ช่วยให้เลือกเกมที่เหมาะกับงบประมาณและสไตล์ของตัวเองได้ง่ายขึ้น ไม่ต้องไล่เปิดทีละหน้าเพื่อหาแนวที่ถนัด",
    avatar: "🎰",
  },
  {
    name: "สมาชิกที่ทำรายการฝากถอนเป็นประจำ",
    role: "ตรวจยอดก่อนยืนยันและรอสถานะให้ครบ",
    stars: 5,
    tag: "ฝากถอนไวลดเวลารอ",
    content:
      "ระบบธุรกรรมทำรายการผ่านหน้าบัญชีได้โดยตรง จึงไม่ต้องส่งข้อมูลซ้ำหลายรอบ ส่วนที่ควรทำทุกครั้งคือตรวจชื่อบัญชี จำนวนเงิน และสถานะรายการให้ครบถ้วนก่อนปิดหน้าเว็บ ถ้ารายการยังดำเนินการอยู่ก็ควรรอผลจากระบบก่อนทำซ้ำ จะช่วยลดความสับสนเวลาย้อนกลับมาตรวจสอบภายหลัง",
    avatar: "⚡",
  },
  {
    name: "สมาชิกที่ใช้งานผ่านมือถือเป็นหลัก",
    role: "เข้าผ่านช่องทางหลักและออกจากระบบทุกครั้ง",
    stars: 4,
    tag: "ใช้งานปลอดภัยเป็นระบบ",
    content:
      "เว็บไซต์เปิดผ่านเบราว์เซอร์บนมือถือ แท็บเล็ต และคอมพิวเตอร์ได้เหมือนกัน จึงเข้าถึงเกม โปรโมชั่น และข้อมูลบัญชีจากหน้าเดียวได้สะดวก ฝั่งความปลอดภัยควรเข้าผ่านช่องทางหลัก ตั้งรหัสผ่านที่คาดเดายาก ไม่เปิดเผยรหัสยืนยันแก่ผู้อื่น เลี่ยงเครือข่ายสาธารณะเมื่อทำธุรกรรม และออกจากระบบเมื่อใช้อุปกรณ์ของคนอื่น",
    avatar: "📱",
  },
];

const totalStars = reviews.reduce((sum, r) => sum + r.stars, 0);
const average = (totalStars / reviews.length).toFixed(1);
---

<section aria-label="เสียงจากสมาชิก AMB194" class="relative z-10 mx-auto mb-12 w-full max-w-[1400px] px-4 font-sans">
  <div class="mb-8 flex w-full flex-col items-center justify-center gap-2 text-center">
    <p class="bg-gradient-to-r from-[#fff3ae] via-[#f8d441] to-[#d9a520] bg-clip-text text-3xl font-black tracking-widest text-transparent uppercase">
      เสียงจากสมาชิก <span class="text-[#fff3ae]">AMB194</span>
    </p>
    <div class="mt-2 h-[4px] w-24 rounded-full bg-gradient-to-r from-transparent via-[#f8d441] to-transparent"></div>
  </div>

  <div class="mx-auto mb-8 flex max-w-md items-center justify-center gap-5 rounded-2xl border border-[#f8d441]/30 bg-[#150f05]/92 px-6 py-4 shadow-[0_10px_30px_rgba(248,212,65,0.2)] backdrop-blur-xl">
    <div class="flex flex-col items-center">
      <span class="bg-gradient-to-b from-[#fff3ae] to-[#d9a520] bg-clip-text text-4xl leading-none font-black text-transparent">{average}</span>
      <span class="mt-1 text-[10px] font-bold tracking-widest text-[#c9b784]/70 uppercase">คะแนนเฉลี่ย</span>
    </div>
    <div class="h-12 w-px bg-[#f8d441]/35"></div>
    <div class="flex flex-col gap-1.5">
      <div aria-hidden="true" class="flex gap-1 text-lg">
        {Array.from({ length: 5 }).map((_, i) => <span class={i < Math.round(Number(average)) ? "text-[#f8d441]" : "text-[#6d4f06]"}>★</span>)}
      </div>
      <span class="text-xs font-bold text-[#c9b784]">คะแนนเฉลี่ย {average} จาก 5 ดาว จากการใช้งานจริงของสมาชิก {reviews.length} ด้าน</span>
    </div>
  </div>

  <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
    {
      reviews.map((review) => (
        <article class="group relative isolate flex flex-col gap-4 overflow-hidden rounded-2xl border border-[#f8d441]/30 bg-[#150f05]/92 p-6 text-left shadow-[0_10px_30px_rgba(248,212,65,0.2)] backdrop-blur-xl transition-all duration-300 hover:-translate-y-1 hover:border-[#f8d441]/60 hover:shadow-[0_15px_40px_rgba(217,165,32,0.26)]">
          <span class="absolute inset-y-0 left-0 -z-10 w-1 bg-gradient-to-b from-[#fff3ae] to-[#d9a520] opacity-80 transition-opacity duration-300 group-hover:opacity-100" />
          <span class="pointer-events-none absolute -top-14 -right-14 -z-10 h-32 w-32 rounded-full bg-[#6d4f06]/60 blur-[50px] transition-all duration-300 group-hover:bg-[#f8d441]/30" />

          <div class="flex items-center justify-between gap-3">
            <span class="inline-flex items-center gap-1.5 rounded-full border border-[#f8d441]/30 bg-[#0b0806] px-3 py-1 text-[10px] font-bold tracking-widest text-[#fff3ae] uppercase">
              <span class="h-1.5 w-1.5 animate-pulse rounded-full bg-[#d9a520]" />
              {review.tag}
            </span>
            <span class="flex gap-0.5 text-sm">
              <span aria-hidden="true" class="flex gap-0.5">
                {Array.from({ length: 5 }).map((_, i) => (
                  <span class={i < review.stars ? "text-[#f8d441]" : "text-[#6d4f06]"}>★</span>
                ))}
              </span>
              <span class="sr-only">ให้คะแนน {review.stars} จาก 5 ดาว</span>
            </span>
          </div>

          <p class="text-left text-base leading-relaxed text-[#f5ecd6]">{review.content}</p>

          <div class="mt-auto flex items-center gap-3 border-t border-[#f8d441]/30 pt-4">
            <span
              aria-hidden="true"
              class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl border border-[#f8d441]/40 bg-gradient-to-br from-[#d9a520] via-[#8a6205] to-[#6d4f06] text-xl shadow-inner transition-transform duration-300 group-hover:scale-110">
              {review.avatar}
            </span>
            <span class="flex flex-col">
              <span class="text-sm font-black text-[#f5ecd6] transition-colors group-hover:text-[#fff3ae]">{review.name}</span>
              <span class="text-[10px] font-bold tracking-wider text-[#c9b784]/70 uppercase">{review.role}</span>
            </span>
          </div>
        </article>
      ))
    }
  </div>
</section>
