---
const reviews = [
  {
    name: "สมาชิกที่เลือกเกมจากฟีเจอร์และความผันผวน",
    role: "อ่านรายละเอียดเกมก่อนเริ่มทุกครั้ง",
    stars: 5,
    tag: "รวมเกมจากค่ายดัง",
    content:
      "ในระบบมีเกมสล็อตจากหลายค่ายให้เลือก ทั้งแนวคลาสสิกที่กติกาสั้นและเกมวิดีโอที่มีรอบโบนัสหลายชั้น การเลือกตามธีมและรูปแบบการเล่นทำให้ไม่ต้องไล่เปิดทีละหน้า สิ่งที่ช่วยได้จริงคืออ่านรายละเอียดเกม รูปแบบโบนัส และความผันผวนก่อน แล้วค่อยกำหนดวงเงินให้เหมาะกับตัวเอง",
    avatar: "🎰",
  },
  {
    name: "สมาชิกที่ฝากถอนผ่าน True Wallet",
    role: "ตรวจยอดก่อนยืนยันและเก็บหลักฐานไว้",
    stars: 5,
    tag: "ฝากถอนออโต้",
    content:
      "ระบบออโต้ทำรายการผ่านหน้าบัญชีได้ด้วยตัวเอง จึงลดการส่งข้อมูลซ้ำไปได้พอสมควร ส่วนที่ควรทำทุกครั้งคือตรวจข้อมูลวอลเลท จำนวนเงิน และสถานะรายการก่อนปิดหน้าเว็บ ถ้ารายการยังอยู่ระหว่างดำเนินการก็ควรรอผลจากระบบแทนการส่งซ้ำ แล้วเก็บหลักฐานไว้จนกว่าระบบจะแสดงสถานะสำเร็จ",
    avatar: "⚡",
  },
  {
    name: "สมาชิกที่ใช้งานผ่านมือถือเป็นหลัก",
    role: "เปิดผ่านเบราว์เซอร์ได้ทุกอุปกรณ์",
    stars: 4,
    tag: "รองรับมือถือและความปลอดภัย",
    content:
      "เว็บไซต์เปิดผ่านเบราว์เซอร์บนมือถือ แท็บเล็ต และคอมพิวเตอร์ได้เหมือนกัน จึงเลือกเกมและตรวจโปรโมชั่นระหว่างวันได้สะดวก แต่ก่อนกรอกข้อมูลควรตรวจชื่อโดเมนให้ถูกต้องทุกครั้ง ฝั่งความปลอดภัยควรตั้งรหัสผ่านที่ไม่ซ้ำกับบริการอื่น ไม่ส่ง OTP ให้บุคคลใด และออกจากระบบเมื่อใช้อุปกรณ์ที่ไม่ใช่ของตนเอง",
    avatar: "📱",
  },
];

const totalStars = reviews.reduce((sum, r) => sum + r.stars, 0);
const average = (totalStars / reviews.length).toFixed(1);
---

<section aria-label="เสียงจากสมาชิก DUCK36" class="relative z-10 mx-auto mb-12 w-full max-w-[1400px] px-4 font-sans">
  <div class="mb-8 flex w-full flex-col items-center justify-center gap-2 text-center">
    <p class="bg-gradient-to-r from-[#fff8e6] via-[#ffd76a] to-[#d99908] bg-clip-text text-3xl font-black tracking-widest text-transparent uppercase">
      เสียงจากสมาชิก <span class="text-[#f5b70a]">DUCK36</span>
    </p>
    <div class="mt-2 h-[4px] w-24 rounded-full bg-gradient-to-r from-transparent via-[#f5b70a] to-transparent"></div>
  </div>

  <div class="mx-auto mb-8 flex max-w-md items-center justify-center gap-5 rounded-2xl border border-[#f5b70a]/30 bg-[#12100b]/92 px-6 py-4 shadow-[0_10px_30px_rgba(245,183,10,0.2)] backdrop-blur-xl">
    <div class="flex flex-col items-center">
      <span class="bg-gradient-to-b from-[#fff8e6] to-[#d99908] bg-clip-text text-4xl leading-none font-black text-transparent">{average}</span>
      <span class="mt-1 text-[10px] font-bold tracking-widest text-[#efe3c9]/70 uppercase">คะแนนเฉลี่ย</span>
    </div>
    <div class="h-12 w-px bg-[#f5b70a]/35"></div>
    <div class="flex flex-col gap-1.5">
      <div aria-hidden="true" class="flex gap-1 text-lg">
        {Array.from({ length: 5 }).map((_, i) => <span class={i < Math.round(Number(average)) ? "text-[#f5b70a]" : "text-[#a8720a]"}>★</span>)}
      </div>
      <span class="text-xs font-bold text-[#efe3c9]/75">คะแนนเฉลี่ย {average} จาก 5 ดาว จากการใช้งานจริงของสมาชิก {reviews.length} ด้าน</span>
    </div>
  </div>

  <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
    {
      reviews.map((review) => (
        <article class="group relative isolate flex flex-col gap-4 overflow-hidden rounded-2xl border border-[#f5b70a]/30 bg-[#12100b]/92 p-6 text-left shadow-[0_10px_30px_rgba(245,183,10,0.2)] backdrop-blur-xl transition-all duration-300 hover:-translate-y-1 hover:border-[#d99908]/50 hover:shadow-[0_15px_40px_rgba(217,153,8,0.26)]">
          <span class="absolute inset-y-0 left-0 -z-10 w-1 bg-gradient-to-b from-[#ffd76a] to-[#d99908] opacity-80 transition-opacity duration-300 group-hover:opacity-100" />
          <span class="pointer-events-none absolute -top-14 -right-14 -z-10 h-32 w-32 rounded-full bg-[#8a5c07]/55 blur-[50px] transition-all duration-300 group-hover:bg-[#f5b70a]/30" />

          <div class="flex items-center justify-between gap-3">
            <span class="inline-flex items-center gap-1.5 rounded-full border border-[#f5b70a]/30 bg-[#050403] px-3 py-1 text-[10px] font-bold tracking-widest text-[#ffd76a] uppercase">
              <span class="h-1.5 w-1.5 animate-pulse rounded-full bg-[#f5b70a]" />
              {review.tag}
            </span>
            <span class="flex gap-0.5 text-sm">
              <span aria-hidden="true" class="flex gap-0.5">
                {Array.from({ length: 5 }).map((_, i) => (
                  <span class={i < review.stars ? "text-[#f5b70a]" : "text-[#a8720a]"}>★</span>
                ))}
              </span>
              <span class="sr-only">ให้คะแนน {review.stars} จาก 5 ดาว</span>
            </span>
          </div>

          <p class="text-left text-base leading-relaxed text-[#efe3c9]">{review.content}</p>

          <div class="mt-auto flex items-center gap-3 border-t border-[#f5b70a]/30 pt-4">
            <span
              aria-hidden="true"
              class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl border border-[#d99908]/35 bg-gradient-to-br from-[#ffcf4d] via-[#d99908] to-[#8a5c07] text-xl shadow-inner transition-transform duration-300 group-hover:scale-110">
              {review.avatar}
            </span>
            <span class="flex flex-col">
              <span class="text-sm font-black text-[#efe3c9] transition-colors group-hover:text-[#ffd76a]">{review.name}</span>
              <span class="text-[10px] font-bold tracking-wider text-[#efe3c9]/70 uppercase">{review.role}</span>
            </span>
          </div>
        </article>
      ))
    }
  </div>
</section>
