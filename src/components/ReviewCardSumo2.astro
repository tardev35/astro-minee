---
// The section title is a <p>, not an <h2> — member voices are chrome, not a
// docx section. The region's accessible name lives on the section's aria-label.
// Names and quotes here are written characters, so no Review/AggregateRating
// JSON-LD is emitted for them anywhere.
//
// Every ★ sits inside an aria-hidden="true" wrapper and the real score is in the
// sr-only line beside it: U+2605 counts as Extended_Pictographic, so a bare one
// would be read out five times per card.
//
// Each card echoes one section of the TT1BET brief — comparing ฟีเจอร์ อัตราจ่าย
// และวงเงิน across providers before choosing, reading a bonus by ยอดฝากขั้นต่ำ
// เกมที่ร่วมรายการ ระยะเวลา และเงื่อนไขการถอน rather than by credit amount,
// checking ชื่อโปรโมชั่น จำนวนเครดิต และสิทธิ์ที่ใช้ร่วมกันได้ before confirming,
// verifying ชื่อบัญชี จำนวนเงิน และสถานะรายการ before a deposit, reading
// "จ่ายไว" against the real status on the account page, and choosing by RTP
// ความผันผวน และตารางจ่าย instead of by "เกมดัง" — so nothing here claims more
// than the brief.
//
// TT1BET: warm near-black cards with a gold spine and bronze rules, gold light
// on the stars and the score, and ivory body copy.
const reviews = [
  {
    name: "สมาชิกที่เทียบค่ายเกมก่อนเลือกเล่น",
    role: "ดูฟีเจอร์ อัตราจ่าย และวงเงินของแต่ละค่าย",
    stars: 5,
    tag: "ใช้เทียบค่าย",
    content:
      "ในระบบเดียวมีทั้งสล็อต บาคาร่า คาสิโนสด และเกมประเภทอื่นให้เลือก ก่อนเล่นก็ไล่เทียบฟีเจอร์ อัตราจ่าย และวงเงินของแต่ละค่ายก่อน พอมีข้อมูลให้เทียบก็หาเกมที่ตรงกับงบและสไตล์ของตัวเองได้ง่ายขึ้นเยอะ",
    avatar: "⚖️",
  },
  {
    name: "สมาชิกที่ไม่ดูโบนัสจากจำนวนเครดิต",
    role: "อ่านยอดฝากขั้นต่ำ ระยะเวลา และเงื่อนไขการถอน",
    stars: 5,
    tag: "ดูก่อนรับสิทธิ์",
    content:
      "เลิกดูโปรจากจำนวนโบนัสอย่างเดียวแล้ว หันมาดูยอดฝากขั้นต่ำ เกมที่ร่วมรายการ ระยะเวลา และเงื่อนไขการถอนพร้อมกัน บางทีโปรที่เหมาะกับงบและประเภทเกมที่เล่นให้ประโยชน์มากกว่าข้อเสนอที่เครดิตสูงแต่ข้อจำกัดเยอะ",
    avatar: "🎁",
  },
  {
    name: "สมาชิกที่ตรวจสิทธิ์โปรก่อนกดยืนยัน",
    role: "ดูชื่อโปรโมชั่น จำนวนเครดิต และเกมที่รองรับ",
    stars: 5,
    tag: "ตรวจก่อนกดรับ",
    content:
      "ก่อนกดยืนยันก็ตรวจชื่อโปรโมชั่น จำนวนเครดิต เงื่อนไขรับสิทธิ์ และเกมที่รองรับก่อนทุกครั้ง ถ้ามีหลายโปรพร้อมกันก็ดูว่าใช้ร่วมกันได้หรือไม่ ไม่แน่ใจตรงไหนก็ติดต่อทีมงานถามรายละเอียดก่อนรับสิทธิ์",
    avatar: "📋",
  },
  {
    name: "สมาชิกที่เช็กข้อมูลรายการก่อนฝาก",
    role: "ตรวจชื่อบัญชี จำนวนเงิน และสถานะรายการ",
    stars: 4,
    tag: "ตรวจก่อนยืนยัน",
    content:
      "ขั้นตอนฝากสะดวกขึ้นจริง แต่ก่อนยืนยันก็ยังเช็กชื่อบัญชี จำนวนเงิน และสถานะรายการให้ชัดเจนทุกครั้ง ถ้ารายการเดิมยังดำเนินการอยู่ก็รอให้ระบบอัปเดตก่อนค่อยทำรายการใหม่ ช่วยลดโอกาสเกิดรายการซ้ำหรือยอดคลาดเคลื่อน",
    avatar: "🧾",
  },
  {
    name: "สมาชิกที่ดูสถานะจ่ายไวจากหน้าบัญชี",
    role: "เก็บเวลา จำนวนเงิน และเลขอ้างอิงของทุกรายการ",
    stars: 5,
    tag: "ดูสถานะจริง",
    content:
      "ตรวจยอดคงเหลือ ประวัติถอน และสถานะธุรกรรมผ่านหน้าบัญชีเป็นหลัก ถ้ารายการยังไม่สำเร็จก็เก็บเวลา จำนวนเงิน และเลขอ้างอิงไว้ก่อน แล้วค่อยติดต่อทีมงานพร้อมข้อมูลรายการถ้าสถานะไม่อัปเดตตามปกติ",
    avatar: "📜",
  },
  {
    name: "สมาชิกที่เลือกเกมจากข้อมูลจริง",
    role: "ดู RTP ความผันผวน ตารางจ่าย และกติกาของเกม",
    stars: 4,
    tag: "เลือกตามงบ",
    content:
      "ไม่ตัดสินจากคำว่าเกมดังหรือแตกง่ายอีกแล้ว หันมาดู RTP ความผันผวน ตารางจ่าย และกติกาของเกมตามประเภทที่เลือก เพราะแต่ละค่ายมีโครงสร้างความเสี่ยงต่างกัน พอเข้าใจข้อมูลก็กำหนดวงเงินได้เหมาะกับงบมากขึ้น",
    avatar: "📈",
  },
];

const totalStars = reviews.reduce((sum, r) => sum + r.stars, 0);
const average = (totalStars / reviews.length).toFixed(1);
---

<section aria-label="เสียงจากสมาชิก TT1BET" class="relative z-10 mx-auto mb-12 w-full max-w-[1400px] px-4 font-sans">
  <div class="mb-8 flex w-full flex-col items-center justify-center gap-2 text-center">
    <p class="bg-gradient-to-r from-[#fff8d6] via-[#e9c341] to-[#b8862a] bg-clip-text text-3xl font-black tracking-widest text-transparent uppercase">
      เสียงจากสมาชิก <span class="text-[#e9c341]">TT1BET</span>
    </p>
    <div aria-hidden="true" class="mt-2 h-[4px] w-24 rounded-full bg-gradient-to-r from-transparent via-[#e9c341] to-transparent"></div>
  </div>

  <div class="mx-auto mb-8 flex max-w-md items-center justify-center gap-5 rounded-2xl border border-[#e9c341]/40 bg-[#171008]/92 px-6 py-4 shadow-[0_10px_30px_rgba(233,195,65,0.22)] backdrop-blur-xl">
    <div class="flex flex-col items-center">
      <span class="bg-gradient-to-b from-[#fff8d6] to-[#e9c341] bg-clip-text text-4xl leading-none font-black text-transparent">{average}</span>
      <span class="mt-1 text-[10px] font-bold tracking-widest text-[#d8c39a] uppercase">คะแนนเฉลี่ย</span>
    </div>
    <div aria-hidden="true" class="h-12 w-px bg-[#6d4a13]/80"></div>
    <div class="flex flex-col gap-1.5">
      <div aria-hidden="true" class="flex gap-1 text-lg">
        {Array.from({ length: 5 }).map((_, i) => <span class={i < Math.round(Number(average)) ? "text-[#fcf1b0]" : "text-[#241a0d]"}>★</span>)}
      </div>
      <span class="text-xs font-bold text-[#d8c39a]">คะแนนเฉลี่ย {average} จาก 5 ดาว จากการใช้งานจริงของสมาชิก {reviews.length} ด้าน</span>
    </div>
  </div>

  <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
    {
      reviews.map((review) => (
        <article class="group relative isolate flex flex-col gap-4 overflow-hidden rounded-2xl border border-[#e9c341]/35 bg-[#171008]/92 p-6 text-left shadow-[0_10px_30px_rgba(233,195,65,0.2)] backdrop-blur-xl transition-all duration-300 hover:-translate-y-1 hover:border-[#e9c341]/70 hover:shadow-[0_15px_40px_rgba(233,195,65,0.3)]">
          <span aria-hidden="true" class="absolute inset-y-0 left-0 -z-10 w-1 bg-gradient-to-b from-[#fcf1b0] to-[#b8862a] opacity-80 transition-opacity duration-300 group-hover:opacity-100" />
          <span
            aria-hidden="true"
            class="pointer-events-none absolute -top-14 -right-14 -z-10 h-32 w-32 rounded-full bg-[#b8862a]/60 blur-[50px] transition-all duration-300 group-hover:bg-[#e9c341]/30"
          />

          <div class="flex items-center justify-between gap-3">
            <span class="inline-flex items-center gap-1.5 rounded-full border border-[#e9c341]/45 bg-[#0b0805] px-3 py-1 text-[10px] font-bold tracking-widest text-[#fcf1b0] uppercase">
              <span aria-hidden="true" class="h-1.5 w-1.5 animate-pulse rounded-full bg-[#e9c341]" />
              {review.tag}
            </span>
            <span class="flex gap-0.5 text-sm">
              <span aria-hidden="true" class="flex gap-0.5">
                {Array.from({ length: 5 }).map((_, i) => (
                  <span class={i < review.stars ? "text-[#fcf1b0]" : "text-[#241a0d]"}>★</span>
                ))}
              </span>
              <span class="sr-only">ให้คะแนน {review.stars} จาก 5 ดาว</span>
            </span>
          </div>

          <p class="text-left text-base leading-relaxed text-[#f2e7cd]">{review.content}</p>

          <div class="mt-auto flex items-center gap-3 border-t border-[#6d4a13]/80 pt-4">
            <span
              aria-hidden="true"
              class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl border border-[#fcf1b0]/50 bg-gradient-to-br from-[#e9c341] to-[#b8862a] text-xl shadow-inner transition-transform duration-300 group-hover:scale-110">
              {review.avatar}
            </span>
            <span class="flex flex-col">
              <span class="text-sm font-black text-[#f2e7cd] transition-colors group-hover:text-[#fcf1b0]">{review.name}</span>
              <span class="text-[10px] font-bold tracking-wider text-[#d8c39a] uppercase">{review.role}</span>
            </span>
          </div>
        </article>
      ))
    }
  </div>
</section>
