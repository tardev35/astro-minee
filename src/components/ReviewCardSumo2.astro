---
const reviews = [
  {
    name: "สมาชิกที่เลือกเกมจากอัตราจ่ายและความผันผวน",
    role: "อ่านข้อมูลเกมก่อนกดเล่นทุกครั้ง",
    stars: 5,
    tag: "รวมสล็อตหลายรูปแบบ",
    content:
      "ในระบบมีสล็อตหลายรูปแบบจากหลายค่าย ทั้งเกมที่จ่ายบ่อยแต่รางวัลต่อครั้งไม่สูง และเกมผันผวนสูงที่ต้องรอรอบทำเงิน การเลือกตามประเภททำให้ไม่ต้องไล่เปิดทีละหน้า สิ่งที่ช่วยได้จริงคืออ่านกติกา รูปแบบโบนัส และอัตราจ่ายก่อน แล้วค่อยวางงบประมาณให้เหมาะกับตัวเอง",
    avatar: "🎰",
  },
  {
    name: "สมาชิกที่ทำรายการผ่านระบบออโต้",
    role: "ตรวจยอดก่อนยืนยันและเก็บรายละเอียดไว้",
    stars: 5,
    tag: "ฝากถอนออโต้",
    content:
      "ระบบออโต้ทำรายการผ่านหน้าบัญชีได้ด้วยตัวเอง จึงลดการส่งข้อมูลซ้ำไปได้พอสมควร ส่วนที่ควรทำทุกครั้งคือตรวจชื่อบัญชี ยอดเงิน และสถานะรายการก่อนปิดหน้าเว็บ ถ้ารายการยังอยู่ระหว่างดำเนินการก็ไม่ควรกดยืนยันซ้ำ แต่เก็บรายละเอียดไว้ให้ทีมงานตรวจสอบ",
    avatar: "⚡",
  },
  {
    name: "สมาชิกที่ใช้งานผ่านมือถือเป็นหลัก",
    role: "เริ่มตามงบด้วยเงื่อนไขฝากไม่มีขั้นต่ำ",
    stars: 4,
    tag: "ไม่มีขั้นต่ำและความปลอดภัย",
    content:
      "เงื่อนไขฝากไม่มีขั้นต่ำช่วยให้เลือกยอดเริ่มต้นได้ยืดหยุ่นโดยไม่ต้องใช้เงินก้อนใหญ่ แต่ก่อนฝากควรตรวจช่องทางที่รองรับและข้อกำหนดของโปรโมชั่นทุกครั้ง ฝั่งความปลอดภัยควรเข้าผ่านทางเข้าหลัก ตั้งรหัสผ่านที่ไม่ซ้ำกับบริการอื่น และออกจากระบบเมื่อใช้อุปกรณ์ที่ไม่ใช่ของตนเอง",
    avatar: "📱",
  },
];

const totalStars = reviews.reduce((sum, r) => sum + r.stars, 0);
const average = (totalStars / reviews.length).toFixed(1);
---

<section aria-label="เสียงจากสมาชิก TGAZM" class="relative z-10 mx-auto mb-12 w-full max-w-[1400px] px-4 font-sans">
  <div class="mb-8 flex w-full flex-col items-center justify-center gap-2 text-center">
    <p class="bg-gradient-to-r from-[#ffeaa0] via-[#ffd54a] to-[#c6f76a] bg-clip-text text-3xl font-black tracking-widest text-transparent uppercase">
      เสียงจากสมาชิก <span class="text-[#ffd54a]">TGAZM</span>
    </p>
    <div class="mt-2 h-[4px] w-24 rounded-full bg-gradient-to-r from-transparent via-[#a3e635] to-transparent"></div>
  </div>

  <div class="mx-auto mb-8 flex max-w-md items-center justify-center gap-5 rounded-2xl border border-[#a3e635]/30 bg-[#0a2411]/92 px-6 py-4 shadow-[0_10px_30px_rgba(163,230,53,0.2)] backdrop-blur-xl">
    <div class="flex flex-col items-center">
      <span class="bg-gradient-to-b from-[#ffeaa0] to-[#c9911a] bg-clip-text text-4xl leading-none font-black text-transparent">{average}</span>
      <span class="mt-1 text-[10px] font-bold tracking-widest text-[#a9c48c] uppercase">คะแนนเฉลี่ย</span>
    </div>
    <div class="h-12 w-px bg-[#a3e635]/35"></div>
    <div class="flex flex-col gap-1.5">
      <div aria-hidden="true" class="flex gap-1 text-lg">
        {Array.from({ length: 5 }).map((_, i) => <span class={i < Math.round(Number(average)) ? "text-[#ffd54a]" : "text-[#4d7c0f]"}>★</span>)}
      </div>
      <span class="text-xs font-bold text-[#a9c48c]">คะแนนเฉลี่ย {average} จาก 5 ดาว จากการใช้งานจริงของสมาชิก {reviews.length} ด้าน</span>
    </div>
  </div>

  <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
    {
      reviews.map((review) => (
        <article class="group relative isolate flex flex-col gap-4 overflow-hidden rounded-2xl border border-[#a3e635]/30 bg-[#0a2411]/92 p-6 text-left shadow-[0_10px_30px_rgba(163,230,53,0.2)] backdrop-blur-xl transition-all duration-300 hover:-translate-y-1 hover:border-[#ffd54a]/50 hover:shadow-[0_15px_40px_rgba(255,213,74,0.26)]">
          <span class="absolute inset-y-0 left-0 -z-10 w-1 bg-gradient-to-b from-[#ffeaa0] to-[#a3e635] opacity-80 transition-opacity duration-300 group-hover:opacity-100" />
          <span class="pointer-events-none absolute -top-14 -right-14 -z-10 h-32 w-32 rounded-full bg-[#4d7c0f]/55 blur-[50px] transition-all duration-300 group-hover:bg-[#ffd54a]/30" />

          <div class="flex items-center justify-between gap-3">
            <span class="inline-flex items-center gap-1.5 rounded-full border border-[#a3e635]/30 bg-[#04150a] px-3 py-1 text-[10px] font-bold tracking-widest text-[#c6f76a] uppercase">
              <span class="h-1.5 w-1.5 animate-pulse rounded-full bg-[#ffd54a]" />
              {review.tag}
            </span>
            <span class="flex gap-0.5 text-sm">
              <span aria-hidden="true" class="flex gap-0.5">
                {Array.from({ length: 5 }).map((_, i) => (
                  <span class={i < review.stars ? "text-[#ffd54a]" : "text-[#4d7c0f]"}>★</span>
                ))}
              </span>
              <span class="sr-only">ให้คะแนน {review.stars} จาก 5 ดาว</span>
            </span>
          </div>

          <p class="text-left text-base leading-relaxed text-[#e2f3cd]">{review.content}</p>

          <div class="mt-auto flex items-center gap-3 border-t border-[#a3e635]/30 pt-4">
            <span
              aria-hidden="true"
              class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl border border-[#ffd54a]/35 bg-gradient-to-br from-[#ffeaa0] via-[#ffd54a] to-[#c9911a] text-xl shadow-inner transition-transform duration-300 group-hover:scale-110">
              {review.avatar}
            </span>
            <span class="flex flex-col">
              <span class="text-sm font-black text-[#e2f3cd] transition-colors group-hover:text-[#ffeaa0]">{review.name}</span>
              <span class="text-[10px] font-bold tracking-wider text-[#a9c48c] uppercase">{review.role}</span>
            </span>
          </div>
        </article>
      ))
    }
  </div>
</section>
