---
export interface Props {
  title?: string;
  titleleft?: string;
  titleright?: string;
}
const { title, titleleft, titleright } = Astro.props;

// Same badge arithmetic as ContentBoxFloatingBadge, re-measured against this
// brand's real docx H2 ("โปรทุนน้อยช่วยให้เริ่มต้นได้ตามงบประมาณ", 38 chars):
// `absolute -top-6` puts the badge's bottom edge at (badge height - 24px) below
// the card top.
//   mobile  375px viewport -> card 343px wide, badge w-[92%] = ~315px; minus
//           px-4 the text box is ~283px, so the title wraps to 2 lines.
//           text-lg 18px x 1.5 = 27px/line. Budget 3 lines: 81 + py-2.5 (20px)
//           + 2px borders = 105px  ->  81px below the card top, vs pt-32
//           (128px). 47px of daylight.
//   md      text-2xl 24px x 1.5 = 36px/line; badge max-w-2xl leaves a ~608px
//           text box, so the title fits on 1 line. Budget 2 lines: 72 + 20 + 4
//           = 96px  ->  72px below the card top, vs md:pt-28 (112px). 40px of
//           daylight.
// The badge is width-capped (w-[92%] max-w-2xl) and centered, never
// `whitespace-nowrap`. Do not trim the padding and do not re-add nowrap.
---

<section class="my-10 flex w-full justify-center px-4 font-sans">
  <div
    class="relative isolate w-full max-w-7xl rounded-2xl border-2 border-[#f1509b]/30 bg-gradient-to-b from-[#2a0a1b]/95 to-[#0d0207]/95 p-8 pt-32 shadow-[0_10px_30px_rgba(241,80,155,0.18)] md:pt-28">
    <div class="pointer-events-none absolute -right-10 -bottom-16 -z-10 h-40 w-40 rounded-full bg-[#f1509b]/25 blur-[60px]"></div>
    <div class="pointer-events-none absolute -top-16 -left-10 -z-10 h-40 w-40 rounded-full bg-[#fda3cd]/25 blur-[60px]"></div>

    {
      title && (
        <div class="absolute -top-6 left-1/2 w-[92%] max-w-2xl -translate-x-1/2 rounded-lg border-2 border-[#d1176f]/45 bg-[#0d0207] px-4 py-2.5 text-center shadow-[0_10px_30px_rgba(241,80,155,0.22)] sm:px-8">
          <h2 class="bg-gradient-to-r from-[#fda3cd] via-[#f1509b] to-[#b5054f] bg-clip-text text-lg leading-normal font-black tracking-tight text-transparent uppercase sm:text-xl md:text-2xl">
            {title}
          </h2>
        </div>
      )
    }

    <div class="grid grid-cols-1 gap-10 md:grid-cols-[3fr_7fr] md:items-center">
      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#f6e3ee]">
        {titleleft && <h2 class="text-2xl leading-normal font-bold text-[#fda3cd]">{titleleft}</h2>}
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#f6e3ee] md:border-l md:border-[#f1509b]/25 md:pl-10">
        {titleright && <h2 class="text-2xl leading-normal font-bold text-[#fda3cd]">{titleright}</h2>}
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
