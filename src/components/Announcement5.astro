---
// ค่า default ต้องเป็นข้อความของแบรนด์ปัจจุบันเสมอ — หน้าอื่นเรียก <Announcement />
// เปล่าๆ แล้วตกมาใช้ค่านี้ ห้ามขึ้นต้นด้วย emoji เพราะ marquee เรนเดอร์ข้อความซ้ำ
// สองรอบ screen reader จะอ่าน emoji ซ้ำตามไปด้วย และห้ามใส่ชื่อโดเมนลงในข้อความ
// (verify-build.mjs จับ URL นอกโดเมนแล้วทำให้ build แดง)
const {
  message = "PG699 รวบรวมเกมคาสิโนหลายประเภทไว้ในระบบเดียว ทั้งเกมสล็อต บาคาร่า เกมไพ่ และคาสิโนสด เลือกได้ตามกติกา รูปแบบการเดิมพัน และระดับความเสี่ยงที่รับได้ • ระบบฝากถอนออโต้ช่วยลดขั้นตอน ทำรายการผ่านหน้าบัญชีได้เอง ควรตรวจสอบชื่อบัญชีและจำนวนเงินก่อนยืนยันทุกครั้ง • คำว่าแตกง่ายและจ่ายไวทุกยอดเป็นคำโฆษณา ไม่ใช่การรับประกันผลลัพธ์ ควรกำหนดวงเงินและเวลาเล่นก่อนเริ่ม • รองรับมือถือ แท็บเล็ต และคอมพิวเตอร์ พร้อมทีมงานดูแลสมาชิกตลอด 24 ชั่วโมง",
} = Astro.props;
---

<div class="mx-auto w-full max-w-7xl px-4 py-3 font-sans">
  <div class="relative overflow-hidden rounded-md border border-[#f5c518]/45 bg-[#020818] shadow-[0_0_15px_rgba(245,197,24,0.18)]">
    <div class="absolute top-0 -left-4 h-full w-8 -skew-x-12 bg-gradient-to-b from-[#ffe9a8] to-[#b8770a]"></div>
    <div class="absolute top-0 -right-4 h-full w-8 -skew-x-12 bg-[#1a5cf5]/35"></div>

    <div class="flex items-center">
      <div class="relative z-10 flex w-12 shrink-0 items-center justify-center bg-gradient-to-b from-[#ffe9a8] to-[#b8770a] py-2.5">
        <span aria-hidden="true" class="animate-pulse text-lg drop-shadow-[0_0_5px_rgba(2,8,24,0.85)]">🔔</span>
      </div>

      <div class="marquee-container relative flex-1 overflow-hidden py-2.5 pr-6">
        <div class="pointer-events-none absolute top-0 left-0 z-10 h-full w-8 bg-gradient-to-r from-[#020818] to-transparent"></div>
        <div class="pointer-events-none absolute top-0 right-0 z-10 h-full w-12 bg-gradient-to-l from-[#020818] to-transparent"></div>

        <div class="marquee-content inline-block pl-4 text-sm font-bold tracking-wide whitespace-nowrap text-[#ffe9a8]">
          <span class="mr-8 inline-flex items-center gap-2"><span class="h-1.5 w-1.5 rounded-full bg-[#f5c518] shadow-[0_0_5px_rgba(245,197,24,0.85)]"></span>{message}</span>
          <span class="mr-8 inline-flex items-center gap-2"><span class="h-1.5 w-1.5 rounded-full bg-[#f5c518] shadow-[0_0_5px_rgba(245,197,24,0.85)]"></span>{message}</span>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  .marquee-content {
    animation: marquee 25s linear infinite;
  }
  .marquee-container:hover .marquee-content {
    animation-play-state: paused;
  }
  @keyframes marquee {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-50%);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .marquee-content {
      animation: none;
    }
  }
</style>
