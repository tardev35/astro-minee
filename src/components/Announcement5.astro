---
// ค่า default ต้องเป็นข้อความของแบรนด์ปัจจุบันเสมอ — หน้าอื่นเรียก <Announcement />
// เปล่าๆ แล้วตกมาใช้ค่านี้ ห้ามขึ้นต้นด้วย emoji เพราะ marquee เรนเดอร์ข้อความซ้ำ
// สองรอบ screen reader จะอ่าน emoji ซ้ำตามไปด้วย และห้ามใส่ชื่อโดเมนลงในข้อความ
// (verify-build.mjs จับ URL นอกโดเมนแล้วทำให้ build แดง)
const {
  message = "XFINITYPLAY รวมเกมสล็อตยอดนิยมจากหลายค่ายไว้ในระบบเดียว ทั้งสล็อตคลาสสิก วิดีโอสล็อต และเกมโบนัส • ระบบเว็บตรง สมัคร เข้าสู่ระบบ และเลือกเกมได้จากหน้าเดียว • ฝากถอนไม่มีขั้นต่ำตามช่องทางที่เว็บไซต์กำหนด • ควรตรวจกติกา อัตราจ่าย และระดับความผันผวนก่อนเลือกเกมทุกครั้ง",
} = Astro.props;
---

<div class="mx-auto w-full max-w-7xl px-4 py-3 font-sans">
  <div class="relative overflow-hidden rounded-md border border-[#22d3ee]/45 bg-[#0d0a2b] shadow-[0_0_15px_rgba(34,211,238,0.18)]">
    <div class="absolute top-0 -left-4 h-full w-8 -skew-x-12 bg-gradient-to-b from-[#22d3ee] to-[#0891b2]"></div>
    <div class="absolute top-0 -right-4 h-full w-8 -skew-x-12 bg-[#a855f7]/25"></div>

    <div class="flex items-center">
      <div class="relative z-10 flex w-12 shrink-0 items-center justify-center bg-gradient-to-b from-[#22d3ee] to-[#0891b2] py-2.5">
        <span aria-hidden="true" class="animate-pulse text-lg drop-shadow-[0_0_5px_rgba(8,5,32,0.85)]">🔔</span>
      </div>

      <div class="marquee-container relative flex-1 overflow-hidden py-2.5 pr-6">
        <div class="pointer-events-none absolute top-0 left-0 z-10 h-full w-8 bg-gradient-to-r from-[#0d0a2b] to-transparent"></div>
        <div class="pointer-events-none absolute top-0 right-0 z-10 h-full w-12 bg-gradient-to-l from-[#0d0a2b] to-transparent"></div>

        <div class="marquee-content inline-block pl-4 text-sm font-bold tracking-wide whitespace-nowrap text-[#a5f3fc]">
          <span class="mr-8 inline-flex items-center gap-2"><span class="h-1.5 w-1.5 rounded-full bg-[#e879f9] shadow-[0_0_5px_rgba(232,121,249,0.85)]"></span>{message}</span>
          <span class="mr-8 inline-flex items-center gap-2"><span class="h-1.5 w-1.5 rounded-full bg-[#e879f9] shadow-[0_0_5px_rgba(232,121,249,0.85)]"></span>{message}</span>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  .marquee-content {
    animation: marquee 25s linear infinite;
  }
  .marquee-container:hover .marquee-content {
    animation-play-state: paused;
  }
  @keyframes marquee {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-50%);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .marquee-content {
      animation: none;
    }
  }
</style>
