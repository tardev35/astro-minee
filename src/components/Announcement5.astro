---
// ค่า default ต้องเป็นข้อความของแบรนด์ปัจจุบันเสมอ — หน้าอื่นเรียก <Announcement />
// เปล่าๆ แล้วตกมาใช้ค่านี้ ห้ามขึ้นต้นด้วย emoji เพราะ marquee เรนเดอร์ข้อความซ้ำ
// สองรอบ screen reader จะอ่าน emoji ซ้ำตามไปด้วย และห้ามใส่ชื่อโดเมนลงในข้อความ
// (verify-build.mjs จับ URL นอกโดเมนแล้วทำให้ build แดง)
const {
  message = "CHICKYLUCKY รวมเกมสล็อตจากผู้ให้บริการหลายรายไว้ในระบบเดียว เชื่อมต่อผ่าน API ตรง เลือกเกมตามค่าย ธีม หรือรูปแบบฟีเจอร์ได้จากหน้าเดียว • ก่อนเลือกเกมควรตรวจกติกา ตารางการจ่าย และระดับความผันผวนให้เหมาะกับงบและสไตล์การเล่น • คำว่าเกมลิขสิทธิ์แท้ควรพิจารณาจากชื่อผู้ให้บริการและรายละเอียดที่ระบบแสดง ไม่ใช่จากข้อความโฆษณาเพียงอย่างเดียว • ควรตรวจยอดคงเหลือ ประวัติฝากถอน และสถานะรายการจากหน้าบัญชีทุกครั้ง และหลีกเลี่ยงการส่งคำขอซ้ำขณะรายการเดิมยังดำเนินการอยู่ • แตกง่ายจ่ายไวไม่ใช่การรับประกันผล ควรกำหนดวงเงินก่อนเริ่มเล่นทุกครั้ง",
} = Astro.props;
---

<div class="mx-auto w-full max-w-7xl px-4 py-3 font-sans">
  <div class="relative overflow-hidden rounded-md border border-[#fde41a]/45 bg-[#3a0806] shadow-[0_0_15px_rgba(253,228,26,0.18)]">
    <div class="absolute top-0 -left-4 h-full w-8 -skew-x-12 bg-gradient-to-b from-[#e01b24] to-[#6d0202]"></div>
    <div class="absolute top-0 -right-4 h-full w-8 -skew-x-12 bg-[#fde41a]/35"></div>

    <div class="flex items-center">
      <div class="relative z-10 flex w-12 shrink-0 items-center justify-center bg-gradient-to-b from-[#e01b24] to-[#6d0202] py-2.5">
        <span aria-hidden="true" class="animate-pulse text-lg drop-shadow-[0_0_5px_rgba(28,1,0,0.85)]">🔔</span>
      </div>

      <div class="marquee-container relative flex-1 overflow-hidden py-2.5 pr-6">
        <div class="pointer-events-none absolute top-0 left-0 z-10 h-full w-8 bg-gradient-to-r from-[#3a0806] to-transparent"></div>
        <div class="pointer-events-none absolute top-0 right-0 z-10 h-full w-12 bg-gradient-to-l from-[#3a0806] to-transparent"></div>

        <div class="marquee-content inline-block pl-4 text-sm font-bold tracking-wide whitespace-nowrap text-[#fdf3d8]">
          <span class="mr-8 inline-flex items-center gap-2"><span class="h-1.5 w-1.5 rounded-full bg-[#fde41a] shadow-[0_0_5px_rgba(253,228,26,0.85)]"></span>{message}</span>
          <span class="mr-8 inline-flex items-center gap-2"><span class="h-1.5 w-1.5 rounded-full bg-[#fde41a] shadow-[0_0_5px_rgba(253,228,26,0.85)]"></span>{message}</span>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  .marquee-content {
    animation: marquee 25s linear infinite;
  }
  .marquee-container:hover .marquee-content {
    animation-play-state: paused;
  }
  @keyframes marquee {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-50%);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .marquee-content {
      animation: none;
    }
  }
</style>
