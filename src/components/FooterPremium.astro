---
import { Picture } from "astro:assets";
import BankStrip from "./BankStrip.astro";
import { BRAND_ADDRESS, BRAND_NAME } from "../lib/brandProfile";
const images = import.meta.glob<{ default: ImageMetadata }>("../assets/logo.{png,webp,jpg}", { eager: true });
const imagePaths = Object.keys(images);
const mainLogo = imagePaths.length > 0 ? images[imagePaths[0]].default : null;

const logoAlt = `โลโก้ ${BRAND_NAME} ตัวอักษร BANANAV3 สีเหลืองกล้วยไล่เฉดทอง ขอบหนาสีน้ำตาลเข้ม มีรูปกล้วยลูกหนึ่งพาดเฉียงอยู่หลังตัวอักษร และมีเปลือกกล้วยโค้งรับอยู่ด้านล่าง`;

// ลิงก์ /ตรวจหวย ถูกถอดออกแล้ว — หน้านั้นถูกพักไว้ใน src/pages-disabled/ สำหรับ
// แบรนด์นี้ ลิงก์ค้างไว้จะกลายเป็น href ไปยัง route ที่ไม่มีอยู่ ซึ่ง
// verify-build.mjs ตีเป็น error ส่วน /แนวทาง ยังอยู่เพราะ operator เปิดหน้านั้นไว้
---

<footer class="relative mt-16 w-full overflow-hidden rounded-t-[3rem] border-t border-[#e8a317]/45 bg-[#140b02] pt-16 pb-8 font-sans text-[#fdf1b3] shadow-[0_-15px_40px_rgba(232,163,23,0.24)]">
  <div aria-hidden="true" class="pointer-events-none absolute inset-x-0 -top-20 mx-auto h-[250px] w-full max-w-4xl rounded-full bg-[#fed624]/25 blur-[100px]"></div>

  <div class="relative z-10 mx-auto w-full max-w-[1200px] px-6">
    <div class="mb-12 grid grid-cols-1 gap-12 md:grid-cols-12">
      <div class="flex flex-col gap-5 md:col-span-5">
        <a href="/" class="inline-block transition-transform duration-300 hover:scale-105">
          {
            mainLogo ? (
              <Picture
                src={mainLogo}
                alt={logoAlt}
                widths={[130, 260, 390]}
                sizes="130px"
                loading="lazy"
                class="h-[65px] w-auto drop-shadow-[0_5px_15px_rgba(254,214,36,0.45)]"
                formats={["avif", "webp"]}
                fallbackFormat="webp"
              />
            ) : (
              <span class="bg-gradient-to-r from-[#ffe97a] to-[#e8a317] bg-clip-text text-4xl font-black tracking-widest text-transparent">{BRAND_NAME}</span>
            )
          }
        </a>
        <p class="border-l-2 border-[#fed624]/60 pl-4 text-sm leading-relaxed text-[#fdf1b3]/65">
          {BRAND_NAME} เป็นแพลตฟอร์มเดิมพันออนไลน์ที่รวมทั้งบาคาร่าและหวยไว้ในระบบเดียว รองรับการใช้งานบนมือถือ แท็บเล็ต และคอมพิวเตอร์ สมาชิกเลือกประเภทเดิมพัน ตรวจสอบโปรโมชั่น
          และติดตามสถานะธุรกรรมได้จากบัญชีเดียว โดยควรศึกษากติกา อัตราจ่าย และเงื่อนไขของแต่ละประเภทให้ครบก่อนเริ่มใช้งานทุกครั้ง
        </p>
        <div class="mt-4 flex gap-3">
          <span class="rounded-full border border-[#fed624]/45 bg-[#2e1a05]/70 px-4 py-1 text-xs font-medium text-[#ffe97a] backdrop-blur-sm">TRUE WALLET</span>
          <span class="rounded-full border border-[#e8a317]/40 bg-[#2e1a05]/70 px-4 py-1 text-xs font-medium text-[#ffe97a] backdrop-blur-sm">AUTO 24 HRS</span>
        </div>
      </div>

      <nav class="flex flex-col gap-4 md:col-span-3 lg:pl-8" aria-label="ทางลัดหน้าเว็บ">
        <p class="text-lg font-black tracking-widest text-[#fed624] uppercase drop-shadow-sm">QUICK LINKS</p>
        <div aria-hidden="true" class="h-[1px] w-12 bg-gradient-to-r from-[#fed624] to-[#e8a317]"></div>
        <ul class="flex flex-col gap-3 text-sm font-medium text-[#fdf1b3]/65">
          <li><a href="/" class="transition-colors hover:text-[#fed624]">หน้าหลัก (Home)</a></li>
          <li><a href="/promotion" class="transition-colors hover:text-[#fed624]">โปรโมชั่น (Promotions)</a></li>
          <li><a href="/ทางเข้า" class="transition-colors hover:text-[#fed624]">ทางเข้า (Access)</a></li>
          <li><a href="/ทดลองเล่น" class="transition-colors hover:text-[#fed624]">ทดลองเล่น (Demo)</a></li>
          <li><a href="/แนวทาง" class="transition-colors hover:text-[#fed624]">แนวทางหวย</a></li>
          <li><a href="/about-us" class="transition-colors hover:text-[#fed624]">เกี่ยวกับเรา (About)</a></li>
          <li><a href="/contact-us" class="transition-colors hover:text-[#fed624]">ติดต่อเรา (Contact)</a></li>
          <li><a href="/register" class="transition-colors hover:text-[#fed624]">สมัครสมาชิก (Join Us)</a></li>
          <li><a href="/login" class="transition-colors hover:text-[#fed624]">เข้าสู่ระบบ (Login)</a></li>
        </ul>
      </nav>

      <div class="flex flex-col gap-5 md:col-span-4">
        <p class="text-lg font-black tracking-widest text-[#fed624] uppercase drop-shadow-sm">CUSTOMER SUPPORT</p>
        <div aria-hidden="true" class="h-[1px] w-12 bg-gradient-to-r from-[#fed624] to-[#e8a317]"></div>

        <a
          href="/line"
          class="flex w-full items-center justify-center gap-2 rounded-xl bg-gradient-to-r from-[#00B900] to-[#009900] py-3.5 font-bold text-white shadow-[0_5px_15px_rgba(0,185,0,0.3)] transition-all hover:-translate-y-1 hover:shadow-[0_8px_20px_rgba(0,185,0,0.4)]">
          ติดต่อแอดมิน LINE
        </a>

        {
          BRAND_ADDRESS.lines.length > 0 && (
            <address aria-label={BRAND_ADDRESS.label} class="mt-2 rounded-xl border border-white/15 bg-black/20 p-4 text-xs leading-relaxed not-italic opacity-90">
              <p class="mb-2 flex items-center gap-2 text-[11px] font-bold tracking-wider uppercase opacity-80">
                <span aria-hidden="true" class="text-sm">
                  📍
                </span>
                {BRAND_ADDRESS.label}
              </p>
              {BRAND_ADDRESS.lines.map((line) => (
                <span class="block">{line}</span>
              ))}
              {BRAND_ADDRESS.email && (
                <a
                  href={`mailto:${BRAND_ADDRESS.email}`}
                  class="mt-3 inline-flex items-center gap-2 font-bold underline decoration-current/40 underline-offset-4 opacity-90 transition-opacity hover:opacity-100">
                  <span aria-hidden="true" class="text-sm">
                    ✉️
                  </span>
                  {BRAND_ADDRESS.email}
                </a>
              )}
            </address>
          )
        }

        <a
          href="#top"
          class="flex w-full items-center justify-center gap-2 rounded-xl border border-[#e8a317]/55 bg-[#2e1a05]/40 py-3 text-sm font-bold text-[#ffe97a] transition-all hover:bg-[#2e1a05]/80 hover:text-[#fdf1b3]">
          <span aria-hidden="true">↑</span> กลับขึ้นบน
        </a>

        <div class="mt-2 text-xs font-medium tracking-widest text-[#fed624]/60 uppercase">Supported Payments</div>
        <BankStrip size={30} />
      </div>
    </div>

    <div class="flex flex-col items-center justify-between border-t border-[#e8a317]/45 pt-8 text-xs font-medium tracking-wide text-[#fdf1b3]/45 md:flex-row">
      <p>COPYRIGHT &copy; {new Date().getFullYear()} {BRAND_NAME}. ALL RIGHTS RESERVED.</p>
      <div class="mt-4 flex gap-4 md:mt-0">
        <a href="/terms/" class="transition-colors hover:text-[#fed624]">TERMS &amp; CONDITIONS</a>
        <a href="/privacy/" class="transition-colors hover:text-[#fed624]">PRIVACY POLICY</a>
      </div>
    </div>
  </div>
</footer>

<style>
  footer a {
    text-decoration: none;
    font-family: var(--font-sans);
  }
</style>
