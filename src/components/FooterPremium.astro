---
import { Picture } from "astro:assets";
import BankStrip from "./BankStrip.astro";
import { BRAND_ADDRESS, BRAND_NAME } from "../lib/brandProfile";
const images = import.meta.glob<{ default: ImageMetadata }>("../assets/logo.{png,webp,jpg}", { eager: true });
const imagePaths = Object.keys(images);
const mainLogo = imagePaths.length > 0 ? images[imagePaths[0]].default : null;

const logoAlt = `โลโก้ ${BRAND_NAME} ตัวอักษร LASVEGAS สีทองต่อด้วยเลข 889 สีเงินโครเมียม เหนือข้อความเป็นภาพเส้นขอบฟ้าเมืองลาสเวกัสสีฟ้านีออน มีหอไอเฟล ตึกระฟ้า หอคอยสตราโตสเฟียร์ และชิงช้าสวรรค์`;
---

<footer class="relative mt-16 w-full overflow-hidden rounded-t-[3rem] border-t border-[#1f5ce0]/45 bg-[#050b24] pt-16 pb-8 font-sans text-[#cddcf7] shadow-[0_-15px_40px_rgba(31,92,224,0.24)]">
  <div class="pointer-events-none absolute inset-x-0 -top-20 mx-auto h-[250px] w-full max-w-4xl rounded-full bg-[#1f5ce0]/30 blur-[100px]"></div>

  <div class="relative z-10 mx-auto w-full max-w-[1200px] px-6">
    <div class="mb-12 grid grid-cols-1 gap-12 md:grid-cols-12">
      <div class="flex flex-col gap-5 md:col-span-5">
        <a href="/" class="inline-block transition-transform duration-300 hover:scale-105">
          {
            mainLogo ? (
              <Picture
                src={mainLogo}
                alt={logoAlt}
                widths={[130, 260, 390]}
                sizes="130px"
                loading="lazy"
                class="h-[65px] w-auto drop-shadow-[0_5px_15px_rgba(63,220,255,0.4)]"
                formats={["avif", "webp"]}
                fallbackFormat="webp"
              />
            ) : (
              <span class="bg-gradient-to-r from-[#ffdd7a] to-[#a8760d] bg-clip-text text-4xl font-black tracking-widest text-transparent">{BRAND_NAME}</span>
            )
          }
        </a>
        <p class="border-l-2 border-[#f2b829]/60 pl-4 text-sm leading-relaxed text-[#cddcf7]/65">
          {BRAND_NAME} เป็นแพลตฟอร์มเกมออนไลน์ที่รวมทั้งเกมสล็อตและบาคาร่าไว้ในระบบเดียว รองรับการฝากถอนผ่าน True Wallet และการใช้งานบนมือถือ แท็บเล็ต และคอมพิวเตอร์
          สมาชิกเลือกเกม ตรวจสอบโปรโมชั่น และจัดการบัญชีได้จากช่องทางเดียว โดยควรศึกษากติกา รูปแบบเดิมพัน และเงื่อนไขต่าง ๆ ก่อนเริ่มใช้งานทุกครั้ง
        </p>
        <div class="mt-4 flex gap-3">
          <span class="rounded-full border border-[#4d8dff]/45 bg-[#122a63]/70 px-4 py-1 text-xs font-medium text-[#8beeff] backdrop-blur-sm">TRUE WALLET</span>
          <span class="rounded-full border border-[#f2b829]/40 bg-[#122a63]/70 px-4 py-1 text-xs font-medium text-[#ffdd7a] backdrop-blur-sm">AUTO 24 HRS</span>
        </div>
      </div>

      <nav class="flex flex-col gap-4 md:col-span-3 lg:pl-8" aria-label="ทางลัดหน้าเว็บ">
        <p class="text-lg font-black tracking-widest text-[#f2b829] uppercase drop-shadow-sm">QUICK LINKS</p>
        <div class="h-[1px] w-12 bg-gradient-to-r from-[#3fdcff] to-[#1f5ce0]"></div>
        <ul class="flex flex-col gap-3 text-sm font-medium text-[#cddcf7]/65">
          <li><a href="/" class="transition-colors hover:text-[#3fdcff]">หน้าหลัก (Home)</a></li>
          <li><a href="/promotion" class="transition-colors hover:text-[#3fdcff]">โปรโมชั่น (Promotions)</a></li>
          <li><a href="/ทางเข้า" class="transition-colors hover:text-[#3fdcff]">ทางเข้า (Access)</a></li>
          <li><a href="/ทดลองเล่น" class="transition-colors hover:text-[#3fdcff]">ทดลองเล่น (Demo)</a></li>
          <li><a href="/about-us" class="transition-colors hover:text-[#3fdcff]">เกี่ยวกับเรา (About)</a></li>
          <li><a href="/contact-us" class="transition-colors hover:text-[#3fdcff]">ติดต่อเรา (Contact)</a></li>
          <li><a href="/register" class="transition-colors hover:text-[#3fdcff]">สมัครสมาชิก (Join Us)</a></li>
          <li><a href="/login" class="transition-colors hover:text-[#3fdcff]">เข้าสู่ระบบ (Login)</a></li>
        </ul>
      </nav>

      <div class="flex flex-col gap-5 md:col-span-4">
        <p class="text-lg font-black tracking-widest text-[#f2b829] uppercase drop-shadow-sm">CUSTOMER SUPPORT</p>
        <div class="h-[1px] w-12 bg-gradient-to-r from-[#3fdcff] to-[#1f5ce0]"></div>

        <a
          href="/line"
          class="flex w-full items-center justify-center gap-2 rounded-xl bg-gradient-to-r from-[#00B900] to-[#009900] py-3.5 font-bold text-white shadow-[0_5px_15px_rgba(0,185,0,0.3)] transition-all hover:-translate-y-1 hover:shadow-[0_8px_20px_rgba(0,185,0,0.4)]">
          ติดต่อแอดมิน LINE
        </a>

        {
          BRAND_ADDRESS.lines.length > 0 && (
            <address aria-label={BRAND_ADDRESS.label} class="mt-2 rounded-xl border border-white/15 bg-black/20 p-4 text-xs leading-relaxed not-italic opacity-90">
              <p class="mb-2 flex items-center gap-2 text-[11px] font-bold tracking-wider uppercase opacity-80">
                <span aria-hidden="true" class="text-sm">
                  📍
                </span>
                {BRAND_ADDRESS.label}
              </p>
              {BRAND_ADDRESS.lines.map((line) => (
                <span class="block">{line}</span>
              ))}
              {BRAND_ADDRESS.email && (
                <a
                  href={`mailto:${BRAND_ADDRESS.email}`}
                  class="mt-3 inline-flex items-center gap-2 font-bold underline decoration-current/40 underline-offset-4 opacity-90 transition-opacity hover:opacity-100">
                  <span aria-hidden="true" class="text-sm">
                    ✉️
                  </span>
                  {BRAND_ADDRESS.email}
                </a>
              )}
            </address>
          )
        }

        <a
          href="#top"
          class="flex w-full items-center justify-center gap-2 rounded-xl border border-[#4d8dff]/55 bg-[#122a63]/40 py-3 text-sm font-bold text-[#8beeff] transition-all hover:bg-[#122a63]/80 hover:text-white">
          <span aria-hidden="true">↑</span> กลับขึ้นบน
        </a>

        <div class="mt-2 text-xs font-medium tracking-widest text-[#f2b829]/60 uppercase">Supported Payments</div>
        <BankStrip size={30} />
      </div>
    </div>

    <div class="flex flex-col items-center justify-between border-t border-[#1f5ce0]/45 pt-8 text-xs font-medium tracking-wide text-[#cddcf7]/45 md:flex-row">
      <p>COPYRIGHT &copy; {new Date().getFullYear()} {BRAND_NAME}. ALL RIGHTS RESERVED.</p>
      <div class="mt-4 flex gap-4 md:mt-0">
        <a href="/terms/" class="transition-colors hover:text-[#f2b829]">TERMS &amp; CONDITIONS</a>
        <a href="/privacy/" class="transition-colors hover:text-[#f2b829]">PRIVACY POLICY</a>
      </div>
    </div>
  </div>
</footer>

<style>
  footer a {
    text-decoration: none;
    font-family: var(--font-sans);
  }
</style>
