---
import { Picture } from "astro:assets";
import BankStrip from "./BankStrip.astro";
import { BRAND_ADDRESS, BRAND_NAME } from "../lib/brandProfile";
const images = import.meta.glob<{ default: ImageMetadata }>("../assets/logo.{png,webp,jpg}", { eager: true });
const imagePaths = Object.keys(images);
const mainLogo = imagePaths.length > 0 ? images[imagePaths[0]].default : null;

const logoAlt = `โลโก้ ${BRAND_NAME} ตัวอักษร MAX สีขาวบนแถบสีแดง ต่อด้วยเลข 56 สีแดงบนพื้นขาว ด้านขวาเป็นมาสคอตช้างสีขาวยิ้มกว้าง สวมถุงเท้าลายแดง-ขาว-ดำ และเสื้อพิมพ์คำว่า MAX56`;
---

<footer class="relative mt-16 w-full overflow-hidden rounded-t-[3rem] border-t border-[#c10d1e]/45 bg-[#0d0204] pt-16 pb-8 font-sans text-[#f6e4e4] shadow-[0_-15px_40px_rgba(193,13,30,0.22)]">
  <div class="pointer-events-none absolute inset-x-0 -top-20 mx-auto h-[250px] w-full max-w-4xl rounded-full bg-[#8c0512]/35 blur-[100px]"></div>

  <div class="relative z-10 mx-auto w-full max-w-[1200px] px-6">
    <div class="mb-12 grid grid-cols-1 gap-12 md:grid-cols-12">
      <div class="flex flex-col gap-5 md:col-span-5">
        <a href="/" class="inline-block transition-transform duration-300 hover:scale-105">
          {
            mainLogo ? (
              <Picture
                src={mainLogo}
                alt={logoAlt}
                widths={[130, 260, 390]}
                sizes="130px"
                class="h-[65px] w-auto drop-shadow-[0_5px_15px_rgba(232,32,47,0.4)]"
                formats={["avif", "webp"]}
                fallbackFormat="webp"
              />
            ) : (
              <span class="bg-gradient-to-r from-[#ff5a66] to-[#8c0512] bg-clip-text text-4xl font-black tracking-widest text-transparent">{BRAND_NAME}</span>
            )
          }
        </a>
        <p class="border-l-2 border-[#c10d1e]/60 pl-4 text-sm leading-relaxed text-[#f6e4e4]/60">
          {BRAND_NAME} เป็นแพลตฟอร์มเกมสล็อตออนไลน์ที่เน้นความสะดวกด้านการทำธุรกรรมผ่าน True Wallet พร้อมเงื่อนไขไม่มีขั้นต่ำในช่องทางที่กำหนด รองรับการใช้งานบนมือถือ แท็บเล็ต และคอมพิวเตอร์
          สมาชิกเลือกเกม ตรวจสอบโปรโมชั่น และติดตามสถานะรายการได้จากบัญชีเดียว ก่อนเริ่มควรอ่านกติกาและเงื่อนไขที่เกี่ยวข้องให้ครบถ้วน
        </p>
        <div class="mt-4 flex gap-3">
          <span class="rounded-full border border-[#c10d1e]/40 bg-[#2a070d]/70 px-4 py-1 text-xs font-medium text-[#ffe9a8] backdrop-blur-sm">TRUE WALLET</span>
          <span class="rounded-full border border-[#f5c451]/35 bg-[#2a070d]/70 px-4 py-1 text-xs font-medium text-[#f6e4e4] backdrop-blur-sm">AUTO 24 HRS</span>
        </div>
      </div>

      <nav class="flex flex-col gap-4 md:col-span-3 lg:pl-8" aria-label="ทางลัดหน้าเว็บ">
        <p class="text-lg font-black tracking-widest text-[#f5c451] uppercase drop-shadow-sm">QUICK LINKS</p>
        <div class="h-[1px] w-12 bg-[#c10d1e]"></div>
        <ul class="flex flex-col gap-3 text-sm font-medium text-[#f6e4e4]/60">
          <li><a href="/" class="transition-colors hover:text-[#f5c451]">หน้าหลัก (Home)</a></li>
          <li><a href="/promotion" class="transition-colors hover:text-[#f5c451]">โปรโมชั่น (Promotions)</a></li>
          <li><a href="/ทางเข้า" class="transition-colors hover:text-[#f5c451]">ทางเข้า (Access)</a></li>
          <li><a href="/ทดลองเล่น" class="transition-colors hover:text-[#f5c451]">ทดลองเล่น (Demo)</a></li>
          <li><a href="/about-us" class="transition-colors hover:text-[#f5c451]">เกี่ยวกับเรา (About)</a></li>
          <li><a href="/contact-us" class="transition-colors hover:text-[#f5c451]">ติดต่อเรา (Contact)</a></li>
          <li><a href="/register" class="transition-colors hover:text-[#f5c451]">สมัครสมาชิก (Join Us)</a></li>
          <li><a href="/login" class="transition-colors hover:text-[#f5c451]">เข้าสู่ระบบ (Login)</a></li>
        </ul>
      </nav>

      <div class="flex flex-col gap-5 md:col-span-4">
        <p class="text-lg font-black tracking-widest text-[#f5c451] uppercase drop-shadow-sm">CUSTOMER SUPPORT</p>
        <div class="h-[1px] w-12 bg-[#c10d1e]"></div>

        <a
          href="/line"
          class="flex w-full items-center justify-center gap-2 rounded-xl bg-gradient-to-r from-[#00B900] to-[#009900] py-3.5 font-bold text-white shadow-[0_5px_15px_rgba(0,185,0,0.3)] transition-all hover:-translate-y-1 hover:shadow-[0_8px_20px_rgba(0,185,0,0.4)]">
          ติดต่อแอดมิน LINE
        </a>

        {
          BRAND_ADDRESS.lines.length > 0 && (
            <address aria-label={BRAND_ADDRESS.label} class="mt-2 rounded-xl border border-white/15 bg-black/20 p-4 text-xs leading-relaxed not-italic opacity-90">
              <p class="mb-2 flex items-center gap-2 text-[11px] font-bold tracking-wider uppercase opacity-80">
                <span aria-hidden="true" class="text-sm">
                  📍
                </span>
                {BRAND_ADDRESS.label}
              </p>
              {BRAND_ADDRESS.lines.map((line) => (
                <span class="block">{line}</span>
              ))}
              {BRAND_ADDRESS.email && (
                <a
                  href={`mailto:${BRAND_ADDRESS.email}`}
                  class="mt-3 inline-flex items-center gap-2 font-bold underline decoration-current/40 underline-offset-4 opacity-90 transition-opacity hover:opacity-100">
                  <span aria-hidden="true" class="text-sm">
                    ✉️
                  </span>
                  {BRAND_ADDRESS.email}
                </a>
              )}
            </address>
          )
        }

        <div class="mt-4 text-xs font-medium tracking-widest text-[#f5c451]/55 uppercase">Supported Payments</div>
        <BankStrip size={30} />
      </div>
    </div>

    <div class="flex flex-col items-center justify-between border-t border-[#8c0512]/50 pt-8 text-xs font-medium tracking-wide text-[#f6e4e4]/40 md:flex-row">
      <p>COPYRIGHT &copy; {new Date().getFullYear()} {BRAND_NAME}. ALL RIGHTS RESERVED.</p>
      <div class="mt-4 flex gap-4 md:mt-0">
        <a href="/terms/" class="transition-colors hover:text-[#f5c451]">TERMS &amp; CONDITIONS</a>
        <a href="/privacy/" class="transition-colors hover:text-[#f5c451]">PRIVACY POLICY</a>
      </div>
    </div>
  </div>
</footer>

<style>
  footer a {
    text-decoration: none;
    font-family: var(--font-sans);
  }
</style>
