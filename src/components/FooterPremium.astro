---
import { Picture } from "astro:assets";
import BankStrip from "./BankStrip.astro";
import { BRAND_ADDRESS, BRAND_NAME } from "../lib/brandProfile";
const images = import.meta.glob<{ default: ImageMetadata }>("../assets/logo.{png,webp,jpg}", { eager: true });
const imagePaths = Object.keys(images);
const mainLogo = imagePaths.length > 0 ? images[imagePaths[0]].default : null;

const logoAlt = `โลโก้ ${BRAND_NAME} ตัวอักษร FiNN สีทองไล่เฉดขอบเข้ม ต่อด้วยเลข 20 สีเงินเมทัลลิก มีสัญลักษณ์ไพ่โพดำซ้อนอยู่ท้ายเลข ใต้ตัวอักษรเป็นแถบสีดำโค้งเขียนว่า WWW.FINN20.COM`;

// FINN20 เป็นแบรนด์บาคาร่า ไม่ใช่เว็บหวย — ลิงก์ /ตรวจหวย และ /แนวทาง ที่ variant
// นี้เคยมีถูกถอดออกแล้ว ทั้งสองหน้าถูกพักไว้ใน src/pages-disabled/ รอบนี้ ลิงก์ที่
// ค้างไว้จะกลายเป็น href ไปยัง route ที่ไม่มีอยู่ ซึ่ง verify-build.mjs ตีเป็น error
---

<footer class="relative mt-16 w-full overflow-hidden rounded-t-[3rem] border-t border-[#e39d02]/45 bg-[#14110a] pt-16 pb-8 font-sans text-[#f3e7c8] shadow-[0_-15px_40px_rgba(253,211,35,0.22)]">
  <div aria-hidden="true" class="pointer-events-none absolute inset-x-0 -top-20 mx-auto h-[250px] w-full max-w-4xl rounded-full bg-[#fdd323]/22 blur-[100px]"></div>

  <div class="relative z-10 mx-auto w-full max-w-[1200px] px-6">
    <div class="mb-12 grid grid-cols-1 gap-12 md:grid-cols-12">
      <div class="flex flex-col gap-5 md:col-span-5">
        <a href="/" class="inline-block transition-transform duration-300 hover:scale-105">
          {
            mainLogo ? (
              <Picture
                src={mainLogo}
                alt={logoAlt}
                widths={[130, 260, 390]}
                sizes="130px"
                loading="lazy"
                class="h-[65px] w-auto drop-shadow-[0_5px_15px_rgba(253,211,35,0.45)]"
                formats={["avif", "webp"]}
                fallbackFormat="webp"
              />
            ) : (
              <span class="bg-gradient-to-r from-[#ffe98a] to-[#e39d02] bg-clip-text text-4xl font-black tracking-widest text-transparent">{BRAND_NAME}</span>
            )
          }
        </a>
        <p class="border-l-2 border-[#fdd323]/60 pl-4 text-sm leading-relaxed text-[#f3e7c8]/65">
          {BRAND_NAME} เป็นแพลตฟอร์มบาคาร่าออนไลน์ที่รวมโต๊ะเกมหลายรูปแบบไว้ในระบบเดียว รองรับการใช้งานบนมือถือ แท็บเล็ต และคอมพิวเตอร์ สมาชิกเลือกโต๊ะจากวงเงินและรูปแบบการเล่น ตรวจสอบโปรโมชั่น
          และติดตามสถานะธุรกรรมได้จากบัญชีเดียว โดยควรศึกษากติกา อัตราจ่าย ค่าคอมมิชชัน และเงื่อนไขของแต่ละโต๊ะให้ครบก่อนเริ่มเดิมพันทุกครั้ง
        </p>
        <div class="mt-4 flex gap-3">
          <span class="rounded-full border border-[#fdd323]/45 bg-[#1f1a10]/70 px-4 py-1 text-xs font-medium text-[#ffe98a] backdrop-blur-sm">TRUE WALLET</span>
          <span class="rounded-full border border-[#e39d02]/40 bg-[#1f1a10]/70 px-4 py-1 text-xs font-medium text-[#ffe98a] backdrop-blur-sm">AUTO 24 HRS</span>
        </div>
      </div>

      <nav class="flex flex-col gap-4 md:col-span-3 lg:pl-8" aria-label="ทางลัดหน้าเว็บ">
        <p class="text-lg font-black tracking-widest text-[#fdd323] uppercase drop-shadow-sm">QUICK LINKS</p>
        <div aria-hidden="true" class="h-[1px] w-12 bg-gradient-to-r from-[#fdd323] to-[#e39d02]"></div>
        <ul class="flex flex-col gap-3 text-sm font-medium text-[#f3e7c8]/65">
          <li><a href="/" class="transition-colors hover:text-[#fdd323]">หน้าหลัก (Home)</a></li>
          <li><a href="/promotion" class="transition-colors hover:text-[#fdd323]">โปรโมชั่น (Promotions)</a></li>
          <li><a href="/ทางเข้า" class="transition-colors hover:text-[#fdd323]">ทางเข้า (Access)</a></li>
          <li><a href="/ทดลองเล่น" class="transition-colors hover:text-[#fdd323]">ทดลองเล่น (Demo)</a></li>
          <li><a href="/about-us" class="transition-colors hover:text-[#fdd323]">เกี่ยวกับเรา (About)</a></li>
          <li><a href="/contact-us" class="transition-colors hover:text-[#fdd323]">ติดต่อเรา (Contact)</a></li>
          <li><a href="/register" class="transition-colors hover:text-[#fdd323]">สมัครสมาชิก (Join Us)</a></li>
          <li><a href="/login" class="transition-colors hover:text-[#fdd323]">เข้าสู่ระบบ (Login)</a></li>
        </ul>
      </nav>

      <div class="flex flex-col gap-5 md:col-span-4">
        <p class="text-lg font-black tracking-widest text-[#fdd323] uppercase drop-shadow-sm">CUSTOMER SUPPORT</p>
        <div aria-hidden="true" class="h-[1px] w-12 bg-gradient-to-r from-[#fdd323] to-[#e39d02]"></div>

        <a
          href="/line"
          class="flex w-full items-center justify-center gap-2 rounded-xl bg-gradient-to-r from-[#00B900] to-[#009900] py-3.5 font-bold text-white shadow-[0_5px_15px_rgba(0,185,0,0.3)] transition-all hover:-translate-y-1 hover:shadow-[0_8px_20px_rgba(0,185,0,0.4)]">
          ติดต่อแอดมิน LINE
        </a>

        {
          BRAND_ADDRESS.lines.length > 0 && (
            <address aria-label={BRAND_ADDRESS.label} class="mt-2 rounded-xl border border-white/15 bg-black/20 p-4 text-xs leading-relaxed not-italic opacity-90">
              <p class="mb-2 flex items-center gap-2 text-[11px] font-bold tracking-wider uppercase opacity-80">
                <span aria-hidden="true" class="text-sm">
                  📍
                </span>
                {BRAND_ADDRESS.label}
              </p>
              {BRAND_ADDRESS.lines.map((line) => (
                <span class="block">{line}</span>
              ))}
              {BRAND_ADDRESS.email && (
                <a
                  href={`mailto:${BRAND_ADDRESS.email}`}
                  class="mt-3 inline-flex items-center gap-2 font-bold underline decoration-current/40 underline-offset-4 opacity-90 transition-opacity hover:opacity-100">
                  <span aria-hidden="true" class="text-sm">
                    ✉️
                  </span>
                  {BRAND_ADDRESS.email}
                </a>
              )}
            </address>
          )
        }

        <a
          href="#top"
          class="flex w-full items-center justify-center gap-2 rounded-xl border border-[#e39d02]/55 bg-[#1f1a10]/40 py-3 text-sm font-bold text-[#ffe98a] transition-all hover:bg-[#1f1a10]/80 hover:text-[#f3e7c8]">
          <span aria-hidden="true">↑</span> กลับขึ้นบน
        </a>

        <div class="mt-2 text-xs font-medium tracking-widest text-[#fdd323]/60 uppercase">Supported Payments</div>
        <BankStrip size={30} />
      </div>
    </div>

    <div class="flex flex-col items-center justify-between border-t border-[#e39d02]/45 pt-8 text-xs font-medium tracking-wide text-[#f3e7c8]/45 md:flex-row">
      <p>COPYRIGHT &copy; {new Date().getFullYear()} {BRAND_NAME}. ALL RIGHTS RESERVED.</p>
      <div class="mt-4 flex gap-4 md:mt-0">
        <a href="/terms/" class="transition-colors hover:text-[#fdd323]">TERMS &amp; CONDITIONS</a>
        <a href="/privacy/" class="transition-colors hover:text-[#fdd323]">PRIVACY POLICY</a>
      </div>
    </div>
  </div>
</footer>

<style>
  footer a {
    text-decoration: none;
    font-family: var(--font-sans);
  }
</style>
