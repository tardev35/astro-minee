---
import { Picture } from "astro:assets";
import BankStrip from "./BankStrip.astro";
import { BRAND_ADDRESS, BRAND_NAME } from "../lib/brandProfile";
const images = import.meta.glob<{ default: ImageMetadata }>("../assets/logo.{png,webp,jpg}", { eager: true });
const imagePaths = Object.keys(images);
const mainLogo = imagePaths.length > 0 ? images[imagePaths[0]].default : null;

const logoAlt = `โลโก้ ${BRAND_NAME} เป็นตัวพิมพ์ใหญ่หนาขอบมน ครึ่งซ้ายเขียนว่า TT1 เป็นสีขาวเงินไล่เฉด ครึ่งขวาเขียนว่า BET เป็นสีทองไล่เฉด ทั้งคำมีเส้นขอบสีดำและเงาตกกระทบด้านล่าง`;

// TT1BET เป็นแบรนด์คาสิโน/สล็อต ไม่ใช่เว็บหวย — /ตรวจหวย กับ /แนวทาง ถูกพักไว้
// ที่ src/pages-disabled/ รอบนี้ ทั้งสอง route จึงไม่มีอยู่ในบิลด์ ลิงก์ที่ค้างไว้
// จะเป็น href ไปยัง route ที่ไม่มีจริง ซึ่ง verify-build.mjs ตีเป็น error —
// variant นี้เคยมีลิงก์ "แนวทางหวย" ค้างจากแบรนด์หวยก่อนหน้า และถูกถอดออกแล้ว
//
// /register กับ /login ยังอยู่ใน quick links ได้: รอบนี้ cta toggle ปิด ทั้งสอง
// จึงเป็น noindex forwarding stub ที่มี route จริง ไม่ใช่ลิงก์ตาย
//
// บล็อก <address> ด้านล่างไม่ใส่สีของแบรนด์โดยตั้งใจ — border-white/15,
// bg-black/20 และ opacity บนสีตัวอักษรที่ inherit มาลงตัวกับ footer variant
// ทุกตัวในคลัง ซึ่งพื้นเข้มทั้งหมด การไล่สีทองใส่ตรงนี้ไม่ได้อะไรเพิ่ม และเป็น
// ทางที่ทำให้ hex ของแบรนด์เก่าค้างไว้ในรอบถัดไป
---

<footer class="relative mt-16 w-full overflow-hidden rounded-t-[3rem] border-t border-[#6d4a13]/45 bg-[#171008] pt-16 pb-8 font-sans text-[#f2e7cd] shadow-[0_-15px_40px_rgba(233,195,65,0.22)]">
  <div aria-hidden="true" class="pointer-events-none absolute inset-x-0 -top-20 mx-auto h-[250px] w-full max-w-4xl rounded-full bg-[#e9c341]/22 blur-[100px]"></div>

  <div class="relative z-10 mx-auto w-full max-w-[1200px] px-6">
    <div class="mb-12 grid grid-cols-1 gap-12 md:grid-cols-12">
      <div class="flex flex-col gap-5 md:col-span-5">
        <a href="/" class="inline-block transition-transform duration-300 hover:scale-105">
          {
            mainLogo ? (
              <Picture
                src={mainLogo}
                alt={logoAlt}
                widths={[130, 260, 390]}
                sizes="130px"
                loading="lazy"
                class="h-[65px] w-auto drop-shadow-[0_5px_15px_rgba(233,195,65,0.45)]"
                formats={["avif", "webp"]}
                fallbackFormat="webp"
              />
            ) : (
              <span class="bg-gradient-to-r from-[#fcf1b0] to-[#6d4a13] bg-clip-text text-4xl font-black tracking-widest text-transparent">{BRAND_NAME}</span>
            )
          }
        </a>
        <p class="border-l-2 border-[#e9c341]/60 pl-4 text-sm leading-relaxed text-[#f2e7cd]/65">
          {BRAND_NAME} เป็นแพลตฟอร์มคาสิโนและสล็อตออนไลน์ที่รวบรวมเกมจากหลายค่ายไว้ในระบบเดียว รองรับการใช้งานบนมือถือ แท็บเล็ต และคอมพิวเตอร์ สมาชิกเลือกเกม ตรวจโปรโมชั่น ดูโบนัส
          และติดตามสถานะธุรกรรมได้จากบัญชีเดียว โดยควรศึกษากติกา อัตราจ่าย ฟีเจอร์ และเงื่อนไขของแต่ละรายการให้ครบก่อนเริ่มเล่นทุกครั้ง
        </p>
        <div class="mt-4 flex gap-3">
          <span class="rounded-full border border-[#e9c341]/45 bg-[#241a0d]/70 px-4 py-1 text-xs font-medium text-[#fcf1b0] backdrop-blur-sm">CASINO &amp; SLOT</span>
          <span class="rounded-full border border-[#6d4a13]/40 bg-[#241a0d]/70 px-4 py-1 text-xs font-medium text-[#fcf1b0] backdrop-blur-sm">AUTO 24 HRS</span>
        </div>
      </div>

      <nav class="flex flex-col gap-4 md:col-span-3 lg:pl-8" aria-label="ทางลัดหน้าเว็บ">
        <p class="text-lg font-black tracking-widest text-[#e9c341] uppercase drop-shadow-sm">QUICK LINKS</p>
        <div aria-hidden="true" class="h-[1px] w-12 bg-gradient-to-r from-[#e9c341] to-[#6d4a13]"></div>
        <ul class="flex flex-col gap-3 text-sm font-medium text-[#f2e7cd]/65">
          <li><a href="/" class="transition-colors hover:text-[#fcf1b0]">หน้าหลัก (Home)</a></li>
          <li><a href="/promotion" class="transition-colors hover:text-[#fcf1b0]">โปรโมชั่น (Promotions)</a></li>
          <li><a href="/ทางเข้า" class="transition-colors hover:text-[#fcf1b0]">ทางเข้า (Access)</a></li>
          <li><a href="/ทดลองเล่น" class="transition-colors hover:text-[#fcf1b0]">ทดลองเล่น (Demo)</a></li>
          <li><a href="/about-us" class="transition-colors hover:text-[#fcf1b0]">เกี่ยวกับเรา (About)</a></li>
          <li><a href="/contact-us" class="transition-colors hover:text-[#fcf1b0]">ติดต่อเรา (Contact)</a></li>
          <li><a href="/register" class="transition-colors hover:text-[#fcf1b0]">สมัครสมาชิก (Join Us)</a></li>
          <li><a href="/login" class="transition-colors hover:text-[#fcf1b0]">เข้าสู่ระบบ (Login)</a></li>
        </ul>
      </nav>

      <div class="flex flex-col gap-5 md:col-span-4">
        <p class="text-lg font-black tracking-widest text-[#e9c341] uppercase drop-shadow-sm">CUSTOMER SUPPORT</p>
        <div aria-hidden="true" class="h-[1px] w-12 bg-gradient-to-r from-[#e9c341] to-[#6d4a13]"></div>

        <a
          href="/line"
          class="flex w-full items-center justify-center gap-2 rounded-xl bg-gradient-to-r from-[#00B900] to-[#009900] py-3.5 font-bold text-white shadow-[0_5px_15px_rgba(0,185,0,0.3)] transition-all hover:-translate-y-1 hover:shadow-[0_8px_20px_rgba(0,185,0,0.4)]">
          ติดต่อแอดมิน LINE
        </a>

        {
          BRAND_ADDRESS.lines.length > 0 && (
            <address aria-label={BRAND_ADDRESS.label} class="mt-2 rounded-xl border border-white/15 bg-black/20 p-4 text-xs leading-relaxed not-italic opacity-90">
              <p class="mb-2 flex items-center gap-2 text-[11px] font-bold tracking-wider uppercase opacity-80">
                <span aria-hidden="true" class="text-sm">
                  📍
                </span>
                {BRAND_ADDRESS.label}
              </p>
              {BRAND_ADDRESS.lines.map((line) => (
                <span class="block">{line}</span>
              ))}
              {BRAND_ADDRESS.email && (
                <a
                  href={`mailto:${BRAND_ADDRESS.email}`}
                  class="mt-3 inline-flex items-center gap-2 font-bold underline decoration-current/40 underline-offset-4 opacity-90 transition-opacity hover:opacity-100">
                  <span aria-hidden="true" class="text-sm">
                    ✉️
                  </span>
                  {BRAND_ADDRESS.emailDisplay}
                </a>
              )}
            </address>
          )
        }

        <a
          href="#top"
          class="flex w-full items-center justify-center gap-2 rounded-xl border border-[#6d4a13]/55 bg-[#241a0d]/40 py-3 text-sm font-bold text-[#fcf1b0] transition-all hover:bg-[#241a0d]/80 hover:text-[#fff8d6]">
          <span aria-hidden="true">↑</span> กลับขึ้นบน
        </a>

        <div class="mt-2 text-xs font-medium tracking-widest text-[#e9c341]/60 uppercase">Supported Payments</div>
        <BankStrip size={30} />
      </div>
    </div>

    <div class="flex flex-col items-center justify-between border-t border-[#6d4a13]/45 pt-8 text-xs font-medium tracking-wide text-[#f2e7cd]/45 md:flex-row">
      <p>COPYRIGHT &copy; {new Date().getFullYear()} {BRAND_NAME}. ALL RIGHTS RESERVED.</p>
      <div class="mt-4 flex gap-4 md:mt-0">
        <a href="/terms/" class="transition-colors hover:text-[#fcf1b0]">TERMS &amp; CONDITIONS</a>
        <a href="/privacy/" class="transition-colors hover:text-[#fcf1b0]">PRIVACY POLICY</a>
      </div>
    </div>
  </div>
</footer>

<style>
  footer a {
    text-decoration: none;
    font-family: var(--font-sans);
  }
</style>
