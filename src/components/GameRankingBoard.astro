---
import { Picture } from "astro:assets";
import img1 from "../assets/providers/game1.avif";
import img2 from "../assets/providers/game2.avif";
import img3 from "../assets/providers/game3.avif";
import img4 from "../assets/providers/game4.avif";
import img5 from "../assets/providers/game5.avif";
import img6 from "../assets/providers/game6.avif";

const games = [
  { rank: 1, name: "บาคาร่าถ่ายทอดสด", type: "โต๊ะบาคาร่า • แจกไพ่ตามจริงทุกรอบ", menus: ["ยอดนิยม", "เล่นล่าสุด"], players: 5124, img: img6 },
  { rank: 2, name: "บาคาร่าสปีด", type: "โต๊ะบาคาร่า • รอบสั้นกว่าปกติ", menus: ["ยอดนิยม", "รายการโปรด"], players: 3842, img: img3 },
  { rank: 3, name: "บาคาร่าโต๊ะวงเงินต่ำ", type: "โต๊ะบาคาร่า • เหมาะกับงบจำกัด", menus: ["ยอดนิยม", "รายการโปรด"], players: 3517, img: img1 },
  { rank: 4, name: "บาคาร่าไม่มีค่าคอมมิชชั่น", type: "โต๊ะบาคาร่า • เงื่อนไขจ่ายต่างจากโต๊ะปกติ", menus: ["เกมใหม่", "เล่นล่าสุด"], players: 2905, img: img2 },
  { rank: 5, name: "บาคาร่าโต๊ะวีไอพี", type: "โต๊ะบาคาร่า • วงเงินขั้นต่ำสูงกว่า", menus: ["เกมใหม่", "รายการโปรด"], players: 2431, img: img4 },
  { rank: 6, name: "เสือมังกรและโต๊ะไพ่อื่น", type: "โต๊ะคาสิโน • กติกาสั้นกว่าบาคาร่า", menus: ["เกมใหม่", "เล่นล่าสุด"], players: 2108, img: img5 },
];

// The medal replaces the rank NUMBER for the top three, so the emoji carries
// information the text does not — it is hidden from assistive tech and the
// meaning is restored by an sr-only span rather than dropped.
const medal = (rank: number) => (rank === 1 ? "🥇" : rank === 2 ? "🥈" : rank === 3 ? "🥉" : null);
---

<section aria-label="อันดับโต๊ะบาคาร่ายอดนิยมบน KOHKAE789" class="mx-auto w-full max-w-[1300px] px-4 py-8 font-sans">
  <div class="mb-8 flex w-full flex-col items-center justify-center gap-2 text-center">
    <span aria-hidden="true" class="text-2xl">🏆</span>
    <p class="bg-gradient-to-r from-[#e8f6ff] via-[#7fdcff] to-[#1573e6] bg-clip-text text-2xl font-black tracking-widest text-transparent uppercase">อันดับโต๊ะบาคาร่ายอดนิยมบน KOHKAE789</p>
    <p class="max-w-3xl text-base leading-relaxed text-[#cfe6f7]/75">
      รายชื่อด้านล่างใช้เพื่ออ้างอิงความนิยมเท่านั้น ไม่ได้รับประกันผลของโต๊ะใดโต๊ะหนึ่ง ก่อนเลือกควรดูกติกา อัตราการจ่าย และวงเงินขั้นต่ำของแต่ละโต๊ะ แล้วกำหนดวงเงินและเวลาเล่นให้ชัดเจน
      เพราะรายชื่อในแต่ละหมวดเปลี่ยนแปลงได้ตามช่วงเวลา
    </p>
    <div class="mt-2 h-[3px] w-24 rounded-full bg-gradient-to-r from-transparent via-[#29abe3] to-transparent"></div>
  </div>

  <div class="flex flex-col gap-3">
    {
      games.map((g) => {
        const top = g.rank === 1;
        return (
          <article
            class={`group relative flex items-center gap-3 overflow-hidden rounded-2xl border p-3 backdrop-blur-md transition-all duration-300 hover:-translate-y-0.5 sm:gap-5 sm:p-4 ${
              top
                ? "border-[#1573e6]/50 bg-gradient-to-r from-[#123157]/95 via-[#0b1c33]/92 to-[#0b1c33]/92 shadow-[0_15px_40px_rgba(21,115,230,0.26)]"
                : "border-[#29abe3]/30 bg-[#0b1c33]/92 shadow-[0_10px_30px_rgba(41,171,227,0.2)] hover:border-[#1573e6]/50 hover:shadow-[0_15px_40px_rgba(21,115,230,0.24)]"
            }`}>
            <div class="pointer-events-none absolute top-1/2 -left-10 h-24 w-24 -translate-y-1/2 rounded-full bg-[#29abe3]/35 blur-[40px] transition-all duration-500 group-hover:bg-[#1573e6]/30" />

            <div class="relative z-10 flex w-8 shrink-0 flex-col items-center justify-center sm:w-12">
              {medal(g.rank) ? (
                <span class="text-2xl sm:text-3xl">
                  <span aria-hidden="true">{medal(g.rank)}</span>
                  <span class="sr-only">อันดับ {g.rank}</span>
                </span>
              ) : (
                <span class="text-xl font-black text-[#7fdcff] sm:text-2xl">#{g.rank}</span>
              )}
            </div>

            <div class={`relative z-10 h-14 w-14 shrink-0 overflow-hidden rounded-xl border sm:h-16 sm:w-16 ${top ? "border-[#1573e6]/50" : "border-[#29abe3]/30"}`}>
              <Picture
                src={g.img}
                alt={`ภาพหน้าปกโต๊ะ ${g.name} ในอันดับโต๊ะบาคาร่ายอดนิยมของ KOHKAE789`}
                formats={["avif", "webp"]}
                fallbackFormat="webp"
                loading="lazy"
                fetchpriority="low"
                widths={[100, 200]}
                sizes="(max-width: 640px) 56px, 64px"
                decoding="async"
                class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-110"
              />
            </div>

            <div class="relative z-10 min-w-0 flex-1">
              <div class="flex items-center gap-2">
                <p class="truncate text-base font-black text-[#cfe6f7] sm:text-lg">{g.name}</p>
                {top && (
                  <span class="hidden shrink-0 rounded-full border border-[#1573e6]/70 bg-[#050c1a] px-2 py-0.5 text-[9px] font-black tracking-wider text-[#bfe9ff] sm:inline">ยอดนิยมสูงสุด</span>
                )}
              </div>
              <p class="truncate text-[11px] text-[#cfe6f7]/70 sm:text-xs">{g.type}</p>

              <div class="mt-2 flex flex-wrap items-center gap-1.5">
                {g.menus.map((m) => (
                  <span class="rounded-full border border-[#29abe3]/30 bg-[#050c1a] px-2.5 py-0.5 text-[10px] font-bold text-[#7fdcff]">{m}</span>
                ))}
              </div>
            </div>

            <div class="relative z-10 hidden shrink-0 flex-col items-end gap-1 sm:flex">
              <span class="flex items-center gap-1.5 text-[11px] text-[#cfe6f7]/70">
                <span class="h-1.5 w-1.5 animate-pulse rounded-full bg-green-500 shadow-[0_0_6px_rgba(34,197,94,0.6)]" />
                <span class="tabular-nums" data-players data-base={g.players}>
                  {g.players.toLocaleString("en-US")}
                </span>{" "}
                ออนไลน์
              </span>
              <a
                href="/register"
                class={`rounded-full px-4 py-1.5 text-xs font-black transition-transform hover:scale-105 ${
                  top
                    ? "bg-gradient-to-r from-[#7fdcff] via-[#29abe3] to-[#0b3f96] text-[#050c1a] shadow-[0_10px_30px_rgba(41,171,227,0.28)]"
                    : "border border-[#29abe3]/60 bg-[#050c1a] text-[#7fdcff] hover:border-[#1573e6] hover:bg-[#12294a]"
                }`}>
                เข้าดูโต๊ะ
              </a>
            </div>
          </article>
        );
      })
    }
  </div>
</section>

<script>
  import { startLiveCounters } from "../lib/liveCounter";

  startLiveCounters();
</script>
