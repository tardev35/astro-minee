---
import { Picture } from "astro:assets";
import img1 from "../assets/providers/game1.avif";
import img2 from "../assets/providers/game2.avif";
import img3 from "../assets/providers/game3.avif";
import img4 from "../assets/providers/game4.avif";
import img5 from "../assets/providers/game5.avif";
import img6 from "../assets/providers/game6.avif";

const games = [
  { rank: 1, name: "สล็อตฟีเจอร์ฟรีสปิน", type: "สล็อตออนไลน์ • รอบโบนัสหลายชั้น ควรอ่านเงื่อนไขฟีเจอร์ก่อน", menus: ["ยอดนิยม", "เล่นล่าสุด"], players: 5124, img: img6 },
  { rank: 2, name: "สล็อตแจ็กพอตสะสม", type: "สล็อตออนไลน์ • รางวัลสะสมจากผู้เล่นหลายคน ความผันผวนสูง", menus: ["ยอดนิยม", "รายการโปรด"], players: 3842, img: img3 },
  { rank: 3, name: "สล็อตคลาสสิก 3 วงล้อ", type: "สล็อตออนไลน์ • กติกาสั้น จบรอบเร็ว เหมาะกับผู้เริ่มต้น", menus: ["ยอดนิยม", "รายการโปรด"], players: 3517, img: img1 },
  { rank: 4, name: "สล็อตหลายเส้นจ่าย", type: "สล็อตออนไลน์ • เส้นจ่ายจำนวนมาก ควรดูอัตราจ่ายต่อรอบก่อน", menus: ["เกมใหม่", "เล่นล่าสุด"], players: 2905, img: img2 },
  { rank: 5, name: "สล็อตธีมผลไม้", type: "สล็อตออนไลน์ • ภาพเข้าใจง่าย จังหวะเกมไม่ซับซ้อน", menus: ["เกมใหม่", "รายการโปรด"], players: 2431, img: img4 },
  { rank: 6, name: "สล็อตซื้อฟีเจอร์โบนัส", type: "สล็อตออนไลน์ • มีเงื่อนไขราคาซื้อฟีเจอร์ ควรกำหนดวงเงินก่อน", menus: ["เกมใหม่", "เล่นล่าสุด"], players: 2108, img: img5 },
];

// The medal replaces the rank NUMBER for the top three, so the emoji carries
// information the text does not — it is hidden from assistive tech and the
// meaning is restored by an sr-only span rather than dropped.
const medal = (rank: number) => (rank === 1 ? "🥇" : rank === 2 ? "🥈" : rank === 3 ? "🥉" : null);
---

<section aria-label="อันดับเกมสล็อตยอดนิยมบน AMB194" class="mx-auto w-full max-w-[1300px] px-4 py-8 font-sans">
  <div class="mb-8 flex w-full flex-col items-center justify-center gap-2 text-center">
    <span aria-hidden="true" class="text-2xl">🏆</span>
    <p class="bg-gradient-to-r from-[#fff3ae] via-[#f8d441] to-[#d9a520] bg-clip-text text-2xl font-black tracking-widest text-transparent uppercase">อันดับเกมสล็อตยอดนิยมบน AMB194</p>
    <p class="max-w-3xl text-base leading-relaxed text-[#c9b784]">
      รายชื่อด้านล่างใช้เพื่ออ้างอิงความนิยมเท่านั้น ไม่ได้รับประกันผลของเกมใดเกมหนึ่ง ก่อนเลือกควรดูกติกา รูปแบบโบนัส ความผันผวน และอัตราจ่ายของแต่ละเกม แล้วกำหนดวงเงินและเวลาเล่นให้ชัดเจน
      เพราะรายชื่อในแต่ละหมวดเปลี่ยนแปลงได้ตามช่วงเวลา
    </p>
    <div class="mt-2 h-[3px] w-24 rounded-full bg-gradient-to-r from-transparent via-[#f8d441] to-transparent"></div>
  </div>

  <div class="flex flex-col gap-3">
    {
      games.map((g) => {
        const top = g.rank === 1;
        return (
          <article
            class={`group relative flex items-center gap-3 overflow-hidden rounded-2xl border p-3 backdrop-blur-md transition-all duration-300 hover:-translate-y-0.5 sm:gap-5 sm:p-4 ${
              top
                ? "border-[#f8d441]/55 bg-gradient-to-r from-[#221807]/95 via-[#150f05]/92 to-[#150f05]/92 shadow-[0_15px_40px_rgba(248,212,65,0.26)]"
                : "border-[#f8d441]/25 bg-[#150f05]/92 shadow-[0_10px_30px_rgba(248,212,65,0.18)] hover:border-[#d9a520]/55 hover:shadow-[0_15px_40px_rgba(217,165,32,0.24)]"
            }`}>
            <div class="pointer-events-none absolute top-1/2 -left-10 h-24 w-24 -translate-y-1/2 rounded-full bg-[#f8d441]/30 blur-[40px] transition-all duration-500 group-hover:bg-[#8a6205]/45" />

            <div class="relative z-10 flex w-8 shrink-0 flex-col items-center justify-center sm:w-12">
              {medal(g.rank) ? (
                <span class="text-2xl sm:text-3xl">
                  <span aria-hidden="true">{medal(g.rank)}</span>
                  <span class="sr-only">อันดับ {g.rank}</span>
                </span>
              ) : (
                <span class="text-xl font-black text-[#fff3ae] sm:text-2xl">#{g.rank}</span>
              )}
            </div>

            <div class={`relative z-10 h-14 w-14 shrink-0 overflow-hidden rounded-xl border sm:h-16 sm:w-16 ${top ? "border-[#f8d441]/55" : "border-[#f8d441]/25"}`}>
              <Picture
                src={g.img}
                alt={`ภาพหน้าปกเกม ${g.name} ในอันดับเกมสล็อตยอดนิยมของ AMB194`}
                formats={["avif", "webp"]}
                fallbackFormat="webp"
                loading="lazy"
                fetchpriority="low"
                widths={[100, 200]}
                sizes="(max-width: 640px) 56px, 64px"
                decoding="async"
                class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-110"
              />
            </div>

            <div class="relative z-10 min-w-0 flex-1">
              <div class="flex items-center gap-2">
                <p class="truncate text-base font-black text-[#f5ecd6] sm:text-lg">{g.name}</p>
                {top && (
                  <span class="hidden shrink-0 rounded-full border border-[#f8d441]/70 bg-[#0b0806] px-2 py-0.5 text-[9px] font-black tracking-wider text-[#fff3ae] sm:inline">ยอดนิยมสูงสุด</span>
                )}
              </div>
              <p class="truncate text-[11px] text-[#c9b784] sm:text-xs">{g.type}</p>

              <div class="mt-2 flex flex-wrap items-center gap-1.5">
                {g.menus.map((m) => (
                  <span class="rounded-full border border-[#f8d441]/30 bg-[#0b0806] px-2.5 py-0.5 text-[10px] font-bold text-[#fff3ae]">{m}</span>
                ))}
              </div>
            </div>

            <div class="relative z-10 hidden shrink-0 flex-col items-end gap-1 sm:flex">
              <span class="flex items-center gap-1.5 text-[11px] text-[#c9b784]">
                <span class="h-1.5 w-1.5 animate-pulse rounded-full bg-green-500 shadow-[0_0_6px_rgba(34,197,94,0.6)]" />
                <span class="tabular-nums" data-players data-base={g.players}>
                  {g.players.toLocaleString("en-US")}
                </span>{" "}
                ออนไลน์
              </span>
              <a
                href="/register"
                class={`rounded-full px-4 py-1.5 text-xs font-black transition-transform hover:scale-105 ${
                  top
                    ? "bg-gradient-to-r from-[#fff3ae] via-[#f8d441] to-[#8a6205] text-[#170f02] shadow-[0_10px_30px_rgba(248,212,65,0.28)]"
                    : "border border-[#f8d441]/60 bg-[#0b0806] text-[#fff3ae] hover:border-[#d9a520] hover:bg-[#221807]"
                }`}>
                เข้าดูเกม
              </a>
            </div>
          </article>
        );
      })
    }
  </div>
</section>

<script>
  import { startLiveCounters } from "../lib/liveCounter";

  startLiveCounters();
</script>
