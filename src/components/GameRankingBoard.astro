---
import { Picture } from "astro:assets";
import img1 from "../assets/providers/game1.avif";
import img2 from "../assets/providers/game2.avif";
import img3 from "../assets/providers/game3.avif";
import img4 from "../assets/providers/game4.avif";
import img5 from "../assets/providers/game5.avif";
import img6 from "../assets/providers/game6.avif";

const games = [
  { rank: 1, name: "สล็อตวิดีโอฟรีสปิน", type: "สล็อตวิดีโอ • รอบโบนัสฟรีสปินหลายชั้น", menus: ["ยอดนิยม", "เล่นล่าสุด"], players: 5124, img: img6 },
  { rank: 2, name: "สล็อตแจ็กพอตสะสม", type: "สล็อตแจ็กพอต • รางวัลสะสมจากผู้เล่นหลายคน", menus: ["ยอดนิยม", "รายการโปรด"], players: 3842, img: img3 },
  { rank: 3, name: "สล็อตคลาสสิกสามวงล้อ", type: "สล็อตคลาสสิก • กติกาสั้น เริ่มต้นเข้าใจง่าย", menus: ["ยอดนิยม", "รายการโปรด"], players: 3517, img: img1 },
  { rank: 4, name: "สล็อตความผันผวนต่ำ", type: "สล็อตวิดีโอ • จ่ายบ่อยกว่าแต่รางวัลต่อครั้งไม่สูง", menus: ["เกมใหม่", "เล่นล่าสุด"], players: 2905, img: img2 },
  { rank: 5, name: "สล็อตความผันผวนสูง", type: "สล็อตวิดีโอ • ควรเผื่อเวลาและงบประมาณไว้", menus: ["เกมใหม่", "รายการโปรด"], players: 2431, img: img4 },
  { rank: 6, name: "สล็อตธีมพิเศษจากหลายค่าย", type: "รวมค่ายเกม • เลือกดูตามผู้พัฒนาได้", menus: ["เกมใหม่", "เล่นล่าสุด"], players: 2108, img: img5 },
];

// The medal replaces the rank NUMBER for the top three, so the emoji carries
// information the text does not — it is hidden from assistive tech and the
// meaning is restored by an sr-only span rather than dropped.
const medal = (rank: number) => (rank === 1 ? "🥇" : rank === 2 ? "🥈" : rank === 3 ? "🥉" : null);
---

<section aria-label="อันดับเกมสล็อตยอดนิยมบน DUCK36" class="mx-auto w-full max-w-[1300px] px-4 py-8 font-sans">
  <div class="mb-8 flex w-full flex-col items-center justify-center gap-2 text-center">
    <span aria-hidden="true" class="text-2xl">🏆</span>
    <p class="bg-gradient-to-r from-[#fff8e6] via-[#ffd76a] to-[#d99908] bg-clip-text text-2xl font-black tracking-widest text-transparent uppercase">อันดับเกมสล็อตยอดนิยมบน DUCK36</p>
    <p class="max-w-3xl text-base leading-relaxed text-[#efe3c9]/75">
      รายชื่อด้านล่างใช้เพื่ออ้างอิงความนิยมเท่านั้น ไม่ได้รับประกันผลของเกมใดเกมหนึ่ง ก่อนเลือกควรดูกติกา รูปแบบโบนัส ความผันผวน และวงเงินขั้นต่ำของแต่ละเกม แล้วกำหนดวงเงินและเวลาเล่นให้ชัดเจน
      เพราะรายชื่อในแต่ละหมวดเปลี่ยนแปลงได้ตามช่วงเวลา
    </p>
    <div class="mt-2 h-[3px] w-24 rounded-full bg-gradient-to-r from-transparent via-[#f5b70a] to-transparent"></div>
  </div>

  <div class="flex flex-col gap-3">
    {
      games.map((g) => {
        const top = g.rank === 1;
        return (
          <article
            class={`group relative flex items-center gap-3 overflow-hidden rounded-2xl border p-3 backdrop-blur-md transition-all duration-300 hover:-translate-y-0.5 sm:gap-5 sm:p-4 ${
              top
                ? "border-[#d99908]/50 bg-gradient-to-r from-[#241f13]/95 via-[#12100b]/92 to-[#12100b]/92 shadow-[0_15px_40px_rgba(217,153,8,0.26)]"
                : "border-[#f5b70a]/30 bg-[#12100b]/92 shadow-[0_10px_30px_rgba(245,183,10,0.2)] hover:border-[#d99908]/50 hover:shadow-[0_15px_40px_rgba(217,153,8,0.24)]"
            }`}>
            <div class="pointer-events-none absolute top-1/2 -left-10 h-24 w-24 -translate-y-1/2 rounded-full bg-[#f5b70a]/35 blur-[40px] transition-all duration-500 group-hover:bg-[#d99908]/30" />

            <div class="relative z-10 flex w-8 shrink-0 flex-col items-center justify-center sm:w-12">
              {medal(g.rank) ? (
                <span class="text-2xl sm:text-3xl">
                  <span aria-hidden="true">{medal(g.rank)}</span>
                  <span class="sr-only">อันดับ {g.rank}</span>
                </span>
              ) : (
                <span class="text-xl font-black text-[#ffd76a] sm:text-2xl">#{g.rank}</span>
              )}
            </div>

            <div class={`relative z-10 h-14 w-14 shrink-0 overflow-hidden rounded-xl border sm:h-16 sm:w-16 ${top ? "border-[#d99908]/50" : "border-[#f5b70a]/30"}`}>
              <Picture
                src={g.img}
                alt={`ภาพหน้าปกเกม ${g.name} ในอันดับเกมสล็อตยอดนิยมของ DUCK36`}
                formats={["avif", "webp"]}
                fallbackFormat="webp"
                loading="lazy"
                fetchpriority="low"
                widths={[100, 200]}
                sizes="(max-width: 640px) 56px, 64px"
                decoding="async"
                class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-110"
              />
            </div>

            <div class="relative z-10 min-w-0 flex-1">
              <div class="flex items-center gap-2">
                <p class="truncate text-base font-black text-[#efe3c9] sm:text-lg">{g.name}</p>
                {top && (
                  <span class="hidden shrink-0 rounded-full border border-[#d99908]/70 bg-[#050403] px-2 py-0.5 text-[9px] font-black tracking-wider text-[#f3e3bd] sm:inline">ยอดนิยมสูงสุด</span>
                )}
              </div>
              <p class="truncate text-[11px] text-[#efe3c9]/70 sm:text-xs">{g.type}</p>

              <div class="mt-2 flex flex-wrap items-center gap-1.5">
                {g.menus.map((m) => (
                  <span class="rounded-full border border-[#f5b70a]/30 bg-[#050403] px-2.5 py-0.5 text-[10px] font-bold text-[#ffd76a]">{m}</span>
                ))}
              </div>
            </div>

            <div class="relative z-10 hidden shrink-0 flex-col items-end gap-1 sm:flex">
              <span class="flex items-center gap-1.5 text-[11px] text-[#efe3c9]/70">
                <span class="h-1.5 w-1.5 animate-pulse rounded-full bg-green-500 shadow-[0_0_6px_rgba(34,197,94,0.6)]" />
                <span class="tabular-nums" data-players data-base={g.players}>
                  {g.players.toLocaleString("en-US")}
                </span>{" "}
                ออนไลน์
              </span>
              <a
                href="/register"
                class={`rounded-full px-4 py-1.5 text-xs font-black transition-transform hover:scale-105 ${
                  top
                    ? "bg-gradient-to-r from-[#ffd76a] via-[#f5b70a] to-[#8a5c07] text-[#050403] shadow-[0_10px_30px_rgba(245,183,10,0.28)]"
                    : "border border-[#f5b70a]/60 bg-[#050403] text-[#ffd76a] hover:border-[#d99908] hover:bg-[#1e1a10]"
                }`}>
                เข้าดูเกม
              </a>
            </div>
          </article>
        );
      })
    }
  </div>
</section>

<script>
  import { startLiveCounters } from "../lib/liveCounter";

  startLiveCounters();
</script>
