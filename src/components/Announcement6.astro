---
const {
  // No leading emoji in the message. The badge to its left already shows one,
  // and a decorative glyph baked into a text prop cannot be marked aria-hidden
  // from here — it would be read out ahead of the sentence, three times over,
  // once per marquee copy.
  //
  // Sub-pages call <Announcement /> bare and land on this default, so it has to
  // be the CURRENT brand's copy — index.astro passes the same string explicitly
  // so the two can never drift apart silently.
  message = "HOT189 บาคาร่าเว็บตรง รวมโต๊ะหลายระดับวงเงินไว้ในบัญชีเดียว ควรตรวจขั้นต่ำของโต๊ะ ตัวเลือกเดิมพัน และอัตราจ่ายก่อนเริ่มทุกครั้ง • ตัวเลือก Banker Player และ Tie มีอัตราจ่ายและความน่าจะเป็นต่างกัน ควรเข้าใจวิธีคิดผลและค่าคอมมิชชันก่อนลงเดิมพัน • ระบบฝากถอนออโต้จัดการได้จากหน้าบัญชีโดยตรง ก่อนยืนยันควรตรวจชื่อบัญชี จำนวนเงิน และข้อมูลรับเงินให้ครบ • หากรายการเดิมยังดำเนินการอยู่ ควรรอผลจากระบบก่อนส่งรายการใหม่ • คำว่าแตกง่ายเป็นถ้อยคำทางการตลาด ไม่ใช่การรับประกันผล กำหนดวงเงินและเวลาไว้ก่อนเริ่มทุกครั้ง",
} = Astro.props;
---

<div class="mx-auto max-w-[900px] p-2">
  <div
    class="group relative flex h-[50px] items-center overflow-hidden rounded-full border border-[#ef2b09]/45 bg-gradient-to-b from-[#2e100a] via-[#0d0402] to-[#2e100a] p-1 shadow-[0_5px_20px_rgba(239,43,9,0.22),inset_0_1px_1px_rgba(255,255,255,0.08)]">
    <div class="pointer-events-none absolute -top-6 left-10 h-16 w-16 rounded-full bg-[#fcd304]/20 blur-[30px]"></div>
    <div class="pointer-events-none absolute right-16 -bottom-6 h-16 w-16 rounded-full bg-[#ef2b09]/25 blur-[30px]"></div>

    <div
      class="relative z-10 flex h-full shrink-0 items-center gap-1.5 rounded-full border border-[#ffe86b]/40 bg-gradient-to-b from-[#ffe86b] via-[#fcd304] to-[#c99400] px-3.5 shadow-[inset_0_1px_1px_rgba(255,255,255,0.6)] md:px-4">
      <span class="h-1.5 w-1.5 animate-pulse rounded-full bg-[#2b0a02] shadow-[0_0_6px_rgba(43,10,2,0.8)]"></span>
      <span class="text-xs font-black tracking-wider text-[#2b0a02] uppercase md:text-sm"><span aria-hidden="true">🔥</span> HOT189</span>
    </div>

    <div class="relative z-10 flex-1 overflow-hidden px-4">
      <div class="flex w-max animate-[scroll_18s_linear_infinite] gap-10 text-sm font-bold whitespace-nowrap text-[#ffe9cf]/90">
        <span>{message}</span>
        <span aria-hidden="true" class="text-[#ff7a18]/80">✦</span>
        {/* Copies 2 and 3 exist so the marquee has no visible seam. Only the
            first is announced — otherwise a screen reader reads the whole
            notice three times in a row. */}
        <span aria-hidden="true">{message}</span>
        <span aria-hidden="true" class="text-[#ff7a18]/80">✦</span>
        <span aria-hidden="true">{message}</span>
      </div>
    </div>

    <div class="pointer-events-none absolute inset-x-0 bottom-0 h-[2px] bg-gradient-to-r from-transparent via-[#fcd304]/70 to-transparent opacity-70"></div>
  </div>
</div>

<style>
  @keyframes scroll {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(calc(-33.33% - 13.33px));
    }
  }
</style>
