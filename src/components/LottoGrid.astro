---
const lottos = [
  { name: "หวยรัฐบาลไทย", close: "15:00 น.", reward: "บาทละ 1000", icon: "🇹🇭" },
  { name: "หวยฮานอย", close: "18:00 น.", reward: "บาทละ 95", icon: "🇻🇳" },
  { name: "หวยลาวพัฒนา", close: "20:00 น.", reward: "บาทละ 95", icon: "🇱🇦" },
  { name: "หวยยี่กี 88 รอบ", close: "ทุก 15 นาที", reward: "บาทละ 95", icon: "⏱️" },
  { name: "หวยมาเลย์", close: "18:00 น.", reward: "บาทละ 95", icon: "🇲🇾" },
  { name: "หวยหุ้นไทย", close: "16:40 น.", reward: "บาทละ 95", icon: "📈" },
];
---

<div class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  <div class="mb-8 flex w-full flex-col items-center justify-center gap-2 text-center">
    <h2 class="bg-gradient-to-r from-amber-200 via-amber-300 to-amber-500 bg-clip-text text-3xl leading-normal font-black tracking-widest text-transparent uppercase drop-shadow-sm">
      ตลาดหวยออนไลน์ที่เปิดรับกับ MAHORANLOTTO
    </h2>
    <div class="mt-2 h-[3px] w-24 rounded-full bg-gradient-to-r from-transparent via-amber-400 to-transparent"></div>
  </div>

  <div class="grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-6 lg:gap-5">
    {
      lottos.map((lotto) => (
        <div class="group relative flex cursor-pointer flex-col items-center justify-center overflow-hidden rounded-2xl border border-amber-500/20 bg-[#1a0409]/70 p-5 shadow-lg backdrop-blur-md transition-all duration-300 hover:-translate-y-2 hover:border-amber-400/60 hover:bg-[#5f0914] hover:shadow-[0_10px_30px_rgba(251,191,36,0.25)]">
          <div class="mb-3 text-5xl drop-shadow-[0_0_15px_rgba(251,191,36,0.4)] transition-transform duration-300 group-hover:scale-110">{lotto.icon}</div>
          <p class="text-center text-sm font-bold text-white transition-colors group-hover:text-amber-300">{lotto.name}</p>
          <p class="mt-1 text-[11px] text-amber-100/70">
            ปิดรับ: <span class="font-mono text-amber-300">{lotto.close}</span>
          </p>
          <div class="mt-3 rounded-full bg-gradient-to-r from-amber-500 to-amber-300 px-4 py-1.5 text-[11px] font-bold text-[#5f0914] shadow-md transition-transform duration-300 group-hover:scale-105">
            {lotto.reward}
          </div>
        </div>
      ))
    }
  </div>
</div>

