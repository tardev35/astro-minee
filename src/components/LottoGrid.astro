---
// Chrome, not article: the block's own label is a <p> with the heading classes
// and the region is named by the <section>'s aria-label. Only the docx produces
// a heading on this site.
//
// The close times and payout rates below are the SAME numbers
// LoginRtpSection.astro's reference table prints and the same ones index.astro's
// prose refers to. Move one, move all three.
const lottos = [
  { name: "หวยรัฐบาลไทย", close: "15:00 น.", rate3: "3 ตัวบน 900", rate2: "2 ตัวบน 95", icon: "🇹🇭" },
  { name: "หวยฮานอย", close: "18:00 น.", rate3: "3 ตัวบน 900", rate2: "2 ตัวบน 95", icon: "🇻🇳" },
  { name: "หวยลาวพัฒนา", close: "20:00 น.", rate3: "3 ตัวบน 900", rate2: "2 ตัวบน 95", icon: "🇱🇦" },
  { name: "หวยยี่กี 88 รอบ", close: "ทุก 15 นาที", rate3: "3 ตัวบน 850", rate2: "2 ตัวบน 90", icon: "⏱️" },
  { name: "หวยมาเลย์", close: "18:00 น.", rate3: "3 ตัวบน 900", rate2: "2 ตัวบน 95", icon: "🇲🇾" },
  { name: "หวยหุ้นไทย", close: "16:40 น.", rate3: "3 ตัวบน 850", rate2: "2 ตัวบน 92", icon: "📈" },
];
---

<section aria-label="ประเภทหวยออนไลน์ที่ JAIDEEJING เปิดรับ พร้อมเวลาปิดรับและอัตราจ่ายอ้างอิงของแต่ละรายการ" class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  <div class="mb-8 flex w-full flex-col items-center justify-center gap-2 text-center">
    <p class="bg-gradient-to-r from-[#ffe08a] via-[#f5c451] to-[#c8901a] bg-clip-text text-3xl leading-normal font-black tracking-widest text-transparent uppercase drop-shadow-sm">
      ประเภทหวยออนไลน์ที่เปิดรับกับ JAIDEEJING
    </p>
    <div class="mt-2 h-[3px] w-24 rounded-full bg-gradient-to-r from-transparent via-[#f5c451] to-transparent"></div>
  </div>

  <div class="grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-6 lg:gap-5">
    {
      lottos.map((lotto) => (
        <div class="group relative flex flex-col items-center justify-center overflow-hidden rounded-2xl border border-[#8f1a10]/55 bg-[#2e0b07]/85 p-5 shadow-lg backdrop-blur-md transition-all duration-300 hover:-translate-y-2 hover:border-[#f5c451]/60 hover:bg-[#3a1008] hover:shadow-[0_10px_30px_rgba(245,196,81,0.28)]">
          <div aria-hidden="true" class="mb-3 text-5xl drop-shadow-[0_0_15px_rgba(245,196,81,0.45)] transition-transform duration-300 group-hover:scale-110">
            {lotto.icon}
          </div>
          <p class="text-center text-sm font-bold text-[#f7e4c0] transition-colors group-hover:text-[#ffe08a]">{lotto.name}</p>
          <p class="mt-1 text-[11px] text-[#e0c79c]">
            ปิดรับ: <span class="font-mono text-[#f5c451]">{lotto.close}</span>
          </p>
          <div class="mt-3 rounded-full bg-gradient-to-r from-[#c8901a] via-[#f5c451] to-[#ffe08a] px-4 py-1.5 text-[11px] font-bold text-[#2a0806] shadow-md transition-transform duration-300 group-hover:scale-105">
            {lotto.rate3}
          </div>
          <p class="mt-2 text-[10px] tracking-wide text-[#e0c79c]">{lotto.rate2}</p>
        </div>
      ))
    }
  </div>

  <p class="mt-5 text-center text-[11px] leading-relaxed tracking-wide text-[#e0c79c]">
    เวลาปิดรับและอัตราจ่ายด้านบนเป็นค่าอ้างอิง อาจเปลี่ยนตามงวด ประเภทการเดิมพัน และสถานะเลขที่ระบบแสดงในขณะนั้น ควรตรวจข้อมูลล่าสุดในระบบก่อนกรอกเลขทุกครั้ง
  </p>
</section>
