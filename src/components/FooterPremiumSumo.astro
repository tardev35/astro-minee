---
import { Picture } from "astro:assets";
import BankStrip from "./BankStrip.astro";
import { BRAND_ADDRESS } from "../lib/brandProfile";
const images = import.meta.glob<{ default: ImageMetadata }>("../assets/logo.{png,webp,jpg}", { eager: true });
const imagePaths = Object.keys(images);
const mainLogo = imagePaths.length > 0 ? images[imagePaths[0]].default : null;
---

<footer class="relative mt-16 w-full overflow-hidden rounded-t-[3rem] border-t border-[#f6931e]/60 bg-[#080503] pt-16 pb-8 font-sans text-[#f2dfc4] shadow-[0_-15px_40px_rgba(246,147,30,0.25)]">
  <div class="pointer-events-none absolute inset-x-0 -top-20 mx-auto h-[250px] w-full max-w-4xl rounded-full bg-[#f6931e]/20 blur-[100px]"></div>
  <div class="pointer-events-none absolute inset-x-0 -bottom-24 mx-auto h-[220px] w-full max-w-2xl rounded-full bg-[#8f4b06]/25 blur-[100px]"></div>

  <div class="relative z-10 mx-auto w-full max-w-[1200px] px-6">
    <div class="mb-12 grid grid-cols-1 gap-12 md:grid-cols-12">
      <div class="flex flex-col gap-5 md:col-span-5">
        <a href="/" class="inline-block max-w-max rounded-xl border border-[#f6931e]/30 bg-[#161009] px-4 py-2 transition-transform duration-300 hover:scale-105">
          {
            mainLogo ? (
              <Picture
                src={mainLogo}
                alt="โลโก้ WIN666 ตัวอักษรสีส้มขอบดำ คู่กับตราวงกลมรูปตัว W สีขาวบนพื้นส้ม"
                widths={[130, 260, 390]}
                sizes="130px"
                class="h-[50px] w-auto object-contain"
                formats={["avif", "webp"]}
                fallbackFormat="webp"
              />
            ) : (
              <span class="text-3xl font-black tracking-widest text-[#f2dfc4]">
                WIN<span class="text-[#f6931e]">666</span>
              </span>
            )
          }
        </a>
        <p class="border-l-2 border-[#f6931e]/50 pl-4 text-sm leading-relaxed text-[#c4a882]">
          WIN666 คาสิโนออนไลน์ระบบใหม่ รวมเกมสล็อต บาคาร่า เกมไพ่ และเกมรูปแบบอื่น ๆ ไว้ในบัญชีเดียว รองรับการฝากถอนผ่านระบบออโต้จากหน้าบัญชีของสมาชิกเอง
          พร้อมรายละเอียดเงื่อนไขของแต่ละโปรโมชั่นให้อ่านก่อนกดรับสิทธิ์
        </p>
        <div class="mt-4 flex flex-wrap gap-3">
          <span class="rounded-full border border-[#f6931e]/30 bg-[#161009] px-4 py-1 text-xs font-medium text-[#f6931e] backdrop-blur-sm">โบนัสสมาชิกใหม่ 100%</span>
          <span class="rounded-full border border-[#8f4b06]/50 bg-[#241a0e] px-4 py-1 text-xs font-medium text-[#ffb35c] backdrop-blur-sm">คืนยอดเสียทุกวัน 10%</span>
        </div>
      </div>

      <nav class="flex flex-col gap-4 md:col-span-3 lg:pl-8">
        <p class="text-lg font-black tracking-widest text-[#f2dfc4] uppercase drop-shadow-sm">ทางลัด</p>
        <div class="h-[1px] w-12 bg-[#f6931e]"></div>
        <ul class="flex flex-col gap-3 text-sm font-medium text-[#c4a882]">
          <li><a href="/" class="transition-colors hover:text-[#f6931e]">หน้าหลัก</a></li>
          <li><a href="/promotion" class="transition-colors hover:text-[#f6931e]">โปรโมชั่น</a></li>
          <li><a href="/ทดลองเล่น" class="transition-colors hover:text-[#f6931e]">ทดลองเล่น</a></li>
          <li><a href="/ทางเข้า" class="transition-colors hover:text-[#f6931e]">ทางเข้า</a></li>
          <li><a href="/about-us" class="transition-colors hover:text-[#f6931e]">เกี่ยวกับเรา</a></li>
          <li><a href="/contact-us" class="transition-colors hover:text-[#f6931e]">ติดต่อเรา</a></li>
        </ul>
      </nav>

      <div class="flex flex-col gap-5 md:col-span-4">
        <p class="text-lg font-black tracking-widest text-[#f2dfc4] uppercase drop-shadow-sm">บริการลูกค้า 24 ชม.</p>
        <div class="h-[1px] w-12 bg-[#f6931e]"></div>

        <a
          href="/line"
          class="flex w-full items-center justify-center gap-2 rounded-xl bg-gradient-to-r from-[#00B900] to-[#009900] py-3.5 font-bold text-white shadow-[0_5px_15px_rgba(0,185,0,0.3)] transition-all hover:-translate-y-1 hover:shadow-[0_8px_20px_rgba(0,185,0,0.4)]">
          ติดต่อแอดมิน LINE
        </a>

        {
          BRAND_ADDRESS.lines.length > 0 && (
            <address aria-label={BRAND_ADDRESS.label} class="mt-2 rounded-xl border border-white/15 bg-black/20 p-4 text-xs leading-relaxed not-italic opacity-90">
              <p class="mb-2 flex items-center gap-2 text-[11px] font-bold tracking-wider uppercase opacity-80">
                <span aria-hidden="true" class="text-sm">
                  📍
                </span>
                {BRAND_ADDRESS.label}
              </p>
              {BRAND_ADDRESS.lines.map((line) => (
                <span class="block">{line}</span>
              ))}
              {BRAND_ADDRESS.email && (
                <a
                  href={`mailto:${BRAND_ADDRESS.email}`}
                  class="mt-3 inline-flex items-center gap-2 font-bold underline decoration-current/40 underline-offset-4 opacity-90 transition-opacity hover:opacity-100">
                  <span aria-hidden="true" class="text-sm">
                    ✉️
                  </span>
                  {BRAND_ADDRESS.email}
                </a>
              )}
            </address>
          )
        }

        <div class="mt-4 text-xs font-medium tracking-widest text-[#c4a882] uppercase">Supported Payments</div>
        <BankStrip size={30} />
      </div>
    </div>

    <div class="flex flex-col items-center justify-between border-t border-[#8f4b06]/60 pt-8 text-xs font-medium tracking-wide text-[#c4a882] md:flex-row">
      <p>COPYRIGHT &copy; {new Date().getFullYear()} WIN6666-AUTO.COM. ALL RIGHTS RESERVED.</p>
      <div class="mt-4 flex gap-4 md:mt-0">
        <a href="/terms/" class="transition-colors hover:text-[#f6931e]">เงื่อนไขข้อตกลง</a>
        <a href="/privacy/" class="transition-colors hover:text-[#f6931e]">นโยบายความเป็นส่วนตัว</a>
      </div>
    </div>
  </div>
</footer>

<style>
  footer a {
    text-decoration: none;
    font-family: var(--font-sans);
  }
  footer {
    font-family: var(--font-sans);
  }
</style>
