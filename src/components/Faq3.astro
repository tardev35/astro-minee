---
export interface FaqItem {
  q: string;
  a: string;
}

export interface Props {
  title?: string;
  faqs?: FaqItem[];
}

// The defaults are THIS brand's copy, not a leftover: a bare <Faq3 /> anywhere in
// the site would otherwise fall back to the previous brand's questions. Pages
// that also emit FAQ JSON-LD still pass an explicit `faqs` prop, so the markup
// and the structured data come from the same array.
const {
  title = "คำถามที่พบบ่อยเกี่ยวกับ PATTAYA168",
  faqs = [
    {
      q: "PATTAYA168 รองรับ True Wallet หรือไม่?",
      a: "ระบบถูกนำเสนอว่ารองรับ True Wallet ตามช่องทางที่กำหนด สมาชิกควรตรวจข้อมูลบัญชี จำนวนเงิน และสถานะรายการก่อนและหลังทำธุรกรรมทุกครั้ง",
    },
    {
      q: "เกมลิขสิทธิ์แท้ของ PATTAYA168 ตรวจสอบอย่างไร?",
      a: "ควรดูชื่อผู้ให้บริการ รายละเอียดเกม กติกา และข้อมูลที่ระบบแสดง ไม่ควรใช้คำว่าลิขสิทธิ์แท้เพียงอย่างเดียวเป็นหลักในการประเมินความน่าเชื่อถือ",
    },
    {
      q: "คำว่าจ่ายไวของ PATTAYA168 รับประกันทุกธุรกรรมหรือไม่?",
      a: "ไม่ควรตีความว่าเป็นการรับประกันทุกกรณี เพราะระยะเวลาอาจขึ้นอยู่กับสถานะบัญชี ช่องทางการเงิน และขั้นตอนตรวจสอบของระบบ",
    },
  ],
} = Astro.props;

// The question renders as a <span>, not an <h3>: the docx is flat H1 + H2, so
// the page's heading inventory has no level below the FAQ section's own title.
// The words still reach a parser as structured data — pageGraph() emits each
// pair as a Question/Answer node from the same faqs array.
//
// PATTAYA168: deep teal on the card border and the rule, the brand cyan through
// the heading gradient with gold as its warm end and on the open "+" glyph, and
// pale seafoam answers on a deep-ocean card.
---

<section class="relative z-10 mx-auto mb-10 w-full max-w-[950px] px-4 font-sans">
  {
    title && (
      <header class="mb-8 text-center">
        <h2 class="bg-gradient-to-r from-[#8ff5ff] via-[#02c4e3] to-[#fdac13] bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase drop-shadow-sm md:text-3xl">
          {title}
        </h2>
        <div class="mx-auto mt-3 h-[3px] w-24 rounded-full bg-gradient-to-r from-transparent via-[#02c4e3] to-transparent" />
      </header>
    )
  }

  <div class="space-y-3">
    {
      faqs.map((faq) => (
        <details class="faq-item rounded-3xl border border-[#0c8ba4]/50 bg-[#04222b]/90 p-2 shadow-[0_10px_30px_rgba(2,196,227,0.18)] backdrop-blur-xl transition-all hover:border-[#02c4e3]/70 hover:bg-[#03303c]/90">
          <summary class="flex w-full cursor-pointer items-center justify-between gap-4 p-4 text-left text-[#cfeef7] transition-colors hover:text-[#fdac13]">
            <span class="text-left text-sm leading-normal font-bold md:text-base">{faq.q}</span>
            <span aria-hidden="true" class="faq-icon ml-4 flex h-6 w-6 shrink-0 items-center justify-center text-2xl transition-transform duration-300 ease-in-out">
              +
            </span>
          </summary>

          <div class="faq-answer overflow-hidden">
            <p class="px-4 pb-4 text-left text-base leading-relaxed text-[#cfeef7]/85">{faq.a}</p>
          </div>
        </details>
      ))
    }
  </div>
</section>

<style>
  .faq-item > summary {
    list-style: none;
  }
  .faq-item > summary::-webkit-details-marker {
    display: none;
  }
  .faq-item[open] .faq-icon {
    transform: rotate(45deg);
    color: #fdac13;
  }
  .faq-item[open] .faq-answer {
    animation: faq-reveal 0.25s ease-out;
  }

  @keyframes faq-reveal {
    from {
      opacity: 0;
      transform: translateY(-4px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .faq-item[open] .faq-answer {
      animation: none;
    }
  }
</style>
