---
export interface FaqItem {
  q: string;
  a: string;
}

export interface Props {
  title?: string;
  faqs?: FaqItem[];
}

// The defaults are THIS brand's copy, not a leftover: a bare <Faq3 /> anywhere in
// the site would otherwise fall back to the previous brand's questions. Pages
// that also emit FAQ JSON-LD still pass an explicit `faqs` prop, so the markup
// and the structured data come from the same array.
const {
  title = "คำถามที่พบบ่อยเกี่ยวกับ หวยพร้อม",
  faqs = [
    {
      q: "หวยพร้อม มีหวยประเภทไหนให้เลือกบ้าง?",
      a: "ระบบอาจรวมหวยหลายประเภทตามรายการที่เว็บไซต์กำหนด ผู้ใช้ควรตรวจชื่อหวย รอบออกรางวัล เวลาเปิดปิด และรูปแบบเดิมพันก่อนกรอกโพยทุกครั้ง",
    },
    {
      q: "หวยพร้อม ไม่อั้นเลขทุกตัวจริงหรือไม่?",
      a: "ไม่ควรตีความว่าไม่มีข้อจำกัดทุกเลข เพราะบางงวดอาจมีเลขปิดรับ จำกัดยอด หรือปรับอัตราจ่าย ควรตรวจสถานะล่าสุดจากระบบก่อนยืนยันโพย",
    },
    {
      q: "คำว่าจ่ายเยอะของ หวยพร้อม หมายถึงอะไร?",
      a: "โดยทั่วไปสื่อถึงอัตราจ่ายที่เว็บไซต์กำหนด แต่ราคาอาจต่างกันตามประเภทหวยและเลขที่เลือก จึงควรดูอัตราจ่ายจริงในระบบก่อนทำรายการ",
    },
  ],
} = Astro.props;

// The question renders as a <span>, not an <h3>: the docx is flat H1 + H2, so
// the page's heading inventory has no level below the FAQ section's own title.
// The words still reach a parser as structured data — pageGraph() emits each
// pair as a Question/Answer node from the same faqs array.
//
// หวยพร้อม: deep green on the card border and the rule, prize gold as the second
// metal in the heading gradient and on the open "+" glyph, soft green-white
// answers on a near-black green card.
---

<section class="relative z-10 mx-auto mb-10 w-full max-w-[950px] px-4 font-sans">
  {
    title && (
      <header class="mb-8 text-center">
        <h2 class="bg-gradient-to-r from-[#d8efdc] via-[#22c55e] to-[#f5c451] bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase drop-shadow-sm md:text-3xl">
          {title}
        </h2>
        <div class="mx-auto mt-3 h-[3px] w-24 rounded-full bg-gradient-to-r from-transparent via-[#22c55e] to-transparent" />
      </header>
    )
  }

  <div class="space-y-3">
    {
      faqs.map((faq) => (
        <details class="faq-item rounded-3xl border border-[#1e7a3a]/45 bg-[#0a2413]/90 p-2 shadow-[0_10px_30px_rgba(34,197,94,0.18)] backdrop-blur-xl transition-all hover:border-[#22c55e]/70 hover:bg-[#10361c]/90">
          <summary class="flex w-full cursor-pointer items-center justify-between gap-4 p-4 text-left text-[#d8efdc] transition-colors hover:text-[#f5c451]">
            <span class="text-left text-sm leading-normal font-bold md:text-base">{faq.q}</span>
            <span aria-hidden="true" class="faq-icon ml-4 flex h-6 w-6 shrink-0 items-center justify-center text-2xl transition-transform duration-300 ease-in-out">
              +
            </span>
          </summary>

          <div class="faq-answer overflow-hidden">
            <p class="px-4 pb-4 text-left text-base leading-relaxed text-[#d8efdc]/85">{faq.a}</p>
          </div>
        </details>
      ))
    }
  </div>
</section>

<style>
  .faq-item > summary {
    list-style: none;
  }
  .faq-item > summary::-webkit-details-marker {
    display: none;
  }
  .faq-item[open] .faq-icon {
    transform: rotate(45deg);
    color: #f5c451;
  }
  .faq-item[open] .faq-answer {
    animation: faq-reveal 0.25s ease-out;
  }

  @keyframes faq-reveal {
    from {
      opacity: 0;
      transform: translateY(-4px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .faq-item[open] .faq-answer {
      animation: none;
    }
  }
</style>
