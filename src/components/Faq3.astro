---
export interface FaqItem {
  q: string;
  a: string;
}

export interface Props {
  title?: string;
  faqs?: FaqItem[];
}

// The defaults are THIS brand's copy, not a leftover: a bare <Faq3 /> anywhere in
// the site would otherwise fall back to the previous brand's questions. Pages
// that also emit FAQ JSON-LD still pass an explicit `faqs` prop, so the markup
// and the structured data come from the same array.
const {
  title = "คำถามที่พบบ่อยเกี่ยวกับ MVP928",
  faqs = [
    {
      q: "MVP928 มีโปรโมชั่นหลายรูปแบบหรือไม่?",
      a: "ระบบอาจมีโปรโมชั่นหลายประเภทตามช่วงเวลาและเงื่อนไข ผู้เล่นควรตรวจยอดฝาก เกมที่ร่วมรายการ และข้อกำหนดการถอนก่อนเลือกรับสิทธิ์ทุกครั้ง",
    },
    {
      q: "ระบบออโต้ของ MVP928 ช่วยเรื่องอะไร?",
      a: "ระบบออโต้ช่วยลดขั้นตอนในการจัดการบัญชีและธุรกรรม พร้อมให้สมาชิกตรวจสอบสถานะรายการได้สะดวกขึ้น โดยระยะเวลาดำเนินการอาจแตกต่างตามช่องทาง",
    },
    {
      q: "คำว่าอันดับหนึ่งและแตกง่ายของ MVP928 รับประกันผลหรือไม่?",
      a: "ไม่ควรตีความว่าเป็นการรับประกัน เพราะคำดังกล่าวเป็นข้อความทางการตลาด ผู้เล่นควรดูข้อมูลเกม กติกา RTP ความผันผวน และเงื่อนไขก่อนเริ่มเล่น",
    },
  ],
} = Astro.props;

// The question renders as a <span>, not an <h3>: the docx is flat H1 + H2, so
// the page's heading inventory has no level below the FAQ section's own title.
// The words still reach a parser as structured data — pageGraph() emits each
// pair as a Question/Answer node from the same faqs array.
//
// MVP928: burnt copper on the card border and the rule, gold as the second metal
// in the heading gradient and on the open "+" glyph. Warm ivory answers.
---

<section class="relative z-10 mx-auto mb-10 w-full max-w-[950px] px-4 font-sans">
  {
    title && (
      <header class="mb-8 text-center">
        <h2 class="bg-gradient-to-r from-[#eaeef3] via-[#f0b243] to-[#ef6a17] bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase drop-shadow-sm md:text-3xl">
          {title}
        </h2>
        <div class="mx-auto mt-3 h-[3px] w-24 rounded-full bg-gradient-to-r from-transparent via-[#ef6a17] to-transparent" />
      </header>
    )
  }

  <div class="space-y-3">
    {
      faqs.map((faq) => (
        <details class="faq-item rounded-3xl border border-[#ef6a17]/35 bg-[#1c0e05]/90 p-2 shadow-[0_10px_30px_rgba(239,106,23,0.18)] backdrop-blur-xl transition-all hover:border-[#f0b243]/60 hover:bg-[#2a1508]/90">
          <summary class="flex w-full cursor-pointer items-center justify-between gap-4 p-4 text-left text-[#ece0d6] transition-colors hover:text-[#f0b243]">
            <span class="text-left text-sm leading-normal font-bold md:text-base">{faq.q}</span>
            <span aria-hidden="true" class="faq-icon ml-4 flex h-6 w-6 shrink-0 items-center justify-center text-2xl transition-transform duration-300 ease-in-out">
              +
            </span>
          </summary>

          <div class="faq-answer overflow-hidden">
            <p class="px-4 pb-4 text-left text-base leading-relaxed text-[#ece0d6]/85">{faq.a}</p>
          </div>
        </details>
      ))
    }
  </div>
</section>

<style>
  .faq-item > summary {
    list-style: none;
  }
  .faq-item > summary::-webkit-details-marker {
    display: none;
  }
  .faq-item[open] .faq-icon {
    transform: rotate(45deg);
    color: #f0b243;
  }
  .faq-item[open] .faq-answer {
    animation: faq-reveal 0.25s ease-out;
  }

  @keyframes faq-reveal {
    from {
      opacity: 0;
      transform: translateY(-4px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .faq-item[open] .faq-answer {
      animation: none;
    }
  }
</style>
