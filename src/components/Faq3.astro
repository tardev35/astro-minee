---
export interface FaqItem {
  q: string;
  a: string;
}

export interface Props {
  title?: string;
  faqs?: FaqItem[];
}

// The defaults are THIS brand's copy, not a leftover: a bare <Faq /> anywhere in
// the site would otherwise fall back to the previous brand's questions. Pages
// that also emit FAQ JSON-LD still pass an explicit `faqs` prop, so the markup
// and the structured data come from the same array.
const {
  title = "คำถามที่พบบ่อยเกี่ยวกับ VEGUS1",
  faqs = [
    {
      q: "VEGUS1 รองรับการเดิมพันประเภทใดบ้าง?",
      a: "ระบบสามารถรวมเกมเดิมพันหลายประเภทตามหมวดที่เว็บไซต์กำหนด ผู้เล่นควรตรวจสอบกติกา อัตราจ่าย และระดับความเสี่ยงของเกมที่สนใจก่อนเริ่มทุกครั้ง",
    },
    {
      q: "VEGUS1 รองรับ True Wallet หรือไม่?",
      a: "รองรับ True Wallet ตามช่องทางที่ระบบกำหนด สมาชิกควรตรวจสอบข้อมูลบัญชี จำนวนเงิน และสถานะรายการให้ครบก่อนและหลังยืนยันธุรกรรม",
    },
    {
      q: "คำว่ามั่นคงหมายถึงรับประกันความปลอดภัยทุกกรณีหรือไม่?",
      a: "ไม่ควรตีความว่าเป็นการรับประกันทั้งหมด ความปลอดภัยยังขึ้นอยู่กับระบบ เว็บไซต์ และพฤติกรรมของผู้ใช้ จึงควรตรวจสอบข้อมูลและดูแลบัญชีของตนเองร่วมด้วย",
    },
  ],
} = Astro.props;

// The question renders as a <span>, not an <h3>: the docx is flat H1 + H2, so
// the page's heading inventory has no level below the FAQ section's own title.
// The words still reach a parser as structured data — pageGraph() emits each
// pair as a Question/Answer node from the same faqs array.
---

<section class="relative z-10 mx-auto mb-10 w-full max-w-[950px] px-4 font-sans">
  {
    title && (
      <header class="mb-8 text-center">
        <h2 class="bg-gradient-to-r from-[#ffe08a] via-[#f5c451] to-[#ff3a33] bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase drop-shadow-sm md:text-3xl">
          {title}
        </h2>
        <div class="mx-auto mt-3 h-[3px] w-24 rounded-full bg-gradient-to-r from-transparent via-[#f5c451] to-transparent" />
      </header>
    )
  }

  <div class="space-y-3">
    {
      faqs.map((faq) => (
        <details class="faq-item rounded-3xl border border-[#d81f26]/35 bg-[#2b0808]/90 p-2 shadow-[0_10px_30px_rgba(216,31,38,0.18)] backdrop-blur-xl transition-all hover:border-[#f5c451]/60 hover:bg-[#4a0a0d]/90">
          <summary class="flex w-full cursor-pointer items-center justify-between gap-4 p-4 text-left text-[#f7e3c8] transition-colors hover:text-[#f5c451]">
            <span class="text-left text-sm leading-normal font-bold md:text-base">{faq.q}</span>
            <span aria-hidden="true" class="faq-icon ml-4 flex h-6 w-6 shrink-0 items-center justify-center text-2xl transition-transform duration-300 ease-in-out">
              +
            </span>
          </summary>

          <div class="faq-answer overflow-hidden">
            <p class="px-4 pb-4 text-left text-base leading-relaxed text-[#f7e3c8]/85">{faq.a}</p>
          </div>
        </details>
      ))
    }
  </div>
</section>

<style>
  .faq-item > summary {
    list-style: none;
  }
  .faq-item > summary::-webkit-details-marker {
    display: none;
  }
  .faq-item[open] .faq-icon {
    transform: rotate(45deg);
    color: #f5c451;
  }
  .faq-item[open] .faq-answer {
    animation: faq-reveal 0.25s ease-out;
  }

  @keyframes faq-reveal {
    from {
      opacity: 0;
      transform: translateY(-4px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .faq-item[open] .faq-answer {
      animation: none;
    }
  }
</style>
