---
export interface FaqItem {
  q: string;
  a: string;
}

export interface Props {
  title?: string;
  faqs?: FaqItem[];
}

const { title, faqs = [] } = Astro.props;

// The question renders as a <span>, not an <h3>: the docx is flat H1 + H2, so
// the page's heading inventory has no level below the FAQ section's own title.
// The words still reach a parser as structured data — pageGraph() emits each
// pair as a Question/Answer node from the same faqs array.
---

<section class="relative z-10 mx-auto mb-10 w-full max-w-[950px] px-4 font-sans">
  {
    title && (
      <header class="mb-8 text-center">
        <h2 class="bg-gradient-to-r from-[#fff2e0] via-[#ffb35c] to-[#f6931e] bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase drop-shadow-sm md:text-3xl">
          {title}
        </h2>
        <div class="mx-auto mt-3 h-[3px] w-24 rounded-full bg-gradient-to-r from-transparent via-[#f6931e] to-transparent" />
      </header>
    )
  }

  <div class="space-y-3">
    {
      faqs.map((faq) => (
        <details class="faq-item rounded-3xl border border-[#f6931e]/30 bg-[#161009]/90 p-2 shadow-[0_10px_30px_rgba(246,147,30,0.16)] backdrop-blur-xl transition-all hover:border-[#e07b12]/60 hover:bg-[#241a0e]/90">
          <summary class="flex w-full cursor-pointer items-center justify-between gap-4 p-4 text-left text-[#f2dfc4] transition-colors hover:text-[#ffb35c]">
            <span class="text-left text-sm leading-normal font-bold md:text-base">{faq.q}</span>
            <span aria-hidden="true" class="faq-icon ml-4 flex h-6 w-6 shrink-0 items-center justify-center text-2xl transition-transform duration-300 ease-in-out">
              +
            </span>
          </summary>

          <div class="faq-answer overflow-hidden">
            <p class="px-4 pb-4 text-left text-base leading-relaxed text-[#f2dfc4]/85">{faq.a}</p>
          </div>
        </details>
      ))
    }
  </div>
</section>

<style>
  .faq-item > summary {
    list-style: none;
  }
  .faq-item > summary::-webkit-details-marker {
    display: none;
  }
  .faq-item[open] .faq-icon {
    transform: rotate(45deg);
    color: #ffb35c;
  }
  .faq-item[open] .faq-answer {
    animation: faq-reveal 0.25s ease-out;
  }

  @keyframes faq-reveal {
    from {
      opacity: 0;
      transform: translateY(-4px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .faq-item[open] .faq-answer {
      animation: none;
    }
  }
</style>
