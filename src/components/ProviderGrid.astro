---
// The section title is a <p>, not an <h2>: this grid is chrome that belongs to
// the docx section above it, and the page's heading inventory is diffed against
// the brief. The accessible name for the region lives on the section's
// aria-label instead.
//
// Copy follows the เฮงเฮง888 brief, docx section 2: สล็อตคลาสสิก /
// เกมฟีเจอร์โบนัส / เกมธีมสมัยใหม่, พิจารณาจากกติกา รูปแบบการจ่าย และ
// ความผันผวนของแต่ละเกม, เลือกให้เหมาะกับสไตล์และงบประมาณ, รองรับทั้งมือถือ
// และคอมพิวเตอร์.
const providers = [
  { name: "สล็อตคลาสสิก", desc: "วงล้อรูปแบบพื้นฐาน กติกาสั้น เข้าใจได้เร็ว เหมาะกับการเริ่มต้น", tag: "เข้าใจง่าย", icon: "🎰" },
  { name: "เกมฟีเจอร์โบนัส", desc: "มีรอบโบนัสและฟรีสปิน ควรอ่านเงื่อนไขการเข้าฟีเจอร์ก่อนเริ่ม", tag: "อ่านเงื่อนไขก่อน", icon: "🎁" },
  { name: "เกมธีมสมัยใหม่", desc: "ภาพและจังหวะเกมต่างจากวงล้อพื้นฐาน ลองดูก่อนเลือกให้ตรงความสนใจ", tag: "ลองก่อนเลือก", icon: "✨" },
  { name: "กติกาของแต่ละเกม", desc: "ทำความเข้าใจสัญลักษณ์ ฟีเจอร์ และรอบโบนัสก่อนเริ่มเล่นทุกครั้ง", tag: "เริ่มจากกติกา", icon: "📘" },
  { name: "รูปแบบการจ่าย", desc: "อัตราจ่ายและเส้นจ่ายผูกกับกติกาของเกมนั้น ควรตรวจก่อนทุกครั้ง", tag: "ตรวจอัตราจ่าย", icon: "📊" },
  { name: "ความผันผวนของเกม", desc: "เกมจ่ายบ่อยกับเกมที่ต้องรอรอบ เหมาะกับงบประมาณคนละแบบ", tag: "เทียบความเสี่ยง", icon: "📈" },
  { name: "รองรับหลายอุปกรณ์", desc: "เปิดผ่านเบราว์เซอร์บนมือถือ แท็บเล็ต และคอมพิวเตอร์ด้วยบัญชีเดียว", tag: "ใช้ได้ทุกจอ", icon: "📱" },
];
---

<section aria-label="เกมสล็อตหลายสไตล์ที่ เฮงเฮง888 รวมไว้ในระบบเดียว" class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  <div class="mb-8 flex w-full flex-col items-center justify-center gap-2 text-center">
    <p class="bg-gradient-to-r from-[#ffdf7a] via-[#f5c518] to-[#9fcf3a] bg-clip-text text-3xl font-black tracking-widest text-transparent uppercase">
      เกมสล็อตหลายสไตล์ที่ <span class="text-[#e8f3e0]">เฮงเฮง888</span> รวมไว้ในระบบเดียว
    </p>
    <div class="mt-2 h-[4px] w-24 rounded-full bg-gradient-to-r from-transparent via-[#12a34f] to-transparent"></div>
  </div>

  <div class="grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-4 lg:gap-5 xl:grid-cols-7">
    {
      providers.map((provider) => (
        <a
          href="/register"
          class="group relative flex flex-col items-center justify-center overflow-hidden rounded-2xl border border-[#12a34f]/30 bg-[#072b14]/92 p-5 shadow-[0_10px_30px_rgba(18,163,79,0.2)] backdrop-blur-md transition-all duration-300 hover:-translate-y-2 hover:border-[#1fc465]/60 hover:bg-[#0b3d1d]/95 hover:shadow-[0_15px_40px_rgba(18,163,79,0.34)]">
          <div class="pointer-events-none absolute inset-0 bg-[#05461f]/35 opacity-0 transition-opacity duration-300 group-hover:opacity-100" />

          <div class="absolute top-2 right-2 z-10 rounded-full bg-gradient-to-r from-[#ffdf7a] via-[#f5c518] to-[#b8860b] px-2 py-0.5 text-[9px] font-black tracking-wide whitespace-nowrap text-[#05230f] shadow-sm transition-transform duration-300 group-hover:scale-110">
            {provider.tag}
          </div>

          <div aria-hidden="true" class="mb-3 text-4xl transition-transform duration-300 group-hover:scale-125 group-hover:rotate-3">
            {provider.icon}
          </div>
          <p class="text-center text-sm font-black text-[#e8f3e0] transition-colors group-hover:text-[#c3e558]">{provider.name}</p>
          <p class="mt-1 text-center text-[10px] text-[#a7c295]">{provider.desc}</p>

          <span class="relative z-10 mt-4 block w-full rounded-full border border-[#12a34f]/30 bg-[#03170c] py-1.5 text-center text-[11px] font-bold text-[#9fcf3a] shadow-inner transition-colors duration-300 group-hover:border-[#f5c518]/60 group-hover:bg-gradient-to-r group-hover:from-[#ffdf7a] group-hover:via-[#f5c518] group-hover:to-[#b8860b] group-hover:text-[#05230f]">
            เข้าดูเกม
          </span>
        </a>
      ))
    }
  </div>
</section>
