---
// The section title is a <p>, not an <h2>: this grid is chrome that belongs to
// the docx section above it, and the page's heading inventory is diffed against
// the brief. The accessible name for the region lives on the section's
// aria-label instead.
//
// Copy follows the ORA2U brief, docx section "เริ่มจากเกมที่เข้าใจกติกาง่ายบน
// ORA2U": ธีม ฟีเจอร์ ระดับเดิมพัน กติกาที่ชัดเจน วงเงินต่อรอบ และรูปแบบการจ่าย.
// The tiles name the things the brief says to check and nothing else — no game
// studio is named, because the brief never states which are on the system and an
// invented list is a claim the site cannot back.
const categories = [
  { name: "ธีมของเกม", desc: "แต่ละเกมวางแนวภาพและเสียงไว้ต่างกัน เลือกจากที่ชอบก่อนได้", tag: "เลือกตามสไตล์", icon: "🎨" },
  { name: "รูปแบบฟีเจอร์", desc: "ฟรีสปิน ตัวคูณ และรอบพิเศษไม่เหมือนกันในแต่ละเกม", tag: "อ่านในตัวเกม", icon: "🎁" },
  { name: "ระดับเดิมพัน", desc: "แต่ละเกมกำหนดช่วงเดิมพันต่อรอบไว้ไม่เท่ากัน", tag: "เลือกตามงบ", icon: "🪙" },
  { name: "กติกาที่ชัดเจน", desc: "เพิ่งเริ่มควรเลือกเกมที่อธิบายกติกาไว้ตรงไปตรงมา", tag: "เริ่มจากที่เข้าใจ", icon: "📄" },
  { name: "ตารางจ่ายของเกม", desc: "สัญลักษณ์และรางวัลที่เกมจ่ายระบุไว้ในตัวเกม", tag: "ดูก่อนเริ่ม", icon: "📊" },
  { name: "ค่า RTP ที่ระบุ", desc: "ผู้ให้บริการระบุไว้ ใช้อธิบายลักษณะการจ่ายของเกม", tag: "ดูจากผู้ให้บริการ", icon: "🎯" },
  { name: "รองรับหลายอุปกรณ์", desc: "เปิดผ่านเบราว์เซอร์บนมือถือ แท็บเล็ต และคอมพิวเตอร์ด้วยบัญชีเดียว", tag: "ใช้ได้ทุกจอ", icon: "📱" },
];
---

<section
  aria-label="สิ่งที่ควรดูก่อนเลือกเกมบน ORA2U ทั้งธีมของเกม รูปแบบฟีเจอร์ ระดับเดิมพัน กติกาของเกม ตารางจ่าย และค่า RTP ที่ผู้ให้บริการระบุ"
  class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  <div class="mb-8 flex w-full flex-col items-center justify-center gap-2 text-center">
    <p class="bg-gradient-to-r from-[#fdf3da] via-[#ffd76a] to-[#fe9a00] bg-clip-text text-3xl font-black tracking-widest text-transparent uppercase">
      สิ่งที่ควรดูก่อนเลือกเกมบน <span class="text-[#ffd76a]">ORA2U</span>
    </p>
    <div class="mt-2 h-[4px] w-24 rounded-full bg-gradient-to-r from-transparent via-[#fe9a00] to-transparent"></div>
  </div>

  <div class="grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-4 lg:gap-5 xl:grid-cols-7">
    {
      categories.map((category) => (
        <a
          href="/register"
          class="group relative flex flex-col items-center justify-center overflow-hidden rounded-2xl border border-[#fe9a00]/35 bg-[#170d03]/92 p-5 shadow-[0_10px_30px_rgba(254,154,0,0.22)] backdrop-blur-md transition-all duration-300 hover:-translate-y-2 hover:border-[#ffd76a]/60 hover:bg-[#241503]/95 hover:shadow-[0_15px_40px_rgba(255,183,51,0.3)]">
          <div class="pointer-events-none absolute inset-0 bg-[#b15d01]/25 opacity-0 transition-opacity duration-300 group-hover:opacity-100" />

          <div class="absolute top-2 right-2 z-10 rounded-full bg-gradient-to-r from-[#ffd76a] to-[#fe9a00] px-2 py-0.5 text-[9px] font-black tracking-wide whitespace-nowrap text-[#170d03] shadow-sm transition-transform duration-300 group-hover:scale-110">
            {category.tag}
          </div>

          <div aria-hidden="true" class="mb-3 text-4xl transition-transform duration-300 group-hover:scale-125 group-hover:rotate-3">
            {category.icon}
          </div>
          <p class="text-center text-sm font-black text-[#f6e6cf] transition-colors group-hover:text-[#ffd76a]">{category.name}</p>
          <p class="mt-1 text-center text-[10px] text-[#d6bd94]">{category.desc}</p>

          <span class="relative z-10 mt-4 block w-full rounded-full border border-[#fe9a00]/40 bg-[#0b0501] py-1.5 text-center text-[11px] font-bold text-[#ffd76a] shadow-inner transition-colors duration-300 group-hover:border-[#ffd76a]/60 group-hover:bg-gradient-to-r group-hover:from-[#ffd76a] group-hover:to-[#fe9a00] group-hover:text-[#170d03]">
            เข้าดูรายละเอียด
          </span>
        </a>
      ))
    }
  </div>
</section>
