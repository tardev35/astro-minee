---
// The section title is a <p>, not an <h2>: this grid is chrome that belongs to
// the docx section above it, and the page's heading inventory is diffed against
// the brief. The accessible name for the region lives on the section's
// aria-label instead.
//
// Copy follows the BANANAV3 brief, docx section 2: ผู้ใช้งานสามารถเลือกทั้ง
// บาคาร่าและหวยตามความสนใจ โดยแต่ละประเภทมีรูปแบบเดิมพัน ความเสี่ยง และวิธีคิด
// ผลแตกต่างกัน ควรตรวจสอบกติกา อัตราจ่าย และช่วงเวลารับรายการก่อนเริ่ม. The
// tiles name the two categories the brief names and the things it says to read
// before starting — no game studio and no lottery office is named, because
// nothing in the brief states which are on the system and an invented list is a
// claim the site cannot back.
const categories = [
  { name: "หมวดบาคาร่า", desc: "โต๊ะบาคาร่าแยกเป็นหมวดให้เลือกตามรูปแบบเดิมพันและเงื่อนไขของโต๊ะ", tag: "เลือกโต๊ะ", icon: "🎴" },
  { name: "หมวดหวยออนไลน์", desc: "ประเภทหวยและงวดที่ยังเปิดรับรายการอยู่ ดูได้จากหน้าเดียว", tag: "เลือกประเภทหวย", icon: "🎟️" },
  { name: "รูปแบบเดิมพัน", desc: "แต่ละประเภทมีตัวเลือกเดิมพันไม่เหมือนกัน ควรอ่านให้ครบก่อนกดยืนยัน", tag: "ดูรูปแบบเดิมพัน", icon: "🧭" },
  { name: "กติกาของแต่ละประเภท", desc: "วิธีตัดสินผลของบาคาร่ากับการคิดผลรางวัลหวยใช้เกณฑ์คนละแบบ", tag: "เริ่มจากกติกา", icon: "📘" },
  { name: "อัตราจ่ายอ้างอิง", desc: "อัตราจ่ายของแต่ละตัวเลือกไม่เท่ากัน ควรเทียบก่อนตัดสินใจลงเดิมพัน", tag: "เทียบอัตราจ่าย", icon: "📊" },
  { name: "ช่วงเวลารับรายการ", desc: "หวยมีเวลาปิดรับต่องวด ส่วนโต๊ะบาคาร่าเปิดตามรอบที่ระบบแสดง", tag: "ดูเวลารับรายการ", icon: "⏱️" },
  { name: "รองรับหลายอุปกรณ์", desc: "เปิดผ่านเบราว์เซอร์บนมือถือ แท็บเล็ต และคอมพิวเตอร์ด้วยบัญชีเดียว", tag: "ใช้ได้ทุกจอ", icon: "📱" },
];
---

<section aria-label="เลือกบาคาร่าและหวยบน BANANAV3 พร้อมกติกา อัตราจ่าย และช่วงเวลารับรายการของแต่ละประเภท" class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  <div class="mb-8 flex w-full flex-col items-center justify-center gap-2 text-center">
    <p class="bg-gradient-to-r from-[#ffe97a] via-[#fed624] to-[#e8a317] bg-clip-text text-3xl font-black tracking-widest text-transparent uppercase">
      เลือกบาคาร่าและหวยบน <span class="text-[#fdf1b3]">BANANAV3</span> ได้จากหน้าเดียว
    </p>
    <div class="mt-2 h-[4px] w-24 rounded-full bg-gradient-to-r from-transparent via-[#fed624] to-transparent"></div>
  </div>

  <div class="grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-4 lg:gap-5 xl:grid-cols-7">
    {
      categories.map((category) => (
        <a
          href="/register"
          class="group relative flex flex-col items-center justify-center overflow-hidden rounded-2xl border border-[#e8a317]/30 bg-[#2e1a05]/92 p-5 shadow-[0_10px_30px_rgba(232,163,23,0.2)] backdrop-blur-md transition-all duration-300 hover:-translate-y-2 hover:border-[#fed624]/60 hover:bg-[#241303]/95 hover:shadow-[0_15px_40px_rgba(254,214,36,0.34)]">
          <div class="pointer-events-none absolute inset-0 bg-[#5b3304]/35 opacity-0 transition-opacity duration-300 group-hover:opacity-100" />

          <div class="absolute top-2 right-2 z-10 rounded-full bg-gradient-to-r from-[#ffe97a] via-[#fed624] to-[#e8a317] px-2 py-0.5 text-[9px] font-black tracking-wide whitespace-nowrap text-[#140b02] shadow-sm transition-transform duration-300 group-hover:scale-110">
            {category.tag}
          </div>

          <div aria-hidden="true" class="mb-3 text-4xl transition-transform duration-300 group-hover:scale-125 group-hover:rotate-3">
            {category.icon}
          </div>
          <p class="text-center text-sm font-black text-[#fdf1b3] transition-colors group-hover:text-[#fed624]">{category.name}</p>
          <p class="mt-1 text-center text-[10px] text-[#d9bd82]">{category.desc}</p>

          <span class="relative z-10 mt-4 block w-full rounded-full border border-[#e8a317]/30 bg-[#140b02] py-1.5 text-center text-[11px] font-bold text-[#fed624] shadow-inner transition-colors duration-300 group-hover:border-[#fed624]/60 group-hover:bg-gradient-to-r group-hover:from-[#ffe97a] group-hover:via-[#fed624] group-hover:to-[#e8a317] group-hover:text-[#140b02]">
            เข้าดูหมวดนี้
          </span>
        </a>
      ))
    }
  </div>
</section>
