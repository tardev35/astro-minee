---
// The section title is a <p>, not an <h2>: this grid is chrome that belongs to
// the docx section above it, and the page's heading inventory is diffed against
// the brief. The accessible name for the region lives on the section's
// aria-label instead.
//
// Copy follows the MVP928 brief, docx section "ระบบใหม่ของ MVP928 ช่วยให้เข้าถึง
// เกมได้ง่ายขึ้น": ค้นหาเกม โปรโมชั่น และข้อมูลบัญชีจากจุดเดียว พร้อมการจัดหมวดเกม
// ที่ชัดเจนเพื่อเปรียบเทียบฟีเจอร์และรูปแบบการเล่นก่อนเลือก. The tiles name the
// things the brief says to compare and nothing else — no game studio is named,
// because the brief never states which are on the system and an invented list is
// a claim the site cannot back.
const categories = [
  { name: "หมวดของเกม", desc: "ระบบจัดกลุ่มเกมไว้ให้ไล่ดูจากจุดเดียว ไม่ต้องสลับหน้า", tag: "เริ่มจากหมวด", icon: "🗂️" },
  { name: "ธีมของเกม", desc: "แต่ละเกมวางแนวภาพและเสียงไว้ต่างกัน เลือกจากที่ชอบก่อนได้", tag: "เลือกตามสไตล์", icon: "🎨" },
  { name: "รูปแบบฟีเจอร์", desc: "ฟรีสปิน ตัวคูณ และรอบพิเศษไม่เหมือนกันในแต่ละเกม", tag: "เทียบก่อนเลือก", icon: "🎁" },
  { name: "ระดับเดิมพัน", desc: "แต่ละเกมกำหนดช่วงเดิมพันต่อรอบไว้ไม่เท่ากัน", tag: "เลือกตามงบ", icon: "🪙" },
  { name: "ค่า RTP ที่ระบุ", desc: "ผู้ให้บริการระบุไว้ ใช้อธิบายลักษณะการจ่ายของเกม", tag: "ดูจากผู้ให้บริการ", icon: "🎯" },
  { name: "ระดับความผันผวน", desc: "ผันผวนสูงและต่ำให้จังหวะการจ่ายต่างกันไปในแต่ละเกม", tag: "ดูคู่กับงบ", icon: "📈" },
  { name: "รองรับหลายอุปกรณ์", desc: "เปิดผ่านเบราว์เซอร์บนมือถือ แท็บเล็ต และคอมพิวเตอร์ด้วยบัญชีเดียว", tag: "ใช้ได้ทุกจอ", icon: "📱" },
];
---

<section
  aria-label="สิ่งที่ระบบของ MVP928 จัดไว้ให้เปรียบเทียบก่อนเลือกเกม ทั้งหมวดของเกม ธีม รูปแบบฟีเจอร์ ระดับเดิมพัน ค่า RTP ที่ผู้ให้บริการระบุ และระดับความผันผวน"
  class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  <div class="mb-8 flex w-full flex-col items-center justify-center gap-2 text-center">
    <p class="bg-gradient-to-r from-[#eaeef3] via-[#f0b243] to-[#ef6a17] bg-clip-text text-3xl font-black tracking-widest text-transparent uppercase">
      หมวดที่ระบบ <span class="text-[#f0b243]">MVP928</span> จัดไว้ให้เทียบก่อนเลือกเกม
    </p>
    <div class="mt-2 h-[4px] w-24 rounded-full bg-gradient-to-r from-transparent via-[#ef6a17] to-transparent"></div>
  </div>

  <div class="grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-4 lg:gap-5 xl:grid-cols-7">
    {
      categories.map((category) => (
        <a
          href="/register"
          class="group relative flex flex-col items-center justify-center overflow-hidden rounded-2xl border border-[#ef6a17]/35 bg-[#1c0e05]/92 p-5 shadow-[0_10px_30px_rgba(239,106,23,0.22)] backdrop-blur-md transition-all duration-300 hover:-translate-y-2 hover:border-[#f0b243]/60 hover:bg-[#2a1508]/95 hover:shadow-[0_15px_40px_rgba(251,139,50,0.3)]">
          <div class="pointer-events-none absolute inset-0 bg-[#b34a08]/25 opacity-0 transition-opacity duration-300 group-hover:opacity-100" />

          <div class="absolute top-2 right-2 z-10 rounded-full bg-gradient-to-r from-[#f0b243] to-[#ef6a17] px-2 py-0.5 text-[9px] font-black tracking-wide whitespace-nowrap text-[#1c0e05] shadow-sm transition-transform duration-300 group-hover:scale-110">
            {category.tag}
          </div>

          <div aria-hidden="true" class="mb-3 text-4xl transition-transform duration-300 group-hover:scale-125 group-hover:rotate-3">
            {category.icon}
          </div>
          <p class="text-center text-sm font-black text-[#ece0d6] transition-colors group-hover:text-[#f0b243]">{category.name}</p>
          <p class="mt-1 text-center text-[10px] text-[#c6ab97]">{category.desc}</p>

          <span class="relative z-10 mt-4 block w-full rounded-full border border-[#ef6a17]/40 bg-[#0b0502] py-1.5 text-center text-[11px] font-bold text-[#f0b243] shadow-inner transition-colors duration-300 group-hover:border-[#f0b243]/60 group-hover:bg-gradient-to-r group-hover:from-[#f0b243] group-hover:to-[#ef6a17] group-hover:text-[#1c0e05]">
            เข้าดูรายละเอียด
          </span>
        </a>
      ))
    }
  </div>
</section>
