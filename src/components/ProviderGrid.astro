---
// The section title is a <p>, not an <h2>: this grid is chrome that belongs to
// the docx section above it, and the page's heading inventory is diffed against
// the brief. The accessible name for the region lives on the section's
// aria-label instead.
//
// Copy follows the DIAMOND789 brief, docx section "เลือกค่ายเกมสล็อตจากข้อมูล
// จริงบน DIAMOND789": ชื่อผู้ให้บริการ ค่าย ธีม รูปแบบฟีเจอร์ ตารางจ่าย และ
// รายละเอียดเกม. The tiles name the things the brief says to check and nothing
// else — no game studio is named, because the brief never states which are on
// the system and an invented list is a claim the site cannot back.
const categories = [
  { name: "ชื่อผู้ให้บริการ", desc: "ดูว่าเกมนั้นมาจากค่ายใด ก่อนตัดสินจากชื่อเกมเพียงอย่างเดียว", tag: "ตรวจก่อนเลือก", icon: "💠" },
  { name: "ธีมของเกม", desc: "แต่ละค่ายวางแนวภาพและเสียงไว้ต่างกัน เลือกจากที่ชอบก่อนได้", tag: "เลือกตามสไตล์", icon: "🎨" },
  { name: "รูปแบบฟีเจอร์", desc: "ฟรีสปิน ตัวคูณ และรอบพิเศษไม่เหมือนกันในแต่ละเกม", tag: "อ่านในตัวเกม", icon: "🎁" },
  { name: "ตารางจ่ายของเกม", desc: "สัญลักษณ์และรางวัลที่เกมจ่ายระบุไว้ในตัวเกม", tag: "ดูก่อนหมุน", icon: "📊" },
  { name: "รายละเอียดเกม", desc: "กติกา จำนวนไลน์ และเงื่อนไขรอบพิเศษเขียนไว้ในหน้าเกม", tag: "อ่านให้ครบ", icon: "📄" },
  { name: "ค่า RTP ที่ระบุ", desc: "ผู้ให้บริการระบุไว้ ใช้อธิบายลักษณะการจ่ายของเกม", tag: "ดูจากผู้ให้บริการ", icon: "🎯" },
  { name: "รองรับหลายอุปกรณ์", desc: "เปิดผ่านเบราว์เซอร์บนมือถือ แท็บเล็ต และคอมพิวเตอร์ด้วยบัญชีเดียว", tag: "ใช้ได้ทุกจอ", icon: "📱" },
];
---

<section
  aria-label="สิ่งที่ควรดูก่อนเลือกค่ายเกมสล็อตบน DIAMOND789 ทั้งชื่อผู้ให้บริการ ธีมของเกม รูปแบบฟีเจอร์ ตารางจ่าย รายละเอียดเกม และค่า RTP ที่ผู้ให้บริการระบุ"
  class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  <div class="mb-8 flex w-full flex-col items-center justify-center gap-2 text-center">
    <p class="bg-gradient-to-r from-[#e8e8ef] via-[#ff5cb8] to-[#f30d8c] bg-clip-text text-3xl font-black tracking-widest text-transparent uppercase">
      ข้อมูลค่ายเกมที่ควรดูบน <span class="text-[#ff5cb8]">DIAMOND789</span>
    </p>
    <div class="mt-2 h-[4px] w-24 rounded-full bg-gradient-to-r from-transparent via-[#f30d8c] to-transparent"></div>
  </div>

  <div class="grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-4 lg:gap-5 xl:grid-cols-7">
    {
      categories.map((category) => (
        <a
          href="/register"
          class="group relative flex flex-col items-center justify-center overflow-hidden rounded-2xl border border-[#f30d8c]/35 bg-[#1a0d16]/92 p-5 shadow-[0_10px_30px_rgba(243,13,140,0.22)] backdrop-blur-md transition-all duration-300 hover:-translate-y-2 hover:border-[#ff5cb8]/60 hover:bg-[#2a1122]/95 hover:shadow-[0_15px_40px_rgba(255,92,184,0.3)]">
          <div class="pointer-events-none absolute inset-0 bg-[#5c0a33]/25 opacity-0 transition-opacity duration-300 group-hover:opacity-100" />

          <div class="absolute top-2 right-2 z-10 rounded-full bg-gradient-to-r from-[#ff5cb8] to-[#f30d8c] px-2 py-0.5 text-[9px] font-black tracking-wide whitespace-nowrap text-[#070308] shadow-sm transition-transform duration-300 group-hover:scale-110">
            {category.tag}
          </div>

          <div aria-hidden="true" class="mb-3 text-4xl transition-transform duration-300 group-hover:scale-125 group-hover:rotate-3">
            {category.icon}
          </div>
          <p class="text-center text-sm font-black text-[#f8e3f0] transition-colors group-hover:text-[#ff5cb8]">{category.name}</p>
          <p class="mt-1 text-center text-[10px] text-[#d9b6cc]">{category.desc}</p>

          <span class="relative z-10 mt-4 block w-full rounded-full border border-[#f30d8c]/40 bg-[#070308] py-1.5 text-center text-[11px] font-bold text-[#ff5cb8] shadow-inner transition-colors duration-300 group-hover:border-[#ff5cb8]/60 group-hover:bg-gradient-to-r group-hover:from-[#ff5cb8] group-hover:to-[#f30d8c] group-hover:text-[#070308]">
            เข้าดูรายละเอียด
          </span>
        </a>
      ))
    }
  </div>
</section>
