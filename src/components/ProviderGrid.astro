---
const providers = [
  { name: "สล็อตออนไลน์", desc: "วงล้อหลายรูปแบบ ตั้งแต่กติกาสั้นไปจนถึงเกมที่มีรอบโบนัสหลายชั้น", tag: "เลือกตามธีม", icon: "🎰" },
  { name: "บาคาร่า", desc: "กติกาสั้น เข้าใจง่าย ควรดูอัตราจ่ายและเงื่อนไขของแต่ละโต๊ะก่อนลง", tag: "กติกาเข้าใจง่าย", icon: "🃏" },
  { name: "รูเล็ต", desc: "เดิมพันได้หลายรูปแบบในรอบเดียว อัตราจ่ายต่างกันตามช่องที่เลือก", tag: "อัตราจ่ายต่างกัน", icon: "🎡" },
  { name: "เกมไพ่รูปแบบอื่น", desc: "เสือมังกร ป็อกเด้ง และเกมไพ่อื่น ๆ ที่มีเงื่อนไขการจ่ายต่างกัน", tag: "อ่านเงื่อนไขก่อน", icon: "🂡" },
  { name: "คาสิโนสด", desc: "โต๊ะถ่ายทอดสดมีเวลาต่อรอบจำกัด ควรดูวงเงินขั้นต่ำของโต๊ะก่อนเข้า", tag: "ดูวงเงินโต๊ะ", icon: "🎥" },
  { name: "เกมที่มีรอบโบนัส", desc: "รอบพิเศษของแต่ละเกมมีเงื่อนไขไม่เหมือนกัน ควรอ่านกติกาก่อนเริ่ม", tag: "ดูรอบพิเศษ", icon: "🎁" },
  { name: "เลือกตามความผันผวน", desc: "เกมจ่ายบ่อยกับเกมที่ต้องรอรอบทำเงินเหมาะกับงบประมาณคนละแบบ", tag: "ดูงบก่อนเลือก", icon: "📈" },
];
---

<section aria-label="หมวดเกมคาสิโนที่ BUGGY888 รวมไว้ในระบบเดียว" class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  <div class="mb-8 flex w-full flex-col items-center justify-center gap-2 text-center">
    <p class="bg-gradient-to-r from-[#fff3cf] via-[#ffd233] to-[#e0a81c] bg-clip-text text-3xl font-black tracking-widest text-transparent uppercase">
      หมวดเกมคาสิโนที่ <span class="text-[#ffe98a]">BUGGY888</span> รวมไว้ในระบบเดียว
    </p>
    <div class="mt-2 h-[4px] w-24 rounded-full bg-gradient-to-r from-transparent via-[#ffd233] to-transparent"></div>
  </div>

  <div class="grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-4 lg:gap-5 xl:grid-cols-7">
    {
      providers.map((provider) => (
        <a
          href="/register"
          class="group relative flex flex-col items-center justify-center overflow-hidden rounded-2xl border border-[#ffd233]/30 bg-[#1b0806]/92 p-5 shadow-[0_10px_30px_rgba(255,210,51,0.2)] backdrop-blur-md transition-all duration-300 hover:-translate-y-2 hover:border-[#ffd233]/60 hover:bg-[#2a0d09]/95 hover:shadow-[0_15px_40px_rgba(232,36,26,0.3)]">
          <div class="pointer-events-none absolute inset-0 bg-[#e8241a]/12 opacity-0 transition-opacity duration-300 group-hover:opacity-100" />

          <div class="absolute top-2 right-2 z-10 rounded-full bg-gradient-to-r from-[#fff3cf] via-[#ffd233] to-[#8d630b] px-2 py-0.5 text-[9px] font-black tracking-wide whitespace-nowrap text-[#2a0704] shadow-sm transition-transform duration-300 group-hover:scale-110">
            {provider.tag}
          </div>

          <div aria-hidden="true" class="mb-3 text-4xl transition-transform duration-300 group-hover:scale-125 group-hover:rotate-3">
            {provider.icon}
          </div>
          <p class="text-center text-sm font-black text-[#f7e2c4] transition-colors group-hover:text-[#fff3cf]">{provider.name}</p>
          <p class="mt-1 text-center text-[10px] text-[#d6ab7e]">{provider.desc}</p>

          <span class="relative z-10 mt-4 block w-full rounded-full border border-[#ffd233]/30 bg-[#0b0302] py-1.5 text-center text-[11px] font-bold text-[#ffe98a] shadow-inner transition-colors duration-300 group-hover:border-[#ffd233]/60 group-hover:bg-gradient-to-r group-hover:from-[#fff3cf] group-hover:via-[#ffd233] group-hover:to-[#8d630b] group-hover:text-[#2a0704]">
            เข้าดูเกม
          </span>
        </a>
      ))
    }
  </div>
</section>
