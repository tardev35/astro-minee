---
const providers = [
  { name: "สล็อตคลาสสิก", desc: "วงล้อไม่กี่แถว กติกาสั้น เหมาะกับการเริ่มตามงบที่วางไว้", tag: "กติกาเข้าใจง่าย", icon: "🎰" },
  { name: "สล็อตวิดีโอ", desc: "หลายเพย์ไลน์พร้อมภาพและเสียงประกอบ มีฟีเจอร์ให้ศึกษาก่อนเล่น", tag: "ฟีเจอร์หลากหลาย", icon: "🎬" },
  { name: "สล็อตโบนัสฟรีสปิน", desc: "รอบพิเศษของแต่ละเกมมีเงื่อนไขต่างกัน ควรอ่านกติกาก่อนเริ่ม", tag: "อ่านเงื่อนไขก่อน", icon: "🎁" },
  { name: "สล็อตแจ็กพอตสะสม", desc: "รางวัลสะสมจากผู้เล่นหลายคน จังหวะออกไม่แน่นอน ควรกำหนดวงเงิน", tag: "รางวัลสะสม", icon: "💎" },
  { name: "เกมความผันผวนต่ำ", desc: "จ่ายบ่อยกว่าแต่รางวัลต่อครั้งไม่สูง เหมาะกับการเล่นแบบค่อยเป็นค่อยไป", tag: "จ่ายบ่อยกว่า", icon: "📈" },
  { name: "เกมความผันผวนสูง", desc: "อาจต้องรอนานกว่าจะถึงรอบทำเงิน ควรเผื่อเวลาและงบประมาณไว้", tag: "รอรอบทำเงิน", icon: "🌪️" },
  { name: "เลือกตามค่ายเกม", desc: "รวมสล็อตจากหลายค่ายไว้ในระบบเดียว เลือกดูตามผู้พัฒนาได้", tag: "หลายค่ายในที่เดียว", icon: "🏷️" },
];
---

<section aria-label="หมวดเกมสล็อตที่ DUCK36 รวมไว้ในระบบเดียว" class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  <div class="mb-8 flex w-full flex-col items-center justify-center gap-2 text-center">
    <p class="bg-gradient-to-r from-[#fff8e6] via-[#ffd76a] to-[#f5b70a] bg-clip-text text-3xl font-black tracking-widest text-transparent uppercase">
      หมวดเกมสล็อตที่ <span class="text-[#ffcf4d]">DUCK36</span> รวมไว้ในระบบเดียว
    </p>
    <div class="mt-2 h-[4px] w-24 rounded-full bg-gradient-to-r from-transparent via-[#f5b70a] to-transparent"></div>
  </div>

  <div class="grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-4 lg:gap-5 xl:grid-cols-7">
    {
      providers.map((provider) => (
        <a
          href="/register"
          class="group relative flex flex-col items-center justify-center overflow-hidden rounded-2xl border border-[#f5b70a]/30 bg-[#12100b]/92 p-5 shadow-[0_10px_30px_rgba(245,183,10,0.2)] backdrop-blur-md transition-all duration-300 hover:-translate-y-2 hover:border-[#ffcf4d]/50 hover:bg-[#1e1a10]/95 hover:shadow-[0_15px_40px_rgba(217,153,8,0.28)]">
          <div class="pointer-events-none absolute inset-0 bg-[#f5b70a]/12 opacity-0 transition-opacity duration-300 group-hover:opacity-100" />

          <div class="absolute top-2 right-2 z-10 rounded-full bg-gradient-to-r from-[#fff8e6] via-[#ffcf4d] to-[#8a5c07] px-2 py-0.5 text-[9px] font-black tracking-wide whitespace-nowrap text-[#050403] shadow-sm transition-transform duration-300 group-hover:scale-110">
            {provider.tag}
          </div>

          <div aria-hidden="true" class="mb-3 text-4xl transition-transform duration-300 group-hover:scale-125 group-hover:rotate-3">
            {provider.icon}
          </div>
          <p class="text-center text-sm font-black text-[#efe3c9] transition-colors group-hover:text-[#fff8e6]">{provider.name}</p>
          <p class="mt-1 text-center text-[10px] text-[#efe3c9]/70">{provider.desc}</p>

          <span class="relative z-10 mt-4 block w-full rounded-full border border-[#f5b70a]/30 bg-[#050403] py-1.5 text-center text-[11px] font-bold text-[#ffd76a] shadow-inner transition-colors duration-300 group-hover:border-[#ffcf4d]/50 group-hover:bg-gradient-to-r group-hover:from-[#fff8e6] group-hover:via-[#ffcf4d] group-hover:to-[#8a5c07] group-hover:text-[#050403]">
            เข้าดูเกม
          </span>
        </a>
      ))
    }
  </div>
</section>
