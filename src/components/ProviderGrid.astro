---
// The section title is a <p>, not an <h2>: this grid is chrome that belongs to
// the docx section above it, and the page's heading inventory is diffed against
// the brief. The accessible name for the region lives on the section's
// aria-label instead.
//
// Copy follows the LASVEGAS889 brief, docx section 2: เกมสล็อตหลายแนวและบาคาร่า
// ในรูปแบบต่าง ๆ ให้เลือกตามความสนใจ, พิจารณาจากกติกา ฟีเจอร์ ระดับความเสี่ยง
// และรูปแบบการจ่าย, มากกว่าการเลือกตามกระแสเพียงอย่างเดียว.
const providers = [
  { name: "เกมสล็อตหลายแนว", desc: "หลายธีมและหลายจังหวะเกม เลือกได้ตามความสนใจของตัวเอง", tag: "เลือกตามความสนใจ", icon: "🎰" },
  { name: "บาคาร่าหลายรูปแบบ", desc: "กติกาชัดเจน มีตัวเลือกการเดิมพันให้พิจารณาก่อนลงมือ", tag: "กติกาชัดเจน", icon: "🃏" },
  { name: "กติกาของแต่ละเกม", desc: "อ่านสัญลักษณ์ เงื่อนไข และรอบพิเศษให้เข้าใจก่อนเริ่มเล่น", tag: "เริ่มจากกติกา", icon: "📘" },
  { name: "ฟีเจอร์ภายในเกม", desc: "แต่ละเกมมีฟีเจอร์และรอบโบนัสต่างกัน ควรดูรายละเอียดก่อนเลือก", tag: "ดูฟีเจอร์ก่อน", icon: "✨" },
  { name: "ระดับความเสี่ยง", desc: "เกมที่จ่ายบ่อยกับเกมที่ต้องรอรอบ เหมาะกับงบประมาณคนละแบบ", tag: "เทียบความเสี่ยง", icon: "📈" },
  { name: "รูปแบบการจ่าย", desc: "เส้นจ่ายและอัตราจ่ายไม่เท่ากัน ควรเทียบก่อนเลือกเกมที่จะเล่น", tag: "เทียบอัตราจ่าย", icon: "📊" },
  { name: "รองรับหลายอุปกรณ์", desc: "เปิดผ่านเบราว์เซอร์บนมือถือ แท็บเล็ต และคอมพิวเตอร์ด้วยบัญชีเดียว", tag: "ใช้ได้ทุกจอ", icon: "📱" },
];
---

<section aria-label="สล็อตและบาคาร่าที่ LASVEGAS889 รวมไว้ในระบบเดียว" class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  <div class="mb-8 flex w-full flex-col items-center justify-center gap-2 text-center">
    <p class="bg-gradient-to-r from-[#ffdd7a] via-[#f2b829] to-[#3fdcff] bg-clip-text text-3xl font-black tracking-widest text-transparent uppercase">
      สล็อตและบาคาร่าที่ <span class="text-[#e8eefb]">LASVEGAS889</span> รวมไว้ในระบบเดียว
    </p>
    <div class="mt-2 h-[4px] w-24 rounded-full bg-gradient-to-r from-transparent via-[#3fdcff] to-transparent"></div>
  </div>

  <div class="grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-4 lg:gap-5 xl:grid-cols-7">
    {
      providers.map((provider) => (
        <a
          href="/register"
          class="group relative flex flex-col items-center justify-center overflow-hidden rounded-2xl border border-[#1f5ce0]/30 bg-[#0b1740]/92 p-5 shadow-[0_10px_30px_rgba(31,92,224,0.2)] backdrop-blur-md transition-all duration-300 hover:-translate-y-2 hover:border-[#3fdcff]/60 hover:bg-[#122a63]/95 hover:shadow-[0_15px_40px_rgba(63,220,255,0.34)]">
          <div class="pointer-events-none absolute inset-0 bg-[#122a63]/35 opacity-0 transition-opacity duration-300 group-hover:opacity-100" />

          <div class="absolute top-2 right-2 z-10 rounded-full bg-gradient-to-r from-[#ffdd7a] via-[#f2b829] to-[#a8760d] px-2 py-0.5 text-[9px] font-black tracking-wide whitespace-nowrap text-[#050b24] shadow-sm transition-transform duration-300 group-hover:scale-110">
            {provider.tag}
          </div>

          <div aria-hidden="true" class="mb-3 text-4xl transition-transform duration-300 group-hover:scale-125 group-hover:rotate-3">
            {provider.icon}
          </div>
          <p class="text-center text-sm font-black text-[#cddcf7] transition-colors group-hover:text-[#3fdcff]">{provider.name}</p>
          <p class="mt-1 text-center text-[10px] text-[#7f96c4]">{provider.desc}</p>

          <span class="relative z-10 mt-4 block w-full rounded-full border border-[#1f5ce0]/30 bg-[#050b24] py-1.5 text-center text-[11px] font-bold text-[#3fdcff] shadow-inner transition-colors duration-300 group-hover:border-[#f2b829]/60 group-hover:bg-gradient-to-r group-hover:from-[#ffdd7a] group-hover:via-[#f2b829] group-hover:to-[#a8760d] group-hover:text-[#050b24]">
            เข้าดูเกม
          </span>
        </a>
      ))
    }
  </div>
</section>
