---
const providers = [
  { name: "สล็อตออนไลน์", desc: "วงล้อหลายรูปแบบ ตั้งแต่กติกาสั้นไปจนถึงเกมที่มีรอบโบนัสหลายชั้น", tag: "เลือกตามธีม", icon: "🎰" },
  { name: "บาคาร่า", desc: "กติกาสั้น เข้าใจง่าย ควรดูอัตราจ่ายและเงื่อนไขของแต่ละโต๊ะก่อนลง", tag: "กติกาเข้าใจง่าย", icon: "🃏" },
  { name: "เกมไพ่รูปแบบอื่น", desc: "เสือมังกร ป็อกเด้ง และเกมไพ่อื่น ๆ ที่มีเงื่อนไขการจ่ายต่างกัน", tag: "อ่านเงื่อนไขก่อน", icon: "🂡" },
  { name: "รูเล็ต", desc: "เดิมพันได้หลายรูปแบบในรอบเดียว อัตราจ่ายต่างกันตามช่องที่เลือก", tag: "อัตราจ่ายต่างกัน", icon: "🎡" },
  { name: "ไฮโลและเกมลูกเต๋า", desc: "รอบเล่นสั้นและจบเร็ว ควรกำหนดวงเงินต่อรอบไว้ล่วงหน้า", tag: "กำหนดวงเงิน", icon: "🎲" },
  { name: "เกมที่มีรอบโบนัส", desc: "รอบพิเศษของแต่ละเกมมีเงื่อนไขไม่เหมือนกัน ควรอ่านกติกาก่อนเริ่ม", tag: "ดูรอบพิเศษ", icon: "🎁" },
  { name: "เลือกตามความผันผวน", desc: "เกมจ่ายบ่อยกับเกมที่ต้องรอรอบทำเงินเหมาะกับงบประมาณคนละแบบ", tag: "ดูงบก่อนเลือก", icon: "📈" },
];
---

<section aria-label="หมวดเกมคาสิโนที่ WIN666 รวมไว้ในระบบเดียว" class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  <div class="mb-8 flex w-full flex-col items-center justify-center gap-2 text-center">
    <p class="bg-gradient-to-r from-[#fff2e0] via-[#ffb35c] to-[#f6931e] bg-clip-text text-3xl font-black tracking-widest text-transparent uppercase">
      หมวดเกมคาสิโนที่ <span class="text-[#ffa943]">WIN666</span> รวมไว้ในระบบเดียว
    </p>
    <div class="mt-2 h-[4px] w-24 rounded-full bg-gradient-to-r from-transparent via-[#f6931e] to-transparent"></div>
  </div>

  <div class="grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-4 lg:gap-5 xl:grid-cols-7">
    {
      providers.map((provider) => (
        <a
          href="/register"
          class="group relative flex flex-col items-center justify-center overflow-hidden rounded-2xl border border-[#f6931e]/30 bg-[#161009]/92 p-5 shadow-[0_10px_30px_rgba(246,147,30,0.2)] backdrop-blur-md transition-all duration-300 hover:-translate-y-2 hover:border-[#ffa943]/50 hover:bg-[#241a0e]/95 hover:shadow-[0_15px_40px_rgba(224,123,18,0.28)]">
          <div class="pointer-events-none absolute inset-0 bg-[#f6931e]/12 opacity-0 transition-opacity duration-300 group-hover:opacity-100" />

          <div class="absolute top-2 right-2 z-10 rounded-full bg-gradient-to-r from-[#fff2e0] via-[#ffa943] to-[#8f4b06] px-2 py-0.5 text-[9px] font-black tracking-wide whitespace-nowrap text-[#180d02] shadow-sm transition-transform duration-300 group-hover:scale-110">
            {provider.tag}
          </div>

          <div aria-hidden="true" class="mb-3 text-4xl transition-transform duration-300 group-hover:scale-125 group-hover:rotate-3">
            {provider.icon}
          </div>
          <p class="text-center text-sm font-black text-[#f2dfc4] transition-colors group-hover:text-[#fff2e0]">{provider.name}</p>
          <p class="mt-1 text-center text-[10px] text-[#f2dfc4]/70">{provider.desc}</p>

          <span class="relative z-10 mt-4 block w-full rounded-full border border-[#f6931e]/30 bg-[#080503] py-1.5 text-center text-[11px] font-bold text-[#ffb35c] shadow-inner transition-colors duration-300 group-hover:border-[#ffa943]/50 group-hover:bg-gradient-to-r group-hover:from-[#fff2e0] group-hover:via-[#ffa943] group-hover:to-[#8f4b06] group-hover:text-[#180d02]">
            เข้าดูเกม
          </span>
        </a>
      ))
    }
  </div>
</section>
