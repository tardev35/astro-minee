---
// The section title is a <p>, not an <h2>: this grid is chrome that belongs to
// the docx section above it, and the page's heading inventory is diffed against
// the brief. The accessible name for the region lives on the section's
// aria-label instead.
const providers = [
  { name: "สล็อตคลาสสิก", desc: "วงล้อรูปแบบพื้นฐาน กติกาสั้น เข้าใจรอบการจ่ายได้เร็ว", tag: "กติกาเข้าใจง่าย", icon: "🎰" },
  { name: "สล็อตฟีเจอร์โบนัส", desc: "มีรอบฟรีสปินและฟีเจอร์พิเศษ เงื่อนไขต่างกันไปในแต่ละเกม", tag: "ดูรอบพิเศษ", icon: "🎁" },
  { name: "สล็อตแจ็กพอตสะสม", desc: "รางวัลสะสมจากผู้เล่นหลายคน ควรอ่านเงื่อนไขการรับรางวัลก่อน", tag: "อ่านเงื่อนไขก่อน", icon: "💎" },
  { name: "เลือกตามค่ายเกม", desc: "แต่ละค่ายมีสไตล์ภาพ จังหวะเกม และรูปแบบการจ่ายเป็นของตัวเอง", tag: "ค้นหาตามค่าย", icon: "🏷️" },
  { name: "เลือกตามธีมเกม", desc: "ธีมผลไม้ สัตว์มงคล การผจญภัย และธีมอื่นให้เลือกตามความชอบ", tag: "เลือกตามธีม", icon: "🍀" },
  { name: "ดูอัตราจ่ายก่อนเล่น", desc: "อัตราจ่ายและจำนวนเส้นของแต่ละเกมไม่เท่ากัน ควรตรวจก่อนเริ่ม", tag: "ดูอัตราจ่าย", icon: "📊" },
  { name: "เลือกตามความผันผวน", desc: "เกมจ่ายบ่อยกับเกมที่ต้องรอรอบทำเงินเหมาะกับงบประมาณคนละแบบ", tag: "ดูงบก่อนเลือก", icon: "📈" },
];
---

<section aria-label="หมวดเกมสล็อตที่ AMBPLUS รวมไว้ในระบบเดียว" class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  <div class="mb-8 flex w-full flex-col items-center justify-center gap-2 text-center">
    <p class="bg-gradient-to-r from-[#fbf2c4] via-[#ecd48c] to-[#c9a24a] bg-clip-text text-3xl font-black tracking-widest text-transparent uppercase">
      หมวดเกมสล็อตที่ <span class="text-[#fbf2c4]">AMBPLUS</span> รวมไว้ในระบบเดียว
    </p>
    <div class="mt-2 h-[4px] w-24 rounded-full bg-gradient-to-r from-transparent via-[#ecd48c] to-transparent"></div>
  </div>

  <div class="grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-4 lg:gap-5 xl:grid-cols-7">
    {
      providers.map((provider) => (
        <a
          href="/register"
          class="group relative flex flex-col items-center justify-center overflow-hidden rounded-2xl border border-[#ecd48c]/30 bg-[#16110a]/92 p-5 shadow-[0_10px_30px_rgba(236,212,140,0.2)] backdrop-blur-md transition-all duration-300 hover:-translate-y-2 hover:border-[#ecd48c]/60 hover:bg-[#241b0e]/95 hover:shadow-[0_15px_40px_rgba(201,162,74,0.3)]">
          <div class="pointer-events-none absolute inset-0 bg-[#6b4e17]/25 opacity-0 transition-opacity duration-300 group-hover:opacity-100" />

          <div class="absolute top-2 right-2 z-10 rounded-full bg-gradient-to-r from-[#fbf2c4] via-[#ecd48c] to-[#8c6b22] px-2 py-0.5 text-[9px] font-black tracking-wide whitespace-nowrap text-[#17110a] shadow-sm transition-transform duration-300 group-hover:scale-110">
            {provider.tag}
          </div>

          <div aria-hidden="true" class="mb-3 text-4xl transition-transform duration-300 group-hover:scale-125 group-hover:rotate-3">
            {provider.icon}
          </div>
          <p class="text-center text-sm font-black text-[#efe3c8] transition-colors group-hover:text-[#fbf2c4]">{provider.name}</p>
          <p class="mt-1 text-center text-[10px] text-[#bfaa85]">{provider.desc}</p>

          <span class="relative z-10 mt-4 block w-full rounded-full border border-[#ecd48c]/30 bg-[#0a0806] py-1.5 text-center text-[11px] font-bold text-[#fbf2c4] shadow-inner transition-colors duration-300 group-hover:border-[#ecd48c]/60 group-hover:bg-gradient-to-r group-hover:from-[#fbf2c4] group-hover:via-[#ecd48c] group-hover:to-[#8c6b22] group-hover:text-[#17110a]">
            เข้าดูเกม
          </span>
        </a>
      ))
    }
  </div>
</section>
