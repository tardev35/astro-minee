---
// The section title is a <p>, not an <h2>: this grid is chrome that belongs to
// the docx section above it, and the page's heading inventory is diffed against
// the brief. The accessible name for the region lives on the section's
// aria-label instead.
const providers = [
  { name: "สล็อตคลาสสิก", desc: "วงล้อรูปแบบพื้นฐาน กติกาสั้น เข้าใจรอบการจ่ายได้เร็ว", tag: "กติกาเข้าใจง่าย", icon: "🎰" },
  { name: "เกมโบนัส", desc: "มีรอบฟรีสปินและฟีเจอร์พิเศษ เงื่อนไขต่างกันไปในแต่ละเกม", tag: "ดูรอบพิเศษ", icon: "🎁" },
  { name: "สล็อตแจ็กพอตสะสม", desc: "รางวัลสะสมจากผู้เล่นหลายคน ควรอ่านเงื่อนไขการรับรางวัลก่อน", tag: "อ่านเงื่อนไขก่อน", icon: "💎" },
  { name: "เกมสล็อตธีมใหม่", desc: "ธีมใหม่ ๆ ที่มีภาพและจังหวะเกมต่างจากสล็อตแบบเดิม", tag: "เลือกตามธีม", icon: "✨" },
  { name: "เลือกตามรูปแบบการเล่น", desc: "แต่ละเกมมีจังหวะรอบและวิธีเล่นไม่เหมือนกัน เลือกแบบที่เข้าใจง่ายก่อน", tag: "ลองหลายรูปแบบ", icon: "🍀" },
  { name: "ดูอัตราจ่ายก่อนเล่น", desc: "อัตราจ่ายและจำนวนเส้นของแต่ละเกมไม่เท่ากัน ควรตรวจก่อนเริ่ม", tag: "ดูอัตราจ่าย", icon: "📊" },
  { name: "เลือกตามความผันผวน", desc: "เกมจ่ายบ่อยกับเกมที่ต้องรอรอบทำเงินเหมาะกับงบประมาณคนละแบบ", tag: "ดูงบก่อนเลือก", icon: "📈" },
];
---

<section aria-label="หมวดเกมสล็อตที่ AMB194 รวมไว้ในระบบเดียว" class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  <div class="mb-8 flex w-full flex-col items-center justify-center gap-2 text-center">
    <p class="bg-gradient-to-r from-[#fff3ae] via-[#f8d441] to-[#d9a520] bg-clip-text text-3xl font-black tracking-widest text-transparent uppercase">
      หมวดเกมสล็อตที่ <span class="text-[#fff3ae]">AMB194</span> รวมไว้ในระบบเดียว
    </p>
    <div class="mt-2 h-[4px] w-24 rounded-full bg-gradient-to-r from-transparent via-[#f8d441] to-transparent"></div>
  </div>

  <div class="grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-4 lg:gap-5 xl:grid-cols-7">
    {
      providers.map((provider) => (
        <a
          href="/register"
          class="group relative flex flex-col items-center justify-center overflow-hidden rounded-2xl border border-[#f8d441]/30 bg-[#150f05]/92 p-5 shadow-[0_10px_30px_rgba(248,212,65,0.2)] backdrop-blur-md transition-all duration-300 hover:-translate-y-2 hover:border-[#f8d441]/60 hover:bg-[#221807]/95 hover:shadow-[0_15px_40px_rgba(217,165,32,0.3)]">
          <div class="pointer-events-none absolute inset-0 bg-[#6d4f06]/25 opacity-0 transition-opacity duration-300 group-hover:opacity-100" />

          <div class="absolute top-2 right-2 z-10 rounded-full bg-gradient-to-r from-[#fff3ae] via-[#f8d441] to-[#8a6205] px-2 py-0.5 text-[9px] font-black tracking-wide whitespace-nowrap text-[#170f02] shadow-sm transition-transform duration-300 group-hover:scale-110">
            {provider.tag}
          </div>

          <div aria-hidden="true" class="mb-3 text-4xl transition-transform duration-300 group-hover:scale-125 group-hover:rotate-3">
            {provider.icon}
          </div>
          <p class="text-center text-sm font-black text-[#f5ecd6] transition-colors group-hover:text-[#fff3ae]">{provider.name}</p>
          <p class="mt-1 text-center text-[10px] text-[#c9b784]">{provider.desc}</p>

          <span class="relative z-10 mt-4 block w-full rounded-full border border-[#f8d441]/30 bg-[#0b0806] py-1.5 text-center text-[11px] font-bold text-[#fff3ae] shadow-inner transition-colors duration-300 group-hover:border-[#f8d441]/60 group-hover:bg-gradient-to-r group-hover:from-[#fff3ae] group-hover:via-[#f8d441] group-hover:to-[#8a6205] group-hover:text-[#170f02]">
            เข้าดูเกม
          </span>
        </a>
      ))
    }
  </div>
</section>
