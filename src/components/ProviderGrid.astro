---
// The section title is a <p>, not an <h2>: this grid is chrome that belongs to
// the docx section above it, and the page's heading inventory is diffed against
// the brief. The accessible name for the region lives on the section's
// aria-label instead.
//
// Copy follows the ABM96 brief: เกมคลาสสิก / เกมฟีเจอร์โบนัส / เกมธีมใหม่ ๆ,
// พิจารณาจากกติกา รูปแบบการจ่าย และระดับความผันผวน, โปรทุนน้อยตามงบประมาณ,
// เครดิตเพิ่มเติมตามเงื่อนไข.
const providers = [
  { name: "สล็อตคลาสสิก", desc: "วงล้อรูปแบบพื้นฐาน กติกาสั้น เข้าใจง่าย เหมาะกับการเริ่มด้วยงบไม่สูง", tag: "เริ่มต้นง่าย", icon: "🎰" },
  { name: "เกมฟีเจอร์โบนัส", desc: "มีรอบโบนัสและฟรีสปิน ควรอ่านเงื่อนไขการเข้าฟีเจอร์ก่อนเริ่ม", tag: "อ่านเงื่อนไขก่อน", icon: "🎁" },
  { name: "เกมธีมใหม่ ๆ", desc: "ธีมและภาพแบบใหม่ จังหวะเกมต่างจากวงล้อแบบพื้นฐาน ลองดูก่อนเลือก", tag: "ลองก่อนเลือก", icon: "✨" },
  { name: "ระดับความผันผวน", desc: "เกมจ่ายบ่อยกับเกมที่ต้องรอรอบ เหมาะกับงบประมาณคนละแบบ", tag: "เทียบความเสี่ยง", icon: "📈" },
  { name: "รูปแบบการจ่าย", desc: "อัตราจ่ายและเส้นจ่ายผูกกับกติกาของเกมนั้น ควรตรวจก่อนทุกครั้ง", tag: "ตรวจอัตราจ่าย", icon: "📊" },
  { name: "โปรทุนน้อย", desc: "ยอดฝากที่กำหนด เกมที่เข้าร่วม และเงื่อนไขการถอนต่างกันในแต่ละรายการ", tag: "เทียบก่อนรับ", icon: "🪙" },
  { name: "เครดิตจากโปรโมชั่น", desc: "จำนวนเครดิต ระยะเวลา และข้อกำหนดการนำไปใช้ต่างกันตามแต่ละรายการ", tag: "อ่านให้ครบ", icon: "💳" },
];
---

<section aria-label="หมวดเกมสล็อตและโปรโมชั่นที่ ABM96 รวมไว้ในระบบเดียว" class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  <div class="mb-8 flex w-full flex-col items-center justify-center gap-2 text-center">
    <p class="bg-gradient-to-r from-[#ffe08a] via-[#f5c542] to-[#fda3cd] bg-clip-text text-3xl font-black tracking-widest text-transparent uppercase">
      หมวดเกมสล็อตและโปรโมชั่นที่ <span class="text-[#fff5fa]">ABM96</span> รวมไว้ในระบบเดียว
    </p>
    <div class="mt-2 h-[4px] w-24 rounded-full bg-gradient-to-r from-transparent via-[#f1509b] to-transparent"></div>
  </div>

  <div class="grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-4 lg:gap-5 xl:grid-cols-7">
    {
      providers.map((provider) => (
        <a
          href="/register"
          class="group relative flex flex-col items-center justify-center overflow-hidden rounded-2xl border border-[#f1509b]/30 bg-[#1d0512]/92 p-5 shadow-[0_10px_30px_rgba(241,80,155,0.2)] backdrop-blur-md transition-all duration-300 hover:-translate-y-2 hover:border-[#f1509b]/60 hover:bg-[#2a0a1b]/95 hover:shadow-[0_15px_40px_rgba(181,5,79,0.34)]">
          <div class="pointer-events-none absolute inset-0 bg-[#5c0428]/30 opacity-0 transition-opacity duration-300 group-hover:opacity-100" />

          <div class="absolute top-2 right-2 z-10 rounded-full bg-gradient-to-r from-[#ffe08a] via-[#f5c542] to-[#f1509b] px-2 py-0.5 text-[9px] font-black tracking-wide whitespace-nowrap text-[#2a0210] shadow-sm transition-transform duration-300 group-hover:scale-110">
            {provider.tag}
          </div>

          <div aria-hidden="true" class="mb-3 text-4xl transition-transform duration-300 group-hover:scale-125 group-hover:rotate-3">
            {provider.icon}
          </div>
          <p class="text-center text-sm font-black text-[#f6e3ee] transition-colors group-hover:text-[#fda3cd]">{provider.name}</p>
          <p class="mt-1 text-center text-[10px] text-[#f6e3ee]/65">{provider.desc}</p>

          <span class="relative z-10 mt-4 block w-full rounded-full border border-[#f1509b]/30 bg-[#0d0207] py-1.5 text-center text-[11px] font-bold text-[#fda3cd] shadow-inner transition-colors duration-300 group-hover:border-[#f5c542]/60 group-hover:bg-gradient-to-r group-hover:from-[#ffe08a] group-hover:via-[#f5c542] group-hover:to-[#f1509b] group-hover:text-[#2a0210]">
            เข้าดูเกม
          </span>
        </a>
      ))
    }
  </div>
</section>
