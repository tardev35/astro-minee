---
const providers = [
  { name: "เกมสล็อต", desc: "วงล้อหลายรูปแบบ ทั้งกติกาสั้นและเกมที่มีฟีเจอร์เสริม", tag: "เริ่มจากกติกา", icon: "🎰" },
  { name: "บาคาร่า", desc: "เกมไพ่ที่สมาชิกเลือกเล่นมาก ควรอ่านเงื่อนไขการจ่ายก่อนเริ่ม", tag: "อ่านเงื่อนไขก่อน", icon: "🎴" },
  { name: "รูเล็ต", desc: "วงล้อหมุนพร้อมรูปแบบการวางเดิมพันหลายแบบในเกมเดียว", tag: "หลายรูปแบบ", icon: "🎡" },
  { name: "เกมไพ่", desc: "รวมเกมไพ่หลายชนิด เลือกตามประเภทและความถนัดของตนเองได้", tag: "เลือกตามถนัด", icon: "🃏" },
  { name: "คาสิโนสด", desc: "ถ่ายทอดจากโต๊ะจริง ควรตรวจสัญญาณอินเทอร์เน็ตก่อนเข้าเล่น", tag: "ถ่ายทอดสด", icon: "🎥" },
  { name: "เลือกตามค่ายเกม", desc: "รวมเกมจากหลายค่ายไว้ในระบบเดียว เลือกดูตามผู้พัฒนาได้", tag: "หลายค่ายในที่เดียว", icon: "🏷️" },
  { name: "อัตราการจ่ายและกติกา", desc: "เทียบอัตราการจ่ายกับงบประมาณของตนเองก่อนตัดสินใจเลือกเกม", tag: "วางงบให้เหมาะ", icon: "📊" },
];
---

<section aria-label="หมวดเกมคาสิโนออนไลน์ที่ LCX88 รวมไว้ในระบบเดียว" class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  <div class="mb-8 flex w-full flex-col items-center justify-center gap-2 text-center">
    <p class="bg-gradient-to-r from-[#ffe08a] via-[#f5c542] to-[#6ea3ff] bg-clip-text text-3xl font-black tracking-widest text-transparent uppercase">
      หมวดเกมคาสิโนออนไลน์ที่ <span class="text-[#f5c542]">LCX88</span> รวมไว้ในระบบเดียว
    </p>
    <div class="mt-2 h-[4px] w-24 rounded-full bg-gradient-to-r from-transparent via-[#2f6bff] to-transparent"></div>
  </div>

  <div class="grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-4 lg:gap-5 xl:grid-cols-7">
    {
      providers.map((provider) => (
        <a
          href="/register"
          class="group relative flex flex-col items-center justify-center overflow-hidden rounded-2xl border border-[#2f6bff]/30 bg-[#0a1547]/92 p-5 shadow-[0_10px_30px_rgba(47,107,255,0.2)] backdrop-blur-md transition-all duration-300 hover:-translate-y-2 hover:border-[#f5c542]/50 hover:bg-[#122264]/95 hover:shadow-[0_15px_40px_rgba(245,197,66,0.28)]">
          <div class="pointer-events-none absolute inset-0 bg-[#2f6bff]/12 opacity-0 transition-opacity duration-300 group-hover:opacity-100" />

          <div class="absolute top-2 right-2 z-10 rounded-full bg-gradient-to-r from-[#ffe08a] via-[#f5c542] to-[#c08b1f] px-2 py-0.5 text-[9px] font-black tracking-wide whitespace-nowrap text-[#04102e] shadow-sm transition-transform duration-300 group-hover:scale-110">
            {provider.tag}
          </div>

          <div aria-hidden="true" class="mb-3 text-4xl transition-transform duration-300 group-hover:scale-125 group-hover:rotate-3">
            {provider.icon}
          </div>
          <p class="text-center text-sm font-black text-[#d7e3ff] transition-colors group-hover:text-[#ffe08a]">{provider.name}</p>
          <p class="mt-1 text-center text-[10px] text-[#9db0dd]">{provider.desc}</p>

          <span class="relative z-10 mt-4 block w-full rounded-full border border-[#2f6bff]/30 bg-[#040b2e] py-1.5 text-center text-[11px] font-bold text-[#6ea3ff] shadow-inner transition-colors duration-300 group-hover:border-[#f5c542]/50 group-hover:bg-gradient-to-r group-hover:from-[#ffe08a] group-hover:via-[#f5c542] group-hover:to-[#c08b1f] group-hover:text-[#04102e]">
            เข้าดูเกม
          </span>
        </a>
      ))
    }
  </div>
</section>
