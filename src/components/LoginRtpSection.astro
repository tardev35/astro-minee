---
import ContentBoxTwo from "./ContentBoxTwo.astro";

// Reference table, not article content — every label below renders as <p>/<span>
// inside ContentBoxTwo, whose section carries the aria-label. Copy follows the
// เฮงเฮง888 brief: เงื่อนไขไม่กำหนดขั้นต่ำเฉพาะบางช่องทาง, โปรโมชั่นเลือกจาก
// เงื่อนไขที่เหมาะกับตัวเอง, สล็อตคลาสสิก/เกมฟีเจอร์โบนัส/เกมธีมสมัยใหม่,
// แตกหนักวันนี้ไม่ใช่การรับประกันผล, ติดตามสถานะรายการจากหน้าบัญชี,
// กำหนดงบและระยะเวลาไว้ล่วงหน้า.
const menus = [
  { icon: "🧾", name: "เงื่อนไขไม่กำหนดขั้นต่ำ", detail: "บางช่องทางรองรับเงื่อนไขนี้ ควรตรวจข้อกำหนดของช่องทางฝากถอนให้ครบก่อนทำธุรกรรมจริง", tag: "ดูช่องทางที่รองรับ" },
  { icon: "🎁", name: "โปรโมชั่นและเงื่อนไขการถอน", detail: "ดูยอดที่กำหนด เกมที่เข้าร่วม และเงื่อนไขการถอนร่วมกัน ก่อนเลือกรับโปรแต่ละรายการ", tag: "อ่านก่อนกดรับ" },
  { icon: "🎰", name: "เกมสล็อตหลายสไตล์", detail: "สล็อตคลาสสิก เกมฟีเจอร์โบนัส และเกมธีมสมัยใหม่ เลือกได้จากบัญชีเดียว", tag: "เลือกตามสไตล์" },
  { icon: "📊", name: "อัตราจ่ายและความผันผวน", detail: "คำว่าแตกหนักวันนี้ไม่ใช่การรับประกันผล ควรดูข้อมูลเกมและอัตราจ่ายก่อนเริ่ม", tag: "ไม่ใช่การรับประกัน" },
  { icon: "🧭", name: "สถานะรายการฝากถอน", detail: "ติดตามสถานะรายการได้จากหน้าบัญชี หากยังดำเนินการอยู่ควรรอผลก่อนส่งรายการใหม่", tag: "รอผลก่อนส่งซ้ำ" },
  { icon: "📱", name: "รองรับมือถือและคอมพิวเตอร์", detail: "เปิดใช้งานผ่านมือถือ แท็บเล็ต และคอมพิวเตอร์ด้วยบัญชีเดียวกัน", tag: "ใช้ได้ทุกจอ" },
  { icon: "🛡️", name: "กำหนดงบและระยะเวลา", detail: "ตั้งงบและเวลาเล่นไว้ล่วงหน้า และหลีกเลี่ยงการเพิ่มเงินเพื่อตามคืนยอดที่เสียไป", tag: "เล่นอยู่ในกรอบ" },
];

const chips = ["ไม่กำหนดขั้นต่ำตามเงื่อนไข", "สล็อตคลาสสิก", "เกมฟีเจอร์โบนัส", "เกมธีมสมัยใหม่", "ดูอัตราจ่าย", "เช็กความผันผวน", "เช็กสถานะรายการ", "รองรับมือถือ"];
---

<ContentBoxTwo
  titleleft="เข้าสู่ระบบ เฮงเฮง888"
  titleright="ช่องทางในระบบและสิ่งที่ควรตรวจก่อนทำรายการ"
  label="เข้าสู่ระบบ เฮงเฮง888 และตารางอ้างอิงช่องทางในระบบที่ควรตรวจก่อนทำรายการ">
  <div slot="left" class="flex h-full flex-col gap-4">
    <div class="relative overflow-hidden rounded-2xl border border-[#12a34f]/30 bg-[#072b14]/92 p-6 shadow-[0_10px_30px_rgba(18,163,79,0.2)] backdrop-blur-md">
      <div aria-hidden="true" class="pointer-events-none absolute -top-10 -right-10 h-32 w-32 rounded-full bg-[#05461f]/60 blur-[50px]"></div>

      <div class="relative z-10 mb-5 flex items-center gap-3">
        <span
          aria-hidden="true"
          class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl border border-[#f5c518]/40 bg-gradient-to-br from-[#ffdf7a] via-[#f5c518] to-[#b8860b] text-xl text-[#05230f] shadow-inner">
          🍀
        </span>
        <div class="flex flex-col">
          <p class="text-base font-black text-[#9fcf3a]">ยินดีต้อนรับกลับ</p>
          <span class="text-[11px] text-[#a7c295]">บัญชีเดียวใช้เลือกเกม ตรวจสอบรายละเอียดโปรโมชั่น และติดตามสถานะรายการฝากถอนของ เฮงเฮง888 ได้จากหน้าเดียว</span>
        </div>
      </div>

      <div class="relative z-10 flex flex-col gap-3.5">
        <div class="relative">
          <span aria-hidden="true" class="absolute top-3.5 left-4 text-[#9fcf3a]">👤</span>
          <input
            type="text"
            aria-label="เบอร์โทรศัพท์หรือยูสเซอร์เนม"
            placeholder="เบอร์โทรศัพท์ / ยูสเซอร์เนม"
            class="w-full rounded-xl border border-[#12a34f]/35 bg-[#03170c]/95 py-3 pr-4 pl-12 text-[#e8f3e0] transition-all outline-none placeholder:text-[#a7c295] focus:border-[#1fc465] focus:ring-1 focus:ring-[#1fc465]/50"
          />
        </div>
        <div class="relative">
          <span aria-hidden="true" class="absolute top-3.5 left-4 text-[#9fcf3a]">🔑</span>
          <input
            type="password"
            aria-label="รหัสผ่านของบัญชี"
            placeholder="รหัสผ่านของบัญชี"
            class="w-full rounded-xl border border-[#12a34f]/35 bg-[#03170c]/95 py-3 pr-4 pl-12 text-[#e8f3e0] transition-all outline-none placeholder:text-[#a7c295] focus:border-[#1fc465] focus:ring-1 focus:ring-[#1fc465]/50"
          />
        </div>

        <div class="flex items-center justify-between px-1 text-xs">
          <label class="flex items-center gap-2 text-[#a7c295]">
            <input type="checkbox" class="h-3.5 w-3.5 rounded border-[#12a34f]/40 bg-[#03170c] accent-[#12a34f]" />
            จดจำฉันไว้
          </label>
          <a href="/login" class="text-[#a7c295] transition-colors hover:text-[#c3e558]">ลืมรหัสผ่าน?</a>
        </div>

        <a
          href="/login"
          class="mt-1 block w-full rounded-xl border border-[#f5c518]/40 bg-gradient-to-r from-[#ffdf7a] via-[#f5c518] to-[#b8860b] p-3.5 text-center font-black text-[#05230f] shadow-[0_10px_30px_rgba(245,197,24,0.28)] transition-all hover:scale-[1.02] hover:shadow-[0_15px_40px_rgba(245,197,24,0.4)]">
          เข้าสู่ระบบ
        </a>

        <div class="flex items-center gap-3 py-1 text-[11px] text-[#a7c295]">
          <span class="h-px flex-1 bg-[#12a34f]/35"></span>
          หรือ
          <span class="h-px flex-1 bg-[#12a34f]/35"></span>
        </div>

        <a
          href="/line"
          class="flex w-full items-center justify-center gap-2 rounded-xl bg-gradient-to-r from-[#00B900] to-[#009900] p-3 text-sm font-bold text-white shadow-md transition-all hover:scale-[1.02]">
          <span aria-hidden="true">💬</span> ทักไลน์ทีมงานคนไทย
        </a>

        <div class="mt-1 flex items-center justify-between px-1">
          <div class="flex gap-2">
            <span class="rounded-full border border-[#12a34f]/30 bg-[#03170c] px-2.5 py-1 text-[10px] font-bold text-[#9fcf3a]"><span aria-hidden="true">🔒</span> HTTPS + SSL</span>
            <span class="rounded-full border border-[#05461f] bg-[#03170c]/80 px-2.5 py-1 text-[10px] font-bold text-[#e8f3e0]"><span aria-hidden="true">🕐</span> ดูแลสมาชิก 24 ชั่วโมง</span>
          </div>
          <a href="/register" class="text-xs font-bold text-[#f5c518] transition-colors hover:text-[#ffdf7a]">สมัครสมาชิกใหม่</a>
        </div>
      </div>
    </div>
  </div>

  <div slot="right" class="h-full">
    <div class="flex h-full flex-col rounded-2xl border border-[#12a34f]/30 bg-[#072b14]/92 p-5 shadow-[0_10px_30px_rgba(18,163,79,0.2)] backdrop-blur-md">
      <div class="mb-5 flex items-center justify-between gap-3">
        <div>
          <span class="text-xs font-bold tracking-wide text-[#a7c295]">ตารางอ้างอิงช่องทางในระบบและสิ่งที่ควรตรวจก่อนทำรายการ</span>
          <div class="bg-gradient-to-r from-[#ffdf7a] via-[#f5c518] to-[#9fcf3a] bg-clip-text text-3xl font-black text-transparent sm:text-4xl">ไม่กำหนดขั้นต่ำตามเงื่อนไข</div>
        </div>
        <span class="flex items-center gap-1.5 self-start rounded-full border border-green-500/40 bg-green-900/40 px-2.5 py-1">
          <span class="h-1.5 w-1.5 animate-pulse rounded-full bg-green-500 shadow-[0_0_8px_rgba(34,197,94,0.7)]"></span>
          <span class="text-[10px] font-bold tracking-widest text-green-300 uppercase">Live</span>
        </span>
      </div>

      <div class="mb-2 flex items-center justify-between text-[11px] font-bold tracking-widest text-[#a7c295] uppercase">
        <span>ช่องทาง / บริการในระบบ</span>
        <span>จุดที่ต้องดู</span>
      </div>

      <div class="flex flex-1 flex-col gap-2.5">
        {
          menus.map((m) => (
            <div class="rounded-xl border border-[#12a34f]/25 bg-[#03170c]/95 px-3.5 py-2.5 transition-colors hover:border-[#1fc465]/60 hover:bg-[#0b3d1d]">
              <div class="flex items-center justify-between gap-2 text-sm">
                <span class="flex min-w-0 items-center gap-2 font-bold text-[#e8f3e0]">
                  <span aria-hidden="true" class="w-5 shrink-0 text-center">
                    {m.icon}
                  </span>{" "}
                  <span class="truncate">{m.name}</span>
                </span>
                <span class="shrink-0 rounded-full border border-[#f5c518]/45 bg-[#03170c] px-2.5 py-0.5 text-[10px] font-bold text-[#f5c518]">{m.tag}</span>
              </div>
              <div class="mt-1.5 text-[11px] tracking-wide text-[#a7c295]">{m.detail}</div>
            </div>
          ))
        }
      </div>

      <div class="mt-4 flex flex-wrap items-center justify-center gap-2">
        {chips.map((c) => <span class="rounded-full border border-[#12a34f]/30 bg-[#03170c] px-3 py-1 text-[10px] font-bold text-[#9fcf3a]">{c}</span>)}
      </div>

      <div class="mt-3 text-center text-[10px] tracking-wide text-[#a7c295]">
        ข้อมูลในตารางใช้เพื่ออ้างอิงเท่านั้น ควรตรวจสอบช่องทางที่รองรับเงื่อนไขไม่กำหนดขั้นต่ำ รายละเอียดโปรโมชั่น อัตราจ่าย และความผันผวนจากหน้าเว็บไซต์จริงก่อนทำรายการทุกครั้ง เพราะคำว่าแตกหนักวันนี้ไม่ใช่การรับประกันผลลัพธ์
      </div>
    </div>
  </div>
</ContentBoxTwo>
