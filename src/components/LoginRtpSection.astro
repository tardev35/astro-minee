---
import ContentBoxTwo from "./ContentBoxTwo.astro";

// Reference table, not article content — every label below renders as <p>/<span>
// inside ContentBoxTwo (whose `as` prop stays at its "p" default), and the
// section's aria-label carries the accessible name.
//
// The close times and payout rates here are the SAME numbers LottoGrid.astro
// prints and the same ones index.astro's prose refers to. If one moves, move
// all three — a market that closes at 15:00 in the grid and 16:00 in the table
// is the kind of contradiction a reader spots before any check does.
const markets = [
  { icon: "🇹🇭", name: "หวยรัฐบาลไทย", close: "ปิดรับ 15:00 น.", rate: "3 ตัวบน 900 · 2 ตัวบน 95", tag: "งวดละครั้ง" },
  { icon: "🇻🇳", name: "หวยฮานอย", close: "ปิดรับ 18:00 น.", rate: "3 ตัวบน 900 · 2 ตัวบน 95", tag: "ออกทุกวัน" },
  { icon: "🇱🇦", name: "หวยลาวพัฒนา", close: "ปิดรับ 20:00 น.", rate: "3 ตัวบน 900 · 2 ตัวบน 95", tag: "ออกตามปฏิทิน" },
  { icon: "⏱️", name: "หวยยี่กี 88 รอบ", close: "ปิดรับทุก 15 นาที", rate: "3 ตัวบน 850 · 2 ตัวบน 90", tag: "รอบถี่" },
  { icon: "🇲🇾", name: "หวยมาเลย์", close: "ปิดรับ 18:00 น.", rate: "3 ตัวบน 900 · 2 ตัวบน 95", tag: "ออกตามปฏิทิน" },
  { icon: "📈", name: "หวยหุ้นไทย", close: "ปิดรับ 16:40 น.", rate: "3 ตัวบน 850 · 2 ตัวบน 92", tag: "อิงเวลาตลาด" },
  { icon: "🏃", name: "เลขวิ่งทุกตลาด", close: "ปิดรับตามงวดของตลาดนั้น", rate: "วิ่งบน 3.2 · วิ่งล่าง 4.2", tag: "ราคาต่างตามตลาด" },
];

const chips = ["หวยรัฐบาล", "หวยฮานอย", "หวยลาวพัฒนา", "หวยยี่กี", "หวยมาเลย์", "หวยหุ้นไทย", "ตรวจโพยย้อนหลัง", "รองรับมือถือ"];
---

<ContentBoxTwo titleleft="เข้าสู่ระบบ LOTTO77" titleright="ตลาดหวย เวลาปิดรับ และอัตราจ่ายอ้างอิง" label="เข้าสู่ระบบ LOTTO77 และตารางอ้างอิงตลาดหวย เวลาปิดรับ และอัตราจ่ายที่ควรตรวจก่อนยืนยันโพย">
  <div slot="left" class="flex h-full flex-col gap-4">
    <div class="relative overflow-hidden rounded-2xl border border-[#d81220]/35 bg-[#2a0507]/92 p-6 shadow-[0_10px_30px_rgba(216,18,32,0.22)] backdrop-blur-md">
      <div aria-hidden="true" class="pointer-events-none absolute -top-10 -right-10 h-32 w-32 rounded-full bg-[#7d0000]/80 blur-[50px]"></div>

      <div class="relative z-10 mb-5 flex items-center gap-3">
        <span
          aria-hidden="true"
          class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl border border-[#f5c451]/45 bg-gradient-to-br from-[#ffe08a] via-[#f5c451] to-[#b8860b] text-xl text-[#150202] shadow-inner">
          🎫
        </span>
        <div class="flex flex-col">
          <p class="text-base font-black text-[#f5c451]">ยินดีต้อนรับกลับ</p>
          <span class="text-[11px] text-[#c9a49c]">บัญชีเดียวใช้เลือกประเภทหวย กรอกเลข ตรวจโพยที่ส่งแล้ว และติดตามผลรางวัลของ LOTTO77 ได้จากหน้าเดียว</span>
        </div>
      </div>

      <div class="relative z-10 flex flex-col gap-3.5">
        <div class="relative">
          <span aria-hidden="true" class="absolute top-3.5 left-4 text-[#ff3d3d]">👤</span>
          <input
            type="text"
            aria-label="เบอร์โทรศัพท์หรือยูสเซอร์เนม"
            placeholder="เบอร์โทรศัพท์ / ยูสเซอร์เนม"
            class="w-full rounded-xl border border-[#d81220]/40 bg-[#150202]/95 py-3 pr-4 pl-12 text-[#f3ded7] transition-all outline-none placeholder:text-[#c9a49c] focus:border-[#f5c451] focus:ring-1 focus:ring-[#f5c451]/50"
          />
        </div>
        <div class="relative">
          <span aria-hidden="true" class="absolute top-3.5 left-4 text-[#ff3d3d]">🔑</span>
          <input
            type="password"
            aria-label="รหัสผ่านของบัญชี"
            placeholder="รหัสผ่านของบัญชี"
            class="w-full rounded-xl border border-[#d81220]/40 bg-[#150202]/95 py-3 pr-4 pl-12 text-[#f3ded7] transition-all outline-none placeholder:text-[#c9a49c] focus:border-[#f5c451] focus:ring-1 focus:ring-[#f5c451]/50"
          />
        </div>

        <div class="flex items-center justify-between px-1 text-xs">
          <label class="flex items-center gap-2 text-[#c9a49c]">
            <input type="checkbox" class="h-3.5 w-3.5 rounded border-[#d81220]/45 bg-[#150202] accent-[#d81220]" />
            จดจำฉันไว้
          </label>
          <a href="/login" class="text-[#c9a49c] transition-colors hover:text-[#f5c451]">ลืมรหัสผ่าน?</a>
        </div>

        <a
          href="/login"
          class="mt-1 block w-full rounded-xl border border-[#f5c451]/45 bg-gradient-to-r from-[#ffe08a] via-[#f5c451] to-[#b8860b] p-3.5 text-center font-black text-[#150202] shadow-[0_10px_30px_rgba(245,196,81,0.3)] transition-all hover:scale-[1.02] hover:shadow-[0_15px_40px_rgba(245,196,81,0.42)]">
          เข้าสู่ระบบ
        </a>

        <div class="flex items-center gap-3 py-1 text-[11px] text-[#c9a49c]">
          <span class="h-px flex-1 bg-[#d81220]/40"></span>
          หรือ
          <span class="h-px flex-1 bg-[#d81220]/40"></span>
        </div>

        <a
          href="/line"
          class="flex w-full items-center justify-center gap-2 rounded-xl bg-gradient-to-r from-[#00B900] to-[#009900] p-3 text-sm font-bold text-white shadow-md transition-all hover:scale-[1.02]">
          <span aria-hidden="true">💬</span> ทักไลน์ทีมงานคนไทย
        </a>

        <div class="mt-1 flex items-center justify-between px-1">
          <div class="flex gap-2">
            <span class="rounded-full border border-[#d81220]/35 bg-[#150202] px-2.5 py-1 text-[10px] font-bold text-[#ff3d3d]"><span aria-hidden="true">🔒</span> HTTPS + SSL</span>
            <span class="rounded-full border border-[#3f070a] bg-[#150202]/80 px-2.5 py-1 text-[10px] font-bold text-[#f3ded7]"><span aria-hidden="true">🕐</span> ดูแลสมาชิก 24 ชั่วโมง</span>
          </div>
          <a href="/register" class="text-xs font-bold text-[#f5c451] transition-colors hover:text-[#ffe08a]">สมัครสมาชิกใหม่</a>
        </div>
      </div>
    </div>
  </div>

  <div slot="right" class="h-full">
    <div class="flex h-full flex-col rounded-2xl border border-[#d81220]/35 bg-[#2a0507]/92 p-5 shadow-[0_10px_30px_rgba(216,18,32,0.22)] backdrop-blur-md">
      <div class="mb-5 flex items-center justify-between gap-3">
        <div>
          <span class="text-xs font-bold tracking-wide text-[#c9a49c]">ตารางอ้างอิงตลาดหวย เวลาปิดรับ และอัตราจ่ายที่ควรตรวจก่อนยืนยันโพย</span>
          <div class="bg-gradient-to-r from-[#ffe08a] via-[#f5c451] to-[#ff3d3d] bg-clip-text text-3xl font-black text-transparent sm:text-4xl">ตรวจอัตราจ่ายก่อนยืนยันโพย</div>
        </div>
        <span class="flex items-center gap-1.5 self-start rounded-full border border-green-500/40 bg-green-900/40 px-2.5 py-1">
          <span class="h-1.5 w-1.5 animate-pulse rounded-full bg-green-500 shadow-[0_0_8px_rgba(34,197,94,0.7)]"></span>
          <span class="text-[10px] font-bold tracking-widest text-green-300 uppercase">Live</span>
        </span>
      </div>

      <div class="mb-2 flex items-center justify-between text-[11px] font-bold tracking-widest text-[#c9a49c] uppercase">
        <span>ตลาดหวย / เวลาปิดรับ</span>
        <span>อัตราจ่ายอ้างอิง</span>
      </div>

      <div class="flex flex-1 flex-col gap-2.5">
        {
          markets.map((m) => (
            <div class="rounded-xl border border-[#d81220]/30 bg-[#150202]/95 px-3.5 py-2.5 transition-colors hover:border-[#f5c451]/60 hover:bg-[#3f070a]">
              <div class="flex items-center justify-between gap-2 text-sm">
                <span class="flex min-w-0 items-center gap-2 font-bold text-[#f3ded7]">
                  <span aria-hidden="true" class="w-5 shrink-0 text-center">
                    {m.icon}
                  </span>{" "}
                  <span class="truncate">{m.name}</span>
                </span>
                <span class="shrink-0 rounded-full border border-[#f5c451]/50 bg-[#150202] px-2.5 py-0.5 text-[10px] font-bold text-[#f5c451]">{m.tag}</span>
              </div>
              <div class="mt-1.5 flex flex-wrap items-center gap-x-3 gap-y-1 text-[11px] tracking-wide text-[#c9a49c]">
                <span>{m.close}</span>
                <span class="font-bold text-[#ff3d3d]">{m.rate}</span>
              </div>
            </div>
          ))
        }
      </div>

      <div class="mt-4 flex flex-wrap items-center justify-center gap-2">
        {chips.map((c) => <span class="rounded-full border border-[#d81220]/35 bg-[#150202] px-3 py-1 text-[10px] font-bold text-[#f5c451]">{c}</span>)}
      </div>

      <div class="mt-3 text-center text-[10px] tracking-wide text-[#c9a49c]">
        ตัวเลขในตารางเป็นค่าอ้างอิงเท่านั้น อัตราจ่าย เวลาปิดรับ และสถานะเลขอั้นอาจเปลี่ยนตามประเภทหวย งวด และเลขที่เลือก จึงควรตรวจราคาที่ระบบแสดงจริงก่อนกดยืนยันโพยทุกครั้ง
        และเก็บเลขอ้างอิงของโพยไว้จนกว่าจะประกาศผลรางวัล
      </div>
    </div>
  </div>
</ContentBoxTwo>
