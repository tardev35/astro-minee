---
import ContentBoxTwo from "./ContentBoxTwo.astro";

const menus = [
  { icon: "🃏", name: "โต๊ะบาคาร่าหลายระดับ", detail: "เลือกโต๊ะตามวงเงินขั้นต่ำและความเร็วของแต่ละรอบก่อนเข้าเล่น", tag: "ดูวงเงินก่อน" },
  { icon: "📊", name: "อัตราจ่าย Banker / Player / Tie", detail: "แต่ละตัวเลือกมีอัตราจ่ายและเงื่อนไขต่างกัน ควรอ่านกติกาของโต๊ะให้ครบ", tag: "อ่านกติกาก่อน" },
  { icon: "🎥", name: "โต๊ะถ่ายทอดสด", detail: "เห็นการแจกไพ่แต่ละรอบตามจริง ผลของทุกรอบยังคงไม่สามารถรับประกันได้", tag: "ผลไม่แน่นอน" },
  { icon: "⚡", name: "ฝากถอนระบบออโต้", detail: "ทำรายการผ่านหน้าบัญชีได้เอง ตรวจชื่อบัญชีและจำนวนเงินก่อนยืนยันทุกครั้ง", tag: "ตรวจก่อนยืนยัน" },
  { icon: "🔗", name: "ไม่ผ่านเอเย่นต์", detail: "จัดการบัญชีและธุรกรรมได้โดยตรง ไม่ต้องส่งข้อมูลส่วนตัวผ่านตัวแทน", tag: "เข้าช่องทางตรง" },
  { icon: "📱", name: "รองรับทุกอุปกรณ์", detail: "ใช้งานผ่านมือถือ แท็บเล็ต และคอมพิวเตอร์ด้วยเบราว์เซอร์เดียว", tag: "เล่นได้ทุกที่" },
  { icon: "🔒", name: "ระบบบัญชีที่มั่นคง", detail: "เข้าผ่านทางเข้าหลัก ตั้งรหัสผ่านไม่ซ้ำ และออกจากระบบเมื่อใช้เครื่องผู้อื่น", tag: "ไม่ส่งต่อ OTP" },
];

const chips = ["บาคาร่าออนไลน์", "เว็บตรงไม่ผ่านเอเย่นต์", "ระบบออโต้", "รองรับมือถือ", "โบนัสและโปรโมชั่น", "อัตราจ่ายแต่ละโต๊ะ", "บริการ 24 ชม."];
---

<ContentBoxTwo
  titleleft="เข้าสู่ระบบ KOHKAE789"
  titleright="โต๊ะบาคาร่าและระบบที่ใช้ได้ทั้งบนมือถือและคอมพิวเตอร์"
  label="เข้าสู่ระบบ KOHKAE789 และโต๊ะบาคาร่าที่ใช้ได้ทุกอุปกรณ์">
  <div slot="left" class="flex h-full flex-col gap-4">
    <div class="relative overflow-hidden rounded-2xl border border-[#29abe3]/30 bg-[#0b1c33]/92 p-6 shadow-[0_10px_30px_rgba(41,171,227,0.18)] backdrop-blur-md">
      <div class="pointer-events-none absolute -top-10 -right-10 h-32 w-32 rounded-full bg-[#1573e6]/22 blur-[50px]"></div>

      <div class="relative z-10 mb-5 flex items-center gap-3">
        <span
          aria-hidden="true"
          class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl border border-[#1573e6]/40 bg-gradient-to-br from-[#5aa8ff] via-[#1573e6] to-[#08306f] text-xl shadow-inner">
          🃏
        </span>
        <div class="flex flex-col">
          <p class="text-base font-black text-[#7fdcff]">ยินดีต้อนรับกลับ</p>
          <span class="text-[11px] text-[#cfe6f7]/70">บัญชีเดียวใช้เลือกโต๊ะบาคาร่า ตรวจสอบโปรโมชั่น และจัดการรายการฝากถอนของ KOHKAE789 ได้จากหน้าเดียว</span>
        </div>
      </div>

      <div class="relative z-10 flex flex-col gap-3.5">
        <div class="relative">
          <span aria-hidden="true" class="absolute top-3.5 left-4 text-[#7fdcff]">👤</span>
          <input
            type="text"
            placeholder="เบอร์โทรศัพท์ / ยูสเซอร์เนม"
            class="w-full rounded-xl border border-[#29abe3]/35 bg-[#050c1a]/95 py-3 pr-4 pl-12 text-[#cfe6f7] transition-all outline-none placeholder:text-[#cfe6f7]/50 focus:border-[#29abe3] focus:ring-1 focus:ring-[#29abe3]/50"
          />
        </div>
        <div class="relative">
          <span aria-hidden="true" class="absolute top-3.5 left-4 text-[#7fdcff]">🔑</span>
          <input
            type="password"
            placeholder="รหัสผ่านของบัญชี"
            class="w-full rounded-xl border border-[#29abe3]/35 bg-[#050c1a]/95 py-3 pr-4 pl-12 text-[#cfe6f7] transition-all outline-none placeholder:text-[#cfe6f7]/50 focus:border-[#29abe3] focus:ring-1 focus:ring-[#29abe3]/50"
          />
        </div>

        <div class="flex items-center justify-between px-1 text-xs">
          <label class="flex items-center gap-2 text-[#cfe6f7]/75">
            <input type="checkbox" class="h-3.5 w-3.5 rounded border-[#29abe3]/40 bg-[#050c1a] accent-[#29abe3]" />
            จดจำฉันไว้
          </label>
          <a href="/login" class="text-[#cfe6f7]/75 transition-colors hover:text-[#7fdcff]">ลืมรหัสผ่าน?</a>
        </div>

        <button
          class="mt-1 w-full rounded-xl border border-[#29abe3]/40 bg-gradient-to-r from-[#7fdcff] via-[#29abe3] to-[#0b3f96] p-3.5 font-black text-[#050c1a] shadow-[0_10px_30px_rgba(41,171,227,0.28)] transition-all hover:scale-[1.02] hover:shadow-[0_15px_40px_rgba(41,171,227,0.4)]">
          เข้าสู่ระบบ
        </button>

        <div class="flex items-center gap-3 py-1 text-[11px] text-[#cfe6f7]/60">
          <span class="h-px flex-1 bg-[#29abe3]/35"></span>
          หรือ
          <span class="h-px flex-1 bg-[#29abe3]/35"></span>
        </div>

        <a
          href="/line"
          class="flex w-full items-center justify-center gap-2 rounded-xl bg-gradient-to-r from-[#00B900] to-[#009900] p-3 text-sm font-bold text-white shadow-md transition-all hover:scale-[1.02]">
          <span aria-hidden="true">💬</span> ติดต่อแอดมิน LINE
        </a>

        <div class="mt-1 flex items-center justify-between px-1">
          <div class="flex gap-2">
            <span class="rounded-full border border-[#29abe3]/30 bg-[#050c1a] px-2.5 py-1 text-[10px] font-bold text-[#7fdcff]"><span aria-hidden="true">🔒</span> HTTPS + SSL</span>
            <span class="rounded-full border border-[#1573e6]/50 bg-[#050c1a]/80 px-2.5 py-1 text-[10px] font-bold text-[#bfe9ff]"><span aria-hidden="true">🕐</span> ระบบออโต้ 24 ชั่วโมง</span>
          </div>
          <a href="/register" class="text-xs font-bold text-[#7fdcff] transition-colors hover:text-[#bfe9ff]">สมัครสมาชิกใหม่</a>
        </div>
      </div>
    </div>
  </div>

  <div slot="right" class="h-full">
    <div class="flex h-full flex-col rounded-2xl border border-[#29abe3]/30 bg-[#0b1c33]/92 p-5 shadow-[0_10px_30px_rgba(41,171,227,0.18)] backdrop-blur-md">
      <div class="mb-5 flex items-center justify-between gap-3">
        <div>
          <span class="text-xs font-bold tracking-wide text-[#cfe6f7]/70">ตารางอ้างอิงโต๊ะบาคาร่าและระบบที่ใช้ได้จากบัญชีเดียว</span>
          <div class="bg-gradient-to-r from-[#e8f6ff] via-[#7fdcff] to-[#1573e6] bg-clip-text text-3xl font-black text-transparent sm:text-4xl">ไม่ผ่านเอเย่นต์ • ระบบออโต้ 24 ชม.</div>
        </div>
        <span class="flex items-center gap-1.5 self-start rounded-full border border-green-500/40 bg-green-900/40 px-2.5 py-1">
          <span class="h-1.5 w-1.5 animate-pulse rounded-full bg-green-500 shadow-[0_0_8px_rgba(34,197,94,0.7)]"></span>
          <span class="text-[10px] font-bold tracking-widest text-green-300 uppercase">Live</span>
        </span>
      </div>

      <div class="mb-2 flex items-center justify-between text-[11px] font-bold tracking-widest text-[#cfe6f7]/60 uppercase">
        <span>โต๊ะเกม / บริการในระบบ</span>
        <span>จุดที่ต้องดู</span>
      </div>

      <div class="flex flex-1 flex-col gap-2.5">
        {
          menus.map((m) => (
            <div class="rounded-xl border border-[#29abe3]/25 bg-[#050c1a]/95 px-3.5 py-2.5 transition-colors hover:border-[#1573e6]/50 hover:bg-[#12294a]">
              <div class="flex items-center justify-between gap-2 text-sm">
                <span class="flex min-w-0 items-center gap-2 font-bold text-[#cfe6f7]">
                  <span aria-hidden="true" class="w-5 shrink-0 text-center">
                    {m.icon}
                  </span>{" "}
                  <span class="truncate">{m.name}</span>
                </span>
                <span class="shrink-0 rounded-full border border-[#1573e6]/30 bg-[#050c1a] px-2.5 py-0.5 text-[10px] font-bold text-[#bfe9ff]">{m.tag}</span>
              </div>
              <div class="mt-1.5 text-[11px] tracking-wide text-[#cfe6f7]/70">{m.detail}</div>
            </div>
          ))
        }
      </div>

      <div class="mt-4 flex flex-wrap items-center justify-center gap-2">
        {chips.map((c) => <span class="rounded-full border border-[#29abe3]/30 bg-[#050c1a] px-3 py-1 text-[10px] font-bold text-[#7fdcff]">{c}</span>)}
      </div>

      <div class="mt-3 text-center text-[10px] tracking-wide text-[#cfe6f7]/60">
        ข้อมูลในตารางใช้เพื่ออ้างอิงเท่านั้น ควรตรวจกติกา อัตราการจ่าย เงื่อนไขของแต่ละโต๊ะ และช่องทางฝากถอนที่รองรับจากหน้าเว็บไซต์จริงก่อนเริ่มใช้งานทุกครั้ง
      </div>
    </div>
  </div>
</ContentBoxTwo>
