---
import ContentBoxTwo from "./ContentBoxTwo.astro";

const menus = [
  { icon: "🎰", name: "เกมสล็อตจากหลายค่าย", detail: "เลือกได้ตามธีม ฟีเจอร์ และรูปแบบการเล่นที่ถนัดก่อนเริ่มเล่นจริง", tag: "เลือกตามธีม" },
  { icon: "🎁", name: "รอบโบนัสและฟรีสปิน", detail: "แต่ละเกมมีเงื่อนไขของรอบพิเศษต่างกัน ควรอ่านกติกาให้ครบก่อน", tag: "อ่านกติกาก่อน" },
  { icon: "📊", name: "ความผันผวนของแต่ละเกม", detail: "เกมจ่ายบ่อยกับเกมที่ต้องรอรอบทำเงินเหมาะกับงบประมาณคนละแบบ", tag: "ดูงบก่อนเลือก" },
  { icon: "⚡", name: "ฝากถอนระบบออโต้", detail: "ทำรายการผ่านหน้าบัญชีได้เอง ตรวจยอดเงินและข้อมูลบัญชีก่อนยืนยัน", tag: "ตรวจก่อนยืนยัน" },
  { icon: "👛", name: "ฝากถอนผ่าน True Wallet", detail: "ใช้บัญชีวอลเลทที่ตรงกับข้อมูลสมัคร และเก็บหลักฐานไว้จนสถานะสำเร็จ", tag: "ใช้วอลเลทของตนเอง" },
  { icon: "📱", name: "รองรับทุกอุปกรณ์", detail: "ใช้งานผ่านมือถือ แท็บเล็ต และคอมพิวเตอร์ด้วยเบราว์เซอร์เดียว", tag: "เล่นได้ทุกที่" },
  { icon: "🔒", name: "ระบบบัญชีที่มั่นคง", detail: "เข้าผ่านทางเข้าหลัก ตั้งรหัสผ่านไม่ซ้ำ และออกจากระบบเมื่อใช้เครื่องผู้อื่น", tag: "ไม่ส่งต่อ OTP" },
];

const chips = ["สล็อตออนไลน์", "เกมค่ายดัง", "ระบบออโต้", "True Wallet", "รองรับมือถือ", "โบนัสและโปรโมชั่น", "บริการ 24 ชม."];
---

<ContentBoxTwo
  titleleft="เข้าสู่ระบบ DUCK36"
  titleright="หมวดเกมและระบบที่ใช้ได้ทั้งบนมือถือและคอมพิวเตอร์"
  label="เข้าสู่ระบบ DUCK36 และหมวดเกมสล็อตที่ใช้ได้ทุกอุปกรณ์">
  <div slot="left" class="flex h-full flex-col gap-4">
    <div class="relative overflow-hidden rounded-2xl border border-[#f5b70a]/30 bg-[#12100b]/92 p-6 shadow-[0_10px_30px_rgba(245,183,10,0.18)] backdrop-blur-md">
      <div class="pointer-events-none absolute -top-10 -right-10 h-32 w-32 rounded-full bg-[#d99908]/22 blur-[50px]"></div>

      <div class="relative z-10 mb-5 flex items-center gap-3">
        <span
          aria-hidden="true"
          class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl border border-[#d99908]/40 bg-gradient-to-br from-[#ffcf4d] via-[#d99908] to-[#8a5c07] text-xl shadow-inner">
          🎰
        </span>
        <div class="flex flex-col">
          <p class="text-base font-black text-[#ffd76a]">ยินดีต้อนรับกลับ</p>
          <span class="text-[11px] text-[#efe3c9]/70">บัญชีเดียวใช้เลือกเกมสล็อต ตรวจสอบโปรโมชั่น และจัดการรายการฝากถอนของ DUCK36 ได้จากหน้าเดียว</span>
        </div>
      </div>

      <div class="relative z-10 flex flex-col gap-3.5">
        <div class="relative">
          <span aria-hidden="true" class="absolute top-3.5 left-4 text-[#ffd76a]">👤</span>
          <input
            type="text"
            placeholder="เบอร์โทรศัพท์ / ยูสเซอร์เนม"
            class="w-full rounded-xl border border-[#f5b70a]/35 bg-[#050403]/95 py-3 pr-4 pl-12 text-[#efe3c9] transition-all outline-none placeholder:text-[#efe3c9]/50 focus:border-[#f5b70a] focus:ring-1 focus:ring-[#f5b70a]/50"
          />
        </div>
        <div class="relative">
          <span aria-hidden="true" class="absolute top-3.5 left-4 text-[#ffd76a]">🔑</span>
          <input
            type="password"
            placeholder="รหัสผ่านของบัญชี"
            class="w-full rounded-xl border border-[#f5b70a]/35 bg-[#050403]/95 py-3 pr-4 pl-12 text-[#efe3c9] transition-all outline-none placeholder:text-[#efe3c9]/50 focus:border-[#f5b70a] focus:ring-1 focus:ring-[#f5b70a]/50"
          />
        </div>

        <div class="flex items-center justify-between px-1 text-xs">
          <label class="flex items-center gap-2 text-[#efe3c9]/75">
            <input type="checkbox" class="h-3.5 w-3.5 rounded border-[#f5b70a]/40 bg-[#050403] accent-[#f5b70a]" />
            จดจำฉันไว้
          </label>
          <a href="/login" class="text-[#efe3c9]/75 transition-colors hover:text-[#ffd76a]">ลืมรหัสผ่าน?</a>
        </div>

        <button
          class="mt-1 w-full rounded-xl border border-[#f5b70a]/40 bg-gradient-to-r from-[#ffd76a] via-[#f5b70a] to-[#8a5c07] p-3.5 font-black text-[#050403] shadow-[0_10px_30px_rgba(245,183,10,0.28)] transition-all hover:scale-[1.02] hover:shadow-[0_15px_40px_rgba(245,183,10,0.4)]">
          เข้าสู่ระบบ
        </button>

        <div class="flex items-center gap-3 py-1 text-[11px] text-[#efe3c9]/60">
          <span class="h-px flex-1 bg-[#f5b70a]/35"></span>
          หรือ
          <span class="h-px flex-1 bg-[#f5b70a]/35"></span>
        </div>

        <a
          href="/line"
          class="flex w-full items-center justify-center gap-2 rounded-xl bg-gradient-to-r from-[#00B900] to-[#009900] p-3 text-sm font-bold text-white shadow-md transition-all hover:scale-[1.02]">
          <span aria-hidden="true">💬</span> ติดต่อแอดมิน LINE
        </a>

        <div class="mt-1 flex items-center justify-between px-1">
          <div class="flex gap-2">
            <span class="rounded-full border border-[#f5b70a]/30 bg-[#050403] px-2.5 py-1 text-[10px] font-bold text-[#ffd76a]"><span aria-hidden="true">🔒</span> HTTPS + SSL</span>
            <span class="rounded-full border border-[#d99908]/50 bg-[#050403]/80 px-2.5 py-1 text-[10px] font-bold text-[#f3e3bd]"><span aria-hidden="true">🕐</span> ระบบออโต้ 24 ชั่วโมง</span>
          </div>
          <a href="/register" class="text-xs font-bold text-[#ffd76a] transition-colors hover:text-[#f3e3bd]">สมัครสมาชิกใหม่</a>
        </div>
      </div>
    </div>
  </div>

  <div slot="right" class="h-full">
    <div class="flex h-full flex-col rounded-2xl border border-[#f5b70a]/30 bg-[#12100b]/92 p-5 shadow-[0_10px_30px_rgba(245,183,10,0.18)] backdrop-blur-md">
      <div class="mb-5 flex items-center justify-between gap-3">
        <div>
          <span class="text-xs font-bold tracking-wide text-[#efe3c9]/70">ตารางอ้างอิงหมวดเกมและระบบที่ใช้ได้จากบัญชีเดียว</span>
          <div class="bg-gradient-to-r from-[#fff8e6] via-[#ffd76a] to-[#d99908] bg-clip-text text-3xl font-black text-transparent sm:text-4xl">รวมเกมค่ายดัง • ระบบออโต้ 24 ชม.</div>
        </div>
        <span class="flex items-center gap-1.5 self-start rounded-full border border-green-500/40 bg-green-900/40 px-2.5 py-1">
          <span class="h-1.5 w-1.5 animate-pulse rounded-full bg-green-500 shadow-[0_0_8px_rgba(34,197,94,0.7)]"></span>
          <span class="text-[10px] font-bold tracking-widest text-green-300 uppercase">Live</span>
        </span>
      </div>

      <div class="mb-2 flex items-center justify-between text-[11px] font-bold tracking-widest text-[#efe3c9]/60 uppercase">
        <span>หมวดเกม / บริการในระบบ</span>
        <span>จุดที่ต้องดู</span>
      </div>

      <div class="flex flex-1 flex-col gap-2.5">
        {
          menus.map((m) => (
            <div class="rounded-xl border border-[#f5b70a]/25 bg-[#050403]/95 px-3.5 py-2.5 transition-colors hover:border-[#d99908]/50 hover:bg-[#1e1a10]">
              <div class="flex items-center justify-between gap-2 text-sm">
                <span class="flex min-w-0 items-center gap-2 font-bold text-[#efe3c9]">
                  <span aria-hidden="true" class="w-5 shrink-0 text-center">
                    {m.icon}
                  </span>{" "}
                  <span class="truncate">{m.name}</span>
                </span>
                <span class="shrink-0 rounded-full border border-[#d99908]/30 bg-[#050403] px-2.5 py-0.5 text-[10px] font-bold text-[#f3e3bd]">{m.tag}</span>
              </div>
              <div class="mt-1.5 text-[11px] tracking-wide text-[#efe3c9]/70">{m.detail}</div>
            </div>
          ))
        }
      </div>

      <div class="mt-4 flex flex-wrap items-center justify-center gap-2">
        {chips.map((c) => <span class="rounded-full border border-[#f5b70a]/30 bg-[#050403] px-3 py-1 text-[10px] font-bold text-[#ffd76a]">{c}</span>)}
      </div>

      <div class="mt-3 text-center text-[10px] tracking-wide text-[#efe3c9]/60">
        ข้อมูลในตารางใช้เพื่ออ้างอิงเท่านั้น ควรตรวจกติกา รูปแบบโบนัส เงื่อนไขของแต่ละเกม และช่องทางฝากถอนที่รองรับจากหน้าเว็บไซต์จริงก่อนเริ่มใช้งานทุกครั้ง
      </div>
    </div>
  </div>
</ContentBoxTwo>
