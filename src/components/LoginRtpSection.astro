---
import ContentBoxTwo from "./ContentBoxTwo.astro";

const menus = [
  { icon: "🎰", name: "สล็อตคลาสสิก", detail: "รูปแบบเรียบง่าย กติกาสั้น เหมาะกับการทำความเข้าใจจังหวะเกมก่อนขยับวงเงิน", tag: "เริ่มจากกติกา" },
  { icon: "🎬", name: "วิดีโอสล็อต", detail: "ธีมและฟีเจอร์หลากหลาย ควรดูอัตราจ่ายและระดับความผันผวนประกอบทุกครั้ง", tag: "ดูอัตราจ่าย" },
  { icon: "🎁", name: "เกมโบนัส", detail: "มีรอบโบนัสและฟีเจอร์พิเศษ ตรวจเงื่อนไขการเข้ารอบก่อนเลือกเล่น", tag: "อ่านเงื่อนไข" },
  { icon: "🔎", name: "ค้นหาตามค่ายและธีม", detail: "เลือกเกมตามค่าย ธีม หรือรูปแบบที่ชื่นชอบได้จากหน้าเดียว", tag: "หาเกมได้ง่าย" },
  { icon: "🔗", name: "ระบบเว็บตรง", detail: "สมัคร เข้าสู่ระบบ เลือกเกม และตรวจสอบรายการได้จากหน้าเว็บไซต์เดียว", tag: "ลดขั้นตอน" },
  { icon: "💸", name: "ฝากถอนไม่มีขั้นต่ำ", detail: "กำหนดยอดทำรายการได้ยืดหยุ่นตามช่องทางที่เว็บไซต์กำหนด", tag: "ตรวจช่องทางก่อน" },
  { icon: "📱", name: "รองรับทุกอุปกรณ์", detail: "ใช้งานผ่านมือถือ แท็บเล็ต และคอมพิวเตอร์ด้วยเบราว์เซอร์เดียว", tag: "เล่นได้ทุกที่" },
];

const chips = ["สล็อตคลาสสิก", "วิดีโอสล็อต", "เกมโบนัส", "ฟีเจอร์พิเศษ", "เว็บตรง", "ไม่มีขั้นต่ำ", "รองรับมือถือ"];
---

<ContentBoxTwo
  titleleft="เข้าสู่ระบบ XFINITYPLAY"
  titleright="หมวดเกมและระบบที่ใช้ได้ทั้งบนมือถือและคอมพิวเตอร์"
  label="เข้าสู่ระบบ XFINITYPLAY และหมวดเกมที่ใช้ได้ทุกอุปกรณ์">
  <div slot="left" class="flex h-full flex-col gap-4">
    <div class="relative overflow-hidden rounded-2xl border border-[#22d3ee]/25 bg-[#080520]/92 p-6 shadow-[0_10px_30px_rgba(34,211,238,0.16)] backdrop-blur-md">
      <div class="pointer-events-none absolute -top-10 -right-10 h-32 w-32 rounded-full bg-[#a855f7]/25 blur-[50px]"></div>

      <div class="relative z-10 mb-5 flex items-center gap-3">
        <span aria-hidden="true" class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl border border-[#22d3ee]/40 bg-gradient-to-br from-[#a5f3fc] via-[#22d3ee] to-[#0891b2] text-xl shadow-inner">🎰</span>
        <div class="flex flex-col">
          <p class="text-base font-black text-[#22d3ee]">ยินดีต้อนรับกลับ</p>
          <span class="text-[11px] text-[#9fb3cc]">บัญชีเดียวใช้เลือกเกม ตรวจสอบโปรโมชั่น และจัดการรายการฝากถอนของ XFINITYPLAY ได้จากหน้าเดียว</span>
        </div>
      </div>

      <div class="relative z-10 flex flex-col gap-3.5">
        <div class="relative">
          <span aria-hidden="true" class="absolute top-3.5 left-4 text-[#a855f7]">👤</span>
          <input
            type="text"
            placeholder="เบอร์โทรศัพท์ / ยูสเซอร์เนม"
            class="w-full rounded-xl border border-[#a855f7]/30 bg-[#0d0a2b]/95 py-3 pr-4 pl-12 text-[#cfe3f5] transition-all outline-none placeholder:text-[#9fb3cc]/70 focus:border-[#22d3ee] focus:ring-1 focus:ring-[#22d3ee]/50"
          />
        </div>
        <div class="relative">
          <span aria-hidden="true" class="absolute top-3.5 left-4 text-[#a855f7]">🔑</span>
          <input
            type="password"
            placeholder="รหัสผ่านของบัญชี"
            class="w-full rounded-xl border border-[#a855f7]/30 bg-[#0d0a2b]/95 py-3 pr-4 pl-12 text-[#cfe3f5] transition-all outline-none placeholder:text-[#9fb3cc]/70 focus:border-[#22d3ee] focus:ring-1 focus:ring-[#22d3ee]/50"
          />
        </div>

        <div class="flex items-center justify-between px-1 text-xs">
          <label class="flex items-center gap-2 text-[#9fb3cc]">
            <input type="checkbox" class="h-3.5 w-3.5 rounded border-[#a855f7]/40 bg-[#0d0a2b] accent-[#22d3ee]" />
            จดจำฉันไว้
          </label>
          <a href="/login" class="text-[#9fb3cc] transition-colors hover:text-[#a5f3fc]">ลืมรหัสผ่าน?</a>
        </div>

        <button
          class="mt-1 w-full rounded-xl border border-[#22d3ee]/40 bg-gradient-to-r from-[#a5f3fc] via-[#22d3ee] to-[#a855f7] p-3.5 font-black text-[#080520] shadow-[0_10px_30px_rgba(34,211,238,0.28)] transition-all hover:scale-[1.02] hover:shadow-[0_15px_40px_rgba(34,211,238,0.4)]">
          เข้าสู่ระบบ
        </button>

        <div class="flex items-center gap-3 py-1 text-[11px] text-[#9fb3cc]/80">
          <span class="h-px flex-1 bg-[#a855f7]/30"></span>
          หรือ
          <span class="h-px flex-1 bg-[#a855f7]/30"></span>
        </div>

        <a
          href="/line"
          class="flex w-full items-center justify-center gap-2 rounded-xl bg-gradient-to-r from-[#00B900] to-[#009900] p-3 text-sm font-bold text-white shadow-md transition-all hover:scale-[1.02]">
          <span aria-hidden="true">💬</span> ติดต่อแอดมิน LINE
        </a>

        <div class="mt-1 flex items-center justify-between px-1">
          <div class="flex gap-2">
            <span class="rounded-full border border-[#22d3ee]/25 bg-[#0d0a2b] px-2.5 py-1 text-[10px] font-bold text-[#22d3ee]"><span aria-hidden="true">🔒</span> HTTPS + SSL</span>
            <span class="rounded-full border border-[#a855f7]/50 bg-[#0d0a2b]/80 px-2.5 py-1 text-[10px] font-bold text-[#e879f9]"><span aria-hidden="true">🕐</span> ระบบออโต้ 24 ชั่วโมง</span>
          </div>
          <a href="/register" class="text-xs font-bold text-[#a855f7] transition-colors hover:text-[#a5f3fc]">สมัครสมาชิกใหม่</a>
        </div>
      </div>
    </div>
  </div>

  <div slot="right" class="h-full">
    <div class="flex h-full flex-col rounded-2xl border border-[#22d3ee]/25 bg-[#080520]/92 p-5 shadow-[0_10px_30px_rgba(34,211,238,0.16)] backdrop-blur-md">
      <div class="mb-5 flex items-center justify-between gap-3">
        <div>
          <span class="text-xs font-bold tracking-wide text-[#9fb3cc]">ตารางอ้างอิงหมวดเกมและระบบที่ใช้ได้จากบัญชีเดียว</span>
          <div class="bg-gradient-to-r from-[#a5f3fc] via-[#22d3ee] to-[#a855f7] bg-clip-text text-3xl font-black text-transparent sm:text-4xl">ฝากถอนไม่มีขั้นต่ำ • ระบบออโต้ 24 ชม.</div>
        </div>
        <span class="flex items-center gap-1.5 self-start rounded-full border border-green-500/40 bg-green-900/40 px-2.5 py-1">
          <span class="h-1.5 w-1.5 animate-pulse rounded-full bg-green-500 shadow-[0_0_8px_rgba(34,197,94,0.7)]"></span>
          <span class="text-[10px] font-bold tracking-widest text-green-300 uppercase">Live</span>
        </span>
      </div>

      <div class="mb-2 flex items-center justify-between text-[11px] font-bold tracking-widest text-[#9fb3cc]/80 uppercase">
        <span>หมวดเกม / บริการในระบบ</span>
        <span>จุดที่ต้องดู</span>
      </div>

      <div class="flex flex-1 flex-col gap-2.5">
        {
          menus.map((m) => (
            <div class="rounded-xl border border-[#a855f7]/25 bg-[#0d0a2b]/95 px-3.5 py-2.5 transition-colors hover:border-[#22d3ee]/50 hover:bg-[#130d3a]">
              <div class="flex items-center justify-between gap-2 text-sm">
                <span class="flex min-w-0 items-center gap-2 font-bold text-[#cfe3f5]">
                  <span aria-hidden="true" class="w-5 shrink-0 text-center">{m.icon}</span> <span class="truncate">{m.name}</span>
                </span>
                <span class="shrink-0 rounded-full border border-[#22d3ee]/30 bg-[#080520] px-2.5 py-0.5 text-[10px] font-bold text-[#a5f3fc]">{m.tag}</span>
              </div>
              <div class="mt-1.5 text-[11px] tracking-wide text-[#9fb3cc]">{m.detail}</div>
            </div>
          ))
        }
      </div>

      <div class="mt-4 flex flex-wrap items-center justify-center gap-2">
        {chips.map((c) => <span class="rounded-full border border-[#22d3ee]/25 bg-[#0d0a2b] px-3 py-1 text-[10px] font-bold text-[#22d3ee]">{c}</span>)}
      </div>

      <div class="mt-3 text-center text-[10px] tracking-wide text-[#9fb3cc]/80">
        ข้อมูลในตารางใช้เพื่ออ้างอิงเท่านั้น ควรตรวจกติกา อัตราจ่าย ระดับความผันผวน และช่องทางฝากถอนที่รองรับจากหน้าเว็บไซต์จริงก่อนเริ่มใช้งานทุกครั้ง
      </div>
    </div>
  </div>
</ContentBoxTwo>
