---
import ContentBoxTwo from "./ContentBoxTwo.astro";

const menus = [
  { icon: "🎰", name: "เกมสล็อตหลายรูปแบบ", detail: "เลือกได้ตามธีม ฟีเจอร์ และอัตราจ่ายที่เหมาะกับงบประมาณของตัวเอง", tag: "เลือกตามธีม" },
  { icon: "🃏", name: "บาคาร่าและเกมไพ่", detail: "แต่ละโต๊ะมีกติกาและอัตราจ่ายต่างกัน ควรอ่านรายละเอียดให้ครบก่อนเริ่ม", tag: "อ่านกติกาก่อน" },
  { icon: "🎡", name: "เกมคาสิโนรูปแบบอื่น", detail: "เกมที่เหลือในระบบมีเงื่อนไขเฉพาะของตัวเอง ควรดูอัตราจ่ายก่อนเลือก", tag: "ดูเงื่อนไขเกม" },
  { icon: "📊", name: "ความผันผวนของแต่ละเกม", detail: "เกมจ่ายบ่อยกับเกมที่ต้องรอรอบทำเงินเหมาะกับงบประมาณคนละแบบ", tag: "ดูงบก่อนเลือก" },
  { icon: "⚡", name: "ฝากถอนระบบออโต้", detail: "ทำรายการผ่านหน้าบัญชีได้เอง ตรวจยอดเงินและข้อมูลบัญชีก่อนยืนยัน", tag: "ตรวจก่อนยืนยัน" },
  { icon: "📱", name: "รองรับทุกอุปกรณ์", detail: "ใช้งานผ่านมือถือ แท็บเล็ต และคอมพิวเตอร์ด้วยเบราว์เซอร์เดียว", tag: "เล่นได้ทุกที่" },
  { icon: "🔒", name: "ระบบบัญชีที่มั่นคง", detail: "เข้าผ่านทางเข้าหลัก ตั้งรหัสผ่านไม่ซ้ำ และออกจากระบบเมื่อใช้เครื่องผู้อื่น", tag: "ไม่ส่งต่อ OTP" },
];

const chips = ["คาสิโนออนไลน์", "เกมสล็อต", "บาคาร่า", "เกมไพ่", "ระบบออโต้", "รองรับมือถือ", "บริการ 24 ชม."];
---

<ContentBoxTwo
  titleleft="เข้าสู่ระบบ WIN666"
  titleright="หมวดเกมและระบบที่ใช้ได้ทั้งบนมือถือและคอมพิวเตอร์"
  label="เข้าสู่ระบบ WIN666 และหมวดเกมคาสิโนที่ใช้ได้ทุกอุปกรณ์">
  <div slot="left" class="flex h-full flex-col gap-4">
    <div class="relative overflow-hidden rounded-2xl border border-[#f6931e]/30 bg-[#161009]/92 p-6 shadow-[0_10px_30px_rgba(246,147,30,0.18)] backdrop-blur-md">
      <div class="pointer-events-none absolute -top-10 -right-10 h-32 w-32 rounded-full bg-[#e07b12]/22 blur-[50px]"></div>

      <div class="relative z-10 mb-5 flex items-center gap-3">
        <span
          aria-hidden="true"
          class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl border border-[#e07b12]/40 bg-gradient-to-br from-[#ffa943] via-[#e07b12] to-[#8f4b06] text-xl shadow-inner">
          🎰
        </span>
        <div class="flex flex-col">
          <p class="text-base font-black text-[#ffb35c]">ยินดีต้อนรับกลับ</p>
          <span class="text-[11px] text-[#f2dfc4]/70">บัญชีเดียวใช้เลือกเกมคาสิโน ตรวจสอบโปรโมชั่น และจัดการรายการฝากถอนของ WIN666 ได้จากหน้าเดียว</span>
        </div>
      </div>

      <div class="relative z-10 flex flex-col gap-3.5">
        <div class="relative">
          <span aria-hidden="true" class="absolute top-3.5 left-4 text-[#ffb35c]">👤</span>
          <input
            type="text"
            placeholder="เบอร์โทรศัพท์ / ยูสเซอร์เนม"
            class="w-full rounded-xl border border-[#f6931e]/35 bg-[#080503]/95 py-3 pr-4 pl-12 text-[#f2dfc4] transition-all outline-none placeholder:text-[#f2dfc4]/50 focus:border-[#f6931e] focus:ring-1 focus:ring-[#f6931e]/50"
          />
        </div>
        <div class="relative">
          <span aria-hidden="true" class="absolute top-3.5 left-4 text-[#ffb35c]">🔑</span>
          <input
            type="password"
            placeholder="รหัสผ่านของบัญชี"
            class="w-full rounded-xl border border-[#f6931e]/35 bg-[#080503]/95 py-3 pr-4 pl-12 text-[#f2dfc4] transition-all outline-none placeholder:text-[#f2dfc4]/50 focus:border-[#f6931e] focus:ring-1 focus:ring-[#f6931e]/50"
          />
        </div>

        <div class="flex items-center justify-between px-1 text-xs">
          <label class="flex items-center gap-2 text-[#f2dfc4]/75">
            <input type="checkbox" class="h-3.5 w-3.5 rounded border-[#f6931e]/40 bg-[#080503] accent-[#f6931e]" />
            จดจำฉันไว้
          </label>
          <a href="/login" class="text-[#f2dfc4]/75 transition-colors hover:text-[#ffb35c]">ลืมรหัสผ่าน?</a>
        </div>

        <button
          class="mt-1 w-full rounded-xl border border-[#f6931e]/40 bg-gradient-to-r from-[#ffb35c] via-[#f6931e] to-[#8f4b06] p-3.5 font-black text-[#180d02] shadow-[0_10px_30px_rgba(246,147,30,0.28)] transition-all hover:scale-[1.02] hover:shadow-[0_15px_40px_rgba(246,147,30,0.4)]">
          เข้าสู่ระบบ
        </button>

        <div class="flex items-center gap-3 py-1 text-[11px] text-[#f2dfc4]/60">
          <span class="h-px flex-1 bg-[#f6931e]/35"></span>
          หรือ
          <span class="h-px flex-1 bg-[#f6931e]/35"></span>
        </div>

        <a
          href="/line"
          class="flex w-full items-center justify-center gap-2 rounded-xl bg-gradient-to-r from-[#00B900] to-[#009900] p-3 text-sm font-bold text-white shadow-md transition-all hover:scale-[1.02]">
          <span aria-hidden="true">💬</span> ติดต่อแอดมิน LINE
        </a>

        <div class="mt-1 flex items-center justify-between px-1">
          <div class="flex gap-2">
            <span class="rounded-full border border-[#f6931e]/30 bg-[#080503] px-2.5 py-1 text-[10px] font-bold text-[#ffb35c]"><span aria-hidden="true">🔒</span> HTTPS + SSL</span>
            <span class="rounded-full border border-[#e07b12]/50 bg-[#080503]/80 px-2.5 py-1 text-[10px] font-bold text-[#f5e0bb]"><span aria-hidden="true">🕐</span> ระบบออโต้ 24 ชั่วโมง</span>
          </div>
          <a href="/register" class="text-xs font-bold text-[#ffb35c] transition-colors hover:text-[#f5e0bb]">สมัครสมาชิกใหม่</a>
        </div>
      </div>
    </div>
  </div>

  <div slot="right" class="h-full">
    <div class="flex h-full flex-col rounded-2xl border border-[#f6931e]/30 bg-[#161009]/92 p-5 shadow-[0_10px_30px_rgba(246,147,30,0.18)] backdrop-blur-md">
      <div class="mb-5 flex items-center justify-between gap-3">
        <div>
          <span class="text-xs font-bold tracking-wide text-[#f2dfc4]/70">ตารางอ้างอิงหมวดเกมและระบบที่ใช้ได้จากบัญชีเดียว</span>
          <div class="bg-gradient-to-r from-[#fff2e0] via-[#ffb35c] to-[#e07b12] bg-clip-text text-3xl font-black text-transparent sm:text-4xl">รวมเกมคาสิโน • ระบบออโต้ 24 ชม.</div>
        </div>
        <span class="flex items-center gap-1.5 self-start rounded-full border border-green-500/40 bg-green-900/40 px-2.5 py-1">
          <span class="h-1.5 w-1.5 animate-pulse rounded-full bg-green-500 shadow-[0_0_8px_rgba(34,197,94,0.7)]"></span>
          <span class="text-[10px] font-bold tracking-widest text-green-300 uppercase">Live</span>
        </span>
      </div>

      <div class="mb-2 flex items-center justify-between text-[11px] font-bold tracking-widest text-[#f2dfc4]/60 uppercase">
        <span>หมวดเกม / บริการในระบบ</span>
        <span>จุดที่ต้องดู</span>
      </div>

      <div class="flex flex-1 flex-col gap-2.5">
        {
          menus.map((m) => (
            <div class="rounded-xl border border-[#f6931e]/25 bg-[#080503]/95 px-3.5 py-2.5 transition-colors hover:border-[#e07b12]/50 hover:bg-[#241a0e]">
              <div class="flex items-center justify-between gap-2 text-sm">
                <span class="flex min-w-0 items-center gap-2 font-bold text-[#f2dfc4]">
                  <span aria-hidden="true" class="w-5 shrink-0 text-center">
                    {m.icon}
                  </span>{" "}
                  <span class="truncate">{m.name}</span>
                </span>
                <span class="shrink-0 rounded-full border border-[#e07b12]/30 bg-[#080503] px-2.5 py-0.5 text-[10px] font-bold text-[#f5e0bb]">{m.tag}</span>
              </div>
              <div class="mt-1.5 text-[11px] tracking-wide text-[#f2dfc4]/70">{m.detail}</div>
            </div>
          ))
        }
      </div>

      <div class="mt-4 flex flex-wrap items-center justify-center gap-2">
        {chips.map((c) => <span class="rounded-full border border-[#f6931e]/30 bg-[#080503] px-3 py-1 text-[10px] font-bold text-[#ffb35c]">{c}</span>)}
      </div>

      <div class="mt-3 text-center text-[10px] tracking-wide text-[#f2dfc4]/60">
        ข้อมูลในตารางใช้เพื่ออ้างอิงเท่านั้น ควรตรวจกติกา อัตราจ่าย เงื่อนไขของแต่ละเกม และช่องทางฝากถอนที่รองรับจากหน้าเว็บไซต์จริงก่อนเริ่มใช้งานทุกครั้ง
      </div>
    </div>
  </div>
</ContentBoxTwo>
