---
import ContentBoxTwo from "./ContentBoxTwo.astro";

const menus = [
  { icon: "🎰", name: "เกมสล็อตหลายรูปแบบ", detail: "เลือกได้ตามธีม ฟีเจอร์ และอัตราจ่ายที่เหมาะกับงบประมาณของตัวเอง", tag: "เลือกตามธีม" },
  { icon: "🃏", name: "บาคาร่าและเกมไพ่", detail: "แต่ละโต๊ะมีกติกาและอัตราจ่ายต่างกัน ควรอ่านรายละเอียดให้ครบก่อนเริ่ม", tag: "อ่านกติกาก่อน" },
  { icon: "🎡", name: "รูเล็ตและเกมวงล้อ", detail: "เดิมพันได้หลายรูปแบบในรอบเดียว อัตราจ่ายต่างกันตามช่องที่เลือก", tag: "ดูอัตราจ่าย" },
  { icon: "🎥", name: "คาสิโนสดถ่ายทอดจริง", detail: "โต๊ะถ่ายทอดสดมีเวลาต่อรอบจำกัด ควรดูวงเงินขั้นต่ำของโต๊ะก่อนเข้า", tag: "ดูวงเงินโต๊ะ" },
  { icon: "⚡", name: "ฝากถอนระบบออโต้", detail: "ทำรายการผ่านหน้าบัญชีได้เอง ตรวจชื่อบัญชีและจำนวนเงินก่อนยืนยัน", tag: "ตรวจก่อนยืนยัน" },
  { icon: "💸", name: "เงื่อนไขไม่มีขั้นต่ำ", detail: "รองรับเฉพาะช่องทางที่กำหนด ควรอ่านเงื่อนไขล่าสุดก่อนทำรายการ", tag: "ตามช่องทางที่กำหนด" },
  { icon: "📱", name: "รองรับทุกอุปกรณ์", detail: "ใช้งานผ่านมือถือ แท็บเล็ต และคอมพิวเตอร์ด้วยเบราว์เซอร์เดียว", tag: "เล่นได้ทุกที่" },
];

const chips = ["คาสิโนออนไลน์", "เกมสล็อต", "บาคาร่า", "รูเล็ต", "เกมไพ่", "คาสิโนสด", "ระบบออโต้", "ไม่มีขั้นต่ำ"];
---

<ContentBoxTwo
  titleleft="เข้าสู่ระบบ BUGGY888"
  titleright="หมวดเกมและระบบที่ใช้ได้ทั้งบนมือถือและคอมพิวเตอร์"
  label="เข้าสู่ระบบ BUGGY888 และหมวดเกมคาสิโนที่ใช้ได้ทุกอุปกรณ์">
  <div slot="left" class="flex h-full flex-col gap-4">
    <div class="relative overflow-hidden rounded-2xl border border-[#ffd233]/30 bg-[#1b0806]/92 p-6 shadow-[0_10px_30px_rgba(255,210,51,0.18)] backdrop-blur-md">
      <div class="pointer-events-none absolute -top-10 -right-10 h-32 w-32 rounded-full bg-[#e8241a]/25 blur-[50px]"></div>

      <div class="relative z-10 mb-5 flex items-center gap-3">
        <span
          aria-hidden="true"
          class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl border border-[#ffd233]/40 bg-gradient-to-br from-[#ffe98a] via-[#ffd233] to-[#8d630b] text-xl shadow-inner">
          🎰
        </span>
        <div class="flex flex-col">
          <p class="text-base font-black text-[#ffe98a]">ยินดีต้อนรับกลับ</p>
          <span class="text-[11px] text-[#d6ab7e]">บัญชีเดียวใช้เลือกเกมคาสิโน ตรวจสอบโปรโมชั่น และจัดการรายการฝากถอนของ BUGGY888 ได้จากหน้าเดียว</span>
        </div>
      </div>

      <div class="relative z-10 flex flex-col gap-3.5">
        <div class="relative">
          <span aria-hidden="true" class="absolute top-3.5 left-4 text-[#ffe98a]">👤</span>
          <input
            type="text"
            placeholder="เบอร์โทรศัพท์ / ยูสเซอร์เนม"
            class="w-full rounded-xl border border-[#ffd233]/35 bg-[#0b0302]/95 py-3 pr-4 pl-12 text-[#f7e2c4] transition-all outline-none placeholder:text-[#a8825f] focus:border-[#ffd233] focus:ring-1 focus:ring-[#ffd233]/50"
          />
        </div>
        <div class="relative">
          <span aria-hidden="true" class="absolute top-3.5 left-4 text-[#ffe98a]">🔑</span>
          <input
            type="password"
            placeholder="รหัสผ่านของบัญชี"
            class="w-full rounded-xl border border-[#ffd233]/35 bg-[#0b0302]/95 py-3 pr-4 pl-12 text-[#f7e2c4] transition-all outline-none placeholder:text-[#a8825f] focus:border-[#ffd233] focus:ring-1 focus:ring-[#ffd233]/50"
          />
        </div>

        <div class="flex items-center justify-between px-1 text-xs">
          <label class="flex items-center gap-2 text-[#d6ab7e]">
            <input type="checkbox" class="h-3.5 w-3.5 rounded border-[#ffd233]/40 bg-[#0b0302] accent-[#ffd233]" />
            จดจำฉันไว้
          </label>
          <a href="/login" class="text-[#d6ab7e] transition-colors hover:text-[#ffe98a]">ลืมรหัสผ่าน?</a>
        </div>

        <a
          href="/login"
          class="mt-1 block w-full rounded-xl border border-[#ffd233]/40 bg-gradient-to-r from-[#ffe98a] via-[#ffd233] to-[#8d630b] p-3.5 text-center font-black text-[#2a0704] shadow-[0_10px_30px_rgba(255,210,51,0.28)] transition-all hover:scale-[1.02] hover:shadow-[0_15px_40px_rgba(255,210,51,0.4)]">
          เข้าสู่ระบบ
        </a>

        <div class="flex items-center gap-3 py-1 text-[11px] text-[#a8825f]">
          <span class="h-px flex-1 bg-[#ffd233]/35"></span>
          หรือ
          <span class="h-px flex-1 bg-[#ffd233]/35"></span>
        </div>

        <a
          href="/line"
          class="flex w-full items-center justify-center gap-2 rounded-xl bg-gradient-to-r from-[#00B900] to-[#009900] p-3 text-sm font-bold text-white shadow-md transition-all hover:scale-[1.02]">
          <span aria-hidden="true">💬</span> ติดต่อแอดมิน LINE
        </a>

        <div class="mt-1 flex items-center justify-between px-1">
          <div class="flex gap-2">
            <span class="rounded-full border border-[#ffd233]/30 bg-[#0b0302] px-2.5 py-1 text-[10px] font-bold text-[#ffe98a]"><span aria-hidden="true">🔒</span> HTTPS + SSL</span>
            <span class="rounded-full border border-[#e8241a]/50 bg-[#0b0302]/80 px-2.5 py-1 text-[10px] font-bold text-[#f7e2c4]"><span aria-hidden="true">🕐</span> ระบบออโต้ 24 ชั่วโมง</span>
          </div>
          <a href="/register" class="text-xs font-bold text-[#ffe98a] transition-colors hover:text-[#fff3cf]">สมัครสมาชิกใหม่</a>
        </div>
      </div>
    </div>
  </div>

  <div slot="right" class="h-full">
    <div class="flex h-full flex-col rounded-2xl border border-[#ffd233]/30 bg-[#1b0806]/92 p-5 shadow-[0_10px_30px_rgba(255,210,51,0.18)] backdrop-blur-md">
      <div class="mb-5 flex items-center justify-between gap-3">
        <div>
          <span class="text-xs font-bold tracking-wide text-[#d6ab7e]">ตารางอ้างอิงหมวดเกมและระบบที่ใช้ได้จากบัญชีเดียว</span>
          <div class="bg-gradient-to-r from-[#fff3cf] via-[#ffd233] to-[#e0a81c] bg-clip-text text-3xl font-black text-transparent sm:text-4xl">รวมเกมคาสิโน • ระบบออโต้ 24 ชม.</div>
        </div>
        <span class="flex items-center gap-1.5 self-start rounded-full border border-green-500/40 bg-green-900/40 px-2.5 py-1">
          <span class="h-1.5 w-1.5 animate-pulse rounded-full bg-green-500 shadow-[0_0_8px_rgba(34,197,94,0.7)]"></span>
          <span class="text-[10px] font-bold tracking-widest text-green-300 uppercase">Live</span>
        </span>
      </div>

      <div class="mb-2 flex items-center justify-between text-[11px] font-bold tracking-widest text-[#a8825f] uppercase">
        <span>หมวดเกม / บริการในระบบ</span>
        <span>จุดที่ต้องดู</span>
      </div>

      <div class="flex flex-1 flex-col gap-2.5">
        {
          menus.map((m) => (
            <div class="rounded-xl border border-[#ffd233]/25 bg-[#0b0302]/95 px-3.5 py-2.5 transition-colors hover:border-[#e8241a]/50 hover:bg-[#2a0d09]">
              <div class="flex items-center justify-between gap-2 text-sm">
                <span class="flex min-w-0 items-center gap-2 font-bold text-[#f7e2c4]">
                  <span aria-hidden="true" class="w-5 shrink-0 text-center">
                    {m.icon}
                  </span>{" "}
                  <span class="truncate">{m.name}</span>
                </span>
                <span class="shrink-0 rounded-full border border-[#e0a81c]/40 bg-[#0b0302] px-2.5 py-0.5 text-[10px] font-bold text-[#ffe98a]">{m.tag}</span>
              </div>
              <div class="mt-1.5 text-[11px] tracking-wide text-[#d6ab7e]">{m.detail}</div>
            </div>
          ))
        }
      </div>

      <div class="mt-4 flex flex-wrap items-center justify-center gap-2">
        {chips.map((c) => <span class="rounded-full border border-[#ffd233]/30 bg-[#0b0302] px-3 py-1 text-[10px] font-bold text-[#ffe98a]">{c}</span>)}
      </div>

      <div class="mt-3 text-center text-[10px] tracking-wide text-[#a8825f]">
        ข้อมูลในตารางใช้เพื่ออ้างอิงเท่านั้น ควรตรวจกติกา อัตราจ่าย เงื่อนไขของแต่ละเกม และช่องทางฝากถอนที่รองรับจากหน้าเว็บไซต์จริงก่อนเริ่มใช้งานทุกครั้ง
      </div>
    </div>
  </div>
</ContentBoxTwo>
