---
import ContentBoxTwo from "./ContentBoxTwo.astro";

// Reference table, not article content — every label below renders as <p>/<span>
// inside ContentBoxTwo (whose `as` prop stays at its "p" default), and the
// section's aria-label carries the accessible name. It closes the page after the
// FAQ and collects, in one place, the things the TT1BET brief says to check:
// ฟีเจอร์ อัตราจ่าย และวงเงิน of each provider before comparing; ยอดฝากขั้นต่ำ
// เกมที่ร่วมรายการ ระยะเวลา และเงื่อนไขการถอน before taking a bonus; ชื่อ
// โปรโมชั่น จำนวนเครดิต และสิทธิ์ที่ใช้ร่วมกันได้ before confirming; ชื่อบัญชี
// จำนวนเงิน และสถานะรายการ before a deposit; ยอดคงเหลือ ประวัติถอน สถานะ
// ธุรกรรม และเลขอ้างอิง afterwards; and RTP ความผันผวน ตารางจ่าย และกติกา before
// choosing a game.
//
// NOTHING here states a figure — no RTP percentage, no payout multiple, no
// transfer time. The brief gives none, and an invented number is a claim the
// site cannot back. Every row is a thing to look up in the system, not a value
// to trust from this page.
const tableFactors = [
  { icon: "🏷️", name: "ชื่อค่ายของเกมที่เลือก", meta: "ดูว่าเกมนั้นมาจากค่ายใดและระบบแสดงข้อมูลค่ายไว้ครบหรือไม่", note: "ช่วยเทียบเกมข้ามค่ายได้ง่ายขึ้น", tag: "ดูก่อนเลือกเกม" },
  { icon: "⚖️", name: "ฟีเจอร์ อัตราจ่าย และวงเงิน", meta: "แต่ละค่ายกำหนดไว้ต่างกัน ควรเทียบข้อมูลก่อนเลือกเล่น", note: "เลือกให้ตรงกับงบและสไตล์ของตนเอง", tag: "ใช้เทียบค่าย" },
  { icon: "📄", name: "กติกาและรายละเอียดเกม", meta: "อ่านวิธีเล่น เงื่อนไขรอบเกม และข้อมูลที่หน้าเกมระบุไว้", note: "แต่ละเกมเขียนกติกาไว้ไม่เหมือนกัน", tag: "อ่านให้ครบ" },
  { icon: "📊", name: "ตารางจ่ายของแต่ละเกม", meta: "ดูสัญลักษณ์ แนวการจ่าย และเงื่อนไขที่ตารางจ่ายกำหนด", note: "ใช้เทียบเกมในหมวดเดียวกัน", tag: "ใช้เทียบเกม" },
  { icon: "🎯", name: "RTP ที่ผู้ให้บริการระบุ", meta: "ดูค่าที่ค่ายเกมแจ้งไว้ในหน้าเกม ไม่ใช่ตัวเลขจากคำโปรโมต", note: "เป็นค่าอ้างอิงระยะยาว ไม่ใช่ผลต่อรอบ", tag: "ดูจากหน้าเกม" },
  { icon: "📈", name: "ความผันผวนของเกม", meta: "เกมผันผวนสูงกับต่ำให้จังหวะการจ่ายต่างกันชัดเจน", note: "เลือกให้เข้ากับงบที่ตั้งไว้", tag: "เลือกตามงบ" },
  { icon: "🎁", name: "จำนวนโบนัสและยอดฝากขั้นต่ำ", meta: "ดูสองอย่างร่วมกัน ไม่ควรพิจารณาเฉพาะจำนวนเครดิต", note: "โปรที่เหมาะกับงบอาจคุ้มกว่าเครดิตสูง", tag: "ดูก่อนรับสิทธิ์" },
  { icon: "📋", name: "เกมที่ร่วมรายการและระยะเวลา", meta: "ตรวจว่าเกมที่เล่นอยู่ร่วมรายการหรือไม่ และโปรสิ้นสุดเมื่อใด", note: "อ่านเงื่อนไขการถอนประกอบทุกครั้ง", tag: "อ่านก่อนยืนยัน" },
  { icon: "🔗", name: "สิทธิ์โปรที่ใช้ร่วมกันได้", meta: "หากมีหลายโปรโมชั่นพร้อมกันควรดูว่าใช้ร่วมกันได้หรือไม่", note: "ไม่แน่ใจให้ติดต่อทีมงานก่อนกดรับ", tag: "ตรวจก่อนกดรับ" },
  { icon: "🧾", name: "ชื่อบัญชีและจำนวนเงินก่อนยืนยัน", meta: "ตรวจชื่อบัญชี จำนวนเงิน และสถานะรายการให้ชัดเจนทุกครั้ง", note: "รอรายการเดิมอัปเดตก่อนทำรายการใหม่", tag: "ตรวจก่อนยืนยัน" },
  { icon: "🔖", name: "เลขอ้างอิงและสถานะธุรกรรม", meta: "ดูยอดคงเหลือ ประวัติถอน และสถานะรายการจากหน้าบัญชี", note: "เก็บเวลา จำนวนเงิน และเลขอ้างอิงไว้ก่อน", tag: "ตรวจย้อนหลัง" },
];

const chips = [
  "คาสิโนออนไลน์",
  "สล็อตออนไลน์",
  "บาคาร่า",
  "คาสิโนสด",
  "ค่ายเกม",
  "อัตราจ่าย",
  "วงเงิน",
  "RTP",
  "ความผันผวน",
  "ตารางจ่าย",
  "กติกาของเกม",
  "โบนัส",
  "ยอดฝากขั้นต่ำ",
  "เกมที่ร่วมรายการ",
  "เงื่อนไขการถอน",
  "สถานะธุรกรรม",
  "เลขอ้างอิง",
  "ระบบบัญชี",
];
---

<ContentBoxTwo
  titleleft="เข้าสู่ระบบ TT1BET"
  titleright="สิ่งที่ควรตรวจก่อนเลือกเกมและก่อนรับสิทธิ์"
  iconleft="🔐"
  iconright="🎯"
  label="เข้าสู่ระบบ TT1BET และตารางอ้างอิงสิ่งที่ควรตรวจก่อนเปรียบเทียบค่ายเกม ดู RTP และความผันผวน อ่านเงื่อนไขโบนัส และติดตามสถานะธุรกรรม">
  <div slot="left" class="flex h-full flex-col gap-4">
    <div class="relative overflow-hidden rounded-2xl border border-[#e9c341]/40 bg-[#171008]/92 p-6 shadow-[0_10px_30px_rgba(233,195,65,0.22)] backdrop-blur-md">
      <div aria-hidden="true" class="pointer-events-none absolute -top-10 -right-10 h-32 w-32 rounded-full bg-[#b8862a]/45 blur-[50px]"></div>

      <div class="relative z-10 mb-5 flex items-center gap-3">
        <span
          aria-hidden="true"
          class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl border border-[#fcf1b0]/50 bg-gradient-to-br from-[#fff8d6] to-[#e9c341] text-xl text-[#0b0805] shadow-inner">
          🛡️
        </span>
        <div class="flex flex-col">
          <p class="text-base font-black text-[#fcf1b0]">ยินดีต้อนรับกลับ</p>
          <span class="text-[11px] text-[#d8c39a]">
            บัญชีเดียวใช้เลือกเกมจากหลายค่ายในระบบเดียว เทียบฟีเจอร์ อัตราจ่าย และวงเงิน ดู RTP กับตารางจ่าย ตรวจโปรโมชั่นและโบนัส แล้วติดตามสถานะธุรกรรมของ TT1BET ได้จากจุดเดียว
          </span>
        </div>
      </div>

      <div class="relative z-10 flex flex-col gap-3.5">
        <div class="relative">
          <span aria-hidden="true" class="absolute top-3.5 left-4 text-[#fcf1b0]">👤</span>
          <input
            type="text"
            aria-label="เบอร์โทรศัพท์หรือยูสเซอร์เนม"
            placeholder="เบอร์โทรศัพท์ / ยูสเซอร์เนม"
            class="w-full rounded-xl border border-[#6d4a13]/80 bg-[#0b0805]/95 py-3 pr-4 pl-12 text-[#f2e7cd] transition-all outline-none placeholder:text-[#d8c39a] focus:border-[#e9c341] focus:ring-1 focus:ring-[#e9c341]/50"
          />
        </div>
        <div class="relative">
          <span aria-hidden="true" class="absolute top-3.5 left-4 text-[#fcf1b0]">🔑</span>
          <input
            type="password"
            aria-label="รหัสผ่านของบัญชี"
            placeholder="รหัสผ่านของบัญชี"
            class="w-full rounded-xl border border-[#6d4a13]/80 bg-[#0b0805]/95 py-3 pr-4 pl-12 text-[#f2e7cd] transition-all outline-none placeholder:text-[#d8c39a] focus:border-[#e9c341] focus:ring-1 focus:ring-[#e9c341]/50"
          />
        </div>

        <div class="flex items-center justify-between px-1 text-xs">
          <label class="flex items-center gap-2 text-[#d8c39a]">
            <input type="checkbox" class="h-3.5 w-3.5 rounded border-[#6d4a13]/80 bg-[#0b0805] accent-[#e9c341]" />
            จดจำฉันไว้
          </label>
          <a href="/login" class="text-[#d8c39a] transition-colors hover:text-[#fcf1b0]">ลืมรหัสผ่าน?</a>
        </div>

        <a
          href="/login"
          class="mt-1 block w-full rounded-xl border border-[#fcf1b0]/50 bg-gradient-to-r from-[#e9c341] to-[#b8862a] p-3.5 text-center font-black text-[#0b0805] shadow-[0_10px_30px_rgba(233,195,65,0.3)] transition-all hover:scale-[1.02] hover:shadow-[0_15px_40px_rgba(233,195,65,0.45)]">
          เข้าสู่ระบบ
        </a>

        <div class="flex items-center gap-3 py-1 text-[11px] text-[#d8c39a]">
          <span aria-hidden="true" class="h-px flex-1 bg-[#6d4a13]/80"></span>
          หรือ
          <span aria-hidden="true" class="h-px flex-1 bg-[#6d4a13]/80"></span>
        </div>

        <a
          href="/line"
          class="flex w-full items-center justify-center gap-2 rounded-xl bg-gradient-to-r from-[#00B900] to-[#009900] p-3 text-sm font-bold text-white shadow-md transition-all hover:scale-[1.02]">
          <span aria-hidden="true">💬</span> ทักไลน์ทีมงานคนไทย
        </a>

        <div class="mt-1 flex items-center justify-between px-1">
          <div class="flex gap-2">
            <span class="rounded-full border border-[#6d4a13]/80 bg-[#0b0805] px-2.5 py-1 text-[10px] font-bold text-[#fcf1b0]"><span aria-hidden="true">🔒</span> HTTPS + SSL</span>
            <span class="rounded-full border border-[#6d4a13]/80 bg-[#0b0805]/80 px-2.5 py-1 text-[10px] font-bold text-[#f2e7cd]"><span aria-hidden="true">🕐</span> ดูแลสมาชิก 24 ชั่วโมง</span>
          </div>
          <a href="/register" class="text-xs font-bold text-[#fcf1b0] transition-colors hover:text-[#e9c341]">สมัครสมาชิกใหม่</a>
        </div>
      </div>
    </div>
  </div>

  <div slot="right" class="h-full">
    <div class="flex h-full flex-col rounded-2xl border border-[#e9c341]/40 bg-[#171008]/92 p-5 shadow-[0_10px_30px_rgba(233,195,65,0.22)] backdrop-blur-md">
      <div class="mb-5 flex items-center justify-between gap-3">
        <div>
          <span class="text-xs font-bold tracking-wide text-[#d8c39a]">ตารางอ้างอิงสิ่งที่ควรดูก่อนเลือกเกม ก่อนรับโบนัส และก่อนยืนยันรายการ</span>
          <p class="bg-gradient-to-r from-[#fff8d6] via-[#e9c341] to-[#b8862a] bg-clip-text text-3xl font-black text-transparent sm:text-4xl">ดูข้อมูลค่ายเกม RTP โบนัส และสถานะรายการก่อนยืนยัน</p>
        </div>
        <span class="flex items-center gap-1.5 self-start rounded-full border border-[#e9c341]/45 bg-[#0b0805]/70 px-2.5 py-1">
          <span aria-hidden="true" class="h-1.5 w-1.5 animate-pulse rounded-full bg-[#e9c341] shadow-[0_0_8px_rgba(233,195,65,0.8)]"></span>
          <span class="text-[10px] font-bold tracking-widest text-[#fcf1b0] uppercase">Live</span>
        </span>
      </div>

      <div class="mb-2 flex items-center justify-between text-[11px] font-bold tracking-widest text-[#d8c39a] uppercase">
        <span>หัวข้อ / สิ่งที่ควรดู</span>
        <span>รายละเอียดที่ควรตรวจในระบบ</span>
      </div>

      <div class="flex flex-1 flex-col gap-2.5">
        {
          tableFactors.map((b) => (
            <div class="rounded-xl border border-[#6d4a13]/70 bg-[#0b0805]/95 px-3.5 py-2.5 transition-colors hover:border-[#e9c341]/60 hover:bg-[#241a0d]">
              <div class="flex items-center justify-between gap-2 text-sm">
                <span class="flex min-w-0 items-center gap-2 font-bold text-[#f2e7cd]">
                  <span aria-hidden="true" class="w-5 shrink-0 text-center">
                    {b.icon}
                  </span>
                  <span class="truncate">{b.name}</span>
                </span>
                <span class="shrink-0 rounded-full border border-[#e9c341]/50 bg-[#0b0805] px-2.5 py-0.5 text-[10px] font-bold text-[#fcf1b0]">{b.tag}</span>
              </div>
              <div class="mt-1.5 flex flex-wrap items-center gap-x-3 gap-y-1 text-[11px] tracking-wide text-[#d8c39a]">
                <span>{b.meta}</span>
                <span class="font-bold text-[#e9c341]">{b.note}</span>
              </div>
            </div>
          ))
        }
      </div>

      <div class="mt-4 flex flex-wrap items-center justify-center gap-2">
        {chips.map((c) => <span class="rounded-full border border-[#6d4a13]/80 bg-[#0b0805] px-3 py-1 text-[10px] font-bold text-[#fcf1b0]">{c}</span>)}
      </div>

      <div class="mt-3 text-center text-[10px] tracking-wide text-[#d8c39a]">
        หัวข้อในตารางเป็นสิ่งที่ควรเปิดดูในระบบก่อนเลือกเกมและก่อนยืนยันรายการ ไม่ใช่ตัวเลขรับประกัน แต่ละค่ายเกมกำหนดกติกา ตารางจ่าย RTP ความผันผวน และเงื่อนไขโบนัสไว้ต่างกัน
        จึงอาจเปลี่ยนได้ตามเกมและตามที่ระบบแสดงในขณะนั้น ควรตรวจข้อมูลจริงก่อนยืนยันทุกครั้ง และกำหนดวงเงินกับงบไว้ล่วงหน้าเสมอ
      </div>
    </div>
  </div>
</ContentBoxTwo>
