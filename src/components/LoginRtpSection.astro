---
import ContentBoxTwo from "./ContentBoxTwo.astro";

// Reference table, not article content — every label below renders as <p>/<span>
// inside ContentBoxTwo, whose section carries the aria-label. Copy follows the
// AMBPLUS brief: slot เว็บตรง, ระบบออโต้, Wallet, หลายอุปกรณ์.
const menus = [
  { icon: "🎰", name: "สล็อตคลาสสิกวงล้อสั้น", detail: "กติกาไม่ซับซ้อน จบรอบเร็ว เหมาะกับการทำความเข้าใจรูปแบบการจ่ายก่อนเริ่ม", tag: "กติกาเข้าใจง่าย" },
  { icon: "🎁", name: "สล็อตฟีเจอร์โบนัส", detail: "รอบฟรีสปินและฟีเจอร์พิเศษของแต่ละเกมมีเงื่อนไขต่างกัน ควรอ่านก่อนเล่น", tag: "อ่านเงื่อนไขรอบโบนัส" },
  { icon: "🔎", name: "ค้นหาตามค่ายและธีม", detail: "เลือกดูเกมตามค่าย ธีม หรือสไตล์ที่สนใจ ช่วยให้หาเกมที่ตรงความชอบได้เร็ว", tag: "เลือกตามค่าย/ธีม" },
  { icon: "📈", name: "อัตราจ่ายและความผันผวน", detail: "เกมจ่ายบ่อยกับเกมที่ต้องรอรอบทำเงินเหมาะกับงบประมาณคนละแบบ", tag: "ดูก่อนเลือกเกม" },
  { icon: "⚡", name: "ฝากถอนระบบออโต้", detail: "ทำรายการผ่านหน้าบัญชีได้เอง ตรวจชื่อบัญชีและจำนวนเงินก่อนยืนยันทุกครั้ง", tag: "ตรวจก่อนยืนยัน" },
  { icon: "👛", name: "รองรับ Wallet บนมือถือ", detail: "ควรใช้ข้อมูลกระเป๋าเงินที่ตรงกับบัญชีสมัคร และเก็บรายละเอียดรายการไว้จนระบบยืนยัน", tag: "ใช้ข้อมูลให้ตรงกัน" },
  { icon: "📱", name: "ใช้งานได้หลายอุปกรณ์", detail: "เปิดผ่านเบราว์เซอร์บนมือถือ แท็บเล็ต และคอมพิวเตอร์ด้วยบัญชีเดียว", tag: "เข้าผ่านช่องทางหลัก" },
];

const chips = ["สล็อตเว็บตรง", "ระบบออโต้", "ฝากถอน Wallet", "ฟีเจอร์โบนัส", "เลือกตามค่าย", "ความผันผวน", "รองรับมือถือ", "จ่ายไว"];
---

<ContentBoxTwo
  titleleft="เข้าสู่ระบบ AMBPLUS"
  titleright="หมวดเกมและระบบที่ใช้ได้ทั้งบนมือถือและคอมพิวเตอร์"
  label="เข้าสู่ระบบ AMBPLUS และหมวดเกมสล็อตที่ใช้ได้ทุกอุปกรณ์">
  <div slot="left" class="flex h-full flex-col gap-4">
    <div class="relative overflow-hidden rounded-2xl border border-[#ecd48c]/30 bg-[#16110a]/92 p-6 shadow-[0_10px_30px_rgba(236,212,140,0.18)] backdrop-blur-md">
      <div class="pointer-events-none absolute -top-10 -right-10 h-32 w-32 rounded-full bg-[#6b4e17]/45 blur-[50px]"></div>

      <div class="relative z-10 mb-5 flex items-center gap-3">
        <span
          aria-hidden="true"
          class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl border border-[#ecd48c]/40 bg-gradient-to-br from-[#fbf2c4] via-[#ecd48c] to-[#8c6b22] text-xl shadow-inner">
          🎰
        </span>
        <div class="flex flex-col">
          <p class="text-base font-black text-[#fbf2c4]">ยินดีต้อนรับกลับ</p>
          <span class="text-[11px] text-[#bfaa85]">บัญชีเดียวใช้เลือกเกมสล็อต ตรวจสอบโปรโมชั่น และจัดการรายการฝากถอนผ่าน Wallet ของ AMBPLUS ได้จากหน้าเดียว</span>
        </div>
      </div>

      <div class="relative z-10 flex flex-col gap-3.5">
        <div class="relative">
          <span aria-hidden="true" class="absolute top-3.5 left-4 text-[#ecd48c]">👤</span>
          <input
            type="text"
            placeholder="เบอร์โทรศัพท์ / ยูสเซอร์เนม"
            class="w-full rounded-xl border border-[#ecd48c]/35 bg-[#0a0806]/95 py-3 pr-4 pl-12 text-[#efe3c8] transition-all outline-none placeholder:text-[#8c7a58] focus:border-[#ecd48c] focus:ring-1 focus:ring-[#ecd48c]/50"
          />
        </div>
        <div class="relative">
          <span aria-hidden="true" class="absolute top-3.5 left-4 text-[#ecd48c]">🔑</span>
          <input
            type="password"
            placeholder="รหัสผ่านของบัญชี"
            class="w-full rounded-xl border border-[#ecd48c]/35 bg-[#0a0806]/95 py-3 pr-4 pl-12 text-[#efe3c8] transition-all outline-none placeholder:text-[#8c7a58] focus:border-[#ecd48c] focus:ring-1 focus:ring-[#ecd48c]/50"
          />
        </div>

        <div class="flex items-center justify-between px-1 text-xs">
          <label class="flex items-center gap-2 text-[#bfaa85]">
            <input type="checkbox" class="h-3.5 w-3.5 rounded border-[#ecd48c]/40 bg-[#0a0806] accent-[#ecd48c]" />
            จดจำฉันไว้
          </label>
          <a href="/login" class="text-[#bfaa85] transition-colors hover:text-[#fbf2c4]">ลืมรหัสผ่าน?</a>
        </div>

        <a
          href="/login"
          class="mt-1 block w-full rounded-xl border border-[#ecd48c]/40 bg-gradient-to-r from-[#fbf2c4] via-[#ecd48c] to-[#8c6b22] p-3.5 text-center font-black text-[#17110a] shadow-[0_10px_30px_rgba(236,212,140,0.28)] transition-all hover:scale-[1.02] hover:shadow-[0_15px_40px_rgba(236,212,140,0.4)]">
          เข้าสู่ระบบ
        </a>

        <div class="flex items-center gap-3 py-1 text-[11px] text-[#8c7a58]">
          <span class="h-px flex-1 bg-[#ecd48c]/35"></span>
          หรือ
          <span class="h-px flex-1 bg-[#ecd48c]/35"></span>
        </div>

        <a
          href="/line"
          class="flex w-full items-center justify-center gap-2 rounded-xl bg-gradient-to-r from-[#00B900] to-[#009900] p-3 text-sm font-bold text-white shadow-md transition-all hover:scale-[1.02]">
          <span aria-hidden="true">💬</span> ติดต่อแอดมิน LINE
        </a>

        <div class="mt-1 flex items-center justify-between px-1">
          <div class="flex gap-2">
            <span class="rounded-full border border-[#ecd48c]/30 bg-[#0a0806] px-2.5 py-1 text-[10px] font-bold text-[#fbf2c4]"><span aria-hidden="true">🔒</span> HTTPS + SSL</span>
            <span class="rounded-full border border-[#6b4e17]/70 bg-[#0a0806]/80 px-2.5 py-1 text-[10px] font-bold text-[#efe3c8]"><span aria-hidden="true">🕐</span> ระบบออโต้ 24 ชั่วโมง</span>
          </div>
          <a href="/register" class="text-xs font-bold text-[#fbf2c4] transition-colors hover:text-[#ecd48c]">สมัครสมาชิกใหม่</a>
        </div>
      </div>
    </div>
  </div>

  <div slot="right" class="h-full">
    <div class="flex h-full flex-col rounded-2xl border border-[#ecd48c]/30 bg-[#16110a]/92 p-5 shadow-[0_10px_30px_rgba(236,212,140,0.18)] backdrop-blur-md">
      <div class="mb-5 flex items-center justify-between gap-3">
        <div>
          <span class="text-xs font-bold tracking-wide text-[#bfaa85]">ตารางอ้างอิงหมวดเกมและระบบที่ใช้ได้จากบัญชีเดียว</span>
          <div class="bg-gradient-to-r from-[#fbf2c4] via-[#ecd48c] to-[#c9a24a] bg-clip-text text-3xl font-black text-transparent sm:text-4xl">รวมเกมสล็อต • ระบบออโต้ 24 ชม.</div>
        </div>
        <span class="flex items-center gap-1.5 self-start rounded-full border border-green-500/40 bg-green-900/40 px-2.5 py-1">
          <span class="h-1.5 w-1.5 animate-pulse rounded-full bg-green-500 shadow-[0_0_8px_rgba(34,197,94,0.7)]"></span>
          <span class="text-[10px] font-bold tracking-widest text-green-300 uppercase">Live</span>
        </span>
      </div>

      <div class="mb-2 flex items-center justify-between text-[11px] font-bold tracking-widest text-[#8c7a58] uppercase">
        <span>หมวดเกม / บริการในระบบ</span>
        <span>จุดที่ต้องดู</span>
      </div>

      <div class="flex flex-1 flex-col gap-2.5">
        {
          menus.map((m) => (
            <div class="rounded-xl border border-[#ecd48c]/25 bg-[#0a0806]/95 px-3.5 py-2.5 transition-colors hover:border-[#c9a24a]/55 hover:bg-[#241b0e]">
              <div class="flex items-center justify-between gap-2 text-sm">
                <span class="flex min-w-0 items-center gap-2 font-bold text-[#efe3c8]">
                  <span aria-hidden="true" class="w-5 shrink-0 text-center">
                    {m.icon}
                  </span>{" "}
                  <span class="truncate">{m.name}</span>
                </span>
                <span class="shrink-0 rounded-full border border-[#c9a24a]/45 bg-[#0a0806] px-2.5 py-0.5 text-[10px] font-bold text-[#fbf2c4]">{m.tag}</span>
              </div>
              <div class="mt-1.5 text-[11px] tracking-wide text-[#bfaa85]">{m.detail}</div>
            </div>
          ))
        }
      </div>

      <div class="mt-4 flex flex-wrap items-center justify-center gap-2">
        {chips.map((c) => <span class="rounded-full border border-[#ecd48c]/30 bg-[#0a0806] px-3 py-1 text-[10px] font-bold text-[#fbf2c4]">{c}</span>)}
      </div>

      <div class="mt-3 text-center text-[10px] tracking-wide text-[#8c7a58]">
        ข้อมูลในตารางใช้เพื่ออ้างอิงเท่านั้น ควรตรวจกติกา อัตราจ่าย ความผันผวนของแต่ละเกม และช่องทาง Wallet ที่รองรับจากหน้าเว็บไซต์จริงก่อนเริ่มใช้งานทุกครั้ง
      </div>
    </div>
  </div>
</ContentBoxTwo>
