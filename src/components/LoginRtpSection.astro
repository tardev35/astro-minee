---
import ContentBoxTwo from "./ContentBoxTwo.astro";

const menus = [
  { icon: "🎰", name: "เกมสล็อต", detail: "วงล้อหลายรูปแบบ ควรอ่านกติกาและอัตราการจ่ายก่อนวางงบประมาณ", tag: "เริ่มจากกติกา" },
  { icon: "🎴", name: "บาคาร่า", detail: "เกมไพ่ที่กติกาสั้น ควรตรวจเงื่อนไขการจ่ายของแต่ละห้องก่อนเริ่ม", tag: "ดูเงื่อนไขห้อง" },
  { icon: "🎡", name: "รูเล็ต", detail: "มีรูปแบบการวางเดิมพันหลายแบบในเกมเดียว เลือกให้เหมาะกับงบ", tag: "หลายรูปแบบ" },
  { icon: "🃏", name: "เกมไพ่และคาสิโนสด", detail: "รวมเกมไพ่และโต๊ะถ่ายทอดสดจากหลายค่ายไว้ในระบบเดียว", tag: "หลายค่ายในที่เดียว" },
  { icon: "⚡", name: "ฝากถอนออโต้", detail: "ทำรายการผ่านหน้าบัญชีได้เอง ตรวจยอดก่อนยืนยันและเก็บหลักฐานไว้", tag: "ตรวจก่อนยืนยัน" },
  { icon: "💸", name: "ฝากถอนไม่มีขั้นต่ำ", detail: "กำหนดยอดทำรายการได้ยืดหยุ่นตามช่องทางที่เว็บไซต์กำหนด", tag: "ตรวจช่องทางก่อน" },
  { icon: "📱", name: "รองรับทุกอุปกรณ์", detail: "ใช้งานผ่านมือถือ แท็บเล็ต และคอมพิวเตอร์ด้วยเบราว์เซอร์เดียว", tag: "เล่นได้ทุกที่" },
];

const chips = ["สล็อต", "บาคาร่า", "รูเล็ต", "เกมไพ่", "คาสิโนสด", "ไม่มีขั้นต่ำ", "รองรับมือถือ"];
---

<ContentBoxTwo titleleft="เข้าสู่ระบบ LCX88" titleright="หมวดเกมและระบบที่ใช้ได้ทั้งบนมือถือและคอมพิวเตอร์" label="เข้าสู่ระบบ LCX88 และหมวดเกมคาสิโนที่ใช้ได้ทุกอุปกรณ์">
  <div slot="left" class="flex h-full flex-col gap-4">
    <div class="relative overflow-hidden rounded-2xl border border-[#2f6bff]/30 bg-[#0a1547]/92 p-6 shadow-[0_10px_30px_rgba(47,107,255,0.18)] backdrop-blur-md">
      <div class="pointer-events-none absolute -top-10 -right-10 h-32 w-32 rounded-full bg-[#f5c542]/22 blur-[50px]"></div>

      <div class="relative z-10 mb-5 flex items-center gap-3">
        <span
          aria-hidden="true"
          class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl border border-[#f5c542]/40 bg-gradient-to-br from-[#ffe08a] via-[#f5c542] to-[#c08b1f] text-xl shadow-inner">
          🎰
        </span>
        <div class="flex flex-col">
          <p class="text-base font-black text-[#f5c542]">ยินดีต้อนรับกลับ</p>
          <span class="text-[11px] text-[#9db0dd]">บัญชีเดียวใช้เลือกเกม ตรวจสอบโปรโมชั่น และจัดการรายการฝากถอนของ LCX88 ได้จากหน้าเดียว</span>
        </div>
      </div>

      <div class="relative z-10 flex flex-col gap-3.5">
        <div class="relative">
          <span aria-hidden="true" class="absolute top-3.5 left-4 text-[#6ea3ff]">👤</span>
          <input
            type="text"
            placeholder="เบอร์โทรศัพท์ / ยูสเซอร์เนม"
            class="w-full rounded-xl border border-[#2f6bff]/35 bg-[#071138]/95 py-3 pr-4 pl-12 text-[#d7e3ff] transition-all outline-none placeholder:text-[#9db0dd]/70 focus:border-[#f5c542] focus:ring-1 focus:ring-[#f5c542]/50"
          />
        </div>
        <div class="relative">
          <span aria-hidden="true" class="absolute top-3.5 left-4 text-[#6ea3ff]">🔑</span>
          <input
            type="password"
            placeholder="รหัสผ่านของบัญชี"
            class="w-full rounded-xl border border-[#2f6bff]/35 bg-[#071138]/95 py-3 pr-4 pl-12 text-[#d7e3ff] transition-all outline-none placeholder:text-[#9db0dd]/70 focus:border-[#f5c542] focus:ring-1 focus:ring-[#f5c542]/50"
          />
        </div>

        <div class="flex items-center justify-between px-1 text-xs">
          <label class="flex items-center gap-2 text-[#9db0dd]">
            <input type="checkbox" class="h-3.5 w-3.5 rounded border-[#2f6bff]/40 bg-[#071138] accent-[#f5c542]" />
            จดจำฉันไว้
          </label>
          <a href="/login" class="text-[#9db0dd] transition-colors hover:text-[#ffe08a]">ลืมรหัสผ่าน?</a>
        </div>

        <button
          class="mt-1 w-full rounded-xl border border-[#f5c542]/40 bg-gradient-to-r from-[#ffe08a] via-[#f5c542] to-[#c08b1f] p-3.5 font-black text-[#04102e] shadow-[0_10px_30px_rgba(245,197,66,0.28)] transition-all hover:scale-[1.02] hover:shadow-[0_15px_40px_rgba(245,197,66,0.4)]">
          เข้าสู่ระบบ
        </button>

        <div class="flex items-center gap-3 py-1 text-[11px] text-[#9db0dd]/80">
          <span class="h-px flex-1 bg-[#2f6bff]/35"></span>
          หรือ
          <span class="h-px flex-1 bg-[#2f6bff]/35"></span>
        </div>

        <a
          href="/line"
          class="flex w-full items-center justify-center gap-2 rounded-xl bg-gradient-to-r from-[#00B900] to-[#009900] p-3 text-sm font-bold text-white shadow-md transition-all hover:scale-[1.02]">
          <span aria-hidden="true">💬</span> ติดต่อแอดมิน LINE
        </a>

        <div class="mt-1 flex items-center justify-between px-1">
          <div class="flex gap-2">
            <span class="rounded-full border border-[#2f6bff]/30 bg-[#071138] px-2.5 py-1 text-[10px] font-bold text-[#6ea3ff]"><span aria-hidden="true">🔒</span> HTTPS + SSL</span>
            <span class="rounded-full border border-[#f5c542]/50 bg-[#071138]/80 px-2.5 py-1 text-[10px] font-bold text-[#ffe08a]"><span aria-hidden="true">🕐</span> ระบบออโต้ 24 ชั่วโมง</span>
          </div>
          <a href="/register" class="text-xs font-bold text-[#6ea3ff] transition-colors hover:text-[#ffe08a]">สมัครสมาชิกใหม่</a>
        </div>
      </div>
    </div>
  </div>

  <div slot="right" class="h-full">
    <div class="flex h-full flex-col rounded-2xl border border-[#2f6bff]/30 bg-[#0a1547]/92 p-5 shadow-[0_10px_30px_rgba(47,107,255,0.18)] backdrop-blur-md">
      <div class="mb-5 flex items-center justify-between gap-3">
        <div>
          <span class="text-xs font-bold tracking-wide text-[#9db0dd]">ตารางอ้างอิงหมวดเกมและระบบที่ใช้ได้จากบัญชีเดียว</span>
          <div class="bg-gradient-to-r from-[#ffe08a] via-[#f5c542] to-[#6ea3ff] bg-clip-text text-3xl font-black text-transparent sm:text-4xl">ฝากถอนไม่มีขั้นต่ำ • ระบบออโต้ 24 ชม.</div>
        </div>
        <span class="flex items-center gap-1.5 self-start rounded-full border border-green-500/40 bg-green-900/40 px-2.5 py-1">
          <span class="h-1.5 w-1.5 animate-pulse rounded-full bg-green-500 shadow-[0_0_8px_rgba(34,197,94,0.7)]"></span>
          <span class="text-[10px] font-bold tracking-widest text-green-300 uppercase">Live</span>
        </span>
      </div>

      <div class="mb-2 flex items-center justify-between text-[11px] font-bold tracking-widest text-[#9db0dd]/80 uppercase">
        <span>หมวดเกม / บริการในระบบ</span>
        <span>จุดที่ต้องดู</span>
      </div>

      <div class="flex flex-1 flex-col gap-2.5">
        {
          menus.map((m) => (
            <div class="rounded-xl border border-[#2f6bff]/25 bg-[#071138]/95 px-3.5 py-2.5 transition-colors hover:border-[#f5c542]/50 hover:bg-[#122264]">
              <div class="flex items-center justify-between gap-2 text-sm">
                <span class="flex min-w-0 items-center gap-2 font-bold text-[#d7e3ff]">
                  <span aria-hidden="true" class="w-5 shrink-0 text-center">
                    {m.icon}
                  </span>{" "}
                  <span class="truncate">{m.name}</span>
                </span>
                <span class="shrink-0 rounded-full border border-[#f5c542]/30 bg-[#040b2e] px-2.5 py-0.5 text-[10px] font-bold text-[#ffe08a]">{m.tag}</span>
              </div>
              <div class="mt-1.5 text-[11px] tracking-wide text-[#9db0dd]">{m.detail}</div>
            </div>
          ))
        }
      </div>

      <div class="mt-4 flex flex-wrap items-center justify-center gap-2">
        {chips.map((c) => <span class="rounded-full border border-[#2f6bff]/30 bg-[#071138] px-3 py-1 text-[10px] font-bold text-[#6ea3ff]">{c}</span>)}
      </div>

      <div class="mt-3 text-center text-[10px] tracking-wide text-[#9db0dd]/80">
        ข้อมูลในตารางใช้เพื่ออ้างอิงเท่านั้น ควรตรวจกติกา อัตราการจ่าย เงื่อนไขของแต่ละเกม และช่องทางฝากถอนที่รองรับจากหน้าเว็บไซต์จริงก่อนเริ่มใช้งานทุกครั้ง
      </div>
    </div>
  </div>
</ContentBoxTwo>
