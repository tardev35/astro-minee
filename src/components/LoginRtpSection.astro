---
import ContentBoxTwo from "./ContentBoxTwo.astro";

// Reference table, not article content — every label below renders as <p>/<span>
// inside ContentBoxTwo (whose `as` prop stays at its "p" default), and the
// section's aria-label carries the accessible name. It closes the page after the
// FAQ and collects, in one place, the things the RENGER8888 brief says to check:
// the game's own rules, อัตราจ่าย and วงเงินขั้นต่ำ before choosing; the terms of
// a promotion before claiming it; the account name and amount before confirming
// a transfer; and the transaction's real status in the history page afterwards.
//
// The อัตราจ่าย column is written as "ตามที่เกมระบุ" and never as a hard figure.
// Rules and pay tables are set per game and per provider, so a single number
// printed here would be a claim the site cannot stand behind — and the brief
// itself says to read what each game states.
const tableFactors = [
  { icon: "🗂️", name: "หมวดของเกมที่รองรับ", meta: "บาคาร่า สล็อต หรือคาสิโนสด ตามที่ระบบรองรับ", note: "เลือกหมวดก่อนแล้วค่อยเทียบรายเกม", tag: "เริ่มจากหมวด" },
  { icon: "📄", name: "กติกาของแต่ละเกม", meta: "แต่ละเกมกำหนดกติกาไว้ไม่เหมือนกัน", note: "อ่านให้ครบก่อนเริ่มใช้งานทุกครั้ง", tag: "อ่านก่อนเริ่ม" },
  { icon: "🎯", name: "อัตราจ่ายที่เกมระบุ", meta: "ระบุอยู่ในหน้าเกมของแต่ละประเภท", note: "ใช้เทียบระหว่างเกมในหมวดเดียวกัน", tag: "ดูจากในเกม" },
  { icon: "🪙", name: "วงเงินขั้นต่ำต่อรอบ", meta: "แต่ละเกมตั้งวงเงินขั้นต่ำไว้ต่างกัน", note: "เลือกให้สอดคล้องกับงบของตนเอง", tag: "เลือกตามงบ" },
  { icon: "🏷️", name: "เงื่อนไขของโปรโมชั่น", meta: "ยอดฝากขั้นต่ำ เกมที่ร่วมรายการ และระยะเวลา", note: "ดูข้อกำหนดการถอนควบคู่กับจำนวนโบนัส", tag: "ดูก่อนรับสิทธิ์" },
  { icon: "🎫", name: "สิทธิ์ที่รับไว้ในบัญชี", meta: "ชื่อโปรโมชั่นและจำนวนเครดิตแสดงในหน้าบัญชี", note: "เก็บรายละเอียดไว้จนใช้งานหรือถอนเสร็จ", tag: "เก็บไว้จนจบ" },
  { icon: "🧾", name: "ข้อมูลก่อนยืนยันฝากถอน", meta: "ชื่อบัญชี จำนวนเงิน และข้อมูลรับเงิน", note: "ตรวจให้ถูกต้องก่อนกดยืนยันทุกครั้ง", tag: "ตรวจก่อนยืนยัน" },
  { icon: "⏳", name: "สถานะรายการในระบบออโต้", meta: "รายการที่ยังดำเนินการอยู่จะแสดงสถานะไว้", note: "รอการอัปเดตก่อนส่งรายการใหม่", tag: "รอผลจากระบบ" },
];

const chips = ["คาสิโนออนไลน์", "เว็บหลัก", "บาคาร่า", "สล็อต", "คาสิโนสด", "อัตราจ่าย", "วงเงินขั้นต่ำ", "โปรโมชั่น", "ระบบออโต้", "ประวัติธุรกรรม"];
---

<ContentBoxTwo
  titleleft="เข้าสู่ระบบ RENGER8888"
  titleright="ข้อมูลที่ควรตรวจก่อนเริ่มใช้งาน"
  iconleft="🔐"
  iconright="🎲"
  label="เข้าสู่ระบบ RENGER8888 และตารางอ้างอิงข้อมูลที่ควรตรวจก่อนเริ่มใช้งาน ทั้งหมวดของเกม กติกา อัตราจ่าย วงเงินขั้นต่ำ เงื่อนไขของโปรโมชั่น ข้อมูลก่อนยืนยันฝากถอน และสถานะรายการในระบบออโต้">
  <div slot="left" class="flex h-full flex-col gap-4">
    <div class="relative overflow-hidden rounded-2xl border border-[#e8121f]/35 bg-[#160406]/92 p-6 shadow-[0_10px_30px_rgba(232,18,31,0.22)] backdrop-blur-md">
      <div aria-hidden="true" class="pointer-events-none absolute -top-10 -right-10 h-32 w-32 rounded-full bg-[#8f0c14]/55 blur-[50px]"></div>

      <div class="relative z-10 mb-5 flex items-center gap-3">
        <span
          aria-hidden="true"
          class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl border border-[#ff2b38]/50 bg-gradient-to-br from-[#e8121f] to-[#8f0c14] text-xl text-[#f7e8e8] shadow-inner">
          🛡️
        </span>
        <div class="flex flex-col">
          <p class="text-base font-black text-[#ff2b38]">ยินดีต้อนรับกลับ</p>
          <span class="text-[11px] text-[#c5a0a2]">บัญชีเดียวใช้เลือกเกมตามหมวดที่ระบบรองรับ ดูกติกาและอัตราจ่ายที่เกมระบุ ตรวจสิทธิ์โปรโมชั่น และติดตามสถานะรายการของ RENGER8888 ได้จากจุดเดียว</span>
        </div>
      </div>

      <div class="relative z-10 flex flex-col gap-3.5">
        <div class="relative">
          <span aria-hidden="true" class="absolute top-3.5 left-4 text-[#ff2b38]">👤</span>
          <input
            type="text"
            aria-label="เบอร์โทรศัพท์หรือยูสเซอร์เนม"
            placeholder="เบอร์โทรศัพท์ / ยูสเซอร์เนม"
            class="w-full rounded-xl border border-[#e8121f]/45 bg-[#080203]/95 py-3 pr-4 pl-12 text-[#f0dcdc] transition-all outline-none placeholder:text-[#c5a0a2] focus:border-[#ff2b38] focus:ring-1 focus:ring-[#ff2b38]/50"
          />
        </div>
        <div class="relative">
          <span aria-hidden="true" class="absolute top-3.5 left-4 text-[#ff2b38]">🔑</span>
          <input
            type="password"
            aria-label="รหัสผ่านของบัญชี"
            placeholder="รหัสผ่านของบัญชี"
            class="w-full rounded-xl border border-[#e8121f]/45 bg-[#080203]/95 py-3 pr-4 pl-12 text-[#f0dcdc] transition-all outline-none placeholder:text-[#c5a0a2] focus:border-[#ff2b38] focus:ring-1 focus:ring-[#ff2b38]/50"
          />
        </div>

        <div class="flex items-center justify-between px-1 text-xs">
          <label class="flex items-center gap-2 text-[#c5a0a2]">
            <input type="checkbox" class="h-3.5 w-3.5 rounded border-[#e8121f]/45 bg-[#080203] accent-[#e8121f]" />
            จดจำฉันไว้
          </label>
          <a href="/login" class="text-[#c5a0a2] transition-colors hover:text-[#ff2b38]">ลืมรหัสผ่าน?</a>
        </div>

        <a
          href="/login"
          class="mt-1 block w-full rounded-xl border border-[#ff2b38]/50 bg-gradient-to-r from-[#e8121f] to-[#8f0c14] p-3.5 text-center font-black text-[#f7e8e8] shadow-[0_10px_30px_rgba(232,18,31,0.35)] transition-all hover:scale-[1.02] hover:shadow-[0_15px_40px_rgba(232,18,31,0.5)]">
          เข้าสู่ระบบ
        </a>

        <div class="flex items-center gap-3 py-1 text-[11px] text-[#c5a0a2]">
          <span aria-hidden="true" class="h-px flex-1 bg-[#e8121f]/40"></span>
          หรือ
          <span aria-hidden="true" class="h-px flex-1 bg-[#e8121f]/40"></span>
        </div>

        <a
          href="/line"
          class="flex w-full items-center justify-center gap-2 rounded-xl bg-gradient-to-r from-[#00B900] to-[#009900] p-3 text-sm font-bold text-white shadow-md transition-all hover:scale-[1.02]">
          <span aria-hidden="true">💬</span> ทักไลน์ทีมงานคนไทย
        </a>

        <div class="mt-1 flex items-center justify-between px-1">
          <div class="flex gap-2">
            <span class="rounded-full border border-[#e8121f]/40 bg-[#080203] px-2.5 py-1 text-[10px] font-bold text-[#ff2b38]"><span aria-hidden="true">🔒</span> HTTPS + SSL</span>
            <span class="rounded-full border border-[#f7e8e8]/45 bg-[#080203]/80 px-2.5 py-1 text-[10px] font-bold text-[#f7e8e8]"><span aria-hidden="true">🕐</span> ดูแลสมาชิก 24 ชั่วโมง</span>
          </div>
          <a href="/register" class="text-xs font-bold text-[#ff2b38] transition-colors hover:text-[#f7e8e8]">สมัครสมาชิกใหม่</a>
        </div>
      </div>
    </div>
  </div>

  <div slot="right" class="h-full">
    <div class="flex h-full flex-col rounded-2xl border border-[#e8121f]/35 bg-[#160406]/92 p-5 shadow-[0_10px_30px_rgba(232,18,31,0.22)] backdrop-blur-md">
      <div class="mb-5 flex items-center justify-between gap-3">
        <div>
          <span class="text-xs font-bold tracking-wide text-[#c5a0a2]">ตารางอ้างอิงสิ่งที่ควรเปิดดูก่อนเลือกเกม และสิ่งที่ควรตรวจก่อนยืนยันรายการ</span>
          <p class="bg-gradient-to-r from-[#e6ecf2] via-[#e8121f] to-[#8f0c14] bg-clip-text text-3xl font-black text-transparent sm:text-4xl">ดูกติกา อัตราจ่าย และวงเงินขั้นต่ำก่อนเลือกเกม</p>
        </div>
        <span class="flex items-center gap-1.5 self-start rounded-full border border-green-500/40 bg-green-900/40 px-2.5 py-1">
          <span aria-hidden="true" class="h-1.5 w-1.5 animate-pulse rounded-full bg-green-500 shadow-[0_0_8px_rgba(34,197,94,0.7)]"></span>
          <span class="text-[10px] font-bold tracking-widest text-green-300 uppercase">Live</span>
        </span>
      </div>

      <div class="mb-2 flex items-center justify-between text-[11px] font-bold tracking-widest text-[#c5a0a2] uppercase">
        <span>สิ่งที่ควรดู / ช่องทาง</span>
        <span>รายละเอียด / เงื่อนไข</span>
      </div>

      <div class="flex flex-1 flex-col gap-2.5">
        {
          tableFactors.map((b) => (
            <div class="rounded-xl border border-[#e8121f]/30 bg-[#080203]/95 px-3.5 py-2.5 transition-colors hover:border-[#ff2b38]/60 hover:bg-[#28080b]">
              <div class="flex items-center justify-between gap-2 text-sm">
                <span class="flex min-w-0 items-center gap-2 font-bold text-[#f0dcdc]">
                  <span aria-hidden="true" class="w-5 shrink-0 text-center">
                    {b.icon}
                  </span>{" "}
                  <span class="truncate">{b.name}</span>
                </span>
                <span class="shrink-0 rounded-full border border-[#ff2b38]/50 bg-[#080203] px-2.5 py-0.5 text-[10px] font-bold text-[#ff2b38]">{b.tag}</span>
              </div>
              <div class="mt-1.5 flex flex-wrap items-center gap-x-3 gap-y-1 text-[11px] tracking-wide text-[#c5a0a2]">
                <span>{b.meta}</span>
                <span class="font-bold text-[#ff2b38]">{b.note}</span>
              </div>
            </div>
          ))
        }
      </div>

      <div class="mt-4 flex flex-wrap items-center justify-center gap-2">
        {chips.map((c) => <span class="rounded-full border border-[#e8121f]/35 bg-[#080203] px-3 py-1 text-[10px] font-bold text-[#ff2b38]">{c}</span>)}
      </div>

      <div class="mt-3 text-center text-[10px] tracking-wide text-[#c5a0a2]">
        รายการในตารางเป็นหัวข้อที่ควรเปิดดูเท่านั้น กติกา อัตราจ่าย วงเงินขั้นต่ำ และเงื่อนไขของโปรโมชั่นถูกกำหนดโดยเว็บไซต์และผู้ให้บริการเกม จึงต่างกันในแต่ละเกมและแต่ละช่วงเวลา
        ควรอ่านข้อมูลที่ระบบแสดงจริงก่อนเริ่มทุกครั้ง และกำหนดวงเงินกับเวลาเล่นไว้ล่วงหน้าเสมอ
      </div>
    </div>
  </div>
</ContentBoxTwo>
