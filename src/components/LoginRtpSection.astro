---
import ContentBoxTwo from "./ContentBoxTwo.astro";

// Reference table, not article content — every label below renders as <p>/<span>
// inside ContentBoxTwo (whose `as` prop stays at its "p" default), and the
// section's aria-label carries the accessible name. It closes the page after the
// FAQ and collects, in one place, the things the PRODED888 brief says to check:
// the category and the rules of the game before choosing; RTP, ตารางจ่าย and
// ความผันผวน instead of the phrase "แตกง่าย"; a promotion's real conditions
// before claiming it; and ยอดคงเหลือ, ประวัติธุรกรรม and สถานะรายการ from the
// account page afterwards.
//
// The อัตราจ่าย column is written as "ตามที่เกมระบุ" and never as a hard figure.
// Rules and pay tables are set per game and per provider, so a single number
// printed here would be a claim the site cannot stand behind — and the brief
// itself says to read what each game states.
const tableFactors = [
  { icon: "🗂️", name: "หมวดของเกมที่รองรับ", meta: "สล็อต บาคาร่า คาสิโน หรือประเภทอื่นตามที่เว็บไซต์กำหนด", note: "เริ่มจากเกมที่เข้าใจกติกาก่อน", tag: "เริ่มจากหมวด" },
  { icon: "📄", name: "กติกาของแต่ละเกม", meta: "แต่ละเกมกำหนดกติกาและรูปแบบการจ่ายไว้ต่างกัน", note: "อ่านให้ครบก่อนเริ่มใช้งานทุกครั้ง", tag: "อ่านก่อนเริ่ม" },
  { icon: "🎯", name: "อัตราจ่ายที่เกมระบุ", meta: "ระบุอยู่ในหน้าเกมของแต่ละประเภท", note: "ใช้เทียบระหว่างเกมในหมวดเดียวกัน", tag: "ดูจากในเกม" },
  { icon: "📊", name: "RTP ตารางจ่าย และความผันผวน", meta: "เกมสล็อตแสดงข้อมูลเหล่านี้ไว้ในหน้าเกม", note: "ใช้ประกอบแทนการเชื่อคำว่าแตกง่าย", tag: "ดูข้อมูลจริง" },
  { icon: "🪙", name: "วงเงินต่อรอบของเกม", meta: "แต่ละเกมตั้งวงเงินขั้นต่ำไว้ไม่เท่ากัน", note: "เลือกให้สอดคล้องกับงบที่ตั้งไว้", tag: "เลือกตามงบ" },
  { icon: "🏷️", name: "เงื่อนไขของโปรโมชั่น", meta: "ยอดขั้นต่ำ เกมที่ร่วมรายการ และระยะเวลา", note: "ดูข้อกำหนดการถอนควบคู่กับจำนวนโบนัส", tag: "เทียบก่อนรับ" },
  { icon: "🧾", name: "ยอดคงเหลือและประวัติธุรกรรม", meta: "ตรวจจากหน้าบัญชีเป็นหลักทุกครั้ง", note: "เก็บเวลา จำนวนเงิน และเลขอ้างอิงไว้", tag: "ตรวจจากบัญชี" },
  { icon: "⏳", name: "สถานะรายการที่ดำเนินการอยู่", meta: "รายการถอนที่ยังไม่เสร็จจะแสดงสถานะไว้", note: "รอระบบอัปเดตผลก่อนส่งรายการใหม่", tag: "รอผลจากระบบ" },
];

const chips = ["พนันออนไลน์", "เกมฮิต", "สล็อต", "บาคาร่า", "คาสิโน", "RTP", "อัตราจ่าย", "โปรโมชั่น", "ประวัติธุรกรรม", "วางงบก่อนเริ่ม"];
---

<ContentBoxTwo
  titleleft="เข้าสู่ระบบ PRODED888"
  titleright="ข้อมูลที่ควรตรวจก่อนเริ่มใช้งาน"
  iconleft="🔐"
  iconright="🎲"
  label="เข้าสู่ระบบ PRODED888 และตารางอ้างอิงข้อมูลที่ควรตรวจก่อนเริ่มใช้งาน ทั้งหมวดของเกม กติกา อัตราจ่าย RTP วงเงินต่อรอบ เงื่อนไขของโปรโมชั่น ยอดคงเหลือ ประวัติธุรกรรม และสถานะรายการที่ดำเนินการอยู่">
  <div slot="left" class="flex h-full flex-col gap-4">
    <div class="relative overflow-hidden rounded-2xl border border-[#e3b53f]/35 bg-[#0d1338]/92 p-6 shadow-[0_10px_30px_rgba(227,181,63,0.22)] backdrop-blur-md">
      <div aria-hidden="true" class="pointer-events-none absolute -top-10 -right-10 h-32 w-32 rounded-full bg-[#2a3a8f]/70 blur-[50px]"></div>

      <div class="relative z-10 mb-5 flex items-center gap-3">
        <span
          aria-hidden="true"
          class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl border border-[#f8de91]/50 bg-gradient-to-br from-[#f8de91] to-[#8f6614] text-xl text-[#070b20] shadow-inner">
          🛡️
        </span>
        <div class="flex flex-col">
          <p class="text-base font-black text-[#f8de91]">ยินดีต้อนรับกลับ</p>
          <span class="text-[11px] text-[#dbe3f5]">บัญชีเดียวใช้เลือกเกมตามหมวดที่เว็บไซต์กำหนด ดูกติกาและอัตราจ่ายที่เกมระบุ เทียบเงื่อนไขโปรโมชั่น และติดตามยอดคงเหลือกับสถานะรายการของ PRODED888 ได้จากจุดเดียว</span>
        </div>
      </div>

      <div class="relative z-10 flex flex-col gap-3.5">
        <div class="relative">
          <span aria-hidden="true" class="absolute top-3.5 left-4 text-[#f8de91]">👤</span>
          <input
            type="text"
            aria-label="เบอร์โทรศัพท์หรือยูสเซอร์เนม"
            placeholder="เบอร์โทรศัพท์ / ยูสเซอร์เนม"
            class="w-full rounded-xl border border-[#e3b53f]/45 bg-[#070b20]/95 py-3 pr-4 pl-12 text-[#ece0c2] transition-all outline-none placeholder:text-[#dbe3f5]/70 focus:border-[#f8de91] focus:ring-1 focus:ring-[#f8de91]/50"
          />
        </div>
        <div class="relative">
          <span aria-hidden="true" class="absolute top-3.5 left-4 text-[#f8de91]">🔑</span>
          <input
            type="password"
            aria-label="รหัสผ่านของบัญชี"
            placeholder="รหัสผ่านของบัญชี"
            class="w-full rounded-xl border border-[#e3b53f]/45 bg-[#070b20]/95 py-3 pr-4 pl-12 text-[#ece0c2] transition-all outline-none placeholder:text-[#dbe3f5]/70 focus:border-[#f8de91] focus:ring-1 focus:ring-[#f8de91]/50"
          />
        </div>

        <div class="flex items-center justify-between px-1 text-xs">
          <label class="flex items-center gap-2 text-[#dbe3f5]">
            <input type="checkbox" class="h-3.5 w-3.5 rounded border-[#e3b53f]/45 bg-[#070b20] accent-[#e3b53f]" />
            จดจำฉันไว้
          </label>
          <a href="/login" class="text-[#dbe3f5] transition-colors hover:text-[#f8de91]">ลืมรหัสผ่าน?</a>
        </div>

        <a
          href="/login"
          class="mt-1 block w-full rounded-xl border border-[#f8de91]/50 bg-gradient-to-r from-[#f8de91] to-[#8f6614] p-3.5 text-center font-black text-[#070b20] shadow-[0_10px_30px_rgba(227,181,63,0.35)] transition-all hover:scale-[1.02] hover:shadow-[0_15px_40px_rgba(227,181,63,0.5)]">
          เข้าสู่ระบบ
        </a>

        <div class="flex items-center gap-3 py-1 text-[11px] text-[#dbe3f5]">
          <span aria-hidden="true" class="h-px flex-1 bg-[#e3b53f]/40"></span>
          หรือ
          <span aria-hidden="true" class="h-px flex-1 bg-[#e3b53f]/40"></span>
        </div>

        <a
          href="/line"
          class="flex w-full items-center justify-center gap-2 rounded-xl bg-gradient-to-r from-[#00B900] to-[#009900] p-3 text-sm font-bold text-white shadow-md transition-all hover:scale-[1.02]">
          <span aria-hidden="true">💬</span> ทักไลน์ทีมงานคนไทย
        </a>

        <div class="mt-1 flex items-center justify-between px-1">
          <div class="flex gap-2">
            <span class="rounded-full border border-[#e3b53f]/40 bg-[#070b20] px-2.5 py-1 text-[10px] font-bold text-[#f8de91]"><span aria-hidden="true">🔒</span> HTTPS + SSL</span>
            <span class="rounded-full border border-[#dbe3f5]/45 bg-[#070b20]/80 px-2.5 py-1 text-[10px] font-bold text-[#dbe3f5]"><span aria-hidden="true">🕐</span> ดูแลสมาชิก 24 ชั่วโมง</span>
          </div>
          <a href="/register" class="text-xs font-bold text-[#f8de91] transition-colors hover:text-[#faf3de]">สมัครสมาชิกใหม่</a>
        </div>
      </div>
    </div>
  </div>

  <div slot="right" class="h-full">
    <div class="flex h-full flex-col rounded-2xl border border-[#e3b53f]/35 bg-[#0d1338]/92 p-5 shadow-[0_10px_30px_rgba(227,181,63,0.22)] backdrop-blur-md">
      <div class="mb-5 flex items-center justify-between gap-3">
        <div>
          <span class="text-xs font-bold tracking-wide text-[#dbe3f5]">ตารางอ้างอิงสิ่งที่ควรเปิดดูก่อนเลือกเกม และสิ่งที่ควรตรวจจากหน้าบัญชี</span>
          <p class="bg-gradient-to-r from-[#dbe3f5] via-[#f8de91] to-[#e3b53f] bg-clip-text text-3xl font-black text-transparent sm:text-4xl">ดูกติกา อัตราจ่าย และเงื่อนไขก่อนเลือกเกม</p>
        </div>
        <span class="flex items-center gap-1.5 self-start rounded-full border border-green-500/40 bg-green-900/40 px-2.5 py-1">
          <span aria-hidden="true" class="h-1.5 w-1.5 animate-pulse rounded-full bg-green-500 shadow-[0_0_8px_rgba(34,197,94,0.7)]"></span>
          <span class="text-[10px] font-bold tracking-widest text-green-300 uppercase">Live</span>
        </span>
      </div>

      <div class="mb-2 flex items-center justify-between text-[11px] font-bold tracking-widest text-[#dbe3f5] uppercase">
        <span>สิ่งที่ควรดู / ช่องทาง</span>
        <span>รายละเอียด / เงื่อนไข</span>
      </div>

      <div class="flex flex-1 flex-col gap-2.5">
        {
          tableFactors.map((b) => (
            <div class="rounded-xl border border-[#e3b53f]/30 bg-[#070b20]/95 px-3.5 py-2.5 transition-colors hover:border-[#f8de91]/60 hover:bg-[#18225c]">
              <div class="flex items-center justify-between gap-2 text-sm">
                <span class="flex min-w-0 items-center gap-2 font-bold text-[#ece0c2]">
                  <span aria-hidden="true" class="w-5 shrink-0 text-center">
                    {b.icon}
                  </span>{" "}
                  <span class="truncate">{b.name}</span>
                </span>
                <span class="shrink-0 rounded-full border border-[#f8de91]/50 bg-[#070b20] px-2.5 py-0.5 text-[10px] font-bold text-[#f8de91]">{b.tag}</span>
              </div>
              <div class="mt-1.5 flex flex-wrap items-center gap-x-3 gap-y-1 text-[11px] tracking-wide text-[#dbe3f5]">
                <span>{b.meta}</span>
                <span class="font-bold text-[#f8de91]">{b.note}</span>
              </div>
            </div>
          ))
        }
      </div>

      <div class="mt-4 flex flex-wrap items-center justify-center gap-2">
        {chips.map((c) => <span class="rounded-full border border-[#e3b53f]/35 bg-[#070b20] px-3 py-1 text-[10px] font-bold text-[#f8de91]">{c}</span>)}
      </div>

      <div class="mt-3 text-center text-[10px] tracking-wide text-[#dbe3f5]">
        รายการในตารางเป็นหัวข้อที่ควรเปิดดูเท่านั้น กติกา อัตราจ่าย RTP วงเงินต่อรอบ และเงื่อนไขของโปรโมชั่นถูกกำหนดโดยเว็บไซต์และผู้ให้บริการเกม จึงต่างกันในแต่ละเกมและแต่ละช่วงเวลา
        ควรอ่านข้อมูลที่ระบบแสดงจริงก่อนเริ่มทุกครั้ง และกำหนดวงเงินกับเวลาเล่นไว้ล่วงหน้าเสมอ
      </div>
    </div>
  </div>
</ContentBoxTwo>
