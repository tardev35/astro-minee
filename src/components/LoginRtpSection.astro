---
import ContentBoxTwo from "./ContentBoxTwo.astro";

// Reference table, not article content — every label below renders as <p>/<span>
// inside ContentBoxTwo (whose `as` prop stays at its "p" default), and the
// section's aria-label carries the accessible name. Copy follows the BMK289
// brief: เกมสล็อตหลายแนวคลาสสิก/โบนัส/ธีมใหม่, ระบบออโต้ลดขั้นตอนฝาก,
// ถอนเป็นขั้นตอนผ่านหน้าบัญชี, ยอดนิยมไม่ได้เหมาะกับทุกคน,
// ตรวจสอบสถานะธุรกรรมย้อนหลัง, กำหนดงบก่อนเริ่ม.
const menus = [
  { icon: "🎰", name: "เกมสล็อตหลายแนว", detail: "ทั้งแบบคลาสสิก เกมโบนัส และเกมธีมใหม่ เลือกได้จากกติกาและฟีเจอร์ของแต่ละเกม", tag: "เลือกตามสไตล์" },
  { icon: "⚡", name: "ระบบฝากแบบออโต้", detail: "ลดขั้นตอนการส่งข้อมูลซ้ำ ควรตรวจชื่อบัญชี จำนวนเงิน และช่องทางก่อนยืนยันทุกครั้ง", tag: "ตรวจก่อนยืนยัน" },
  { icon: "💳", name: "คำขอถอนและสถานะรายการ", detail: "ส่งคำขอถอนและติดตามสถานะได้จากหน้าบัญชี หากยังดำเนินการอยู่ควรรอผลก่อนส่งซ้ำ", tag: "รอผลก่อนส่งซ้ำ" },
  { icon: "📈", name: "ความผันผวนและรูปแบบโบนัส", detail: "เกมยอดนิยมไม่ได้เหมาะกับทุกคน ควรดูความผันผวนและจำนวนเงินต่อรอบก่อนเลือก", tag: "ไม่ใช่การรับประกัน" },
  { icon: "🧭", name: "ตรวจสอบรายการย้อนหลัง", detail: "หากพบรายการผิดปกติ ควรเก็บเวลา จำนวนเงิน และข้อมูลอ้างอิงไว้สำหรับการตรวจสอบ", tag: "เก็บข้อมูลอ้างอิง" },
  { icon: "📱", name: "รองรับมือถือและคอมพิวเตอร์", detail: "เปิดใช้งานผ่านมือถือ แท็บเล็ต และคอมพิวเตอร์ด้วยบัญชีเดียวกัน", tag: "ใช้ได้ทุกจอ" },
  { icon: "🛡️", name: "กำหนดงบก่อนเริ่มเล่น", detail: "ตั้งวงเงินไว้ล่วงหน้า และไม่เพิ่มเงินเพื่อไล่ตามผลที่เสียไปในแต่ละรอบ", tag: "เล่นอยู่ในกรอบ" },
];

const chips = ["เกมคลาสสิก", "เกมโบนัส", "เกมธีมใหม่", "ระบบออโต้", "เช็กความผันผวน", "ดูเงื่อนไขโปรโมชั่น", "ติดตามสถานะรายการ", "รองรับมือถือ"];
---

<ContentBoxTwo titleleft="เข้าสู่ระบบ BMK289" titleright="ช่องทางในระบบและสิ่งที่ควรตรวจก่อนทำรายการ" label="เข้าสู่ระบบ BMK289 และตารางอ้างอิงช่องทางในระบบที่ควรตรวจก่อนทำรายการ">
  <div slot="left" class="flex h-full flex-col gap-4">
    <div class="relative overflow-hidden rounded-2xl border border-[#2b8cff]/30 bg-[#08152f]/92 p-6 shadow-[0_10px_30px_rgba(43,140,255,0.2)] backdrop-blur-md">
      <div aria-hidden="true" class="pointer-events-none absolute -top-10 -right-10 h-32 w-32 rounded-full bg-[#0d2350]/60 blur-[50px]"></div>

      <div class="relative z-10 mb-5 flex items-center gap-3">
        <span
          aria-hidden="true"
          class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl border border-[#ffcc33]/40 bg-gradient-to-br from-[#ffe488] via-[#ffcc33] to-[#c9931a] text-xl text-[#05132e] shadow-inner">
          🎮
        </span>
        <div class="flex flex-col">
          <p class="text-base font-black text-[#9dcef0]">ยินดีต้อนรับกลับ</p>
          <span class="text-[11px] text-[#96abcb]">บัญชีเดียวใช้เลือกเกม ตรวจสอบโปรโมชั่น และติดตามสถานะรายการฝากถอนของ BMK289 ได้จากหน้าเดียว</span>
        </div>
      </div>

      <div class="relative z-10 flex flex-col gap-3.5">
        <div class="relative">
          <span aria-hidden="true" class="absolute top-3.5 left-4 text-[#9dcef0]">👤</span>
          <input
            type="text"
            aria-label="เบอร์โทรศัพท์หรือยูสเซอร์เนม"
            placeholder="เบอร์โทรศัพท์ / ยูสเซอร์เนม"
            class="w-full rounded-xl border border-[#2b8cff]/35 bg-[#02081c]/95 py-3 pr-4 pl-12 text-[#dbe9fb] transition-all outline-none placeholder:text-[#96abcb] focus:border-[#5eb0ff] focus:ring-1 focus:ring-[#5eb0ff]/50"
          />
        </div>
        <div class="relative">
          <span aria-hidden="true" class="absolute top-3.5 left-4 text-[#9dcef0]">🔑</span>
          <input
            type="password"
            aria-label="รหัสผ่านของบัญชี"
            placeholder="รหัสผ่านของบัญชี"
            class="w-full rounded-xl border border-[#2b8cff]/35 bg-[#02081c]/95 py-3 pr-4 pl-12 text-[#dbe9fb] transition-all outline-none placeholder:text-[#96abcb] focus:border-[#5eb0ff] focus:ring-1 focus:ring-[#5eb0ff]/50"
          />
        </div>

        <div class="flex items-center justify-between px-1 text-xs">
          <label class="flex items-center gap-2 text-[#96abcb]">
            <input type="checkbox" class="h-3.5 w-3.5 rounded border-[#2b8cff]/40 bg-[#02081c] accent-[#2b8cff]" />
            จดจำฉันไว้
          </label>
          <a href="/login" class="text-[#96abcb] transition-colors hover:text-[#9dcef0]">ลืมรหัสผ่าน?</a>
        </div>

        <a
          href="/login"
          class="mt-1 block w-full rounded-xl border border-[#ffcc33]/40 bg-gradient-to-r from-[#ffe488] via-[#ffcc33] to-[#c9931a] p-3.5 text-center font-black text-[#05132e] shadow-[0_10px_30px_rgba(255,204,51,0.28)] transition-all hover:scale-[1.02] hover:shadow-[0_15px_40px_rgba(255,204,51,0.4)]">
          เข้าสู่ระบบ
        </a>

        <div class="flex items-center gap-3 py-1 text-[11px] text-[#96abcb]">
          <span class="h-px flex-1 bg-[#2b8cff]/35"></span>
          หรือ
          <span class="h-px flex-1 bg-[#2b8cff]/35"></span>
        </div>

        <a
          href="/line"
          class="flex w-full items-center justify-center gap-2 rounded-xl bg-gradient-to-r from-[#00B900] to-[#009900] p-3 text-sm font-bold text-white shadow-md transition-all hover:scale-[1.02]">
          <span aria-hidden="true">💬</span> ทักไลน์ทีมงานคนไทย
        </a>

        <div class="mt-1 flex items-center justify-between px-1">
          <div class="flex gap-2">
            <span class="rounded-full border border-[#2b8cff]/30 bg-[#02081c] px-2.5 py-1 text-[10px] font-bold text-[#9dcef0]"><span aria-hidden="true">🔒</span> HTTPS + SSL</span>
            <span class="rounded-full border border-[#0d2350] bg-[#02081c]/80 px-2.5 py-1 text-[10px] font-bold text-[#dbe9fb]"><span aria-hidden="true">🕐</span> ดูแลสมาชิก 24 ชั่วโมง</span>
          </div>
          <a href="/register" class="text-xs font-bold text-[#ffcc33] transition-colors hover:text-[#ffe488]">สมัครสมาชิกใหม่</a>
        </div>
      </div>
    </div>
  </div>

  <div slot="right" class="h-full">
    <div class="flex h-full flex-col rounded-2xl border border-[#2b8cff]/30 bg-[#08152f]/92 p-5 shadow-[0_10px_30px_rgba(43,140,255,0.2)] backdrop-blur-md">
      <div class="mb-5 flex items-center justify-between gap-3">
        <div>
          <span class="text-xs font-bold tracking-wide text-[#96abcb]">ตารางอ้างอิงช่องทางในระบบและสิ่งที่ควรตรวจก่อนทำรายการ</span>
          <div class="bg-gradient-to-r from-[#ffe488] via-[#ffcc33] to-[#9dcef0] bg-clip-text text-3xl font-black text-transparent sm:text-4xl">ระบบออโต้ ฝากง่าย ถอนไว</div>
        </div>
        <span class="flex items-center gap-1.5 self-start rounded-full border border-green-500/40 bg-green-900/40 px-2.5 py-1">
          <span class="h-1.5 w-1.5 animate-pulse rounded-full bg-green-500 shadow-[0_0_8px_rgba(34,197,94,0.7)]"></span>
          <span class="text-[10px] font-bold tracking-widest text-green-300 uppercase">Live</span>
        </span>
      </div>

      <div class="mb-2 flex items-center justify-between text-[11px] font-bold tracking-widest text-[#96abcb] uppercase">
        <span>ช่องทาง / บริการในระบบ</span>
        <span>จุดที่ต้องดู</span>
      </div>

      <div class="flex flex-1 flex-col gap-2.5">
        {
          menus.map((m) => (
            <div class="rounded-xl border border-[#2b8cff]/25 bg-[#02081c]/95 px-3.5 py-2.5 transition-colors hover:border-[#5eb0ff]/60 hover:bg-[#123061]">
              <div class="flex items-center justify-between gap-2 text-sm">
                <span class="flex min-w-0 items-center gap-2 font-bold text-[#dbe9fb]">
                  <span aria-hidden="true" class="w-5 shrink-0 text-center">
                    {m.icon}
                  </span>{" "}
                  <span class="truncate">{m.name}</span>
                </span>
                <span class="shrink-0 rounded-full border border-[#ffcc33]/45 bg-[#02081c] px-2.5 py-0.5 text-[10px] font-bold text-[#ffcc33]">{m.tag}</span>
              </div>
              <div class="mt-1.5 text-[11px] tracking-wide text-[#96abcb]">{m.detail}</div>
            </div>
          ))
        }
      </div>

      <div class="mt-4 flex flex-wrap items-center justify-center gap-2">
        {chips.map((c) => <span class="rounded-full border border-[#2b8cff]/30 bg-[#02081c] px-3 py-1 text-[10px] font-bold text-[#9dcef0]">{c}</span>)}
      </div>

      <div class="mt-3 text-center text-[10px] tracking-wide text-[#96abcb]">
        ข้อมูลในตารางใช้เพื่ออ้างอิงเท่านั้น ควรตรวจสอบกติกาของเกม เงื่อนไขโปรโมชั่น และรายละเอียดช่องทางฝากถอนจากหน้าเว็บไซต์จริงก่อนทำรายการทุกครั้ง
        เพราะระยะเวลาดำเนินการอาจแตกต่างตามช่องทางและสถานะรายการ และคำว่าจ่ายจริงไม่ได้หมายถึงการรับประกันทุกกรณี
      </div>
    </div>
  </div>
</ContentBoxTwo>
