---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  titleleft?: string;
  titlecenter?: string;
  titleright?: string;
}
const { title, as: HeadingTag = "h2", titleleft, titlecenter, titleright } = Astro.props;

// The section heading arrives on `title` and is the only heading a docx section
// normally needs here. The three column titles are prop-driven <h2>, so a brief
// that is flat H1 + H2 simply leaves them unset and the three columns carry the
// section's paragraph split across them.
//
// PATTAYA168: pale-seafoam column markers and cyan rules on an ocean-ink card,
// with the cyan wash behind the header. The small bar at the top of each column
// is decorative and always renders, so three untitled columns still read as
// three parts of one section.
//
// `isolate` on the card + `-z-10` on the wash is what lets the slot content
// paint above the decoration without a wrapper <div>. Keep both.
---

<section class="mx-auto mb-8 w-full max-w-7xl px-4 font-sans">
  <div
    class="group relative isolate w-full overflow-hidden rounded-3xl border border-[#0c8ba4]/55 bg-[#04222b]/90 p-8 text-[#cfeef7] shadow-[0_10px_30px_rgba(2,28,34,0.7)] backdrop-blur-xl transition-all duration-500 hover:border-[#02c4e3]/65 hover:shadow-[0_15px_40px_rgba(2,196,227,0.3)] md:p-10">
    <div aria-hidden="true" class="pointer-events-none absolute -top-24 left-1/2 -z-10 h-48 w-72 -translate-x-1/2 rounded-full bg-[#02c4e3]/22 blur-[70px]"></div>

    {
      title && (
        <header class="mb-8 flex items-center gap-4 border-b border-[#02c4e3]/30 pb-4">
          <span aria-hidden="true" class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#8ff5ff] via-[#02c4e3] to-[#0c8ba4] shadow-[0_0_10px_rgba(2,196,227,0.5)]" />
          <HeadingTag class="bg-gradient-to-r from-[#8ff5ff] via-[#02c4e3] to-[#fdac13] bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase">{title}</HeadingTag>
        </header>
      )
    }

    <div class="grid grid-cols-1 gap-8 md:grid-cols-3">
      <article class="flex flex-col gap-3 border-b border-[#0c8ba4]/50 pb-8 text-left text-base leading-relaxed text-[#cfeef7] md:border-r md:border-b-0 md:pr-8 md:pb-0">
        <span aria-hidden="true" class="h-[3px] w-12 shrink-0 rounded-full bg-gradient-to-r from-[#8ff5ff] to-transparent"></span>
        {
          titleleft && (
            <h2 class="flex items-center gap-2 text-lg leading-normal font-black tracking-widest text-[#8ff5ff] uppercase">
              <span aria-hidden="true" class="h-1.5 w-1.5 shrink-0 rounded-full bg-[#02c4e3] shadow-[0_0_8px_rgba(2,196,227,0.9)]" />
              {titleleft}
            </h2>
          )
        }
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-3 border-b border-[#0c8ba4]/50 pb-8 text-left text-base leading-relaxed text-[#cfeef7] md:border-r md:border-b-0 md:px-4 md:pb-0">
        <span aria-hidden="true" class="h-[3px] w-12 shrink-0 rounded-full bg-gradient-to-r from-[#02c4e3] to-transparent"></span>
        {
          titlecenter && (
            <h2 class="flex items-center gap-2 text-lg leading-normal font-black tracking-widest text-[#8ff5ff] uppercase">
              <span aria-hidden="true" class="h-1.5 w-1.5 shrink-0 rounded-full bg-[#02c4e3] shadow-[0_0_8px_rgba(2,196,227,0.9)]" />
              {titlecenter}
            </h2>
          )
        }
        <slot name="center" />
      </article>

      <article class="flex flex-col gap-3 text-left text-base leading-relaxed text-[#cfeef7] md:pl-8">
        <span aria-hidden="true" class="h-[3px] w-12 shrink-0 rounded-full bg-gradient-to-r from-[#8ff5ff] to-transparent"></span>
        {
          titleright && (
            <h2 class="flex items-center gap-2 text-lg leading-normal font-black tracking-widest text-[#8ff5ff] uppercase">
              <span aria-hidden="true" class="h-1.5 w-1.5 shrink-0 rounded-full bg-[#02c4e3] shadow-[0_0_8px_rgba(2,196,227,0.9)]" />
              {titleright}
            </h2>
          )
        }
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
