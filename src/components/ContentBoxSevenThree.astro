---
export interface Props {
  titleleft?: string;
  titleright?: string;
}
const { titleleft, titleright } = Astro.props;

// Both column titles are <h2> and both receive their text from the page, i.e.
// from the docx — they are article headings, not chrome. The columns are
// flattened: the text classes sit on the <article> and the slot renders as a
// direct child, so `leading-normal` on each heading neutralises the inherited
// leading-relaxed. Do not re-add a wrapper <div> around either slot.
//
// The 3fr column is the slide artwork and the 7fr column is the docx paragraph,
// so index.astro passes titleright only and the block contributes one <h2>.
//
// RUAYRUAY888: rose-black card on the page ink, hot-pink frame and glow, and
// the near-white heading the artwork's neon lettering is drawn in. Body copy is
// the soft pink-white the whole brand shares.
---

<section class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  <div
    class="group relative isolate w-full overflow-hidden rounded-3xl border border-[#f874a1]/35 bg-[#1a1113]/92 p-8 text-[#f6dde8] shadow-[0_10px_30px_rgba(248,116,161,0.2)] backdrop-blur-xl transition-all duration-500 hover:border-[#fdb4d4]/60 hover:shadow-[0_15px_40px_rgba(248,116,161,0.28)] md:p-10">
    <div class="grid grid-cols-1 gap-8 md:grid-cols-[3fr_7fr] md:items-center">
      <article class="flex flex-col gap-4 border-b border-[#f874a1]/30 pb-6 text-left text-base leading-relaxed font-medium text-[#f6dde8] md:border-r md:border-b-0 md:pr-6 md:pb-0">
        {titleleft && <h2 class="text-center text-3xl leading-normal font-black tracking-wider text-[#ffffff] uppercase drop-shadow-[0_2px_10px_rgba(248,116,161,0.45)] md:text-left">{titleleft}</h2>}
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-3 text-left text-base leading-relaxed text-[#f6dde8] md:pl-6">
        {titleright && <h2 class="flex items-center gap-2 text-2xl leading-normal font-black text-[#fdb4d4] drop-shadow-[0_0_8px_rgba(248,116,161,0.45)]">{titleright}</h2>}
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
