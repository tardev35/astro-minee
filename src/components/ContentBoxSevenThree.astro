---
export interface Props {
  titleleft?: string;
  titleright?: string;
}
const { titleleft, titleright } = Astro.props;
---

<section class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  <div
    class="group relative isolate w-full overflow-hidden rounded-3xl border border-[#f6931e]/30 bg-[#161009]/92 p-8 text-[#f2dfc4] shadow-[0_10px_30px_rgba(246,147,30,0.16)] backdrop-blur-xl transition-all duration-500 hover:border-[#e07b12]/55 hover:shadow-[0_15px_40px_rgba(224,123,18,0.22)] md:p-10">
    <div class="grid grid-cols-1 gap-8 md:grid-cols-[3fr_7fr] md:items-center">
      <article
        class="flex flex-col gap-4 border-b border-[#f6931e]/25 pb-6 text-left text-base leading-relaxed font-medium text-[#f5e0bb] md:border-r md:border-b-0 md:pr-6 md:pb-0">
        {
          titleleft && (
            <h2 class="text-center text-3xl leading-normal font-black tracking-wider text-[#fff2e0] uppercase drop-shadow-[0_2px_10px_rgba(246,147,30,0.35)] md:text-left">{titleleft}</h2>
          )
        }
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-3 text-left text-base leading-relaxed text-[#f2dfc4] md:pl-6">
        {titleright && <h2 class="flex items-center gap-2 text-2xl leading-normal font-black text-[#f6931e] drop-shadow-[0_0_8px_rgba(246,147,30,0.35)]">{titleright}</h2>}
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
