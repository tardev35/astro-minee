---
import { Picture } from "astro:assets";

import slide1 from "../assets/slide1.png";
import slide2 from "../assets/slide2.png";
import slide3 from "../assets/slide3.png";
import slide4 from "../assets/slide4.png";

// Each alt is the text actually printed on that slide, read off the artwork,
// plus the scene it sits in. All four share the LAVA432 look: the white LAVA
// wordmark with 432 in a scarlet block, a model in black-and-red LAVA432 kit,
// gold coins, and a near-black background streaked with scarlet embers.
//
// This is a pure-CSS marquee — no Swiper, no JavaScript at all. It duplicates
// the four images three times so the loop has no seam; the duplicate copies are
// alt="" + aria-hidden so a screen reader hears each promotion once.
const images = [
  {
    src: slide1,
    alt: "แบนเนอร์โปรโมชั่น LAVA432 ข้อความ เช็กอิน 7 วัน รับเครดิตสะสม 432 บาท และบรรทัดล่างเขียนว่า เช็กอินครบ รับต่อได้เพลิน ใต้ลงมาเป็นการ์ดเจ็ดใบเรียงกันเขียนว่า DAY 1 ถึง DAY 7 มีเครื่องหมายถูกอยู่ทุกใบ และปุ่ม เช็กอินเลย ด้านบนเป็นโลโก้ LAVA432 ตัวอักษรขาวและเลข 432 บนบล็อกสีแดง ข้างขวาเป็นผู้หญิงในชุดกีฬาสีดำ-แดงติดโลโก้ LAVA432 ชี้นิ้วมาทางซ้าย ด้านล่างเป็นกล่องของขวัญผูกโบว์แดง หีบสมบัติที่มีเหรียญทองล้น และกล่องเขียนว่า เครดิตสะสม 432 บาท บนพื้นหลังสีดำแดงมีประกายไฟ",
  },
  {
    src: slide2,
    alt: "แบนเนอร์โปรโมชั่น LAVA432 ข้อความ ภารกิจประจำวัน พร้อมไอคอนเป้าธนูและกระดานเช็กลิสต์ ใต้ลงมาเป็นแผงหัวข้อ DAILY MISSIONS ไล่รายการ เข้าสู่ระบบ เดิมพันครบตามกำหนด เล่นเกมสล็อต และ ชวนเพื่อน โดยมีเครื่องหมายถูกสีแดงอยู่ท้ายทุกข้อ ถัดลงมาเขียนว่า ครบ 4 ภารกิจ รับฟรีสปิน 25 ครั้ง ทำครบ รับสิทธิ์ทันที และปุ่ม รับภารกิจ ด้านบนเป็นโลโก้ LAVA432 ตัวอักษรขาวและเลข 432 บนบล็อกสีแดง ข้างขวาเป็นผู้หญิงในชุดกีฬาสีดำ-แดงติดโลโก้ LAVA432 ขยิบตาและชี้นิ้วขึ้น ข้างหลังเป็นวงล้อสล็อตเลข 7 และช่อง BAR ด้านซ้ายล่างเป็นหีบสมบัติที่มีเหรียญทองและป้ายเลข 432 บนพื้นหลังสีดำแดงมีประกายไฟ",
  },
  {
    src: slide3,
    alt: "แบนเนอร์โปรโมชั่น LAVA432 ข้อความ ชวนเพื่อนมันส์ รับโบนัสคู่หู คนละ 50 บาท และบรรทัดล่างเขียนว่า เพื่อนสมัครสำเร็จ รับกันทั้งคู่ ใต้ลงมาเป็นไอคอนคนสองคนมีลูกศรชี้หากันคั่นด้วยกล่องของขวัญ กำกับว่า +50 บาท ทั้งสองฝั่ง และปุ่ม ชวนเลย ด้านบนเป็นโลโก้ LAVA432 ตัวอักษรขาวและเลข 432 บนบล็อกสีแดง มุมขวาบนเป็นไอคอนคนพร้อมเครื่องหมาย +1 ข้างขวาเป็นผู้หญิงในแจ็กเก็ตสีแดงและเสื้อดำติดโลโก้ LAVA432 ถือโทรศัพท์ที่เปิดหน้าแอป LAVA432 แล้วชี้นิ้วไปที่จอ ด้านล่างเป็นลูกฟุตบอลและเหรียญทอง บนพื้นหลังสีดำแดงมีประกายไฟ",
  },
  {
    src: slide4,
    alt: "แบนเนอร์โปรโมชั่น LAVA432 ข้อความขนาดใหญ่ LAVA HOUR พร้อมไอคอนนาฬิกาและช่วงเวลา 20:00 - 22:00 ใต้ลงมาเขียนว่า เปิดกล่องสุ่ม ลุ้น 18 / 88 / 188 / 432 เครดิต และป้ายเล็กเขียนว่า ร่วมสนุกเฉพาะช่วงเวลาที่กำหนด พร้อมปุ่ม เปิดเลย ด้านบนเป็นโลโก้ LAVA432 ตัวอักษรขาวและเลข 432 บนบล็อกสีแดง ข้างหลังเป็นหน้าปัดนาฬิกาขนาดใหญ่และสายฟ้าสีแดง ข้างขวาเป็นผู้หญิงในเสื้อสีแดงติดโลโก้ LAVA432 ยกมือประกบแก้มทำท่าตกใจดีใจ ด้านล่างซ้ายเป็นกล่องสุ่มสีดำแดงมีเครื่องหมายคำถามและเหรียญทองกระจายรอบ ๆ บนพื้นหลังสีดำแดงมีประกายไฟ",
  },
];

const COPIES = 3;
const slides = Array.from({ length: COPIES }, () => images).flat();
---

<div class="marquee mx-auto w-full max-w-[1301px] overflow-hidden px-4 py-5">
  <input id="carousel-pause" type="checkbox" class="peer sr-only" />
  <label
    for="carousel-pause"
    class="sr-only cursor-pointer peer-focus-visible:not-sr-only peer-focus-visible:mb-3 peer-focus-visible:inline-block peer-focus-visible:rounded-full peer-focus-visible:border peer-focus-visible:border-[#ff6a13]/60 peer-focus-visible:px-4 peer-focus-visible:py-2 peer-focus-visible:text-sm peer-focus-visible:font-bold peer-focus-visible:text-[#ff6a13]">
    หยุด / เล่นสไลด์ภาพ
  </label>

  <div class="marquee-track flex">
    {
      slides.map((slide, index) => {
        const isDuplicate = index >= images.length;
        return (
          <div class="marquee-slide" aria-hidden={isDuplicate ? "true" : undefined}>
            <Picture
              src={slide.src}
              alt={isDuplicate ? "" : slide.alt}
              class="block w-full rounded-xl border border-[#ec000e]/50 object-cover shadow-[0_10px_30px_rgba(236,0,14,0.28)]"
              width={slide.src.width}
              height={slide.src.height}
              loading="lazy"
              fetchpriority="low"
              decoding="async"
              widths={[200, 400, 600]}
              sizes="(max-width: 768px) 50vw, 33vw"
              formats={["avif", "webp"]}
              fallbackFormat="webp"
              quality={60}
            />
          </div>
        );
      })
    }
  </div>
</div>

<style>
  .marquee {
    --gap: 12px;
    --per-view: 2;
    --shift: calc(-200% - 24px);
  }

  @media (min-width: 768px) {
    .marquee {
      --gap: 16px;
      --per-view: 3;
      --shift: calc(-133.3333% - 21.3333px);
    }
  }

  .marquee-track {
    gap: var(--gap);
    width: 100%;
    animation: carousel-scroll 32s linear infinite;
    will-change: transform;
  }

  .marquee-slide {
    flex: 0 0 calc((100% - (var(--per-view) - 1) * var(--gap)) / var(--per-view));
  }

  @keyframes carousel-scroll {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(var(--shift));
    }
  }

  .marquee:hover .marquee-track,
  .marquee:focus-within .marquee-track,
  .marquee > input:checked ~ .marquee-track {
    animation-play-state: paused;
  }

  @media (prefers-reduced-motion: reduce) {
    .marquee-track {
      animation: none;
    }
  }
</style>
