---
import { Picture } from "astro:assets";

import slide1 from "../assets/slide1.png";
import slide2 from "../assets/slide2.png";
import slide3 from "../assets/slide3.png";
import slide4 from "../assets/slide4.png";

// Each alt is the text actually printed on that slide, read off the artwork,
// plus the scene it sits in. All four share the KIKI49 wordmark (KIKI in white,
// 49 in red) beside a skeleton-luchador penguin mascot in a black hood with a
// white asterisk emblem, set in a red neon casino room with gold coins.
const images = [
  {
    src: slide1,
    alt: "แบนเนอร์ KIKI49 ข้อความ เว็บสล็อต แตกง่าย โปรคุ้มทุกวัน ฝาก-ถอนออโต้ รวดเร็ว เล่นง่าย จ่ายจริง ป้าย ระบบออโต้ โบนัสคุ้ม บริการ 24 ชม. และปุ่ม สมัครเลย พร้อมมาสคอตเพนกวินสวมชุดโครงกระดูกบนโลโก้ ผู้หญิงในชุดดำแดง KIKI49 วงล้อสล็อต 777 ป้ายไฟ JACKPOT เหรียญทอง ลูกเต๋าแดงและชิปคาสิโน ในห้องคาสิโนไฟนีออนแดง",
  },
  {
    src: slide2,
    alt: "แบนเนอร์โปรโมชั่น KIKI49 ข้อความ คืนยอดเสียทุกวัน 0.8% เล่นต่อได้ทุกวัน และปุ่ม รับสิทธิ์ พร้อมมาสคอตเพนกวินโครงกระดูกสวมฮู้ดดำโบกมือ ผู้หญิงในชุดดำแดง KIKI49 แบมือ ตู้สล็อต 777 BAR ชิปคาสิโนสีแดงและเหรียญทองในห้องคาสิโนไฟนีออนแดง",
  },
  {
    src: slide3,
    alt: "แบนเนอร์โปรโมชั่น KIKI49 ข้อความ สมาชิกใหม่ รับโบนัส 50% สมัครวันนี้ รับสิทธิ์ทันที และปุ่ม รับโปรเลย พร้อมผู้หญิงในชุดดำแดง KIKI49 ชี้มาที่ตัวเลข มาสคอตเพนกวินโครงกระดูกบนโลโก้ ตู้สล็อต 777 ลูกเต๋าแดง กล่องของขวัญและเหรียญทอง",
  },
  {
    src: slide4,
    alt: "แบนเนอร์โปรโมชั่น KIKI49 ข้อความ แนะนำเพื่อน รับค่าคอม 10% ชวนเพื่อน ยิ่งชวนยิ่งคุ้ม สามขั้นตอน คัดลิงก์แนะนำเพื่อน เพื่อนสมัครผ่านลิงก์ของคุณ รับค่าคอม 10% ไม่จำกัด และปุ่ม ชวนเลย พร้อมผู้หญิงในชุดดำแดง KIKI49 ถือมือถือ ป้ายไฟ JACKPOT และเหรียญทอง",
  },
];

const COPIES = 3;
const slides = Array.from({ length: COPIES }, () => images).flat();
---

<div class="marquee mx-auto w-full max-w-[1301px] overflow-hidden px-4 py-5">
  <input id="carousel-pause" type="checkbox" class="peer sr-only" />
  <label
    for="carousel-pause"
    class="sr-only cursor-pointer peer-focus-visible:not-sr-only peer-focus-visible:mb-3 peer-focus-visible:inline-block peer-focus-visible:rounded-full peer-focus-visible:border peer-focus-visible:border-[#e2131d]/60 peer-focus-visible:px-4 peer-focus-visible:py-2 peer-focus-visible:text-sm peer-focus-visible:font-bold peer-focus-visible:text-[#ff5a5f]">
    หยุด / เล่นสไลด์ภาพ
  </label>

  <div class="marquee-track flex">
    {
      slides.map((slide, index) => {
        const isDuplicate = index >= images.length;
        return (
          <div class="marquee-slide" aria-hidden={isDuplicate ? "true" : undefined}>
            <Picture
              src={slide.src}
              alt={isDuplicate ? "" : slide.alt}
              class="block w-full rounded-xl border border-[#e2131d]/40 object-cover shadow-[0_10px_30px_rgba(226,19,29,0.25)]"
              width={slide.src.width}
              height={slide.src.height}
              loading="lazy"
              fetchpriority="low"
              decoding="async"
              widths={[200, 400, 600]}
              sizes="(max-width: 768px) 50vw, 33vw"
              formats={["avif", "webp"]}
              fallbackFormat="webp"
              quality={60}
            />
          </div>
        );
      })
    }
  </div>
</div>

<style>
  .marquee {
    --gap: 12px;
    --per-view: 2;
    --shift: calc(-200% - 24px);
  }

  @media (min-width: 768px) {
    .marquee {
      --gap: 16px;
      --per-view: 3;
      --shift: calc(-133.3333% - 21.3333px);
    }
  }

  .marquee-track {
    gap: var(--gap);
    width: 100%;
    animation: carousel-scroll 32s linear infinite;
    will-change: transform;
  }

  .marquee-slide {
    flex: 0 0 calc((100% - (var(--per-view) - 1) * var(--gap)) / var(--per-view));
  }

  @keyframes carousel-scroll {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(var(--shift));
    }
  }

  .marquee:hover .marquee-track,
  .marquee:focus-within .marquee-track,
  .marquee > input:checked ~ .marquee-track {
    animation-play-state: paused;
  }

  @media (prefers-reduced-motion: reduce) {
    .marquee-track {
      animation: none;
    }
  }
</style>
