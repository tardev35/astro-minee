---
import { Picture } from "astro:assets";

import slide1 from "../assets/slide1.png";
import slide2 from "../assets/slide2.png";
import slide3 from "../assets/slide3.png";
import slide4 from "../assets/slide4.png";

// Each alt is the Thai promotional text actually printed on that slide, read off
// the artwork, plus the scene it sits in. All four share the PATTAYA168 look:
// turquoise and gold over a night Pattaya bay, palm trees, casino chips and
// coins, with the site's palm-over-water logo centred at the top.
//
// The wordmark baked into these files is written as "โลโก้เว็บไซต์" rather than
// transcribed: alt text is for describing the picture, not for repeating a
// logotype a reader cannot act on.
//
// This is a pure-CSS marquee — no Swiper, no JavaScript at all. It duplicates
// the four images three times so the loop has no seam; the duplicate copies are
// alt="" + aria-hidden so a screen reader hears each promotion once.
const images = [
  {
    src: slide1,
    alt: "แบนเนอร์โปรโมชั่นโทนฟ้าเทอร์ควอยซ์กับทอง ด้านบนกลางภาพเป็นโลโก้เว็บไซต์รูปวงกลมสีฟ้าไล่เฉด ข้างในเป็นต้นปาล์มสีขาวสะท้อนบนผิวน้ำที่มีระลอกคลื่น ใต้วงกลมเป็นตัวอักษรโรมันเขียนว่า PATTAYA และลูกบอลสีส้มสามลูกพิมพ์เลข 1 6 และ 8 กลางภาพเป็นข้อความสีขาวขอบทองเขียนว่า สมาชิกใหม่รับโบนัส ใต้ข้อความเป็นเลข 88 ตัวใหญ่สีทอง ถัดลงมาเขียนว่า เปิดยูสวันนี้ รับสิทธิ์ทันที และกรอบมีมงกุฎขนาบสองข้างเขียนว่า เฉพาะสมาชิกใหม่ แถบล่างสุดมีสามช่องพร้อมไอคอนเขียนว่า สมัครฟรี รับไว และ ใช้งานง่าย ด้านซ้ายเป็นผู้หญิงสวมชุดสีส้มสลับฟ้ายิ้มขยิบตาและชี้มือมาข้างหน้า รอบภาพมีเหรียญทอง ไพ่โพดำ และชิปคาสิโนสีฟ้าทอง ฉากหลังเป็นอ่าวพัทยายามค่ำคืนที่มีตึกสูงเปิดไฟ",
  },
  {
    src: slide2,
    alt: "แบนเนอร์โปรโมชั่นโทนฟ้าเทอร์ควอยซ์กับทอง ด้านบนกลางภาพเป็นโลโก้เว็บไซต์รูปวงกลมสีฟ้าไล่เฉด ข้างในเป็นต้นปาล์มสีขาวสะท้อนบนผิวน้ำ ใต้วงกลมเป็นตัวอักษรโรมันเขียนว่า PATTAYA และลูกบอลสีส้มสามลูกพิมพ์เลข 1 6 และ 8 มุมบนขวาเป็นข้อความลายมือเขียนว่า Good Friends Bigger Wins กลางภาพเป็นหัวข้อสีขาวขอบทองสองบรรทัดเขียนว่า ชวนเพื่อน และ รับเพิ่ม ใต้หัวข้อเป็นเลข 300 ตัวใหญ่สีทอง ถัดลงมาเขียนว่า เพื่อนสมัครสำเร็จ รับโบนัสทันที ด้านล่างเป็นแถวขั้นตอนสามช่องพร้อมลูกศรและไอคอนเขียนว่า แชร์ลิงก์ เพื่อนสมัคร และ รับโบนัส ด้านซ้ายเป็นผู้หญิงสวมสูทสีฟ้าเทอร์ควอยซ์ชี้มือมาข้างหน้าและถือโทรศัพท์ที่หน้าจอเขียนว่า แชร์ให้เพื่อน รับโบนัสด้วยกัน ขอบซ้ายเขียนว่า ยิ่งชวน ยิ่งรวย ไปด้วยกัน มุมล่างซ้ายเป็นชิปคาสิโนกองอยู่ข้างแท่งทองที่เขียนว่า GOOD PEOPLE GREAT JACKPOTS ล่างสุดเขียนว่า PATTAYA168 PLAY MORE TOGETHER และมุมล่างขวาเขียนว่า เพื่อนดี มีแต่ได้ ฉากหลังเป็นอ่าวพัทยายามค่ำคืนที่มีต้นปาล์ม เรือ และตึกสูงเปิดไฟ",
  },
  {
    src: slide3,
    alt: "แบนเนอร์โปรโมชั่นโทนฟ้าเทอร์ควอยซ์กับทอง ด้านบนกลางภาพเป็นโลโก้เว็บไซต์รูปวงกลมสีฟ้าไล่เฉด ข้างในเป็นต้นปาล์มสีขาวสะท้อนบนผิวน้ำ ใต้วงกลมเป็นตัวอักษรโรมันเขียนว่า PATTAYA และลูกบอลสีส้มสามลูกพิมพ์เลข 1 6 และ 8 มุมบนขวาเป็นข้อความลายมือเขียนว่า Play More Everyday กลางภาพเป็นหัวข้อสีขาวขอบทองสองบรรทัดมีมงกุฎวางอยู่ด้านบนเขียนว่า ภารกิจรายวัน และ ทำครบรับของรางวัล ใต้หัวข้อเขียนว่า สะสมแต้ม แลกรับสิทธิ์สุดคุ้ม ถัดลงมาเป็นแถวสามช่องพร้อมลูกศรและไอคอนปฏิทิน กระดานบันทึก และกล่องของขวัญ เขียนว่า เช็คอิน ทำภารกิจ และ รับรางวัล ด้านซ้ายเป็นผู้หญิงสวมชุดกีฬาสีฟ้าเทอร์ควอยซ์ที่มีโลโก้เว็บไซต์อยู่บนอก กำลังยิ้มขยิบตาและชี้มือมาข้างหน้า ขอบซ้ายเป็นป้ายมังกรทองเขียนว่า SLOT และข้อความลายมือว่า Good Game Bigger Rewards ขอบขวาเป็นไพ่เขียนว่า CASINO ลูกฟุตบอลเขียนว่า SPORTS และป้ายไม้เขียนว่า PATTAYA 168 ด้านล่างมีกล่องของขวัญสีฟ้า เหรียญทอง อัญมณี และชิปคาสิโนกองอยู่ มุมล่างขวาเขียนว่า เล่นทุกวัน รับความสุขได้มากกว่า",
  },
  {
    src: slide4,
    alt: "แบนเนอร์โปรโมชั่นโทนทองกับฟ้าเทอร์ควอยซ์ ด้านบนกลางภาพเป็นโลโก้เว็บไซต์รูปวงกลมสีฟ้าไล่เฉด ข้างในเป็นต้นปาล์มสีขาวสะท้อนบนผิวน้ำที่มีระลอกคลื่น ใต้วงกลมเป็นตัวอักษรโรมันเขียนว่า PATTAYA และลูกบอลสีส้มสามลูกพิมพ์เลข 1 6 และ 8 มุมบนขวาเป็นหน้าปัดนาฬิกาทองเลขโรมันขนาดใหญ่ที่พิมพ์คำว่า GOLDEN HOUR ไว้บนหน้าปัด กลางภาพเป็นหัวข้อตัวใหญ่สีทองเขียนว่า นาทีทอง ใต้หัวข้อเป็นสองบรรทัดเขียนว่า เติมครบ 500 และ รับเพิ่ม 20 เปอร์เซ็นต์ ถัดลงมาเป็นสองแถบพร้อมไอคอนนาฬิกาและกล่องของขวัญเขียนว่า เฉพาะช่วงกิจกรรม และ ลุ้นสนุกได้ทุกวัน ด้านขวาเป็นผู้หญิงสวมชุดราตรีเลื่อมสีทองหันหลังแล้วเหลียวมองมาทางกล้อง มุมล่างซ้ายเป็นวงล้อสล็อตขึ้นเลข 777 รอบภาพมีเหรียญทองกระจายอยู่ ฉากหลังเป็นอ่าวพัทยายามค่ำคืนที่มีต้นปาล์มและตึกสูงเปิดไฟ",
  },
];

const COPIES = 3;
const slides = Array.from({ length: COPIES }, () => images).flat();
---

<div class="marquee mx-auto w-full max-w-[1301px] overflow-hidden px-4 py-5">
  <input id="carousel-pause" type="checkbox" class="peer sr-only" />
  <label
    for="carousel-pause"
    class="sr-only cursor-pointer peer-focus-visible:not-sr-only peer-focus-visible:mb-3 peer-focus-visible:inline-block peer-focus-visible:rounded-full peer-focus-visible:border peer-focus-visible:border-[#02c4e3]/60 peer-focus-visible:px-4 peer-focus-visible:py-2 peer-focus-visible:text-sm peer-focus-visible:font-bold peer-focus-visible:text-[#8ff5ff]">
    หยุด / เล่นสไลด์ภาพ
  </label>

  <div class="marquee-track flex">
    {
      slides.map((slide, index) => {
        const isDuplicate = index >= images.length;
        return (
          <div class="marquee-slide" aria-hidden={isDuplicate ? "true" : undefined}>
            <Picture
              src={slide.src}
              alt={isDuplicate ? "" : slide.alt}
              class="block w-full rounded-xl border border-[#02c4e3]/50 object-cover shadow-[0_10px_30px_rgba(2,196,227,0.28)]"
              width={slide.src.width}
              height={slide.src.height}
              loading="lazy"
              fetchpriority="low"
              decoding="async"
              widths={[200, 400, 600]}
              sizes="(max-width: 768px) 50vw, 33vw"
              formats={["avif", "webp"]}
              fallbackFormat="webp"
              quality={60}
            />
          </div>
        );
      })
    }
  </div>
</div>

<style>
  .marquee {
    --gap: 12px;
    --per-view: 2;
    --shift: calc(-200% - 24px);
  }

  @media (min-width: 768px) {
    .marquee {
      --gap: 16px;
      --per-view: 3;
      --shift: calc(-133.3333% - 21.3333px);
    }
  }

  .marquee-track {
    gap: var(--gap);
    width: 100%;
    animation: carousel-scroll 32s linear infinite;
    will-change: transform;
  }

  .marquee-slide {
    flex: 0 0 calc((100% - (var(--per-view) - 1) * var(--gap)) / var(--per-view));
  }

  @keyframes carousel-scroll {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(var(--shift));
    }
  }

  .marquee:hover .marquee-track,
  .marquee:focus-within .marquee-track,
  .marquee > input:checked ~ .marquee-track {
    animation-play-state: paused;
  }

  @media (prefers-reduced-motion: reduce) {
    .marquee-track {
      animation: none;
    }
  }
</style>
