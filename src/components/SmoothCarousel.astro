---
import { Picture } from "astro:assets";

import slide1 from "../assets/slide1.png";
import slide2 from "../assets/slide2.png";
import slide3 from "../assets/slide3.png";
import slide4 from "../assets/slide4.png";

// Each alt is the text actually printed on that slide, read off the artwork,
// plus the scene it sits in. All four share the LOTTO77 lucky-red look: crimson
// and gold on a near-black maroon ground, lottery balls, สลากกินแบ่งรัฐบาล
// tickets, a woman in a red cheongsam holding tickets, and stacks of gold coins.
//
// This is a pure-CSS marquee — no Swiper, no JavaScript at all. It duplicates
// the four images three times so the loop has no seam; the duplicate copies are
// alt="" + aria-hidden so a screen reader hears each promotion once.
const images = [
  {
    src: slide1,
    alt: "แบนเนอร์โปรโมชั่น LOTTO77 ข้อความ สมาชิกใหม่ รับเครดิตฟรีซื้อหวย 50 บาท พร้อมป้าย สมัครวันนี้ รับสิทธิ์ทันที และ โปรต้อนรับสำหรับสายหวย กับปุ่ม รับโปรเลย ฉากหลังสีแดงเข้มมีลูกบอลหวยสีแดงทอง ตารางเลขหวยยี่กีและหวยรัฐบาล ผู้หญิงในชุดกี่เพ้าสีแดงถือใบสลากกินแบ่งรัฐบาล และกองเหรียญทอง",
  },
  {
    src: slide2,
    alt: "แบนเนอร์โปรโมชั่น LOTTO77 ข้อความ นาทีทอง 19:00 – 21:00 ซื้อหวยรับส่วนลด 10% พร้อมป้าย เฉพาะช่วงเวลาที่กำหนด และปุ่ม ร่วมโปรเลย ฉากหลังสีแดงเข้มมีนาฬิกาสีทอง ลายคลื่นแดง-ทอง ผู้หญิงในชุดสีแดงถือใบสลาก และลูกบอลหวยเลข 77 กับกองเหรียญทอง",
  },
  {
    src: slide3,
    alt: "แบนเนอร์โปรโมชั่น LOTTO77 ข้อความ วงล้อเลขนำโชค ลุ้นเครดิตซื้อหวยสูงสุด 888 บาท พร้อมป้าย หมุนฟรีทุกวัน ลุ้นรับทันที และปุ่ม หมุนเลย ภาพวงล้อเสี่ยงโชคขนาดใหญ่สีแดง-ทองมีตัวเลข 77 99 24 38 17 89 45 16 เรียงรอบโลโก้ LOTTO77 ตรงกลาง ล้อมด้วยใบสลากกินแบ่งรัฐบาลและกองเหรียญทองบนพื้นหลังสีแดงเข้ม",
  },
  {
    src: slide4,
    alt: "แบนเนอร์โปรโมชั่น LOTTO77 ข้อความ ซื้อหวยครบ 300 บาท รับคืน 5% ทุกงวด พร้อมป้าย ยิ่งซื้อ ยิ่งคุ้ม และปุ่ม รับสิทธิ์ ภาพผู้หญิงในชุดสีแดงถือใบสลากกินแบ่งรัฐบาลคลี่เป็นรูปพัด ตารางเลขหวย เหรียญสีแดง-ทอง และลูกบอลหวยเลข 7 3 8 บนพื้นหลังสีแดงเข้ม",
  },
];

const COPIES = 3;
const slides = Array.from({ length: COPIES }, () => images).flat();
---

<div class="marquee mx-auto w-full max-w-[1301px] overflow-hidden px-4 py-5">
  <input id="carousel-pause" type="checkbox" class="peer sr-only" />
  <label
    for="carousel-pause"
    class="sr-only cursor-pointer peer-focus-visible:not-sr-only peer-focus-visible:mb-3 peer-focus-visible:inline-block peer-focus-visible:rounded-full peer-focus-visible:border peer-focus-visible:border-[#f5c451]/60 peer-focus-visible:px-4 peer-focus-visible:py-2 peer-focus-visible:text-sm peer-focus-visible:font-bold peer-focus-visible:text-[#f5c451]">
    หยุด / เล่นสไลด์ภาพ
  </label>

  <div class="marquee-track flex">
    {
      slides.map((slide, index) => {
        const isDuplicate = index >= images.length;
        return (
          <div class="marquee-slide" aria-hidden={isDuplicate ? "true" : undefined}>
            <Picture
              src={slide.src}
              alt={isDuplicate ? "" : slide.alt}
              class="block w-full rounded-xl border border-[#d81220]/50 object-cover shadow-[0_10px_30px_rgba(216,18,32,0.28)]"
              width={slide.src.width}
              height={slide.src.height}
              loading="lazy"
              fetchpriority="low"
              decoding="async"
              widths={[200, 400, 600]}
              sizes="(max-width: 768px) 50vw, 33vw"
              formats={["avif", "webp"]}
              fallbackFormat="webp"
              quality={60}
            />
          </div>
        );
      })
    }
  </div>
</div>

<style>
  .marquee {
    --gap: 12px;
    --per-view: 2;
    --shift: calc(-200% - 24px);
  }

  @media (min-width: 768px) {
    .marquee {
      --gap: 16px;
      --per-view: 3;
      --shift: calc(-133.3333% - 21.3333px);
    }
  }

  .marquee-track {
    gap: var(--gap);
    width: 100%;
    animation: carousel-scroll 32s linear infinite;
    will-change: transform;
  }

  .marquee-slide {
    flex: 0 0 calc((100% - (var(--per-view) - 1) * var(--gap)) / var(--per-view));
  }

  @keyframes carousel-scroll {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(var(--shift));
    }
  }

  .marquee:hover .marquee-track,
  .marquee:focus-within .marquee-track,
  .marquee > input:checked ~ .marquee-track {
    animation-play-state: paused;
  }

  @media (prefers-reduced-motion: reduce) {
    .marquee-track {
      animation: none;
    }
  }
</style>
