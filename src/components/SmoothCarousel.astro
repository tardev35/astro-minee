---
import { Picture } from "astro:assets";

import slide1 from "../assets/slide1.png";
import slide2 from "../assets/slide2.png";
import slide3 from "../assets/slide3.png";
import slide4 from "../assets/slide4.png";

// Each alt is the text actually printed on that slide, read off the artwork,
// plus the scene it sits in. All four share the CHICKYLUCKY look: crimson and
// chick-yellow on a deep red ground, a JACKPOT 777 slot cabinet, stacks of gold
// coins and casino chips, a woman in a red-and-yellow outfit, and the white
// rooster in its red cape.
//
// This is a pure-CSS marquee — no Swiper, no JavaScript at all. It duplicates
// the four images three times so the loop has no seam; the duplicate copies are
// alt="" + aria-hidden so a screen reader hears each promotion once.
const images = [
  {
    src: slide1,
    alt: "แบนเนอร์โปรโมชั่น CHICKYLUCKY ข้อความ สมาชิกใหม่ รับโบนัส 50% สมัครวันนี้ รับสิทธิ์ทันที และปุ่ม รับโปรเลย ใต้ปุ่มเขียนว่า โปรต้อนรับสำหรับสมาชิกใหม่ ภาพผู้หญิงในชุดกีฬาสีแดง-เหลืองชี้นิ้วขึ้น ข้างซ้ายเป็นตู้สล็อต JACKPOT เลข 777 กองเหรียญทอง ชิปคาสิโน และไก่สวมผ้าคลุมสีแดงโลโก้ CHICKY LUCKY บนพื้นหลังสีแดงเข้ม",
  },
  {
    src: slide2,
    alt: "แบนเนอร์โปรโมชั่น CHICKYLUCKY ข้อความ ฝากครั้งแรก รับเพิ่ม 20% คุ้มตั้งแต่ฝากแรก และปุ่ม ฝากเลย ภาพผู้หญิงในชุดสีแดง-เหลืองยืนกอดอก ข้างหลังเป็นตู้สล็อต JACKPOT 777 มีไก่สวมผ้าคลุมสีแดง กองเหรียญทอง ชิปคาสิโน และไพ่ A กับ K บนพื้นหลังสีแดงเข้ม",
  },
  {
    src: slide3,
    alt: "แบนเนอร์โปรโมชั่น CHICKYLUCKY ข้อความ นาทีทอง 12:00 - 14:00 รับเพิ่ม 15% เฉพาะช่วงเวลาที่กำหนด และปุ่ม ร่วมโปรเลย ภาพนาฬิกาเรือนทองด้านหลังตัวเลข ผู้หญิงในชุดสีแดง-เหลือง ตู้สล็อต JACKPOT 777 ไก่สวมผ้าคลุมสีแดง ชิปคาสิโนและกองเหรียญทองบนพื้นหลังสีแดงเข้ม",
  },
  {
    src: slide4,
    alt: "แบนเนอร์โปรโมชั่น CHICKYLUCKY ข้อความ วงล้อไก่นำโชค ลุ้นเครดิตฟรีสูงสุด 888 บาท หมุนฟรีทุกวัน ลุ้นรับทันที และปุ่ม หมุนเลย ภาพวงล้อเสี่ยงโชคสีแดง-ครีมมีตัวเลข 888 200 100 50 30 20 และรูปไก่ตรงกลาง ข้างขวาเป็นผู้หญิงในชุดสีแดง-เหลืองชี้นิ้วขึ้น ล้อมด้วยเหรียญทองและชิปคาสิโนบนพื้นหลังสีแดงเข้ม",
  },
];

const COPIES = 3;
const slides = Array.from({ length: COPIES }, () => images).flat();
---

<div class="marquee mx-auto w-full max-w-[1301px] overflow-hidden px-4 py-5">
  <input id="carousel-pause" type="checkbox" class="peer sr-only" />
  <label
    for="carousel-pause"
    class="sr-only cursor-pointer peer-focus-visible:not-sr-only peer-focus-visible:mb-3 peer-focus-visible:inline-block peer-focus-visible:rounded-full peer-focus-visible:border peer-focus-visible:border-[#fde41a]/60 peer-focus-visible:px-4 peer-focus-visible:py-2 peer-focus-visible:text-sm peer-focus-visible:font-bold peer-focus-visible:text-[#fde41a]">
    หยุด / เล่นสไลด์ภาพ
  </label>

  <div class="marquee-track flex">
    {
      slides.map((slide, index) => {
        const isDuplicate = index >= images.length;
        return (
          <div class="marquee-slide" aria-hidden={isDuplicate ? "true" : undefined}>
            <Picture
              src={slide.src}
              alt={isDuplicate ? "" : slide.alt}
              class="block w-full rounded-xl border border-[#e01b24]/50 object-cover shadow-[0_10px_30px_rgba(224,27,36,0.28)]"
              width={slide.src.width}
              height={slide.src.height}
              loading="lazy"
              fetchpriority="low"
              decoding="async"
              widths={[200, 400, 600]}
              sizes="(max-width: 768px) 50vw, 33vw"
              formats={["avif", "webp"]}
              fallbackFormat="webp"
              quality={60}
            />
          </div>
        );
      })
    }
  </div>
</div>

<style>
  .marquee {
    --gap: 12px;
    --per-view: 2;
    --shift: calc(-200% - 24px);
  }

  @media (min-width: 768px) {
    .marquee {
      --gap: 16px;
      --per-view: 3;
      --shift: calc(-133.3333% - 21.3333px);
    }
  }

  .marquee-track {
    gap: var(--gap);
    width: 100%;
    animation: carousel-scroll 32s linear infinite;
    will-change: transform;
  }

  .marquee-slide {
    flex: 0 0 calc((100% - (var(--per-view) - 1) * var(--gap)) / var(--per-view));
  }

  @keyframes carousel-scroll {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(var(--shift));
    }
  }

  .marquee:hover .marquee-track,
  .marquee:focus-within .marquee-track,
  .marquee > input:checked ~ .marquee-track {
    animation-play-state: paused;
  }

  @media (prefers-reduced-motion: reduce) {
    .marquee-track {
      animation: none;
    }
  }
</style>
