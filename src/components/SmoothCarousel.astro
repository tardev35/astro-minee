---
import { Picture } from "astro:assets";

import slide1 from "../assets/slide1.png";
import slide2 from "../assets/slide2.png";
import slide3 from "../assets/slide3.png";
import slide4 from "../assets/slide4.png";

// Each alt is the text actually printed on that slide, read off the artwork,
// plus the scene it sits in. All four share the เฮงเฮง888 wordmark (ตัวอักษรไทย
// "เฮงเฮง" สีขาวขอบเขียวเข้ม เหนือเลข 888 สีเขียวมะนาวไล่เฉด) beside a model in a
// green-and-white outfit printed เฮงเฮง888, in a dark green casino hall with gold
// coins and green casino chips.
const images = [
  {
    src: slide1,
    alt: "แบนเนอร์โปรโมชั่น เฮงเฮง888 ข้อความ สมาชิกใหม่ รับโบนัส 50% สมัครวันนี้ รับสิทธิ์ทันที โบนัสต้อนรับสำหรับผู้เล่นใหม่ และปุ่มสีเขียว รับโปรเลย พร้อมโลโก้ เฮงเฮง888 ตัวอักษรไทยสีขาวเหนือเลข 888 สีเขียวมะนาว ผู้หญิงในชุดเกาะอกและกระโปรงสีเขียว-ขาวพิมพ์ เฮงเฮง888 ชี้นิ้วขึ้น วงล้อสล็อตเลข 777 กองเหรียญทองและเหรียญที่ปลิวอยู่ในห้องคาสิโนโทนเขียวเข้ม",
  },
  {
    src: slide2,
    alt: "แบนเนอร์โปรโมชั่น เฮงเฮง888 ข้อความ ฝากครั้งแรก รับเพิ่ม 20% คุ้มตั้งแต่ฝากแรก พร้อมป้าย ฝากง่าย ถอนเร็ว ระบบออโต้ และปุ่มสีเขียว ฝากเลย พร้อมโลโก้ เฮงเฮง888 ตัวอักษรไทยสีขาวเหนือเลข 888 สีเขียวมะนาว ผู้หญิงในชุดครอปและกระโปรงสีเขียว-ขาวพิมพ์ เฮงเฮง888 ชี้นิ้วไปทางข้อความ ป้าย JACKPOT ตู้สล็อตเลข 77 ชิปคาสิโนสีเขียว-ขาว และกองเหรียญทองในห้องคาสิโนโทนเขียวเข้ม",
  },
  {
    src: slide3,
    alt: "แบนเนอร์โปรโมชั่น เฮงเฮง888 ข้อความ แนะนำเพื่อน รับค่าคอม 10% ชวนเพื่อน ยิ่งชวนยิ่งคุ้ม พร้อมแผนภาพสามขั้นตอน ส่งลิงก์แนะนำ เพื่อนสมัคร รับค่าคอม และปุ่มสีเขียว ชวนเลย พร้อมโลโก้ เฮงเฮง888 ตัวอักษรไทยสีขาวเหนือเลข 888 สีเขียวมะนาว ผู้หญิงในชุดกีฬาสีเขียว-ขาวพิมพ์ เฮงเฮง888 ชี้นิ้วขึ้น ชิปคาสิโนสีเขียว ไพ่ และกองเหรียญทอง พร้อมแถบข้อความ มั่นคง ปลอดภัย เชื่อถือได้ 100% บริการตลอด 24 ชม. ถอนง่าย จ่ายไว ในห้องคาสิโนโทนเขียวเข้ม",
  },
  {
    src: slide4,
    alt: "แบนเนอร์โปรโมชั่น เฮงเฮง888 ข้อความ คืนยอดเสียทุกวัน 0.8% เล่นต่อได้ทุกวัน คืนยอดเสียคุ้มค่า ไม่พลาดทุกความสนุก พร้อมป้าย ระบบออโต้ โบนัสคุ้ม บริการ 24 ชม. และปุ่มสีเขียว รับสิทธิ์ พร้อมโลโก้ เฮงเฮง888 ตัวอักษรไทยสีขาวเหนือเลข 888 สีเขียวมะนาว ผู้หญิงในชุดเกาะอกสีเขียว-ขาวพิมพ์ เฮงเฮง888 ชี้นิ้วขึ้น ตู้สล็อตเลข 777 ชิปคาสิโนสีเขียว กล่องของขวัญผูกโบว์ทอง และกองเหรียญทองในห้องคาสิโนโทนเขียวเข้ม",
  },
];

const COPIES = 3;
const slides = Array.from({ length: COPIES }, () => images).flat();
---

<div class="marquee mx-auto w-full max-w-[1301px] overflow-hidden px-4 py-5">
  <input id="carousel-pause" type="checkbox" class="peer sr-only" />
  <label
    for="carousel-pause"
    class="sr-only cursor-pointer peer-focus-visible:not-sr-only peer-focus-visible:mb-3 peer-focus-visible:inline-block peer-focus-visible:rounded-full peer-focus-visible:border peer-focus-visible:border-[#12a34f]/60 peer-focus-visible:px-4 peer-focus-visible:py-2 peer-focus-visible:text-sm peer-focus-visible:font-bold peer-focus-visible:text-[#9fcf3a]">
    หยุด / เล่นสไลด์ภาพ
  </label>

  <div class="marquee-track flex">
    {
      slides.map((slide, index) => {
        const isDuplicate = index >= images.length;
        return (
          <div class="marquee-slide" aria-hidden={isDuplicate ? "true" : undefined}>
            <Picture
              src={slide.src}
              alt={isDuplicate ? "" : slide.alt}
              class="block w-full rounded-xl border border-[#12a34f]/45 object-cover shadow-[0_10px_30px_rgba(18,163,79,0.25)]"
              width={slide.src.width}
              height={slide.src.height}
              loading="lazy"
              fetchpriority="low"
              decoding="async"
              widths={[200, 400, 600]}
              sizes="(max-width: 768px) 50vw, 33vw"
              formats={["avif", "webp"]}
              fallbackFormat="webp"
              quality={60}
            />
          </div>
        );
      })
    }
  </div>
</div>

<style>
  .marquee {
    --gap: 12px;
    --per-view: 2;
    --shift: calc(-200% - 24px);
  }

  @media (min-width: 768px) {
    .marquee {
      --gap: 16px;
      --per-view: 3;
      --shift: calc(-133.3333% - 21.3333px);
    }
  }

  .marquee-track {
    gap: var(--gap);
    width: 100%;
    animation: carousel-scroll 32s linear infinite;
    will-change: transform;
  }

  .marquee-slide {
    flex: 0 0 calc((100% - (var(--per-view) - 1) * var(--gap)) / var(--per-view));
  }

  @keyframes carousel-scroll {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(var(--shift));
    }
  }

  .marquee:hover .marquee-track,
  .marquee:focus-within .marquee-track,
  .marquee > input:checked ~ .marquee-track {
    animation-play-state: paused;
  }

  @media (prefers-reduced-motion: reduce) {
    .marquee-track {
      animation: none;
    }
  }
</style>
