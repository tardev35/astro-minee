---
import { Picture } from "astro:assets";

import slide1 from "../assets/slide1.png";
import slide2 from "../assets/slide2.png";
import slide3 from "../assets/slide3.png";
import slide4 from "../assets/slide4.png";

// Each alt is the text actually printed on that slide, read off the artwork,
// plus the scene it sits in. All four share the LASVEGAS889 wordmark (LASVEGAS
// สีทอง + เลข 889 สีโครมเงิน) over a neon-cyan Las Vegas skyline on a deep
// royal-blue night background, with a model in a white/royal-blue/gold outfit
// printed LASVEGAS 889, gold coins and blue casino chips.
//
// This is a pure-CSS marquee — no Swiper, no JavaScript at all. It duplicates
// the four images three times so the loop has no seam; the duplicate copies are
// alt="" + aria-hidden so a screen reader hears each promotion once.
const images = [
  {
    src: slide1,
    alt: "แบนเนอร์โปรโมชั่น LASVEGAS889 ข้อความ สมาชิกใหม่ รับโบนัส 50% สมัครวันนี้ รับสิทธิ์ทันที และปุ่ม รับโปรเลย พร้อมแถบ มั่นคง ปลอดภัย เชื่อถือได้ 100% บริการตลอด 24 ชม. รวดเร็ว ทันใจ และ ฝาก-ถอน ออโต้ ไม่ต้องรอนาน พร้อมโลโก้ LASVEGAS สีทองและเลข 889 สีโครมเงินเหนือเส้นขอบฟ้าเมืองลาสเวกัสสีฟ้านีออน ผู้หญิงในชุดครอปสีขาว-น้ำเงิน-ทองพิมพ์ LASVEGAS 889 ชิปคาสิโนสีน้ำเงินและกองเหรียญทองบนพื้นหลังสีน้ำเงินเข้ม",
  },
  {
    src: slide2,
    alt: "แบนเนอร์โปรโมชั่น LASVEGAS889 ข้อความ ฝากครั้งแรก รับเพิ่ม 20% คุ้มตั้งแต่ฝากแรก พร้อมไอคอนสามช่อง ฝากง่าย ถอนเร็ว ระบบออโต้ ป้าย VIP และปุ่ม ฝากเลย พร้อมโลโก้ LASVEGAS สีทองและเลข 889 สีโครมเงินเหนือเส้นขอบฟ้าเมืองลาสเวกัสสีฟ้านีออน ผู้หญิงในชุดครอปสีขาว-น้ำเงิน-ทองพิมพ์ LASVEGAS 889 ตู้สล็อตสัญลักษณ์ BAR และเลข 7 ชิปคาสิโนสีน้ำเงินและกองเหรียญทองบนพื้นหลังสีน้ำเงินเข้ม",
  },
  {
    src: slide3,
    alt: "แบนเนอร์โปรโมชั่น LASVEGAS889 ข้อความ คืนยอดเสีย 0.8% ทุกวัน เล่นต่อได้ทุกวัน คืนยอดเสียคุ้มค่า ไม่พลาดทุกความสนุก และปุ่ม รับสิทธิ์ พร้อมโลโก้ LASVEGAS สีทองและเลข 889 สีโครมเงินเหนือเส้นขอบฟ้าเมืองลาสเวกัสสีฟ้านีออน ผู้หญิงในชุดเดรสสีขาว-น้ำเงิน-ทองพิมพ์ LASVEGAS 889 ตู้สล็อต JACKPOT เลข 777 ชิปคาสิโนพิมพ์ 889 และกองเหรียญทองบนพื้นหลังสีน้ำเงินเข้ม",
  },
  {
    src: slide4,
    alt: "แบนเนอร์โปรโมชั่น LASVEGAS889 ข้อความ คาสิโนออนไลน์ครบวงจร เล่นง่าย ฝาก-ถอนออโต้ จ่ายจริง พร้อมการันตีสี่ข้อ ปลอดภัย มั่นคง 100% ฝาก-ถอน ออโต้ จ่ายจริง ไม่มีโกง และ บริการ 24 ชม. ตลอดทุกวัน ปุ่ม สมัครเลย และแถบล่าง รองรับทุกอุปกรณ์ ระบบทันสมัย ปลอดภัย รองรับทุกธนาคาร พร้อมโลโก้ LASVEGAS สีทองและเลข 889 สีโครมเงิน ป้าย Welcome to Fabulous LAS VEGAS NEVADA เหนือเส้นขอบฟ้าเมืองลาสเวกัสสีฟ้านีออน ผู้หญิงในชุดสีขาว-น้ำเงิน-ทองพิมพ์ LASVEGAS 889 ตู้สล็อตเลข 777 และกองเหรียญทองบนพื้นหลังสีน้ำเงินเข้ม",
  },
];

const COPIES = 3;
const slides = Array.from({ length: COPIES }, () => images).flat();
---

<div class="marquee mx-auto w-full max-w-[1301px] overflow-hidden px-4 py-5">
  <input id="carousel-pause" type="checkbox" class="peer sr-only" />
  <label
    for="carousel-pause"
    class="sr-only cursor-pointer peer-focus-visible:not-sr-only peer-focus-visible:mb-3 peer-focus-visible:inline-block peer-focus-visible:rounded-full peer-focus-visible:border peer-focus-visible:border-[#3fdcff]/60 peer-focus-visible:px-4 peer-focus-visible:py-2 peer-focus-visible:text-sm peer-focus-visible:font-bold peer-focus-visible:text-[#3fdcff]">
    หยุด / เล่นสไลด์ภาพ
  </label>

  <div class="marquee-track flex">
    {
      slides.map((slide, index) => {
        const isDuplicate = index >= images.length;
        return (
          <div class="marquee-slide" aria-hidden={isDuplicate ? "true" : undefined}>
            <Picture
              src={slide.src}
              alt={isDuplicate ? "" : slide.alt}
              class="block w-full rounded-xl border border-[#1f5ce0]/45 object-cover shadow-[0_10px_30px_rgba(31,92,224,0.25)]"
              width={slide.src.width}
              height={slide.src.height}
              loading="lazy"
              fetchpriority="low"
              decoding="async"
              widths={[200, 400, 600]}
              sizes="(max-width: 768px) 50vw, 33vw"
              formats={["avif", "webp"]}
              fallbackFormat="webp"
              quality={60}
            />
          </div>
        );
      })
    }
  </div>
</div>

<style>
  .marquee {
    --gap: 12px;
    --per-view: 2;
    --shift: calc(-200% - 24px);
  }

  @media (min-width: 768px) {
    .marquee {
      --gap: 16px;
      --per-view: 3;
      --shift: calc(-133.3333% - 21.3333px);
    }
  }

  .marquee-track {
    gap: var(--gap);
    width: 100%;
    animation: carousel-scroll 32s linear infinite;
    will-change: transform;
  }

  .marquee-slide {
    flex: 0 0 calc((100% - (var(--per-view) - 1) * var(--gap)) / var(--per-view));
  }

  @keyframes carousel-scroll {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(var(--shift));
    }
  }

  .marquee:hover .marquee-track,
  .marquee:focus-within .marquee-track,
  .marquee > input:checked ~ .marquee-track {
    animation-play-state: paused;
  }

  @media (prefers-reduced-motion: reduce) {
    .marquee-track {
      animation: none;
    }
  }
</style>
