---
import { Picture } from "astro:assets";

import slide1 from "../assets/slide1.png";
import slide2 from "../assets/slide2.png";
import slide3 from "../assets/slide3.png";
import slide4 from "../assets/slide4.png";

// Each alt is the text actually printed on that slide, read off the artwork,
// plus the scene it sits in. All four share the gold AMBPlus+ wordmark on a
// near-black ground, a model in a black-and-gold dress, gold coins and chips,
// a 777 JACKPOT reel, a roulette wheel and a poker hand.
const images = [
  {
    src: slide1,
    alt: "แบนเนอร์โปรโมชั่นของ AMBPLUS ข้อความ AMBPlus+ คาสิโนออนไลน์ครบวงจร เล่นง่าย จ่ายจริง ฝากถอนออโต้ รองรับมือถือ ระบบออโต้ 24 ชม. และปุ่ม สมัครเลย พร้อมนางแบบชุดดำทอง วงล้อรูเล็ต ตู้สล็อต 777 ไพ่โป๊กเกอร์ เหรียญและชิปสีทอง",
  },
  {
    src: slide2,
    alt: "แบนเนอร์โปรโมชั่นของ AMBPLUS ข้อความ สมาชิกใหม่ รับโบนัส 50% สมัครวันนี้ รับสิทธิ์ทันที โบนัสต้อนรับสำหรับผู้เล่นใหม่ และปุ่ม รับโปรเลย พร้อมนางแบบชุดดำทอง ไพ่โป๊กเกอร์ ตู้สล็อต 777 เหรียญและชิปสีทอง",
  },
  {
    src: slide3,
    alt: "แบนเนอร์โปรโมชั่นของ AMBPLUS ข้อความ ฝากแรกของวัน รับเพิ่ม 20% คุ้มตั้งแต่ฝากแรก ฝากง่าย ถอนเร็ว ระบบออโต้ และปุ่ม ฝากเลย พร้อมนางแบบชุดดำทอง ตู้สล็อต 777 วงล้อรูเล็ต ไพ่โป๊กเกอร์ เหรียญและชิปสีทอง",
  },
  {
    src: slide4,
    alt: "แบนเนอร์โปรโมชั่นของ AMBPLUS ข้อความ คืนยอดเสียทุกวัน 0.8% เล่นต่อได้ทุกวัน คืนยอดเสียคุ้มค่า ไม่พลาดทุกความสนุก และปุ่ม รับสิทธิ์ พร้อมนางแบบชุดดำทอง ไพ่โป๊กเกอร์ ตู้สล็อต 777 วงล้อรูเล็ต เหรียญและชิปสีทอง",
  },
];

const COPIES = 3;
const slides = Array.from({ length: COPIES }, () => images).flat();
---

<div class="marquee mx-auto w-full max-w-[1301px] overflow-hidden px-4 py-5">
  <input id="carousel-pause" type="checkbox" class="peer sr-only" />
  <label
    for="carousel-pause"
    class="sr-only cursor-pointer peer-focus-visible:not-sr-only peer-focus-visible:mb-3 peer-focus-visible:inline-block peer-focus-visible:rounded-full peer-focus-visible:border peer-focus-visible:border-[#ecd48c]/60 peer-focus-visible:px-4 peer-focus-visible:py-2 peer-focus-visible:text-sm peer-focus-visible:font-bold peer-focus-visible:text-[#fbf2c4]">
    หยุด / เล่นสไลด์ภาพ
  </label>

  <div class="marquee-track flex">
    {
      slides.map((slide, index) => {
        const isDuplicate = index >= images.length;
        return (
          <div class="marquee-slide" aria-hidden={isDuplicate ? "true" : undefined}>
            <Picture
              src={slide.src}
              alt={isDuplicate ? "" : slide.alt}
              class="block w-full rounded-xl border border-[#ecd48c]/35 object-cover shadow-[0_10px_30px_rgba(236,212,140,0.22)]"
              width={slide.src.width}
              height={slide.src.height}
              loading="lazy"
              fetchpriority="low"
              decoding="async"
              widths={[200, 400, 600]}
              sizes="(max-width: 768px) 50vw, 33vw"
              formats={["avif", "webp"]}
              fallbackFormat="webp"
              quality={60}
            />
          </div>
        );
      })
    }
  </div>
</div>

<style>
  .marquee {
    --gap: 12px;
    --per-view: 2;
    --shift: calc(-200% - 24px);
  }

  @media (min-width: 768px) {
    .marquee {
      --gap: 16px;
      --per-view: 3;
      --shift: calc(-133.3333% - 21.3333px);
    }
  }

  .marquee-track {
    gap: var(--gap);
    width: 100%;
    animation: carousel-scroll 32s linear infinite;
    will-change: transform;
  }

  .marquee-slide {
    flex: 0 0 calc((100% - (var(--per-view) - 1) * var(--gap)) / var(--per-view));
  }

  @keyframes carousel-scroll {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(var(--shift));
    }
  }

  .marquee:hover .marquee-track,
  .marquee:focus-within .marquee-track,
  .marquee > input:checked ~ .marquee-track {
    animation-play-state: paused;
  }

  @media (prefers-reduced-motion: reduce) {
    .marquee-track {
      animation: none;
    }
  }
</style>
