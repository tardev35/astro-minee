---
import { Picture } from "astro:assets";

import slide1 from "../assets/slide1.png";
import slide2 from "../assets/slide2.png";
import slide3 from "../assets/slide3.png";
import slide4 from "../assets/slide4.png";

// Each alt is the text actually printed on that slide, read off the artwork,
// plus the scene it sits in. All four share the MAX56 wordmark (MAX in white on
// black, 56 in dark red on white) beside a white 3D elephant mascot, above a
// model in a red-and-white outfit printed MAX56, in a crimson casino hall with
// gold coins and red-and-white casino chips.
const images = [
  {
    src: slide1,
    alt: "แบนเนอร์โปรโมชั่น MAX56 ข้อความ สมาชิกใหม่ รับโบนัส 50% สมัครวันนี้ รับสิทธิ์ทันที โบนัสต้อนรับสำหรับผู้เล่นใหม่ และปุ่มสีแดง รับโปรเลย พร้อมโลโก้ MAX56 ช้างเผือกสามมิติสวมสายสะพาย ผู้หญิงในชุดเดรสสีแดง-ขาวพิมพ์ MAX56 ชี้นิ้วขึ้น วงล้อสล็อตเลข 777 และคำว่า BAR เหรียญทองปั๊มโลโก้ MAX56 กล่องของขวัญผูกโบว์แดง และแถบข้อความ ปลอดภัยมั่นใจ 100% ฝาก-ถอนเร็วภายใน 10 วินาที บริการ 24 ชม. ในห้องคาสิโนโทนแดงเข้ม",
  },
  {
    src: slide2,
    alt: "แบนเนอร์โปรโมชั่น MAX56 ข้อความ ฝากครั้งแรก รับเพิ่ม 20% พร้อมป้าย คุ้มตั้งแต่ฝากแรก ฝากง่าย ถอนเร็ว ระบบออโต้ และปุ่มสีแดง ฝากเลย พร้อมโลโก้ MAX56 ช้างเผือกสามมิติ ผู้หญิงในชุดกีฬาสีแดง-ขาวพิมพ์ MAX56 ชี้นิ้วขึ้น วงล้อสล็อตเลข 77 ป้าย BONUS และคำว่า BAR เหรียญทองปลิว ชิปคาสิโนสีแดง-ขาว-ดำ และกล่องของขวัญผูกโบว์แดงบนพื้นหลังคาสิโนโทนแดงเข้ม",
  },
  {
    src: slide3,
    alt: "แบนเนอร์โปรโมชั่น MAX56 ข้อความ แนะนำเพื่อน รับค่าคอม 10% ชวนเพื่อน ยิ่งชวนยิ่งคุ้ม รับค่าคอมง่าย และปุ่มสีแดง ชวนเลย พร้อมโลโก้ MAX56 ช้างเผือกสามมิติ ผู้หญิงในชุดเดรสสีแดงถือโทรศัพท์ที่แสดงหน้าจอ ชวนเพื่อน รับค่าคอม 10% วงล้อรูเล็ต ไพ่เอซโพแดง ชิปคาสิโนสีแดง-ขาว และเหรียญทองบนพื้นหลังคาสิโนโทนแดงเข้ม",
  },
  {
    src: slide4,
    alt: "แบนเนอร์โปรโมชั่น MAX56 ข้อความ คืนยอดเสีย 0.8% ทุกวัน เล่นต่อได้ทุกวัน คืนยอดเสียคุ้มค่า ไม่พลาดทุกความสนุก และปุ่มสีแดง รับสิทธิ์ พร้อมโลโก้ MAX56 ช้างเผือกสามมิติ ผู้หญิงในชุดครอปและกระโปรงสีแดง-ขาวพิมพ์ MAX56 ชี้นิ้วขึ้น วงล้อสล็อตเลข 777 สีทอง เหรียญทองและชิปคาสิโน หน้าตู้สล็อตไฟประดับในห้องคาสิโนโทนแดงเข้ม",
  },
];

const COPIES = 3;
const slides = Array.from({ length: COPIES }, () => images).flat();
---

<div class="marquee mx-auto w-full max-w-[1301px] overflow-hidden px-4 py-5">
  <input id="carousel-pause" type="checkbox" class="peer sr-only" />
  <label
    for="carousel-pause"
    class="sr-only cursor-pointer peer-focus-visible:not-sr-only peer-focus-visible:mb-3 peer-focus-visible:inline-block peer-focus-visible:rounded-full peer-focus-visible:border peer-focus-visible:border-[#c10d1e]/60 peer-focus-visible:px-4 peer-focus-visible:py-2 peer-focus-visible:text-sm peer-focus-visible:font-bold peer-focus-visible:text-[#ff5a66]">
    หยุด / เล่นสไลด์ภาพ
  </label>

  <div class="marquee-track flex">
    {
      slides.map((slide, index) => {
        const isDuplicate = index >= images.length;
        return (
          <div class="marquee-slide" aria-hidden={isDuplicate ? "true" : undefined}>
            <Picture
              src={slide.src}
              alt={isDuplicate ? "" : slide.alt}
              class="block w-full rounded-xl border border-[#c10d1e]/40 object-cover shadow-[0_10px_30px_rgba(232,32,47,0.25)]"
              width={slide.src.width}
              height={slide.src.height}
              loading="lazy"
              fetchpriority="low"
              decoding="async"
              widths={[200, 400, 600]}
              sizes="(max-width: 768px) 50vw, 33vw"
              formats={["avif", "webp"]}
              fallbackFormat="webp"
              quality={60}
            />
          </div>
        );
      })
    }
  </div>
</div>

<style>
  .marquee {
    --gap: 12px;
    --per-view: 2;
    --shift: calc(-200% - 24px);
  }

  @media (min-width: 768px) {
    .marquee {
      --gap: 16px;
      --per-view: 3;
      --shift: calc(-133.3333% - 21.3333px);
    }
  }

  .marquee-track {
    gap: var(--gap);
    width: 100%;
    animation: carousel-scroll 32s linear infinite;
    will-change: transform;
  }

  .marquee-slide {
    flex: 0 0 calc((100% - (var(--per-view) - 1) * var(--gap)) / var(--per-view));
  }

  @keyframes carousel-scroll {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(var(--shift));
    }
  }

  .marquee:hover .marquee-track,
  .marquee:focus-within .marquee-track,
  .marquee > input:checked ~ .marquee-track {
    animation-play-state: paused;
  }

  @media (prefers-reduced-motion: reduce) {
    .marquee-track {
      animation: none;
    }
  }
</style>
