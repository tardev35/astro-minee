---
import { Picture } from "astro:assets";

import slide1 from "../assets/slide1.png";
import slide2 from "../assets/slide2.png";
import slide3 from "../assets/slide3.png";
import slide4 from "../assets/slide4.png";

// Each alt is the text actually printed on that slide, read off the artwork,
// plus the scene it sits in. All four share the BMK289 wordmark (ตัวอักษรโครม
// สีฟ้า-ขาว BMK289 เหนือบรรทัด BMK289.COM FUTURE GAME AND SPORTS) beside a model
// in a blue-and-white outfit printed BMK289, in a neon-blue casino hall with
// gold coins and blue casino chips.
const images = [
  {
    src: slide1,
    alt: "แบนเนอร์โปรโมชั่น BMK289 ข้อความ แนะนำเพื่อน รับค่าคอม 10% ชวนเพื่อน ยิ่งชวนยิ่งคุ้ม พร้อมแผนภาพสามขั้นตอน 1 ส่งลิงก์ 2 เพื่อนสมัคร 3 รับค่าคอม และปุ่ม ชวนเลย พร้อมโลโก้ BMK289 ตัวอักษรโครมสีฟ้า-ขาวเหนือบรรทัด BMK289.COM FUTURE GAME AND SPORTS ผู้หญิงในชุดครอปและกระโปรงสีน้ำเงิน-ขาวพิมพ์ BMK289 ชี้นิ้ว ป้าย JACKPOT 1,286,000.00 วงล้อสล็อตเลข 777 ไพ่โพดำ ชิปคาสิโนสีน้ำเงิน กองเหรียญทอง และแถบข้อความ มั่นคง ปลอดภัย ระบบเสถียร บริการตลอด 24 ชม. ในห้องคาสิโนโทนน้ำเงินนีออน",
  },
  {
    src: slide2,
    alt: "แบนเนอร์โปรโมชั่น BMK289 ข้อความ ฝากครั้งแรก รับเพิ่ม 20% คุ้มตั้งแต่ฝากแรก พร้อมไอคอนสามช่อง ฝากง่าย ถอนเร็ว ระบบออโต้ และปุ่ม ฝากเลย พร้อมโลโก้ BMK289 ตัวอักษรโครมสีฟ้า-ขาวเหนือบรรทัด BMK289.COM FUTURE GAME AND SPORTS ผู้หญิงในชุดครอปและกระโปรงสีน้ำเงิน-ขาวพิมพ์ BMK289 ชี้นิ้วขึ้น ป้าย JACKPOT 1,286,000.00 ตู้สล็อตสัญลักษณ์ BAR และเลข 7 ไพ่เอซ และกองเหรียญทองในห้องคาสิโนโทนน้ำเงินนีออน",
  },
  {
    src: slide3,
    alt: "แบนเนอร์โปรโมชั่น BMK289 ข้อความ เว็บตรงแตกง่าย คืนยอดเสีย 0.8% ทุกวัน เล่นต่อได้ทุกวัน คุ้มค่าทุกความสนุก พร้อมป้าย โบนัสคุ้ม ระบบเสถียร บริการ 24 ชม. และปุ่ม รับสิทธิ์ พร้อมโลโก้ BMK289 ตัวอักษรโครมสีฟ้า-ขาวเหนือบรรทัด BMK289.COM FUTURE GAME AND SPORTS ผู้หญิงในชุดครอปและกางเกงสีน้ำเงิน-ขาวพิมพ์ BMK289 ชี้นิ้วไปทางข้อความ ตู้สล็อตสัญลักษณ์ BAR ไพ่เอซ ชิปคาสิโนสีน้ำเงิน และกองเหรียญทองในห้องคาสิโนโทนน้ำเงินนีออน",
  },
  {
    src: slide4,
    alt: "แบนเนอร์โปรโมชั่น BMK289 ข้อความ สมาชิกใหม่ รับโบนัส 50% สมัครวันนี้ รับสิทธิ์ทันที โบนัสต้อนรับสำหรับผู้เล่นใหม่ และปุ่ม รับโปรเลย พร้อมโลโก้ BMK289 ตัวอักษรโครมสีฟ้า-ขาวเหนือบรรทัด BMK289.COM FUTURE GAME AND SPORTS ผู้หญิงในชุดครอปและกางเกงสีน้ำเงิน-ขาวพิมพ์ BMK289 กำหมัดและชี้นิ้ว ป้าย JACKPOT 1,286,000.00 ตู้สล็อตสัญลักษณ์ BAR และเลข 7 ไพ่เอซ และกองเหรียญทองในห้องคาสิโนโทนน้ำเงินนีออน",
  },
];

const COPIES = 3;
const slides = Array.from({ length: COPIES }, () => images).flat();
---

<div class="marquee mx-auto w-full max-w-[1301px] overflow-hidden px-4 py-5">
  <input id="carousel-pause" type="checkbox" class="peer sr-only" />
  <label
    for="carousel-pause"
    class="sr-only cursor-pointer peer-focus-visible:not-sr-only peer-focus-visible:mb-3 peer-focus-visible:inline-block peer-focus-visible:rounded-full peer-focus-visible:border peer-focus-visible:border-[#2b8cff]/60 peer-focus-visible:px-4 peer-focus-visible:py-2 peer-focus-visible:text-sm peer-focus-visible:font-bold peer-focus-visible:text-[#9dcef0]">
    หยุด / เล่นสไลด์ภาพ
  </label>

  <div class="marquee-track flex">
    {
      slides.map((slide, index) => {
        const isDuplicate = index >= images.length;
        return (
          <div class="marquee-slide" aria-hidden={isDuplicate ? "true" : undefined}>
            <Picture
              src={slide.src}
              alt={isDuplicate ? "" : slide.alt}
              class="block w-full rounded-xl border border-[#2b8cff]/45 object-cover shadow-[0_10px_30px_rgba(43,140,255,0.25)]"
              width={slide.src.width}
              height={slide.src.height}
              loading="lazy"
              fetchpriority="low"
              decoding="async"
              widths={[200, 400, 600]}
              sizes="(max-width: 768px) 50vw, 33vw"
              formats={["avif", "webp"]}
              fallbackFormat="webp"
              quality={60}
            />
          </div>
        );
      })
    }
  </div>
</div>

<style>
  .marquee {
    --gap: 12px;
    --per-view: 2;
    --shift: calc(-200% - 24px);
  }

  @media (min-width: 768px) {
    .marquee {
      --gap: 16px;
      --per-view: 3;
      --shift: calc(-133.3333% - 21.3333px);
    }
  }

  .marquee-track {
    gap: var(--gap);
    width: 100%;
    animation: carousel-scroll 32s linear infinite;
    will-change: transform;
  }

  .marquee-slide {
    flex: 0 0 calc((100% - (var(--per-view) - 1) * var(--gap)) / var(--per-view));
  }

  @keyframes carousel-scroll {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(var(--shift));
    }
  }

  .marquee:hover .marquee-track,
  .marquee:focus-within .marquee-track,
  .marquee > input:checked ~ .marquee-track {
    animation-play-state: paused;
  }

  @media (prefers-reduced-motion: reduce) {
    .marquee-track {
      animation: none;
    }
  }
</style>
