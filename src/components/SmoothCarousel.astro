---
import { Picture } from "astro:assets";

import slide1 from "../assets/slide1.png";
import slide2 from "../assets/slide2.png";
import slide3 from "../assets/slide3.png";
import slide4 from "../assets/slide4.png";

// Each alt is the text actually printed on that slide, read off the artwork,
// plus the scene it sits in. All four share the DIAMOND789 look: the Diamond789
// wordmark in brushed silver with a hot-pink D and 789 beside a cut white
// diamond, the line GAME CASIO ONLINE AND SPORT BETTING under it, a model in a
// black-and-pink Diamond789 outfit, a roulette wheel, casino chips marked 789,
// gold coins, and pink and white gems on a black background.
//
// This is a pure-CSS marquee — no Swiper, no JavaScript at all. It duplicates
// the four images three times so the loop has no seam; the duplicate copies are
// alt="" + aria-hidden so a screen reader hears each promotion once.
const images = [
  {
    src: slide1,
    alt: "แบนเนอร์โปรโมชั่น DIAMOND789 ข้อความ Diamond789 สีเงินเงา และบรรทัดล่างเขียนว่า ภารกิจประจำวัน สีชมพูบานเย็น ใต้ลงมาเป็นแถบสีดำเขียนว่า ทำครบ 3 ภารกิจ และ รับกล่องสุ่ม 79 บาท ถัดลงมาเป็นรายการภารกิจสามข้อเรียงลงมา ล็อกอิน ฝากเงิน และ หมุนเกม แต่ละข้อมีไอคอนอยู่หน้าและเครื่องหมายถูกในกรอบอยู่ท้าย ข้างขวาเป็นวงกลมขอบชมพูเขียนเลข 79 ตัวใหญ่และคำว่า บาท ถัดขึ้นไปเป็นกล่องของขวัญสีชมพูผูกโบว์ ด้านล่างเป็นปุ่มสีชมพูบานเย็นเขียนว่า รับภารกิจ ขนาบด้วยรูปเพชร ด้านบนเป็นโลโก้ Diamond789 ตัวอักษรสีเงินสลับชมพู มีเพชรเจียระไนสีขาวอยู่ข้างหน้า ใต้โลโก้เขียนว่า GAME CASIO ONLINE AND SPORT BETTING ด้านซ้ายเป็นผู้หญิงในชุดสีดำสลับชมพูติดโลโก้ Diamond789 ข้างหลังเป็นวงล้อรูเล็ต ชิปคาสิโนมีเลข 789 ไพ่เอซ และเพชรสีชมพูกับสีขาวกระจายอยู่ ด้านล่างสุดเป็นแถบสี่ช่องเขียนว่า มั่นคง ปลอดภัย ข้อมูลส่วนตัวปลอดภัย บริการรวดเร็ว และ จ่ายจริง การันตี บนพื้นหลังสีดำ",
  },
  {
    src: slide2,
    alt: "แบนเนอร์โปรโมชั่น DIAMOND789 ข้อความ Diamond789 สีเงินเงา และบรรทัดล่างเขียนว่า ชวนเพื่อนรับเพิ่ม สีขาว ใต้ลงมาเป็นแถบสีดำเขียนว่า เพื่อนสมัครสำเร็จ และ รับทันที 89 บาท โดยเลข 89 เป็นตัวใหญ่สีขาว ถัดลงมาเป็นแผงสามขั้นตอนเรียงจากซ้ายไปขวา หมายเลข 1 ไอคอนคนสองคนเขียนว่า ชวนเพื่อน มีลูกศรชี้ไปยังหมายเลข 2 ไอคอนกระดานที่มีเครื่องหมายถูกเขียนว่า สมัครสำเร็จ แล้วลูกศรชี้ต่อไปยังหมายเลข 3 ไอคอนกล่องของขวัญเขียนว่า รับโบนัส ถัดลงมาเป็นแถบเขียนว่า รับสิทธิ์ง่าย โบนัสเข้าไว ขนาบด้วยรูปเพชร และปุ่มสีขาวขอบชมพูเขียนว่า ชวนเลย ด้านบนเป็นโลโก้ Diamond789 ตัวอักษรสีเงินสลับชมพู มีเพชรเจียระไนสีขาวอยู่ข้างหน้า ใต้โลโก้เขียนว่า GAME CASIO ONLINE AND SPORT BETTING ข้างขวาเป็นผู้หญิงในชุดสีดำสลับชมพูติดโลโก้ Diamond789 ถือโทรศัพท์ที่เปิดหน้าแอป Diamond789 แล้วชี้นิ้วมาที่หน้าจอ ด้านหลังเป็นวงล้อรูเล็ต ไพ่เอซ ลูกเต๋า ชิปคาสิโนมีเลข 789 กองเหรียญทอง และเพชรสีชมพูกับสีขาว ด้านล่างสุดเป็นแถบสี่ช่องเขียนว่า มั่นคง ปลอดภัย ข้อมูลส่วนตัวปลอดภัย บริการรวดเร็ว และ จ่ายจริง การันตี บนพื้นหลังสีดำ",
  },
  {
    src: slide3,
    alt: "แบนเนอร์โปรโมชั่น DIAMOND789 ข้อความ Diamond789 สีเงินเงา และบรรทัดล่างเขียนว่า Lucky Hour สีชมพูบานเย็นตัวใหญ่ ใต้ลงมาเป็นกรอบสีดำเขียนช่วงเวลา 20:00 - 21:00 ถัดลงมาเป็นแถบเขียนว่า เปิดหีบลับ ลุ้นรับ และ 29 / 79 / 179 เครดิต ถัดมาเป็นบรรทัดที่มีไอคอนนาฬิกาเขียนว่า ร่วมสนุกเฉพาะช่วงเวลาที่กำหนด และปุ่มสีขาวขอบชมพูเขียนว่า เปิดเลย ด้านขวาเป็นหีบสมบัติเปิดฝาที่มีเหรียญทองและเพชรสีชมพูล้นออกมาพร้อมลำแสงสว่าง ด้านบนเป็นโลโก้ Diamond789 ตัวอักษรสีเงินสลับชมพู มีเพชรเจียระไนสีขาวอยู่ข้างหน้า ใต้โลโก้เขียนว่า GAME CASIO ONLINE AND SPORT BETTING ด้านซ้ายเป็นผู้หญิงในชุดสีดำสลับชมพูติดโลโก้ Diamond789 ยกมือทั้งสองข้างขึ้นแนบแก้มทำท่าตื่นเต้น ด้านหลังเป็นวงล้อรูเล็ต ชิปคาสิโนมีเลข 789 ไพ่เอซ เหรียญทอง และเพชรสีชมพูกับสีขาวกระจายอยู่บนพื้นหลังสีดำ",
  },
  {
    src: slide4,
    alt: "แบนเนอร์โปรโมชั่น DIAMOND789 ข้อความ Diamond789 สีเงินเงา และบรรทัดล่างเขียนว่า วงล้อเพชรแตก สีชมพูบานเย็น ใต้ลงมาเป็นแถบสีดำเขียนว่า ฝากครบ 300 รับสิทธิ์หมุน 1 ครั้ง ด้านขวาเป็นวงล้อเสี่ยงโชคขอบไฟชมพูแบ่งเป็นช่อง ช่องบนซ้ายเขียน 39 เครดิต ช่องบนขวาเขียน 89 เครดิต ช่องขวาเขียน 189 เครดิต สลับกับช่องที่มีไอคอนกล่องของขวัญเขียนว่า ของรางวัล และช่องที่เขียนว่า หมุนฟรี กลางวงล้อเป็นเพชรสีชมพู และมีหัวลูกศรรูปเพชรชี้ลงอยู่ด้านบน ใต้วงล้อเป็นบรรทัดเขียนว่า ลุ้นได้ทุกวันตามเงื่อนไข และปุ่มสีขาวขอบชมพูเขียนว่า หมุนเลย ด้านบนเป็นโลโก้ Diamond789 ตัวอักษรสีเงินสลับชมพู มีเพชรเจียระไนสีขาวอยู่ข้างหน้า ใต้โลโก้เขียนว่า GAME CASIO ONLINE AND SPORT BETTING ด้านซ้ายเป็นผู้หญิงในชุดสีดำสลับชมพูติดโลโก้ Diamond789 ชี้นิ้วไปที่วงล้อ ด้านหลังเป็นชิปคาสิโนมีเลข 789 กองเหรียญทอง และเพชรสีชมพูกับสีขาวกระจายอยู่บนพื้นหลังสีดำ",
  },
];

const COPIES = 3;
const slides = Array.from({ length: COPIES }, () => images).flat();
---

<div class="marquee mx-auto w-full max-w-[1301px] overflow-hidden px-4 py-5">
  <input id="carousel-pause" type="checkbox" class="peer sr-only" />
  <label
    for="carousel-pause"
    class="sr-only cursor-pointer peer-focus-visible:not-sr-only peer-focus-visible:mb-3 peer-focus-visible:inline-block peer-focus-visible:rounded-full peer-focus-visible:border peer-focus-visible:border-[#f30d8c]/60 peer-focus-visible:px-4 peer-focus-visible:py-2 peer-focus-visible:text-sm peer-focus-visible:font-bold peer-focus-visible:text-[#ff5cb8]">
    หยุด / เล่นสไลด์ภาพ
  </label>

  <div class="marquee-track flex">
    {
      slides.map((slide, index) => {
        const isDuplicate = index >= images.length;
        return (
          <div class="marquee-slide" aria-hidden={isDuplicate ? "true" : undefined}>
            <Picture
              src={slide.src}
              alt={isDuplicate ? "" : slide.alt}
              class="block w-full rounded-xl border border-[#f30d8c]/50 object-cover shadow-[0_10px_30px_rgba(243,13,140,0.25)]"
              width={slide.src.width}
              height={slide.src.height}
              loading="lazy"
              fetchpriority="low"
              decoding="async"
              widths={[200, 400, 600]}
              sizes="(max-width: 768px) 50vw, 33vw"
              formats={["avif", "webp"]}
              fallbackFormat="webp"
              quality={60}
            />
          </div>
        );
      })
    }
  </div>
</div>

<style>
  .marquee {
    --gap: 12px;
    --per-view: 2;
    --shift: calc(-200% - 24px);
  }

  @media (min-width: 768px) {
    .marquee {
      --gap: 16px;
      --per-view: 3;
      --shift: calc(-133.3333% - 21.3333px);
    }
  }

  .marquee-track {
    gap: var(--gap);
    width: 100%;
    animation: carousel-scroll 32s linear infinite;
    will-change: transform;
  }

  .marquee-slide {
    flex: 0 0 calc((100% - (var(--per-view) - 1) * var(--gap)) / var(--per-view));
  }

  @keyframes carousel-scroll {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(var(--shift));
    }
  }

  .marquee:hover .marquee-track,
  .marquee:focus-within .marquee-track,
  .marquee > input:checked ~ .marquee-track {
    animation-play-state: paused;
  }

  @media (prefers-reduced-motion: reduce) {
    .marquee-track {
      animation: none;
    }
  }
</style>
