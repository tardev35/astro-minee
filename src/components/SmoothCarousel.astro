---
import { Picture } from "astro:assets";

import slide1 from "../assets/slide1.png";
import slide2 from "../assets/slide2.png";
import slide3 from "../assets/slide3.png";
import slide4 from "../assets/slide4.png";

// Each alt is the text actually printed on that slide, read off the artwork,
// plus the scene it sits in. All four share the JERRY69 look: the bubbly
// wordmark with white "JERRY" in a heavy black outline and an orange-to-gold
// "69", a model in a black outfit with orange trim, gold coins and chips
// stamped JERRY, gift boxes and slot reels on a near-black ground.
//
// This is a pure-CSS marquee — no Swiper, no JavaScript at all. It duplicates
// the four images three times so the loop has no seam; the duplicate copies are
// alt="" + aria-hidden so a screen reader hears each promotion once.
const images = [
  {
    src: slide1,
    alt: "แบนเนอร์โปรโมชั่น JERRY69 หัวข้อสีส้มทองเขียนว่า ภารกิจรายวัน บรรทัดถัดมาเขียนว่า ทำครบ 3 ภารกิจ รับสุ่ม ใต้ลงมาเป็นตัวเลขสีส้มทองขนาดใหญ่ 29 / 69 / 169 เหนือคำว่า เครดิต ถัดลงมาเป็นสี่ขั้นตอนที่มีเลขกำกับและลูกศรเชื่อมกัน หนึ่ง ล็อกอิน พร้อมไอคอนคนติดเครื่องหมายถูก สอง ฝากเงิน พร้อมไอคอนกระเป๋าเงินกับเหรียญ สาม หมุนเกม พร้อมไอคอนตู้สล็อต 777 และ สี่ รับรางวัล พร้อมไอคอนกล่องของขวัญ ด้านล่างเป็นปุ่มวงรีสีส้มทองเขียนว่า รับภารกิจ ด้านซ้ายเป็นผู้หญิงในชุดสีดำขลิบส้มติดโลโก้ JERRY69 ชูสามนิ้วและชี้มาที่ข้อความ ด้านบนเป็นโลโก้ JERRY69 ตัวอักษรสีขาวขอบดำกับเลข 69 สีส้มทอง รอบด้านเป็นเหรียญทองสลักคำว่า JERRY กล่องของขวัญ และวงล้อสล็อตบนพื้นหลังสีดำ",
  },
  {
    src: slide2,
    alt: "แบนเนอร์โปรโมชั่น JERRY69 ข้อความสีส้มทองเขียนว่า Lucky Hour พร้อมไอคอนนาฬิกา ใต้ลงมาเป็นกรอบสี่เหลี่ยมเขียนช่วงเวลา 20:00 - 21:00 ถัดมาเป็นบรรทัดสีขาวเขียนว่า เปิดหีบลับ ลุ้นรับ แล้วเป็นตัวเลขสีส้มทองขนาดใหญ่ 39 / 79 / 179 ตามด้วยคำว่า เครดิต ด้านขวาเป็นหีบสมบัติสีทองเปิดฝาที่มีลำแสงพุ่งออกมาพร้อมอัญมณีสีแดง ฟ้า และขาว ถัดลงมาเป็นวงล้อรูเล็ตทางซ้ายและไพ่เอซสี่ใบทางขวา ตรงกลางด้านล่างเป็นปุ่มวงรีสีส้มทองเขียนว่า เปิดเลย ด้านซ้ายเป็นผู้หญิงในชุดสีดำขลิบส้มติดโลโก้ JERRY69 ยกมือขึ้นทั้งสองข้าง ด้านบนเป็นโลโก้ JERRY69 ตัวอักษรสีขาวขอบดำกับเลข 69 สีส้มทอง รอบด้านเป็นเหรียญทองและชิปสลักคำว่า JERRY บนพื้นหลังสีดำ",
  },
  {
    src: slide3,
    alt: "แบนเนอร์โปรโมชั่น JERRY69 ในกรอบเส้นสีส้มเขียนว่า เช็กอิน 7 วัน บรรทัดถัดมาเป็นตัวอักษรสีส้มทองขนาดใหญ่เขียนว่า รับฟรีทุกวัน ถัดลงมาเป็นป้ายเขียนว่า สูงสุด คู่กับตัวเลข 88 ขนาดใหญ่มากและคำว่า เครดิต ใต้ลงมาเป็นไทล์เจ็ดช่องเรียงกันเขียนว่า วันที่ 1 ถึง วันที่ 7 ทุกช่องติดเครื่องหมายถูกสีทอง ด้านล่างเป็นปุ่มวงรีสีส้มทองเขียนว่า เช็กอินเลย และแถวข้อความสามรายการ สมัครไว ระบบลื่น รองรับมือถือ ด้านขวาเป็นผู้หญิงในชุดสีดำขลิบส้มติดโลโก้ JERRY69 มุมขวาบนเป็นตู้สล็อตเขียนว่า JACKPOT รอบด้านเป็นกล่องของขวัญผูกโบว์ทอง เหรียญทอง และชิปสลักคำว่า JERRY บนพื้นหลังสีดำ",
  },
  {
    src: slide4,
    alt: "แบนเนอร์โปรโมชั่น JERRY69 หัวข้อสีส้มทองเขียนว่า วงล้อโชคดี ด้านขวาเป็นวงล้อเสี่ยงโชคสีส้มสลับดำที่มีหลอดไฟล้อมรอบขอบและหัวลูกศรสีแดงชี้ลงอยู่ด้านบน ช่องต่าง ๆ เขียนว่า 69 เครดิต 169 เครดิต 269 เครดิต และช่องที่มีไอคอนกล่องของขวัญเขียนว่า ของรางวัล ด้านซ้ายเขียนว่า ฝากครบ คู่กับตัวเลข 300 ขนาดใหญ่ และบรรทัดเขียนว่า หมุนฟรี 1 ครั้ง ด้านล่างเป็นปุ่มวงรีสีส้มทองเขียนว่า หมุนเลย ถัดไปทางซ้ายเป็นผู้หญิงในชุดสีดำขลิบส้มติดโลโก้ JERRY69 ชี้นิ้วไปที่วงล้อ ด้านบนเป็นโลโก้ JERRY69 ตัวอักษรสีขาวขอบดำกับเลข 69 สีส้มทอง รอบด้านเป็นเพชร กล่องของขวัญ และเหรียญทองบนพื้นหลังสีดำ",
  },
];

const COPIES = 3;
const slides = Array.from({ length: COPIES }, () => images).flat();
---

<div class="marquee mx-auto w-full max-w-[1301px] overflow-hidden px-4 py-5">
  <input id="carousel-pause" type="checkbox" class="peer sr-only" />
  <label
    for="carousel-pause"
    class="sr-only cursor-pointer peer-focus-visible:not-sr-only peer-focus-visible:mb-3 peer-focus-visible:inline-block peer-focus-visible:rounded-full peer-focus-visible:border peer-focus-visible:border-[#fa8302]/60 peer-focus-visible:px-4 peer-focus-visible:py-2 peer-focus-visible:text-sm peer-focus-visible:font-bold peer-focus-visible:text-[#ffc94a]">
    หยุด / เล่นสไลด์ภาพ
  </label>

  <div class="marquee-track flex">
    {
      slides.map((slide, index) => {
        const isDuplicate = index >= images.length;
        return (
          <div class="marquee-slide" aria-hidden={isDuplicate ? "true" : undefined}>
            <Picture
              src={slide.src}
              alt={isDuplicate ? "" : slide.alt}
              class="block w-full rounded-xl border border-[#fa8302]/50 object-cover shadow-[0_10px_30px_rgba(250,131,2,0.25)]"
              width={slide.src.width}
              height={slide.src.height}
              loading="lazy"
              fetchpriority="low"
              decoding="async"
              widths={[200, 400, 600]}
              sizes="(max-width: 768px) 50vw, 33vw"
              formats={["avif", "webp"]}
              fallbackFormat="webp"
              quality={60}
            />
          </div>
        );
      })
    }
  </div>
</div>

<style>
  .marquee {
    --gap: 12px;
    --per-view: 2;
    --shift: calc(-200% - 24px);
  }

  @media (min-width: 768px) {
    .marquee {
      --gap: 16px;
      --per-view: 3;
      --shift: calc(-133.3333% - 21.3333px);
    }
  }

  .marquee-track {
    gap: var(--gap);
    width: 100%;
    animation: carousel-scroll 32s linear infinite;
    will-change: transform;
  }

  .marquee-slide {
    flex: 0 0 calc((100% - (var(--per-view) - 1) * var(--gap)) / var(--per-view));
  }

  @keyframes carousel-scroll {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(var(--shift));
    }
  }

  .marquee:hover .marquee-track,
  .marquee:focus-within .marquee-track,
  .marquee > input:checked ~ .marquee-track {
    animation-play-state: paused;
  }

  @media (prefers-reduced-motion: reduce) {
    .marquee-track {
      animation: none;
    }
  }
</style>
