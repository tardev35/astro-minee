---
import { Picture } from "astro:assets";

import slide1 from "../assets/slide1.png";
import slide2 from "../assets/slide2.png";
import slide3 from "../assets/slide3.png";
import slide4 from "../assets/slide4.png";

// Each alt is the Thai promotional text actually printed on that slide, read off
// the artwork, plus the scene it sits in. All four share the JAIDEEJING look:
// gold on deep red, a gold dragon coiled around a coin emblem, Thai government
// lottery tickets, gold lotto balls, gold coins and red silk.
//
// The wordmark baked into these files is written as "โลโก้เว็บไซต์" rather than
// transcribed: alt text is for describing the picture, not for repeating a
// logotype a reader cannot act on.
//
// This is a pure-CSS marquee — no Swiper, no JavaScript at all. It duplicates
// the four images three times so the loop has no seam; the duplicate copies are
// alt="" + aria-hidden so a screen reader hears each promotion once.
const images = [
  {
    src: slide1,
    alt: "แบนเนอร์โปรโมชั่นโทนแดงทอง มุมบนซ้ายเป็นโลโก้เว็บไซต์รูปมังกรทองพันรอบเหรียญ ข้างกันเป็นป้ายผ้าสีแดงเขียนว่า โชคดีวันนี้ รายได้ที่นี่ มุมบนขวาเขียนว่า เลขดี ชีวิตดีขึ้นทุกงวด หัวข้อตัวหนาสองบรรทัดเขียนว่า เปิดโพยแรก และ รับโบนัส ใต้หัวข้อเป็นแถบเขียนว่า ซื้อหวยครั้งแรก รับเครดิตฟรี โดยเลข 88 เป็นตัวใหญ่สีทอง ถัดลงมาเป็นกรอบเขียนว่า เฉพาะสมาชิกใหม่ ขอบขวาเขียนว่า ลุ้นทุกตัว รวยทุกงวด แถบล่างสุดมีสามช่องเขียนว่า แทงง่าย จ่ายไว และ ใช้งานสะดวก ในภาพเป็นผู้หญิงสวมชุดเลื่อมสีทองยิ้มพร้อมชูสลากกินแบ่งรัฐบาลหนึ่งใบ รอบตัวมีลูกบอลหวยสีทองพิมพ์เลข 6 8 9 และ 5 สลากกินแบ่งรัฐบาลอีกหลายใบ เหรียญทองกองอยู่ และยอดปราสาททองกับผ้าไหมสีแดงเป็นฉากหลัง",
  },
  {
    src: slide2,
    alt: "แบนเนอร์โปรโมชั่นโทนแดงทอง มุมบนซ้ายเป็นโลโก้เว็บไซต์รูปมังกรทองพันรอบเหรียญ ข้างกันเป็นป้ายผ้าสีแดงเขียนว่า โชคดีวันนี้ รายได้ที่นี่ มุมบนขวาเขียนว่า ตัวเลขเปลี่ยนชีวิต เริ่มได้วันนี้ หัวข้อตัวหนาสองบรรทัดเขียนว่า ภารกิจ และ สะสมโพย โดยมีช่องเครื่องหมายถูกสีทองสองช่องอยู่ข้างหัวข้อ ใต้หัวข้อเป็นแถบเขียนว่า ซื้อครบ 5 งวด รับโบนัส โดยเลข 188 เป็นตัวใหญ่สีทอง ถัดลงมาเขียนว่า ยิ่งซื้อ ยิ่งคุ้ม ด้านล่างเป็นแถวขั้นตอนสามช่องพร้อมลูกศรเขียนว่า ซื้อหวย สะสมงวด และ รับโบนัส คู่กับไอคอนรถเข็น เอกสาร และกล่องของขวัญ ในภาพเป็นผู้หญิงชี้นิ้วขึ้นด้านบนและถือสลากกินแบ่งรัฐบาลไว้ในอีกมือ ข้างกันเป็นหีบสมบัติเปิดอยู่ล้นด้วยเหรียญทองและสลากกินแบ่งรัฐบาล รอบภาพมีลูกบอลหวยสีทองพิมพ์เลข 8 9 6 และ 5 กับผ้าไหมสีแดง",
  },
  {
    src: slide3,
    alt: "แบนเนอร์โปรโมชั่นโทนแดงทอง มุมบนซ้ายเป็นโลโก้เว็บไซต์รูปมังกรทองพันรอบเหรียญ ข้างกันเป็นป้ายผ้าสีแดงเขียนว่า โชคดีวันนี้ รายได้ที่นี่ มุมบนขวาเขียนว่า ยิ่งชวน ยิ่งรวย ไปด้วยกัน หัวข้อตัวหนาสองบรรทัดเขียนว่า ชวนเพื่อน และ สายหวย ใต้หัวข้อเป็นแถบเขียนว่า แนะนำเพื่อน รับเพิ่ม โดยเลข 300 เป็นตัวใหญ่สีทอง ถัดลงมาเขียนว่า เพื่อนซื้อสำเร็จ รับโบนัสทันที ด้านล่างเป็นแถวขั้นตอนสามช่องพร้อมลูกศรเขียนว่า แชร์ลิงก์ เพื่อนสมัคร และ รับโบนัส ในภาพเป็นผู้หญิงสวมชุดสีแดงกำลังชี้มือมาข้างหน้าและถือโทรศัพท์ที่หน้าจอเขียนว่า ชวนเพื่อน รับโบนัส พร้อมปุ่ม แชร์เลย รอบภาพมีลูกบอลหวยสีทองพิมพ์เลข 6 9 และ 8 สลากกินแบ่งรัฐบาลหลายใบ เหรียญทอง และยอดปราสาททองเป็นฉากหลัง",
  },
  {
    src: slide4,
    alt: "แบนเนอร์โปรโมชั่นโทนแดงทอง มุมบนซ้ายเป็นโลโก้เว็บไซต์รูปมังกรทองพันรอบเหรียญ ข้างกันเป็นป้ายผ้าสีแดงเขียนว่า โชคดีวันนี้ รายได้ที่นี่ ด้านบนเขียนว่า ทุกตัวเลข มีโอกาสเปลี่ยนชีวิต มุมขวาเขียนว่า เวลา รวย ไม่รอใคร หัวข้อตัวหนาสองบรรทัดเขียนว่า นาทีทอง และ เลขเฮง ใต้หัวข้อเป็นแถบเขียนว่า ช่วงเวลาเฮง ซื้อครบ 500 รับเพิ่ม 20 เปอร์เซ็นต์ ถัดลงมาเขียนว่า เฉพาะช่วงกิจกรรม มุมล่างขวาเขียนว่า เลขใบเดียวอาจเปลี่ยนเป็นล้าน แถบล่างสุดมีสามช่องเขียนว่า ครบเครื่องเรื่องหวย ฝากถอนสะดวก และ ลุ้นได้ทุกวัน ในภาพเป็นผู้หญิงสวมชุดเลื่อมสีดำทองถือสลากกินแบ่งรัฐบาลสองใบ ด้านหลังเป็นหน้าปัดนาฬิกาทองขนาดใหญ่ รอบภาพมีลูกบอลหวยสีทองพิมพ์เลข 9 5 6 และ 8 สลากกินแบ่งรัฐบาลหลายใบ และเหรียญทองกองอยู่",
  },
];

const COPIES = 3;
const slides = Array.from({ length: COPIES }, () => images).flat();
---

<div class="marquee mx-auto w-full max-w-[1301px] overflow-hidden px-4 py-5">
  <input id="carousel-pause" type="checkbox" class="peer sr-only" />
  <label
    for="carousel-pause"
    class="sr-only cursor-pointer peer-focus-visible:not-sr-only peer-focus-visible:mb-3 peer-focus-visible:inline-block peer-focus-visible:rounded-full peer-focus-visible:border peer-focus-visible:border-[#f5c451]/60 peer-focus-visible:px-4 peer-focus-visible:py-2 peer-focus-visible:text-sm peer-focus-visible:font-bold peer-focus-visible:text-[#ffe08a]">
    หยุด / เล่นสไลด์ภาพ
  </label>

  <div class="marquee-track flex">
    {
      slides.map((slide, index) => {
        const isDuplicate = index >= images.length;
        return (
          <div class="marquee-slide" aria-hidden={isDuplicate ? "true" : undefined}>
            <Picture
              src={slide.src}
              alt={isDuplicate ? "" : slide.alt}
              class="block w-full rounded-xl border border-[#f5c451]/50 object-cover shadow-[0_10px_30px_rgba(245,196,81,0.28)]"
              width={slide.src.width}
              height={slide.src.height}
              loading="lazy"
              fetchpriority="low"
              decoding="async"
              widths={[200, 400, 600]}
              sizes="(max-width: 768px) 50vw, 33vw"
              formats={["avif", "webp"]}
              fallbackFormat="webp"
              quality={60}
            />
          </div>
        );
      })
    }
  </div>
</div>

<style>
  .marquee {
    --gap: 12px;
    --per-view: 2;
    --shift: calc(-200% - 24px);
  }

  @media (min-width: 768px) {
    .marquee {
      --gap: 16px;
      --per-view: 3;
      --shift: calc(-133.3333% - 21.3333px);
    }
  }

  .marquee-track {
    gap: var(--gap);
    width: 100%;
    animation: carousel-scroll 32s linear infinite;
    will-change: transform;
  }

  .marquee-slide {
    flex: 0 0 calc((100% - (var(--per-view) - 1) * var(--gap)) / var(--per-view));
  }

  @keyframes carousel-scroll {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(var(--shift));
    }
  }

  .marquee:hover .marquee-track,
  .marquee:focus-within .marquee-track,
  .marquee > input:checked ~ .marquee-track {
    animation-play-state: paused;
  }

  @media (prefers-reduced-motion: reduce) {
    .marquee-track {
      animation: none;
    }
  }
</style>
