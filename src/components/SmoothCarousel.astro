---
import { Picture } from "astro:assets";

import slide1 from "../assets/slide1.png";
import slide2 from "../assets/slide2.png";
import slide3 from "../assets/slide3.png";
import slide4 from "../assets/slide4.png";

// Each alt is the text actually printed on that slide, read off the artwork,
// plus the scene it sits in. All four share the VEGUS1 look: crimson and gold
// on a dark red ground, the Vegus1 wordmark, a JACKPOT 777 slot cabinet, stacks
// of gold coins and red-gold casino chips, playing cards, and a woman in a
// red-gold satin dress.
//
// This is a pure-CSS marquee — no Swiper, no JavaScript at all. It duplicates
// the four images three times so the loop has no seam; the duplicate copies are
// alt="" + aria-hidden so a screen reader hears each promotion once.
const images = [
  {
    src: slide1,
    alt: "แบนเนอร์โปรโมชั่น VEGUS1 ข้อความ สมาชิกใหม่ รับโบนัส 50% สมัครวันนี้ รับสิทธิ์ทันที ใต้ปุ่มเขียนว่า โปรต้อนรับสำหรับสมาชิกใหม่ และปุ่ม รับโปรเลย ด้านซ้ายบนเป็นโลโก้ Vegus1 ภาพผู้หญิงในชุดผ้าซาตินสีแดง-ทองชี้นิ้วไปทางขวา ข้างหลังเป็นตู้สล็อต JACKPOT เลข 777 ไพ่ กองเหรียญทอง และชิปคาสิโนสีแดงบนพื้นหลังสีแดงเข้ม-ทอง",
  },
  {
    src: slide2,
    alt: "แบนเนอร์โปรโมชั่น VEGUS1 ข้อความ ฝากครั้งแรก รับเพิ่ม 20% คุ้มตั้งแต่ฝากแรก ฝาก-ถอนออโต้ รวดเร็ว ปลอดภัย และปุ่ม ฝากเลย ด้านซ้ายบนเป็นโลโก้ Vegus1 ภาพผู้หญิงในชุดผ้าซาตินสีแดง-ทอง ข้างหลังเป็นตู้สล็อต JACKPOT 777 ไพ่เอซ กองเหรียญทอง และชิปคาสิโนสีแดง-ทองบนพื้นหลังสีแดงเข้ม",
  },
  {
    src: slide3,
    alt: "แบนเนอร์โปรโมชั่น VEGUS1 ข้อความ นาทีทอง 21:00 - 23:00 รับเพิ่ม 15% เฉพาะช่วงเวลาที่กำหนด และปุ่ม ร่วมโปรเลย ด้านซ้ายบนเป็นโลโก้ Vegus1 ภาพหน้าปัดนาฬิกาสีทองเลขโรมันขนาดใหญ่ ผู้หญิงในชุดผ้าซาตินสีแดง-ทองยกมือ ตู้สล็อต JACKPOT 777 ชิปคาสิโน Vegus1 และกองเหรียญทองบนพื้นหลังสีแดงเข้ม-ทอง",
  },
  {
    src: slide4,
    alt: "แบนเนอร์โปรโมชั่น VEGUS1 ข้อความ วงล้อโชคดี ลุ้นเครดิตฟรี 888 บาท หมุนฟรีทุกวัน ลุ้นรับทันที และปุ่ม หมุนเลย ด้านซ้ายบนเป็นโลโก้ Vegus1 ภาพวงล้อเสี่ยงโชคสีแดง-ทองแบ่งช่องเป็นเงินรางวัล 500 888 188 288 80 100 50 และ 300 บาท มีคำว่า ลุ้นเลย ตรงดุมวงล้อ ข้างขวาเป็นผู้หญิงในชุดผ้าซาตินสีแดง-ทอง ตู้สล็อต JACKPOT 777 กองเหรียญทองและชิปคาสิโนบนพื้นหลังสีแดงเข้ม",
  },
];

const COPIES = 3;
const slides = Array.from({ length: COPIES }, () => images).flat();
---

<div class="marquee mx-auto w-full max-w-[1301px] overflow-hidden px-4 py-5">
  <input id="carousel-pause" type="checkbox" class="peer sr-only" />
  <label
    for="carousel-pause"
    class="sr-only cursor-pointer peer-focus-visible:not-sr-only peer-focus-visible:mb-3 peer-focus-visible:inline-block peer-focus-visible:rounded-full peer-focus-visible:border peer-focus-visible:border-[#f5c451]/60 peer-focus-visible:px-4 peer-focus-visible:py-2 peer-focus-visible:text-sm peer-focus-visible:font-bold peer-focus-visible:text-[#f5c451]">
    หยุด / เล่นสไลด์ภาพ
  </label>

  <div class="marquee-track flex">
    {
      slides.map((slide, index) => {
        const isDuplicate = index >= images.length;
        return (
          <div class="marquee-slide" aria-hidden={isDuplicate ? "true" : undefined}>
            <Picture
              src={slide.src}
              alt={isDuplicate ? "" : slide.alt}
              class="block w-full rounded-xl border border-[#d81f26]/50 object-cover shadow-[0_10px_30px_rgba(216,31,38,0.28)]"
              width={slide.src.width}
              height={slide.src.height}
              loading="lazy"
              fetchpriority="low"
              decoding="async"
              widths={[200, 400, 600]}
              sizes="(max-width: 768px) 50vw, 33vw"
              formats={["avif", "webp"]}
              fallbackFormat="webp"
              quality={60}
            />
          </div>
        );
      })
    }
  </div>
</div>

<style>
  .marquee {
    --gap: 12px;
    --per-view: 2;
    --shift: calc(-200% - 24px);
  }

  @media (min-width: 768px) {
    .marquee {
      --gap: 16px;
      --per-view: 3;
      --shift: calc(-133.3333% - 21.3333px);
    }
  }

  .marquee-track {
    gap: var(--gap);
    width: 100%;
    animation: carousel-scroll 32s linear infinite;
    will-change: transform;
  }

  .marquee-slide {
    flex: 0 0 calc((100% - (var(--per-view) - 1) * var(--gap)) / var(--per-view));
  }

  @keyframes carousel-scroll {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(var(--shift));
    }
  }

  .marquee:hover .marquee-track,
  .marquee:focus-within .marquee-track,
  .marquee > input:checked ~ .marquee-track {
    animation-play-state: paused;
  }

  @media (prefers-reduced-motion: reduce) {
    .marquee-track {
      animation: none;
    }
  }
</style>
