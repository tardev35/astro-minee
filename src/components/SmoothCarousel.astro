---
import { Picture } from "astro:assets";

import slide1 from "../assets/slide1.png";
import slide2 from "../assets/slide2.png";
import slide3 from "../assets/slide3.png";
import slide4 from "../assets/slide4.png";

// Each alt is the text actually printed on that slide, read off the artwork,
// plus the scene it sits in. All four share the PRODED888 look: the gold ribbon
// crest spelling PRODED / 888 under a crown, a model in navy-and-gold, and gold
// light on a deep navy ground.
//
// This is a pure-CSS marquee — no Swiper, no JavaScript at all. It duplicates
// the four images three times so the loop has no seam; the duplicate copies are
// alt="" + aria-hidden so a screen reader hears each promotion once.
const images = [
  {
    src: slide1,
    alt: "แบนเนอร์โปรโมชั่น PRODED888 หัวข้อตัวหนาสองบรรทัดเขียนว่า วงล้อทองคำ และ ลุ้นรับเครดิตฟรี ด้านขวาบนเป็นวงล้อเสี่ยงโชคสีทองแบ่งเป็นช่องเขียนว่า 18 เครดิต 38 เครดิต 88 เครดิต และ 188 เครดิต ตรงกลางวงล้อเป็นแผ่นทองรูปโพดำ ใต้วงล้อเขียนว่า LUCKY SPIN ใต้หัวข้อเขียนว่า หมุนฟรีทุกวัน และ ลุ้นรับ 18 / 38 / 88 / 188 เครดิต ถัดลงมาเป็นไอคอนกล่องของขวัญคู่กับข้อความ สิทธิ์สุ่มวันละ 1 ครั้ง ด้านล่างเป็นปุ่มสีทองเขียนว่า หมุนเลย พร้อมลูกศร ด้านซ้ายของภาพเป็นผู้หญิงในชุดสีน้ำเงินกรมท่าขลิบทองกำลังชี้มือมาข้างหน้า มุมบนซ้ายเป็นโลโก้ริบบิ้นทองเขียนว่า PRODED และ 888 พร้อมมงกุฎทอง ข้อความแนวตั้งด้านซ้ายเขียนว่า GOOD LUCK BIG WIN ด้านขวาเขียนว่า SPIN FOR A BIGGER TOMORROW ฉากหลังเป็นห้องโถงสีน้ำเงินเข้มมีเหรียญทอง ชิปคาสิโน ไพ่โพดำ และลูกเต๋ากระจายอยู่",
  },
  {
    src: slide2,
    alt: "แบนเนอร์โปรโมชั่น PRODED888 หัวข้อตัวหนาสองบรรทัดเขียนว่า เช็กอิน 7 วัน และ รับของขวัญทุกวัน ใต้ลงมาเป็นแถบเงื่อนไขเขียนว่า เช็กอินต่อเนื่อง รับโบนัส 28 / 58 / 88 เครดิต ถัดลงมาเป็นแถวการ์ดเจ็ดใบเขียนว่า วันที่ 1 ถึง วันที่ 7 แต่ละใบมีเครื่องหมายถูกในวงกลมสีทองและกองเหรียญ ใต้การ์ดเขียนว่า 28 เครดิต 28 เครดิต 58 เครดิต 58 เครดิต 88 เครดิต 88 เครดิต ส่วนใบวันที่ 7 เป็นหีบสมบัติเขียนว่า กล่องรางวัลพิเศษ ถัดลงมาเป็นไอคอนกล่องของขวัญคู่กับข้อความ ครบวันที่ 7 รับกล่องรางวัลพิเศษ ด้านล่างเป็นปุ่มสีทองเขียนว่า เช็กอินเลย พร้อมลูกศร ด้านซ้ายของภาพเป็นผู้หญิงในชุดราตรีสีน้ำเงินกรมท่าขลิบทอง ด้านบนเป็นโลโก้ริบบิ้นทองเขียนว่า PRODED และ 888 พร้อมมงกุฎทอง มุมบนซ้ายเขียนว่า TRUSTED PLAY BIGGER TOGETHER ตรงกลางเขียนว่า PLAY MORE WIN BIGGER มุมบนขวาเขียนว่า PREMIUM CASINO FOR A BETTER YOU มุมล่างซ้ายเขียนว่า PRODED888 MORE THAN A GAME A ROYAL EXPERIENCE มุมล่างขวาเขียนว่า GOOD PLAYERS GOOD REWARDS แถบล่างสุดมีสามหัวข้อเขียนว่า เล่นสนุกปลอดภัย โปรโมชั่นจัดเต็ม และ ดูแลตลอด 24 ชม.",
  },
  {
    src: slide3,
    alt: "แบนเนอร์โปรโมชั่น PRODED888 หัวข้อตัวหนาสองบรรทัดเขียนว่า ภารกิจประจำวัน และ รับแต้มแลกรางวัล ใต้ลงมาเขียนว่า เล่นทุกวัน สะสมแต้ม แลกของรางวัลสุดพิเศษ ถัดลงมาเป็นวงกลมสีทองสามวงเรียงกันเขียนว่า 1 ล็อกอิน คู่กับไอคอนปฏิทิน 2 เล่นเกม คู่กับไอคอนจอยเกม และ 3 รับแต้ม คู่กับไอคอนกองเหรียญ ถัดลงมาเขียนว่า ทำครบ 3 ขั้น รับโบนัสทันที ด้านล่างเป็นปุ่มสีทองเขียนว่า รับภารกิจ ใต้ปุ่มเขียนว่า ภารกิจเล็ก ๆ ทุกวัน รางวัลใหญ่รอคุณอยู่ ข้อความด้านข้างเขียนว่า GOOD PLAYERS BETTER TOMORROW และ MORE PLAY MORE REWARDS และ DAILY MISSION BIGGER REWARDS และ SAME PLAY MORE VALUE และ REWARD YOUR JOURNEY ในภาพเป็นผู้หญิงในชุดสีน้ำเงินกรมท่าขลิบทองกำลังยกนิ้วโป้ง ด้านบนเป็นโลโก้ริบบิ้นทองเขียนว่า PRODED และ 888 ด้านล่างมีเหรียญทองและไพ่กระจายอยู่",
  },
  {
    src: slide4,
    alt: "แบนเนอร์โปรโมชั่น PRODED888 ด้านบนเป็นโลโก้ริบบิ้นทองเขียนว่า PRODED และ 888 ถัดลงมาเป็นตัวอักษรทองขนาดใหญ่เขียนว่า PRODED888 ใต้ลงมาเขียนว่า เกมดัง เล่นสนุก จบในที่เดียว และ ภาพคม ระบบลื่น โปรโมชั่นคุ้ม ถัดลงมาเป็นแถบไอคอนสามอันเขียนว่า เข้าไว คู่กับรูปสายฟ้า ปลอดภัย คู่กับรูปโล่ และ ใช้งานง่าย คู่กับรูปโทรศัพท์ ด้านล่างเป็นปุ่มสีทองเขียนว่า เข้าร่วมเลย ข้อความด้านข้างเขียนว่า MORE THAN A GAME และ PLAY BIG WIN BIGGER และ GOOD PLAY GREAT LUCK ในภาพเป็นผู้หญิงในชุดราตรีสีน้ำเงินกรมท่าถือไพ่เอซสองใบอยู่ที่โต๊ะคาสิโน มีชิปสีทองพิมพ์คำว่า PRODED 888 วางอยู่",
  },
];

const COPIES = 3;
const slides = Array.from({ length: COPIES }, () => images).flat();
---

<div class="marquee mx-auto w-full max-w-[1301px] overflow-hidden px-4 py-5">
  <input id="carousel-pause" type="checkbox" class="peer sr-only" />
  <label
    for="carousel-pause"
    class="sr-only cursor-pointer peer-focus-visible:not-sr-only peer-focus-visible:mb-3 peer-focus-visible:inline-block peer-focus-visible:rounded-full peer-focus-visible:border peer-focus-visible:border-[#e3b53f]/60 peer-focus-visible:px-4 peer-focus-visible:py-2 peer-focus-visible:text-sm peer-focus-visible:font-bold peer-focus-visible:text-[#f8de91]">
    หยุด / เล่นสไลด์ภาพ
  </label>

  <div class="marquee-track flex">
    {
      slides.map((slide, index) => {
        const isDuplicate = index >= images.length;
        return (
          <div class="marquee-slide" aria-hidden={isDuplicate ? "true" : undefined}>
            <Picture
              src={slide.src}
              alt={isDuplicate ? "" : slide.alt}
              class="block w-full rounded-xl border border-[#e3b53f]/50 object-cover shadow-[0_10px_30px_rgba(227,181,63,0.25)]"
              width={slide.src.width}
              height={slide.src.height}
              loading="lazy"
              fetchpriority="low"
              decoding="async"
              widths={[200, 400, 600]}
              sizes="(max-width: 768px) 50vw, 33vw"
              formats={["avif", "webp"]}
              fallbackFormat="webp"
              quality={60}
            />
          </div>
        );
      })
    }
  </div>
</div>

<style>
  .marquee {
    --gap: 12px;
    --per-view: 2;
    --shift: calc(-200% - 24px);
  }

  @media (min-width: 768px) {
    .marquee {
      --gap: 16px;
      --per-view: 3;
      --shift: calc(-133.3333% - 21.3333px);
    }
  }

  .marquee-track {
    gap: var(--gap);
    width: 100%;
    animation: carousel-scroll 32s linear infinite;
    will-change: transform;
  }

  .marquee-slide {
    flex: 0 0 calc((100% - (var(--per-view) - 1) * var(--gap)) / var(--per-view));
  }

  @keyframes carousel-scroll {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(var(--shift));
    }
  }

  .marquee:hover .marquee-track,
  .marquee:focus-within .marquee-track,
  .marquee > input:checked ~ .marquee-track {
    animation-play-state: paused;
  }

  @media (prefers-reduced-motion: reduce) {
    .marquee-track {
      animation: none;
    }
  }
</style>
