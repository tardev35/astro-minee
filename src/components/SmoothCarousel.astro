---
import { Picture } from "astro:assets";

import slide1 from "../assets/slide1.png";
import slide2 from "../assets/slide2.png";
import slide3 from "../assets/slide3.png";
import slide4 from "../assets/slide4.png";

// Each alt is the Thai promotional text actually printed on that slide, read off
// the artwork, plus the scene it sits in. All four share the RUAYRUAY888 look:
// hot pink neon over near-black, a model in pink-and-black streetwear, chips,
// crown coins and gift boxes.
//
// The wordmark baked into these files belongs to an unrelated brand, so every
// alt writes it as "โลโก้เว็บไซต์" and never transcribes it. Publishing another
// brand's name in this site's alt text is worse than a slightly less literal alt.
//
// This is a pure-CSS marquee — no Swiper, no JavaScript at all. It duplicates
// the four images three times so the loop has no seam; the duplicate copies are
// alt="" + aria-hidden so a screen reader hears each promotion once.
const images = [
  {
    src: slide1,
    alt: "แบนเนอร์โปรโมชั่นโทนชมพูนีออน ด้านบนกลางภาพเป็นโลโก้เว็บไซต์บนพื้นดำ หัวข้อตัวหนาเขียนว่า เช็กอิน 7 วัน โดยเลข 7 เป็นตัวใหญ่ ใต้หัวข้อเป็นแถบสีชมพูเขียนว่า รับกล่องสุ่มโบนัสฟรี คู่กับไอคอนกล่องของขวัญ ถัดลงมาเป็นปฏิทินตั้งโต๊ะเจ็ดช่องเขียนว่า วันที่ 1 ถึง วันที่ 7 ทุกช่องมีเครื่องหมายถูกสีชมพู ด้านขวาเป็นตราวงกลมมีมงกุฎเขียนว่า ลุ้นรางวัลทุกวัน ข้อความลายมือด้านซ้ายเขียนว่า Play More Be Happier และ GOOD PLAY BRIGHTER DAYS มุมบนขวาเขียนว่า GAMES REWARDS FRIENDS BIGGER HAPPINESS แถบล่างสุดเขียนว่า MORE REWARDS A BRIGHTER YOU ในภาพเป็นผู้หญิงเกล้าผมสวมชุดเลื่อมสีเงินและต่างหูระย้า ด้านหน้ามีกล่องสุ่มสีดำพิมพ์โลโก้เว็บไซต์กับเครื่องหมายคำถาม กล่องของขวัญผูกโบว์ชมพู และเหรียญรูปมงกุฎวางอยู่ ฉากหลังเป็นซุ้มโค้งเรืองแสงสีชมพู",
  },
  {
    src: slide2,
    alt: "แบนเนอร์โปรโมชั่นโทนชมพูนีออน มุมบนซ้ายเป็นโลโก้เว็บไซต์บนพื้นดำ ใต้โลโก้เขียนว่า PLAY MORE WIN MORE หัวข้อตัวหนาด้านล่างเขียนว่า ภารกิจรายวัน ใต้หัวข้อเป็นแถบเขียนว่า ทำครบ รับเครดิตพิเศษทุกวัน ด้านซ้ายเป็นคลิปบอร์ดหัวข้อ DAILY MISSION มีรายการสี่บรรทัดเขียนว่า เข้าเล่นเกม ทำยอดเดิมพัน รับโบนัส และ ภารกิจพิเศษ ทุกบรรทัดมีเครื่องหมายถูกสีชมพู ด้านขวาเป็นการ์ดสามใบเขียนว่า BONUS FREE CREDIT และ CASH BACK พร้อมตราวงกลมมีมงกุฎเขียนว่า ของรางวัลเพียบ ข้อความลายมือเขียนว่า Daily Mission และ Good Game Better You แถบล่างสุดมีสี่ช่องเขียนว่า เล่น ลุ้น รับ และ ชนะ คู่กับไอคอนจอยเกม ลูกเต๋า กล่องของขวัญ และถ้วยรางวัล ในภาพเป็นผู้หญิงผมยาวสวมชุดวอร์มสีชมพูดำพิมพ์โลโก้เว็บไซต์ กำลังชี้มือมาข้างหน้าและถือโทรศัพท์ที่มีข้อความ PLAY ANYTIME ANYWHERE ฉากหลังมีลูกเต๋า จอยเกม และเหรียญรูปมงกุฎลอยอยู่",
  },
  {
    src: slide3,
    alt: "แบนเนอร์โปรโมชั่นโทนชมพูนีออน ด้านบนซ้ายเป็นโลโก้เว็บไซต์ ใต้โลโก้เป็นข้อความลายมือเขียนว่า Play More Good Vibes หัวข้อตัวหนาสองบรรทัดเขียนว่า เล่นง่าย และ ลุ้นสนุกทุกวัน ใต้หัวข้อเป็นแถบมีมงกุฎเขียนว่า โปรใหม่มาแล้ว คู่กับโลโก้เว็บไซต์ ด้านล่างเป็นปุ่มสีชมพูเขียนว่า ดูโปรโมชั่น พร้อมลูกศร ใต้ปุ่มเป็นไอคอนสี่อันเขียนว่า ปลอดภัย มั่นใจ 100% ฝาก-ถอน รวดเร็ว โปรโมชั่น จัดเต็ม และ เล่นได้ทุกที่ ทุกเวลา ข้อความด้านซ้ายเขียนว่า BIG WINS BRIGHTER DAYS ด้านขวาเขียนว่า Win Together Everyday และ GAMERS PLAY A BRIGHTER TOMORROW ในภาพเป็นผู้หญิงผมสั้นสวมแจ็กเก็ตหนังสีดำแถบชมพูพิมพ์โลโก้เว็บไซต์ กำลังขยิบตาและชี้มือมาข้างหน้า ด้านหน้ามีชิปคาสิโนสีชมพูดำลายหัวใจกองอยู่ พร้อมเหรียญเงินพิมพ์เลข 888 ฉากหลังเป็นตู้เกมเรืองแสงสีชมพู",
  },
  {
    src: slide4,
    alt: "แบนเนอร์โปรโมชั่นโทนชมพูนีออน ด้านบนกลางภาพเป็นโลโก้เว็บไซต์มีมงกุฎอยู่ด้านบน หัวข้อตัวหนาเขียนว่า ชวนเพื่อนรับรางวัล ใต้หัวข้อเขียนว่า ยิ่งชวน ยิ่งได้ ลุ้นโบนัส X2 โดย X2 เป็นตัวใหญ่ ด้านขวาเป็นไอคอนรูปคนสองคนกับเครื่องหมายบวกสีชมพู และตราวงกลมมีมงกุฎเขียนว่า แจกจริงทุกสัปดาห์ ข้อความมุมบนซ้ายเขียนว่า GOOD FRIENDS BIGGER WINS และ PLAY INVITE WIN TOGETHER ด้านขวาเขียนว่า Play More Together MORE FRIENDS MORE PLAY MORE REWARDS และ SAME GAME BIGGER SQUAD ในภาพเป็นผู้หญิงผมหยิกสวมแจ็กเก็ตสีดำพิมพ์โลโก้เว็บไซต์ทับเสื้อครอปสีขาว กำลังขยิบตาและชี้มือไปทางไอคอนชวนเพื่อน ด้านล่างมีกล่องของขวัญสีดำผูกโบว์ชมพูพิมพ์โลโก้เว็บไซต์ และเหรียญรูปมงกุฎกระจายอยู่",
  },
];

const COPIES = 3;
const slides = Array.from({ length: COPIES }, () => images).flat();
---

<div class="marquee mx-auto w-full max-w-[1301px] overflow-hidden px-4 py-5">
  <input id="carousel-pause" type="checkbox" class="peer sr-only" />
  <label
    for="carousel-pause"
    class="sr-only cursor-pointer peer-focus-visible:not-sr-only peer-focus-visible:mb-3 peer-focus-visible:inline-block peer-focus-visible:rounded-full peer-focus-visible:border peer-focus-visible:border-[#f874a1]/60 peer-focus-visible:px-4 peer-focus-visible:py-2 peer-focus-visible:text-sm peer-focus-visible:font-bold peer-focus-visible:text-[#fdb4d4]">
    หยุด / เล่นสไลด์ภาพ
  </label>

  <div class="marquee-track flex">
    {
      slides.map((slide, index) => {
        const isDuplicate = index >= images.length;
        return (
          <div class="marquee-slide" aria-hidden={isDuplicate ? "true" : undefined}>
            <Picture
              src={slide.src}
              alt={isDuplicate ? "" : slide.alt}
              class="block w-full rounded-xl border border-[#f874a1]/50 object-cover shadow-[0_10px_30px_rgba(248,116,161,0.28)]"
              width={slide.src.width}
              height={slide.src.height}
              loading="lazy"
              fetchpriority="low"
              decoding="async"
              widths={[200, 400, 600]}
              sizes="(max-width: 768px) 50vw, 33vw"
              formats={["avif", "webp"]}
              fallbackFormat="webp"
              quality={60}
            />
          </div>
        );
      })
    }
  </div>
</div>

<style>
  .marquee {
    --gap: 12px;
    --per-view: 2;
    --shift: calc(-200% - 24px);
  }

  @media (min-width: 768px) {
    .marquee {
      --gap: 16px;
      --per-view: 3;
      --shift: calc(-133.3333% - 21.3333px);
    }
  }

  .marquee-track {
    gap: var(--gap);
    width: 100%;
    animation: carousel-scroll 32s linear infinite;
    will-change: transform;
  }

  .marquee-slide {
    flex: 0 0 calc((100% - (var(--per-view) - 1) * var(--gap)) / var(--per-view));
  }

  @keyframes carousel-scroll {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(var(--shift));
    }
  }

  .marquee:hover .marquee-track,
  .marquee:focus-within .marquee-track,
  .marquee > input:checked ~ .marquee-track {
    animation-play-state: paused;
  }

  @media (prefers-reduced-motion: reduce) {
    .marquee-track {
      animation: none;
    }
  }
</style>
