---
import { Picture } from "astro:assets";

import slide1 from "../assets/slide1.png";
import slide2 from "../assets/slide2.png";
import slide3 from "../assets/slide3.png";
import slide4 from "../assets/slide4.png";

// Each alt is the text actually printed on that slide, read off the artwork,
// plus the scene it sits in. All four share the ABM96 wordmark (ABM in pink, 96
// in white) beside a pink pig mascot in a white ABM96 t-shirt, a woman in a
// pink/white/black cropped sports outfit printed ABM96, and a neon-pink casino
// room with gold coins and pink chips.
const images = [
  {
    src: slide1,
    alt: "แบนเนอร์โปรโมชั่น ABM96 ข้อความ สมาชิกใหม่ รับโบนัส 50% สมัครวันนี้ รับสิทธิ์ทันที โบนัสต้อนรับสำหรับผู้เล่นใหม่ และปุ่ม รับโปรเลย พร้อมผู้หญิงในชุดกีฬาครอปสีชมพู-ขาว-ดำ พิมพ์ ABM96 ชี้นิ้วขึ้น มาสคอตหมูสีชมพูสวมเสื้อยืดขาวพิมพ์ ABM96 ป้ายไฟ JACKPOT BIG WIN ตู้สล็อตเลข 777 BAR เหรียญทองและชิปคาสิโนสีชมพูในห้องคาสิโนไฟนีออนสีชมพู",
  },
  {
    src: slide2,
    alt: "แบนเนอร์โปรโมชั่น ABM96 ข้อความ ฝากครั้งแรก รับเพิ่ม 20% คุ้มตั้งแต่ฝากแรก ฝากง่าย ถอนเร็ว ระบบออโต้ และปุ่ม ฝากเลย พร้อมแถบ ระบบออโต้ ฝาก-ถอนอัตโนมัติ 24 ชม. โบนัสคุ้ม จัดเต็มทุกโปรโมชั่น และบริการ 24 ชม. มีผู้หญิงในชุดกีฬาครอปสีชมพู-ขาว-ดำ พิมพ์ ABM96 มาสคอตหมูสีชมพูแลบลิ้น ป้ายไฟ JACKPOT BIG WIN ตู้สล็อตเลข 777 BAR ไพ่โพแดงโพดำ เหรียญทองและชิปคาสิโนสีชมพู",
  },
  {
    src: slide3,
    alt: "แบนเนอร์โปรโมชั่น ABM96 ข้อความ แนะนำเพื่อน รับค่าคอม 10% ชวนเพื่อน ยิ่งชวนยิ่งคุ้ม สามขั้นตอน ส่งลิงก์แนะนำ เพื่อนสมัคร รับค่าคอม และปุ่ม ชวนเลย พร้อมผู้หญิงในชุดกีฬาครอปสีชมพู-ขาว-ดำ พิมพ์ ABM96 มาสคอตหมูสีชมพูสวมเสื้อยืดขาวพิมพ์ ABM96 ป้ายไฟ JACKPOT BIG WIN ตู้สล็อตเลข 777 BAR กล่องของขวัญ เหรียญทองและชิปคาสิโนสีชมพู",
  },
  {
    src: slide4,
    alt: "แบนเนอร์โปรโมชั่น ABM96 ข้อความ คืนยอดเสียทุกวัน 0.8% เล่นต่อได้ทุกวัน คืนยอดเสียคุ้มค่า ไม่พลาดทุกความสนุก และปุ่ม รับสิทธิ์ พร้อมแถบ ระบบออโต้ ฝาก-ถอนรวดเร็วทันใจ โบนัสคุ้ม จัดเต็มทุกโปรโมชั่น และบริการ 24 ชม. มีผู้หญิงในชุดกีฬาครอปสีชมพู-ขาว-ดำ พิมพ์ ABM96 มาสคอตหมูสีชมพูแลบลิ้นสวมเสื้อยืดขาวพิมพ์ ABM96 ป้ายไฟ JACKPOT BIG WIN ตู้สล็อตเลข 777 BAR ไพ่ เหรียญทองและชิปคาสิโนสีชมพู",
  },
];

const COPIES = 3;
const slides = Array.from({ length: COPIES }, () => images).flat();
---

<div class="marquee mx-auto w-full max-w-[1301px] overflow-hidden px-4 py-5">
  <input id="carousel-pause" type="checkbox" class="peer sr-only" />
  <label
    for="carousel-pause"
    class="sr-only cursor-pointer peer-focus-visible:not-sr-only peer-focus-visible:mb-3 peer-focus-visible:inline-block peer-focus-visible:rounded-full peer-focus-visible:border peer-focus-visible:border-[#f1509b]/60 peer-focus-visible:px-4 peer-focus-visible:py-2 peer-focus-visible:text-sm peer-focus-visible:font-bold peer-focus-visible:text-[#fda3cd]">
    หยุด / เล่นสไลด์ภาพ
  </label>

  <div class="marquee-track flex">
    {
      slides.map((slide, index) => {
        const isDuplicate = index >= images.length;
        return (
          <div class="marquee-slide" aria-hidden={isDuplicate ? "true" : undefined}>
            <Picture
              src={slide.src}
              alt={isDuplicate ? "" : slide.alt}
              class="block w-full rounded-xl border border-[#f1509b]/40 object-cover shadow-[0_10px_30px_rgba(241,80,155,0.25)]"
              width={slide.src.width}
              height={slide.src.height}
              loading="lazy"
              fetchpriority="low"
              decoding="async"
              widths={[200, 400, 600]}
              sizes="(max-width: 768px) 50vw, 33vw"
              formats={["avif", "webp"]}
              fallbackFormat="webp"
              quality={60}
            />
          </div>
        );
      })
    }
  </div>
</div>

<style>
  .marquee {
    --gap: 12px;
    --per-view: 2;
    --shift: calc(-200% - 24px);
  }

  @media (min-width: 768px) {
    .marquee {
      --gap: 16px;
      --per-view: 3;
      --shift: calc(-133.3333% - 21.3333px);
    }
  }

  .marquee-track {
    gap: var(--gap);
    width: 100%;
    animation: carousel-scroll 32s linear infinite;
    will-change: transform;
  }

  .marquee-slide {
    flex: 0 0 calc((100% - (var(--per-view) - 1) * var(--gap)) / var(--per-view));
  }

  @keyframes carousel-scroll {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(var(--shift));
    }
  }

  .marquee:hover .marquee-track,
  .marquee:focus-within .marquee-track,
  .marquee > input:checked ~ .marquee-track {
    animation-play-state: paused;
  }

  @media (prefers-reduced-motion: reduce) {
    .marquee-track {
      animation: none;
    }
  }
</style>
