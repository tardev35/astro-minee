---
import { Picture } from "astro:assets";

import slide1 from "../assets/slide1.png";
import slide2 from "../assets/slide2.png";
import slide3 from "../assets/slide3.png";
import slide4 from "../assets/slide4.png";

// Each alt is the Thai promotional text actually printed on that slide, read off
// the artwork, plus the scene it sits in. All four share the TT1BET look: gold
// lettering on warm near-black, chandeliers and gold-panelled casino rooms,
// roulette wheels, stacked black-and-gold chips and a woman in a sequin gown,
// with the brushed-silver-and-gold wordmark centred at the top.
//
// The wordmark baked into these files is written as "โลโก้เว็บไซต์" rather than
// transcribed: alt text is for describing the picture, not for repeating a
// logotype a reader cannot act on.
//
// This is a pure-CSS marquee — no Swiper, no JavaScript at all. It duplicates
// the four images three times so the loop has no seam; the duplicate copies are
// alt="" + aria-hidden so a screen reader hears each promotion once.
const images = [
  {
    src: slide1,
    alt: "แบนเนอร์โปรโมชั่นโทนทองบนพื้นดำ ด้านบนกลางภาพเป็นโลโก้เว็บไซต์ตัวอักษรโรมันหนา ใต้โลโก้เป็นบรรทัดเล็กเขียนว่า PLAY BIGGER WIN BRIGHTER มุมบนซ้ายเป็นข้อความลายมือสีทองเขียนว่า Good Luck Tonight มุมบนขวาเขียนว่า MORE THAN A GAME กลางภาพเป็นหัวข้อตัวใหญ่สีทองเขียนว่า นาทีทองคืนนี้ ถัดลงมาเขียนว่า รับเพิ่ม 30 เปอร์เซ็นต์ ใต้หัวข้อเป็นแถบพร้อมไอคอนนาฬิกาเขียนว่า เวลา 20:00 ถึง 22:00 เท่านั้น และปุ่มสีทองเขียนว่า รับสิทธิ์เลย ด้านซ้ายเป็นผู้หญิงสวมชุดราตรีเลื่อมสีแดงหันหลังแล้วเหลียวมองมาทางกล้อง มือถือชิปคาสิโนสีดำแดงไว้ ด้านขวาเป็นวงล้อรูเล็ตและกองชิปคาสิโนสีดำทองที่พิมพ์ชื่อเว็บไซต์ไว้ ฉากหลังเป็นห้องคาสิโนสีทองที่มีโคมไฟระย้า แสงประกายทอง และป้ายเขียนว่า CASINO LIVE BIGGER แถบล่างสุดมีสี่ช่องพร้อมไอคอนเขียนว่า มั่นคงปลอดภัย ฝาก-ถอนรวดเร็ว ครบทุกเกม คาสิโน สล็อต กีฬา และ เล่นได้ทุกที่ ตลอด 24 ชั่วโมง ล่างสุดเขียนว่า YOUR LUCKY HOUR STARTS HERE",
  },
  {
    src: slide2,
    alt: "แบนเนอร์โปรโมชั่นโทนทองบนพื้นดำ ด้านบนกลางภาพเป็นโลโก้เว็บไซต์ตัวอักษรโรมันหนา ขอบซ้ายเขียนว่า PLAY MORE WIN BIGGER ขอบขวาเขียนว่า GOOD PLAYERS BET TOGETHER กลางภาพมีมงกุฎทองวางอยู่เหนือหัวข้อสีทองเขียนว่า ภารกิจรายสัปดาห์ ใต้หัวข้อเป็นกรอบเขียนว่า สะสมครบ รับเครดิตฟรี และเลข 388 ตัวใหญ่สีทองที่มีกล่องของขวัญขนาบสองข้าง ด้านล่างเป็นปุ่มสีดำขอบทองเขียนว่า เริ่มภารกิจ ด้านซ้ายเป็นผู้หญิงสวมชุดเลื่อมสีน้ำเงินยิ้มขยิบตาและชี้มือมาข้างหน้า ด้านขวาเป็นวงล้อรางวัลสีทองที่มีชื่อเว็บไซต์อยู่กลางวงและมีไอคอนเหรียญ มงกุฎ กล่องของขวัญ และโพดำเรียงอยู่บนวง รอบภาพมีเหรียญทอง กล่องของขวัญ ลูกเต๋า และสัญลักษณ์โพดำ ฉากหลังเป็นห้องคาสิโนสีทองที่มีเสาลายและแสงประกายทอง",
  },
  {
    src: slide3,
    alt: "แบนเนอร์โปรโมชั่นโทนทองบนพื้นดำ ด้านบนกลางภาพเป็นโลโก้เว็บไซต์ตัวอักษรโรมันหนา ขอบซ้ายเขียนว่า BET PLAY WIN TOGETHER และ MORE FRIENDS BIGGER WINS ขอบขวาเขียนว่า GOOD PEOPLE GREAT JACKPOTS และ GOOD FRIENDS BIGGER FORTUNES กลางภาพมีไอคอนคนสองคนกับเครื่องหมายบวกอยู่เหนือหัวข้อสีทองเขียนว่า ชวนเพื่อนร่วมสนุก ถัดลงมาเขียนว่า รับโบนัส และเลข 300 ตัวใหญ่สีทอง ใต้เลขเขียนว่า เมื่อเพื่อนสมัครและเล่นครบเงื่อนไข และปุ่มสีดำขอบทองเขียนว่า ชวนเพื่อนเลย ด้านซ้ายเป็นผู้หญิงสวมชุดเลื่อมสีน้ำเงินนั่งเท้าคางอยู่ที่โต๊ะไพ่ บนโต๊ะมีไพ่สองใบและกองชิปคาสิโนสีดำทองที่พิมพ์ชื่อเว็บไซต์ไว้ ฉากหลังเป็นห้องคาสิโนที่มีโคมไฟระย้า โคมไฟตั้งโต๊ะ และวิวตึกสูงเปิดไฟ",
  },
  {
    src: slide4,
    alt: "แบนเนอร์โปรโมชั่นโทนทองบนพื้นดำ ด้านบนกลางภาพเป็นโลโก้เว็บไซต์ตัวอักษรโรมันหนา มุมบนซ้ายเขียนว่า MORE THAN A GAME กลางภาพเป็นหัวข้อตัวใหญ่สีทองเขียนว่า คืนยอดเสียทุกวัน ถัดลงมาเขียนว่า รับเพิ่ม 8 เปอร์เซ็นต์ ใต้หัวข้อเป็นแถบที่มีมงกุฎขนาบสองข้างเขียนว่า VIP รับไวทุกวันตามเงื่อนไข ถัดลงมาเป็นสี่ช่องพร้อมไอคอนเขียนว่า สิทธิพิเศษระดับ VIP รับคืนทุกวันไม่มีสะสม เล่นได้ทุกรูปแบบ มั่นคง ปลอดภัย และ ดูแลต่อเนื่องระยะยาว ใต้ลงมาเป็นปุ่มสีทองเขียนว่า รับโปรวันนี้ ด้านซ้ายเป็นผู้หญิงสวมชุดราตรีเลื่อมสีดำนั่งบนเก้าอี้หนังที่มีป้ายเขียนว่า VIP มุมล่างซ้ายเป็นวงล้อรูเล็ต ด้านล่างเป็นกองชิปคาสิโนสีดำทองที่พิมพ์ชื่อเว็บไซต์ไว้และป้ายสีดำขอบทองเขียนว่า PLAY WIN BELONG ฉากหลังเป็นห้องคาสิโนสีทองที่มีโคมไฟระย้าและแสงประกายทอง",
  },
];

const COPIES = 3;
const slides = Array.from({ length: COPIES }, () => images).flat();
---

<div class="marquee mx-auto w-full max-w-[1301px] overflow-hidden px-4 py-5">
  <input id="carousel-pause" type="checkbox" class="peer sr-only" />
  <label
    for="carousel-pause"
    class="sr-only cursor-pointer peer-focus-visible:not-sr-only peer-focus-visible:mb-3 peer-focus-visible:inline-block peer-focus-visible:rounded-full peer-focus-visible:border peer-focus-visible:border-[#e9c341]/60 peer-focus-visible:px-4 peer-focus-visible:py-2 peer-focus-visible:text-sm peer-focus-visible:font-bold peer-focus-visible:text-[#fcf1b0]">
    หยุด / เล่นสไลด์ภาพ
  </label>

  <div class="marquee-track flex">
    {
      slides.map((slide, index) => {
        const isDuplicate = index >= images.length;
        return (
          <div class="marquee-slide" aria-hidden={isDuplicate ? "true" : undefined}>
            <Picture
              src={slide.src}
              alt={isDuplicate ? "" : slide.alt}
              class="block w-full rounded-xl border border-[#e9c341]/50 object-cover shadow-[0_10px_30px_rgba(233,195,65,0.28)]"
              width={slide.src.width}
              height={slide.src.height}
              loading="lazy"
              fetchpriority="low"
              decoding="async"
              widths={[200, 400, 600]}
              sizes="(max-width: 768px) 50vw, 33vw"
              formats={["avif", "webp"]}
              fallbackFormat="webp"
              quality={60}
            />
          </div>
        );
      })
    }
  </div>
</div>

<style>
  .marquee {
    --gap: 12px;
    --per-view: 2;
    --shift: calc(-200% - 24px);
  }

  @media (min-width: 768px) {
    .marquee {
      --gap: 16px;
      --per-view: 3;
      --shift: calc(-133.3333% - 21.3333px);
    }
  }

  .marquee-track {
    gap: var(--gap);
    width: 100%;
    animation: carousel-scroll 32s linear infinite;
    will-change: transform;
  }

  .marquee-slide {
    flex: 0 0 calc((100% - (var(--per-view) - 1) * var(--gap)) / var(--per-view));
  }

  @keyframes carousel-scroll {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(var(--shift));
    }
  }

  .marquee:hover .marquee-track,
  .marquee:focus-within .marquee-track,
  .marquee > input:checked ~ .marquee-track {
    animation-play-state: paused;
  }

  @media (prefers-reduced-motion: reduce) {
    .marquee-track {
      animation: none;
    }
  }
</style>
