---
import { Picture } from "astro:assets";

import slide1 from "../assets/slide1.png";
import slide2 from "../assets/slide2.png";
import slide3 from "../assets/slide3.png";
import slide4 from "../assets/slide4.png";

// Each alt is the text actually printed on that slide, read off the artwork,
// plus the scene it sits in. All four share the MVP928 look: the wordmark with
// "MVP" in white-to-silver chrome and "928" in peach-to-orange, a model in a
// black-and-copper dress carrying the logo, a gold Zeus bust, gold coins and
// casino chips on a near-black ground.
//
// This is a pure-CSS marquee — no Swiper, no JavaScript at all. It duplicates
// the four images three times so the loop has no seam; the duplicate copies are
// alt="" + aria-hidden so a screen reader hears each promotion once.
const images = [
  {
    src: slide1,
    alt: "แบนเนอร์โปรโมชั่น MVP928 มุมบนซ้ายเป็นโลโก้ MVP928 ตัวอักษร MVP สีขาวเงินและเลข 928 สีส้มพีช ถัดลงมาเป็นตัวอักษรขนาดใหญ่สีเงินสลับส้มเขียนว่า MVP928 ใต้ลงมาเขียนว่า สนุกคุ้มทุกแมตช์ ต่อด้วยแถบข้อความเขียนว่า รวมเกมเด่น โบนัสอัปเดตทุกวัน ถัดลงมาเป็นป้ายวงรีสามอันเรียงกันเขียนว่า เกมไว พร้อมไอคอนสายฟ้า ภาพคม พร้อมไอคอนเป้า และ เล่นลื่น พร้อมไอคอนจรวด ด้านล่างเป็นปุ่มสีส้มเขียนว่า เปิดเกมเลย ด้านขวาเป็นผู้หญิงในชุดสีดำสลับทองแดงติดโลโก้ MVP928 นั่งอยู่ท่ามกลางเหรียญทองและชิปคาสิโน ด้านหลังเป็นรูปปั้นครึ่งตัวของซุสสีทองบนพื้นหลังสีดำ",
  },
  {
    src: slide2,
    alt: "แบนเนอร์โปรโมชั่น MVP928 หัวข้อตัวหนาเขียนว่า เช็กอิน 5 วัน บรรทัดถัดมาเขียนว่า รับกล่องสุ่มโบนัส ใต้ลงมาเขียนว่า ลุ้น 28 / 58 / 128 เครดิต ถัดลงมาเป็นแถวจุดหมายห้าช่องเขียนว่า วันที่ 1 วันที่ 2 วันที่ 3 วันที่ 4 และ วันที่ 5 แต่ละช่องเป็นเครื่องหมายถูกสีทองในวงกลมเชื่อมกันด้วยลูกศร ใต้แถวเขียนว่า ทำเช็กอินต่อเนื่องครบ รับสิทธิ์สุ่มทันที ถัดลงมาเป็นหีบสมบัติสามใบเขียนว่า 28 เครดิต 58 เครดิต และ 128 เครดิต ด้านล่างเป็นปุ่มเขียนว่า เช็กอินเลย ด้านซ้ายเป็นผู้หญิงในชุดสีดำสลับทองแดงติดโลโก้ MVP928 ชี้นิ้วไปที่แถวขั้นตอน ด้านบนเป็นโลโก้ MVP928 ตัวอักษร MVP สีขาวเงินและเลข 928 สีส้มพีชบนพื้นหลังสีดำ",
  },
  {
    src: slide3,
    alt: "แบนเนอร์โปรโมชั่น MVP928 หัวข้อตัวอักษรสีเงินสลับทองเขียนว่า King Hour ใต้ลงมาเป็นป้ายรูปนาฬิกาเขียนช่วงเวลา 22:00 - 23:00 ถัดมาเป็นบรรทัดเขียนว่า เปิดหีบ ลุ้นโค้ดลับ และบรรทัดเขียนว่า รับเครดิตฟรี 99 / 199 / 299 ใต้ลงมาเขียนว่า เฉพาะช่วงเวลากำหนดของทุกวัน ตรงกลางเป็นหีบสมบัติเปิดฝาเปล่งแสงที่มีเหรียญรูปกุญแจสลักคำว่า CODE กระเด็นออกมา ด้านล่างเป็นปุ่มเขียนว่า ล่ารางวัล ด้านบนเป็นโลโก้ MVP928 ตัวอักษร MVP สีขาวเงินและเลข 928 สีส้มพีช รอบด้านเป็นเหรียญทองและชิปคาสิโนบนพื้นหลังสีดำ",
  },
  {
    src: slide4,
    alt: "แบนเนอร์โปรโมชั่น MVP928 หัวข้อตัวหนาเขียนว่า วงล้อราชัน บรรทัดเงื่อนไขเขียนว่า ฝากครบ 500 รับสิทธิ์หมุนฟรี 1 ครั้ง ด้านขวาเป็นวงล้อเสี่ยงโชคขนาดใหญ่สีทองสลับดำ ช่องบนวงล้อเขียนว่า 68 เครดิต 168 เครดิต และ 368 เครดิต สลับกับช่องที่เขียนว่า ของรางวัล ช่องรูปหีบสมบัติ ช่องรูปถุงเงิน และช่องรูปเพชร ใต้วงล้อเขียนว่า หมุนรับสิทธิ์ลุ้นของรางวัลได้ทุกวัน ด้านล่างเป็นปุ่มเขียนว่า หมุนเลย ด้านซ้ายเป็นผู้หญิงในชุดสีดำสลับทองแดงติดโลโก้ MVP928 ชี้นิ้วไปที่วงล้อ ด้านบนเป็นโลโก้ MVP928 ตัวอักษร MVP สีขาวเงินและเลข 928 สีส้มพีชบนพื้นหลังสีดำ",
  },
];

const COPIES = 3;
const slides = Array.from({ length: COPIES }, () => images).flat();
---

<div class="marquee mx-auto w-full max-w-[1301px] overflow-hidden px-4 py-5">
  <input id="carousel-pause" type="checkbox" class="peer sr-only" />
  <label
    for="carousel-pause"
    class="sr-only cursor-pointer peer-focus-visible:not-sr-only peer-focus-visible:mb-3 peer-focus-visible:inline-block peer-focus-visible:rounded-full peer-focus-visible:border peer-focus-visible:border-[#ef6a17]/60 peer-focus-visible:px-4 peer-focus-visible:py-2 peer-focus-visible:text-sm peer-focus-visible:font-bold peer-focus-visible:text-[#f0b243]">
    หยุด / เล่นสไลด์ภาพ
  </label>

  <div class="marquee-track flex">
    {
      slides.map((slide, index) => {
        const isDuplicate = index >= images.length;
        return (
          <div class="marquee-slide" aria-hidden={isDuplicate ? "true" : undefined}>
            <Picture
              src={slide.src}
              alt={isDuplicate ? "" : slide.alt}
              class="block w-full rounded-xl border border-[#ef6a17]/50 object-cover shadow-[0_10px_30px_rgba(239,106,23,0.25)]"
              width={slide.src.width}
              height={slide.src.height}
              loading="lazy"
              fetchpriority="low"
              decoding="async"
              widths={[200, 400, 600]}
              sizes="(max-width: 768px) 50vw, 33vw"
              formats={["avif", "webp"]}
              fallbackFormat="webp"
              quality={60}
            />
          </div>
        );
      })
    }
  </div>
</div>

<style>
  .marquee {
    --gap: 12px;
    --per-view: 2;
    --shift: calc(-200% - 24px);
  }

  @media (min-width: 768px) {
    .marquee {
      --gap: 16px;
      --per-view: 3;
      --shift: calc(-133.3333% - 21.3333px);
    }
  }

  .marquee-track {
    gap: var(--gap);
    width: 100%;
    animation: carousel-scroll 32s linear infinite;
    will-change: transform;
  }

  .marquee-slide {
    flex: 0 0 calc((100% - (var(--per-view) - 1) * var(--gap)) / var(--per-view));
  }

  @keyframes carousel-scroll {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(var(--shift));
    }
  }

  .marquee:hover .marquee-track,
  .marquee:focus-within .marquee-track,
  .marquee > input:checked ~ .marquee-track {
    animation-play-state: paused;
  }

  @media (prefers-reduced-motion: reduce) {
    .marquee-track {
      animation: none;
    }
  }
</style>
