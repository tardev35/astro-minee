---
import { Picture } from "astro:assets";

import slide1 from "../assets/slide1.png";
import slide2 from "../assets/slide2.png";
import slide3 from "../assets/slide3.png";
import slide4 from "../assets/slide4.png";

// Each alt is the text actually printed on that slide, read off the artwork,
// plus the scene it sits in. All four share the ORA2U look: the gold crown
// medallion with the LUCKYGAME ribbon, a model in a black-and-gold ORA2U outfit,
// gold coins, poker chips, gems and slot reels on a near-black ground.
//
// This is a pure-CSS marquee — no Swiper, no JavaScript at all. It duplicates
// the four images three times so the loop has no seam; the duplicate copies are
// alt="" + aria-hidden so a screen reader hears each promotion once.
const images = [
  {
    src: slide1,
    alt: "แบนเนอร์โปรโมชั่น ORA2U หัวข้อสีทองเขียนว่า ภารกิจประจำวัน บรรทัดถัดมาเขียนว่า ทำครบ 4 ภารกิจ รับซองสุ่ม พร้อมไอคอนซองสีแดง ใต้ลงมาเป็นตัวเลขสีทองขนาดใหญ่ 28 / 88 / 168 เหนือคำว่า เครดิต ถัดลงมาเป็นแถวไทล์สีทองสี่ขั้นตอนที่ติดเครื่องหมายถูกครบทุกช่อง ล็อกอิน พร้อมไอคอนคน ฝากเงิน พร้อมไอคอนเหรียญ หมุนเกม พร้อมไอคอนวงล้อ 777 และ รับรางวัล พร้อมไอคอนกล่องของขวัญ ด้านล่างเป็นปุ่มวงรีสีทองเขียนว่า รับภารกิจ ด้านซ้ายเป็นผู้หญิงในชุดสีดำสลับทองติดโลโก้ ORA2U ด้านบนกลางภาพเป็นโลโก้มงกุฎ ORA2U รอบด้านเป็นกล่องของขวัญ เหรียญทอง และวงล้อสล็อตบนพื้นหลังสีดำ",
  },
  {
    src: slide2,
    alt: "แบนเนอร์โปรโมชั่น ORA2U ข้อความสีขาวเขียนว่า Lucky Hour ใต้ลงมาเป็นกรอบเส้นนีออนสีชมพูเขียนช่วงเวลา 19:00 - 20:00 ถัดมาเป็นบรรทัดภาษาไทยเขียนว่า เปิดหีบลับ ลุ้นรับ แล้วเป็นตัวเลขสีทองขนาดใหญ่ 29 / 79 / 179 เครดิต และบรรทัดเขียนว่า เฉพาะช่วงเวลาที่กำหนด ด้านขวาเป็นหีบสมบัติสีทองเปิดฝาที่มีลำแสงพุ่งออกมาพร้อมอัญมณีสีฟ้า ชมพู และขาว เหรียญทอง และวงล้อรูเล็ต ด้านล่างเป็นปุ่มวงรีสีทองเขียนว่า เปิดเลย ด้านซ้ายเป็นผู้หญิงในชุดสีดำสลับทองยกมือขึ้นทั้งสองข้าง ด้านบนซ้ายเป็นโลโก้มงกุฎ ORA2U และมีไอคอนนาฬิกาอยู่ด้านบนบนพื้นหลังสีดำ",
  },
  {
    src: slide3,
    alt: "แบนเนอร์โปรโมชั่น ORA2U หัวข้อสีทองเขียนว่า วงล้อแต้มทอง และบรรทัดถัดมาเขียนว่า ฝากครบ 300 รับสิทธิ์หมุน 1 ครั้ง ด้านขวาเป็นวงล้อเสี่ยงโชคสีทองสลับดำขนาดใหญ่ที่มีหลอดไฟล้อมรอบขอบ ช่องต่าง ๆ เขียนว่า 39 เครดิต 89 เครดิต 189 เครดิต สลับกับช่องที่มีไอคอนกล่องของขวัญเขียนว่า ของรางวัล และช่องที่มีไอคอนลูกศรวนเขียนว่า หมุนฟรี ตรงดุมกลางวงล้อเขียนว่า หมุน และมีหัวลูกศรสีทองชี้ลงอยู่ด้านบน ใต้วงล้อเป็นบรรทัดเขียนว่า ลุ้นได้ทุกวันตามเงื่อนไข และปุ่มวงรีสีทองเขียนว่า หมุนเลย ด้านซ้ายเป็นผู้หญิงในชุดสีดำสลับทองชี้นิ้วไปที่วงล้อ ด้านบนซ้ายเป็นโลโก้มงกุฎ ORA2U รอบด้านเป็นเพชรและเหรียญทองบนพื้นหลังสีดำ",
  },
  {
    src: slide4,
    alt: "แบนเนอร์โปรโมชั่น ORA2U หัวข้อสีทองเขียนว่า ชวนเพื่อนรับเพิ่ม ใต้ลงมาเป็นแผงกรอบเส้นสีทองเขียนว่า เพื่อนสมัครสำเร็จ รับทันที พร้อมตัวเลข 69 ขนาดใหญ่มากและคำว่า บาท ถัดลงมาเป็นไอคอนวงกลมสีทองสามขั้นตอนเชื่อมด้วยลูกศร ชวนเพื่อน พร้อมไอคอนคนกับเครื่องหมายบวก สมัครสำเร็จ พร้อมไอคอนกระดานที่มีเครื่องหมายถูก และ รับโบนัส พร้อมไอคอนกล่องของขวัญ ถัดมาเป็นบรรทัดเขียนว่า ยิ่งชวน ยิ่งได้ และปุ่มวงรีสีทองเขียนว่า ชวนเลย ด้านข้างเป็นผู้หญิงในชุดสีดำสลับทองถือโทรศัพท์ที่เปิดโลโก้ ORA2U แล้วชี้นิ้วไปที่หน้าจอ รอบด้านเป็นไพ่เอซ เหรียญทอง และกล่องของขวัญบนพื้นหลังสีดำ",
  },
];

const COPIES = 3;
const slides = Array.from({ length: COPIES }, () => images).flat();
---

<div class="marquee mx-auto w-full max-w-[1301px] overflow-hidden px-4 py-5">
  <input id="carousel-pause" type="checkbox" class="peer sr-only" />
  <label
    for="carousel-pause"
    class="sr-only cursor-pointer peer-focus-visible:not-sr-only peer-focus-visible:mb-3 peer-focus-visible:inline-block peer-focus-visible:rounded-full peer-focus-visible:border peer-focus-visible:border-[#fe9a00]/60 peer-focus-visible:px-4 peer-focus-visible:py-2 peer-focus-visible:text-sm peer-focus-visible:font-bold peer-focus-visible:text-[#ffd76a]">
    หยุด / เล่นสไลด์ภาพ
  </label>

  <div class="marquee-track flex">
    {
      slides.map((slide, index) => {
        const isDuplicate = index >= images.length;
        return (
          <div class="marquee-slide" aria-hidden={isDuplicate ? "true" : undefined}>
            <Picture
              src={slide.src}
              alt={isDuplicate ? "" : slide.alt}
              class="block w-full rounded-xl border border-[#fe9a00]/50 object-cover shadow-[0_10px_30px_rgba(254,154,0,0.25)]"
              width={slide.src.width}
              height={slide.src.height}
              loading="lazy"
              fetchpriority="low"
              decoding="async"
              widths={[200, 400, 600]}
              sizes="(max-width: 768px) 50vw, 33vw"
              formats={["avif", "webp"]}
              fallbackFormat="webp"
              quality={60}
            />
          </div>
        );
      })
    }
  </div>
</div>

<style>
  .marquee {
    --gap: 12px;
    --per-view: 2;
    --shift: calc(-200% - 24px);
  }

  @media (min-width: 768px) {
    .marquee {
      --gap: 16px;
      --per-view: 3;
      --shift: calc(-133.3333% - 21.3333px);
    }
  }

  .marquee-track {
    gap: var(--gap);
    width: 100%;
    animation: carousel-scroll 32s linear infinite;
    will-change: transform;
  }

  .marquee-slide {
    flex: 0 0 calc((100% - (var(--per-view) - 1) * var(--gap)) / var(--per-view));
  }

  @keyframes carousel-scroll {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(var(--shift));
    }
  }

  .marquee:hover .marquee-track,
  .marquee:focus-within .marquee-track,
  .marquee > input:checked ~ .marquee-track {
    animation-play-state: paused;
  }

  @media (prefers-reduced-motion: reduce) {
    .marquee-track {
      animation: none;
    }
  }
</style>
