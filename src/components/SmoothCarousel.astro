---
import { Picture } from "astro:assets";

import slide1 from "../assets/slide1.png";
import slide2 from "../assets/slide2.png";
import slide3 from "../assets/slide3.png";
import slide4 from "../assets/slide4.png";

// Each alt is the text actually printed on that slide, read off the artwork,
// plus the scene it sits in. All four share the FINN20 look: the gold-chrome
// FiNN wordmark with a silver 20 and a spade glyph over a black WWW.FINN20.COM
// pill, a model in a black-and-gold FINN20 outfit, gold coins and chips, and a
// near-black background streaked with gold sparkle.
//
// This is a pure-CSS marquee — no Swiper, no JavaScript at all. It duplicates
// the four images three times so the loop has no seam; the duplicate copies are
// alt="" + aria-hidden so a screen reader hears each promotion once.
const images = [
  {
    src: slide1,
    alt: "แบนเนอร์โปรโมชั่น FINN20 ข้อความ เช็กอิน 5 วัน รับเครดิตสะสม 120 บาท และบรรทัดล่างเขียนว่า เช็กครบ รับต่อเนื่องทุกวัน ใต้ลงมาเป็นการ์ดห้าใบเรียงกันเขียนว่า DAY 1 ถึง DAY 5 แต่ละใบมีเหรียญทองตัวอักษร F กำกับด้วย 20 บาท สี่ใบแรกและ 40 บาท ใบสุดท้าย พร้อมปุ่มสีทองเขียนว่า เช็กอินเลย แถวล่างสุดมีสามข้อความ เช็กอินง่าย ครั้งเดียวต่อวัน รับเครดิตทุกวัน ต่อเนื่อง 5 วัน และ เครดิตใช้ได้ทันที ไม่ต้องทำเทิร์น ด้านบนเป็นโลโก้ FINN20 ตัวอักษร FiNN สีทองเงาและเลข 20 สีเงินพร้อมสัญลักษณ์โพดำ ใต้โลโก้เป็นแถบดำเขียนว่า WWW.FINN20.COM ข้างขวาเป็นผู้หญิงในชุดสีดำสลับทองติดโลโก้ FINN20 ชี้นิ้วขึ้น ด้านล่างซ้ายเป็นกล่องของขวัญผูกโบว์ทองและชิปคาสิโนเลข 20 บนพื้นหลังสีดำที่มีเหรียญทองและประกายทองกระจายอยู่",
  },
  {
    src: slide2,
    alt: "แบนเนอร์โปรโมชั่น FINN20 ข้อความ ภารกิจประจำวัน และบรรทัดถัดมาเขียนว่า ครบ 3 ภารกิจ รับฟรีสปิน 20 ครั้ง พร้อมข้อความ ทำครบ รับสิทธิ์ทันที ใต้ลงมาเป็นรายการภารกิจสามข้อ เข้าเล่น เดิมพันครบ และ หมุนสล็อต แต่ละข้อมีไอคอนอยู่หน้าและเครื่องหมายถูกในวงกลมอยู่ท้าย ถัดลงมาเป็นวงกลมสีดำขอบทองเขียนว่า รับฟรีสปิน 20 ครั้ง และปุ่มสีทองเขียนว่า รับภารกิจ ด้านบนเป็นโลโก้ FINN20 ตัวอักษร FiNN สีทองเงาและเลข 20 สีเงินพร้อมสัญลักษณ์โพดำ ใต้โลโก้เป็นแถบดำเขียนว่า WWW.FINN20.COM ข้างขวาเป็นผู้หญิงในชุดสีดำสลับทองติดโลโก้ FINN20 ชี้นิ้วขึ้น ด้านหลังเป็นตู้สล็อตเขียนว่า JACKPOT BIG WIN ด้านซ้ายล่างเป็นวงล้อสล็อตเลข 777 และชิปคาสิโน บนพื้นหลังสีดำที่มีเหรียญทองและประกายทองกระจายอยู่",
  },
  {
    src: slide3,
    alt: "แบนเนอร์โปรโมชั่น FINN20 ข้อความ ชวนเพื่อนรับคู่ คนละ 20 บาท และบรรทัดล่างเขียนว่า เพื่อนสมัครสำเร็จ รับโบนัสทันที ใต้ลงมาเป็นแผงสามขั้นตอนเรียงจากซ้ายไปขวา ไอคอนคนเขียนว่า ชวนเพื่อน มีลูกศรชี้ไปยังไอคอนคนที่มีเครื่องหมายถูกเขียนว่า เพื่อนสมัครสำเร็จ แล้วลูกศรชี้ต่อไปยังกล่องของขวัญที่มีเหรียญทองกองอยู่ เขียนว่า รับโบนัส และปุ่มสีทองเขียนว่า ชวนเลย ด้านบนเป็นโลโก้ FINN20 ตัวอักษร FiNN สีทองเงาและเลข 20 สีเงินพร้อมสัญลักษณ์โพดำ ใต้โลโก้เป็นแถบดำเขียนว่า WWW.FINN20.COM ข้างขวาเป็นผู้หญิงในชุดสีดำสลับทองติดโลโก้ FINN20 ถือโทรศัพท์ที่เปิดหน้าแอป FINN20 แล้วชี้นิ้วไปที่จอ ด้านซ้ายเป็นวงล้อรูเล็ตและไพ่โพดำ ด้านขวาเป็นวงล้อสล็อตช่อง BAR บนพื้นหลังสีดำที่มีเหรียญทองและประกายทองกระจายอยู่",
  },
  {
    src: slide4,
    alt: "แบนเนอร์โปรโมชั่น FINN20 ข้อความขนาดใหญ่ FINN HOUR โดยคำว่า FINN เป็นสีทองและ HOUR เป็นสีเงิน ใต้ลงมาเป็นไอคอนนาฬิกาพร้อมช่วงเวลา 20:20 - 21:20 ถัดมาเขียนว่า เปิดกล่องสุ่ม และ ลุ้น 20 / 120 / 520 เครดิต พร้อมไอคอนปฏิทินและข้อความ ร่วมสนุกเฉพาะช่วงเวลาที่กำหนด ด้านล่างซ้ายเป็นกล่องสุ่มสีดำขอบทองมีเครื่องหมายคำถามและป้ายเขียนว่า LUCKY BOX ข้างกันเป็นปุ่มสีทองเขียนว่า เปิดเลย ด้านบนเป็นโลโก้ FINN20 ตัวอักษร FiNN สีทองเงาและเลข 20 สีเงินพร้อมสัญลักษณ์โพดำ ใต้โลโก้เป็นแถบดำเขียนว่า WWW.FINN20.COM ข้างขวาเป็นผู้หญิงในชุดสีดำสลับทองติดโลโก้ FINN20 ยกมือขึ้นข้างแก้มทำท่าตื่นเต้น ข้างหลังเป็นนาฬิกาเรือนทอง วงล้อรูเล็ต และวงล้อสล็อตเลข 777 บนพื้นหลังสีดำที่มีเหรียญทองและประกายทองกระจายอยู่",
  },
];

const COPIES = 3;
const slides = Array.from({ length: COPIES }, () => images).flat();
---

<div class="marquee mx-auto w-full max-w-[1301px] overflow-hidden px-4 py-5">
  <input id="carousel-pause" type="checkbox" class="peer sr-only" />
  <label
    for="carousel-pause"
    class="sr-only cursor-pointer peer-focus-visible:not-sr-only peer-focus-visible:mb-3 peer-focus-visible:inline-block peer-focus-visible:rounded-full peer-focus-visible:border peer-focus-visible:border-[#fdd323]/60 peer-focus-visible:px-4 peer-focus-visible:py-2 peer-focus-visible:text-sm peer-focus-visible:font-bold peer-focus-visible:text-[#fdd323]">
    หยุด / เล่นสไลด์ภาพ
  </label>

  <div class="marquee-track flex">
    {
      slides.map((slide, index) => {
        const isDuplicate = index >= images.length;
        return (
          <div class="marquee-slide" aria-hidden={isDuplicate ? "true" : undefined}>
            <Picture
              src={slide.src}
              alt={isDuplicate ? "" : slide.alt}
              class="block w-full rounded-xl border border-[#fdd323]/50 object-cover shadow-[0_10px_30px_rgba(253,211,35,0.25)]"
              width={slide.src.width}
              height={slide.src.height}
              loading="lazy"
              fetchpriority="low"
              decoding="async"
              widths={[200, 400, 600]}
              sizes="(max-width: 768px) 50vw, 33vw"
              formats={["avif", "webp"]}
              fallbackFormat="webp"
              quality={60}
            />
          </div>
        );
      })
    }
  </div>
</div>

<style>
  .marquee {
    --gap: 12px;
    --per-view: 2;
    --shift: calc(-200% - 24px);
  }

  @media (min-width: 768px) {
    .marquee {
      --gap: 16px;
      --per-view: 3;
      --shift: calc(-133.3333% - 21.3333px);
    }
  }

  .marquee-track {
    gap: var(--gap);
    width: 100%;
    animation: carousel-scroll 32s linear infinite;
    will-change: transform;
  }

  .marquee-slide {
    flex: 0 0 calc((100% - (var(--per-view) - 1) * var(--gap)) / var(--per-view));
  }

  @keyframes carousel-scroll {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(var(--shift));
    }
  }

  .marquee:hover .marquee-track,
  .marquee:focus-within .marquee-track,
  .marquee > input:checked ~ .marquee-track {
    animation-play-state: paused;
  }

  @media (prefers-reduced-motion: reduce) {
    .marquee-track {
      animation: none;
    }
  }
</style>
