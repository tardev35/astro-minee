---
import { Picture } from "astro:assets";

import slide1 from "../assets/slide1.png";
import slide2 from "../assets/slide2.png";
import slide3 from "../assets/slide3.png";
import slide4 from "../assets/slide4.png";

// Each alt is the text actually printed on that slide, read off the artwork,
// plus the scene it sits in. All four share the หวยพร้อม look: the wordmark
// spelling หวย / พร้อม under a red tick, a model in a dark green sequin dress,
// and neon-green light over a green city skyline with gold and green lottery
// balls.
//
// This is a pure-CSS marquee — no Swiper, no JavaScript at all. It duplicates
// the four images three times so the loop has no seam; the duplicate copies are
// alt="" + aria-hidden so a screen reader hears each promotion once.
const images = [
  {
    src: slide1,
    alt: "แบนเนอร์โปรโมชั่น หวยพร้อม หัวข้อตัวหนาสองบรรทัดเขียนว่า สมาชิกใหม่ และ รับเครดิตฟรี ถัดลงมาเป็นตัวเลข 88 สีทองขนาดใหญ่ มีริบบิ้นสีแดงมุมขวาเขียนว่า NEW MEMBER ใต้ตัวเลขเขียนว่า รับสิทธิ์ต้อนรับสำหรับใช้ลุ้นหวยออนไลน์ ด้านล่างเป็นปุ่มสีแดงเขียนว่า สมัครเลย พร้อมลูกศร ใต้ปุ่มเป็นไอคอนสามอันเขียนว่า สมัครง่าย คู่กับรูปสายฟ้า ใช้งานสะดวก คู่กับรูปโทรศัพท์ และ ลุ้นได้ทุกวัน คู่กับรูปมงกุฎ ด้านบนกลางภาพเป็นโลโก้เขียนว่า หวย และ พร้อม พร้อมเครื่องหมายถูกสีแดง ใต้โลโก้เขียนว่า ลุ้นทุกความหวัง อยู่ใกล้แค่ปลายนิ้ว มุมบนขวาเขียนว่า ซื้อง่าย ตรวจผลเร็ว รางวัลจริง แน่นอน ข้อความด้านซ้ายเขียนว่า เลขดี ชีวิตดี เริ่มได้ที่ หวยพร้อม และ หวยไทย หวยรัฐบาล หวยฮานอย หวยลาว หวยหุ้น ด้านขวาเขียนว่า เสี่ยงโชค สร้างโอกาส ให้ชีวิต ในภาพเป็นผู้หญิงในชุดเลื่อมสีเขียวเข้มที่มีโลโก้ หวยพร้อม กำลังถือสลากกินแบ่งรัฐบาลเป็นพัดและชี้มือไปที่ตัวเลข ฉากหลังเป็นเส้นขอบฟ้าเมืองสีเขียวนีออนมีลูกบอลหวยหมายเลข 6 2 9 5 และ 8 กับเหรียญทองลอยอยู่",
  },
  {
    src: slide2,
    alt: "แบนเนอร์โปรโมชั่น หวยพร้อม หัวข้อตัวหนาสองบรรทัดเขียนว่า วงล้อเลขมงคล และ ลุ้นเครดิต 188 โดยเลข 188 เป็นสีทองมีมงกุฎอยู่ด้านบน ใต้หัวข้อเขียนว่า หมุนรับของรางวัล ก่อนซื้อหวยทุกวัน ด้านล่างเป็นปุ่มสีแดงเขียนว่า สิทธิ์พิเศษประจำวัน คู่กับไอคอนกล่องของขวัญ ด้านขวาบนเป็นวงล้อเสี่ยงโชคสีเขียวทองแบ่งเป็นช่องเขียนว่า 188 เครดิต 88 เครดิต 38 เครดิต 18 เครดิต ขอให้รวย ลุ้นโชค 2 เท่า เครดิตฟรี และ รางวัลพิเศษ ตรงกลางวงล้อเป็นโลโก้ หวยพร้อม มุมบนซ้ายเป็นโลโก้เขียนว่า หวย และ พร้อม พร้อมเครื่องหมายถูกสีแดง ข้อความด้านซ้ายเขียนว่า มากกว่าหวย คือความมั่นใจ และ เสี่ยงโชค สร้างโอกาส ให้ชีวิตดีขึ้น ด้านขวาเขียนว่า หมุนวันนี้ อาจเป็นคุณ ที่โชคดี แถบล่างสุดมีสี่หัวข้อเขียนว่า เล่นง่าย ไม่ยุ่งยาก จ่ายจริง มั่นใจได้ 100% รองรับมือถือ เล่นได้ทุกที่ ทุกเวลา และ หวยรัฐบาล หวยฮานอย หวยลาว หวยหุ้น ในภาพเป็นผู้หญิงในชุดเลื่อมสีเขียวเข้มที่มีโลโก้ หวยพร้อม กำลังถือลูกบอลหวยสีดำหมายเลข 8 และชี้มือมาข้างหน้า ฉากหลังเป็นแสงสีเขียวนีออนมีลูกบอลหวยหมายเลข 9 6 5 2 และ 8 เหรียญทอง ใบโคลเวอร์ และสลากกินแบ่งรัฐบาลกระจายอยู่",
  },
  {
    src: slide3,
    alt: "แบนเนอร์โปรโมชั่น หวยพร้อม หัวข้อตัวหนาสองบรรทัดเขียนว่า เช็กอิน 5 วัน โดยเลข 5 เป็นสีทอง และ รับเครดิตเพิ่ม ใต้หัวข้อเขียนว่า สะสมสิทธิ์รายวัน พร้อมลุ้นเลขเด่นทุกเช้า ถัดลงมาเป็นแถวการ์ดห้าใบเขียนว่า วันที่ 1 ถึง วันที่ 5 แต่ละใบมีเครื่องหมายถูกในวงกลมสีเขียว ด้านขวาของแถวการ์ดเป็นป้ายเขียนว่า DAILY CHECK-IN คู่กับไอคอนปฏิทิน ด้านบนกลางภาพเป็นโลโก้เขียนว่า หวย และ พร้อม พร้อมเครื่องหมายถูกสีแดง ถัดไปทางขวาเขียนว่า เช็กทุกวัน โชคดีทุกเช้า ที่ หวยพร้อม ข้อความด้านซ้ายล่างเขียนว่า เช็กอินวันนี้ รับเลยเครดิตฟรี ลุ้นเลขปังทุกวัน ด้านขวาล่างเขียนว่า เสี่ยงโชค สร้างโอกาส ให้ชีวิตดีขึ้น ในภาพเป็นผู้หญิงในชุดเลื่อมสีเขียวเข้มที่มีโลโก้ หวยพร้อม กำลังถือโทรศัพท์ที่แสดงโลโก้ หวยพร้อม และชี้มือไปที่แถวการ์ด ด้านล่างมีสลากกินแบ่งรัฐบาลวางเรียงกัน ฉากหลังเป็นเส้นขอบฟ้าเมืองสีเขียวนีออนมีลูกบอลหวยหมายเลข 6 9 2 3 และ 8 กับเหรียญทองลอยอยู่",
  },
  {
    src: slide4,
    alt: "แบนเนอร์โปรโมชั่น หวยพร้อม หัวข้อตัวหนาสองบรรทัดเขียนว่า ชวนเพื่อนลุ้นเฮง และ รับโบนัส ถัดลงมาเป็นตัวเลข 88 สีทองขนาดใหญ่ ใต้ตัวเลขเป็นแถบสีขาวเขียนว่า เพื่อนสมัครสำเร็จ รับเครดิตโบนัสทันที ถัดลงมาเขียนว่า ยิ่งชวน ยิ่งได้ลุ้น ด้านขวามีไอคอนแชร์และไอคอนเพิ่มเพื่อนคู่กับรูปเคอร์เซอร์ ด้านซ้ายเป็นกรอบข้อความเขียนว่า ชวนเลย ด้านบนกลางภาพเป็นโลโก้เขียนว่า หวย และ พร้อม พร้อมเครื่องหมายถูกสีแดง ใต้โลโก้เขียนว่า หวยรัฐบาล หวยฮานอย หวยลาว หวยหุ้น มุมบนขวาเขียนว่า ชวนเพื่อน สร้างโอกาส สร้างความเฮง ไปด้วยกัน ข้อความด้านซ้ายเขียนว่า เล่นหวย ได้เพื่อน ได้โชค ได้โบนัส ด้านขวาเขียนว่า เพื่อนเยอะ โชคเยอะ รวยไปด้วยกัน ด้านล่างเป็นกล่องของขวัญสีเขียวผูกโบว์ทองพิมพ์โลโก้ หวยพร้อม และข้อความ ชวนเพื่อน รับโบนัส 88 ในภาพเป็นผู้หญิงในชุดเลื่อมสีเขียวเข้มที่มีโลโก้ หวยพร้อม กำลังถือโทรศัพท์ที่แสดงโลโก้ หวยพร้อม ฉากหลังเป็นเส้นขอบฟ้าเมืองสีเขียวนีออนมีลูกบอลหวยหมายเลข 6 9 3 และ 8 เหรียญทอง และสลากกินแบ่งรัฐบาลวางอยู่",
  },
];

const COPIES = 3;
const slides = Array.from({ length: COPIES }, () => images).flat();
---

<div class="marquee mx-auto w-full max-w-[1301px] overflow-hidden px-4 py-5">
  <input id="carousel-pause" type="checkbox" class="peer sr-only" />
  <label
    for="carousel-pause"
    class="sr-only cursor-pointer peer-focus-visible:not-sr-only peer-focus-visible:mb-3 peer-focus-visible:inline-block peer-focus-visible:rounded-full peer-focus-visible:border peer-focus-visible:border-[#22c55e]/60 peer-focus-visible:px-4 peer-focus-visible:py-2 peer-focus-visible:text-sm peer-focus-visible:font-bold peer-focus-visible:text-[#f5c451]">
    หยุด / เล่นสไลด์ภาพ
  </label>

  <div class="marquee-track flex">
    {
      slides.map((slide, index) => {
        const isDuplicate = index >= images.length;
        return (
          <div class="marquee-slide" aria-hidden={isDuplicate ? "true" : undefined}>
            <Picture
              src={slide.src}
              alt={isDuplicate ? "" : slide.alt}
              class="block w-full rounded-xl border border-[#1e7a3a]/55 object-cover shadow-[0_10px_30px_rgba(34,197,94,0.25)]"
              width={slide.src.width}
              height={slide.src.height}
              loading="lazy"
              fetchpriority="low"
              decoding="async"
              widths={[200, 400, 600]}
              sizes="(max-width: 768px) 50vw, 33vw"
              formats={["avif", "webp"]}
              fallbackFormat="webp"
              quality={60}
            />
          </div>
        );
      })
    }
  </div>
</div>

<style>
  .marquee {
    --gap: 12px;
    --per-view: 2;
    --shift: calc(-200% - 24px);
  }

  @media (min-width: 768px) {
    .marquee {
      --gap: 16px;
      --per-view: 3;
      --shift: calc(-133.3333% - 21.3333px);
    }
  }

  .marquee-track {
    gap: var(--gap);
    width: 100%;
    animation: carousel-scroll 32s linear infinite;
    will-change: transform;
  }

  .marquee-slide {
    flex: 0 0 calc((100% - (var(--per-view) - 1) * var(--gap)) / var(--per-view));
  }

  @keyframes carousel-scroll {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(var(--shift));
    }
  }

  .marquee:hover .marquee-track,
  .marquee:focus-within .marquee-track,
  .marquee > input:checked ~ .marquee-track {
    animation-play-state: paused;
  }

  @media (prefers-reduced-motion: reduce) {
    .marquee-track {
      animation: none;
    }
  }
</style>
