---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;
const headingSize = HeadingTag === "h1" ? "text-3xl" : "text-2xl";

// text-center lives on the <header> ONLY, never on the card or the <section>.
// This file shipped that bug once: centering on an ancestor inherits straight
// into the slot and centers the body paragraph with it. House style is headings
// may be centered, paragraphs are always flush left at text-base.
//
// MAX56 neumorphic pair: the page ground (#0d0204) against the raised red-black
// tone (#2a070d), so the card still reads as extruded on the near-black crimson
// page. Matches ContentBoxSevenThreeNeumorphism and ContentBoxTwoNeumorphism.
---

<section class="relative z-10 my-6 flex w-full justify-center px-4 font-sans">
  <div
    class="w-full max-w-[1400px] rounded-[25px] border border-[#c10d1e]/25 bg-[#1a0508] p-8 text-left text-base leading-relaxed text-[#f6e4e4] shadow-[10px_10px_20px_#0d0204,-10px_-10px_20px_#2a070d]">
    {
      title && (
        <header class="mb-8 border-b border-[#c10d1e]/25 pb-4 text-center">
          <HeadingTag class={`bg-gradient-to-r from-[#ffe9a8] via-[#f5c451] to-[#c10d1e] bg-clip-text ${headingSize} leading-normal font-black tracking-wide text-transparent`}>{title}</HeadingTag>
        </header>
      )
    }
    <slot />
  </div>
</section>
