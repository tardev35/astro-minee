---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;
const headingSize = HeadingTag === "h1" ? "text-3xl" : "text-2xl";

// text-center lives on the <header> ONLY, never on the card or the <section>.
// This file shipped that bug once: centering on an ancestor inherits straight
// into the slot and centers the body paragraph with it. House style is headings
// may be centered, paragraphs are always flush left at text-base.
//
// HOT189 neumorphic pair: the page ground (#0d0402, the layout's own ink) casts
// the dark side of the extrusion, the panel tone (#2e100a) the lit side, so the
// card reads as raised off the ember-black page. Matches
// ContentBoxSevenThreeNeumorphism, ContentBox3ThreeNeumorphism and
// ContentBoxTwoNeumorphism so the four read as one system.
//
// Two-tone split held across every box this brand renders: flame red carries the
// surfaces (border, rules, glows), gold carries the type.
---

<section class="relative z-10 my-6 flex w-full justify-center px-4 font-sans">
  <div
    class="w-full max-w-[1400px] rounded-[25px] border border-[#ef2b09]/35 bg-[#1c0705] p-8 text-left text-base leading-relaxed text-[#ffe9cf] shadow-[10px_10px_20px_#0d0402,-10px_-10px_20px_#2e100a]">
    {
      title && (
        <header class="mb-8 border-b border-[#ef2b09]/35 pb-4 text-center">
          <HeadingTag class={`bg-gradient-to-r from-[#ffe86b] via-[#fcd304] to-[#c99400] bg-clip-text ${headingSize} leading-normal font-black tracking-wide text-transparent`}>{title}</HeadingTag>
        </header>
      )
    }
    <slot />
  </div>
</section>
