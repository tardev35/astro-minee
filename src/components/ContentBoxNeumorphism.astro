---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h2" } = Astro.props;
const headingSize = HeadingTag === "h1" ? "text-3xl" : "text-2xl";

// `as` defaults to "h2" because the docx is flat H1 + H2 and only the one block
// carrying the page title asks for "h1" explicitly. A default of "h1" is how a
// second <h1> reaches an indexable page without anyone typing one.
//
// text-center lives on the <header> ONLY, never on the card or the <section>.
// This file shipped that bug once: centering on an ancestor inherits straight
// into the slot and centers the body paragraph with it. House style is headings
// may be centered, paragraphs are always flush left at text-base.
//
// No slot wrapper — the card carries the body text classes itself and the slot
// renders as its direct child. Do not re-add a `relative z-10` div.
//
// หวยพร้อม neumorphic pair: the page ink (#04140a) casts the dark side of the
// extrusion and the lifted surface (#10361c) the lit side, so the card reads as
// raised off the near-black green page. Matches ContentBoxTwoNeumorphism,
// ContentBox3ThreeNeumorphism and ContentBoxSevenThreeNeumorphism so the four
// read as one raised system.
//
// Green carries every surface (border, rule, extrusion) and the soft green-white
// body copy sits on the card. The heading ramp runs green-white → neon green →
// prize gold, the artwork's own ramp. The red in the wordmark's tick stays out
// of here: it is reserved for calls to action.
---

<section class="relative z-10 my-6 flex w-full justify-center px-4 font-sans">
  <div
    class="w-full max-w-[1400px] rounded-[25px] border border-[#1e7a3a]/45 bg-[#0a2413] p-8 text-left text-base leading-relaxed text-[#d8efdc] shadow-[10px_10px_20px_#04140a,-10px_-10px_20px_#10361c]">
    {
      title && (
        <header class="mb-8 border-b border-[#1e7a3a]/45 pb-4 text-center">
          <HeadingTag class={`bg-gradient-to-r from-[#d8efdc] via-[#22c55e] to-[#f5c451] bg-clip-text ${headingSize} leading-normal font-black tracking-wide text-transparent`}>{title}</HeadingTag>
        </header>
      )
    }
    <slot />
  </div>
</section>
