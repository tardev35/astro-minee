---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;
const headingSize = HeadingTag === "h1" ? "text-3xl" : "text-2xl";
---

<section class="relative z-10 my-6 flex w-full justify-center px-4 font-sans">
  <div
    class="w-full max-w-[1400px] rounded-[25px] border border-[#3a2e1c]/70 bg-[#15110b] p-8 text-left text-base leading-relaxed text-[#f4e3c8] shadow-[10px_10px_20px_#040302,-10px_-10px_20px_#241a10]">
    {
      title && (
        <header class="mb-8 border-b border-[#e8b43a]/25 pb-4 text-center">
          <HeadingTag
            class={`bg-gradient-to-r from-[#f7d97a] via-[#e8b43a] to-[#a9741c] bg-clip-text ${headingSize} leading-normal font-black tracking-wide text-transparent`}>
            {title}
          </HeadingTag>
        </header>
      )
    }
    <slot />
  </div>
</section>
