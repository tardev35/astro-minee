---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;
const headingSize = HeadingTag === "h1" ? "text-3xl" : "text-2xl";

// text-center lives on the <header> ONLY, never on the card or the <section>.
// This file shipped that bug once: centering on an ancestor inherits straight
// into the slot and centers the body paragraph with it. House style is headings
// may be centered, paragraphs are always flush left at text-base.
//
// The neumorphic pair is the page ground (#1a0c03) against the raised honey
// tone (#3d1a08) so the card still reads as extruded on the deep-brown page.
---

<section class="relative z-10 my-6 flex w-full justify-center px-4 font-sans">
  <div
    class="w-full max-w-[1400px] rounded-[25px] border border-[#f7cf7e]/25 bg-[#2a1206] p-8 text-left text-base leading-relaxed text-[#fdf0d8] shadow-[10px_10px_20px_#1a0c03,-10px_-10px_20px_#3d1a08]">
    {
      title && (
        <header class="mb-8 border-b border-[#eb9413]/25 pb-4 text-center">
          <HeadingTag class={`bg-gradient-to-r from-[#fff1cc] via-[#f7cf7e] to-[#eb9413] bg-clip-text ${headingSize} leading-normal font-black tracking-wide text-transparent`}>{title}</HeadingTag>
        </header>
      )
    }
    <slot />
  </div>
</section>
