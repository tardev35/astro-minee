---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;
const headingSize = HeadingTag === "h1" ? "text-3xl" : "text-2xl";
---

<section class="relative z-10 my-6 flex w-full justify-center px-4 font-sans">
  <div
    class="w-full max-w-[1400px] rounded-[25px] border border-[#a3e635]/25 bg-[#0a2411] p-8 text-left text-base leading-relaxed text-[#e2f3cd] shadow-[10px_10px_20px_#010a04,-10px_-10px_20px_#16391f]">
    {
      title && (
        <header class="mb-8 border-b border-[#ffd54a]/25 pb-4 text-center">
          <HeadingTag
            class={`bg-gradient-to-r from-[#e8fb9c] via-[#a3e635] to-[#ffd54a] bg-clip-text ${headingSize} leading-normal font-black tracking-wide text-transparent`}>
            {title}
          </HeadingTag>
        </header>
      )
    }
    <slot />
  </div>
</section>
