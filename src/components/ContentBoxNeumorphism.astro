---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h2" } = Astro.props;
const headingSize = HeadingTag === "h1" ? "text-3xl" : "text-2xl";

// `as` defaults to "h2" because the docx is flat H1 + H2 and only the one block
// carrying the page title asks for "h1" explicitly. A default of "h1" is how a
// second <h1> reaches an indexable page without anyone typing one.
//
// text-center lives on the <header> ONLY, never on the card or the <section>.
// This file shipped that bug once: centering on an ancestor inherits straight
// into the slot and centers the body paragraph with it. House style is headings
// may be centered, paragraphs are always flush left at text-base.
//
// No slot wrapper — the card carries the body text classes itself and the slot
// renders as its direct child. Do not re-add a `relative z-10` div.
//
// RENGER8888 neumorphic pair: the page ink (#080203) casts the dark side of the
// extrusion and the card surface (#28080b) the lit side, so the card reads as
// lifted off the near-black maroon page. Matches ContentBoxTwoNeumorphism and
// ContentBoxSevenThreeNeumorphism so the three read as one raised system.
//
// Crimson carries every surface (border, rule, extrusion) and the warm off-white
// body copy sits on the card. The heading ramp runs steel silver → crimson →
// blood red, the wordmark's own bevel.
---

<section class="relative z-10 my-6 flex w-full justify-center px-4 font-sans">
  <div
    class="w-full max-w-[1400px] rounded-[25px] border border-[#e8121f]/35 bg-[#160406] p-8 text-left text-base leading-relaxed text-[#f0dcdc] shadow-[10px_10px_20px_#080203,-10px_-10px_20px_#28080b]">
    {
      title && (
        <header class="mb-8 border-b border-[#e8121f]/35 pb-4 text-center">
          <HeadingTag class={`bg-gradient-to-r from-[#e6ecf2] via-[#e8121f] to-[#8f0c14] bg-clip-text ${headingSize} leading-normal font-black tracking-wide text-transparent`}>{title}</HeadingTag>
        </header>
      )
    }
    <slot />
  </div>
</section>
