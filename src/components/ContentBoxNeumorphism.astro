---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;
const headingSize = HeadingTag === "h1" ? "text-3xl" : "text-2xl";
---

<section class="relative z-10 my-6 flex w-full justify-center px-4 font-sans">
  <div
    class="w-full max-w-[1400px] rounded-[25px] border border-[#a855f7]/25 bg-[#0d0a2b] p-8 text-left text-base leading-relaxed text-[#cfe3f5] shadow-[10px_10px_20px_#03010f,-10px_-10px_20px_#161046]">
    {
      title && (
        <header class="mb-8 border-b border-[#22d3ee]/25 pb-4 text-center">
          <HeadingTag
            class={`bg-gradient-to-r from-[#a5f3fc] via-[#22d3ee] to-[#a855f7] bg-clip-text ${headingSize} leading-normal font-black tracking-wide text-transparent`}>
            {title}
          </HeadingTag>
        </header>
      )
    }
    <slot />
  </div>
</section>
