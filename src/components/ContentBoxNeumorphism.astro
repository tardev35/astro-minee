---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h2" } = Astro.props;
const headingSize = HeadingTag === "h1" ? "text-3xl" : "text-2xl";

// `as` defaults to "h2" because the docx is flat H1 + H2 and only the one block
// carrying the page title asks for "h1" explicitly. A default of "h1" is how a
// second <h1> reaches an indexable page without anyone typing one.
//
// text-center lives on the <header> ONLY, never on the card or the <section>.
// This file shipped that bug once: centering on an ancestor inherits straight
// into the slot and centers the body paragraph with it. House style is headings
// may be centered, paragraphs are always flush left at text-base.
//
// No slot wrapper — the card carries the body text classes itself and the slot
// renders as its direct child. Do not re-add a `relative z-10` div.
//
// TT1BET neumorphic pair: the page ink (#0b0805) casts the dark side of the
// extrusion and the raised warm surface (#241a0d) the lit side, so the card
// reads as lifted off the warm near-black page. Matches
// ContentBoxSevenThreeNeumorphism and ContentBoxTwoNeumorphism so all three read
// as one raised system.
//
// Bronze deep carries every surface rule and the ivory body copy sits on the
// card. The heading ramp runs gold pale -> primary gold -> bronze, the artwork's
// own ramp off the brushed-silver-and-gold wordmark. The crimson (#9e1b13) stays
// out of here: it is the rare second accent, not a section colour.
---

<section class="relative z-10 my-6 flex w-full justify-center px-4 font-sans">
  <div
    class="w-full max-w-[1400px] rounded-[25px] border border-[#6d4a13]/55 bg-[#171008] p-8 text-left text-base leading-relaxed text-[#f2e7cd] shadow-[10px_10px_20px_#0b0805,-10px_-10px_20px_#241a0d]">
    {
      title && (
        <header class="mb-8 border-b border-[#6d4a13]/55 pb-4 text-center">
          <HeadingTag class={`bg-gradient-to-r from-[#fff8d6] via-[#e9c341] to-[#b8862a] bg-clip-text ${headingSize} leading-normal font-black tracking-wide text-transparent`}>{title}</HeadingTag>
        </header>
      )
    }
    <slot />
  </div>
</section>
