---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;
const headingSize = HeadingTag === "h1" ? "text-3xl" : "text-2xl";

// text-center lives on the <header> ONLY, never on the card or the <section>.
// This file shipped that bug once: centering on an ancestor inherits straight
// into the slot and centers the body paragraph with it. House style is headings
// may be centered, paragraphs are always flush left at text-base.
//
// FINN20 neumorphic pair: the page ground (#080705, the layout's own ink) casts
// the dark side of the extrusion and the panel tone (#1f1a10) the lit side, so
// the card reads as raised off the near-black page. Matches
// ContentBoxSevenThreeNeumorphism and ContentBoxTwoNeumorphism so the three read
// as one system.
//
// Two-tone split held across every box this brand renders: gold carries the
// surfaces (border, rules, glows) and the warm-ivory body copy sits on the card.
---

<section class="relative z-10 my-6 flex w-full justify-center px-4 font-sans">
  <div
    class="w-full max-w-[1400px] rounded-[25px] border border-[#fdd323]/35 bg-[#14110a] p-8 text-left text-base leading-relaxed text-[#f3e7c8] shadow-[10px_10px_20px_#080705,-10px_-10px_20px_#1f1a10]">
    {
      title && (
        <header class="mb-8 border-b border-[#fdd323]/35 pb-4 text-center">
          <HeadingTag class={`bg-gradient-to-r from-[#ffe98a] via-[#fdd323] to-[#e39d02] bg-clip-text ${headingSize} leading-normal font-black tracking-wide text-transparent`}>{title}</HeadingTag>
        </header>
      )
    }
    <slot />
  </div>
</section>
