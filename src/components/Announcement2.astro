---
// This default IS the copy that ships on every page except the homepage: the
// sub-pages call <Announcement /> with no props. It has to be the current
// brand's wording, never whatever brand shipped this variant last.
//
// No leading emoji: the marquee renders `message` three times, so an emoji baked
// into the string is announced three times and cannot be marked aria-hidden. No
// domain either — verify-build.mjs fails the build on an off-domain URL.
const {
  message = "ORA2U รวมเกมสล็อตและเกมคาสิโนออนไลน์หลายรูปแบบไว้ในระบบเดียว เลือกเกมจากธีม ฟีเจอร์ และระดับเดิมพันได้จากหน้าเดียว • หากเพิ่งเริ่มควรเลือกเกมที่กติกาชัดเจนและวงเงินต่อรอบไม่สูงเกินงบ เพื่อทำความเข้าใจรูปแบบการจ่ายก่อนขยับไปเกมที่ซับซ้อนขึ้น • โปรทุนน้อยควรดูยอดเริ่มต้น เกมที่ร่วมรายการ และเงื่อนไขการถอนร่วมกัน โบนัสที่ดูสูงอาจไม่เหมาะที่สุดหากมีข้อกำหนดซับซ้อน • ระบบออโต้ช่วยตรวจยอด ประวัติธุรกรรม และสถานะรายการได้จากที่เดียว ก่อนยืนยันควรตรวจชื่อบัญชีและจำนวนเงินให้ถูกต้อง • คำว่าแตกง่ายและจ่ายไวไม่ใช่การรับประกันผล ควรกำหนดงบและศึกษากติกาก่อนเริ่มใช้งานทุกครั้ง",
} = Astro.props;
---

<div class="relative mx-auto flex h-[42px] max-w-[900px] items-center overflow-hidden rounded-sm bg-[#0b0501] shadow-[0_4px_15px_rgba(0,0,0,0.5)]">
  <div class="relative z-10 flex h-full items-center bg-gradient-to-r from-[#b15d01] to-[#fe9a00] px-6 pl-4 [clip-path:polygon(0_0,100%_0,85%_100%,0_100%)] md:px-8">
    <div class="flex items-center gap-2">
      <span class="relative flex h-2.5 w-2.5">
        <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-[#fdf3da] opacity-75"></span>
        <span class="relative inline-flex h-2.5 w-2.5 rounded-full bg-[#fdf3da]"></span>
      </span>
      <span class="font-black tracking-widest text-[#2a1502] italic drop-shadow-md">HOT</span>
    </div>
  </div>

  <div class="relative flex-1 overflow-hidden">
    <div class="absolute inset-y-0 left-0 z-10 w-8 bg-gradient-to-r from-[#0b0501] to-transparent"></div>
    <div class="absolute inset-y-0 right-0 z-10 w-8 bg-gradient-to-l from-[#0b0501] to-transparent"></div>

    <div class="flex w-max animate-[scroll_20s_linear_infinite] items-center gap-10 pl-4 text-sm font-bold whitespace-nowrap text-[#f6e6cf]/90 md:text-base">
      <span>{message}</span>
      <span>{message}</span>
      <span>{message}</span>
    </div>
  </div>

  <div class="absolute bottom-0 left-0 h-[2px] w-full bg-gradient-to-r from-[#ffd76a] via-[#fe9a00] to-transparent"></div>
</div>

<style>
  @keyframes scroll {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(calc(-33.33% - 13px));
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .animate-\[scroll_20s_linear_infinite\],
    .animate-ping {
      animation: none;
    }
  }
</style>
