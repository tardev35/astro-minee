---
export interface Props {
  title?: string;
  titleleft?: string;
  titleright?: string;
  label?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, titleleft, titleright, label, as } = Astro.props;
const TitleTag = as ?? "p";
const intro = Astro.slots.has("default") ? (await Astro.slots.render("default")).trim() : "";

// `titleleft`/`titleright` are docx section headings handed down by the page, so
// they render as <h2> — the rendered heading inventory is diffed against the
// brief on every rebrand and these are the brief's own H2s. `title` is the
// optional centered banner line above the grid, which is chrome, so it stays a
// <p>; `label` (or whichever title is present) names the region for assistive
// tech via the section's aria-label.
//
// TAKO168: the clipped frame runs gold at the top-left and bright red at the
// bottom-right, matching ContentBoxCyberCut so the two CyberCut sections read as
// one family.
const sectionLabel = label ?? title ?? titleleft ?? titleright ?? "ข้อมูลประกอบ";
---

<section aria-label={sectionLabel} class="mx-auto mb-6 w-full max-w-7xl px-4 font-sans">
  <div
    class="relative isolate w-full border border-[#e11d16]/30 bg-[#1a0806]/92 p-8 text-[#f6e5df] shadow-[0_10px_30px_rgba(225,29,22,0.22)] backdrop-blur-md transition-all duration-300 hover:border-[#e8b23a]/55 hover:shadow-[0_15px_40px_rgba(232,178,58,0.28)]"
    style="clip-path: polygon(30px 0, 100% 0, 100% calc(100% - 30px), calc(100% - 30px) 100%, 0 100%, 0 30px);">
    <div aria-hidden="true" class="absolute top-0 left-0 -z-10 h-[2px] w-24 bg-gradient-to-r from-[#e8b23a] to-transparent"></div>
    <div aria-hidden="true" class="absolute right-0 bottom-0 -z-10 h-[2px] w-24 bg-gradient-to-l from-[#ff6a5a] to-transparent"></div>
    <div aria-hidden="true" class="absolute top-0 left-0 -z-10 h-16 w-[2px] bg-gradient-to-b from-[#e8b23a] to-transparent"></div>
    <div aria-hidden="true" class="absolute right-0 bottom-0 -z-10 h-16 w-[2px] bg-gradient-to-t from-[#ff6a5a] to-transparent"></div>

    {
      title && (
        <TitleTag class="mb-4 bg-gradient-to-r from-[#ffd97a] via-[#e8b23a] to-[#ff6a5a] bg-clip-text text-center text-2xl leading-normal font-black text-transparent uppercase">{title}</TitleTag>
      )
    }

    {intro && <div class="mb-8 text-left text-base leading-relaxed text-[#f6e5df]" set:html={intro} />}

    <div class="grid grid-cols-1 gap-8 md:grid-cols-2">
      <article class="relative flex flex-col gap-4 text-left text-base leading-relaxed text-[#f6e5df]">
        {
          titleleft && (
            <h2 class="flex items-center gap-2 border-b border-[#e11d16]/30 pb-2 text-xl leading-normal font-black text-[#e8b23a] uppercase">
              <span aria-hidden="true" class="inline-block h-2 w-2 shrink-0 bg-[#ff6a5a] shadow-[0_0_5px_rgba(255,106,90,0.7)]" /> {titleleft}
            </h2>
          )
        }
        <slot name="left" />
      </article>

      <article class="relative flex flex-col gap-4 text-left text-base leading-relaxed text-[#f6e5df] md:border-l md:border-[#e11d16]/30 md:pl-8">
        {
          titleright && (
            <h2 class="flex items-center gap-2 border-b border-[#e11d16]/30 pb-2 text-xl leading-normal font-black text-[#e8b23a] uppercase">
              <span aria-hidden="true" class="inline-block h-2 w-2 shrink-0 bg-[#e8b23a] shadow-[0_0_5px_rgba(232,178,58,0.8)]" /> {titleright}
            </h2>
          )
        }
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
