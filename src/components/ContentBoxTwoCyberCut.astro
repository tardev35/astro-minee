---
export interface Props {
  title?: string;
  titleleft?: string;
  titleright?: string;
  label?: string;
}
const { title, titleleft, titleright, label } = Astro.props;
const intro = Astro.slots.has("default") ? (await Astro.slots.render("default")).trim() : "";

// `titleleft`/`titleright` are docx section headings handed down by the page, so
// they render as <h2> — the rendered heading inventory is diffed against the
// brief on every rebrand and these are the brief's own H2s. `title` is the
// optional centered banner line above the grid, which is chrome, so it stays a
// <p>; `label` (or whichever title is present) names the region for assistive
// tech via the section's aria-label.
const sectionLabel = label ?? title ?? titleleft ?? titleright ?? "ข้อมูลประกอบ";
---

<section aria-label={sectionLabel} class="mx-auto mb-6 w-full max-w-7xl px-4 font-sans">
  <div
    class="relative isolate w-full border border-[#12a34f]/30 bg-[#072b14]/92 p-8 text-[#e8f3e0] shadow-[0_10px_30px_rgba(18,163,79,0.18)] backdrop-blur-md transition-all duration-300 hover:border-[#1fc465]/55 hover:shadow-[0_15px_40px_rgba(18,163,79,0.28)]"
    style="clip-path: polygon(30px 0, 100% 0, 100% calc(100% - 30px), calc(100% - 30px) 100%, 0 100%, 0 30px);">
    <div class="absolute top-0 left-0 -z-10 h-[2px] w-24 bg-gradient-to-r from-[#9fcf3a] to-transparent"></div>
    <div class="absolute right-0 bottom-0 -z-10 h-[2px] w-24 bg-gradient-to-l from-[#f5c518] to-transparent"></div>
    <div class="absolute top-0 left-0 -z-10 h-16 w-[2px] bg-gradient-to-b from-[#9fcf3a] to-transparent"></div>
    <div class="absolute right-0 bottom-0 -z-10 h-16 w-[2px] bg-gradient-to-t from-[#f5c518] to-transparent"></div>

    {
      title && (
        <p class="mb-4 bg-gradient-to-r from-[#ffdf7a] via-[#f5c518] to-[#b8860b] bg-clip-text text-center text-2xl leading-normal font-black text-transparent uppercase">
          {title}
        </p>
      )
    }

    {intro && <div class="mb-8 text-left text-base leading-relaxed text-[#e8f3e0]" set:html={intro} />}

    <div class="grid grid-cols-1 gap-8 md:grid-cols-2">
      <article class="relative flex flex-col gap-4 text-left text-base leading-relaxed text-[#e8f3e0]">
        {
          titleleft && (
            <h2 class="flex items-center gap-2 border-b border-[#12a34f]/30 pb-2 text-xl leading-normal font-black text-[#9fcf3a] uppercase">
              <span aria-hidden="true" class="inline-block h-2 w-2 shrink-0 bg-[#9fcf3a] shadow-[0_0_5px_rgba(159,207,58,0.7)]" /> {titleleft}
            </h2>
          )
        }
        <slot name="left" />
      </article>

      <article class="relative flex flex-col gap-4 text-left text-base leading-relaxed text-[#e8f3e0] md:border-l md:border-[#12a34f]/30 md:pl-8">
        {
          titleright && (
            <h2 class="flex items-center gap-2 border-b border-[#12a34f]/30 pb-2 text-xl leading-normal font-black text-[#9fcf3a] uppercase">
              <span aria-hidden="true" class="inline-block h-2 w-2 shrink-0 bg-[#f5c518] shadow-[0_0_5px_rgba(245,197,24,0.8)]" /> {titleright}
            </h2>
          )
        }
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
