---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h2" } = Astro.props;
---

<section class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  <div
    class="group relative isolate w-full overflow-hidden rounded-3xl border border-[#a3e635]/25 bg-[#04150a]/92 p-6 text-[#e2f3cd] shadow-[0_10px_30px_rgba(163,230,53,0.16)] backdrop-blur-xl transition-all duration-500 hover:border-[#a3e635]/50 md:p-10">
    <div
      aria-hidden="true"
      class="pointer-events-none absolute top-0 left-1/2 -z-10 h-[2px] w-1/2 -translate-x-1/2 bg-gradient-to-r from-transparent via-[#a3e635] to-transparent opacity-60 transition-opacity duration-500 group-hover:opacity-100">
    </div>

    {
      title && (
        <header class="mb-8 flex items-center gap-4 border-b border-[#a3e635]/25 pb-4">
          <div class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#e8fb9c] to-[#ffd54a] shadow-[0_0_10px_rgba(163,230,53,0.45)]" />
          <HeadingTag class="bg-gradient-to-r from-[#e8fb9c] via-[#a3e635] to-[#ffd54a] bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase">
            {title}
          </HeadingTag>
        </header>
      )
    }

    <div class="grid grid-cols-1 gap-6 lg:grid-cols-2 lg:gap-10">
      <article
        class="relative flex gap-4 rounded-2xl border border-[#a3e635]/20 bg-[#0a2411]/95 p-6 text-left text-base leading-relaxed text-[#e2f3cd] transition-all duration-300 hover:-translate-y-2 hover:border-[#a3e635]/50 hover:bg-[#123018]/90 hover:shadow-[0_15px_40px_rgba(163,230,53,0.28)]">
        <div
          aria-hidden="true"
          class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl border border-[#a3e635]/30 bg-gradient-to-br from-[#e8fb9c] via-[#a3e635] to-[#4d7c0f] text-2xl shadow-[0_5px_15px_rgba(163,230,53,0.28)]">
          🔐
        </div>
        <slot name="left" />
      </article>

      <article
        class="relative flex gap-4 rounded-2xl border border-[#ffd54a]/20 bg-[#0a2411]/95 p-6 text-left text-base leading-relaxed text-[#e2f3cd] transition-all duration-300 hover:-translate-y-2 hover:border-[#ffd54a]/50 hover:bg-[#123018]/90 hover:shadow-[0_15px_40px_rgba(255,213,74,0.28)]">
        <div
          aria-hidden="true"
          class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl border border-[#ffd54a]/50 bg-gradient-to-br from-[#ffeaa0] via-[#ffd54a] to-[#c9911a] text-2xl shadow-[0_5px_15px_rgba(255,213,74,0.3)]">
          🛡️
        </div>
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
