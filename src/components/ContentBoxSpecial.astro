---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  /** Emoji for the left / right icon tiles. Decorative — both tiles carry
   *  aria-hidden, so these never reach the accessibility tree. */
  iconleft?: string;
  iconright?: string;
}
const { title, as: HeadingTag = "h2", iconleft = "🎰", iconright = "🃏" } = Astro.props;

// Two halves of one docx section: the left card takes the bright end of the
// MVP928 ramp (chrome -> gold), the right card the deep copper end. Both tiles
// use a bright-to-deep fill, so their glyph colour is picked against the middle
// of that fill (#1c0e05 on the gold, #f7ece2 on the copper) — getting that
// backwards is the unreadable-button bug this template's spec calls out by name.
//
// The two wrappers a consumer passes into slot="left"/slot="right" must STAY:
// each is a flex sibling of the icon box, so passing loose <p> children would
// turn every paragraph into its own flex item beside the icon.
---

<section class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  <div
    class="group relative isolate w-full overflow-hidden rounded-3xl border border-[#ef6a17]/30 bg-[#0b0502]/92 p-6 text-[#ece0d6] shadow-[0_10px_30px_rgba(239,106,23,0.2)] backdrop-blur-xl transition-all duration-500 hover:border-[#f0b243]/55 md:p-10">
    <div
      aria-hidden="true"
      class="pointer-events-none absolute top-0 left-1/2 -z-10 h-[2px] w-1/2 -translate-x-1/2 bg-gradient-to-r from-transparent via-[#ef6a17] to-transparent opacity-60 transition-opacity duration-500 group-hover:opacity-100">
    </div>

    {
      title && (
        <header class="mb-8 flex items-center gap-4 border-b border-[#ef6a17]/30 pb-4">
          <div aria-hidden="true" class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#f0b243] to-[#8f4a12] shadow-[0_0_10px_rgba(239,106,23,0.45)]" />
          <HeadingTag class="bg-gradient-to-r from-[#eaeef3] via-[#f0b243] to-[#ef6a17] bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase">{title}</HeadingTag>
        </header>
      )
    }

    <div class="grid grid-cols-1 gap-6 lg:grid-cols-2 lg:gap-10">
      <article
        class="relative flex gap-4 rounded-2xl border border-[#ef6a17]/30 bg-[#1c0e05]/95 p-6 text-left text-base leading-relaxed text-[#ece0d6] transition-all duration-300 hover:-translate-y-2 hover:border-[#f0b243]/55 hover:bg-[#2a1508]/90 hover:shadow-[0_15px_40px_rgba(239,106,23,0.24)]">
        <div
          aria-hidden="true"
          class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl border border-[#ef6a17]/45 bg-gradient-to-br from-[#f7ece2] via-[#f5cc8a] to-[#f0b243] text-2xl text-[#1c0e05] shadow-[0_5px_15px_rgba(239,106,23,0.28)]">
          {iconleft}
        </div>
        <slot name="left" />
      </article>

      <article
        class="relative flex gap-4 rounded-2xl border border-[#b34a08]/40 bg-[#1c0e05]/95 p-6 text-left text-base leading-relaxed text-[#ece0d6] transition-all duration-300 hover:-translate-y-2 hover:border-[#ef6a17]/55 hover:bg-[#2a1508]/90 hover:shadow-[0_15px_40px_rgba(179,74,8,0.32)]">
        <div
          aria-hidden="true"
          class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl border border-[#fb8b32]/40 bg-gradient-to-br from-[#b34a08] to-[#8f4a12] text-2xl text-[#f7ece2] shadow-[0_5px_15px_rgba(179,74,8,0.35)]">
          {iconright}
        </div>
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
