---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  /** Emoji for the left / right icon tiles. Decorative — both tiles carry
   *  aria-hidden, so these never reach the accessibility tree. */
  iconleft?: string;
  iconright?: string;
}
const { title, as: HeadingTag = "h2", iconleft = "🎰", iconright = "🃏" } = Astro.props;

// Two halves of one docx section: the left card takes the bright end of the
// PRODED888 ramp (ivory -> gold), the right card the navy end. Both tiles use a
// two-stop fill, so their glyph colour is picked against the middle of that fill
// (#070b20 on the gold, #faf3de on the navy) — getting that backwards is the
// unreadable-button bug this template's spec calls out by name.
//
// Each <article> is a flex row: the icon box and the slot content are siblings,
// so a consumer passes exactly ONE element per slot. Do not add a wrapper inside
// the component and do not pass loose siblings into a slot.
---

<section class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  <div
    class="group relative isolate w-full overflow-hidden rounded-3xl border border-[#e3b53f]/30 bg-[#070b20]/92 p-6 text-[#ece0c2] shadow-[0_10px_30px_rgba(227,181,63,0.2)] backdrop-blur-xl transition-all duration-500 hover:border-[#f8de91]/55 md:p-10">
    <div
      aria-hidden="true"
      class="pointer-events-none absolute top-0 left-1/2 -z-10 h-[2px] w-1/2 -translate-x-1/2 bg-gradient-to-r from-transparent via-[#e3b53f] to-transparent opacity-60 transition-opacity duration-500 group-hover:opacity-100">
    </div>

    {
      title && (
        <header class="mb-8 flex items-center gap-4 border-b border-[#e3b53f]/30 pb-4">
          <div aria-hidden="true" class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#f8de91] to-[#8f6614] shadow-[0_0_10px_rgba(227,181,63,0.45)]" />
          <HeadingTag class="bg-gradient-to-r from-[#dbe3f5] via-[#f8de91] to-[#e3b53f] bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase">{title}</HeadingTag>
        </header>
      )
    }

    <div class="grid grid-cols-1 gap-6 lg:grid-cols-2 lg:gap-10">
      <article
        class="relative flex gap-4 rounded-2xl border border-[#e3b53f]/30 bg-[#0d1338]/95 p-6 text-left text-base leading-relaxed text-[#ece0c2] transition-all duration-300 hover:-translate-y-2 hover:border-[#f8de91]/55 hover:bg-[#18225c]/90 hover:shadow-[0_15px_40px_rgba(227,181,63,0.24)]">
        <div
          aria-hidden="true"
          class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl border border-[#e3b53f]/45 bg-gradient-to-br from-[#faf3de] via-[#f8de91] to-[#e3b53f] text-2xl text-[#070b20] shadow-[0_5px_15px_rgba(227,181,63,0.28)]">
          {iconleft}
        </div>
        <slot name="left" />
      </article>

      <article
        class="relative flex gap-4 rounded-2xl border border-[#2a3a8f]/60 bg-[#0d1338]/95 p-6 text-left text-base leading-relaxed text-[#ece0c2] transition-all duration-300 hover:-translate-y-2 hover:border-[#e3b53f]/55 hover:bg-[#18225c]/90 hover:shadow-[0_15px_40px_rgba(42,58,143,0.4)]">
        <div
          aria-hidden="true"
          class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl border border-[#f8de91]/40 bg-gradient-to-br from-[#2a3a8f] to-[#18225c] text-2xl text-[#faf3de] shadow-[0_5px_15px_rgba(42,58,143,0.45)]">
          {iconright}
        </div>
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
