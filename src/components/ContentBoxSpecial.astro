---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  /** Emoji for the left / right icon tiles. Decorative — both tiles carry
   *  aria-hidden, so these never reach the accessibility tree. */
  iconleft?: string;
  iconright?: string;
}
const { title, as: HeadingTag = "h2", iconleft = "🎰", iconright = "🛡️" } = Astro.props;

// Two halves of one docx section: the left card takes the molten tile, the right
// card the scarlet one. Both tiles use a bright-to-mid fill, so their text
// colour is picked against the middle of that fill (#120303 on molten, #ffffff
// on scarlet) — getting that backwards is the unreadable-button bug this
// template's spec calls out by name. LAVA432 has no gold: the inherited gold
// ramp became molten orange.
//
// The two wrappers a consumer passes into slot="left"/slot="right" must STAY:
// each is a flex sibling of the icon box, so passing loose <p> children would
// turn every paragraph into its own flex item beside the icon.
---

<section class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  <div
    class="group relative isolate w-full overflow-hidden rounded-3xl border border-[#ec000e]/25 bg-[#120303]/92 p-6 text-[#f4e3e0] shadow-[0_10px_30px_rgba(236,0,14,0.2)] backdrop-blur-xl transition-all duration-500 hover:border-[#ff6a13]/50 md:p-10">
    <div
      aria-hidden="true"
      class="pointer-events-none absolute top-0 left-1/2 -z-10 h-[2px] w-1/2 -translate-x-1/2 bg-gradient-to-r from-transparent via-[#ff6a13] to-transparent opacity-60 transition-opacity duration-500 group-hover:opacity-100">
    </div>

    {
      title && (
        <header class="mb-8 flex items-center gap-4 border-b border-[#ec000e]/25 pb-4">
          <div aria-hidden="true" class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#ffa040] to-[#7a0206] shadow-[0_0_10px_rgba(255,106,19,0.45)]" />
          <HeadingTag class="bg-gradient-to-r from-[#ffffff] via-[#ffa040] to-[#ff6a13] bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase">{title}</HeadingTag>
        </header>
      )
    }

    <div class="grid grid-cols-1 gap-6 lg:grid-cols-2 lg:gap-10">
      <article
        class="relative flex gap-4 rounded-2xl border border-[#ff6a13]/25 bg-[#1c0505]/95 p-6 text-left text-base leading-relaxed text-[#f4e3e0] transition-all duration-300 hover:-translate-y-2 hover:border-[#ff6a13]/55 hover:bg-[#2a0808]/90 hover:shadow-[0_15px_40px_rgba(255,106,19,0.24)]">
        <div
          aria-hidden="true"
          class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl border border-[#ff6a13]/40 bg-gradient-to-br from-[#ffa040] via-[#ff6a13] to-[#ff3d2e] text-2xl text-[#120303] shadow-[0_5px_15px_rgba(255,106,19,0.28)]">
          {iconleft}
        </div>
        <slot name="left" />
      </article>

      <article
        class="relative flex gap-4 rounded-2xl border border-[#ec000e]/25 bg-[#1c0505]/95 p-6 text-left text-base leading-relaxed text-[#f4e3e0] transition-all duration-300 hover:-translate-y-2 hover:border-[#ff3d2e]/55 hover:bg-[#2a0808]/90 hover:shadow-[0_15px_40px_rgba(236,0,14,0.3)]">
        <div
          aria-hidden="true"
          class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl border border-[#ff3d2e]/40 bg-gradient-to-br from-[#ff3d2e] via-[#ec000e] to-[#7a0206] text-2xl text-[#ffffff] shadow-[0_5px_15px_rgba(236,0,14,0.32)]">
          {iconright}
        </div>
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
