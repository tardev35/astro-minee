---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  /** Emoji for the left / right icon tiles. Decorative — both tiles carry
   *  aria-hidden, so these never reach the accessibility tree. */
  iconleft?: string;
  iconright?: string;
}
const { title, as: HeadingTag = "h2", iconleft = "💰", iconright = "🔍" } = Astro.props;

// Two halves of one docx section: the left card takes the gold tile, the right
// card the crimson one. Icon tiles use a bright fill, so their text colour is
// the dark maroon (#2a0206 on gold, #fff5f5 on crimson) — getting that backwards
// is the unreadable-button bug this brand's spec calls out by name.
---

<section class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  <div
    class="group relative isolate w-full overflow-hidden rounded-3xl border border-[#e2131d]/25 bg-[#100205]/92 p-6 text-[#f2e2e4] shadow-[0_10px_30px_rgba(226,19,29,0.16)] backdrop-blur-xl transition-all duration-500 hover:border-[#e2131d]/50 md:p-10">
    <div
      aria-hidden="true"
      class="pointer-events-none absolute top-0 left-1/2 -z-10 h-[2px] w-1/2 -translate-x-1/2 bg-gradient-to-r from-transparent via-[#e2131d] to-transparent opacity-60 transition-opacity duration-500 group-hover:opacity-100">
    </div>

    {
      title && (
        <header class="mb-8 flex items-center gap-4 border-b border-[#e2131d]/25 pb-4">
          <div class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#ffe08a] to-[#a80f16] shadow-[0_0_10px_rgba(245,197,66,0.45)]" />
          <HeadingTag class="bg-gradient-to-r from-[#ffe08a] via-[#f5c542] to-[#ff5a5f] bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase">
            {title}
          </HeadingTag>
        </header>
      )
    }

    <div class="grid grid-cols-1 gap-6 lg:grid-cols-2 lg:gap-10">
      <article
        class="relative flex gap-4 rounded-2xl border border-[#f5c542]/25 bg-[#1c0407]/95 p-6 text-left text-base leading-relaxed text-[#f2e2e4] transition-all duration-300 hover:-translate-y-2 hover:border-[#f5c542]/55 hover:bg-[#2a0509]/90 hover:shadow-[0_15px_40px_rgba(245,197,66,0.24)]">
        <div
          aria-hidden="true"
          class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl border border-[#f5c542]/40 bg-gradient-to-br from-[#ffe08a] via-[#f5c542] to-[#a80f16] text-2xl text-[#2a0206] shadow-[0_5px_15px_rgba(245,197,66,0.28)]">
          {iconleft}
        </div>
        <slot name="left" />
      </article>

      <article
        class="relative flex gap-4 rounded-2xl border border-[#e2131d]/25 bg-[#1c0407]/95 p-6 text-left text-base leading-relaxed text-[#f2e2e4] transition-all duration-300 hover:-translate-y-2 hover:border-[#e2131d]/55 hover:bg-[#2a0509]/90 hover:shadow-[0_15px_40px_rgba(226,19,29,0.3)]">
        <div
          aria-hidden="true"
          class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl border border-[#f5c542]/40 bg-gradient-to-br from-[#ff5a5f] via-[#e2131d] to-[#5c070b] text-2xl text-[#fff5f5] shadow-[0_5px_15px_rgba(226,19,29,0.32)]">
          {iconright}
        </div>
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
