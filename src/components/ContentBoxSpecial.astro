---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  /** Emoji for the left / right icon tiles. Decorative — both tiles carry
   *  aria-hidden, so these never reach the accessibility tree. */
  iconleft?: string;
  iconright?: string;
}
const { title, as: HeadingTag = "h2", iconleft = "🎰", iconright = "🛡️" } = Astro.props;

// Two halves of one docx section: the left card takes the chick-yellow tile,
// the right card the crimson one. Both tiles use a bright-to-deep fill, so
// their text colour is picked against the middle of that fill (#1c0100 on
// yellow, #fdf3d8 on red) — getting that backwards is the unreadable-button bug
// this template's spec calls out by name.
---

<section class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  <div
    class="group relative isolate w-full overflow-hidden rounded-3xl border border-[#e01b24]/25 bg-[#1c0100]/92 p-6 text-[#fdf3d8] shadow-[0_10px_30px_rgba(224,27,36,0.2)] backdrop-blur-xl transition-all duration-500 hover:border-[#fde41a]/50 md:p-10">
    <div
      aria-hidden="true"
      class="pointer-events-none absolute top-0 left-1/2 -z-10 h-[2px] w-1/2 -translate-x-1/2 bg-gradient-to-r from-transparent via-[#fde41a] to-transparent opacity-60 transition-opacity duration-500 group-hover:opacity-100">
    </div>

    {
      title && (
        <header class="mb-8 flex items-center gap-4 border-b border-[#e01b24]/25 pb-4">
          <div aria-hidden="true" class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#fff17a] to-[#540101] shadow-[0_0_10px_rgba(253,228,26,0.45)]" />
          <HeadingTag class="bg-gradient-to-r from-[#fff17a] via-[#fde41a] to-[#ff5252] bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase">
            {title}
          </HeadingTag>
        </header>
      )
    }

    <div class="grid grid-cols-1 gap-6 lg:grid-cols-2 lg:gap-10">
      <article
        class="relative flex gap-4 rounded-2xl border border-[#fde41a]/25 bg-[#3a0806]/95 p-6 text-left text-base leading-relaxed text-[#fdf3d8] transition-all duration-300 hover:-translate-y-2 hover:border-[#fde41a]/55 hover:bg-[#540101]/90 hover:shadow-[0_15px_40px_rgba(253,228,26,0.24)]">
        <div
          aria-hidden="true"
          class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl border border-[#fde41a]/40 bg-gradient-to-br from-[#fff17a] via-[#fde41a] to-[#f0b429] text-2xl text-[#1c0100] shadow-[0_5px_15px_rgba(253,228,26,0.28)]">
          {iconleft}
        </div>
        <slot name="left" />
      </article>

      <article
        class="relative flex gap-4 rounded-2xl border border-[#e01b24]/25 bg-[#3a0806]/95 p-6 text-left text-base leading-relaxed text-[#fdf3d8] transition-all duration-300 hover:-translate-y-2 hover:border-[#ff5252]/55 hover:bg-[#540101]/90 hover:shadow-[0_15px_40px_rgba(224,27,36,0.3)]">
        <div
          aria-hidden="true"
          class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl border border-[#ff5252]/40 bg-gradient-to-br from-[#ff5252] via-[#e01b24] to-[#8f0d13] text-2xl text-[#fdf3d8] shadow-[0_5px_15px_rgba(224,27,36,0.32)]">
          {iconright}
        </div>
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
