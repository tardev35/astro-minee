---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  /** Emoji for the left / right icon tiles. Decorative — both tiles carry
   *  aria-hidden, so these never reach the accessibility tree. */
  iconleft?: string;
  iconright?: string;
}
const { title, as: HeadingTag = "h2", iconleft = "🎰", iconright = "🛡️" } = Astro.props;

// Two halves of one docx section: the left card takes the gold tile, the right
// card the crimson one. Both tiles use a bright-to-deep fill, so their text
// colour is picked against the middle of that fill (#2a0606 on gold, #f7e3c8 on
// crimson) — getting that backwards is the unreadable-button bug this
// template's spec calls out by name.
//
// The two wrappers a consumer passes into slot="left"/slot="right" must STAY:
// each is a flex sibling of the icon box, so passing loose <p> children would
// turn every paragraph into its own flex item beside the icon.
---

<section class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  <div
    class="group relative isolate w-full overflow-hidden rounded-3xl border border-[#d81f26]/25 bg-[#150404]/92 p-6 text-[#f7e3c8] shadow-[0_10px_30px_rgba(216,31,38,0.2)] backdrop-blur-xl transition-all duration-500 hover:border-[#f5c451]/50 md:p-10">
    <div
      aria-hidden="true"
      class="pointer-events-none absolute top-0 left-1/2 -z-10 h-[2px] w-1/2 -translate-x-1/2 bg-gradient-to-r from-transparent via-[#f5c451] to-transparent opacity-60 transition-opacity duration-500 group-hover:opacity-100">
    </div>

    {
      title && (
        <header class="mb-8 flex items-center gap-4 border-b border-[#d81f26]/25 pb-4">
          <div aria-hidden="true" class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#ffe08a] to-[#4a0a0d] shadow-[0_0_10px_rgba(245,196,81,0.45)]" />
          <HeadingTag class="bg-gradient-to-r from-[#ffe08a] via-[#f5c451] to-[#ff3a33] bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase">{title}</HeadingTag>
        </header>
      )
    }

    <div class="grid grid-cols-1 gap-6 lg:grid-cols-2 lg:gap-10">
      <article
        class="relative flex gap-4 rounded-2xl border border-[#f5c451]/25 bg-[#2b0808]/95 p-6 text-left text-base leading-relaxed text-[#f7e3c8] transition-all duration-300 hover:-translate-y-2 hover:border-[#f5c451]/55 hover:bg-[#4a0a0d]/90 hover:shadow-[0_15px_40px_rgba(245,196,81,0.24)]">
        <div
          aria-hidden="true"
          class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl border border-[#f5c451]/40 bg-gradient-to-br from-[#ffe08a] via-[#f5c451] to-[#c9931a] text-2xl text-[#2a0606] shadow-[0_5px_15px_rgba(245,196,81,0.28)]">
          {iconleft}
        </div>
        <slot name="left" />
      </article>

      <article
        class="relative flex gap-4 rounded-2xl border border-[#d81f26]/25 bg-[#2b0808]/95 p-6 text-left text-base leading-relaxed text-[#f7e3c8] transition-all duration-300 hover:-translate-y-2 hover:border-[#ff3a33]/55 hover:bg-[#4a0a0d]/90 hover:shadow-[0_15px_40px_rgba(216,31,38,0.3)]">
        <div
          aria-hidden="true"
          class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl border border-[#ff3a33]/40 bg-gradient-to-br from-[#ff3a33] via-[#d81f26] to-[#6d0d10] text-2xl text-[#f7e3c8] shadow-[0_5px_15px_rgba(216,31,38,0.32)]">
          {iconright}
        </div>
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
