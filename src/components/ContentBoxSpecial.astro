---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  /** Emoji for the left / right icon tiles. Decorative — both tiles carry
   *  aria-hidden, so these never reach the accessibility tree. */
  iconleft?: string;
  iconright?: string;
}
const { title, as: HeadingTag = "h2", iconleft = "🎰", iconright = "🃏" } = Astro.props;

// Two halves of one docx section: the left card takes the wordmark-gold tile,
// the right card the royal-blue one. Both tiles use a bright-to-deep fill, so
// their text colour is picked against the middle of that fill (#050b24 on gold,
// #e8eefb on blue) — getting that backwards is the unreadable-button bug this
// brand's spec calls out by name.
---

<section class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  <div
    class="group relative isolate w-full overflow-hidden rounded-3xl border border-[#1f5ce0]/25 bg-[#050b24]/92 p-6 text-[#cddcf7] shadow-[0_10px_30px_rgba(31,92,224,0.2)] backdrop-blur-xl transition-all duration-500 hover:border-[#3fdcff]/50 md:p-10">
    <div
      aria-hidden="true"
      class="pointer-events-none absolute top-0 left-1/2 -z-10 h-[2px] w-1/2 -translate-x-1/2 bg-gradient-to-r from-transparent via-[#3fdcff] to-transparent opacity-60 transition-opacity duration-500 group-hover:opacity-100">
    </div>

    {
      title && (
        <header class="mb-8 flex items-center gap-4 border-b border-[#1f5ce0]/25 pb-4">
          <div aria-hidden="true" class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#ffdd7a] to-[#0a1a45] shadow-[0_0_10px_rgba(242,184,41,0.45)]" />
          <HeadingTag class="bg-gradient-to-r from-[#ffdd7a] via-[#f2b829] to-[#3fdcff] bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase">
            {title}
          </HeadingTag>
        </header>
      )
    }

    <div class="grid grid-cols-1 gap-6 lg:grid-cols-2 lg:gap-10">
      <article
        class="relative flex gap-4 rounded-2xl border border-[#f2b829]/25 bg-[#0b1740]/95 p-6 text-left text-base leading-relaxed text-[#cddcf7] transition-all duration-300 hover:-translate-y-2 hover:border-[#f2b829]/55 hover:bg-[#122a63]/90 hover:shadow-[0_15px_40px_rgba(242,184,41,0.24)]">
        <div
          aria-hidden="true"
          class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl border border-[#f2b829]/40 bg-gradient-to-br from-[#ffdd7a] via-[#f2b829] to-[#a8760d] text-2xl text-[#050b24] shadow-[0_5px_15px_rgba(242,184,41,0.28)]">
          {iconleft}
        </div>
        <slot name="left" />
      </article>

      <article
        class="relative flex gap-4 rounded-2xl border border-[#1f5ce0]/25 bg-[#0b1740]/95 p-6 text-left text-base leading-relaxed text-[#cddcf7] transition-all duration-300 hover:-translate-y-2 hover:border-[#3fdcff]/55 hover:bg-[#122a63]/90 hover:shadow-[0_15px_40px_rgba(63,220,255,0.3)]">
        <div
          aria-hidden="true"
          class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl border border-[#3fdcff]/40 bg-gradient-to-br from-[#1f5ce0] via-[#0a1a45] to-[#050b24] text-2xl text-[#e8eefb] shadow-[0_5px_15px_rgba(31,92,224,0.32)]">
          {iconright}
        </div>
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
