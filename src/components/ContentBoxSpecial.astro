---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  /** Emoji for the left / right icon tiles. Decorative — both tiles carry
   *  aria-hidden, so these never reach the accessibility tree. */
  iconleft?: string;
  iconright?: string;
}
const { title, as: HeadingTag = "h2", iconleft = "💰", iconright = "🔍" } = Astro.props;

// Two halves of one docx section: the left card takes the coin-gold tile, the
// right card the forest-green one. Both tiles use a bright-to-deep fill, so
// their text colour is picked against the middle of that fill (#05230f on gold,
// #e8f3e0 on green) — getting that backwards is the unreadable-button bug this
// brand's spec calls out by name.
---

<section class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  <div
    class="group relative isolate w-full overflow-hidden rounded-3xl border border-[#12a34f]/25 bg-[#03170c]/92 p-6 text-[#e8f3e0] shadow-[0_10px_30px_rgba(18,163,79,0.16)] backdrop-blur-xl transition-all duration-500 hover:border-[#1fc465]/50 md:p-10">
    <div
      aria-hidden="true"
      class="pointer-events-none absolute top-0 left-1/2 -z-10 h-[2px] w-1/2 -translate-x-1/2 bg-gradient-to-r from-transparent via-[#9fcf3a] to-transparent opacity-60 transition-opacity duration-500 group-hover:opacity-100">
    </div>

    {
      title && (
        <header class="mb-8 flex items-center gap-4 border-b border-[#12a34f]/25 pb-4">
          <div aria-hidden="true" class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#ffdf7a] to-[#05461f] shadow-[0_0_10px_rgba(245,197,24,0.45)]" />
          <HeadingTag class="bg-gradient-to-r from-[#ffdf7a] via-[#f5c518] to-[#9fcf3a] bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase">
            {title}
          </HeadingTag>
        </header>
      )
    }

    <div class="grid grid-cols-1 gap-6 lg:grid-cols-2 lg:gap-10">
      <article
        class="relative flex gap-4 rounded-2xl border border-[#f5c518]/25 bg-[#072b14]/95 p-6 text-left text-base leading-relaxed text-[#e8f3e0] transition-all duration-300 hover:-translate-y-2 hover:border-[#f5c518]/55 hover:bg-[#0b3d1d]/90 hover:shadow-[0_15px_40px_rgba(245,197,24,0.24)]">
        <div
          aria-hidden="true"
          class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl border border-[#f5c518]/40 bg-gradient-to-br from-[#ffdf7a] via-[#f5c518] to-[#b8860b] text-2xl text-[#05230f] shadow-[0_5px_15px_rgba(245,197,24,0.28)]">
          {iconleft}
        </div>
        <slot name="left" />
      </article>

      <article
        class="relative flex gap-4 rounded-2xl border border-[#12a34f]/25 bg-[#072b14]/95 p-6 text-left text-base leading-relaxed text-[#e8f3e0] transition-all duration-300 hover:-translate-y-2 hover:border-[#1fc465]/55 hover:bg-[#0b3d1d]/90 hover:shadow-[0_15px_40px_rgba(18,163,79,0.3)]">
        <div
          aria-hidden="true"
          class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl border border-[#f5c518]/40 bg-gradient-to-br from-[#12a34f] via-[#05461f] to-[#03170c] text-2xl text-[#e8f3e0] shadow-[0_5px_15px_rgba(18,163,79,0.32)]">
          {iconright}
        </div>
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
