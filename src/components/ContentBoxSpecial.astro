---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  /** Emoji for the left / right icon tiles. Decorative — both tiles carry
   *  aria-hidden, so these never reach the accessibility tree. */
  iconleft?: string;
  iconright?: string;
}
const { title, as: HeadingTag = "h2", iconleft = "💰", iconright = "🔍" } = Astro.props;

// Two halves of one docx section: the left card takes the gold tile, the right
// card the deep-green one. Both tiles use a bright-to-deep fill, so their text
// colour is picked against the middle of that fill (#08210f on gold, #f2fbe8 on
// green) — getting that backwards is the unreadable-button bug this brand's
// spec calls out by name.
---

<section class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  <div
    class="group relative isolate w-full overflow-hidden rounded-3xl border border-[#8fd318]/25 bg-[#04140a]/92 p-6 text-[#e6f3dd] shadow-[0_10px_30px_rgba(143,211,24,0.16)] backdrop-blur-xl transition-all duration-500 hover:border-[#8fd318]/50 md:p-10">
    <div
      aria-hidden="true"
      class="pointer-events-none absolute top-0 left-1/2 -z-10 h-[2px] w-1/2 -translate-x-1/2 bg-gradient-to-r from-transparent via-[#8fd318] to-transparent opacity-60 transition-opacity duration-500 group-hover:opacity-100">
    </div>

    {
      title && (
        <header class="mb-8 flex items-center gap-4 border-b border-[#8fd318]/25 pb-4">
          <div class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#ffe873] to-[#1c7a2f] shadow-[0_0_10px_rgba(251,213,3,0.45)]" />
          <HeadingTag class="bg-gradient-to-r from-[#ffe873] via-[#fbd503] to-[#d4ea23] bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase">
            {title}
          </HeadingTag>
        </header>
      )
    }

    <div class="grid grid-cols-1 gap-6 lg:grid-cols-2 lg:gap-10">
      <article
        class="relative flex gap-4 rounded-2xl border border-[#fbd503]/25 bg-[#08210f]/95 p-6 text-left text-base leading-relaxed text-[#e6f3dd] transition-all duration-300 hover:-translate-y-2 hover:border-[#fbd503]/55 hover:bg-[#0d2f17]/90 hover:shadow-[0_15px_40px_rgba(251,213,3,0.24)]">
        <div
          aria-hidden="true"
          class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl border border-[#fbd503]/40 bg-gradient-to-br from-[#ffe873] via-[#fbd503] to-[#8fd318] text-2xl text-[#08210f] shadow-[0_5px_15px_rgba(251,213,3,0.28)]">
          {iconleft}
        </div>
        <slot name="left" />
      </article>

      <article
        class="relative flex gap-4 rounded-2xl border border-[#8fd318]/25 bg-[#08210f]/95 p-6 text-left text-base leading-relaxed text-[#e6f3dd] transition-all duration-300 hover:-translate-y-2 hover:border-[#8fd318]/55 hover:bg-[#0d2f17]/90 hover:shadow-[0_15px_40px_rgba(143,211,24,0.3)]">
        <div
          aria-hidden="true"
          class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl border border-[#fbd503]/40 bg-gradient-to-br from-[#8fd318] via-[#1c7a2f] to-[#0a3d1c] text-2xl text-[#f2fbe8] shadow-[0_5px_15px_rgba(28,122,47,0.32)]">
          {iconright}
        </div>
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
