---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  /** Emoji for the left / right icon tiles. Decorative — both tiles carry
   *  aria-hidden, so these never reach the accessibility tree. */
  iconleft?: string;
  iconright?: string;
}
const { title, as: HeadingTag = "h2", iconleft = "🎯", iconright = "🛡️" } = Astro.props;

// Two halves of one docx section: the left card takes the bright end of the
// PATTAYA168 ramp (pale seafoam -> cyan), the right card the gold accent. Both
// tiles use a two-stop fill, so their glyph colour is picked against the middle
// of that fill (#021c22 ink on both, since the cyan and the gold are the light
// ends) — getting that backwards is the unreadable-button bug this template's
// spec calls out by name.
//
// Each <article> is a flex row: the icon box and the slot content are siblings,
// so a consumer passes exactly ONE element per slot. Do not add a wrapper inside
// the component and do not pass loose siblings into a slot.
---

<section class="relative z-10 mx-auto mb-10 w-full max-w-[1400px] px-4 font-sans">
  <div
    class="group relative isolate w-full overflow-hidden rounded-3xl border border-[#02c4e3]/30 bg-[#021c22]/92 p-6 text-[#cfeef7] shadow-[0_10px_30px_rgba(2,196,227,0.18)] backdrop-blur-xl transition-all duration-500 hover:border-[#8ff5ff]/55 md:p-10">
    <div
      aria-hidden="true"
      class="pointer-events-none absolute top-0 left-1/2 -z-10 h-[2px] w-1/2 -translate-x-1/2 bg-gradient-to-r from-transparent via-[#02c4e3] to-transparent opacity-60 transition-opacity duration-500 group-hover:opacity-100">
    </div>

    {
      title && (
        <header class="mb-8 flex items-center gap-4 border-b border-[#02c4e3]/30 pb-4">
          <div aria-hidden="true" class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#8ff5ff] to-[#0c8ba4] shadow-[0_0_10px_rgba(2,196,227,0.5)]" />
          <HeadingTag class="bg-gradient-to-r from-[#8ff5ff] via-[#02c4e3] to-[#fdac13] bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase">{title}</HeadingTag>
        </header>
      )
    }

    <div class="grid grid-cols-1 gap-6 lg:grid-cols-2 lg:gap-10">
      <article
        class="relative flex gap-4 rounded-2xl border border-[#02c4e3]/30 bg-[#04222b]/95 p-6 text-left text-base leading-relaxed text-[#cfeef7] transition-all duration-300 hover:-translate-y-2 hover:border-[#8ff5ff]/55 hover:bg-[#03303c]/95 hover:shadow-[0_15px_40px_rgba(2,196,227,0.26)]">
        <div
          aria-hidden="true"
          class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl border border-[#8ff5ff]/45 bg-gradient-to-br from-[#8ff5ff] via-[#5afef1] to-[#02c4e3] text-2xl text-[#021c22] shadow-[0_5px_15px_rgba(2,196,227,0.3)]">
          {iconleft}
        </div>
        <slot name="left" />
      </article>

      <article
        class="relative flex gap-4 rounded-2xl border border-[#fdac13]/45 bg-[#04222b]/95 p-6 text-left text-base leading-relaxed text-[#cfeef7] transition-all duration-300 hover:-translate-y-2 hover:border-[#fdac13]/70 hover:bg-[#03303c]/95 hover:shadow-[0_15px_40px_rgba(253,172,19,0.26)]">
        <div
          aria-hidden="true"
          class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl border border-[#fdac13]/50 bg-gradient-to-br from-[#fdac13] to-[#f0820c] text-2xl text-[#021c22] shadow-[0_5px_15px_rgba(253,172,19,0.35)]">
          {iconright}
        </div>
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
