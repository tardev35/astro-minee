---
// The default is the fallback for every bare <Announcement /> on the sub-pages,
// so it has to be THIS brand's copy — a variant's shipped default is always the
// slogan of whichever brand last used it. index.astro passes the same string
// explicitly; keep the two byte-identical so the home page and the rest of the
// site cannot drift apart silently.
//
// No leading emoji in this string: the marquee renders `message` twice, and an
// emoji baked into a text prop cannot be marked aria-hidden, so a screen reader
// reads it out on every repeat. The 📢 badge beside the track is separate markup
// and is hidden properly.
//
// No domain name in the copy either — verify-build.mjs fails the build on an
// off-domain URL found in a component.
//
// MVP928 two-tone: burnt copper carries the rail and the glow, gold is the
// second metal on the badge ring and the divider. The text runs light gold
// rather than copper — copper type on a near-black panel is where the contrast
// would go.
const {
  message = "MVP928 สล็อตเว็บตรงระบบใหม่ออโต้ รวมเกม โปรโมชั่น และข้อมูลบัญชีไว้ที่จุดเดียว ช่วยลดการสลับหน้าและขั้นตอนที่ไม่จำเป็น • คำว่าอันดับหนึ่งเป็นถ้อยคำทางการตลาด ควรดูข้อมูลค่ายเกม ระบบบัญชี ช่องทางติดต่อ และเงื่อนไขธุรกรรมประกอบกัน • โปรโมชั่นมีทั้งโบนัสสมาชิกใหม่ สิทธิ์ตามยอดฝาก และกิจกรรมตามช่วงเวลา ก่อนรับควรตรวจยอดขั้นต่ำ เกมที่ร่วมรายการ และเงื่อนไขการถอนให้ครบ • ระบบออโต้ช่วยลดขั้นตอนจัดการรายการ ควรตรวจชื่อบัญชีและจำนวนเงินก่อนยืนยัน หากรายการเดิมยังดำเนินการอยู่ควรรอผลจากระบบก่อนส่งใหม่ • คำว่าแตกง่ายไม่ใช่การรับประกันผลลัพธ์ ควรดู RTP ความผันผวน และตารางจ่ายประกอบ พร้อมกำหนดวงเงินและเวลาเล่นไว้ล่วงหน้า",
} = Astro.props;
---

<div class="mx-auto mt-4 max-w-[900px] px-4 md:px-0">
  <div
    class="relative flex h-[46px] items-center rounded-r-full border border-[#f0b243]/35 bg-gradient-to-r from-[#2a1508]/80 to-[#0b0502] py-2 pr-4 pl-12 shadow-[0_0_20px_rgba(239,106,23,0.22)] backdrop-blur-md">
    <div class="absolute top-1/2 -left-2 flex h-11 w-11 -translate-y-1/2 items-center justify-center rounded-full border-[3px] border-[#f0b243] bg-[#0b0502] shadow-[0_0_15px_rgba(239,106,23,0.55)]">
      <span aria-hidden="true" class="animate-pulse text-xl">📢</span>
    </div>

    <div aria-hidden="true" class="mr-4 h-full w-[1px] bg-[#f0b243]/30"></div>

    <div class="flex-1 overflow-hidden [mask-image:linear-gradient(90deg,transparent_0%,#000_5%,#000_95%,transparent_100%)]">
      <div class="flex w-max animate-[scroll_25s_linear_infinite] gap-12 text-sm font-bold whitespace-nowrap text-[#f5cc8a]">
        <span class="drop-shadow-[0_0_5px_rgba(240,178,67,0.5)]">{message}</span>
        <span class="drop-shadow-[0_0_5px_rgba(240,178,67,0.5)]">{message}</span>
      </div>
    </div>
  </div>
</div>

<style>
  @keyframes scroll {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(calc(-50% - 24px));
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .animate-\[scroll_25s_linear_infinite\] {
      animation: none;
    }
  }
</style>
