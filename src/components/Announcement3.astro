---
// The default is the fallback for every bare <Announcement /> on the sub-pages,
// so it has to be THIS brand's copy — a variant's shipped default is always the
// slogan of whichever brand last used it.
//
// No leading emoji in this string: the marquee renders `message` twice, and an
// emoji baked into a text prop cannot be marked aria-hidden, so a screen reader
// reads it out on every repeat. The 📢 badge beside the track is separate markup
// and is hidden properly.
//
// No domain name in the copy either — verify-build.mjs fails the build on an
// off-domain URL found in a component.
//
// TAKO168 two-tone: crimson carries the track and the pill, gold is the second
// metal on the badge ring and the rule. The text runs gold rather than red —
// red type on a near-black panel is where the contrast would go.
const {
  message = "TAKO168 รวมเกมสล็อตหลายค่ายไว้ในระบบเดียว เลือกเกมจากธีม ฟีเจอร์โบนัส และระดับเดิมพันได้จากหน้าเดียว • รองรับ True Wallet ตามช่องทางที่กำหนด ก่อนยืนยันควรตรวจข้อมูล Wallet จำนวนเงิน และบัญชีสมาชิกให้ถูกต้อง • ควรดูตารางจ่าย RTP และความผันผวนของเกมประกอบกัน แทนการดูจากคำว่าแตกหนักเพียงอย่างเดียว • สมาชิกตรวจยอดคงเหลือ ประวัติถอน และสถานะธุรกรรมได้จากหน้าบัญชี หากรายการยังดำเนินการอยู่ควรเก็บเลขอ้างอิงและรอระบบอัปเดตก่อนส่งคำขอใหม่ • คำว่าแตกหนักและจ่ายไวเป็นถ้อยคำทางการตลาด ไม่ใช่การรับประกันผลของเกมหรือการถอนทุกกรณี ควรกำหนดงบก่อนเริ่มเล่นทุกครั้ง",
} = Astro.props;
---

<div class="mx-auto mt-4 max-w-[900px] px-4 md:px-0">
  <div
    class="relative flex h-[46px] items-center rounded-r-full border border-[#e8b23a]/35 bg-gradient-to-r from-[#6b0d08]/75 to-[#0a0403] py-2 pr-4 pl-12 shadow-[0_0_20px_rgba(225,29,22,0.2)] backdrop-blur-md">
    <div class="absolute top-1/2 -left-2 flex h-11 w-11 -translate-y-1/2 items-center justify-center rounded-full border-[3px] border-[#e8b23a] bg-[#0a0403] shadow-[0_0_15px_rgba(225,29,22,0.55)]">
      <span aria-hidden="true" class="animate-pulse text-xl">📢</span>
    </div>

    <div aria-hidden="true" class="mr-4 h-full w-[1px] bg-[#e8b23a]/30"></div>

    <div class="flex-1 overflow-hidden [mask-image:linear-gradient(90deg,transparent_0%,#000_5%,#000_95%,transparent_100%)]">
      <div class="flex w-max animate-[scroll_25s_linear_infinite] gap-12 text-sm font-bold whitespace-nowrap text-[#ffd97a]">
        <span class="drop-shadow-[0_0_5px_rgba(232,178,58,0.5)]">{message}</span>
        <span class="drop-shadow-[0_0_5px_rgba(232,178,58,0.5)]">{message}</span>
      </div>
    </div>
  </div>
</div>

<style>
  @keyframes scroll {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(calc(-50% - 24px));
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .animate-\[scroll_25s_linear_infinite\] {
      animation: none;
    }
  }
</style>
