---
import { Picture } from "astro:assets";
import BankStrip from "./BankStrip.astro";
import { BRAND_ADDRESS, BRAND_NAME } from "../lib/brandProfile";
const images = import.meta.glob<{ default: ImageMetadata }>("../assets/logo.{png,webp,jpg}", { eager: true });

const imagePaths = Object.keys(images);
const mainLogo = imagePaths.length > 0 ? images[imagePaths[0]].default : null;

// LAVA432 is a slot brand: no /ตรวจหวย or /แนวทาง entries here. Both pages
// are parked in src/pages-disabled/ this round, and a link to a route that does
// not exist fails the build in tools/verify-build.mjs.
const quickLinks = [
  { name: "หน้าแรก", path: "/" },
  { name: "ทดลองเล่นเกมฟรี", path: "/ทดลองเล่น" },
  { name: "โปรโมชั่นสมาชิกใหม่", path: "/promotion" },
  { name: "ทางเข้าล่าสุด", path: "/ทางเข้า" },
  { name: "เกี่ยวกับเรา", path: "/about-us" },
  { name: "สมัครสมาชิก", path: "/register" },
  { name: "ติดต่อแอดมิน", path: "/contact-us" },
];

const logoAlt = `โลโก้ ${BRAND_NAME} ตัวอักษร LAVA สีขาวหนาเอียงเล็กน้อย ต่อด้วยเลข 432 สีดำวางบนแถบสี่เหลี่ยมสีแดงสด ทั้งหมดอยู่ในกรอบสีดำขอบมน`;
---

<footer class="relative mt-32 w-full border-t border-[#ff6a13]/30 bg-[#120303] pt-64 pb-6 font-sans text-[#f4e3e0] shadow-[0_-10px_30px_rgba(255,106,19,0.15)] md:pt-40">
  <div
    class="absolute -top-14 left-1/2 z-20 flex w-[92%] max-w-5xl -translate-x-1/2 flex-col items-center justify-between rounded-2xl border border-[#ff6a13]/35 bg-gradient-to-r from-[#7a0206] via-[#a10309] to-[#2a0808] p-6 shadow-[0_15px_40px_rgba(236,0,14,0.28)] md:-top-16 md:flex-row md:p-8">
    <div class="mb-5 flex flex-col text-center md:mb-0 md:text-left">
      <p class="text-xl font-black tracking-wide text-[#ffa040] uppercase italic drop-shadow-[0_2px_4px_rgba(0,0,0,0.5)] md:text-3xl">
        <span aria-hidden="true">🌋</span> พร้อมเริ่มกับ {BRAND_NAME} แล้วหรือยัง?
      </p>
      <p class="mt-2 text-sm font-medium text-[#f4e3e0]/90 md:text-base">
        สมัครสมาชิก {BRAND_NAME} แล้วเลือกเกมสล็อตหลายรูปแบบได้จากบัญชีเดียว โปรโมชั่นแต่ละรายการมีเงื่อนไขและช่วงเวลาไม่เท่ากัน ควรอ่านรายละเอียดให้ครบก่อนกดรับสิทธิ์ทุกครั้ง
      </p>
    </div>

    <a
      href="/register"
      class="group relative flex items-center justify-center overflow-hidden rounded-full border border-[#ffa040] bg-gradient-to-b from-[#ffa040] to-[#ff6a13] px-8 py-3.5 text-sm font-extrabold whitespace-nowrap text-[#120303] shadow-[0_0_15px_rgba(255,106,19,0.4)] transition-all hover:scale-105 md:text-base">
      <span class="relative z-10">สมัครสมาชิกเลย <span aria-hidden="true">🚀</span></span>
      <div aria-hidden="true" class="absolute inset-0 translate-y-full bg-[#ffa040] transition-transform duration-300 group-hover:translate-y-0"></div>
    </a>
  </div>

  <div class="relative z-10 mx-auto max-w-[1200px] px-6">
    <div class="mb-10 grid grid-cols-1 gap-10 md:grid-cols-12 lg:gap-12">
      <div class="flex flex-col gap-6 md:col-span-12 lg:col-span-4">
        <a href="/" class="inline-block origin-left transition-transform hover:scale-105">
          {
            mainLogo ? (
              <Picture
                src={mainLogo}
                alt={logoAlt}
                widths={[100, 200, 300]}
                sizes="100px"
                height={45}
                loading="lazy"
                decoding="async"
                class="h-[45px] w-auto drop-shadow-[0_0_12px_rgba(236,0,14,0.6)]"
                formats={["avif", "webp"]}
                fallbackFormat="webp"
              />
            ) : (
              <p class="bg-gradient-to-b from-[#ffffff] to-[#ec000e] bg-clip-text text-3xl font-black text-transparent drop-shadow-[0_0_8px_rgba(236,0,14,0.5)]">{BRAND_NAME}</p>
            )
          }
        </a>
        <p class="text-sm leading-relaxed text-[#c9a8a4]">
          {BRAND_NAME} รวมเกมสล็อตหลายรูปแบบไว้ในระบบเดียว จัดหมวดเกมตามค่าย ธีม หรือรูปแบบฟีเจอร์ได้จากหน้าเดียว สมาชิกดูยอดคงเหลือ ประวัติฝากถอน และสถานะรายการย้อนหลังได้จากหน้าบัญชีของตนเอง
        </p>

        <div class="mt-2 flex flex-wrap gap-3">
          <a
            href="/line"
            class="flex items-center gap-2 rounded-full border border-[#00B900]/30 bg-[#00B900]/10 px-4 py-2 text-xs font-bold text-[#00B900] shadow-[0_0_10px_rgba(0,185,0,0.1)] transition-colors hover:bg-[#00B900] hover:text-white">
            <span aria-hidden="true" class="text-base">💬</span> LINE OFFICIAL
          </a>
        </div>

        {
          BRAND_ADDRESS.lines.length > 0 && (
            <address aria-label={BRAND_ADDRESS.label} class="mt-2 rounded-xl border border-white/15 bg-black/20 p-4 text-xs leading-relaxed not-italic opacity-90">
              <p class="mb-2 flex items-center gap-2 text-[11px] font-bold tracking-wider uppercase opacity-80">
                <span aria-hidden="true" class="text-sm">📍</span>
                {BRAND_ADDRESS.label}
              </p>
              {BRAND_ADDRESS.lines.map((line) => (
                <span class="block">{line}</span>
              ))}
              {BRAND_ADDRESS.email && (
                <a href={`mailto:${BRAND_ADDRESS.email}`} class="mt-3 inline-flex items-center gap-2 font-bold underline decoration-current/40 underline-offset-4 opacity-90 transition-opacity hover:opacity-100">
                  <span aria-hidden="true" class="text-sm">✉️</span>
                  {BRAND_ADDRESS.email}
                </a>
              )}
            </address>
          )
        }
      </div>

      <div class="md:col-span-6 lg:col-span-5">
        <p class="relative mb-5 inline-block text-lg font-bold tracking-wider text-[#f4e3e0] uppercase">
          ลิงก์ด่วน (Quick Links)
          <span aria-hidden="true" class="absolute -bottom-2 left-0 h-1 w-1/2 rounded-full bg-gradient-to-r from-[#ec000e] to-[#ffa040] shadow-[0_0_8px_rgba(255,106,19,0.6)]"></span>
        </p>

        <div class="grid grid-cols-2 gap-x-4 gap-y-3 text-sm">
          {
            quickLinks.map((link) => (
              <a href={link.path} class="group flex items-center text-[#c9a8a4] transition-colors hover:text-[#ffa040]">
                <span aria-hidden="true" class="mr-2 h-1.5 w-1.5 rounded-sm bg-[#ec000e] transition-transform group-hover:rotate-45" />
                {link.name}
              </a>
            ))
          }
        </div>
      </div>

      <div class="md:col-span-6 lg:col-span-3">
        <p class="relative mb-5 inline-block text-lg font-bold tracking-wider text-[#f4e3e0] uppercase">
          ระบบการเงิน
          <span aria-hidden="true" class="absolute -bottom-2 left-0 h-1 w-1/2 rounded-full bg-gradient-to-r from-[#ec000e] to-[#ffa040] shadow-[0_0_8px_rgba(255,106,19,0.6)]"></span>
        </p>

        <p class="mb-4 text-xs text-[#c9a8a4]">รองรับการฝาก-ถอนผ่านแอปธนาคารชั้นนำและ TrueMoney Wallet โดยควรใช้บัญชีชื่อเดียวกับข้อมูลที่สมัครไว้</p>

        <BankStrip size={30} />

        <div class="mt-3 flex h-10 items-center justify-center rounded border border-white/5 bg-[#7a0206] transition-colors hover:border-[#ff6a13]/50" title="ตรวจรายการย้อนหลัง">
          <span class="flex items-center gap-1 text-xs font-bold text-[#f4e3e0]"><span aria-hidden="true" class="text-lg text-[#ff6a13]">🧾</span> เก็บเลขรายการไว้ตรวจสอบได้</span>
        </div>
      </div>
    </div>

    <hr class="mb-6 border-[#ff6a13]/25" />

    <div class="mb-6 hidden text-justify text-[10px] leading-relaxed text-[#c9a8a4] md:block">
      {BRAND_NAME} สล็อตเว็บใหญ่ระบบใหม่ รวมเกมสล็อตหลายรูปแบบไว้ในบัญชีเดียว ทั้งเกมคลาสสิก เกมฟีเจอร์โบนัส และเกมธีมสมัยใหม่ จัดหมวดตามค่าย ธีม และรูปแบบฟีเจอร์ ระบบสมาชิกบัญชีเดียว ฝากถอนออโต้
      ตรวจยอดคงเหลือและประวัติธุรกรรมได้จากหน้าบัญชี ทางเข้าเว็บหลักรองรับทั้งมือถือและคอมพิวเตอร์ สมัครสมาชิก {BRAND_NAME}
    </div>

    <div class="flex flex-col items-center justify-between gap-4 border-t border-white/5 pt-6 text-xs text-[#c9a8a4] md:flex-row">
      <p>&copy; {new Date().getFullYear()} <span class="font-bold tracking-wider text-[#ffa040] uppercase">{BRAND_NAME}</span>. All Rights Reserved.</p>

      <div class="flex items-center gap-6">
        <a href="/terms/" class="transition-colors hover:text-[#f4e3e0]">เงื่อนไขและข้อตกลง</a>
        <a href="/privacy/" class="transition-colors hover:text-[#f4e3e0]">นโยบายความเป็นส่วนตัว</a>

        <a
          href="#top"
          class="flex h-8 w-8 items-center justify-center rounded border border-white/10 bg-white/5 text-[#f4e3e0] transition-all hover:border-[#ffa040] hover:bg-[#a10309] hover:shadow-[0_0_15px_rgba(255,106,19,0.5)]"
          aria-label="กลับขึ้นด้านบนสุดของหน้า">
          <span aria-hidden="true">↑</span>
        </a>
      </div>
    </div>
  </div>
</footer>

<style>
  footer a {
    text-decoration: none;
    color: inherit;
    transition: all 0.3s ease;
  }
</style>
