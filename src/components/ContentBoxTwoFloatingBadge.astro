---
export interface Props {
  title?: string;
  titleleft?: string;
  titleright?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, titleleft, titleright, as: HeadingTag = "h2" } = Astro.props;

// The title badge is `absolute -top-6`, so the width cap (w-[92%] max-w-2xl)
// plus text-center and the card's pt-32/md:pt-28 are load bearing — a full docx
// sentence has to wrap rather than blow past the viewport, and the wrapped badge
// has to clear the grid below it.
//
// Measured against BANANAV3's H2-2 title ("บาคาร่าเหมาะกับผู้ที่ชอบกติกาชัดและ
// รอบเกมรวดเร็ว", 45 chars). Mobile: text-lg at leading-normal = 27px a line
// over ~240px of usable badge width wraps to 3 lines at worst → 3×27 + 20
// (py-2.5) + 4 (border-2) = 105px tall, bottom edge at 105 − 24 = 81px into the
// card, inside pt-32 (128px). Desktop: text-2xl at 36px a line over ~560px
// wraps to 2 lines → 96px tall, bottom edge at 72px, inside md:pt-28 (112px).
//
// titleleft/titleright are <p>, not headings: this box's column labels are
// supporting-panel chrome. The one docx heading it carries is `title`.
---

<section class="my-10 flex w-full justify-center px-4 font-sans">
  <div
    class="relative isolate w-full max-w-7xl rounded-2xl border-2 border-[#e8a317]/30 bg-gradient-to-b from-[#2e1a05]/95 to-[#241303]/95 p-8 pt-32 shadow-[0_10px_30px_rgba(232,163,23,0.16)] md:pt-28">
    <div aria-hidden="true" class="pointer-events-none absolute -top-16 -right-10 -z-10 h-40 w-40 rounded-full bg-[#fed624]/30 blur-[60px]"></div>
    <div aria-hidden="true" class="pointer-events-none absolute -bottom-16 -left-10 -z-10 h-40 w-40 rounded-full bg-[#e8a317]/25 blur-[60px]"></div>

    {
      title && (
        <div class="absolute -top-6 left-1/2 flex w-[92%] max-w-2xl -translate-x-1/2 items-center justify-center gap-2 rounded-lg border-2 border-[#e8a317]/40 bg-[#2e1a05] px-4 py-2.5 text-center shadow-[0_10px_30px_rgba(254,214,36,0.22)] sm:px-8">
          <span aria-hidden="true" class="shrink-0 text-[#fed624]">
            ✦
          </span>
          <HeadingTag class="min-w-0 bg-gradient-to-r from-[#ffe97a] via-[#fed624] to-[#ffc94d] bg-clip-text text-lg leading-normal font-black tracking-tight text-transparent uppercase sm:text-xl md:text-2xl">
            {title}
          </HeadingTag>
          <span aria-hidden="true" class="shrink-0 text-[#fed624]">
            ✦
          </span>
        </div>
      )
    }

    <div class="grid grid-cols-1 gap-10 md:grid-cols-2">
      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#fdf1b3]">
        {titleleft && <p class="text-2xl leading-normal font-bold text-[#fed624]">{titleleft}</p>}
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#fdf1b3] md:border-l md:border-[#e8a317]/30 md:pl-10">
        {titleright && <p class="text-2xl leading-normal font-bold text-[#fed624]">{titleright}</p>}
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
