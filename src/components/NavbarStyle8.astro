---
import { isActivePath } from "../lib/nav";
import { Picture } from "astro:assets";
import { BRAND_NAME } from "../lib/brandProfile";
const images = import.meta.glob<{ default: ImageMetadata }>("../assets/logo.{png,webp,jpg}", { eager: true });

const imagePaths = Object.keys(images);
const mainLogo = imagePaths.length > 0 ? images[imagePaths[0]].default : null;

const currentPath = Astro.url.pathname;

const isActive = (path: string) => isActivePath(currentPath, path);

// เมนูชุดเดียวใช้ทั้งแถบบนจอคอมและ drawer มือถือ — ไอคอนอยู่ในอาร์เรย์ แล้ว
// เรนเดอร์เป็น <span aria-hidden="true"> ที่เป็น "พี่น้อง" ของตัวอักษร ห้ามต่อ
// emoji เข้าไปในสตริงชื่อเมนู เพราะ screen reader จะอ่านชื่อไอคอนติดมาด้วย
//
// ลำดับ: หน้าแรก มาก่อนเสมอ ตามด้วย โปรโมชั่น แล้วจึงเป็นหน้าอ่านข้อมูล —
// แบรนด์นี้ปิด cta toggle (login/register ยังเป็นหน้า interstitial แบบ noindex)
// จึงไม่มีเมนู สมัครสมาชิก/เข้าสู่ระบบ และ ทางเข้า ยังอยู่ในเมนูตามปกติ
//
// MVP928 เป็นแบรนด์สล็อต ไม่ใช่เว็บหวย: /ตรวจหวย กับ /แนวทาง ถูกพักไว้ใน
// src/pages-disabled/ ทั้งคู่ จึงต้องไม่มีลิงก์ไปหาที่ไหนเลย — route ไม่มีอยู่จริง
// และ tools/verify-build.mjs จะทำให้ build แดงถ้ามี href ชี้ไปหน้าที่ไม่มี
//
// ไอคอนเลือกให้ตรงแนวสล็อตพรีเมียมของ MVP928 — ทดลองเล่น เป็นตู้สล็อต และ
// เกี่ยวกับเรา เป็นมงกุฎ ให้ล้อกับมาสคอตราชาในโลโก้
const links = [
  { name: "หน้าแรก", path: "/", icon: "🏠" },
  { name: "โปรโมชั่น", path: "/promotion", icon: "🎁" },
  { name: "ทดลองเล่น", path: "/ทดลองเล่น", icon: "🎰" },
  { name: "ทางเข้า", path: "/ทางเข้า", icon: "🚪" },
  { name: "เกี่ยวกับเรา", path: "/about-us", icon: "👑" },
  { name: "ติดต่อเรา", path: "/contact-us", icon: "💬" },
];

const logoAlt = `โลโก้ ${BRAND_NAME} เป็นหัวราชาไว้เคราขาวสวมมงกุฎทองขอบสีส้ม อยู่ทางซ้ายของตัวอักษร MVP สีขาวเงินแบบโลหะ ต่อด้วยเลข 928 สีพีชไล่เฉดส้ม ทั้งหมดมีเส้นขอบสีส้มเข้มล้อมรอบบนพื้นโปร่งใส`;
---

<header class="sticky top-0 z-50 w-full font-sans">
  <nav class="relative z-40 w-full bg-[#0b0502]/95 shadow-[0_4px_20px_rgba(11,5,2,0.85)] backdrop-blur-lg" aria-label={`เมนูหลัก ${BRAND_NAME}`}>
    <div aria-hidden="true" class="bg-theme-oklab absolute bottom-0 left-0 h-[2px] w-full opacity-80"></div>

    <div class="flex h-[65px] w-full items-center justify-between px-3 md:px-6 lg:h-[80px]">
      <div class="flex items-center">
        <a href="/" class="flex-shrink-0 transition-transform hover:scale-105">
          {
            mainLogo ? (
              <Picture
                src={mainLogo}
                alt={logoAlt}
                loading="eager"
                fetchpriority="high"
                widths={[120, 240, 360]}
                sizes="(max-width: 1023px) 92px, 120px"
                class="h-[35px] w-auto drop-shadow-[0_0_10px_rgba(239,106,23,0.5)] lg:h-[45px]"
                formats={["avif", "webp"]}
                fallbackFormat="webp"
              />
            ) : (
              <span class="bg-gradient-to-b from-[#eaeef3] to-[#ef6a17] bg-clip-text text-2xl font-black tracking-widest text-transparent">{BRAND_NAME}</span>
            )
          }
        </a>
      </div>

      <div class="hidden h-full items-center justify-center gap-7 lg:flex xl:gap-9">
        {
          links.map((link) => (
            <a href={link.path} class="group relative flex h-full items-center gap-2 text-sm font-bold transition-all xl:text-base">
              <span aria-hidden="true" class="absolute left-0 -ml-3 text-[#f0b243] opacity-0 transition-all duration-300 group-hover:-ml-4 group-hover:opacity-100">
                [
              </span>
              <span aria-hidden="true" class={`text-base transition-transform duration-300 group-hover:scale-115 ${isActive(link.path) ? "" : "opacity-80"}`}>
                {link.icon}
              </span>
              <span class={`transition-colors duration-300 ${isActive(link.path) ? "text-[#f0b243] drop-shadow-[0_0_8px_rgba(240,178,67,0.75)]" : "text-[#ece0d6]/80 group-hover:text-[#fdc79b]"}`}>{link.name}</span>
              <span aria-hidden="true" class="absolute right-0 -mr-3 text-[#f0b243] opacity-0 transition-all duration-300 group-hover:-mr-4 group-hover:opacity-100">
                ]
              </span>
              {isActive(link.path) && <div aria-hidden="true" class="absolute bottom-0 left-0 h-[3px] w-full rounded-t-md bg-[#ef6a17] shadow-[0_-2px_10px_rgba(239,106,23,0.9)]" />}
            </a>
          ))
        }
      </div>

      <div class="z-50 flex items-center gap-2 md:gap-4">
        <a
          href="/login"
          class="hidden items-center justify-center rounded border border-[#ef6a17]/70 px-6 py-2 text-sm font-bold text-[#fdc79b] transition-all hover:bg-[#ef6a17]/20 hover:shadow-[0_0_15px_rgba(239,106,23,0.45)] lg:flex">
          เข้าสู่ระบบ
        </a>
        <a
          href="/register"
          class="bg-theme-oklab hidden items-center justify-center rounded px-6 py-2 text-sm font-extrabold text-[#180c04] shadow-[0_0_20px_rgba(239,106,23,0.5)] transition-all hover:brightness-110 lg:flex">
          สมัครสมาชิก
        </a>

        <div class="flex items-center gap-2 lg:hidden">
          <a
            href="/register"
            class="bg-theme-oklab flex items-center justify-center rounded px-3 py-1.5 text-[11px] font-bold text-[#180c04] shadow-[0_0_10px_rgba(239,106,23,0.5)] md:px-4 md:text-xs">
            สมัครสมาชิก
          </a>
          <button id="hamburger-btn" class="flex flex-col items-center justify-center space-y-1.5 rounded border border-[#ef6a17]/45 bg-[#ef6a17]/10 p-1.5" aria-label="เปิดเมนู">
            <span aria-hidden="true" class="hamburger-line h-[2px] w-5 origin-center rounded-full bg-[#f0b243] transition-all duration-300"></span>
            <span aria-hidden="true" class="hamburger-line h-[2px] w-5 rounded-full bg-[#f0b243] transition-all duration-300"></span>
            <span aria-hidden="true" class="hamburger-line h-[2px] w-5 origin-center rounded-full bg-[#f0b243] transition-all duration-300"></span>
          </button>
        </div>
      </div>
    </div>
  </nav>

  <div id="mobile-overlay" class="pointer-events-none fixed inset-0 z-40 bg-black/80 opacity-0 backdrop-blur-sm transition-opacity duration-300 lg:hidden"></div>

  <div
    id="mobile-sidebar"
    class="fixed top-0 right-0 z-50 h-screen w-[260px] translate-x-full transform overflow-y-auto border-l border-[#ef6a17]/45 bg-[#0b0502] shadow-[-10px_0_30px_rgba(11,5,2,0.95)] transition-transform duration-400 ease-[cubic-bezier(0.3,1,0.3,1)] lg:hidden">
    <div class="flex items-center justify-between border-b border-white/5 px-5 py-5">
      <span class="text-sm font-extrabold tracking-wider text-[#eaeef3]">MENU</span>
      <button id="close-sidebar-btn" class="p-1 text-xl text-[#f0b243] hover:text-[#eaeef3]" aria-label="ปิดเมนู">✕</button>
    </div>

    <div class="flex flex-col space-y-2 px-4 pt-4 pb-8">
      {
        links.map((link) => (
          <a
            href={link.path}
            class={`sidebar-item flex items-center rounded-lg border px-4 py-3.5 transition-all ${isActive(link.path) ? "border-[#ef6a17]/60 bg-[#ef6a17]/20 text-[#f0b243]" : "border-transparent bg-white/5 text-[#ece0d6]/80 hover:bg-white/10"}`}>
            <span aria-hidden="true" class="mr-3 text-xl">
              {link.icon}
            </span>
            <span class="text-sm font-bold">{link.name}</span>
          </a>
        ))
      }

      <div class="mt-6 flex flex-col gap-3 border-t border-[#ef6a17]/40 pt-6">
        <a
          href="/login"
          class="sidebar-item hover:bg-theme-oklab flex items-center justify-center gap-2 rounded-lg border border-[#f0b243]/70 bg-transparent py-3.5 text-sm font-bold text-[#fdc79b] transition-colors hover:border-transparent hover:text-[#180c04]">
          <span aria-hidden="true">🔒</span> เข้าสู่ระบบ
        </a>
      </div>
    </div>
  </div>
</header>

<style is:global>
  .bg-theme-oklab {
    background-image: linear-gradient(in oklab to right, #b34a08, #ef6a17, #f0b243);
  }

  #hamburger-btn.active .hamburger-line:nth-child(1) {
    transform: translateY(7px) rotate(45deg);
  }
  #hamburger-btn.active .hamburger-line:nth-child(2) {
    opacity: 0;
  }
  #hamburger-btn.active .hamburger-line:nth-child(3) {
    transform: translateY(-7px) rotate(-45deg);
  }

  .sidebar-item {
    opacity: 0;
    transform: translateX(20px);
    transition: all 0.3s cubic-bezier(0.3, 1, 0.3, 1);
  }
  .sidebar-item.item-show {
    opacity: 1;
    transform: translateX(0);
  }
  .sidebar-item:nth-child(1) {
    transition-delay: 0.1s;
  }
  .sidebar-item:nth-child(2) {
    transition-delay: 0.15s;
  }
  .sidebar-item:nth-child(3) {
    transition-delay: 0.2s;
  }
  .sidebar-item:nth-child(4) {
    transition-delay: 0.25s;
  }
  .sidebar-item:nth-child(5) {
    transition-delay: 0.3s;
  }
  .sidebar-item:nth-child(6) {
    transition-delay: 0.35s;
  }

  @media (prefers-reduced-motion: reduce) {
    .sidebar-item {
      transition: none;
    }
  }
</style>

<script>
  const hamburgerBtn = document.getElementById("hamburger-btn");
  const closeBtn = document.getElementById("close-sidebar-btn");
  const overlay = document.getElementById("mobile-overlay");
  const sidebar = document.getElementById("mobile-sidebar");
  const sidebarItems = document.querySelectorAll(".sidebar-item");

  const toggleSidebar = () => {
    hamburgerBtn?.classList.toggle("active");

    sidebar?.classList.toggle("translate-x-full");
    sidebar?.classList.toggle("translate-x-0");

    overlay?.classList.toggle("opacity-0");
    overlay?.classList.toggle("opacity-100");
    overlay?.classList.toggle("pointer-events-none");
    overlay?.classList.toggle("pointer-events-auto");

    if (sidebar?.classList.contains("translate-x-0")) {
      document.body.style.overflow = "hidden";
      sidebarItems.forEach((item) => item.classList.add("item-show"));
    } else {
      document.body.style.overflow = "";
      sidebarItems.forEach((item) => item.classList.remove("item-show"));
    }
  };

  hamburgerBtn?.addEventListener("click", toggleSidebar);
  closeBtn?.addEventListener("click", toggleSidebar);
  overlay?.addEventListener("click", toggleSidebar);

  sidebarItems.forEach((item) => {
    item.addEventListener("click", () => {
      if (sidebar?.classList.contains("translate-x-0")) {
        toggleSidebar();
      }
    });
  });
</script>
