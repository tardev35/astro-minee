---
import { isActivePath } from "../lib/nav";
import { Picture } from "astro:assets";
const images = import.meta.glob<{ default: ImageMetadata }>("../assets/logo.{png,webp,jpg}", { eager: true });

const imagePaths = Object.keys(images);
const mainLogo = imagePaths.length > 0 ? images[imagePaths[0]].default : null;

const currentPath = Astro.url.pathname;

const isActive = (path: string) => isActivePath(currentPath, path);

// เมนูชุดเดียว ใช้ทั้งแถบบนจอใหญ่และ sidebar บนมือถือ — เดิมไฟล์นี้เขียนลิงก์ซ้ำ
// สองชุด (จอใหญ่ไม่มีไอคอน มือถือมี) ซึ่งแปลว่าคนถัดไปแก้ชุดเดียวแล้วอีกชุดค้าง
// icon แยกเป็น span ของตัวเองเสมอ ไม่เชื่อมกับ name เพราะถ้าต่อกันเป็นข้อความ
// เดียว screen reader จะอ่านว่า "house หน้าแรก"
//
// ลำดับเมนู: หน้าแรก · โปรโมชั่น · (สมัครสมาชิก · เข้าสู่ระบบ ถ้าเปิด toggle) ·
// ที่เหลือ — แบรนด์นี้ปิด cta toggle ไว้ /register กับ /login จึงเป็นปุ่มมุมขวา
// อย่างเดียว ไม่ใช่รายการเมนู
const links = [
  { name: "หน้าแรก", path: "/", icon: "🏠" },
  { name: "โปรโมชั่น", path: "/promotion", icon: "🎁" },
  { name: "ทดลองเล่น", path: "/ทดลองเล่น", icon: "🎰" },
  { name: "ทางเข้า", path: "/ทางเข้า", icon: "🚪" },
  { name: "เกี่ยวกับเรา", path: "/about-us", icon: "ℹ️" },
  { name: "ติดต่อเรา", path: "/contact-us", icon: "💬" },
];

const logoAlt = "โลโก้ ABM96 ตัวอักษร ABM สีชมพูและเลข 96 สีขาวขอบดำ ด้านขวาเป็นมาสคอตหมูสีชมพูแลบลิ้นสวมเสื้อยืดสีขาวพิมพ์คำว่า ABM96 นั่งอยู่";
---

<header class="sticky top-0 z-50 w-full font-sans">
  <nav class="relative z-40 w-full bg-[#0d0207]/95 shadow-[0_4px_20px_rgba(0,0,0,0.6)] backdrop-blur-lg">
    <div class="bg-theme-oklab absolute bottom-0 left-0 h-[2px] w-full opacity-80"></div>

    <div class="flex h-[65px] w-full items-center justify-between px-3 md:px-6 lg:h-[80px]">
      <div class="flex items-center">
        <a href="/" class="flex-shrink-0 transition-transform hover:scale-105">
          {
            mainLogo ? (
              <Picture
                src={mainLogo}
                alt={logoAlt}
                loading="eager"
                fetchpriority="high"
                widths={[130, 260, 390]}
                sizes="130px"
                class="h-[35px] w-auto drop-shadow-[0_0_10px_rgba(253,163,205,0.55)] lg:h-[45px]"
                formats={["avif", "webp"]}
                fallbackFormat="webp"
              />
            ) : (
              <span class="bg-gradient-to-b from-[#fda3cd] to-[#b5054f] bg-clip-text text-2xl font-black tracking-widest text-transparent">ABM96</span>
            )
          }
        </a>
      </div>

      <div class="hidden h-full items-center justify-center gap-8 lg:flex xl:gap-10">
        {
          links.map((link) => (
            <a href={link.path} class="group relative flex h-full items-center gap-2 text-sm font-bold transition-all xl:text-base">
              <span class="absolute left-0 -ml-3 text-[#fda3cd] opacity-0 transition-all duration-300 group-hover:-ml-4 group-hover:opacity-100">[</span>
              <span aria-hidden="true" class="text-base leading-none">
                {link.icon}
              </span>
              <span
                class={`transition-colors duration-300 ${isActive(link.path) ? "text-[#fda3cd] drop-shadow-[0_0_8px_rgba(253,163,205,0.7)]" : "text-[#e7c3d6]/80 group-hover:text-[#ffd0e6]"}`}>
                {link.name}
              </span>
              <span class="absolute right-0 -mr-3 text-[#fda3cd] opacity-0 transition-all duration-300 group-hover:-mr-4 group-hover:opacity-100">]</span>
              {isActive(link.path) && <div class="absolute bottom-0 left-0 h-[3px] w-full rounded-t-md bg-[#fda3cd] shadow-[0_-2px_10px_rgba(253,163,205,0.9)]" />}
            </a>
          ))
        }
      </div>

      <div class="z-50 flex items-center gap-2 md:gap-4">
        <a
          href="/login"
          class="hidden items-center justify-center rounded border border-[#f1509b]/70 px-6 py-2 text-sm font-bold text-[#ffd0e6] transition-all hover:bg-[#f1509b]/20 hover:shadow-[0_0_15px_rgba(241,80,155,0.45)] lg:flex">
          เข้าสู่ระบบ
        </a>
        <a
          href="/register"
          class="bg-theme-oklab hidden items-center justify-center rounded px-6 py-2 text-sm font-extrabold text-[#2a0210] shadow-[0_0_20px_rgba(253,163,205,0.5)] transition-all hover:brightness-110 lg:flex">
          สมัครสมาชิก
        </a>

        <div class="flex items-center gap-2 lg:hidden">
          <a href="/register" class="bg-theme-oklab flex items-center justify-center rounded px-3 py-1.5 text-[11px] font-bold text-[#2a0210] shadow-[0_0_10px_rgba(253,163,205,0.5)] md:px-4 md:text-xs">
            สมัครสมาชิก
          </a>
          <button id="hamburger-btn" class="flex flex-col items-center justify-center space-y-1.5 rounded border border-[#f1509b]/40 bg-[#f1509b]/10 p-1.5" aria-label="Menu">
            <span class="hamburger-line h-[2px] w-5 origin-center rounded-full bg-[#fda3cd] transition-all duration-300"></span>
            <span class="hamburger-line h-[2px] w-5 rounded-full bg-[#fda3cd] transition-all duration-300"></span>
            <span class="hamburger-line h-[2px] w-5 origin-center rounded-full bg-[#fda3cd] transition-all duration-300"></span>
          </button>
        </div>
      </div>
    </div>
  </nav>

  <div id="mobile-overlay" class="pointer-events-none fixed inset-0 z-40 bg-black/80 opacity-0 backdrop-blur-sm transition-opacity duration-300 lg:hidden"></div>

  <div
    id="mobile-sidebar"
    class="fixed top-0 right-0 z-50 h-screen w-[260px] translate-x-full transform overflow-y-auto border-l border-[#f1509b]/40 bg-[#0d0207] shadow-[-10px_0_30px_rgba(0,0,0,0.9)] transition-transform duration-400 ease-[cubic-bezier(0.3,1,0.3,1)] lg:hidden">
    <div class="flex items-center justify-between border-b border-white/5 px-5 py-5">
      <span class="text-sm font-extrabold tracking-wider text-white">MENU</span>
      <button id="close-sidebar-btn" class="p-1 text-xl text-[#fda3cd] hover:text-white" aria-label="ปิดเมนู">✕</button>
    </div>

    <div class="flex flex-col space-y-2 px-4 pt-4 pb-8">
      {
        links.map((link) => (
          <a
            href={link.path}
            class={`sidebar-item flex items-center px-4 py-3.5 rounded-lg border transition-all ${isActive(link.path) ? "bg-[#f1509b]/20 border-[#f1509b]/60 text-[#fda3cd]" : "bg-white/5 border-transparent text-[#e7c3d6]/80 hover:bg-white/10"}`}>
            <span aria-hidden="true" class="mr-3 text-xl">
              {link.icon}
            </span>
            <span class="text-sm font-bold">{link.name}</span>
          </a>
        ))
      }

      <div class="mt-6 flex flex-col gap-3 border-t border-[#f1509b]/40 pt-6">
        <a
          href="/login"
          class="sidebar-item hover:bg-theme-oklab flex items-center justify-center gap-2 rounded-lg border border-[#fda3cd]/70 bg-transparent py-3.5 text-sm font-bold text-[#ffd0e6] transition-colors hover:border-transparent hover:text-[#2a0210]">
          <span aria-hidden="true">🔒</span> เข้าสู่ระบบ
        </a>
      </div>
    </div>
  </div>
</header>

<style is:global>
  .bg-theme-oklab {
    background-image: linear-gradient(in oklab to right, #b5054f, #f1509b, #fda3cd);
  }

  /* อนิเมชั่น Hamburger เปลี่ยนเป็น X */
  #hamburger-btn.active .hamburger-line:nth-child(1) {
    transform: translateY(7px) rotate(45deg);
  }
  #hamburger-btn.active .hamburger-line:nth-child(2) {
    opacity: 0;
  }
  #hamburger-btn.active .hamburger-line:nth-child(3) {
    transform: translateY(-7px) rotate(-45deg);
  }

  /* อนิเมชั่นเด้งไล่ระดับของเมนูใน Sidebar */
  .sidebar-item {
    opacity: 0;
    transform: translateX(20px);
    transition: all 0.3s cubic-bezier(0.3, 1, 0.3, 1);
  }
  .sidebar-item.item-show {
    opacity: 1;
    transform: translateX(0);
  }
  .sidebar-item:nth-child(1) {
    transition-delay: 0.1s;
  }
  .sidebar-item:nth-child(2) {
    transition-delay: 0.15s;
  }
  .sidebar-item:nth-child(3) {
    transition-delay: 0.2s;
  }
  .sidebar-item:nth-child(4) {
    transition-delay: 0.25s;
  }
  .sidebar-item:nth-child(5) {
    transition-delay: 0.3s;
  }
  .sidebar-item:nth-child(6) {
    transition-delay: 0.35s;
  }

  @media (prefers-reduced-motion: reduce) {
    .sidebar-item {
      transition: none;
      opacity: 1;
      transform: none;
    }
  }
</style>

<script>
  const hamburgerBtn = document.getElementById("hamburger-btn");
  const closeBtn = document.getElementById("close-sidebar-btn");
  const overlay = document.getElementById("mobile-overlay");
  const sidebar = document.getElementById("mobile-sidebar");
  const sidebarItems = document.querySelectorAll(".sidebar-item");

  const toggleSidebar = () => {
    hamburgerBtn?.classList.toggle("active");

    sidebar?.classList.toggle("translate-x-full");
    sidebar?.classList.toggle("translate-x-0");

    overlay?.classList.toggle("opacity-0");
    overlay?.classList.toggle("opacity-100");
    overlay?.classList.toggle("pointer-events-none");
    overlay?.classList.toggle("pointer-events-auto");

    if (sidebar?.classList.contains("translate-x-0")) {
      document.body.style.overflow = "hidden";
      sidebarItems.forEach((item) => item.classList.add("item-show"));
    } else {
      document.body.style.overflow = "";
      sidebarItems.forEach((item) => item.classList.remove("item-show"));
    }
  };

  hamburgerBtn?.addEventListener("click", toggleSidebar);
  closeBtn?.addEventListener("click", toggleSidebar);
  overlay?.addEventListener("click", toggleSidebar);

  sidebarItems.forEach((item) => {
    item.addEventListener("click", () => {
      if (sidebar?.classList.contains("translate-x-0")) {
        toggleSidebar();
      }
    });
  });
</script>
