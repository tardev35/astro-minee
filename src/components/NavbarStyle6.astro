---
import { isActivePath } from "../lib/nav";
import { Picture } from "astro:assets";
import { BRAND_NAME } from "../lib/brandProfile";
const images = import.meta.glob<{ default: ImageMetadata }>("../assets/logo.{png,webp,jpg}", { eager: true });

const imagePaths = Object.keys(images);
const mainLogo = imagePaths.length > 0 ? images[imagePaths[0]].default : null;

const currentPath = Astro.url.pathname;

const isActive = (path: string) => isActivePath(currentPath, path);

// One array, rendered twice (desktop rail + mobile drawer). Never duplicate the
// menu inline in both places — that is how a nav ends up with an entry on
// desktop that the phone drawer does not have.
//
// สมัครสมาชิก/เข้าสู่ระบบ are NOT menu entries on this brand — the cta toggles
// are off, so /register and /login exist only as the pinned buttons below and
// /ทางเข้า keeps its place in the menu.
//
// DIAMOND789 is a slot/casino brand, not a lottery one: /ตรวจหวย and /แนวทาง
// are parked in src/pages-disabled/ this round, so there are no rows for them
// here. A link to a route that does not exist fails the build.
//
// The icon is its own aria-hidden <span>, never concatenated into `name`: an
// emoji inside the label puts "house" into the accessible name of the link.
const links = [
  { name: "หน้าแรก", path: "/", icon: "🏠" },
  { name: "โปรโมชั่น", path: "/promotion", icon: "🎁" },
  { name: "ทดลองเล่น", path: "/ทดลองเล่น", icon: "🎰" },
  { name: "ทางเข้า", path: "/ทางเข้า", icon: "🚪" },
  { name: "เกี่ยวกับเรา", path: "/about-us", icon: "💎" },
  { name: "ติดต่อเรา", path: "/contact-us", icon: "📞" },
];

const logoAlt = `โลโก้ ${BRAND_NAME} ตัวอักษร Daimond789 คำว่า aimond เป็นสีเงินเงาโลหะ ส่วนตัว D และเลข 789 เป็นสีชมพูบานเย็นไล่เฉดม่วง ด้านซ้ายเป็นเพชรเจียระไนสีขาวประกายวาว ด้านล่างเป็นข้อความ GAME CASIO ONLINE AND SPORT BETTING`;
---

<header class="sticky top-0 z-50 w-full font-sans shadow-lg">
  <div class="pointer-events-none absolute top-0 left-0 z-50 hidden h-0 w-full items-start justify-center lg:flex">
    <div
      class="pointer-events-auto flex h-[65px] w-[130px] items-center justify-center rounded-b-3xl border-x border-b border-[#f30d8c] bg-gradient-to-b from-[#5c0a33] to-[#14060f] shadow-[0_5px_18px_rgba(243,13,140,0.45)]">
      <a href="/" class="drop-shadow-[0_0_9px_rgba(255,92,184,0.45)] transition-transform hover:scale-110">
        <Picture
          src={mainLogo!}
          alt={logoAlt}
          loading="eager"
          fetchpriority="high"
          widths={[110, 220, 330]}
          sizes="110px"
          class="h-[35px] w-auto"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
        />
      </a>
    </div>
  </div>

  <aside
    class="fixed top-1/2 left-3 z-40 hidden h-[500px] w-[92px] -translate-y-1/2 flex-col items-center justify-center rounded-2xl border border-[#f30d8c]/50 bg-[#14060f]/95 p-2 shadow-[5px_0_22px_rgba(7,3,8,0.8)] backdrop-blur-md lg:flex"
    aria-label={`เมนูหลัก ${BRAND_NAME}`}>
    <div class="relative flex h-full w-full flex-col gap-2 overflow-hidden rounded-xl">
      {
        links.map((link) => (
          <a
            href={link.path}
            class={`group relative flex h-full w-full flex-col items-center justify-center rounded-lg transition-all ${isActive(link.path) ? "bg-[#5c0a33]" : "hover:bg-[#5c0a33]/70"}`}>
            <span aria-hidden="true" class="mb-1 text-3xl drop-shadow-md transition-transform group-hover:scale-110">
              {link.icon ?? "🔗"}
            </span>
            <span class={`text-xs font-bold transition-colors ${isActive(link.path) ? "text-[#ff5cb8]" : "text-[#e7bfd6] group-hover:text-[#ff5cb8]"}`}>{link.name}</span>
            <div
              aria-hidden="true"
              class={`absolute top-0 left-0 h-full w-[3px] origin-top bg-gradient-to-b from-[#f30d8c] to-[#ff5cb8] transition-transform duration-300 ${isActive(link.path) ? "scale-y-100" : "scale-y-0 group-hover:scale-y-100"}`}
            />
          </a>
        ))
      }
    </div>
  </aside>

  <nav class="relative z-40 flex h-[60px] items-center justify-between border-b border-[#f30d8c]/45 bg-[#14060f] px-3 shadow-xl lg:hidden" aria-label={`เมนูหลัก ${BRAND_NAME}`}>
    <button id="hamburger-btn" class="flex flex-col items-center justify-center space-y-1.5 p-2" aria-label="เปิดเมนู" aria-controls="mobile-sidebar" aria-expanded="false">
      <span class="hamburger-line h-0.5 w-6 origin-center bg-[#ff5cb8] transition-all duration-300"></span>
      <span class="hamburger-line h-0.5 w-6 bg-[#ff5cb8] transition-all duration-300"></span>
      <span class="hamburger-line h-0.5 w-6 origin-center bg-[#ff5cb8] transition-all duration-300"></span>
    </button>

    <a href="/" class="flex-shrink-0 transition-transform hover:scale-105">
      <Picture
        src={mainLogo!}
        alt={logoAlt}
        loading="eager"
        fetchpriority="high"
        widths={[100, 200, 300]}
        sizes="100px"
        class="h-[30px] w-auto drop-shadow-md"
        formats={["avif", "webp"]}
        fallbackFormat="webp"
      />
    </a>

    <a
      href="/login"
      class="flex h-[32px] items-center justify-center rounded border border-[#f30d8c]/60 bg-gradient-to-r from-[#ff5cb8] to-[#b80568] px-4 text-xs font-bold text-[#fff0f8] shadow-[0_0_12px_rgba(243,13,140,0.45)] transition-transform active:scale-95">
      เข้าสู่ระบบ
    </a>
  </nav>

  <div id="mobile-overlay" class="pointer-events-none fixed inset-0 z-30 bg-black/80 opacity-0 backdrop-blur-sm transition-opacity duration-300 lg:hidden"></div>

  <div
    id="mobile-sidebar"
    class="fixed top-0 left-0 z-50 h-screen w-[260px] -translate-x-full transform overflow-y-auto border-r border-[#f30d8c]/40 bg-[#14060f] shadow-[10px_0_30px_rgba(0,0,0,0.8)] transition-transform duration-300 ease-out lg:hidden">
    <div class="flex flex-col space-y-2.5 px-4 pt-16 pb-8">
      {
        links.map((link) => (
          <a
            href={link.path}
            class={`sidebar-item flex items-center rounded-lg border px-4 py-3 transition-all ${isActive(link.path) ? "border-[#f30d8c] bg-[#5c0a33] text-[#ff5cb8] shadow-inner" : "border-transparent bg-white/5 text-[#e7bfd6] hover:bg-white/10 hover:text-[#ff5cb8]"}`}>
            <span aria-hidden="true" class="mr-3 text-xl">
              {link.icon ?? "🔗"}
            </span>
            <span class="text-sm font-bold">{link.name}</span>
          </a>
        ))
      }

      <div class="mt-5 flex flex-col gap-2 border-t border-[#f30d8c]/45 pt-5">
        <a
          href="/register"
          class="sidebar-item flex justify-center gap-1.5 rounded border border-[#ff5cb8]/60 bg-gradient-to-r from-[#ff8ccc] via-[#f30d8c] to-[#b312ac] py-3 text-sm font-bold text-[#2a0618] shadow-md transition-transform active:scale-95">
          <span aria-hidden="true">💎</span> สมัครสมาชิกใหม่
        </a>
      </div>
    </div>
  </div>

  <div class="fixed top-4 right-6 z-50 hidden items-center gap-3 lg:flex">
    <a
      href="/login"
      class="group flex items-center gap-1.5 rounded border border-[#f30d8c]/60 bg-[#2b0820]/90 px-6 py-2 text-sm font-bold text-[#ff5cb8] shadow-md backdrop-blur-sm transition-all hover:border-[#ff5cb8] hover:bg-[#6d0d45]/90">
      <span aria-hidden="true">🔒</span> เข้าสู่ระบบ
    </a>
    <a
      href="/register"
      class="group flex items-center gap-1.5 rounded border border-[#ff5cb8]/60 bg-gradient-to-r from-[#ff8ccc] via-[#f30d8c] to-[#b312ac] px-6 py-2 text-sm font-bold text-[#2a0618] shadow-[0_0_15px_rgba(243,13,140,0.32)] transition-all hover:scale-105">
      <span aria-hidden="true">👤</span> สมัครสมาชิก
    </a>
  </div>
</header>

<div class="hidden h-[15px] w-full lg:block"></div>

<style is:global>
  /* Hamburger กลายเป็น X */
  #hamburger-btn.active .hamburger-line:nth-child(1) {
    transform: translateY(8px) rotate(45deg);
  }
  #hamburger-btn.active .hamburger-line:nth-child(2) {
    opacity: 0;
    transform: scaleX(0);
  }
  #hamburger-btn.active .hamburger-line:nth-child(3) {
    transform: translateY(-8px) rotate(-45deg);
  }

  /* อนิเมชั่นเด้งไล่ระดับของเมนูใน Sidebar */
  .sidebar-item {
    opacity: 0;
    transform: translateX(-20px);
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }
  .sidebar-item.item-show {
    opacity: 1;
    transform: translateX(0);
  }

  .sidebar-item:nth-child(1) {
    transition-delay: 0.1s;
  }
  .sidebar-item:nth-child(2) {
    transition-delay: 0.15s;
  }
  .sidebar-item:nth-child(3) {
    transition-delay: 0.2s;
  }
  .sidebar-item:nth-child(4) {
    transition-delay: 0.25s;
  }
  .sidebar-item:nth-child(5) {
    transition-delay: 0.3s;
  }
  .sidebar-item:nth-child(6) {
    transition-delay: 0.35s;
  }

  @media (prefers-reduced-motion: reduce) {
    .sidebar-item {
      transition: none;
      opacity: 1;
      transform: none;
    }
  }
</style>

<script>
  const hamburgerBtn = document.getElementById("hamburger-btn");
  const overlay = document.getElementById("mobile-overlay");
  const sidebar = document.getElementById("mobile-sidebar");
  const sidebarItems = document.querySelectorAll(".sidebar-item");

  const toggleSidebar = () => {
    hamburgerBtn?.classList.toggle("active");
    sidebar?.classList.toggle("-translate-x-full");
    sidebar?.classList.toggle("translate-x-0");
    overlay?.classList.toggle("opacity-0");
    overlay?.classList.toggle("opacity-100");
    overlay?.classList.toggle("pointer-events-none");
    overlay?.classList.toggle("pointer-events-auto");

    const open = sidebar?.classList.contains("translate-x-0") ?? false;
    hamburgerBtn?.setAttribute("aria-expanded", String(open));

    if (open) {
      document.body.style.overflow = "hidden";
      sidebarItems.forEach((item) => item.classList.add("item-show"));
    } else {
      document.body.style.overflow = "";
      sidebarItems.forEach((item) => item.classList.remove("item-show"));
    }
  };

  hamburgerBtn?.addEventListener("click", toggleSidebar);
  overlay?.addEventListener("click", toggleSidebar);

  sidebarItems.forEach((item) => {
    item.addEventListener("click", () => {
      if (sidebar?.classList.contains("translate-x-0")) {
        toggleSidebar();
      }
    });
  });
</script>
