---
import { isActivePath } from "../lib/nav";
import { Picture } from "astro:assets";
const images = import.meta.glob<{ default: ImageMetadata }>("../assets/logo.{png,webp,jpg}", { eager: true });
const imagePaths = Object.keys(images);
const mainLogo = imagePaths.length > 0 ? images[imagePaths[0]].default : null;
const currentPath = Astro.url.pathname;
const isActive = (path: string) => isActivePath(currentPath, path);

// One source of truth for the menu. This file used to declare the same array
// twice — once for the desktop bar and once for the mobile drawer — which is
// how a link ends up in one and not the other. The icons live here next to the
// label so they can be rendered as a SIBLING span with aria-hidden, never
// concatenated into the label text: an emoji inside the accessible name has a
// screen reader announce the item as "house หน้าแรก".
//
// /login and /register are NOT in this list on purpose. They are noindex
// forwarding interstitials on this brand, not real pages, so ทางเข้า is the
// menu entry that leads a visitor to them.
const links = [
  { name: "หน้าแรก", path: "/", icon: "🏠" },
  { name: "โปรโมชั่น", path: "/promotion", icon: "🎁" },
  { name: "ทดลองเล่น", path: "/ทดลองเล่น", icon: "🎰" },
  { name: "ทางเข้า", path: "/ทางเข้า", icon: "🔑" },
  { name: "เกี่ยวกับเรา", path: "/about-us", icon: "🏢" },
  { name: "ติดต่อเรา", path: "/contact-us", icon: "💬" },
];

const logoAlt = "โลโก้ DUCK36 รูปเป็ดใส่แว่นดำสวมหมวก DUCK36 คล้องสร้อยทอง ถือไม้เบสบอล ในวงกลมสีดำ ใต้ภาพเป็นตัวอักษร DUCK สีเงินและ 36 สีทอง";
---

<header class="sticky top-0 z-[100] w-full font-sans">
  <nav
    class="relative mx-auto flex h-[85px] w-full items-center justify-between rounded-b-2xl border-b border-[#f5b70a]/40 bg-[#050403]/85 px-4 shadow-[0_10px_30px_rgba(245,183,10,0.32)] backdrop-blur-xl xl:px-8">
    <a href="/" class="z-[110] flex-shrink-0 transition-transform duration-300 hover:scale-105 hover:drop-shadow-[0_0_15px_rgba(255,215,106,0.5)]">
      {
        mainLogo ? (
          <Picture
            src={mainLogo}
            alt={logoAlt}
            loading="eager"
            widths={[140, 280, 420]}
            sizes="(max-width: 1279px) 140px, 180px"
            class="h-[55px] w-auto xl:h-[70px]"
            formats={["avif", "webp"]}
            fallbackFormat="webp"
          />
        ) : (
          <span class="bg-gradient-to-r from-[#e9e9e9] to-[#c9c9c9] bg-clip-text text-4xl font-black tracking-widest text-transparent drop-shadow-md">
            DUCK<span class="bg-gradient-to-r from-[#ffd76a] to-[#f5b70a] bg-clip-text text-transparent">36</span>
          </span>
        )
      }
    </a>

    <div class="hidden h-full flex-1 items-center justify-center gap-6 lg:flex">
      {
        links.map((item) => (
          <a
            href={item.path}
            class={`group relative flex h-full items-center gap-2 px-2 text-sm font-bold tracking-widest uppercase transition-colors duration-300 xl:text-base ${isActive(item.path) ? "text-[#ffd76a]" : "text-[#efe3c9]/60 hover:text-white"}`}>
            <span aria-hidden="true" class="text-base">
              {item.icon}
            </span>
            <span>{item.name}</span>
            <div
              class={`absolute bottom-0 left-0 h-[3px] w-full rounded-t-full bg-gradient-to-r from-[#ffd76a] to-[#a8720a] shadow-[0_-2px_10px_rgba(245,183,10,0.8)] transition-transform duration-300 ${isActive(item.path) ? "scale-x-100" : "scale-x-0 group-hover:scale-x-100"}`}
            />
          </a>
        ))
      }
    </div>

    <div class="z-[110] flex items-center gap-4">
      <a
        href="/login"
        class="hidden items-center justify-center rounded-full border border-[#f5b70a]/50 bg-[#050403]/60 px-7 py-2.5 text-sm font-bold text-[#efe3c9] backdrop-blur-md transition-all duration-300 hover:bg-[#8a5c07]/35 hover:text-white hover:shadow-[0_0_15px_rgba(245,183,10,0.4)] lg:flex">
        เข้าสู่ระบบ
      </a>
      <a
        href="/register"
        class="hidden items-center justify-center rounded-full bg-gradient-to-r from-[#ffd76a] via-[#f5b70a] to-[#a8720a] px-7 py-2.5 text-sm font-black text-[#120d02] shadow-[0_4px_15px_rgba(245,183,10,0.4)] transition-all duration-300 hover:-translate-y-0.5 hover:shadow-[0_8px_25px_rgba(245,183,10,0.6)] lg:flex">
        สมัครสมาชิก
      </a>

      <button
        id="hamburger-btn"
        class="relative flex h-[45px] w-[45px] flex-col items-center justify-center gap-[6px] rounded-full border border-[#f5b70a]/30 bg-[#050403]/60 lg:hidden"
        aria-label="เปิดเมนู">
        <span class="line-1 h-[2px] w-5 origin-center rounded-full bg-[#ffd76a] transition-all duration-300"></span>
        <span class="line-2 h-[2px] w-5 origin-center rounded-full bg-[#ffd76a] transition-all duration-300"></span>
        <span class="line-3 h-[2px] w-5 origin-center rounded-full bg-[#ffd76a] transition-all duration-300"></span>
      </button>
    </div>
  </nav>

  <div
    id="mobile-menu"
    class="pointer-events-none absolute top-[85px] left-0 w-full origin-top -translate-y-4 scale-y-95 flex-col rounded-b-3xl border-b border-[#f5b70a]/40 bg-[#050403]/98 px-6 pt-4 pb-8 opacity-0 shadow-2xl backdrop-blur-2xl transition-all duration-400 lg:hidden">
    <div class="flex flex-col gap-2">
      {
        links.map((item) => (
          <a
            href={item.path}
            class={`flex items-center gap-3 rounded-xl px-5 py-3.5 text-lg font-bold tracking-widest uppercase transition-colors ${isActive(item.path) ? "bg-[#8a5c07]/30 text-[#ffd76a] shadow-inner" : "text-[#efe3c9]/60 hover:bg-white/5 hover:text-white"}`}>
            <span aria-hidden="true" class="text-xl">
              {item.icon}
            </span>
            <span>{item.name}</span>
          </a>
        ))
      }
    </div>
    <div class="mt-6 flex flex-col gap-4">
      <a
        href="/register"
        class="flex w-full justify-center rounded-full bg-gradient-to-r from-[#ffd76a] to-[#a8720a] py-3.5 text-lg font-black text-[#120d02] shadow-[0_5px_15px_rgba(245,183,10,0.3)]">
        สมัครสมาชิก
      </a>
      <a href="/login" class="flex w-full justify-center rounded-full border border-[#f5b70a]/50 bg-[#050403]/60 py-3.5 text-lg font-bold text-[#efe3c9]">เข้าสู่ระบบ</a>
    </div>
  </div>
</header>

<style is:global>
  nav,
  header {
    font-family: var(--font-sans) !important;
  }
  #hamburger-btn.active .line-1 {
    transform: translateY(8px) rotate(45deg);
  }
  #hamburger-btn.active .line-2 {
    opacity: 0;
  }
  #hamburger-btn.active .line-3 {
    transform: translateY(-8px) rotate(-45deg);
  }
  #mobile-menu.show {
    opacity: 1;
    transform: translateY(0) scaleY(100%);
    pointer-events: auto;
  }
</style>

<script>
  const hamburgerBtn = document.getElementById("hamburger-btn");
  const mobileMenu = document.getElementById("mobile-menu");
  hamburgerBtn?.addEventListener("click", () => {
    hamburgerBtn.classList.toggle("active");
    mobileMenu?.classList.toggle("show");
  });
</script>
