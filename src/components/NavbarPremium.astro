---
import { isActivePath } from "../lib/nav";
import { Picture } from "astro:assets";
import { BRAND_NAME } from "../lib/brandProfile";
const images = import.meta.glob<{ default: ImageMetadata }>("../assets/logo.{png,webp,jpg}", { eager: true });
const imagePaths = Object.keys(images);
const mainLogo = imagePaths.length > 0 ? images[imagePaths[0]].default : null;
const currentPath = Astro.url.pathname;
const isActive = (path: string) => isActivePath(currentPath, path);

// One source of truth for the menu. This file used to declare the same array
// twice — once for the desktop bar and once for the mobile drawer — which is
// how a link ends up in one and not the other. The icons live here next to the
// label so they can be rendered as a SIBLING span with aria-hidden, never
// concatenated into the label text: an emoji inside the accessible name has a
// screen reader announce the item as "house หน้าแรก".
//
// PRODED888 is a slot/casino brand, so /ตรวจหวย and /แนวทาง do not exist in
// this build and have no entry here. A link to a missing route fails
// tools/verify-build.mjs.
//
// /login and /register are NOT in this list on purpose. They are noindex
// forwarding interstitials on this brand (the uploader's cta toggles are off),
// not real pages, so ทางเข้า is the menu entry that leads a visitor to them.
// If a future brand switches those toggles on, the order becomes
// หน้าแรก · โปรโมชั่น · สมัครสมาชิก · เข้าสู่ระบบ · everything else.
//
// Icons match the brand's genre — a royal navy-and-gold casino, so ทดลองเล่น is
// a slot reel, โปรโมชั่น is a gift, and เกี่ยวกับเรา takes the crown from the
// PRODED888 crest.
const links = [
  { name: "หน้าแรก", path: "/", icon: "🏠" },
  { name: "โปรโมชั่น", path: "/promotion", icon: "🎁" },
  { name: "ทดลองเล่น", path: "/ทดลองเล่น", icon: "🎰" },
  { name: "ทางเข้า", path: "/ทางเข้า", icon: "🚪" },
  { name: "เกี่ยวกับเรา", path: "/about-us", icon: "👑" },
  { name: "ติดต่อเรา", path: "/contact-us", icon: "💬" },
];

const logoAlt = `โลโก้ ${BRAND_NAME} เป็นริบบิ้นสีทองพาดกลางภาพ มีตัวอักษรนูนสามมิติสีทองเขียนว่า PRODED อยู่บนริบบิ้น ด้านหลังเป็นวงล้อรูเล็ตสีน้ำเงินกรมท่าสลับทอง ด้านบนเป็นมงกุฎทองประดับ ใต้ริบบิ้นเป็นเลข 888 สีน้ำเงินขอบทองเงาวาว รอบตราสัญลักษณ์มีไพ่โพดำและดอกจิกสีดำขอบทอง ลูกเต๋าสีขาว และกองชิปคาสิโนสีทองสลับดำ`;
---

<header class="sticky top-0 z-[100] w-full font-sans">
  <nav
    class="relative mx-auto flex h-[85px] w-full items-center justify-between rounded-b-2xl border-b border-[#e3b53f]/40 bg-[#070b20]/85 px-4 shadow-[0_10px_30px_rgba(227,181,63,0.28)] backdrop-blur-xl xl:px-8">
    <a href="/" class="z-[110] flex-shrink-0 transition-transform duration-300 hover:scale-105 hover:drop-shadow-[0_0_15px_rgba(248,222,145,0.55)]">
      {
        mainLogo ? (
          <Picture
            src={mainLogo}
            alt={logoAlt}
            loading="eager"
            widths={[140, 280, 420]}
            sizes="(max-width: 1279px) 140px, 180px"
            class="h-[55px] w-auto xl:h-[70px]"
            formats={["avif", "webp"]}
            fallbackFormat="webp"
          />
        ) : (
          <span class="bg-gradient-to-r from-[#faf3de] via-[#f8de91] to-[#8f6614] bg-clip-text text-4xl font-black tracking-widest text-transparent drop-shadow-md">
            {BRAND_NAME}
          </span>
        )
      }
    </a>

    <div class="hidden h-full flex-1 items-center justify-center gap-6 lg:flex">
      {
        links.map((item) => (
          <a
            href={item.path}
            class={`group relative flex h-full items-center gap-2 px-2 text-sm font-bold tracking-widest uppercase transition-colors duration-300 xl:text-base ${isActive(item.path) ? "text-[#f8de91]" : "text-[#ece0c2]/60 hover:text-[#faf3de]"}`}>
            <span aria-hidden="true" class="text-base">
              {item.icon}
            </span>
            <span>{item.name}</span>
            <div
              class={`absolute bottom-0 left-0 h-[3px] w-full rounded-t-full bg-gradient-to-r from-[#f8de91] via-[#e3b53f] to-[#8f6614] shadow-[0_-2px_10px_rgba(227,181,63,0.8)] transition-transform duration-300 ${isActive(item.path) ? "scale-x-100" : "scale-x-0 group-hover:scale-x-100"}`}
            />
          </a>
        ))
      }
    </div>

    <div class="z-[110] flex items-center gap-4">
      <a
        href="/login"
        class="hidden items-center justify-center rounded-full border border-[#e3b53f]/60 bg-[#0d1338]/70 px-7 py-2.5 text-sm font-bold text-[#ece0c2] backdrop-blur-md transition-all duration-300 hover:bg-[#18225c]/80 hover:text-[#faf3de] hover:shadow-[0_0_15px_rgba(227,181,63,0.45)] lg:flex">
        เข้าสู่ระบบ
      </a>
      <a
        href="/register"
        class="hidden items-center justify-center rounded-full bg-gradient-to-r from-[#faf3de] via-[#e3b53f] to-[#8f6614] px-7 py-2.5 text-sm font-black text-[#070b20] shadow-[0_4px_15px_rgba(227,181,63,0.42)] transition-all duration-300 hover:-translate-y-0.5 hover:shadow-[0_8px_25px_rgba(227,181,63,0.6)] lg:flex">
        สมัครสมาชิก
      </a>

      <button
        id="hamburger-btn"
        class="relative flex h-[45px] w-[45px] flex-col items-center justify-center gap-[6px] rounded-full border border-[#e3b53f]/35 bg-[#0d1338]/70 lg:hidden"
        aria-label="เปิดเมนู"
        aria-controls="mobile-menu"
        aria-expanded="false">
        <span class="line-1 h-[2px] w-5 origin-center rounded-full bg-[#e3b53f] transition-all duration-300"></span>
        <span class="line-2 h-[2px] w-5 origin-center rounded-full bg-[#e3b53f] transition-all duration-300"></span>
        <span class="line-3 h-[2px] w-5 origin-center rounded-full bg-[#e3b53f] transition-all duration-300"></span>
      </button>
    </div>
  </nav>

  <div
    id="mobile-menu"
    class="pointer-events-none absolute top-[85px] left-0 w-full origin-top -translate-y-4 scale-y-95 flex-col rounded-b-3xl border-b border-[#e3b53f]/40 bg-[#070b20]/98 px-6 pt-4 pb-8 opacity-0 shadow-2xl backdrop-blur-2xl transition-all duration-400 lg:hidden">
    <div class="flex flex-col gap-2">
      {
        links.map((item) => (
          <a
            href={item.path}
            class={`flex items-center gap-3 rounded-xl px-5 py-3.5 text-lg font-bold tracking-widest uppercase transition-colors ${isActive(item.path) ? "bg-[#18225c]/70 text-[#f8de91] shadow-inner" : "text-[#ece0c2]/60 hover:bg-[#e3b53f]/10 hover:text-[#faf3de]"}`}>
            <span aria-hidden="true" class="text-xl">
              {item.icon}
            </span>
            <span>{item.name}</span>
          </a>
        ))
      }
    </div>
    <div class="mt-6 flex flex-col gap-4">
      <a
        href="/register"
        class="flex w-full justify-center rounded-full bg-gradient-to-r from-[#faf3de] via-[#e3b53f] to-[#8f6614] py-3.5 text-lg font-black text-[#070b20] shadow-[0_5px_15px_rgba(227,181,63,0.35)]">
        สมัครสมาชิก
      </a>
      <a href="/login" class="flex w-full justify-center rounded-full border border-[#e3b53f]/60 bg-[#0d1338]/70 py-3.5 text-lg font-bold text-[#ece0c2]">เข้าสู่ระบบ</a>
    </div>
  </div>
</header>

<style is:global>
  nav,
  header {
    font-family: var(--font-sans) !important;
  }
  #hamburger-btn.active .line-1 {
    transform: translateY(8px) rotate(45deg);
  }
  #hamburger-btn.active .line-2 {
    opacity: 0;
  }
  #hamburger-btn.active .line-3 {
    transform: translateY(-8px) rotate(-45deg);
  }
  #mobile-menu.show {
    opacity: 1;
    transform: translateY(0) scaleY(100%);
    pointer-events: auto;
  }
</style>

<script>
  const hamburgerBtn = document.getElementById("hamburger-btn");
  const mobileMenu = document.getElementById("mobile-menu");
  hamburgerBtn?.addEventListener("click", () => {
    hamburgerBtn.classList.toggle("active");
    mobileMenu?.classList.toggle("show");
    hamburgerBtn.setAttribute("aria-expanded", String(mobileMenu?.classList.contains("show") ?? false));
  });
</script>
