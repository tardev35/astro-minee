---
export interface Props {
  titleleft?: string;
  titleright?: string;
}
const { titleleft, titleright } = Astro.props;

// Both column titles render as <h2>, not <h3>: the HOT189 docx is flat H1 + H2
// with no nested sub-headings, and the page's heading inventory is diffed
// against that brief. The text is prop-driven, so a title here is a real docx
// section heading — a consumer that wants a headingless column simply omits the
// prop and labels its own content with a <p>. index.astro passes only titleleft,
// so the right column is a supporting panel with no heading.
//
// HOT189 neumorphic pair: page ground (#0d0402) casts the dark side of the
// extrusion, panel tone (#2e100a) the lit side, matching ContentBoxNeumorphism
// so the two read as one system.
---

<section class="mx-auto mb-8 w-full max-w-7xl px-4 font-sans">
  <div
    class="w-full rounded-[25px] border border-[#ef2b09]/35 bg-[#1c0705] p-8 shadow-[10px_10px_20px_#0d0402,-10px_-10px_20px_#2e100a] transition-all duration-300 hover:shadow-[15px_15px_30px_#000000,-15px_-15px_30px_#8f1505]">
    <div class="grid grid-cols-1 gap-8 md:grid-cols-2">
      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#ffe9cf]">
        {titleleft && <h2 class="bg-gradient-to-r from-[#ffe86b] via-[#fcd304] to-[#c99400] bg-clip-text text-2xl leading-normal font-black tracking-wide text-transparent">{titleleft}</h2>}
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#ffe9cf] md:border-l md:border-[#ef2b09]/35 md:pl-8">
        {titleright && <h2 class="bg-gradient-to-r from-[#ffe86b] via-[#fcd304] to-[#c99400] bg-clip-text text-2xl leading-normal font-black tracking-wide text-transparent">{titleright}</h2>}
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
