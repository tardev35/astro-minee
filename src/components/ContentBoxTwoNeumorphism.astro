---
export interface Props {
  titleleft?: string;
  titleright?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { titleleft, titleright, as: HeadingTag = "h2" } = Astro.props;

// Both column titles render as <h2>, not <h3>: the TT1BET docx is flat
// H1 + H2 with no nested sub-headings, and the page's heading inventory is
// diffed against that brief. The text is prop-driven, so a title here is a real
// docx section heading — a consumer that wants a headingless column simply omits
// the prop and labels its own content with a <p>. index.astro passes only
// titleleft and splits one docx paragraph across the two columns at a sentence
// boundary, so the section still contributes exactly one <h2>.
//
// The columns are flattened: the text classes sit on each <article> and the slot
// renders as a direct child, so `leading-normal` on each heading neutralises the
// inherited leading-relaxed. Do not re-add a wrapper <div> around either slot.
//
// TT1BET neumorphic pair: the page ink (#0b0805) casts the dark side of the
// extrusion, the raised warm surface (#241a0d) the lit side, matching
// ContentBoxNeumorphism and ContentBoxSevenThreeNeumorphism so all three read as
// one raised system. Bronze deep carries the surfaces and the heading ramp runs
// gold pale -> primary gold -> bronze, the artwork's own ramp.
---

<section class="mx-auto mb-8 w-full max-w-7xl px-4 font-sans">
  <div
    class="w-full rounded-[25px] border border-[#6d4a13]/55 bg-[#171008] p-8 shadow-[10px_10px_20px_#0b0805,-10px_-10px_20px_#241a0d] transition-all duration-300 hover:shadow-[15px_15px_30px_#0b0805,-15px_-15px_30px_#241a0d]">
    <div class="grid grid-cols-1 gap-8 md:grid-cols-2">
      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#f2e7cd]">
        {
          titleleft && (
            <HeadingTag class="bg-gradient-to-r from-[#fff8d6] via-[#e9c341] to-[#b8862a] bg-clip-text text-2xl leading-normal font-black tracking-wide text-transparent">{titleleft}</HeadingTag>
          )
        }
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#f2e7cd] md:border-l md:border-[#6d4a13]/55 md:pl-8">
        {
          titleright && (
            <HeadingTag class="bg-gradient-to-r from-[#fff8d6] via-[#e9c341] to-[#b8862a] bg-clip-text text-2xl leading-normal font-black tracking-wide text-transparent">{titleright}</HeadingTag>
          )
        }
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
