---
export interface Props {
  titleleft?: string;
  titleright?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { titleleft, titleright, as: HeadingTag = "h2" } = Astro.props;

// Both column titles render as <h2>, not <h3>: the หวยพร้อม docx is flat
// H1 + H2 with no nested sub-headings, and the page's heading inventory is
// diffed against that brief. The text is prop-driven, so a title here is a real
// docx section heading — a consumer that wants a headingless column simply omits
// the prop and labels its own content with a <p>. index.astro passes only
// titleleft and splits one docx paragraph across the two columns at a sentence
// boundary, so the section still contributes exactly one <h2>.
//
// The columns are flattened: the text classes sit on each <article> and the slot
// renders as a direct child, so `leading-normal` on each heading neutralises the
// inherited leading-relaxed. Do not re-add a wrapper <div> around either slot.
//
// หวยพร้อม neumorphic pair: the page ink (#04140a) casts the dark side of the
// extrusion, the lifted surface (#10361c) the lit side, matching
// ContentBoxNeumorphism and ContentBoxSevenThreeNeumorphism so they read as one
// raised system. Green carries the surfaces and the heading ramp runs
// green-white → neon green → prize gold, the artwork's own ramp.
---

<section class="mx-auto mb-8 w-full max-w-7xl px-4 font-sans">
  <div
    class="w-full rounded-[25px] border border-[#1e7a3a]/45 bg-[#0a2413] p-8 shadow-[10px_10px_20px_#04140a,-10px_-10px_20px_#10361c] transition-all duration-300 hover:shadow-[15px_15px_30px_#04140a,-15px_-15px_30px_#10361c]">
    <div class="grid grid-cols-1 gap-8 md:grid-cols-2">
      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#d8efdc]">
        {
          titleleft && (
            <HeadingTag class="bg-gradient-to-r from-[#d8efdc] via-[#22c55e] to-[#f5c451] bg-clip-text text-2xl leading-normal font-black tracking-wide text-transparent">{titleleft}</HeadingTag>
          )
        }
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#d8efdc] md:border-l md:border-[#1e7a3a]/45 md:pl-8">
        {
          titleright && (
            <HeadingTag class="bg-gradient-to-r from-[#d8efdc] via-[#22c55e] to-[#f5c451] bg-clip-text text-2xl leading-normal font-black tracking-wide text-transparent">{titleright}</HeadingTag>
          )
        }
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
