---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;
const headingSize = HeadingTag === "h1" ? "text-3xl" : "text-2xl";
---

<section class="relative z-10 my-8 flex w-full justify-center px-4 font-sans">
  <div
    class="group relative isolate w-full max-w-[1400px] overflow-hidden rounded-3xl border border-[#d99908]/35 bg-gradient-to-br from-[#12100b]/92 to-[#050403]/88 p-8 text-left text-base leading-relaxed text-[#efe3c9] shadow-[0_10px_30px_rgba(217,153,8,0.18)] backdrop-blur-xl transition-all duration-500 hover:border-[#d99908]/65 hover:shadow-[0_15px_40px_rgba(217,153,8,0.3)] md:p-10">
    <div class="pointer-events-none absolute -top-20 -left-20 -z-10 h-40 w-40 rounded-full bg-[#f5b70a]/28 blur-[55px] transition-all duration-500 group-hover:bg-[#ffd76a]/35"></div>
    <div class="pointer-events-none absolute -right-20 -bottom-20 -z-10 h-40 w-40 rounded-full bg-[#a8720a]/50 blur-[55px] transition-all duration-500 group-hover:bg-[#d99908]/30"></div>

    {
      title && (
        <header class="mb-8 flex items-center gap-4 border-b border-[#d99908]/30 pb-4">
          <div class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#fff8e6] via-[#f5b70a] to-[#8a5c07] shadow-[0_0_10px_rgba(245,183,10,0.5)]" />
          <HeadingTag
            class={`bg-gradient-to-r from-[#fff8e6] via-[#ffd76a] to-[#f5b70a] bg-clip-text ${headingSize} leading-normal font-black tracking-widest text-transparent uppercase`}>
            {title}
          </HeadingTag>
        </header>
      )
    }
    <slot />
  </div>
</section>
