---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;
const headingSize = HeadingTag === "h1" ? "text-3xl" : "text-2xl";

// ORA2U palette: a near-black card on the near-black ground, with the primary
// gold carrying one aura blob and bronze the other, so the card reads as the
// logo's medallion bevel instead of a flat tint. The heading gradient runs
// white -> pale gold -> gold and never ends on bronze: clip-text on a dark card
// needs every stop to clear contrast on its own, and #6d3800 would not.
// `isolate` on the card + `-z-10` on the blobs is what lets the slot content
// paint above the decoration with no wrapper <div>. Keep both.
---

<section class="relative z-10 my-8 flex w-full justify-center px-4 font-sans">
  <div
    class="group relative isolate w-full max-w-[1400px] overflow-hidden rounded-3xl border border-[#fe9a00]/35 bg-gradient-to-br from-[#170d03]/92 to-[#030100]/88 p-8 text-left text-base leading-relaxed text-[#f6e6cf] shadow-[0_10px_30px_rgba(254,154,0,0.24)] backdrop-blur-xl transition-all duration-500 hover:border-[#ffd76a]/65 hover:shadow-[0_15px_40px_rgba(254,154,0,0.32)] md:p-10">
    <div aria-hidden="true" class="pointer-events-none absolute -top-20 -left-20 -z-10 h-40 w-40 rounded-full bg-[#fe9a00]/28 blur-[55px] transition-all duration-500 group-hover:bg-[#ffb733]/32">
    </div>
    <div aria-hidden="true" class="pointer-events-none absolute -right-20 -bottom-20 -z-10 h-40 w-40 rounded-full bg-[#b15d01]/55 blur-[55px] transition-all duration-500 group-hover:bg-[#ffd76a]/25">
    </div>

    {
      title && (
        <header class="mb-8 flex items-center gap-4 border-b border-[#fe9a00]/30 pb-4">
          <div aria-hidden="true" class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#fde49b] via-[#ffd76a] to-[#b15d01] shadow-[0_0_10px_rgba(254,154,0,0.5)]" />
          <HeadingTag class={`bg-gradient-to-r from-[#ffffff] via-[#fde49b] to-[#fe9a00] bg-clip-text ${headingSize} leading-normal font-black tracking-widest text-transparent uppercase`}>
            {title}
          </HeadingTag>
        </header>
      )
    }
    <slot />
  </div>
</section>
