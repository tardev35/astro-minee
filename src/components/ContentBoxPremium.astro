---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;
const headingSize = HeadingTag === "h1" ? "text-3xl" : "text-2xl";

// PATTAYA168 palette: a deep-ocean teal card on the page ground, with the
// primary cyan carrying one aura blob and the deeper teal the other, so the card
// reads as the artwork's lit water rather than a flat tint. The heading gradient
// runs pale seafoam -> cyan -> gold and never ends on a darker stop: clip-text on
// a dark card needs every stop to clear contrast on its own.
// `isolate` on the card + `-z-10` on the blobs is what lets the slot content
// paint above the decoration with no wrapper <div>. Keep both.
---

<section class="relative z-10 my-8 flex w-full justify-center px-4 font-sans">
  <div
    class="group relative isolate w-full max-w-[1400px] overflow-hidden rounded-3xl border border-[#0c8ba4]/50 bg-gradient-to-br from-[#04222b]/92 to-[#021c22]/88 p-8 text-left text-base leading-relaxed text-[#cfeef7] shadow-[0_10px_30px_rgba(2,196,227,0.22)] backdrop-blur-xl transition-all duration-500 hover:border-[#02c4e3]/70 hover:shadow-[0_15px_40px_rgba(2,196,227,0.34)] md:p-10">
    <div aria-hidden="true" class="pointer-events-none absolute -top-20 -left-20 -z-10 h-40 w-40 rounded-full bg-[#02c4e3]/26 blur-[55px] transition-all duration-500 group-hover:bg-[#5afef1]/32">
    </div>
    <div aria-hidden="true" class="pointer-events-none absolute -right-20 -bottom-20 -z-10 h-40 w-40 rounded-full bg-[#03303c]/85 blur-[55px] transition-all duration-500 group-hover:bg-[#0c8ba4]/60">
    </div>

    {
      title && (
        <header class="mb-8 flex items-center gap-4 border-b border-[#0c8ba4]/40 pb-4">
          <div aria-hidden="true" class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#8ff5ff] via-[#02c4e3] to-[#0c8ba4] shadow-[0_0_10px_rgba(2,196,227,0.55)]" />
          <HeadingTag class={`bg-gradient-to-r from-[#8ff5ff] via-[#02c4e3] to-[#fdac13] bg-clip-text ${headingSize} leading-normal font-black tracking-widest text-transparent uppercase`}>
            {title}
          </HeadingTag>
        </header>
      )
    }
    <slot />
  </div>
</section>
