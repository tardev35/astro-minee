---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;
const headingSize = HeadingTag === "h1" ? "text-3xl" : "text-2xl";

// AMBKING1234 palette: deep-green card on near-black, with the logo lime and the
// jackpot gold kept for the heading and one of the two aura blobs, so the box
// carries both brand hues without the title ever sitting on a bright fill
// (gold-on-green text, never dark-on-lime).
// `isolate` on the card + `-z-10` on the blobs is what lets the slot content
// paint above the decoration with no wrapper <div>. Keep both.
---

<section class="relative z-10 my-8 flex w-full justify-center px-4 font-sans">
  <div
    class="group relative isolate w-full max-w-[1400px] overflow-hidden rounded-3xl border border-[#8fd318]/35 bg-gradient-to-br from-[#08210f]/92 to-[#04140a]/88 p-8 text-left text-base leading-relaxed text-[#e6f3dd] shadow-[0_10px_30px_rgba(143,211,24,0.18)] backdrop-blur-xl transition-all duration-500 hover:border-[#8fd318]/65 hover:shadow-[0_15px_40px_rgba(143,211,24,0.3)] md:p-10">
    <div class="pointer-events-none absolute -top-20 -left-20 -z-10 h-40 w-40 rounded-full bg-[#8fd318]/28 blur-[55px] transition-all duration-500 group-hover:bg-[#d4ea23]/35"></div>
    <div class="pointer-events-none absolute -right-20 -bottom-20 -z-10 h-40 w-40 rounded-full bg-[#0a3d1c]/55 blur-[55px] transition-all duration-500 group-hover:bg-[#fbd503]/25"></div>

    {
      title && (
        <header class="mb-8 flex items-center gap-4 border-b border-[#8fd318]/30 pb-4">
          <div class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#ffe873] via-[#fbd503] to-[#1c7a2f] shadow-[0_0_10px_rgba(251,213,3,0.5)]" />
          <HeadingTag
            class={`bg-gradient-to-r from-[#ffe873] via-[#fbd503] to-[#d4ea23] bg-clip-text ${headingSize} leading-normal font-black tracking-widest text-transparent uppercase`}>
            {title}
          </HeadingTag>
        </header>
      )
    }
    <slot />
  </div>
</section>
