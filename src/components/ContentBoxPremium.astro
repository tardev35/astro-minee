---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;
const headingSize = HeadingTag === "h1" ? "text-3xl" : "text-2xl";
---

<section class="relative z-10 my-8 flex w-full justify-center px-4 font-sans">
  <div
    class="group relative isolate w-full max-w-[1400px] overflow-hidden rounded-3xl border border-[#ffd54a]/35 bg-gradient-to-br from-[#0a2411]/92 to-[#04150a]/88 p-8 text-left text-base leading-relaxed text-[#e2f3cd] shadow-[0_10px_30px_rgba(255,213,74,0.18)] backdrop-blur-xl transition-all duration-500 hover:border-[#ffd54a]/65 hover:shadow-[0_15px_40px_rgba(255,213,74,0.3)] md:p-10">
    <div class="pointer-events-none absolute -top-20 -left-20 -z-10 h-40 w-40 rounded-full bg-[#a3e635]/28 blur-[55px] transition-all duration-500 group-hover:bg-[#c6f76a]/35"></div>
    <div class="pointer-events-none absolute -right-20 -bottom-20 -z-10 h-40 w-40 rounded-full bg-[#4d7c0f]/50 blur-[55px] transition-all duration-500 group-hover:bg-[#ffd54a]/30"></div>

    {
      title && (
        <header class="mb-8 flex items-center gap-4 border-b border-[#ffd54a]/30 pb-4">
          <div class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#ffeaa0] via-[#ffd54a] to-[#c9911a] shadow-[0_0_10px_rgba(255,213,74,0.5)]" />
          <HeadingTag
            class={`bg-gradient-to-r from-[#ffeaa0] via-[#ffd54a] to-[#c6f76a] bg-clip-text ${headingSize} leading-normal font-black tracking-widest text-transparent uppercase`}>
            {title}
          </HeadingTag>
        </header>
      )
    }
    <slot />
  </div>
</section>
