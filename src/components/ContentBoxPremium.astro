---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;
const headingSize = HeadingTag === "h1" ? "text-3xl" : "text-2xl";
---

<section class="relative z-10 my-8 flex w-full justify-center px-4 font-sans">
  <div
    class="group relative isolate w-full max-w-[1400px] overflow-hidden rounded-3xl border border-[#1573e6]/35 bg-gradient-to-br from-[#0b1c33]/92 to-[#050c1a]/88 p-8 text-left text-base leading-relaxed text-[#cfe6f7] shadow-[0_10px_30px_rgba(21,115,230,0.18)] backdrop-blur-xl transition-all duration-500 hover:border-[#1573e6]/65 hover:shadow-[0_15px_40px_rgba(21,115,230,0.3)] md:p-10">
    <div class="pointer-events-none absolute -top-20 -left-20 -z-10 h-40 w-40 rounded-full bg-[#29abe3]/28 blur-[55px] transition-all duration-500 group-hover:bg-[#7fdcff]/35"></div>
    <div class="pointer-events-none absolute -right-20 -bottom-20 -z-10 h-40 w-40 rounded-full bg-[#1e5fae]/50 blur-[55px] transition-all duration-500 group-hover:bg-[#1573e6]/30"></div>

    {
      title && (
        <header class="mb-8 flex items-center gap-4 border-b border-[#1573e6]/30 pb-4">
          <div class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#e8f6ff] via-[#29abe3] to-[#0b3f96] shadow-[0_0_10px_rgba(41,171,227,0.5)]" />
          <HeadingTag
            class={`bg-gradient-to-r from-[#e8f6ff] via-[#7fdcff] to-[#29abe3] bg-clip-text ${headingSize} leading-normal font-black tracking-widest text-transparent uppercase`}>
            {title}
          </HeadingTag>
        </header>
      )
    }
    <slot />
  </div>
</section>
