---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}
const { title, as: HeadingTag = "h1" } = Astro.props;
const headingSize = HeadingTag === "h1" ? "text-3xl" : "text-2xl";

// CHICKYLUCKY palette: a deep maroon card on the near-black ground, with the
// logo's chick-yellow carrying the heading and one aura blob while the crimson
// takes the other. The heading gradient runs light gold → yellow → bright red
// and never ends on a deep shade — clip-text on a dark card needs every stop to
// clear contrast on its own.
// `isolate` on the card + `-z-10` on the blobs is what lets the slot content
// paint above the decoration with no wrapper <div>. Keep both.
---

<section class="relative z-10 my-8 flex w-full justify-center px-4 font-sans">
  <div
    class="group relative isolate w-full max-w-[1400px] overflow-hidden rounded-3xl border border-[#e01b24]/35 bg-gradient-to-br from-[#3a0806]/92 to-[#1c0100]/88 p-8 text-left text-base leading-relaxed text-[#fdf3d8] shadow-[0_10px_30px_rgba(224,27,36,0.22)] backdrop-blur-xl transition-all duration-500 hover:border-[#fde41a]/65 hover:shadow-[0_15px_40px_rgba(253,228,26,0.3)] md:p-10">
    <div aria-hidden="true" class="pointer-events-none absolute -top-20 -left-20 -z-10 h-40 w-40 rounded-full bg-[#e01b24]/32 blur-[55px] transition-all duration-500 group-hover:bg-[#ff5252]/35"></div>
    <div aria-hidden="true" class="pointer-events-none absolute -right-20 -bottom-20 -z-10 h-40 w-40 rounded-full bg-[#540101]/60 blur-[55px] transition-all duration-500 group-hover:bg-[#fde41a]/25"></div>

    {
      title && (
        <header class="mb-8 flex items-center gap-4 border-b border-[#e01b24]/30 pb-4">
          <div aria-hidden="true" class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#fff17a] via-[#fde41a] to-[#540101] shadow-[0_0_10px_rgba(253,228,26,0.5)]" />
          <HeadingTag
            class={`bg-gradient-to-r from-[#fff17a] via-[#fde41a] to-[#ff5252] bg-clip-text ${headingSize} leading-normal font-black tracking-widest text-transparent uppercase`}>
            {title}
          </HeadingTag>
        </header>
      )
    }
    <slot />
  </div>
</section>
