---
// The lottery sub-pages (/ตรวจหวย, /แนวทาง) call this bare, so the default IS
// their ticker copy and has to be THIS brand's. No leading emoji: the marquee
// renders `message` twice and an emoji baked into a text prop cannot be marked
// aria-hidden, so it is read out on every repeat. The 📢 in the badge beside the
// track is separate markup and is hidden properly.
const {
  message = "BANANAV3 รวมหวยออนไลน์ไว้ในระบบเดียวกับบาคาร่า ทั้งหวยรัฐบาล หวยลาว หวยฮานอย และหวยยี่กี • ตรวจวันออกรางวัล เวลาปิดรับ และอัตราจ่ายของแต่ละงวดจากระบบก่อนยืนยันโพยทุกครั้ง • แนวทางและสถิติย้อนหลังเป็นข้อมูลประกอบเท่านั้น ไม่สามารถรับประกันผลการออกรางวัลได้ • ควรกำหนดวงเงินต่อหนึ่งงวดไว้ล่วงหน้าก่อนเริ่มซื้อ",
} = Astro.props;
---

<div class="relative z-10 mx-auto w-full max-w-[1400px] px-4 py-3 font-sans">
  <div class="relative flex overflow-hidden rounded-full border border-[#f5c451]/35 bg-[#2a0507]/85 shadow-[0_5px_15px_rgba(0,0,0,0.5)] backdrop-blur-md">
    <div
      class="relative z-10 flex shrink-0 items-center justify-center bg-gradient-to-r from-[#f5c451] via-[#ffe08a] to-[#f5c451] px-6 py-2.5 font-black text-[#5a0308] shadow-[4px_0_15px_rgba(0,0,0,0.5)]">
      <span aria-hidden="true" class="mr-2 animate-pulse text-lg">📢</span> ประกาศ
    </div>

    <div class="marquee-container relative flex-1 overflow-hidden py-2.5 pr-6">
      <div class="pointer-events-none absolute top-0 left-0 z-10 h-full w-8 bg-gradient-to-r from-[#2a0507] to-transparent"></div>

      <div class="marquee-content inline-block pl-4 text-sm font-bold tracking-widest whitespace-nowrap text-[#f3ded7]/90">
        <span class="mr-8 inline-flex items-center gap-2"><span aria-hidden="true" class="h-2 w-2 rounded-full bg-[#f5c451] shadow-[0_0_8px_rgba(245,196,81,0.8)]"></span>{message}</span>
        <span class="mr-8 inline-flex items-center gap-2"><span aria-hidden="true" class="h-2 w-2 rounded-full bg-[#f5c451] shadow-[0_0_8px_rgba(245,196,81,0.8)]"></span>{message}</span>
      </div>
    </div>
  </div>
</div>

<style>
  .marquee-content {
    animation: marquee 20s linear infinite;
  }
  .marquee-container:hover .marquee-content {
    animation-play-state: paused;
  }
  @keyframes marquee {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-50%);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .marquee-content {
      animation: none;
    }
  }
</style>
