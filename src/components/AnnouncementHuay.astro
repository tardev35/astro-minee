---
// Every page on this brand calls this bare, so the default IS the sitewide
// ticker copy and has to be THIS brand's. No leading emoji: the marquee renders
// `message` twice and an emoji baked into a text prop cannot be marked
// aria-hidden, so it would be read out on every repeat. The 📢 in the badge
// beside the track is separate markup and is hidden properly.
//
// Every clause traces back to a docx paragraph — the งวด/เวลาปิดรับ check, the
// 2 ตัว/3 ตัว/วิ่ง distinction, the "ไม่อั้นเลข" caveat, the "จ่ายเยอะ" caveat,
// and the โพย review step. Nothing here promises a payout or a win rate.
const {
  message = "หวยพร้อม รวมประเภทหวย ระบบกรอกโพย อัตราจ่าย และข้อมูลผลรางวัลไว้ในระบบเดียว รองรับการใช้งานผ่านมือถือ • ก่อนเลือกเลขควรตรวจชื่อรายการ วันที่ออกรางวัล และเวลาปิดรับให้ถูกต้อง โดยเฉพาะผู้ที่ซื้อหวยหลายประเภทในวันเดียว • เลข 2 ตัว เลข 3 ตัว และเลขวิ่งมีวิธีคิดผลและอัตราจ่ายต่างกัน ควรตรวจว่าต้องการแทงตรงหรือโต๊ดก่อนกรอกจำนวนเงิน • คำว่าไม่อั้นเลขควรพิจารณาตามสถานะล่าสุดของแต่ละงวด เพราะบางเลขอาจถูกจำกัดยอด เปลี่ยนอัตราจ่าย หรือหยุดรับเมื่อถึงวงเงินที่กำหนด • อัตราจ่ายสูงไม่ได้หมายถึงโอกาสถูกรางวัลมากขึ้น ควรเทียบราคาที่ระบบแสดงจริงก่อนซื้อทุกครั้ง • เมื่อซื้อหลายเลขพร้อมกันควรไล่ดูเลข ประเภทเดิมพัน จำนวนเงิน และยอดรวมทีละรายการ พร้อมเก็บเลขอ้างอิงของโพยไว้ตรวจสอบย้อนหลัง",
} = Astro.props;
---

<div class="relative z-10 mx-auto w-full max-w-[1400px] px-4 py-3 font-sans">
  <div class="relative flex overflow-hidden rounded-full border border-[#1e7a3a]/45 bg-[#04140a]/85 shadow-[0_5px_15px_rgba(0,0,0,0.5)] backdrop-blur-md">
    <div
      class="relative z-10 flex shrink-0 items-center justify-center bg-gradient-to-r from-[#f5c451] via-[#ffe08a] to-[#f5c451] px-6 py-2.5 font-black text-[#04140a] shadow-[4px_0_15px_rgba(0,0,0,0.5)]">
      <span aria-hidden="true" class="mr-2 animate-pulse text-lg">📢</span> ประกาศ
    </div>

    <div class="marquee-container relative flex-1 overflow-hidden py-2.5 pr-6">
      <div class="pointer-events-none absolute top-0 left-0 z-10 h-full w-8 bg-gradient-to-r from-[#04140a] to-transparent"></div>

      <div class="marquee-content inline-block pl-4 text-sm font-bold tracking-widest whitespace-nowrap text-[#d8efdc]/90">
        <span class="mr-8 inline-flex items-center gap-2"><span aria-hidden="true" class="h-2 w-2 rounded-full bg-[#22c55e] shadow-[0_0_8px_rgba(34,197,94,0.8)]"></span>{message}</span>
        <span class="mr-8 inline-flex items-center gap-2"><span aria-hidden="true" class="h-2 w-2 rounded-full bg-[#22c55e] shadow-[0_0_8px_rgba(34,197,94,0.8)]"></span>{message}</span>
      </div>
    </div>
  </div>
</div>

<style>
  .marquee-content {
    animation: marquee 20s linear infinite;
  }
  .marquee-container:hover .marquee-content {
    animation-play-state: paused;
  }
  @keyframes marquee {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-50%);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .marquee-content {
      animation: none;
    }
  }
</style>
