---
export interface FAQ {
  q: string;
  a: string;
}
export interface Props {
  title?: string;
  faqs?: FAQ[];
}

const {
  title = "คำถามที่พบบ่อย (FAQ)",
  faqs = [
    {
      q: "อัตราจ่ายของหวยแต่ละตลาดดูได้ที่ไหน",
      a: "อัตราจ่ายของทุกประเภทการแทงจะแสดงอยู่ในหน้าของแต่ละตลาดหวย และระบบจะแสดงอัตราจ่ายจริงอีกครั้งบนหน้ายืนยันโพยก่อนกดส่งเสมอ",
    },
    { q: "แทงหวยขั้นต่ำกี่บาท", a: "ระบบรองรับการส่งโพยตั้งแต่จำนวนเงินขั้นต่ำที่กำหนดไว้ในแต่ละตลาด สมาชิกสามารถตรวจสอบจำนวนเงินขั้นต่ำและสูงสุดได้จากหน้ารายละเอียดของตลาดนั้นก่อนส่งโพย" },
    {
      q: "มีเลขอั้นหรือเลขเต็มหรือไม่",
      a: "มีตามรอบที่ยอดแทงเข้ามามาก เลขอั้นจะถูกปรับลดอัตราจ่ายลง ส่วนเลขเต็มจะปิดรับในรอบนั้น ทั้งสองรายการแสดงอยู่ในหน้าตลาดหวยและระบบจะแจ้งให้ทราบก่อนยืนยันโพย",
    },
  ],
} = Astro.props;
---

<section class="mx-auto mb-12 w-full max-w-4xl px-4 font-sans">
  <div class="mb-6 text-center">
    <h2 class="bg-gradient-to-r from-amber-200 via-amber-300 to-amber-500 bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase drop-shadow-sm">{title}</h2>
  </div>

  <div class="flex flex-col gap-3">
    {
      faqs.map((faq) => (
        <details
          name="faq-huay"
          class="faq-item group overflow-hidden rounded-xl border border-amber-500/25 bg-[#1a0409]/85 backdrop-blur-md transition-all duration-300 hover:border-amber-400/60 hover:shadow-[0_10px_25px_rgba(251,191,36,0.15)]">
          <summary class="flex w-full cursor-pointer items-center justify-between gap-4 p-5 text-left">
            <h3 class="text-base leading-normal font-bold text-white transition-colors group-hover:text-amber-300">{faq.q}</h3>
            <span
              aria-hidden="true"
              class="faq-icon flex h-6 w-6 shrink-0 items-center justify-center rounded-md border border-amber-500/40 bg-[#5f0914] text-sm font-bold text-amber-200 transition-all duration-300 group-hover:bg-[#fbbf24] group-hover:text-[#1a0409]">
              +
            </span>
          </summary>
          <p class="faq-answer border-t border-amber-500/20 bg-[#0f0206]/70 p-5 text-left text-base leading-relaxed text-amber-50/85">{faq.a}</p>
        </details>
      ))
    }
  </div>
</section>

<style>
  /* The removed script queried `.icon`, `.faq-content` and `.faq-item` across
     the WHOLE document, not within its own component — so a second accordion
     anywhere on the page would have had its rows closed and its icons reset by
     this one. `name` gives the exclusive behaviour it was reaching for, scoped
     to this group by the browser. */
  .faq-item > summary {
    list-style: none;
  }
  .faq-item > summary::-webkit-details-marker {
    display: none;
  }
  .faq-item[open] {
    border-color: rgba(251, 191, 36, 0.6);
  }
  .faq-item[open] .faq-icon {
    transform: rotate(45deg);
    background-color: #fbbf24;
    color: #1a0409;
  }
  .faq-item[open] .faq-answer {
    animation: faq-reveal 0.25s ease-out;
  }

  @keyframes faq-reveal {
    from {
      opacity: 0;
      transform: translateY(-4px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .faq-item[open] .faq-answer {
      animation: none;
    }
  }
</style>
