---
import kbankLogo from "../assets/banks/kbank.png";
import scbLogo from "../assets/banks/scb.png";
import krungsriLogo from "../assets/banks/krungsri.png";
import ktbLogo from "../assets/banks/ktb.png";
import ttbLogo from "../assets/banks/ttb.png";
import { brandFlag, brandPick } from "../lib/brandProfile";

// The rows are server-rendered and src/lib/winnersFeed.ts only takes over the
// rotation, so every value below has to come from brandPick/brandFlag — a
// Math.random() in frontmatter runs at BUILD time and makes two builds of the
// same domain differ. Keep the data-winner-* hooks and the data-* config on the
// feed element; that is the whole interface the shared module reads.
const bankPool = [
  { name: "KBank", color: "bg-[#1155cc]", icon: kbankLogo.src },
  { name: "SCB", color: "bg-[#4e1c80]", icon: scbLogo.src },
  { name: "Krungsri", color: "bg-[#fcd34d]", icon: krungsriLogo.src },
  { name: "KTB", color: "bg-[#0ea5e9]", icon: ktbLogo.src },
  { name: "TTB", color: "bg-[#ca8a04]", icon: ttbLogo.src },
];

// Same market names LottoGrid and LoginRtpSection print.
const marketPool = ["หวยรัฐบาลไทย", "หวยฮานอย", "หวยลาวพัฒนา", "หวยยี่กี 88 รอบ", "หวยมาเลย์", "หวยหุ้นไทย"];

const LETTERS = "abcdefghijklmnopqrstuvwxyz";
const pick = (salt: string, n: number) => brandPick(Astro.site, salt, n);
const digits = (salt: string, n: number) => Array.from({ length: n }, (_, d) => pick(`${salt}-${d}`, 10)).join("");

const initialRows = Array.from({ length: 4 }, (_, i) => ({
  bank: bankPool[pick(`card-bank-${i}`, bankPool.length)],
  market: marketPool[pick(`card-market-${i}`, marketPool.length)],
  user: `${LETTERS.charAt(pick(`card-a-${i}`, 26))}${LETTERS.charAt(pick(`card-b-${i}`, 26))}***${digits(`card-u${i}`, 4)}`,
  amount: (15000 + pick(`card-amount-${i}`, 80001)).toLocaleString("en-US"),
  ref: digits(`card-ref-${i}`, 8),
  pending: brandFlag(Astro.site, `card-pending-${i}`),
}));

const PENDING_CLASS = "text-[#ff3d3d] bg-[#3f070a] border border-[#ff3d3d]/45 animate-pulse";
const DONE_CLASS = "text-[#150202] bg-gradient-to-r from-[#ffe08a] via-[#f5c451] to-[#b8860b] border border-[#f5c451]/45 font-black shadow-md";
---

<div class="mx-auto w-full max-w-[1300px] p-4 font-sans">
  <section
    aria-label="รายการถอนรางวัลหวยล่าสุดของสมาชิก LOTTO77"
    class="relative overflow-hidden rounded-[30px] border-2 border-[#f5c451]/30 bg-[#2a0507]/92 px-4 py-8 shadow-[0_10px_30px_rgba(245,196,81,0.18)] backdrop-blur-md md:p-10">
    <div aria-hidden="true" class="pointer-events-none absolute -top-10 left-1/2 h-32 w-64 -translate-x-1/2 rounded-full bg-[#d81220]/35 blur-[50px]"></div>

    <div class="relative z-10 mb-8 flex items-center justify-center gap-3">
      <span aria-hidden="true" class="text-2xl">🏆</span>
      <p class="bg-gradient-to-r from-[#ffe08a] via-[#f5c451] to-[#ff3d3d] bg-clip-text text-xl font-black tracking-wide text-transparent md:text-3xl">รายการถอนรางวัลหวยล่าสุดของสมาชิก LOTTO77</p>
      <span aria-hidden="true" class="text-2xl">🏆</span>
    </div>

    <div
      data-winners-feed
      data-interval="5000"
      data-max-rows="4"
      data-amount-min="15000"
      data-amount-max="95000"
      data-pending-chance="0.4"
      data-user-style="letters"
      data-user-digits="4"
      class="relative z-10 grid grid-cols-1 gap-4 md:grid-cols-2">
      {
        initialRows.map((row) => (
          <div data-winner-row class="winner-card transition-all duration-500 ease-out">
            <div class="flex flex-col rounded-[20px] border border-[#3f070a] bg-[#150202]/95 p-5 shadow-sm transition-all hover:border-[#f5c451]/50 hover:bg-[#3f070a]/95">
              <div class="mb-4 flex items-start justify-between">
                <div data-winner-bank class={`flex h-10 w-10 items-center justify-center rounded-full border border-white/10 shadow-inner ${row.bank.color}`}>
                  <img data-winner-icon src={row.bank.icon} alt="" width="24" height="24" loading="lazy" decoding="async" class="h-6 w-6 object-contain" />
                </div>
                <div
                  data-winner-status
                  data-pending-text="กำลังตรวจสอบโพย"
                  data-done-text="ถอนรางวัลสำเร็จ"
                  data-pending-class={PENDING_CLASS}
                  data-done-class={DONE_CLASS}
                  class={`rounded-full px-3 py-1 text-[10px] ${row.pending ? PENDING_CLASS : DONE_CLASS}`}>
                  {row.pending ? "กำลังตรวจสอบโพย" : "ถอนรางวัลสำเร็จ"}
                </div>
              </div>
              <div>
                <div class="text-sm text-[#c9a49c]">
                  ยูสเซอร์:{" "}
                  <span data-winner-user class="font-bold text-[#f3ded7]">
                    {row.user}
                  </span>
                </div>
                <div class="mt-1 text-2xl font-black text-[#f5c451]">
                  <span data-winner-amount>{row.amount}</span> <span class="text-xs text-[#c9a49c]">THB</span>
                </div>
                <div class="mt-2 flex flex-wrap items-center gap-x-3 gap-y-1 text-[11px] text-[#c9a49c]">
                  <span class="rounded-full border border-[#d81220]/35 bg-[#2a0507] px-2.5 py-0.5 font-bold text-[#ff3d3d]">
                    <span data-winner-market>{row.market}</span>
                  </span>
                  <span>
                    เลขอ้างอิงโพย:{" "}
                    <span data-winner-ref data-ref-length="8" class="font-mono text-[#f3ded7]">
                      {row.ref}
                    </span>
                  </span>
                </div>
              </div>
            </div>
          </div>
        ))
      }
    </div>

    <p class="relative z-10 mt-6 text-center text-[11px] tracking-wide text-[#c9a49c]">
      รายการด้านบนเป็นตัวอย่างการแสดงผลของระบบ สมาชิกควรตรวจสถานะโพยและประวัติผลรางวัลจากหน้าบัญชีของตนเองเป็นหลัก และเก็บเลขอ้างอิงของโพยไว้จนกว่าจะประกาศผลรางวัล
    </p>

    <script type="application/json" data-winners-banks set:html={JSON.stringify(bankPool)} />
    <script type="application/json" data-winners-markets set:html={JSON.stringify(marketPool)} />
  </section>
</div>

<script>
  import { startWinnersFeed } from "../lib/winnersFeed";

  startWinnersFeed();
</script>

<style>
  .winner-card.is-entering {
    transform: scale(0.95);
    opacity: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .winner-card {
      transition: none;
    }
  }
</style>
