---
export interface Props {
  title?: string;
  titleleft?: string;
  titleright?: string;
}
const { title, titleleft, titleright } = Astro.props;
const rightHeading = titleright ?? title;

// 3fr/7fr: the narrow column takes the slide, the wide one the docx paragraph.
// Both column titles are <h2> fed from the page, so pass ONLY the one the brief
// actually has a heading for — passing both invents a heading the docx does not
// contain, and the page's inventory is diffed against the brief every rebrand.
//
// PATTAYA168: ocean-ink card, the primary cyan aura on one corner and the deep
// teal on the other so both ends of the ramp appear without a bright fill behind
// text. The heading gradient runs pale seafoam -> cyan -> gold; the deep teal as
// clip-text on this card is where the contrast would go.
---

<section class="relative z-10 mx-auto mb-8 w-full max-w-7xl px-4 font-sans">
  <div
    class="group relative isolate w-full overflow-hidden rounded-3xl border border-[#0c8ba4]/45 bg-gradient-to-br from-[#04222b]/92 to-[#021c22]/88 p-8 text-[#cfeef7] shadow-[0_10px_30px_rgba(2,196,227,0.2)] backdrop-blur-xl transition-all duration-500 hover:border-[#02c4e3]/65 hover:shadow-[0_15px_40px_rgba(2,196,227,0.3)] md:p-10">
    <div aria-hidden="true" class="pointer-events-none absolute -top-24 -left-24 -z-10 h-48 w-48 rounded-full bg-[#02c4e3]/22 blur-[60px] transition-all duration-500 group-hover:bg-[#5afef1]/28">
    </div>
    <div aria-hidden="true" class="pointer-events-none absolute -right-24 -bottom-24 -z-10 h-48 w-48 rounded-full bg-[#03303c]/85 blur-[60px] transition-all duration-500 group-hover:bg-[#0c8ba4]/60">
    </div>

    <div class="grid grid-cols-1 gap-10 md:grid-cols-[3fr_7fr] md:items-center">
      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#cfeef7]">
        {
          titleleft && (
            <h2 class="bg-gradient-to-r from-[#8ff5ff] via-[#02c4e3] to-[#fdac13] bg-clip-text text-center text-xl leading-normal font-black tracking-widest text-transparent uppercase md:text-left">
              {titleleft}
            </h2>
          )
        }
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#cfeef7] md:border-l md:border-[#0c8ba4]/40 md:pl-10">
        {
          rightHeading && (
            <h2 class="mb-2 bg-gradient-to-r from-[#8ff5ff] via-[#02c4e3] to-[#fdac13] bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase">{rightHeading}</h2>
          )
        }
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
