---
export interface Props {
  title?: string;
  titleleft?: string;
  titleright?: string;
}
const { title, titleleft, titleright } = Astro.props;
const rightHeading = titleright ?? title;

// 3fr/7fr: the narrow column takes the slide, the wide one the docx paragraph.
// Both column titles are <h2> fed from the page, so pass ONLY the one the brief
// actually has a heading for — passing both invents a heading the docx does not
// contain, and the page's inventory is diffed against the brief every rebrand.
//
// LASVEGAS889: royal-navy card, wordmark-gold aura on one corner and the deep
// night blue on the other so both brand accents appear without a second bright
// fill behind text.
---

<section class="relative z-10 mx-auto mb-8 w-full max-w-7xl px-4 font-sans">
  <div
    class="group relative isolate w-full overflow-hidden rounded-3xl border border-[#1f5ce0]/30 bg-gradient-to-br from-[#0b1740]/92 to-[#050b24]/88 p-8 text-[#cddcf7] shadow-[0_10px_30px_rgba(31,92,224,0.22)] backdrop-blur-xl transition-all duration-500 hover:border-[#3fdcff]/60 hover:shadow-[0_15px_40px_rgba(63,220,255,0.3)] md:p-10">
    <div aria-hidden="true" class="pointer-events-none absolute -top-24 -left-24 -z-10 h-48 w-48 rounded-full bg-[#f2b829]/20 blur-[60px] transition-all duration-500 group-hover:bg-[#ffdd7a]/28"></div>
    <div aria-hidden="true" class="pointer-events-none absolute -right-24 -bottom-24 -z-10 h-48 w-48 rounded-full bg-[#0a1a45]/60 blur-[60px] transition-all duration-500 group-hover:bg-[#1f5ce0]/40"></div>

    <div class="grid grid-cols-1 gap-10 md:grid-cols-[3fr_7fr] md:items-center">
      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#cddcf7]">
        {
          titleleft && (
            <h2 class="bg-gradient-to-r from-[#ffdd7a] via-[#f2b829] to-[#3fdcff] bg-clip-text text-center text-xl leading-normal font-black tracking-widest text-transparent uppercase md:text-left">
              {titleleft}
            </h2>
          )
        }
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#cddcf7] md:border-l md:border-[#1f5ce0]/30 md:pl-10">
        {
          rightHeading && (
            <h2 class="mb-2 bg-gradient-to-r from-[#ffdd7a] via-[#f2b829] to-[#3fdcff] bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase">
              {rightHeading}
            </h2>
          )
        }
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
