---
export interface Props {
  title?: string;
  titleleft?: string;
  titleright?: string;
}
const { title, titleleft, titleright } = Astro.props;
const rightHeading = titleright ?? title;
---

<section class="relative z-10 mx-auto mb-8 w-full max-w-7xl px-4 font-sans">
  <div
    class="group relative isolate w-full overflow-hidden rounded-3xl border border-[#ffd54a]/30 bg-gradient-to-br from-[#123018]/92 to-[#04150a]/88 p-8 text-[#e2f3cd] shadow-[0_10px_30px_rgba(255,213,74,0.16)] backdrop-blur-xl transition-all duration-500 hover:border-[#ffd54a]/60 hover:shadow-[0_15px_40px_rgba(255,213,74,0.28)] md:p-10">
    <div class="pointer-events-none absolute -top-24 -left-24 -z-10 h-48 w-48 rounded-full bg-[#a3e635]/25 blur-[60px] transition-all duration-500 group-hover:bg-[#c6f76a]/30"></div>
    <div class="pointer-events-none absolute -right-24 -bottom-24 -z-10 h-48 w-48 rounded-full bg-[#4d7c0f]/45 blur-[60px] transition-all duration-500 group-hover:bg-[#ffd54a]/30"></div>

    <div class="grid grid-cols-1 gap-10 md:grid-cols-[3fr_7fr] md:items-center">
      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#e2f3cd]">
        {
          titleleft && (
            <h2 class="bg-gradient-to-r from-[#e8fb9c] via-[#a3e635] to-[#ffd54a] bg-clip-text text-center text-xl leading-normal font-black tracking-widest text-transparent uppercase md:text-left">
              {titleleft}
            </h2>
          )
        }
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#e2f3cd] md:border-l md:border-[#ffd54a]/30 md:pl-10">
        {
          rightHeading && (
            <h2 class="mb-2 bg-gradient-to-r from-[#e8fb9c] via-[#a3e635] to-[#ffd54a] bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase">
              {rightHeading}
            </h2>
          )
        }
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
