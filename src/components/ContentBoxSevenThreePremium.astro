---
export interface Props {
  title?: string;
  titleleft?: string;
  titleright?: string;
}
const { title, titleleft, titleright } = Astro.props;
const rightHeading = titleright ?? title;

// 3fr/7fr: the narrow column takes the slide, the wide one the docx paragraph.
// Both column titles are <h2> fed from the page, so pass ONLY the one the brief
// actually has a heading for — passing both invents a heading the docx does not
// contain, and the page's inventory is diffed against the brief every rebrand.
//
// AMBKING1234: deep-green card, gold aura on one corner and darkest green on the
// other so both brand hues appear without a second bright fill behind text.
---

<section class="relative z-10 mx-auto mb-8 w-full max-w-7xl px-4 font-sans">
  <div
    class="group relative isolate w-full overflow-hidden rounded-3xl border border-[#8fd318]/30 bg-gradient-to-br from-[#0d2f17]/92 to-[#04140a]/88 p-8 text-[#e6f3dd] shadow-[0_10px_30px_rgba(143,211,24,0.18)] backdrop-blur-xl transition-all duration-500 hover:border-[#8fd318]/60 hover:shadow-[0_15px_40px_rgba(143,211,24,0.3)] md:p-10">
    <div class="pointer-events-none absolute -top-24 -left-24 -z-10 h-48 w-48 rounded-full bg-[#fbd503]/20 blur-[60px] transition-all duration-500 group-hover:bg-[#ffe873]/28"></div>
    <div class="pointer-events-none absolute -right-24 -bottom-24 -z-10 h-48 w-48 rounded-full bg-[#0a3d1c]/55 blur-[60px] transition-all duration-500 group-hover:bg-[#8fd318]/40"></div>

    <div class="grid grid-cols-1 gap-10 md:grid-cols-[3fr_7fr] md:items-center">
      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#e6f3dd]">
        {
          titleleft && (
            <h2 class="bg-gradient-to-r from-[#ffe873] via-[#fbd503] to-[#d4ea23] bg-clip-text text-center text-xl leading-normal font-black tracking-widest text-transparent uppercase md:text-left">
              {titleleft}
            </h2>
          )
        }
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#e6f3dd] md:border-l md:border-[#8fd318]/30 md:pl-10">
        {
          rightHeading && (
            <h2 class="mb-2 bg-gradient-to-r from-[#ffe873] via-[#fbd503] to-[#d4ea23] bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase">
              {rightHeading}
            </h2>
          )
        }
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
