---
export interface Props {
  title?: string;
  titleleft?: string;
  titleright?: string;
}
const { title, titleleft, titleright } = Astro.props;
const rightHeading = titleright ?? title;

// 3fr/7fr: the narrow column takes the slide, the wide one the docx paragraph.
// Both column titles are <h2> fed from the page, so pass ONLY the one the brief
// actually has a heading for — passing both invents a heading the docx does not
// contain, and the page's inventory is diffed against the brief every rebrand.
//
// RUAYRUAY888: rose-black card, the hot-pink aura on one corner and the deep
// pink on the other so both ends of the ramp appear without a bright fill behind
// text. The heading gradient runs white -> bright pink -> hot pink; the deepest
// pink as clip-text on this card is where the contrast would go.
---

<section class="relative z-10 mx-auto mb-8 w-full max-w-7xl px-4 font-sans">
  <div
    class="group relative isolate w-full overflow-hidden rounded-3xl border border-[#f874a1]/35 bg-gradient-to-br from-[#241b1d]/92 to-[#0c0a0a]/88 p-8 text-[#f6dde8] shadow-[0_10px_30px_rgba(248,116,161,0.22)] backdrop-blur-xl transition-all duration-500 hover:border-[#fdb4d4]/60 hover:shadow-[0_15px_40px_rgba(248,116,161,0.3)] md:p-10">
    <div aria-hidden="true" class="pointer-events-none absolute -top-24 -left-24 -z-10 h-48 w-48 rounded-full bg-[#f874a1]/22 blur-[60px] transition-all duration-500 group-hover:bg-[#fdb4d4]/30">
    </div>
    <div aria-hidden="true" class="pointer-events-none absolute -right-24 -bottom-24 -z-10 h-48 w-48 rounded-full bg-[#8f1140]/65 blur-[60px] transition-all duration-500 group-hover:bg-[#d6377a]/50">
    </div>

    <div class="grid grid-cols-1 gap-10 md:grid-cols-[3fr_7fr] md:items-center">
      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#f6dde8]">
        {
          titleleft && (
            <h2 class="bg-gradient-to-r from-[#ffffff] via-[#fdb4d4] to-[#f874a1] bg-clip-text text-center text-xl leading-normal font-black tracking-widest text-transparent uppercase md:text-left">
              {titleleft}
            </h2>
          )
        }
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#f6dde8] md:border-l md:border-[#f874a1]/30 md:pl-10">
        {
          rightHeading && (
            <h2 class="mb-2 bg-gradient-to-r from-[#ffffff] via-[#fdb4d4] to-[#f874a1] bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase">{rightHeading}</h2>
          )
        }
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
