---
import { Picture } from "astro:assets";
import BankStrip from "./BankStrip.astro";
import { BRAND_ADDRESS, BRAND_NAME } from "../lib/brandProfile";
const images = import.meta.glob<{ default: ImageMetadata }>("../assets/logo.{png,webp,jpg}", { eager: true });
const imagePaths = Object.keys(images);
const mainLogo = imagePaths.length > 0 ? images[imagePaths[0]].default : null;

// The angled clip-path and the mono "/// DIRECTORY" labels are this variant's
// shape and stay; only the hue moves. It arrived on a blue brand (BMK289), so
// every #2b8cff/#02081c/#9dcef0 stop below is a repaint, not an original.
//
// Both column labels are <p>, not headings: the footer renders on every page,
// so one <h2> here would be an <h2> sitewide and the homepage heading inventory
// is diffed against the docx checklist. Each <nav>/region carries an aria-label
// instead, which is what the label was doing for assistive tech anyway.
//
// The <address> block is pasted verbatim from the playbook and carries NO brand
// colour on purpose — border-white/15 + bg-black/20 + opacity land correctly on
// every footer variant in the library. Do not repaint it.
---

<footer
  class="relative mt-10 w-full overflow-hidden border-t border-[#e11d16]/40 bg-[#0a0403] pt-16 pb-8 font-sans text-[#f6e5df]"
  style="clip-path: polygon(0 30px, 50vw 0, 100% 30px, 100% 100%, 0 100%);">
  <div
    aria-hidden="true"
    class="pointer-events-none absolute inset-0 opacity-[0.14]"
    style="background-image: linear-gradient(#e11d16 1px, transparent 1px), linear-gradient(90deg, #8f0f0a 1px, transparent 1px); background-size: 30px 30px;">
  </div>

  <div class="relative z-10 mx-auto w-full max-w-[1200px] px-6">
    <div class="mb-12 grid grid-cols-1 gap-10 md:grid-cols-12">
      <div class="flex flex-col gap-5 md:col-span-5">
        <a href="/" class="inline-block transition-transform hover:scale-105">
          {
            mainLogo ? (
              <Picture
                src={mainLogo}
                alt={`โลโก้ ${BRAND_NAME} ตัวอักษร TAKO168 สีขาวนูนสามมิติขอบหนาสีแดง ด้านบนเป็นรูปปลาหมึกยักษ์สีชมพูสวมหมวกโจรสลัดสีม่วงขลิบทอง ปิดตาข้างซ้าย และชูดาบคัตลาสสีเงินไว้ด้วยหนวด`}
                widths={[100, 200, 300]}
                sizes="100px"
                loading="lazy"
                class="h-[60px] w-auto drop-shadow-[0_4px_12px_rgba(225,29,22,0.4)]"
                formats={["avif", "webp"]}
                fallbackFormat="webp"
              />
            ) : (
              <span class="text-3xl font-black tracking-widest text-[#ffd97a]">{BRAND_NAME}</span>
            )
          }
        </a>
        <p class="border-l-2 border-[#e11d16] pl-4 text-sm leading-relaxed text-[#f6e5df]/80">
          {BRAND_NAME} แพลตฟอร์มสล็อตออนไลน์ที่รวมเกมหลายค่ายหลายรูปแบบไว้ในระบบเดียว รองรับ True Wallet ตามช่องทางที่กำหนด และมีระบบบัญชีสำหรับตรวจสอบธุรกรรม เลือกเกม ดูโปรโมชั่น
          และติดตามสถานะรายการได้จากบัญชีเดียว โดยควรศึกษากติกา ข้อมูลเกม และกำหนดงบให้เหมาะกับตนเองก่อนเริ่มทุกครั้ง
        </p>
        <div class="mt-4 flex gap-3">
          <span class="border border-[#e11d16]/50 bg-[#1a0806] px-3 py-1 font-mono text-xs text-[#ff6a5a]">TRUE_WALLET</span>
          <span class="border border-[#e8b23a]/50 bg-[#1a0806] px-3 py-1 font-mono text-xs text-[#e8b23a]">SUPPORT_24H</span>
        </div>
      </div>

      <nav class="flex flex-col gap-4 md:col-span-3 lg:pl-8" aria-label="ลิงก์หน้าเว็บ">
        <p class="text-lg font-black tracking-widest text-[#ffd97a] uppercase">/// DIRECTORY</p>
        <ul class="flex flex-col gap-3 font-mono text-sm text-[#f6e5df]/80">
          <li><a href="/" class="transition-colors hover:text-[#e8b23a]">&gt; หน้าแรก</a></li>
          <li><a href="/promotion" class="transition-colors hover:text-[#e8b23a]">&gt; โปรโมชั่น</a></li>
          <li><a href="/ทดลองเล่น" class="transition-colors hover:text-[#e8b23a]">&gt; ทดลองเล่น</a></li>
          <li><a href="/ทางเข้า" class="transition-colors hover:text-[#e8b23a]">&gt; ทางเข้า</a></li>
          <li><a href="/about-us" class="transition-colors hover:text-[#e8b23a]">&gt; เกี่ยวกับเรา</a></li>
          <li><a href="/contact-us" class="transition-colors hover:text-[#e8b23a]">&gt; ติดต่อเรา</a></li>
          <li><a href="/register" class="transition-colors hover:text-[#e8b23a]">&gt; สมัครสมาชิก</a></li>
          <li><a href="/login" class="transition-colors hover:text-[#e8b23a]">&gt; เข้าสู่ระบบ</a></li>
        </ul>
      </nav>

      <div class="flex flex-col gap-5 md:col-span-4">
        <p class="text-lg font-black tracking-widest text-[#ffd97a] uppercase">/// SUPPORT_LINK</p>

        <a
          href="/line"
          class="flex w-full items-center justify-center gap-2 bg-[#00B900] py-3 font-bold text-white transition-all hover:bg-[#009900]"
          style="clip-path: polygon(10px 0, 100% 0, 100% calc(100% - 10px), calc(100% - 10px) 100%, 0 100%, 0 10px);">
          LINE CONNECT
        </a>

        {
          BRAND_ADDRESS.lines.length > 0 && (
            <address aria-label={BRAND_ADDRESS.label} class="mt-2 rounded-xl border border-white/15 bg-black/20 p-4 text-xs leading-relaxed not-italic opacity-90">
              <p class="mb-2 flex items-center gap-2 text-[11px] font-bold tracking-wider uppercase opacity-80">
                <span aria-hidden="true" class="text-sm">📍</span>
                {BRAND_ADDRESS.label}
              </p>
              {BRAND_ADDRESS.lines.map((line) => (
                <span class="block">{line}</span>
              ))}
              {BRAND_ADDRESS.email && (
                <a href={`mailto:${BRAND_ADDRESS.email}`} class="mt-3 inline-flex items-center gap-2 font-bold underline decoration-current/40 underline-offset-4 opacity-90 transition-opacity hover:opacity-100">
                  <span aria-hidden="true" class="text-sm">✉️</span>
                  {BRAND_ADDRESS.email}
                </a>
              )}
            </address>
          )
        }

        <a
          href="#top"
          class="flex w-full items-center justify-center gap-2 border border-[#e11d16]/60 bg-transparent py-3 font-bold text-[#ffd97a] transition-all hover:bg-[#2b0705]/60"
          style="clip-path: polygon(10px 0, 100% 0, 100% calc(100% - 10px), calc(100% - 10px) 100%, 0 100%, 0 10px);">
          <span aria-hidden="true">↑</span> กลับขึ้นบน
        </a>

        <div class="mt-2 font-mono text-xs text-[#f6e5df]/60">ACCEPTED_PAYMENTS</div>
        <BankStrip size={28} />
      </div>
    </div>

    <div class="flex flex-col items-center justify-between border-t border-[#e11d16]/25 pt-6 font-mono text-xs text-[#f6e5df]/60 md:flex-row">
      <p>SYSTEM_COPYRIGHT &copy; {new Date().getFullYear()} {BRAND_NAME}</p>
      <div class="mt-4 flex gap-4 md:mt-0">
        <a href="/terms/" class="hover:text-[#e8b23a]">TERMS_OF_SERVICE</a>
        <a href="/privacy/" class="hover:text-[#e8b23a]">PRIVACY_POLICY</a>
      </div>
    </div>
  </div>
</footer>

<style>
  footer a {
    text-decoration: none;
    font-family: var(--font-sans);
  }
  .font-mono {
    font-family: monospace;
  }
</style>
