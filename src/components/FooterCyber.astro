---
import { Picture } from "astro:assets";
import BankStrip from "./BankStrip.astro";
import { BRAND_ADDRESS } from "../lib/brandProfile";
const images = import.meta.glob<{ default: ImageMetadata }>("../assets/logo.{png,webp,jpg}", { eager: true });
const imagePaths = Object.keys(images);
const mainLogo = imagePaths.length > 0 ? images[imagePaths[0]].default : null;
---

<footer
  class="relative mt-10 w-full overflow-hidden border-t border-[#1c7a2f]/45 bg-[#04140a] pt-16 pb-8 font-sans text-[#e6f3dd]"
  style="clip-path: polygon(0 30px, 50vw 0, 100% 30px, 100% 100%, 0 100%);">
  <div
    aria-hidden="true"
    class="pointer-events-none absolute inset-0 opacity-[0.12]"
    style="background-image: linear-gradient(#125c26 1px, transparent 1px), linear-gradient(90deg, #8fd318 1px, transparent 1px); background-size: 30px 30px;">
  </div>

  <div class="relative z-10 mx-auto w-full max-w-[1200px] px-6">
    <div class="mb-12 grid grid-cols-1 gap-10 md:grid-cols-12">
      <div class="flex flex-col gap-5 md:col-span-5">
        <a href="/" class="inline-block transition-transform hover:scale-105">
          {
            mainLogo ? (
              <Picture
                src={mainLogo}
                alt="โลโก้ AMBKING1234 ตัวอักษร ambking สีเขียวมะนาวและเขียวเข้ม ต่อด้วยเลข 1234 สีขาวขอบเขียว"
                widths={[160, 320, 480]}
                sizes="160px"
                loading="lazy"
                class="h-[60px] w-auto drop-shadow-[0_4px_12px_rgba(143,211,24,0.35)]"
                formats={["avif", "webp"]}
                fallbackFormat="webp"
              />
            ) : (
              <span class="text-3xl font-black tracking-widest text-[#d4ea23]">AMBKING1234</span>
            )
          }
        </a>
        <p class="border-l-2 border-[#8fd318] pl-4 text-sm leading-relaxed text-[#e6f3dd]/80">
          AMBKING1234 รวมเกมสล็อตยอดนิยมหลายรูปแบบไว้ในระบบเดียว เมนูเข้าใจง่าย รองรับมือถือ แท็บเล็ต และคอมพิวเตอร์ พร้อมระบบบัญชีและช่องทางบริการที่ช่วยให้ใช้งานได้เป็นขั้นตอน
          ควรศึกษากติกาและกำหนดงบประมาณก่อนเริ่มเล่นทุกครั้ง
        </p>
        <div class="mt-4 flex gap-3">
          <span class="border border-[#8fd318]/45 bg-[#08210f] px-3 py-1 font-mono text-xs text-[#d4ea23]">ONE_WALLET</span>
          <span class="border border-[#fbd503]/45 bg-[#08210f] px-3 py-1 font-mono text-xs text-[#fbd503]">AUTO_24H</span>
        </div>
      </div>

      <nav class="flex flex-col gap-4 md:col-span-3 lg:pl-8">
        <p class="text-lg font-black tracking-widest text-[#d4ea23] uppercase">/// DIRECTORY</p>
        <ul class="flex flex-col gap-3 font-mono text-sm text-[#e6f3dd]/80">
          <li><a href="/" class="transition-colors hover:text-[#e4f223]">&gt; หน้าแรก</a></li>
          <li><a href="/promotion" class="transition-colors hover:text-[#e4f223]">&gt; โปรโมชั่น</a></li>
          <li><a href="/ทดลองเล่น" class="transition-colors hover:text-[#e4f223]">&gt; ทดลองเล่น</a></li>
          <li><a href="/ทางเข้า" class="transition-colors hover:text-[#e4f223]">&gt; ทางเข้า</a></li>
          <li><a href="/about-us" class="transition-colors hover:text-[#e4f223]">&gt; เกี่ยวกับเรา</a></li>
          <li><a href="/contact-us" class="transition-colors hover:text-[#e4f223]">&gt; ติดต่อเรา</a></li>
          <li><a href="/register" class="transition-colors hover:text-[#e4f223]">&gt; สมัครสมาชิก</a></li>
          <li><a href="/login" class="transition-colors hover:text-[#e4f223]">&gt; เข้าสู่ระบบ</a></li>
        </ul>
      </nav>

      <div class="flex flex-col gap-5 md:col-span-4">
        <p class="text-lg font-black tracking-widest text-[#d4ea23] uppercase">/// SUPPORT_LINK</p>

        <a
          href="/line"
          class="flex w-full items-center justify-center gap-2 bg-[#00B900] py-3 font-bold text-white transition-all hover:bg-[#009900]"
          style="clip-path: polygon(10px 0, 100% 0, 100% calc(100% - 10px), calc(100% - 10px) 100%, 0 100%, 0 10px);">
          LINE CONNECT
        </a>

        {
          BRAND_ADDRESS.lines.length > 0 && (
            <address aria-label={BRAND_ADDRESS.label} class="mt-2 rounded-xl border border-white/15 bg-black/20 p-4 text-xs leading-relaxed not-italic opacity-90">
              <p class="mb-2 flex items-center gap-2 text-[11px] font-bold tracking-wider uppercase opacity-80">
                <span aria-hidden="true" class="text-sm">📍</span>
                {BRAND_ADDRESS.label}
              </p>
              {BRAND_ADDRESS.lines.map((line) => (
                <span class="block">{line}</span>
              ))}
              {BRAND_ADDRESS.email && (
                <a href={`mailto:${BRAND_ADDRESS.email}`} class="mt-3 inline-flex items-center gap-2 font-bold underline decoration-current/40 underline-offset-4 opacity-90 transition-opacity hover:opacity-100">
                  <span aria-hidden="true" class="text-sm">✉️</span>
                  {BRAND_ADDRESS.email}
                </a>
              )}
            </address>
          )
        }

        <a
          href="#top"
          class="flex w-full items-center justify-center gap-2 border border-[#8fd318]/60 bg-transparent py-3 font-bold text-[#8fd318] transition-all hover:bg-[#0d2f17]/60"
          style="clip-path: polygon(10px 0, 100% 0, 100% calc(100% - 10px), calc(100% - 10px) 100%, 0 100%, 0 10px);">
          <span aria-hidden="true">↑</span> กลับขึ้นบน
        </a>

        <div class="mt-2 font-mono text-xs text-[#e6f3dd]/60">ACCEPTED_PAYMENTS</div>
        <BankStrip size={28} />
      </div>
    </div>

    <div class="flex flex-col items-center justify-between border-t border-[#1c7a2f]/35 pt-6 font-mono text-xs text-[#e6f3dd]/60 md:flex-row">
      <p>SYSTEM_COPYRIGHT &copy; {new Date().getFullYear()} AMBKING1234</p>
      <div class="mt-4 flex gap-4 md:mt-0">
        <a href="/terms/" class="hover:text-[#e4f223]">เงื่อนไขและข้อตกลง</a>
        <a href="/privacy/" class="hover:text-[#e4f223]">นโยบายความเป็นส่วนตัว</a>
      </div>
    </div>
  </div>
</footer>

<style>
  footer a {
    text-decoration: none;
    font-family: var(--font-sans);
  }
  .font-mono {
    font-family: monospace;
  }
</style>
