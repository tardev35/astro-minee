---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  titleleft?: string;
  titleright?: string;
}
const { title, as: HeadingTag = "h2", titleleft, titleright } = Astro.props;

// Both column titles are <h2> fed from the page (the docx), so pass only the
// column the brief actually has a heading for — a page whose section heading
// sits on `title` must leave titleleft/titleright unset or it invents two more
// <h2> the brief never asked for.
//
// PRODED888: gold rules and gold-light heading text on the deep navy card, with
// the column divider and the aura wash in the navy accent. The lighter gold
// carries the type because #e3b53f on navy at this weight is the dimmer of the
// two metals.
---

<section class="relative z-10 mx-auto mb-8 w-full max-w-7xl px-4 font-sans">
  <div
    class="group relative isolate w-full overflow-hidden rounded-3xl border border-[#e3b53f]/35 bg-[#0d1338]/92 p-8 text-[#ece0c2] shadow-[0_10px_30px_rgba(7,11,32,0.85)] backdrop-blur-xl transition-all duration-500 hover:border-[#f8de91]/55 hover:shadow-[0_15px_40px_rgba(227,181,63,0.24)] md:p-10">
    <div aria-hidden="true" class="pointer-events-none absolute inset-0 -z-10 bg-gradient-to-br from-[#2a3a8f]/45 to-transparent opacity-70"></div>

    {
      title && (
        <header class="mb-8 flex items-center gap-4 border-b border-[#e3b53f]/30 pb-4">
          <span aria-hidden="true" class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#faf3de] via-[#f8de91] to-[#8f6614] shadow-[0_0_10px_rgba(227,181,63,0.5)]" />
          <HeadingTag class="bg-gradient-to-r from-[#dbe3f5] via-[#f8de91] to-[#e3b53f] bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase">{title}</HeadingTag>
        </header>
      )
    }

    <div class="grid grid-cols-1 gap-10 md:grid-cols-2">
      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#ece0c2]">
        {
          titleleft && (
            <h2 class="flex items-center gap-3 border-b border-[#e3b53f]/30 pb-3 text-xl leading-normal font-black tracking-widest text-[#f8de91] uppercase">
              <span aria-hidden="true" class="h-6 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#faf3de] via-[#f8de91] to-[#8f6614] shadow-[0_0_10px_rgba(227,181,63,0.45)]" />
              {titleleft}
            </h2>
          )
        }
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#ece0c2] md:border-l md:border-[#2a3a8f]/70 md:pl-10">
        {
          titleright && (
            <h2 class="flex items-center gap-3 border-b border-[#e3b53f]/30 pb-3 text-xl leading-normal font-black tracking-widest text-[#f8de91] uppercase">
              <span aria-hidden="true" class="h-6 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#faf3de] via-[#f8de91] to-[#8f6614] shadow-[0_0_10px_rgba(227,181,63,0.45)]" />
              {titleright}
            </h2>
          )
        }
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
