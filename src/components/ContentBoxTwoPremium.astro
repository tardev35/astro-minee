---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  titleleft?: string;
  titleright?: string;
}
const { title, as: HeadingTag = "h2", titleleft, titleright } = Astro.props;

// Both column titles are <h2> fed from the page (the docx), so pass only the
// column the brief actually has a heading for — a page whose section heading
// sits on `title` must leave titleleft/titleright unset or it invents two more
// <h2> the brief never asked for.
//
// VEGUS1: gold rules and gold heading text on the deep maroon card, with the
// column divider and the aura wash in the primary crimson.
---

<section class="relative z-10 mx-auto mb-8 w-full max-w-7xl px-4 font-sans">
  <div
    class="group relative isolate w-full overflow-hidden rounded-3xl border border-[#f5c451]/30 bg-[#2b0808]/92 p-8 text-[#f7e3c8] shadow-[0_10px_30px_rgba(21,4,4,0.85)] backdrop-blur-xl transition-all duration-500 hover:border-[#f5c451]/55 hover:shadow-[0_15px_40px_rgba(245,196,81,0.24)] md:p-10">
    <div aria-hidden="true" class="pointer-events-none absolute inset-0 -z-10 bg-gradient-to-br from-[#4a0a0d]/45 to-transparent opacity-70"></div>

    {
      title && (
        <header class="mb-8 flex items-center gap-4 border-b border-[#f5c451]/30 pb-4">
          <span aria-hidden="true" class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#ffe08a] via-[#f5c451] to-[#d81f26] shadow-[0_0_10px_rgba(245,196,81,0.5)]" />
          <HeadingTag class="bg-gradient-to-r from-[#ffe08a] via-[#f5c451] to-[#ff3a33] bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase">{title}</HeadingTag>
        </header>
      )
    }

    <div class="grid grid-cols-1 gap-10 md:grid-cols-2">
      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#f7e3c8]">
        {
          titleleft && (
            <h2 class="flex items-center gap-3 border-b border-[#f5c451]/30 pb-3 text-xl leading-normal font-black tracking-widest text-[#ffe08a] uppercase">
              <span aria-hidden="true" class="h-6 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#ffe08a] via-[#f5c451] to-[#d81f26] shadow-[0_0_10px_rgba(245,196,81,0.45)]" />
              {titleleft}
            </h2>
          )
        }
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#f7e3c8] md:border-l md:border-[#d81f26]/40 md:pl-10">
        {
          titleright && (
            <h2 class="flex items-center gap-3 border-b border-[#f5c451]/30 pb-3 text-xl leading-normal font-black tracking-widest text-[#ffe08a] uppercase">
              <span aria-hidden="true" class="h-6 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#ffe08a] via-[#f5c451] to-[#d81f26] shadow-[0_0_10px_rgba(245,196,81,0.45)]" />
              {titleright}
            </h2>
          )
        }
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
