---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  titleleft?: string;
  titleright?: string;
}
const { title, as: HeadingTag = "h2", titleleft, titleright } = Astro.props;

// Both column titles are <h2> fed from the page (the docx), so pass only the
// column the brief actually has a heading for — a page whose section heading
// sits on `title` must leave titleleft/titleright unset or it invents two more
// <h2> the brief never asked for.
//
// CHICKYLUCKY: chick-yellow rules and gold heading text on the deep maroon
// card, with the divider in the primary crimson.
---

<section class="relative z-10 mx-auto mb-8 w-full max-w-7xl px-4 font-sans">
  <div
    class="group relative isolate w-full overflow-hidden rounded-3xl border border-[#fde41a]/30 bg-[#3a0806]/92 p-8 text-[#fdf3d8] shadow-[0_10px_30px_rgba(28,1,0,0.85)] backdrop-blur-xl transition-all duration-500 hover:border-[#fde41a]/55 hover:shadow-[0_15px_40px_rgba(253,228,26,0.24)] md:p-10">
    <div aria-hidden="true" class="pointer-events-none absolute inset-0 -z-10 bg-gradient-to-br from-[#540101]/45 to-transparent opacity-70"></div>

    {
      title && (
        <header class="mb-8 flex items-center gap-4 border-b border-[#fde41a]/30 pb-4">
          <span aria-hidden="true" class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#fff17a] via-[#fde41a] to-[#e01b24] shadow-[0_0_10px_rgba(253,228,26,0.5)]" />
          <HeadingTag class="bg-gradient-to-r from-[#fff17a] via-[#fde41a] to-[#ff5252] bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase">{title}</HeadingTag>
        </header>
      )
    }

    <div class="grid grid-cols-1 gap-10 md:grid-cols-2">
      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#fdf3d8]">
        {
          titleleft && (
            <h2 class="flex items-center gap-3 border-b border-[#fde41a]/30 pb-3 text-xl leading-normal font-black tracking-widest text-[#fff17a] uppercase">
              <span aria-hidden="true" class="h-6 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#fff17a] via-[#fde41a] to-[#e01b24] shadow-[0_0_10px_rgba(253,228,26,0.45)]" />
              {titleleft}
            </h2>
          )
        }
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#fdf3d8] md:border-l md:border-[#e01b24]/40 md:pl-10">
        {
          titleright && (
            <h2 class="flex items-center gap-3 border-b border-[#fde41a]/30 pb-3 text-xl leading-normal font-black tracking-widest text-[#fff17a] uppercase">
              <span aria-hidden="true" class="h-6 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#fff17a] via-[#fde41a] to-[#e01b24] shadow-[0_0_10px_rgba(253,228,26,0.45)]" />
              {titleright}
            </h2>
          )
        }
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
