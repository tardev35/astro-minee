---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  titleleft?: string;
  titleright?: string;
}
const { title, as: HeadingTag = "h2", titleleft, titleright } = Astro.props;

// Both column titles are <h2> fed from the page (the docx), so pass only the
// column the brief actually has a heading for. LASVEGAS889: gold rules and gold
// heading text on the royal-navy card, with the divider in the primary blue.
---

<section class="relative z-10 mx-auto mb-8 w-full max-w-7xl px-4 font-sans">
  <div
    class="group relative isolate w-full overflow-hidden rounded-3xl border border-[#f2b829]/30 bg-[#0b1740]/92 p-8 text-[#cddcf7] shadow-[0_10px_30px_rgba(5,11,36,0.85)] backdrop-blur-xl transition-all duration-500 hover:border-[#f2b829]/55 hover:shadow-[0_15px_40px_rgba(242,184,41,0.24)] md:p-10">
    <div aria-hidden="true" class="pointer-events-none absolute inset-0 -z-10 bg-gradient-to-br from-[#122a63]/45 to-transparent opacity-70"></div>

    {
      title && (
        <header class="mb-8 flex items-center gap-4 border-b border-[#f2b829]/30 pb-4">
          <span aria-hidden="true" class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#ffdd7a] via-[#f2b829] to-[#3fdcff] shadow-[0_0_10px_rgba(242,184,41,0.5)]" />
          <HeadingTag class="bg-gradient-to-r from-[#ffdd7a] via-[#f2b829] to-[#3fdcff] bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase">{title}</HeadingTag>
        </header>
      )
    }

    <div class="grid grid-cols-1 gap-10 md:grid-cols-2">
      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#cddcf7]">
        {
          titleleft && (
            <h2 class="flex items-center gap-3 border-b border-[#f2b829]/30 pb-3 text-xl leading-normal font-black tracking-widest text-[#ffdd7a] uppercase">
              <span aria-hidden="true" class="h-6 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#ffdd7a] via-[#f2b829] to-[#3fdcff] shadow-[0_0_10px_rgba(242,184,41,0.45)]" />
              {titleleft}
            </h2>
          )
        }
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#cddcf7] md:border-l md:border-[#1f5ce0]/40 md:pl-10">
        {
          titleright && (
            <h2 class="flex items-center gap-3 border-b border-[#f2b829]/30 pb-3 text-xl leading-normal font-black tracking-widest text-[#ffdd7a] uppercase">
              <span aria-hidden="true" class="h-6 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#ffdd7a] via-[#f2b829] to-[#3fdcff] shadow-[0_0_10px_rgba(242,184,41,0.45)]" />
              {titleright}
            </h2>
          )
        }
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
