---
export interface Props {
  title?: string;
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  titleleft?: string;
  titleright?: string;
}
const { title, as: HeadingTag = "h2", titleleft, titleright } = Astro.props;

// Both column titles are <h2> fed from the page (the docx), so pass only the
// column the brief actually has a heading for — a page whose section heading
// sits on `title` must leave titleleft/titleright unset or it invents two more
// <h2> the brief never asked for.
//
// PATTAYA168: cyan rules and pale-seafoam heading text on the deep-ocean card,
// with the column divider and the aura wash in the deeper teal. Gold stays as
// the warm end of the heading gradient only — on this surface #fdac13 is the
// brighter metal and carries the eye without competing with the cyan rule.
---

<section class="relative z-10 mx-auto mb-8 w-full max-w-7xl px-4 font-sans">
  <div
    class="group relative isolate w-full overflow-hidden rounded-3xl border border-[#02c4e3]/35 bg-[#04222b]/92 p-8 text-[#cfeef7] shadow-[0_10px_30px_rgba(2,28,34,0.85)] backdrop-blur-xl transition-all duration-500 hover:border-[#8ff5ff]/55 hover:shadow-[0_15px_40px_rgba(2,196,227,0.24)] md:p-10">
    <div aria-hidden="true" class="pointer-events-none absolute inset-0 -z-10 bg-gradient-to-br from-[#0c8ba4]/40 to-transparent opacity-70"></div>

    {
      title && (
        <header class="mb-8 flex items-center gap-4 border-b border-[#02c4e3]/30 pb-4">
          <span aria-hidden="true" class="h-8 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#8ff5ff] via-[#02c4e3] to-[#0c8ba4] shadow-[0_0_10px_rgba(2,196,227,0.5)]" />
          <HeadingTag class="bg-gradient-to-r from-[#8ff5ff] via-[#02c4e3] to-[#fdac13] bg-clip-text text-2xl leading-normal font-black tracking-widest text-transparent uppercase">{title}</HeadingTag>
        </header>
      )
    }

    <div class="grid grid-cols-1 gap-10 md:grid-cols-2">
      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#cfeef7]">
        {
          titleleft && (
            <h2 class="flex items-center gap-3 border-b border-[#02c4e3]/30 pb-3 text-xl leading-normal font-black tracking-widest text-[#8ff5ff] uppercase">
              <span aria-hidden="true" class="h-6 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#8ff5ff] via-[#02c4e3] to-[#0c8ba4] shadow-[0_0_10px_rgba(2,196,227,0.45)]" />
              {titleleft}
            </h2>
          )
        }
        <slot name="left" />
      </article>

      <article class="flex flex-col gap-4 text-left text-base leading-relaxed text-[#cfeef7] md:border-l md:border-[#0c8ba4]/70 md:pl-10">
        {
          titleright && (
            <h2 class="flex items-center gap-3 border-b border-[#02c4e3]/30 pb-3 text-xl leading-normal font-black tracking-widest text-[#8ff5ff] uppercase">
              <span aria-hidden="true" class="h-6 w-1.5 shrink-0 rounded-full bg-gradient-to-b from-[#8ff5ff] via-[#02c4e3] to-[#0c8ba4] shadow-[0_0_10px_rgba(2,196,227,0.45)]" />
              {titleright}
            </h2>
          )
        }
        <slot name="right" />
      </article>
    </div>
  </div>
</section>
