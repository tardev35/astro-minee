---
export interface FaqItem {
  q: string;
  a: string;
}

export interface Props {
  title?: string;
  faqs?: FaqItem[];
}

const { title, faqs = [] } = Astro.props;

// The questions render as <span>, not <h3> — the docx for this template is flat
// H1+H2 and the page's heading inventory is diffed against it. That is the whole
// reason this plain variant is the one picked when the brief has no H3s.
//
// RUAYRUAY888: the panel runs rose-black → ink so the open state's pink glow
// reads against it, and the + marker is bright pink on a hot-pink ring.
---

<div class="mx-auto max-w-[1000px] px-4 py-10 font-sans">
  {title && <h2 class="mb-8 bg-gradient-to-b from-[#ffffff] to-[#d6377a] bg-clip-text text-center text-2xl font-black tracking-tight text-transparent uppercase md:text-4xl">{title}</h2>}

  <div class="space-y-4">
    {
      faqs.map((faq) => (
        // `name` makes this an exclusive accordion natively — opening one closes
        // the rest, which is what the removed script did by hand.
        <details name="faq-plain" class="faq-item group overflow-hidden rounded-xl border border-[#f874a1]/30 bg-gradient-to-br from-[#241b1d] to-[#0c0a0a] transition-all hover:border-[#f874a1]/60">
          <summary class="flex w-full cursor-pointer items-center justify-between p-5 text-left transition-all">
            <span class="text-base font-bold text-[#f6dde8] md:text-lg">{faq.q}</span>
            <span
              aria-hidden="true"
              class="faq-icon ml-4 flex h-8 w-8 shrink-0 items-center justify-center rounded-full border border-[#f874a1]/40 text-lg leading-none font-black text-[#fdb4d4] transition-transform duration-300">
              +
            </span>
          </summary>
          <div class="faq-answer border-t border-[#8f1140]/60 p-5 pt-0 text-left text-base leading-relaxed text-[#f6dde8]/85">{faq.a}</div>
        </details>
      ))
    }
  </div>
</div>

<style>
  .faq-item > summary {
    list-style: none;
  }
  .faq-item > summary::-webkit-details-marker {
    display: none;
  }
  .faq-item[open] {
    border-color: rgba(248, 116, 161, 0.6);
    box-shadow: 0 0 20px rgba(214, 55, 122, 0.35);
  }
  .faq-item[open] .faq-icon {
    transform: rotate(45deg);
    border-color: #fdb4d4;
    color: #ffffff;
  }
  .faq-item[open] .faq-answer {
    animation: faq-reveal 0.25s ease-out;
  }

  @keyframes faq-reveal {
    from {
      opacity: 0;
      transform: translateY(-4px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .faq-item[open] .faq-answer {
      animation: none;
    }
  }
</style>
