---
import { Picture } from "astro:assets";
import img1 from "../assets/providers/game1.avif";
import img2 from "../assets/providers/game2.avif";
import img3 from "../assets/providers/game3.avif";
import img4 from "../assets/providers/game4.avif";
import img5 from "../assets/providers/game5.avif";
import img6 from "../assets/providers/game6.avif";

// The widget title renders as <p>, not <h2>: it is chrome, and the page's
// heading inventory is diffed against the docx on every rebrand. The
// accessible name for the region lives on the <section>'s aria-label.
//
// This grid sits under the TT1BET brief's H2 "เปรียบเทียบค่ายคาสิโนและสล็อต
// ได้ง่ายบน TT1BET", so the copy says what that section says: each provider may
// differ in ฟีเจอร์ อัตราจ่าย และวงเงิน, and the list is a reference, not a
// ranking.
//
// TT1BET: gold card frames and gold badges on the warm near-black ground. The
// "HOT" pill is a gold fill with ink lettering rather than another outlined
// frame, so it still reads as a flag against a card frame that is already gold.
const providers = [
  { alt: "PG Soft", users: "4,592", isHot: true, img: img1 },
  { alt: "Joker Gaming", users: "2,184", isHot: true, img: img2 },
  { alt: "JILI", users: "3,845", isHot: true, img: img3 },
  { alt: "Evolution", users: "2,901", isHot: true, img: img4 },
  { alt: "SA Gaming", users: "1,754", isHot: false, img: img5 },
  { alt: "Sexy Baccarat", users: "3,245", isHot: true, img: img6 },
];
---

<section aria-label="ค่ายคาสิโนและสล็อตที่เปิดให้เลือกบน TT1BET" class="mx-auto w-full max-w-[1300px] px-4 py-8 font-sans sm:px-6 lg:px-8">
  <div class="mb-8 flex w-full flex-col items-center justify-center gap-2 text-center">
    <span aria-hidden="true" class="text-2xl drop-shadow-[0_0_10px_rgba(252,241,176,0.8)]">🎰</span>
    <p class="bg-gradient-to-r from-[#fff8d6] via-[#e9c341] to-[#b8862a] bg-clip-text text-3xl font-black tracking-widest text-transparent uppercase drop-shadow-sm">ค่ายเกมที่ให้บริการ</p>
    <p class="max-w-3xl text-base leading-relaxed text-[#f2e7cd]">
      รายชื่อค่ายด้านล่างใช้เพื่ออ้างอิงเท่านั้น จำนวนผู้ใช้งานและเกมที่เปิดให้บริการเปลี่ยนแปลงได้ตามช่วงเวลา แต่ละค่ายอาจมีฟีเจอร์ อัตราจ่าย และวงเงินต่างกัน
      จึงควรเปรียบเทียบข้อมูลและกติกาจากหน้าเกมจริงก่อนเลือกเล่น
    </p>
    <div class="mt-2 h-[2px] w-24 rounded-full bg-gradient-to-r from-transparent via-[#e9c341] to-transparent"></div>
  </div>

  <div class="grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-6 lg:gap-6">
    {
      providers.map((p) => (
        <div class="group relative flex flex-col overflow-hidden rounded-2xl bg-[#171008] shadow-[0_5px_15px_rgba(11,8,5,0.6)] transition-all duration-500 hover:-translate-y-2 hover:shadow-[0_15px_35px_rgba(233,195,65,0.3)]">
          <div class="pointer-events-none absolute inset-0 z-20 rounded-2xl border border-[#e9c341]/50 transition-all duration-500 group-hover:border-[#fcf1b0]/60 group-hover:shadow-[inset_0_0_20px_rgba(252,241,176,0.18)]" />

          <div class="absolute top-0 left-0 z-10 flex items-center gap-1.5 rounded-br-xl border-r border-b border-[#e9c341]/50 bg-[#0b0805]/85 px-3 py-1.5 text-[10px] font-medium text-[#f2e7cd] backdrop-blur-md transition-colors group-hover:text-[#fcf1b0]">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M10 9a3 3 0 100-6 3 3 0 000 6zm-7 9a7 7 0 1114 0H3z" clip-rule="evenodd" />
            </svg>
            {p.users}
          </div>

          {p.isHot && (
            <div class="absolute top-0 right-0 z-10 flex items-center gap-1 rounded-bl-xl border-b border-l border-[#fcf1b0]/50 bg-gradient-to-r from-[#fff8d6] via-[#e9c341] to-[#b8862a] px-3 py-1.5 text-[10px] font-black tracking-wide text-[#0b0805] shadow-md">
              <span aria-hidden="true" class="animate-pulse">
                🔥
              </span>{" "}
              HOT
            </div>
          )}

          <Picture
            src={p.img}
            alt={`ภาพหน้าปกค่ายเกม ${p.alt} ที่เปิดให้เลือกเล่นบน TT1BET`}
            formats={["avif", "webp"]}
            fallbackFormat="webp"
            loading="lazy"
            fetchpriority="low"
            widths={[200, 400]}
            sizes="(max-width: 640px) 45vw, 200px"
            decoding="async"
            class="block aspect-square w-full object-cover opacity-90 transition-transform duration-700 group-hover:scale-110 group-hover:opacity-100"
          />

          <div
            aria-hidden="true"
            class="pointer-events-none absolute -bottom-10 left-0 h-20 w-full bg-gradient-to-t from-[#e9c341]/45 to-transparent opacity-0 transition-opacity duration-500 group-hover:opacity-100"
          />
        </div>
      ))
    }
  </div>
</section>
